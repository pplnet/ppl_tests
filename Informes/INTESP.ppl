CrearDialogo
  Fecha1   : 'Fecha Liq' ;;;;;;NoVacio(Dialogo.Fecha1);'Fecha Incorrecta';NO;Habiles(FSys,3,'ARG')
  Cantidad1: 'Cantidad'  ;;;;;;Dialogo.Cantidad1>=0;'Cantidad Incorrecta';NO;1000000;
  Lista1   : "Especies"  ;;;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".ESPECIES WHERE Status='HAB' and Tipo in ('PUB','PRI','ONE') ORDER BY Codigo ");
  Check1   : 'Desde Partidas' ;1;1;;NO;NO;;;;0;
FinDialogo

if not Ok
  Cancelar
endif

ACT(a1, 'Intereses por Especie ')
ACT(a2, 'Fecha Liq.: '~Dialogo.Fecha1)
If NoVacio(Dialogo.Lista1)
   ACT(a3,'Especies: '~Pipe2Comillas(Dialogo.Lista1))
EndIf

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

ACT(a5, 'Especie')
ACT(b5, 'Intereses '~PYC(Dialogo.Cantidad1,0,2))
ACT(c5, 'Cod.MAE')
ACT(d5, 'Cupon Vig.')
ACT(e5, 'F. Ult. Cupon')
ACT(f5, 'F. Prox. Cupon')
ACT(g5, 'Contraesp.')
ACT(h5, 'T.Int.Vig.')
ACT(i5, 'V.Residual.')

SetFilaActual(5)

*-- Busco especies
SQL.ADD("Select Codigo, Tipo, CodMAEContado, FechaCambioTasa, TasaIntVigente, TasaIntAnterior, VTeorico, Cupon, InteresesC, DiasMes, DiasAnio, IntsCapitalizados ")
SQL.ADD("from "~DBO~".ESPECIES ")
SQL.ADD("where Tipo in ('PUB','PRI','ONE') ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD("and Codigo In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
EndIf
SQL.ADD("Order by Codigo ")

Recorrer SQL
  Message('Especie: '~FBN['Codigo'])

     * asigno valor a las celdas
     ACT(a:fac, fbn('Codigo'))
     ACT(c:fac, fbn('CodMAEContado'))
     ACN(d:fac, NrCupon2(FBN['Codigo'],Dialogo.Fecha1) )
     ACT(g:fac, Cotizaen(Val(a:fac)))
     ACN(h:fac, 100 * fbn('TasaIntVigente'))
     ACN(i:fac, 100 * ValorTeorico2(Val(a:fac),Dialogo.Fecha1))
     ACD(ae:fac, UltCupon2(Val(a:fac),Dialogo.Fecha1)) 
     ACN(fe:fac, ProxCupon2(Val(a:fac),Dialogo.Fecha1)) 

     If val(ae:fac)=val(fe:fac)
        Message('*- Estoy en una fecha de corte de cupon -> Verifico si se realizo ')
        ACD(ae:fac, UltCupon2(Val(a:fac),Dialogo.Fecha1-1))         
     endif

     if Val(ae:fAc)>0
        ACD(e:fac, Val(ae:fac))
     endif

     if Val(fe:fac)>0
        ACD(f:fac, Val(fe:fac))
     endif

     * calculo el interes 
     if Eqstr(fbn('InteresesC'),'CLE') o Dialogo.Check1=1
        * obtengo diferencia de dias (x2,x3)
        ACN(x2,0)

        if EqStr(fbn('DiasAnio'),'360') y EqStr(fbn('DiasMes'),'30')
           *- ACN(x2, Dif360(Val(ae:fac), Dialogo.Fecha1,2))
           *- Claudia, para que calcule 30 dias por cada mes como pide Mariano
           ACN(x2,Abs(30*DifMes(Val(ae:fac),Dialogo.Fecha1)) )
           If val(x2)=0 
              *- No se completo un mes 
              ACN(x2, Abs(Dif360(Val(ae:fac),Dialogo.Fecha1,2)))
           EndIf
        else
           ACN(x2, Abs(DifDias(Val(ae:fac), Dialogo.Fecha1,'USA',NO)))
        endif
 
        * obtengo tasa interes cupon para la formula (xx1)
        ACN(xx1,0)
        if fbn('FechaCambioTasa') > Val(ae:fac) y fbn('FechaCambioTasa') <= Dialogo.Fecha1
           ACN(ww1, fbn('TasaIntAnterior'))
           if EqStr(fbn('DiasAnio'),'360') y EqStr(fbn('DiasMes'),'30')
              ACN(ww1, Val(ww1)* Abs(Dif360(Val(ae:fac),fbn('FechaCambioTasa')-1,2))) 
           else
              ACN(ww1, Val(ww1)* Abs(DifDias(Val(ae:fac),fbn('FechaCambioTasa')-1,'USA',NO)))
           endif
           ACN(zz1 ,fbn('TasaIntVigente'))
 
           if EqStr(fbn('DiasAnio'),'360') y EqStr(fbn('DiasMes'),'30')
              ACN(zz1, Val(zz1)* Abs(Dif360(fbn('FechaCambioTasa')-1, Dialogo.Fecha1 ,2))) 
           else
              ACN(zz1, Val(zz1)* Abs(DifDias(fbn('FechaCambioTasa')-1, Dialogo.Fecha1, 'USA', NO)))
           endif
           ACN(xx1, Val(ww1)+Val(zz1))


           if EqStr(fbn('DiasAnio'),'360') y EqStr(fbn('DiasMes'),'30')
              ACN(xx1, Val(xx1) / Abs(Dif360(Val(ae:fac),Dialogo.Fecha1,2)))
           else
              ACN(xx1, Val(xx1) / Abs(DifDias(Val(ae:fac),Dialogo.Fecha1,'USA',NO)))
           endif

        else
           if fbn('FechaCambioTasa') <= Val(ae:fac)
              ACN(xx1, fbn('TasaIntVigente'))
           endif
           if fbn('FechaCambioTasa') > Dialogo.Fecha1
              ACN(xx1, fbn('TasaIntAnterior'))
           endif
        endif

        * formula completa
        if Eqstr(BuscarCampo('ESPECIES','Alias6','Codigo',fbn('Codigo')),'ESP')               
            if [(Anio(Val(ae:fac)) MOD 4) = 0] y [(Anio(Val(ae:fac)) MOD 4000) <> 0] y  [ [(Anio(Val(ae:fac)) MOD 100) <> 0] O [(Anio(Val(ae:fac)) MOD 400) = 0] ] 
               Acn(ac3,366)
            else
               Acn(ac3,365)
            endif
        else
           Acn(ac3,DiasAnio2(fbn('Codigo'),Val(ae:fac),Val(fe:fac)))
        endif   

        * ACN(b:fac,fbn('VTeorico')*Dialogo.Cantidad1*(1+fbn('IntsCapitalizados'))*Val(xx1)*Val(x2)/Val(ac3))  
        ACN(b:fac,(val(i:fac)/100)*Dialogo.Cantidad1*Val(xx1)*Val(x2)/Val(ac3))  
     else
        ACN(b:fac,0)
     endif

  *- Valor para linkear desde el informe de Partidas 
  ACN(z1, val(b:fac)) 
  *----
Proximo

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
SetFont(a1..z5, 1)
SetFont(a6..z:fac, 2)
AgregarMarco(a5..i5,1,0,Exe('COLOR'))

ACO(2,15)
ACO(5,8)
ACO(6,9)
Ifa
Ifa
ACT(a:fac, 'FIN DEL LISTADO')

SetFont(a:FAC..a:FAC,1)
*AlinearCeldas(c:3,'D')
LimitesVision(j:FAC+1)
*RangoTitulo(a:1..c:fac,Val(w1)+2)
FormatoCeldas(d6..d:fac,Exe('F0R'))
FormatoCeldas(h6..h:fac,Exe('F6'))
FormatoCeldas(i6..i:fac,Exe('F6'))
CrearFont(6,"Arial,6,B")
RangoTitulo(a:1..j:FAC+1, 5)

