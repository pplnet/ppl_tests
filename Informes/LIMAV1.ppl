AgregarMarco(A:fac..E:fac, 0, 0, Exe('COLOR'))
Let &filaInicial fac+1
**************
*SENTENCIA SQL
**************
SQL.ADD("SELECT D.EntidadGarante, D.FechaVigencia, D.Disponible ")
SQL.ADD("FROM "~dbo~".DDCUPOSAVALADOS D")
SQL.ADD("WHERE")
SQL.ADD("Moneda = '"~Dialogo.Especie1~"' ")
SQL.ADD("AND FechaVigencia = ")
    SQL.ADD("(SELECT MAX(FechaVigencia) FROM "~dbo~".DDCUPOSAVALADOS")
    SQL.ADD(" WHERE Moneda = '"~Dialogo.Especie1~"' ")
    SQL.ADD(" AND FechaVigencia <= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" AND Vehiculo = '"~Dialogo.Vehiculo1~"' ")
    SQL.ADD(" AND Book = '"~Dialogo.Book1~"'  ")
    SQL.ADD(" AND EntidadGarante = D.EntidadGarante) ")
SQL.ADD("AND Vehiculo = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("AND Book = '"~Dialogo.Book1~"' ")
If Dialogo.Radio1 = 1
    SQL.ADD("AND TipoEntidadGarante = 'SGR'")
ELSE
    IF Dialogo.Radio1 = 2
        SQL.ADD("AND TipoEntidadGarante = 'FPG'")
    Endif
Endif

WATCH(SQL.BATCH)

*************
Recorrer SQL
*************
    ***Col A: Entidad Garante** *Una línea para cada entidad garante
    ACT(A:FAC,FBN['EntidadGarante'])

    ***Col B: Cupo Admitido*** / Lim Asignado (Disponible del ABM)
    ACN(B:FAC, FBN['Disponible'])

    ***Col C: Exposición** *(lo que ya consumió a la fecha del reporte)
    ACN(C:FAC, (LimConsumido(FBN['EntidadGarante'],'DDA',,0,Dialogo.Vehiculo1,,Dialogo.Book1,,Dialogo.Fecha1)))

    ***COL D Cupo Disponible** *(Cupo Admitido - Exposición) - si está en nros negativos se pone en rojo
    ACN(D:FAC, (FBN['Disponible']-Val(C:FAC)) )

    ***Col E Cumple** *Si Cupo Disponible queda menor que cero - Excedido (en rojo) *Sino, OK
    IF VAL(D:FAC) > 0
        ACT(E:FAC, 'OK')
    ELSE
        ACT(E:FAC, 'EXCEDIDO')
        ColorCeldas(E:FAC, clRED)
    ENDIF

