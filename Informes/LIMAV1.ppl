ACT(A:FAC, 'Entidad Garante')
ACT(B:FAC, 'Cupo admitido')
ACT(C:FAC, 'Exposicion')
ACT(D:FAC, 'Cupo disponible')
ACT(E:FAC, 'Cumple')
 
AlinearCeldas(A:fac..E:fac,'C')
