CrearDialogo
    Fecha1:     'Fecha: '                           ;1;1;;;;;;;FSYS;;
    Vehiculo1:  'Vehiculo: '                        ;2;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un Vehiculo';NO;Var('DDVEHDEF');;
    Book1:      'Book: '                            ;3;1;;;;EqStr(Dialogo.Vehiculo1,BuscarCampo('BOOKS','Vehiculo','Codigo',Dialogo.Book1)) Y NoVacio(Dialogo.Book1);'El book ingresado no corresponde al Vehiculo';NO;Var('BOOKDDCHE');BuscarCampo('VEHICULOS','Alias5','Codigo',Dialogo.Vehiculo1);;;;" Vehiculo = '"~Dialogo.Vehiculo1~"'"
    Especie1:   'Moneda '                           ;4;1;;NO;;;;;Var('MONELOCA');
    Radio1:     'Entidad Garante: |AMBAS|SGR|FPG|'  ;5;1;;;;;;;;0
FinDialogo

If not ok
    Cancelar
Endif

