CrearDialogo
   Fecha1         :'Fecha :'             ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
FinDialogo

If Not Ok
   Cancelar
Endif

***+++Preparamos contadores por cada ejecucion de evento/informe con la misma Logica del Cierre, luego validaremos cantidad de ejecuciones en LOGINFORMES
SQL.ADD(" Select Tipo,Codigo from  "~DBO~".CIERREDIARIO Where Habilitado='SI' Order By OrdenEjecucion")
Recorrer SQL

    If EqStr(FBN['Codigo'],'ACTCOT') Y EqStr(FBN['Tipo'],'E')
        ***---Cotizaciones de Mercado
        let &actcot &actcot+1
    Endif
    
    If EqStr(FBN['Codigo'],'ACTBNA') Y EqStr(FBN['Tipo'],'E')
        ***---Cotizaciones BNA y BCU
        let &actbna &actbna+1
    Endif

    ***/// La importacion y el seteo de tasas de hace desde el evento CIETAS
    
    If EqStr(FBN['Codigo'],'ACTTAS') Y EqStr(FBN['Tipo'],'E')
        ***---Tasas Dia
        ***---COMENTAR ACTTAS CUANDO SE IMPLEMENTE PMCONSOLA
        let &acttas &acttas+1
    Endif

    If EqStr(FBN['Codigo'],'REPTAX') Y EqStr(FBN['Tipo'],'E')
        ***---Seteo de Tasas Variables SE
        let &reptax &reptax+1 
    Endif
    
    If EqStr(FBN['Codigo'],'TAVATI') Y EqStr(FBN['Tipo'],'E')
        ***---Impacta Tasas Variables Titulos
        let &tavati &tavati+1
    Endif
    
    **Cintia 181223 Se agrega por PCR
    If EqStr(FBN['Codigo'],'CUOTAP') Y EqStr(FBN['Tipo'],'E')
        let &cuotap &cuotap+1
    Endif
    
    ******EL REPTAS, AJLINK y el AJUCAP se ejecutan de forma diferente dependiendo de si es fin de mes*****
    ACN(x1, SQL("Select 1 from "~DBO~".VARIABLES where Codigo = 'DIASCONT' "))
    if Val(x1)=1
       ACN(x1, Trunc(Var('DIASCONT'),0))
    else
       ACN(x1, 1)
    endif

    If Val(x1) > 0
        ACD(x2, Habiles(PriDeMes(Dialogo.Fecha1,SI)-1,Val(x1),'ARG'))
    Else
        ACD(x2, FinDeMes(Dialogo.Fecha1,NO))
    Endif

    IF Dialogo.Fecha1=Val(x2)
        *Es fin de mes
        If EqStr(FBN['Codigo'],'REPTAS') Y EqStr(FBN['Tipo'],'E')
            ***---Seteo de Tasas Variables MM
            let &reptas &reptas+1
        Endif
        
        If EqStr(FBN['Codigo'],'AJLINK') Y EqStr(FBN['Tipo'],'E')        
            ***---Ajuste USD Link
            let &ajlink &ajlink+1
        Endif
        
        If EqStr(FBN['Codigo'],'AJUCAP') Y EqStr(FBN['Tipo'],'E')        
            *Ajuste Indice Capitalizacion
            let &ajucap &ajucap+1
        Endif
        
        If EqStr(FBN['Codigo'],'CPFUVA') Y EqStr(FBN['Tipo'],'E')        
            *Ajuste Indice Cuotas Partes - Si es mensual, se ejecuta automáticamente
            let &cpfuva &cpfuva+1
        Endif
    ELSE
        *Ejecución diaria
        If EqStr(FBN['Codigo'],'REPTAS') Y EqStr(FBN['Tipo'],'E')
            ***---Seteo de Tasas Variables MM
            let &reptas &reptas+1
        Endif

        If EqStr(FBN['Codigo'],'AJLINK') Y EqStr(FBN['Tipo'],'E')        
            ***---Ajuste USD Link
            let &ajlink &ajlink+1
        Endif        

        If EqStr(FBN['Codigo'],'AJUCAP') Y EqStr(FBN['Tipo'],'E')        
            *Ajuste Indice Capitalizacion
            let &ajucap &ajucap+1
        Endif 
        
        *Ajuste Indice Cuotas Partes - Si es diario, no se tiene que ejecutar en BICE- 121023 issue 6751 ahora se ejecuta para todos
            If EqStr(FBN['Codigo'],'CPFUVA') Y EqStr(FBN['Tipo'],'E')        
                let &cpfuva &cpfuva+1
            Endif
    ENDIF


    ***---Ajuste Limites FCI
    #ifdef BFSA
    #else
        If EqStr(FBN['Codigo'],'AJULIM') Y EqStr(FBN['Tipo'],'E')        
            let &ajulim &ajulim+1
        Endif
    #endif

    **---IF FinDeMes(Dialogo.Fecha1, NO, 'ARG') = Dialogo.Fecha1
    *IF FinDeMes(Dialogo.Fecha1, NO) = Dialogo.Fecha1
        **---Fin de Mes de Lunes a Viernes aunque sea feriado => Reseteo los Precios en Posiciones2
        
      
    If EqStr(FBN['Codigo'],'RESET3') Y EqStr(FBN['Tipo'],'E')        
        **-Pregunto si DIASRESET NO ES MAYOR A DIASCONT    
        IF Var('DIASRESET')<=Var('DIASCONT')    
            *-Busco la variable DIASRESET y la asigno a una variable Local
            IF SQL("Select 1 from "~DBO~".VARIABLES where Codigo = 'DIASRESET' ")=1
                let &diaRESET  Trunc(Var('DIASRESET'),0)
            ELSE
                let &diaRESET 1
            ENDIF
        ELSE
            *-Como DIASRESET es MAYOR que DIASCONT tomo DIASCONT
            IF SQL("Select 1 from "~DBO~".VARIABLES where Codigo = 'DIASCONT' ")=1
                let &diaRESET  Trunc(Var('DIASCONT'),0)
            ELSE
                let &diaRESET 1
            ENDIF
        ENDIF


        IF &diaRESET = 0 Y FinDeMes(Dialogo.Fecha1,NO) = Dialogo.Fecha1    
            let &diaEjecEvento Dialogo.Fecha1
           
            ***---En este caso &diaRESET va a ser = 0 por ende debo pasarle la misma fecha que va a ser validada anteriormente, Fin De Mes.
            let &fechaEjec Dialogo.Fecha1    
        ELSE    
            let &diaEjecEvento Habiles(PriDeMes(Dialogo.Fecha1,SI),-1,,NO) 
            IF DiaSem(&diaEjecEvento)=1
            **Domingo
                let &diaEjecEvento Habiles(&diaEjecEvento,-2,,NO) 
            ELSE
                IF DiaSem(&diaEjecEvento)=7
                **Sabado
                    let &diaEjecEvento Habiles(&diaEjecEvento,-1,,NO)
                ENDIF
            ENDIF
           
            ***---Asigno a una variable el valor de DIASRESET/DIASCONT tomado y luego pregunto si es ese dia del mes para correr el RESET3.  
            let &fechaEjec Habiles(PriDeMes(Dialogo.Fecha1,SI)-1,&diaRESET,'ARG')
        ENDIF
         

        IF &fechaEjec = Dialogo.Fecha1
            let &reset3 &reset3+1
        ENDIF 
    Endif   

    If EqStr(FBN['Codigo'],'CONT0') Y EqStr(FBN['Tipo'],'E')        
        ***---Generacion de Asientos Contables
        let &cont0 &cont0+1
    Endif

    ***---Llamado evento INTCON
    #ifdef BFSA
        If EqStr(FBN['Codigo'],'INTCON') Y EqStr(FBN['Tipo'],'E')        
            let &intcon &intcon+1
            *Check3='Filtra F.Valor'
            *Check1='Filtra Asiento'
            *Check2='Filtra Oper.'
        Endif
    #else
        #ifdef PCR
          If EqStr(FBN['Codigo'],'INTCON') Y EqStr(FBN['Tipo'],'E')        
              let &intcon &intcon+1
          endif
            *pasarle el parámetro Fecha1 con el valor que tiene en el diálogo ya que si no se pasa arroja un Warning.
        #else
            If EqStr(FBN['Codigo'],'INTCON') Y EqStr(FBN['Tipo'],'E')        
                let &intcon &intcon+1
                *Radio1: 'Proceso' 0 = default
                *No filtra Asiento, ni NrOperacion, ni rango de fecha valor, ni TipoOp,
            Endif
        #endif
    #endif

    ***---Intereses Corridos para los proximos 3 dias, pero solo de lunes a viernes
    ACN(DS:1, DiaSem(Dialogo.Fecha1))
    IF Val(DS:1) = 2 o Val(DS:1) = 3
        ***---Lunes o Martes
        If EqStr(FBN['Codigo'],'INT001') Y EqStr(FBN['Tipo'],'E')        
            let &int001 &int001+3
        Endif
        
        If EqStr(FBN['Codigo'],'COPPOS') Y EqStr(FBN['Tipo'],'E')                
            ***---Copiar Posiciones Inicio del dia siguiente
                *Agustin Cocciardi - 27/06/2025
                *A partir de ahora, se copian las posiciones hasta el próximo día hábil
                Recorrer&i 1,Habiles(Dialogo.Fecha1,1,'ARG')-Dialogo.Fecha1
                    IF DiaSem(Dialogo.Fecha1+&i) > 1 Y  DiaSem(Dialogo.Fecha1+&i) < 7
                        let &coppos &coppos+1
                    ENDIF
                Proximo
        Endif
    ELSE
        IF Val(DS:1) = 4
            ***---Miercoles
            If EqStr(FBN['Codigo'],'INT001') Y EqStr(FBN['Tipo'],'E')                    
                let &int001 &int001+3
            Endif
            
            If EqStr(FBN['Codigo'],'COPPOS') Y EqStr(FBN['Tipo'],'E')                            
                ***---Copiar Posiciones Inicio del dia siguiente
                *A partir de ahora, se copian las posiciones hasta el próximo día hábil
                Recorrer&i 1,Habiles(Dialogo.Fecha1,1,'ARG')-Dialogo.Fecha1
                    IF DiaSem(Dialogo.Fecha1+&i) > 1 Y  DiaSem(Dialogo.Fecha1+&i) < 7
                        let &coppos &coppos+1
                    ENDIF
                Proximo
            Endif
        ELSE
            IF Val(DS:1) = 5
                ***---Jueves
                If EqStr(FBN['Codigo'],'INT001') Y EqStr(FBN['Tipo'],'E')                                    
                    let &int001 &int001+3
                Endif
                
                If EqStr(FBN['Codigo'],'COPPOS') Y EqStr(FBN['Tipo'],'E')                            
                    ***---Copiar Posiciones Inicio del dia siguiente
                    *A partir de ahora, se copian las posiciones hasta el próximo día hábil
                    Recorrer&i 1,Habiles(Dialogo.Fecha1,1,'ARG')-Dialogo.Fecha1
                        IF DiaSem(Dialogo.Fecha1+&i) > 1 Y  DiaSem(Dialogo.Fecha1+&i) < 7
                            let &coppos &coppos+1
                        ENDIF
                    Proximo
                Endif
            ELSE
                IF Val(DS:1) = 6
                    ***---Viernes
                    If EqStr(FBN['Codigo'],'INT001') Y EqStr(FBN['Tipo'],'E')                                                            
                        let &int001 &int001+3
                    Endif
                    
                    If EqStr(FBN['Codigo'],'COPPOS') Y EqStr(FBN['Tipo'],'E')                                                
                        ***---Copiar Posiciones Inicio del dia siguiente
                        *A partir de ahora, se copian las posiciones hasta el próximo día hábil
                        Recorrer&i 1,Habiles(Dialogo.Fecha1,1,'ARG')-Dialogo.Fecha1
                            IF DiaSem(Dialogo.Fecha1+&i) > 1 Y  DiaSem(Dialogo.Fecha1+&i) < 7
                                let &coppos &coppos+1
                            ENDIF
                        Proximo
                    Endif
                ENDIF
            ENDIF
        ENDIF
    ENDIF

    
    **CINTIA 250823 tanto diferencia de cambio como rentabilidad se calcularán con un día de atraso (con el cierre de hoy se calcula lo de ayer)
    
    **//Rentabilidad y Diferencia de Cambio para operaciones cargadas hoy con FechaOp anterior teniendo en cuenta la carga de Cotizaciones con FechaValor. 
    *Si hay Op FechaValor y Cotizacion FechaValor y MinFechaOp >= que MinFechaCotiz no hago nada en el recorrer ya que entra en caso 4 (CASO1)
    *Si hay Op FechaValor y Cotizacion FechaValor y MinFechaOp < que MinFechaCotiz hago desde MinFechaOp hasta MinFechaCotiz-1 para cada vh/book iterado de ese caso (CASO2) y despues desde MinFechaCotiz hasta Fsys-1 para todos los vh/book (CASO2 B)
    *Si hay Op FechaValor pero no hay cotizacion FechaValor, hago desde MinFechaOp hasta D.Fecha1 -1 para cada vh/book iterado (CASO3) y después normal (fecha1-1) para todos los vh/book (CASO3 B)
    *Si no hay Op FechaValor pero si hay cotizacion FechaValor, hago desde MinFechaCotiz hasta D.Fecha1 -1 para todos los vh/book (CASO4)
    *Si no hay cotizacion FechaValor ni Op FechaValor (FechaOp<FechaCargasys), hago normal (fecha1-1) para todos los vh/book (comun) (CASO5)
    
    *Identifico la FechaValor mas antigua de las cotizaciones ingresadas en la fecha que se está cerrando    
    let &FechaCotizFV SQL("Select Min(Fecha) from "~DBO~".COTIZACIONES where FechaActualizacion= '"~IdxDate(Dialogo.Fecha1)~"'")
            
    If EqStr(FBN['Codigo'],'DCMM') Y EqStr(FBN['Tipo'],'E')
        ***+++Creamos nuevas funciones para contar las ejecuciones de cada evento segun logica correspondiente
        (.'DCCIERRINF'.)
        let &evento 0
        (.'DCRECIEINF'.) 
    Endif
    
    ***para el caso de rentabilidad sólo se cargará en CIERREDIARIO el RENTAB ya que el RENTLO sólo se ejecuta cuando se cargaron cotizaciones FechaValor pero cumple la misma función.
    If EqStr(FBN['Codigo'],'RENTAB') Y EqStr(FBN['Tipo'],'E')
        (.'RENTCIEINF'.)
        let &evento 1
        (.'DCRECIEINF'.) 
    Endif

    *********

    ***---Vencimiento de Cupones
    ***---LinkearHoja('VTOCUP', 1, Fecha1=Dialogo.Fecha1, Radio1=2)

    If EqStr(FBN['Codigo'],'ALIQUI') Y EqStr(FBN['Tipo'],'I') 
        ***---Movimientos pendientes de liquidar
        let &aliqui &aliqui+1
    Endif

    **CINTIA 111223- Por Vistas
    If EqStr(FBN['Codigo'],'ELIVIS') Y EqStr(FBN['Tipo'],'E') 
        #ifdef BFSA
            let &elivis &elivis+1
        #endif    
    Endif
Proximo  

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(4)

ACT(A:2,'Fecha : '~Dialogo.Fecha1)
SetFont(a:2..a:2,2)

ACT(a:FAC, "Ejecuciones del Cierre")
SetFont(a:fac..a:fac,3)

SetFilaActual(FAC+2)
ACT(a:FAC, 'Tipo')
ACT(b:FAC, 'Codigo')
ACT(c:FAC, 'Nombre')
ACT(d:FAC, 'Ejecución')
AlinearCeldas(a:FAC..d:FAC,'I')
SetFont(a:fac..d:FAC,2)
AgregarMarco(a:FAC..d:FAC,2,0,Exe('COLOR'))

***+++Para la columna de Ejecucion necesito validar los contadores contra la tabla LOGINFORMES para la ultima vez que se haya puesto en 'NO' la variable ABIERTO del dia
ACD(ZZ:1, SQL(" Select MAX(Fecha) from "~DBO~".PMAUDIT Where Codigo = 'ABIERTO' and Tabla = 'VARIABLES' and ValorActual = 'NO' and Fecha between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha1+1)~"' "))

If Vacio(IdxDate(Val(ZZ:1)))
    Cancelar("No se ha ejecutado el Cierre para la fecha:"~Dialogo.Fecha1)
Endif

SQL.ADD(" Select Tipo,Codigo,Nombre from  "~DBO~".CIERREDIARIO Where Habilitado='SI' Order By OrdenEjecucion")

Recorrer SQL
    If EqStr(FBN['Tipo'],'E')
        ACT(A:FAC, 'EVENTO')
    Else
        ACT(A:FAC, 'INFORME')
    Endif
    ACT(B:FAC, FBN['Codigo'])
    ACT(C:FAC, FBN['Nombre']) 
    
    SQL.ADD(" Select COUNT(Codigo) as Contador from "~DBO~".LOGINFORMES")
    SQL.ADD(" Where Codigo = '"~Val(B:FAC)~"' AND ")
    SQL.ADD(" Fecha >= '"~IdxDate(Val(ZZ:1))~"' AND Fecha < '"~IdxDate(Dialogo.Fecha1+1)~"' ")    
    let &ejecutado 0
    watch(sql.batch)
    Recorrer SQL 
        DFA
        If EqStr(Val(B:FAC),'ACTCOT') Y &actcot = FBN['Contador']
            let &ejecutado 1  
        Endif
         If EqStr(Val(B:FAC),'ACTBNA') Y &actbna = FBN['Contador']
            let &ejecutado 1  
        Endif
         If EqStr(Val(B:FAC),'ACTTAS') Y &acttas = FBN['Contador']
            let &ejecutado 1  
        Endif
         If EqStr(Val(B:FAC),'REPTAX') Y &reptax = FBN['Contador']
            let &ejecutado 1  
        Endif
         If EqStr(Val(B:FAC),'TAVATI') Y &tavati = FBN['Contador']
            let &ejecutado 1  
        Endif
         If EqStr(Val(B:FAC),'REPTAS') Y &reptas = FBN['Contador']
            let &ejecutado 1  
        Endif
         If EqStr(Val(B:FAC),'AJLINK') Y &ajlink = FBN['Contador']
            let &ejecutado 1  
        Endif
         If EqStr(Val(B:FAC),'AJUCAP') Y &ajucap = FBN['Contador']
            let &ejecutado 1  
        Endif
         If EqStr(Val(B:FAC),'CPFUVA') Y &cpfuva = FBN['Contador']
            let &ejecutado 1  
        Endif
         If EqStr(Val(B:FAC),'AJULIM') Y &ajulim = FBN['Contador']
            let &ejecutado 1  
        Endif
         If EqStr(Val(B:FAC),'RESET3') Y &reset3 = FBN['Contador']
            let &ejecutado 1  
        Endif
         If EqStr(Val(B:FAC),'INT001') Y &int001 = FBN['Contador']
            let &ejecutado 1  
        Endif
         If EqStr(Val(B:FAC),'COPPOS') Y &coppos = FBN['Contador']
            let &ejecutado 1  
        Endif
         If EqStr(Val(B:FAC),'DCMM') Y &dcmm = FBN['Contador']
            let &ejecutado 1  
        Endif
         If EqStr(Val(B:FAC),'RENTAB') Y &rentab = FBN['Contador']
            let &ejecutado 1  
        Endif
         If EqStr(Val(B:FAC),'CONT0') Y &cont0 = FBN['Contador']
            let &ejecutado 1  
        Endif
         If EqStr(Val(B:FAC),'INTCON') Y &intcon = FBN['Contador']
            let &ejecutado 1  
        Endif
         If EqStr(Val(B:FAC),'ALIQUI') Y &aliqui = FBN['Contador']
            let &ejecutado 1  
        Endif
         If EqStr(Val(B:FAC),'ELIVIS') Y &elivis = FBN['Contador']
            let &ejecutado 1  
        Endif
         If EqStr(Val(B:FAC),'DCMMLT') Y &dcmmlt = FBN['Contador']
            let &ejecutado 1  
        Endif
         If EqStr(Val(B:FAC),'RENTLO') Y &rentlo = FBN['Contador']
            let &ejecutado 1  
        Endif        
        If &ejecutado = 1
            ACT(D:FAC, 'Finalizo correctamente')
            ColorCeldas(D:FAC, clGreen)
        Else
            ACT(D:FAC, 'No finalizo correctamente')
            ColorCeldas(D:FAC, clRed)
        Endif    
    Proximo
     
Proximo

ACO(3,25)
ACO(4,18)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(E:FAC)

