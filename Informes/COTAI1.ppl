MostrarCuadroDeMensajes
CrearDialogo
  Fecha1           :  'F. Desde'           ;1;;;;;;;;FSYS
  Fecha2           :  'F. Hasta'           ;2;;;;;;;;FSYS
  Vehiculo1        :  'Vehiculo'           ;3;;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar un Vehiculo';NO;Var('DDVEHDEF')
  Book1            :  'Book'               ;4;;;;;EqStr(Dialogo.Vehiculo1,BuscarCampo('BOOKS','Vehiculo','Codigo',Dialogo.Book1));'El book ingresado no corresponde al Vehiculo';NO;Var('BOOKDDCHE');BuscarCampo('VEHICULOS','Alias5','Codigo',Dialogo.Vehiculo1);;;;" Vehiculo = '"~Dialogo.Vehiculo1~"'"  
FinDialogo

If Not Ok 
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,12,B')
CrearFont(4, 'Arial,8,BI')

let &filaLogo 1
@LOGO


SetFilaActual(fac+3)

ACT(F:1, 'Operaciones con Tasa Incumplida')
SetFont(F:1, 3)
SetFilaActual(fac+2)

***---HEADER---***
ACT(A:fac,'Fecha Desde:')
ACT(C:fac,Dialogo.Fecha1)
ifa
ACT(A:fac,'Fecha Hasta:')
ACT(C:fac,Dialogo.Fecha2)
ifa
If NoVacio(Dialogo.Vehiculo1)
    ACT(A:fac,'Vehiculo:')
    ACT(C:fac,Dialogo.Vehiculo1)
    ifa
EndIf
If NoVacio(Dialogo.Book1)
    ACT(A:fac,'Book:')
    ACT(C:fac,Dialogo.Book1)
    ifa
EndIf
SetFont(A:&fi1..A:fac, 2)
SetFont(B:&fi1..B:fac, 2)
ifa


***---COLUMNAS---***
ACT(A:fac, 'NrOperacion')
ACT(B:fac, 'Tasa Op')
ACT(C:fac, 'Tasa Instrumento')
ACT(D:fac, 'Instrumento')
ACT(E:fac, 'Plazo Instrumento') 
ACT(F:fac, 'Subasta')
ACT(G:fac, 'Segmento')
ACT(H:fac, 'Moneda')
ACT(I:fac, 'Contraparte')
ACT(J:fac, 'Concertacion')
ACT(K:fac, 'Liquidacion')
ACT(L:fac, 'Id.Cheque')
ACT(M:fac, 'Acreditacion')
ACT(N:fac, 'Monto')
ACT(O:fac, 'Comitente') 
ACT(P:fac, 'Cod.Ch.CVSA')
ACT(Q:fac, 'Sin Recurso')
ACT(R:fac, 'No a la Orden')
ACT(S:fac, 'E.Pyme')
ACT(T:fac, 'Primera.Neg')
ACT(U:fac, 'CUIT Librador')
ACT(V:fac, 'LIBRADOR')
ACT(W:fac, 'Boleto')
  
AlinearCeldas(A:fac..AY:fac,'C')
SetFont(A:fac..AY:fac, 2)
AgregarMarco(A:fac..AY:fac, 0, 0, Exe('COLOR'))
Let &filaInicial fac+1

***---QRY---***
SQL.ADD("   SELECT NrOperacion,     NrOperacion2,       CB1,                      Especie,       TipoOp, ")
SQL.ADD("   Precio1,         Cliente2,           FechaOp,                  Hora1,         Hora2, ")
SQL.ADD("   FechaPago,       NrOperacion3,       NrOperacion4,             Cliente3,      OperacionRef, ")
SQL.ADD("   FechaVto2,       TotalBrutoCli1,     TotalIntereses,           Cantidad,      ImpComMer1,  ")
SQL.ADD("   ImpGastos1,      Cliente1,           MensajeChequeo,           MB2,           Numerador,")
SQL.ADD("   ObservacDoc,     ContraEspecie,      TipoCambio,               CB2,           CB3, ")
SQL.ADD("   FechaVto,        NrSucursal,         CB4,                      CB5,           NrBoleto, ")
SQL.ADD("   TotalImpuestos,  Plazo,              TipoDoc,                  FechaCarga,    FechaCargaSys,")
SQL.ADD("   Cliente4,        Contrato,           Vehiculo1,                CodComitente,  Book1,     ")
SQL.ADD("   Cuenta1,         RB1,                FechaEj,                  Fecha2,        Plaza1  ") 
SQL.ADD("   FROM "~DBO~".OPERACIONES ")
SQL.ADD("WHERE  FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' AND FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"'  ")
If NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("  AND Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
If NoVacio(Dialogo.Book1)
    SQL.ADD("  AND Book1 = '"~Dialogo.Book1~"' ")
Endif 
SQL.ADD(" AND TipoOp IN ('DDC')   ") 
WATCH(SQL.BATCH)

Recorrer SQL
    let &plazoOp fbn('Plazo')
    let &tasaOp fbn('Precio1')
    let &fuente fbn('Plaza1')
    let &tasaInclumplida 0
    
    SQL.ADD("Select TD.Valor1 TasaInstrum from TASASDIA TD, TIPOSTASA TT ")
    SQL.ADD("Where TT.Codigo = TD.TipoTasa and TT.PrecioRef = '"~&fuente~ "' ")
    SQL.ADD("and TD.PlazoHasta = (Select Min(PlazoHasta) from TASASDIA TD2, TIPOSTASA TT2 Where TT2.PrecioRef = TT.PrecioRef AND PlazoHasta >= '"~FsTr(&plazoOp)~"'")
    SQL.ADD("                    AND TT2.Codigo = TD2.TipoTasa) ")
    SQL.ADD("and TD.Fecha = (Select MAX(T1.Fecha) FROM dbo.TASASDIA T1 where T1.TipoTasa = TD.TipoTasa and T1.Fecha <= '"~IdxDate(fbn('FechaOp'))~"') ")
    Recorrer SQL 
        DFA
        let &tasaInstrumento fbn('TasaInstrum')
        If &tasaOp<fbn('TasaInstrum')
            let &tasaIncumplida 1
        EndIf
    Proximo   
    
    If &tasaIncumplida = 1
        ACT(A:fac, fbn('NrOperacion'))
        ACLO(A:fac, fbn('NrOperacion'))
        ACN(B:fac, &tasaOp)
        ACN(C:fac, &tasaInstrumento)
        ACT(D:fac, fbn('TipoDoc')) 
        ACT(E:fac, fbn('Plazo'))
        
        ACT(F:fac, fbn('NrOperacion2'))
                
        IF fbn('CB1') = 1
            ACT(G:fac, 'Avalado')
        ELSE
            IF fbn('CB1') = 0
                ACT(G:fac, 'No Avalado')
            Endif
        ENDIF
        
        ACT(H:fac, fbn('Especie'))
        ACT(I:fac, fbn('Cliente2'))
        ACD(J:fac, fbn('FechaOp'))
        ACD(K:fac, fbn('FechaPago'))
        ACT(L:fac, fbn('NrOperacion4'))
        ACD(M:fac, fbn('FechaVto2'))
        ACN(N:fac, fbn('TotalBrutoCli1'))
        ACT(O:fac, fbn('CodComitente')) 
        ACT(P:fac, fbn('ObservacDoc'))

        IF fbn('CB2') = 0
            ACT(Q:fac, 'No')
        ELSE
            IF fbn('CB2') = 1
                ACT(Q:fac, 'Si')
            Endif
        ENDIF
        IF fbn('CB3') = 0
            ACT(R:fac, 'No')
        ELSE
            IF fbn('CB3') = 1
                ACT(R:fac, 'Si')
            Endif
        ENDIF
       
        IF fbn('CB4') = 0
            ACT(S:fac, 'No')
        ELSE
            IF fbn('CB4') = 1
                ACT(S:fac, 'Si')
            Endif
        ENDIF

        IF fbn('CB5') = 0
            ACT(T:fac, 'No')
        ELSE
            IF fbn('CB5') = 1
                ACT(T:fac, 'Si')
            Endif
        ENDIF
        ACT(U:fac, fbn('Contrato'))
        ACT(V:fac, '-')
        ACT(W:fac, fbn('NrBoleto'))

    Else
        DFA
    EndIf
Proximo

AlinearCeldas(A:&filaInicial..A:fac,'C')
FormatoCeldas(B:&filaInicial..B:fac, Exe('F8'))
FormatoCeldas(C:&filaInicial..C:fac, Exe('F8'))
