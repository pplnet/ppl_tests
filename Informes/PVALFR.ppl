MostrarCuadroDeMensajes
CrearDialogo
  Fecha1   : 'Fecha'    ;1;1;;;;Dialogo.Fecha1<>0;'Fecha invalida';NO;Fsys
  Especie1 : 'Especie'  ;2;1;;;;Vacio(Dialogo.Especie1) o DesciendeDeEspecie(Dialogo.Especie1, 'FONDOS');'Especie invalida';NO;;;;;;;;
  Vehiculo1: 'Vehiculo' ;3;1;;;;Vacio(Dialogo.Vehiculo1) o Incluido(Dialogo.Vehiculo1, IIF(NoVacio(UsrVehiculos(UsuarioActivo)), UsrVehiculos(UsuarioActivo), SQLSet(" Select Codigo From "~DBO~".VEHICULOS ")));'Debe Ingresar un Vehiculo Valido';NO;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') OR Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' "),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and ((Status='HAB' or Status Is Null or Status='') or V.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"') "))
  Lista3   : 'Books'    ;4;1;;;;;;;;;SQLSET("Select Codigo From "~DBO~".BOOKS");
FinDialogo
if NOT OK
  Cancelar
endif

CrearFont(1,"Arial,12,BI")
CrearFont(2,"Arial,10,B")
CrearFont(3,"Arial,10,")
CrearFont(4,"Arial,8,BU")
CrearFont(5,"Arial,8,BI")
CrearFont(6,"Arial,8,B")
CrearFont(7,"Arial,8,")

If NoVacio(Dialogo.Vehiculo1)
  ACT(az:6, Dialogo.Vehiculo1)
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    ACT(az:6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and ((Status='HAB' or Status Is Null or Status='') or V.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"') "))
  Else
    ACT(az:6,SQLSET("Select V.Codigo FROM "~DBO~".VEHICULOS V where (Status='HAB' or Status Is Null or Status='') OR Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ") )
  EndIf
Endif

SetFilaActual(1)
ACT(a:fac,'Posicion Fondos')
SetFont(a:fac,1)

SetFilaActual(fac+2)
ACT(a:fac  ,'Fecha:')
ACT(b:fac  ,Dialogo.Fecha1)
ACT(a:fac+1,'Especie:')
if NoVacio(Dialogo.Especie1)
  ACT(b:fac+1, Dialogo.Especie1~' - '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1))
else
  ACT(b:fac+1,'TODAS')
endif
ACT(a:fac+2, 'Vehiculo:')
ACT(b:fac+2, Val(az:6))
ACT(a:fac+3, 'Book:')
if NoVacio(Dialogo.Lista3)
  ACT(b:fac+3, Dialogo.Lista3)
else
  ACT(b:fac+3,'TODOS')
endif
SetFont(a:fac..a:fac+3,3)
SetFont(b:fac..b:fac+3,2)

SetFilaActual(fac+5)
ACT(A:fac  , 'Vehiculo')
ACT(B:fac  , 'Especie')
*ACT(C:fac  , 'Cupon')
ACT(D:fac  , 'Cotiza')
ACT(F:fac  , 'Expresado en ARP')
ACT(E:fac+1, 'Pos.Final')
ACT(F:fac+1, 'Cotizacion')
ACT(G:fac+1, 'Pos.Val.')

ACT(I:fac  , 'Expresado en USD')
ACT(H:fac+1, 'Pos.Final')
ACT(I:fac+1, 'Cotizacion')
ACT(J:fac+1, 'Pos.Val.')

SetFont(A:fac..J:fac+1,6)
AlinearCeldas(A:fac..D:fac+1,'I')
AlinearCeldas(E:fac..J:fac,'C')
AlinearCeldas(E:fac+1..E:fac+1,'I')
AlinearCeldas(E:fac+1..J:fac+1,'D')
AgregarMarco(a:fac..D:fac+1,0,0,EXE('COLOR6'))
AgregarMarco(E:fac..G:fac+1,0,0,EXE('COLOR6'))
AgregarMarco(H:fac..J:fac,0,0,EXE('COLOR6'))
AgregarMarco(a:fac+1..J:fac+1,0,0,EXE('COLOR6'))

IFA
ACN(aw:1, FAC+2)
ACN(aw:2, FAC+2)
ACT(az:1,'')

SQL.ADD("Select P.Vehiculo, V.Descripcion, P.Especie, E.Nombre, E.Cotiza, E.InteresesC, ")
SQL.ADD("       P.Cupon, P.Fecha, P.NrSaldo, ")
SQL.ADD("       P.CantidadIni, P.PrecioIni, ")
SQL.ADD("       P.Cantidad1, P.Precio1, ")
SQL.ADD("       P.Cantidad2, P.Precio2, ")
SQL.ADD("       P.CantidadFin, P.PrecioFin ")
SQL.ADD(" from   "~DBO~".POSICIONES P, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V ")
SQL.ADD(" where P.Especie      =  E.Codigo ")
SQL.ADD("  and  P.Vehiculo     =  V.Codigo ")
SQL.ADD("  and  NrSaldo        in (121,131) ")
SQL.ADD("  and  P.TipoNegocio  =  'FC' ")
SQL.ADD("  and  P.Vehiculo     In  ("~Pipe2Comillas(val(az6))~") ")
if NoVacio(Dialogo.Especie1)
  SQL.ADD("  and  P.Especie   = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Lista3)
  SQL.ADD("  and  P.Book   in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
endif
SQL.ADD("  and  P.Fecha     = (select Max(Fecha) ")
SQL.ADD("                       from  "~DBO~".POSICIONES ")
SQL.ADD("                       where Especie     = P.Especie ")
SQL.ADD("                        and  IsNull(Cupon,'') = IsNull(P.Cupon,'') ")
SQL.ADD("                        and  Vehiculo    =  P.Vehiculo ")
SQL.ADD("                        and  IsNull(Book,'') = IsNull(P.Book,'') ")
SQL.ADD("                        and  NrSaldo     =  P.NrSaldo ")
SQL.ADD("                        and  TipoNegocio = P.TipoNegocio ")
SQL.ADD("                        and  Fecha    <= "~IdxDate2(Dialogo.Fecha1)~" ) ")
SQL.ADD(" order by P.Vehiculo, P.Especie, IsNull(P.Cupon,''), P.NrSaldo, P.Fecha ")
watch(SQL.Batch)
Recorrer SQL
 If fbn('CantidadFin')>1 O fbn('CantidadFin')<-1
  message(fbn('Vehiculo')~' '~FStr(fbn('NrSaldo'),1,0)~' '~IdxDate(fbn('Fecha'))~' '~PyC(fbn('CantidadFin'),1,2))
  If Not EqStr(fbn('Vehiculo'),Val(az:1))
    SetFont(B:Val(aw:2)..an:fac,7)
    ifa
    ACT(az:1,fbn('Vehiculo'))
    ACT(az:2,'')
    ACT(az:3,'')
    ACT(A:fac, 'Vehiculo: '~fbn('Vehiculo')~' - '~fbn('Descripcion'))
    SetFont(A:fac,4)
    ifa
    ACN(aw:2, FAC)
   Endif

   if EqStr(fbn('Especie'),Val(az:2))
    DFA
   else
    ACT(A:fac  , BuscarCampo('VEHICULOS','Descripcion','Codigo',fbn('Vehiculo')))
    ACT(B:fac, fbn('Especie')~' '~fbn('Nombre'))
    ACT(C:fac, fbn('Cupon'))
    ACT(D:fac, fbn('Cotiza'))
    ACT(az:2, fbn('Especie'))
    ACT(az:3, fbn('Cupon'))
   endif

   if fbn('Nrsaldo')=121
    ACN(az:4, 5)
    ACT(az:5, 'ARP')
    ACN(az:6, 30)
   else
    ACN(az:4, 8)
    ACT(az:5, 'USD')
    ACN(az:6, 35)
   endif
    
  SCN(Val(az:4):fac, fbn('CantidadFin'))

  if SQL(" Select 1 From "~DBO~".COTIZACIONES where Codigo = '"~fbn('Especie')~"' AND Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ") = 1
     ACN(Val(az:4)+1:fac, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,NO,Val(az:5)))
  else
     ACN(Val(az:4)+1:fac, 0)
  endif  

  ACN(Val(az:4)+2:fac, Val(Val(az:4):fac)*Val(Val(az:4)+1:fac))
 else
  DFA
 endif
Proximo

SetFont(B:Val(aw:2)..an:fac,7)

FormatoCeldas(E:Val(aw:1)..J:fac,Exe('F2'))
FormatoCeldas(F:Val(aw:1)..F:fac,Exe('F8'))
FormatoCeldas(I:Val(aw:1)..I:fac,Exe('F8'))

SetFilaActual(FAC+2)
ACT(a:FAC, 'Fin del Listado')
SetFont(a:FAC,6)

ACO( 1,22)
ACO( 2,12)
ACO( 3, 5)
ACO( 4, 5)

ACO( 5, 8)
ACO( 6, 8)
ACO( 7, 8)
ACO( 8, 8)
ACO( 9, 8)
ACO( 10, 8)

LimitesVision(J:fac)
SetPrintFit(3,90)
Impresion(1,1)
Impresion(2,1)
Impresion(4,1)
SetMargins(0,0,0,2)
