HojaVisible(No)
ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1   : 'Fecha'             ;;;;;;;;;FSys
  Lista1   : 'Vehiculo'          ;;;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "));
  Radio1   : 'Consolidado|Si|No' ;;;;;;;;;0
  Radio2   : 'Expresado|ARP|USD' ;;;;;;;;;0
FinDialogo

if not OK
  Cancelar
endif

*- Control de Vehiculo Habilitado
ACT(zz6, IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")) )
 
if Dialogo.Radio1=1
   *** SELECCIONO SWAPS DE INTERES
   *************** Selecciono operaciones con Vto Simple *****
   SQL.ADD("Select 1 Orden, O.Vehiculo1, O.FechaCargaSys, O.Cliente1, O.NrOperacion,O.Especie, O.ContraEspecie, O.FechaOp, O.FechaEj FVto, ")
   SQL.ADD("O.FechaOp2 FInicio, O.FechaEj FFin, O.Cantidad ResidualV, O.TotalBrutoCli1 ResidualC, O.Precio3 VTasa, O.TotalGanancias CTasa, O.Spread VSpread, O.TotalNetoCli2 CSpread, ")
   SQL.ADD(" O.TotalIntereses VTotInt, O.InteresesCorr CTotInt, O.TipoOp, O.RB9, O.RB8, O.TotalAux3, O.TotalBrutoCli2, O.FechaPago, 0 Cantidad5, 0 Cantidad6, 0 Cuotas1 ")
   SQL.ADD("from "~DBO~".OPERACIONES O ")
   SQL.ADD("where O.Especie=O.ContraEspecie AND ")
   SQL.ADD(" (TipoOp IN ('DTSFV','DTSFF','DTSVV','DTSFVV') and O.FechaOp2<='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaEj>='"~IdxDate(Dialogo.Fecha1)~"')   ")
   if NoVacio(Dialogo.Lista1)
      SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   Else
      SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Val(zz6))~") ")
   endif
   SQL.ADD("  Union All ")
   *************** Selecciono operaciones con Vto Multiple
   SQL.ADD("Select 1 Orden, O.Vehiculo1, O.FechaCargaSys, O.Cliente1, O.NrOperacion, O.Especie, O.ContraEspecie, O.FechaOp, CASE O.TipoOp WHEN 'DTSFVX' THEN O.FechaEx2 WHEN 'DTSNFV' THEN O.FechaEx2 ELSE C.Fecha2 END FVto, ")
   SQL.ADD("C.Fecha1 FInicio, C.Fecha2 FFin, C.Cantidad1 ResidualV, C.Cantidad2 ResidualC, C.Precio1 VTasa, C.Precio2 CTasa, C.Total3 VSpread, C.Total4 CSpread, ")
   SQL.ADD(" C.Cantidad3 VTotInt, C.Cantidad4 CTotInt, O.TipoOp, O.RB9, O.RB8, O.TotalAux3, O.TotalBrutoCli2, C.Fecha3 FechaPago, C.Cantidad5, C.Cantidad6, O.Cuotas1 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD(" where O.NrOperacion = C.NrOperacion AND O.Especie=O.ContraEspecie ")
   SQL.ADD("  and ((TipoOp IN ('DTSFFM','DTSFVM','DTSFVX','DTSVVM') and C.Fecha1<='"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"') ")
   SQL.ADD("  or (TipoOp IN ('DTSNFV') and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"')) ")
   if NoVacio(Dialogo.Lista1)
      SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   Else
      SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Val(zz6))~") ")
   endif
   SQL.ADD("  Union All ")
 
   *** SELECCIONO SWAPS DE TIPO DE CAMBIO
   *************** Selecciono operaciones con Vto Simple *****
   SQL.ADD("Select 2 Orden, O.Vehiculo1, O.FechaCargaSys, O.Cliente1, O.NrOperacion,O.Especie, O.ContraEspecie, O.FechaOp, O.FechaEj FVto, ")
   SQL.ADD("O.FechaOp2 FInicio, O.FechaEj FFin, O.Cantidad ResidualV, O.TotalBrutoCli1 ResidualC, O.Precio3 VTasa, O.TotalGanancias CTasa, O.Spread VSpread, O.TotalNetoCli2 CSpread, ")
   SQL.ADD(" O.TotalIntereses VTotInt, O.InteresesCorr CTotInt, O.TipoOp, O.RB9, O.RB8, O.TotalAux3, O.TotalBrutoCli2, O.FechaPago, 0 Cantidad5, 0 Cantidad6, 0 Cuotas1 ")
   SQL.ADD("from "~DBO~".OPERACIONES O ")
   SQL.ADD("where O.Especie<>O.ContraEspecie AND ")
   SQL.ADD(" (TipoOp IN ('DTSFV','DTSFF','DTSVV','DTSFVV') and O.FechaOp2<='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaEj>='"~IdxDate(Dialogo.Fecha1)~"')   ")
   if NoVacio(Dialogo.Lista1)
      SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   Else
      SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Val(zz6))~") ")
   endif
   SQL.ADD("  Union All ")
   *************** Selecciono operaciones con Vto Multiple
   SQL.ADD(" Select 2 Orden, O.Vehiculo1, O.FechaCargaSys, O.Cliente1, O.NrOperacion, O.Especie, O.ContraEspecie, O.FechaOp, CASE O.TipoOp WHEN 'DTSFVX' THEN O.FechaEx2 WHEN 'DTSNFV' THEN O.FechaEx2 ELSE C.Fecha2 END FVto, ")
   SQL.ADD(" C.Fecha1 FInicio, C.Fecha2 FFin, C.Cantidad1 ResidualV, C.Cantidad2 ResidualC, C.Precio1 VTasa, C.Precio2 CTasa, C.Total3 VSpread, C.Total4 CSpread, ")
   SQL.ADD(" C.Cantidad3 VTotInt, C.Cantidad4 CTotInt, O.TipoOp, O.RB9, O.RB8, O.TotalAux3, O.TotalBrutoCli2, C.Fecha3 FechaDePago, C.Cantidad5, C.Cantidad6, O.Cuotas1 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD(" where O.NrOperacion = C.NrOperacion AND O.Especie<>O.ContraEspecie ")
   SQL.ADD("  and ((TipoOp IN ('DTSFFM','DTSFVM','DTSFVX','DTSVVM') and C.Fecha1<='"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"') ")
   SQL.ADD("  or (TipoOp IN ('DTSNFV') and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"')) ")
   if NoVacio(Dialogo.Lista1)
      SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   Else
      SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Val(zz6))~") ")
   endif

   SQL.ADD("Union All ")

   SQL.ADD(" Select 1 Orden, O.Vehiculo1, O.FechaCargaSys, O.Cliente1, O.NrOperacion, O.Especie, O.Especie ContraEspecie, O.FechaOp, C.Fecha2 FVto, ")
   SQL.ADD(" C.Fecha1 FInicio, C.Fecha2 FFin, C.Cantidad1 ResidualV, C.Cantidad2 ResidualC, C.Precio1 VTasa, C.Precio2 CTasa, C.Total3 VSpread, C.Total4 CSpread, ")
   SQL.ADD(" C.Cantidad3 VTotInt, C.Cantidad4 CTotInt, O.TipoOp, '1' as RB9, O.RB8, O.TotalAux3, O.TotalAux3 TotalBrutoCli2, C.Fecha3 FechaDePago, C.Cantidad5, C.Cantidad6, O.Cuotas1 ")
   SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD("and TipoOp IN ('DTCAP','DTFLO') and C.Fecha1<='"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" order by 1,2,3 ")
   ACN(ba1,0)

   Recorrer SQL
      SCN(ba1,1)
      LinkearHoja('POSWA1', Val(ba1), Fecha1=Dialogo.Fecha1, Lista1=FBN['Vehiculo1'], Radio1=Dialogo.Radio1, Radio2=Dialogo.Radio2)
   Proximo
else
   LinkearHoja('POSWA1', 1, Fecha1=Dialogo.Fecha1,Lista1=IIF(NoVacio(Dialogo.Lista1),Dialogo.Lista1,Val(zz6)),Radio2=Dialogo.Radio2)
endif