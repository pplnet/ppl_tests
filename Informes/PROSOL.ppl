HojaVisible(SI)
IF Vacio(UsrVehiculos(UsuarioActivo))
    ACT(LS:1, SQLSet(" Select Codigo from "~DBO~".VEHICULOS where Status = 'HAB' "))
ELSE
    ACT(LS:1, UsrVehiculos(UsuarioActivo))
ENDIF
MostrarCuadrodeMensajes
DialogoVisible(SI)
CrearDialogo
  Fecha1      : 'Fecha'                        ;;;;;;Dialogo.Fecha1<>0;'Debe ingresar una Fecha';NO;FSYS
  Lista1      : 'Vehiculos'                    ;;1;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), Val(LS:1), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where V.Codigo = U.Vehiculo AND U.Codigo = '"~UsuarioActivo~"' AND V.Status = 'HAB' "));;
  TipoOrd1    : 'Tipo Orden'                   ;-5;2;;;;Vacio(Dialogo.TipoOrd1) o (Eqstr(Dialogo.TipoOrd1, 'PROINV') o Eqstr(Dialogo.TipoOrd1, 'SOLFON'));'Debe ingresar un tipo de Orden válido';NO;;;;;;"Codigo IN('PROINV','SOLFON')"
FinDialogo

if Not Ok
  Cancelar
endif



CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,16,B')


let &filaLogo 1
(.'LOGO'.)


SetFilaActual(fac+3)

ACT(d:1, 'Estado de Propuesta de Inversión y Solicitud de Fondos')
SetFont(d:1, 3)
SetFilaActual(fac+2)

***---Header  
ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
ifa

If NoVacio(Dialogo.Lista1)
    ACT(A:fac, 'Vehiculo: '~Dialogo.Lista1)
    ifa
Else
    ACT(A:fac, 'Vehiculos: Todos')
    ifa
Endif

If NoVacio(Dialogo.TipoOrd1)
    ACT(A:fac, 'Tipo Orden: '~Dialogo.TipoOrd1)
Else
    ACT(A:fac, 'Tipo Orden: Todas')
Endif

SetFont(A:&fi1..A:fac, 2)
SetFont(B:&fi1..B:fac, 2)
ifa

***---Columnas
ACT(A:fac, 'Nro. Orden')
ACT(B:fac, 'Tipo Orden')
ACT(C:fac, 'Instancia')
ACT(D:fac, 'Vehiculo')
ACT(E:fac, 'Book')
ACT(F:fac, 'Monto Total')
ACT(G:fac, 'Moneda')
ACT(H:fac, 'Monto ya aplicado')
ACT(I:fac, 'Monto sin aplicar')
ACT(J:fac, 'Fecha Inicio')
ACT(K:fac, 'Plazo')

AlinearCeldas(A:fac..K:fac,'C')
SetFont(A:fac..K:fac, 2)
AgregarMarco(A:fac..K:fac, 0, 0, Exe('COLOR'))
Let &filaInicial fac+1
 
***---Query
SQL.ADD("  SELECT O.CantidadCompletada, O.NrOrden,  O.TipoOrden, O.Vehiculo, O.Book1, O.CantidadTotalOrden, ") 
SQL.ADD("   O.Especie, O.FechaOrden, O.Plazo1, OB.NrBit  ") 
SQL.ADD("   FROM "~DBO~".ORDENES O ")
SQL.ADD("JOIN "~DBO~".OPERACIONESBITS OB ON OB.NrOperacion = O.NrOrden ")
SQL.ADD(" WHERE OB.Valor = 1 ")
SQL.ADD("AND O.FechaOrden =  '"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(Dialogo.Lista1)
    SQL.ADD("AND O.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif 
If NoVacio(Dialogo.TipoOrd1)
    SQL.ADD(" AND O.TipoOrden = '"~Dialogo.TipoOrd1~"'   ")
Else
    SQL.ADD(" AND O.TipoOrden IN ('PROINV','SOLFON')   ")
Endif

WATCH(SQL.BATCH)

Recorrer SQL

    ACT(A:fac, fbn('NrOrden'))    
    ACLR(A:fac, fbn('NrOrden'))    
    ACT(B:fac, fbn('TipoOrden'))
    
    SQL.ADD("SELECT NrInstancia, Nombre FROM "~DBO~".INSTANCIAS WHERE NrInstancia = "~Fstr(fbn('NrBit'),0,0)~" AND Tabla = 'ORDENES' ")
    Recorrer SQL
        dfa
        ACT(C:fac, fbn('NrInstancia')~'-'~fbn('Nombre'))         
    Proximo      
    ACT(D:fac, fbn('Vehiculo'))
    ACT(E:fac, fbn('Book1'))
    ACN(F:fac, fbn('CantidadTotalOrden'))
    ACT(G:fac, fbn('Especie'))
    ACN(H:fac, fbn('CantidadCompletada'))
    ACN(I:fac, Val(F:fac) - Val(H:fac))
    ACD(J:fac, fbn('FechaOrden'))
    ACN(K:fac, fbn('Plazo1'))
    
    
Proximo

SetFont(A:&filaInicial..K:fac, 1)
FormatoCeldas(K:&filaInicial..K:fac, Exe('F0'))
FormatoCeldas(f:&filaInicial..I:fac, Exe('F2'))
