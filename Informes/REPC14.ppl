let &fechaBonInd2 Dialogo.Fecha2


SetFilaActual(1)

******FECHA DE POSICIONES*******
*Si la fecha es un sábado, se elige el viernes anterior
If DiaSem(Dialogo.Fecha2) = 7 
    let &fechaPosiciones2 Dialogo.Fecha2-1
else
    *Si la fecha es un domingo, se elige el viernes anterior
    If DiaSem(Dialogo.Fecha2) = 1 
        let &fechaPosiciones2 Dialogo.Fecha2-2
    else
        *sino, se deja la fecha del diálogo
        let &fechaPosiciones2 Dialogo.Fecha2
    Endif
Endif
