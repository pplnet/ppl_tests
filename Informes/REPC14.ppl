CrearDialogo
  Fecha1:    'Fecha Desde'                     ;;;;;;Dialogo.Fecha1>=Fecha(VAR('FECHAMIGRA'));'La fecha desde no puede ser menor al '~VAR('FECHAMIGRA');NO;PriDeMes(Habiles(PriDeMes(FSys,SI),-1,SI))
  Fecha2:    'Fecha Hasta'                     ;;;;;;Dialogo.Fecha2<=FSys;'La fecha Hasta no puede ser mayor a hoy';NO;FinDeMes(Dialogo.Fecha1,SI)
  Vehiculo1: 'Vehiculo'                        ;;;;;;;;;;;
  Lista1:    'Books'                           ;;;;;;;;;;;;;;;;
  Radio2:    'Expresado en|ARP|USD'            ;;;;;;;;;0
  Radio3:    'Expresado en|Millones|ImporteOri';;;;SI;SI;;;;0;;;;;
FinDialogo

IF Not OK
  Cancelar
ENDIF

