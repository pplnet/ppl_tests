ACT(AW:fac, 'Estado') 
ACT(AX:fac, 'Fecha Cobro MAV') 
ACT(AY:fac, 'Fecha Cobro Directo') 
  
AlinearCeldas(A:fac..AY:fac,'C')
SetFont(A:fac..AY:fac, 2)
AgregarMarco(A:fac..AY:fac, 0, 0, Exe('COLOR'))
Let &filaInicial fac+1
 
***---Query
SQL.ADD("SELECT")
SQL.ADD("   O.NrOperacion,    O.NrOperacion2,    O.CB1,             O.Especie,       O.TipoOp, ")
SQL.ADD("   O.Precio1,        O.Cliente2,        O.FechaOp,         O.Hora1,         O.Hora2, ")
SQL.ADD("   O.FechaPago,      O.NrOperacion3,    O.NrOperacion4,    O.Cliente3,      O.OperacionRef, ")
SQL.ADD("   O.FechaVto2,      O.TotalBrutoCli1,  O.TotalIntereses,  O.Cantidad,      O.ImpComMer1,  ")
SQL.ADD("   O.ImpGastos1,     O.Cliente1,        O.MensajeChequeo,  O.MB2,           O.Numerador,")
SQL.ADD("   O.ObservacDoc,    O.ContraEspecie,   O.TipoCambio,      O.CB2,           O.CB3, ")
SQL.ADD("   O.FechaVto,       O.NrSucursal,      O.CB4,             O.CB5,           O.NrBoleto, ")
SQL.ADD("   O.TotalImpuestos, O.Plazo,           O.TipoDoc,         O.FechaCarga,    O.FechaCargaSys,")
SQL.ADD("   O.Cliente4,       O.Contrato,        O.Vehiculo1,       O.CodComitente,  O.Book1,     ")
SQL.ADD("   O.Cuenta1,        O.RB1,             O.FechaEj,         O.Fecha2,        O.Observac2,  ") 
SQL.ADD("   O.Opcion                                                                               ")

SQL.ADD("FROM "~DBO~".OPERACIONES O")
SQL.ADD("INNER JOIN "~DBO~".OPERACIONESBITS OB ON O.NrOperacion=OB.NrOperacion")
SQL.ADD("WHERE O.TipoOp = 'DDC'")
SQL.ADD("AND OB.NrBit=50 AND OB.Valor=1")
 
If NoVacio(Dialogo.String1)
    SQL.ADD(" AND  O.ObservacDoc = '"~Dialogo.String1~"' ")
Else
    If Dialogo.Radio1 = 0
    SQL.ADD("AND  O.FechaPago >= '"~IdxDate(Dialogo.Fecha1)~"' AND O.FechaPago <= '"~IdxDate(Dialogo.Fecha2)~"'  ") 
    Else
         If Dialogo.Radio1 = 1
         SQL.ADD(" AND  O.FechaVto2 >= '"~IdxDate(Dialogo.Fecha1)~"' AND O.FechaVto2 <= '"~IdxDate(Dialogo.Fecha2)~"'  ")
         Else
            SQL.ADD(" AND  O.FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"'  ")
         Endif
    Endif

    If NoVacio(Dialogo.Vehiculo1)
        SQL.ADD("  AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
    Endif
    If NoVacio(Dialogo.Book1)
        SQL.ADD("  AND O.Book1 = '"~Dialogo.Book1~"' ")
    Endif
    If NoVacio(Dialogo.Cliente1)
        SQL.ADD("  AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
    Endif

    If NoVacio(Dialogo.Especie1)
        SQL.ADD("  AND O.Especie = '"~Dialogo.Especie1~"' ")
    Endif


    If NoVacio(Dialogo.Instrumento1)
            SQL.ADD("  AND O.TipoDoc = '"~Dialogo.Instrumento1~"' ") 
    Endif
       
    IF Dialogo.Radio2 = 2
        SQL.ADD("  AND (O.CB1 = 0 OR  O.CB1 = 1 )")
    ELSE
        SQL.ADD("  AND O.CB1 = "~Fstr(Dialogo.Radio2,0,0)~" ")
    ENDIF
    
    IF Dialogo.Radio3 = 0
        SQL.ADD("  AND (O.RB1 >= 1)")
    ELSE
        IF Dialogo.Radio3 = 1
            SQL.ADD("  AND (O.RB1 = 0) ")
        ENDIF
    ENDIF
    
    
Endif 
SQL.ADD(" AND O.TipoOp IN ('DDC','DDV')   ")  
WATCH(SQL.BATCH)

Recorrer SQL

    ACT(A:fac, fbn('NrOperacion'))
    ACLO(A:fac, fbn('NrOperacion'))
    ACT(B:fac, fbn('NrOperacion2'))
    
    IF fbn('CB1') = 1
        ACT(C:fac, 'Avalado')
    ELSE
        IF fbn('CB1') = 0
            ACT(C:fac, 'No Avalado')
        Endif
    ENDIF
    
    ACT(D:fac, fbn('Especie'))
    
     IF Eqstr(fbn('TipoOp'),'DDC')
        ACT(E:fac, 'C')
    ELSE
        ACT(E:fac, 'V')
    ENDIF
  

    ACN(F:fac, fbn('Precio1'))
    ACT(G:fac, fbn('Cliente2'))
    ACT(H:fac, fbn('Hora1'))
    ACD(I:fac, fbn('FechaOp'))
    ACD(J:fac, fbn('FechaPago'))
    ACT(K:fac, fbn('NrOperacion3'))
    ACT(L:fac, fbn('NrOperacion4'))
    ACT(M:fac, fbn('Cliente3'))

    ACT(N:fac, fbn('OperacionRef'))
    ACD(O:fac, fbn('FechaVto2'))
    ACN(P:fac, fbn('TotalBrutoCli1'))
    ACN(Q:fac, fbn('Cantidad'))
    let &TotalCapital &TotalCapital + val(Q:fac)
    let &Capital  &Capital + val(Q:fac)
    ACN(R:fac, fbn('TotalIntereses'))
    ACN(S:fac, fbn('ImpGastos1'))
    let &TotalGastos &TotalGastos + val(S:fac)
    let &Gastos &Gastos + val(S:fac)
    ACN(T:fac, fbn('ImpComMer1'))
    let &TotalGastos &TotalGastos + val(T:fac)
    let &Gastos &Gastos + val(T:fac)
    ACT(U:fac, fbn('CodComitente')) 
    ACT(V:fac, fbn('MensajeChequeo')) 
    ACT(W:fac, fbn('Hora2'))
     
    ACT(X:fac, '-')
    
    IF fbn('MB2') = 0
        ACT(Y:fac, 'EX')
    ELSE
        IF fbn('MB2') = 1
            ACT(Y:fac, 'RI')
        ELSE
            ACT(Y:fac, 'Otro')
        Endif
    ENDIF

    ACT(Z:fac, fbn('ObservacDoc'))
    ACT(AA:fac, fbn('ContraEspecie'))
    ACN(AB:fac, 1)

    IF fbn('CB2') = 0
        ACT(AC:fac, 'No')
    ELSE
        IF fbn('CB2') = 1
            ACT(AC:fac, 'Si')
        Endif
    ENDIF
     IF fbn('CB3') = 0
        ACT(AD:fac, 'No')
    ELSE
        IF fbn('CB3') = 1
            ACT(AD:fac, 'Si')
        Endif
    ENDIF
   
    
    ACD(AE:fac, fbn('FechaVto'))
    ACT(AF:fac, BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Cliente3')))
    ACT(AG:fac, fbn('NrSucursal'))
    IF fbn('CB4') = 0
        ACT(AH:fac, 'No')
    ELSE
        IF fbn('CB4') = 1
            ACT(AH:fac, 'Si')
        Endif
    ENDIF

    IF fbn('CB5') = 0
        ACT(AI:fac, 'No')
    ELSE
        IF fbn('CB5') = 1
            ACT(AI:fac, 'Si')
        Endif
    ENDIF
    ACT(AJ:fac, fbn('Contrato'))
    ACT(AK:fac, fbn('Opcion'))
    ACT(AL:fac, fbn('Observac2'))
    ACT(AM:fac, fbn('TipoDoc'))
    ACT(AN:fac, fbn('NrBoleto'))

    ACT(AO:fac, '-')
    ACT(AP:fac,'-' )
    ACN(AQ:fac, fbn('TotalImpuestos'))
    let &TotalGastos &TotalGastos + val(AQ:fac)
    let &Gastos &Gastos + val(AQ:fac)
    ACN(AR:fac, fbn('Cantidad'))
    ACT(AS:fac, fbn('Cliente4'))
    ACT(AT:fac, '-')
    ACT(AU:fac, fbn('Plazo')) 
    ACN(AV:fac, &Gastos + &Capital ) 
    IF fbn('RB1') = 0 Y fbn('FechaVto')<FSYS
        ACT(AW:fac, 'MORA')
    ELSE
        IF fbn('RB1') >= 1 
            ACT(AW:fac, 'COBRADO')
        ELSE
            ACT(AW:fac, 'NO COBRADO')
        Endif
    ENDIF
    IF fbn('RB1') = 1
        ACD(AX:fac,fbn('Fecha2'))
        ACT(AY:fac,'-')
        
    Else
        If fbn('RB1') = 2
            ACD(AY:fac,fbn('Fecha2'))
            ACT(AX:fac,'-')
        Else
            ACT(AY:fac,'-')
            ACT(AX:fac,'-')
        Endif
    Endif
   
    If Eqstr(Val(AW:fac),'COBRADO')
        let &TotalCapitalConci &TotalCapitalConci + val(Q:fac)
        let &TotalInteresesConci &TotalInteresesConci + val(R:fac) 
    Endif 
    
    let &Gastos 0
    let &Capital 0 
    
Proximo
AlinearCeldas(A:&filaInicial..AY:fac,'C')
AgregarMarco(A:&filaInicial..AY:fac, 0, 0,  Exe('COLOR7'))
