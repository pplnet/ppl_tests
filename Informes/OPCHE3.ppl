MostrarCuadrodeMensajes
DialogoVisible(SI)
CrearDialogo
  String1     : 'Cod.Ch.CVSA'                               ;1;1;;;;;;;;;;;;
  Radio1      : 'Fecha|Liq|Acreditacion|Concertacion'       ;;;;;VACIO(Dialogo.String1);Dialogo.Radio1<>-1;'Debe ingresar un tipo Fecha';NO;0
  Fecha1      : 'Fecha Desde'                               ;;;;;VACIO(Dialogo.String1);Dialogo.Fecha1<>-1;'Se debe ingresar una Fecha Desde';NO;FSYS
  Fecha2      : 'Fecha Hasta'                               ;;;;;VACIO(Dialogo.String1);Dialogo.Fecha2<>-1;'Se debe ingresar una Fecha Hasta';NO;FSYS
  Vehiculo1   : 'Vehiculo'                                  ;1;2;;;VACIO(Dialogo.String1);NoVacio(Dialogo.Vehiculo1);'Debe Ingresar un Vehiculo';NO;Var('DDVEHDEF')
  Book1       : 'Book'                                      ;2;2;;;VACIO(Dialogo.String1);EqStr(Dialogo.Vehiculo1,BuscarCampo('BOOKS','Vehiculo','Codigo',Dialogo.Book1));'El book ingresado no corresponde al Vehiculo';NO;Var('BOOKDDCHE');BuscarCampo('VEHICULOS','Alias5','Codigo',Dialogo.Vehiculo1);;;;" Vehiculo = '"~Dialogo.Vehiculo1~"'"  
  Cliente1    : 'Entidad'                                   ;5;1;;;VACIO(Dialogo.String1);NoVacio(Dialogo.Cliente1);'Debe Ingresar una Entidad';NO;Var('DDCOMIDEF');;;;; "Codigo in (Select DISTINCT Cliente1 from OPERACIONES where TipoOp ='DDC')"
  Especie1    : 'Moneda'                                    ;;;;;VACIO(Dialogo.String1);NoVacio(Dialogo.Especie1) Y DESCIENDEDEESPECIE(Dialogo.Especie1,'MONEDA');'Se debe ingresar una Moneda';NO;Var('MONELOCA');;;;;"dbo.DESCIENDEDEESPECIE(Codigo,'MONEDA') = 1"    
  Radio2      : 'Segmento|No Avalado|Avalado|Ambos'         ;;;;;VACIO(Dialogo.String1);;;;2
  Instrumento1: 'Instrumento'                               ;;;;;VACIO(Dialogo.String1);;;;
  Radio3      : 'Cobrado|Si|No|Ambos'                       ;;;;;VACIO(Dialogo.String1);;;;2
FinDialogo

if Not Ok
  Cancelar
endif



CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,16,B')


let &filaLogo 1
@LOGO


SetFilaActual(fac+3)

ACT(F:1, 'Informe de Operaciones de Cheques')
SetFont(F:1, 3)
SetFilaActual(fac+2)

***---Header
If NoVacio(Dialogo.String1)
    ACT(A:fac, 'Id Cheque: '~Dialogo.String1)
    ifa
Else   
    ACT(A:fac, 'Fecha: ')
    If Dialogo.Radio1 = 0
        ACT(B:fac,'Liquidacion')
    Else
        If Dialogo.Radio1 = 1
            ACT(B:fac,'Acreditacion')
        Else
            ACT(B:fac,'Concertacion')
        Endif
    Endif
    ifa
    ACT(A:fac, 'Fecha Desde: ')
    ACT(B:fac,Dialogo.Fecha1)
    ifa

    ACT(A:fac, 'Fecha Hasta: ')
    ACT(B:fac,Dialogo.Fecha2)
    ifa
    If NoVacio(Dialogo.Vehiculo1)
        ACT(A:fac, 'Vehiculo:'~Dialogo.Vehiculo1)
        ifa
    Else
        ACT(A:fac, 'Vehiculos: Todos')
        ifa
    Endif
    If NoVacio(Dialogo.Book1)
        ACT(A:fac, 'Book:'~Dialogo.Book1)
        ifa
    Else
        ACT(A:fac, 'Books: Todos')
        ifa
    Endif

    If NoVacio(Dialogo.Cliente1)
        ACT(A:fac, 'Entidad: '~Dialogo.Cliente1)
        ifa
    Endif

    If NoVacio(Dialogo.Especie1)
        ACT(A:fac, 'Moneda:'~Dialogo.Especie1)
        ifa
    Else
        ACT(A:fac, 'Monedas: Todas')
        ifa
    Endif

    If NoVacio(Dialogo.Instrumento1)
       ACT(A:fac, 'Instrumento:'~Dialogo.Instrumento1)
       ifa
    Else
       ACT(A:fac, 'Instrumento: Todos')
       ifa
    Endif
       
    IF Dialogo.Radio2 = 0
    ACT(A:fac, 'Segmento: No Avalado')
        ifa
    ELSE
        If Dialogo.Radio2 = 1
        ACT(A:fac, 'Segmento: Avalado')
            ifa
        Else
            ACT(A:fac, 'Segmento: Ambos')
            ifa
        Endif
    ENDIF
    
    IF Dialogo.Radio3 = 0
        ACT(A:fac, 'Estado: Cobrado')
        ifa
    ELSE
        If Dialogo.Radio3 = 1
            ACT(A:fac, 'Estado: No Cobrado')
            ifa
        Else
            ACT(A:fac, 'Estado: Ambos')
            ifa

        Endif
    ENDIF
Endif
SetFont(A:&fi1..A:fac, 2)
SetFont(B:&fi1..B:fac, 2)
ifa

***---Columnas
ACT(A:fac, 'NrOperacion')
