SetFilaActual(8)
SQL.ADD("Select C.Codigo, L.* from "~DBO~".CLIENTES C, "~DBO~".LIMASIGNADOS L")
SQL.ADD("where C.Codigo=L.Cliente and L.Limite in ('COTOR', 'CONTRACT','PRESETTLEM','SETTLEMENT','CUSTODY') order by C.Codigo")

Recorrer SQL
  dfa
  if Not EqStr(Val(z1), fbn('Codigo'))
    ACT(z1, fbn('Codigo'))
    ifa
    ACT(a:fac, fbn('Codigo'))
  endif
  if EqStr(fbn('Limite'),'COTOR')
    ACN(z2, 0)
  endif
  if EqStr(fbn('Limite'),'CONTRACT')
    ACN(z2, 1)
  endif
  if EqStr(fbn('Limite'),'PRESETTLEM')
    ACN(z2, 2)
  endif
  if EqStr(fbn('Limite'),'CUSTODY')
    ACN(z2, 3)
  endif

  if EqStr(fbn('Limite'),'SETTLEMENT')
    ACN(z2, 4)
  endif

  ACT(2+4*Val(z2):fac, fbn('Especie'))
  ACN(3+4*Val(z2):fac, fbn('Monto') )
  FormatoCeldas(3+4*Val(z2):fac, Exe('F2'))
  ACT(4+4*Val(z2):fac, fbn('FRevision'))
  ACT(5+4*Val(z2):fac, fbn('FVencimiento'))
