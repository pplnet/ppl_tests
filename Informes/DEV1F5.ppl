*AgregarMarco(X:&totales..X:&totales, 0, 0, Exe('COLOR'))
FormatoCeldas(M:&totales..X:&totales, Exe('F2'))
AlinearCeldas(M:&totales..X:&totales,'C')
SetFont(M:&totales..X:&totales, 2)

