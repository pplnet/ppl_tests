SetFilaActual(6)
SQL.ADD("Select * from "~DBO~".FERIADOS order by Codigo")
recorrer SQL
  ACT(a:FAC, FBN('Codigo'))
  ACT(b:FAC, FBN('Descripcion'))
  recorrer&i 1, 100
    if NoVacio(FBN('Fecha'~Pad0(FStr(&i,1,0),2))) 
      ACT(c:FAC, FBN('Fecha'~Pad0(FStr(&i,1,0),2)))
      ifa
    endif
  proximo
proximo

