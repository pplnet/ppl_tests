*
ifa
    
**********
SetFont(A:&fi1..A:fac, 2)
SetFont(B:&fi1..B:fac, 2)
ifa
******************************
*Títulos de Columnas y Formato
******************************
 ACT(A:FAC, 'Fecha')
 ACT(B:FAC, 'Monto Total ALyC')
 ACT(C:FAC, 'Monto Total Operado')
 ACT(D:FAC, '% ALyC')
 ACT(E:FAC, 'Cumple')
 
 AlinearCeldas(A:fac..E:fac,'C')
 SetFont(A:fac..E:fac, 2)
 AgregarMarco(A:fac..E:fac, 0, 0, Exe('COLOR'))
Let &filaInicial fac+1
**************
*SENTENCIA SQL
**************
SQL.ADD("Select FechaOp,Cantidad,Cliente1, Cliente2 FROM "~dbo~".OPERACIONES")
SQL.ADD("WHERE FechaOp  Between '"~idxDate(Dialogo.Fecha1)~"' AND '"~idxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("AND Cliente1 = '"~&cliente~"'")
SQL.ADD("AND Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
SQL.ADD("AND Book1 = '"~Dialogo.Book1~"'")
SQL.ADD("Order By FechaOp")

WATCH(SQL.BATCH)

let &fechaAnterior Dialogo.Fecha2+1000
*************
Recorrer SQL
*************
    IF FBN['FechaOp'] = &fechaAnterior
    *   Si la fecha es igual a la anterior.
        dfa
    ENDIF
    IF (EsHabil(FBN['FechaOp'],'ARG'))
        *Si la fecha cambia, actualizo variable
        let &fechaAnterior FBN['FechaOp']
        *Y luego escribo por primera vez los datos de la nueva fecha
        
        ****COLUMNA A - Fecha
        ACD(A:FAC, FBN['FechaOp'])
        
        ****COLUMNA B - Monto Total ALyC
        If EqStr(FBN['Cliente2'],&cliente)
            *Monto Total ALyC = Sumatoria del campo O.Cantidad de todas las operaciones de la fecha donde el cliente2 = contraparte del dialogo
            SCN(B:FAC, FBN['Cantidad'])
            ACL(B:FAC,'DEALYC', Fecha1=FBN['FechaOp'], Cliente1=FBN['Cliente2'], Vehiculo1=Dialogo.Vehiculo1, Book1=Dialogo.Book1)
        Endif
        
        
        ***COLUMNA C - Monto Total Operado
        If EqStr(FBN['Cliente1'],&cliente)
            *Monto Total Operado = Sumatoria del campo O.Cantidad de todas las operaciones de la fecha donde el cliente1 = contraparte del dialogo
            SCN(C:FAC, FBN['Cantidad'])
        Endif
        
        ****COLUMNA D - % ALyC
        *% ALyC = (Monto Total ALyC % Monto Total Operado)
        ACN(D:FAC, ( (Val(B:FAC)*100)/Val(C:FAC) ) )
        
        ****COLUMNA E - Cumple
        *En el ABM CLIENTES, Valor1 representa un porcentaje. 
        *Si el valor de %ALyC es mayor, la leyenda va a ser NO (no puede exceder limites).
        *Si es menor igual va a ser SI.
        *en el ejemplo del Excel debe ser de 20%
        if &LimALyC < Val(D:FAC)
            ACT(E:FAC, 'NO')
        else
        if &LimALyC >= Val(D:FAC)
            ACT(E:FAC, 'SI')
            endif
        endif
    ELSE
        dfa
    ENDIF
        
    
