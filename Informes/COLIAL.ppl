CrearDialogo
    Fecha1:     'Fecha Desde: ' ;1;1;;;;NoVacio(Dialogo.Fecha1);'Fecha Inválida';NO;FSYS;;
    Fecha2:     'Fecha Hasta: ' ;2;1;;;;NoVacio(Dialogo.Fecha2) Y Dialogo.Fecha1<=Dialogo.Fecha2;'Fecha Desde debe ser mayor a Fecha Desde';NO;FSYS;;
    Cliente1:   'ALyC: '        ;3;1;;;;NoVacio(Dialogo.Cliente1) Y NoVacio(BuscarCampo('CLIENTES','CodigoMAV','Codigo',Dialogo.Cliente1));'ALyC inválida';NO;;;;;;"CodigoMAV IS NOT NULL"
    Vehiculo1:  'Vehiculo: '    ;4;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un Vehiculo';NO;;;
    Book1:      'Book: '        ;5;1;;;;EqStr(Dialogo.Vehiculo1,BuscarCampo('BOOKS','Vehiculo','Codigo',Dialogo.Book1)) Y NoVacio(Dialogo.Book1);'El book ingresado no corresponde al Vehiculo';NO;;BuscarCampo('VEHICULOS','Alias5','Codigo',Dialogo.Vehiculo1);;;;" Vehiculo = '"~Dialogo.Vehiculo1~"'"
    
FinDialogo

If not ok
    Cancelar
Endif

