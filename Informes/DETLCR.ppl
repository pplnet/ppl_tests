CrearDialogo
  Cliente1   : 'Cliente';;;;;;NoVacio(Dialogo.Cliente1);'Debe ingresar un Cliente';NO;
  TipoLimite1: 'Limite' ;;;;;;NoVacio(Dialogo.TipoLimite1) y EqStr(BuscarCampo('TIPOSLIMITE','Clase','Codigo',Dialogo.TipoLimite1),'C');'Debe ingresar un Tipo de Limite de Credito';NO;
  Fecha1     : 'Fecha'  ;;;;;;Dialogo.Fecha1>0;'Fecha incorrecta';NO;FSys;
FinDialogo
if Not Ok
  Cancelar
endif

MessageBox(Dialogo.TipoLimite1)
CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

ACT(ml1,SQL("SELECT Especie FROM "~DBO~".LIMASIGNADOS WHERE Cliente='"~Dialogo.Cliente1~"' and Limite='"~Dialogo.TipoLimite1~"'") )
ACT(a:4, 'Detalle de Limites de Credito')
ACT(a:5, 'Cliente : '~Dialogo.Cliente1)
ACT(a:6, 'Limite : '~Dialogo.TipoLimite1~' En '~val(ml1))
ACT(a:7, 'Fecha : '~Dialogo.Fecha1)

ACT(a:9, 'Cliente')
ACT(b:9, 'Limite')
ACT(c:9, 'Fecha')
ACT(d:9, 'Especie')
ACT(e:9, 'Operacion')
ACT(f:9, 'Tipo')
ACT(g:9, 'Cantidad')
ACT(h:9, 'Acumulado')
AgregarMarco(a:9..h:9,1,1,Exe('COLOR'))
SetFont(a:1..h:9,2)

SetFilaActual(9)
SQL.ADD("Select * from "~DBO~".MOVLIMITES ")
SQL.ADD("where Cliente = '"~Dialogo.Cliente1~"' ")
SQL.ADD("and FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"' ")
if Not EqStr(Dialogo.TipoLimite1,'SETCRE')
  SQL.ADD("and Bits = 'P' ")
endif
SQL.ADD("and Limite = '"~Dialogo.TipoLimite1~"' ")
SQL.ADD("and Especie = '"~val(ml1)~"' ")
SQL.ADD("order by FechaMov")

Recorrer SQL
  ACT(a:FAC, FBN['Cliente'])
  ACT(b:FAC, FBN['Limite'])
  ACT(c:FAC, FBN['FechaMov'])
  ACT(d:FAC, FBN['Especie'])
  ACT(e:FAC, FBN['NrOperacion'])
  ACLO(e:FAC, FBN['NrOperacion'])
  ACT(f:FAC, BuscarCampo('OPERACIONES','TipoOp','NrOperacion',FBN['NrOperacion']))
  ACN(g:FAC, FBN['Monto'])
  ACN(h:FAC, Val(h:FAC-1)+Val(g:FAC))
Proximo

SetFont(a:10..h:FAC,1)
SetFilaActual(FAC+2)
ACT(f:FAC, 'Limite Consumido')
if EqStr(Dialogo.TipoLimite1,'SETTLEMENT')
  ACN(h:FAC, LimSumado(Dialogo.Cliente1, 'SETTLEMENT',Dialogo.Fecha1))
  SCN(h:FAC, LimConsumido(Dialogo.Cliente1, 'SETCRE',val(ml1),0,,,,,Dialogo.Fecha1))
else
  ACN(h:FAC, LimConsumido(Dialogo.Cliente1, Dialogo.TipoLimite1,val(ml1),0,,,,,Dialogo.Fecha1))
endif
SetFont(f:FAC..h:FAC,2)
FormatoCeldas(g:10..h:FAC,EXE('F2'))

ACO(1,7)
ACO(2,7)
ACO(3,7)
ACO(4,7)
ACO(5,7)
ACO(6,7)
ACO(7,10)
ACO(8,10)

LimitesVision(h:FAC)