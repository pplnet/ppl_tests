HojaVisible(NO)
IF Vacio(UsrVehiculos(UsuarioActivo))
    ACT(LS:1, SQLSet(" Select Codigo from "~DBO~".VEHICULOS where Status = 'HAB' "))
ELSE
    ACT(LS:1, UsrVehiculos(UsuarioActivo))
ENDIF

CrearDialogo
  Fecha1: 'Fecha'                            ;;1;;;;;;;FSys
  Radio1: 'Filtra Book|SI|NO'                ;3;1;;;;;;;1;
  Vehiculo1: 'Vehiculo'                      ;4;1;;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Radio1=1 O NoVacio(Dialogo.Vehiculo1) ;'Vehiculo Invalido';NO;;;;;;;
  Lista2: 'Books'                            ;5;1;;;Dialogo.Radio1=0;;;;;;SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~Dialogo.Vehiculo1~"' ");;
  Lista1: 'Vehiculos'                        ;-1;1;;;Dialogo.Radio1=1;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), Val(LS:1), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where V.Codigo = U.Vehiculo AND U.Codigo = '"~UsuarioActivo~"' AND V.Status = 'HAB' "));;
  Radio2: 'Expresado en|ARP|USD'             ;;1;;;;;;;0
  Radio3: 'Expresado en|Millones|ImporteOri' ;;1;;SI;SI;;;;0;;;;;
  Radio4: 'Vehiculo Consolidado|NO|SI'       ;-9;2;1;SI;Dialogo.Radio1=1;;;;1;;;;;;;
  
  
  
FinDialogo

IF Not OK
  Cancelar
ENDIF

*Filtra Book
IF Dialogo.Radio1 = 0
    LinkearHoja('DETINA', 1, Fecha1 = Dialogo.Fecha1, Vehiculo1 = Dialogo.Vehiculo1, Lista1 = Dialogo.Lista1, Lista2 = Dialogo.Lista2, Radio1=Dialogo.Radio1, Radio2 = Dialogo.Radio2, Radio3 = Dialogo.Radio3, Radio4=0)
ELSE
    *Vehiculo NO Consolidado
    If Dialogo.Radio4=0
        IF NoVacio(Dialogo.Lista1)
            Recorrer&k 1, Elementos(Dialogo.Lista1)
            LinkearHoja('DETINA', 1, Fecha1 = Dialogo.Fecha1, Vehiculo1 = ItemLista(Dialogo.Lista1, &k), Lista1 = '', Lista2 = '', Radio1=Dialogo.Radio1, Radio2 = Dialogo.Radio2, Radio3 = Dialogo.Radio3, Radio4=Dialogo.Radio4)
            Proximo
        ELSE
            Recorrer&k 1, Elementos(Val(LS:1))
            LinkearHoja('DETINA', 1, Fecha1 = Dialogo.Fecha1, Vehiculo1 = ItemLista(Val(LS:1), &k), Lista1 = '', Lista2 = '', Radio1=Dialogo.Radio1, Radio2 = Dialogo.Radio2, Radio3 = Dialogo.Radio3, Radio4=Dialogo.Radio4)
            Proximo
        ENDIF
        *Vehiculos Consolidados
    Else
        IF NoVacio(Dialogo.Lista1)
        LinkearHoja('DETINA', 1, Fecha1 = Dialogo.Fecha1, Vehiculo1 = '', Lista1 = Dialogo.Lista1, Lista2 = Dialogo.Lista2, Radio1=Dialogo.Radio1, Radio2 = Dialogo.Radio2, Radio3 = Dialogo.Radio3, Radio4=Dialogo.Radio4)
        ELSE
        LinkearHoja('DETINA', 1, Fecha1 = Dialogo.Fecha1, Vehiculo1 = '', Lista1 = Val(LS:1), Lista2 = Dialogo.Lista2, Radio1=Dialogo.Radio1, Radio2 = Dialogo.Radio2, Radio3 = Dialogo.Radio3, Radio4=Dialogo.Radio4)
        ENDIF
    Endif

ENDIF

