(.'TASAUVAPER'.)

ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo2  : "Grupo"          ;;;;Vacio(Dialogo.Lista1);;;;;;;;;;"TipoVehiculo <> 'DIV'";
  Lista1     : "Vehiculo"       ;;;;Vacio(Dialogo.Vehiculo2);;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV'"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"));;;;;
  Especie1   : "Especie"        ;;;
  Fecha1     : "F.Desde"        ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys
  Fecha2     : "F.Hasta"        ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha Hasta';NO;FSys+365
  Book1      :'Book'            ;;;;;;;;;
  Radio2     : "Consolidado |Si |     No" ;;;;;;;;;1
  Radio1     : "Expresado   |Pesos|Dolares" ;;;;;;;;;0
FinDialogo

if Not Ok
  Cancelar
endif

*/Moneda Local
act(ml:1,Var('MONELOCA'))
*/Moneda Extranjera
act(me:1,Var('MONEEXTR'))
*ARP UVA
act(mu:1,'UVA')

*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(ZZ:6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(ZZ:6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)
SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Caida de Depositos a Plazo")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(W:1,FAC)

if NoVacio(Dialogo.Vehiculo2)
 ACT(a:FAC+1, 'Grupo : '~Pipe2Comillas(Dialogo.Vehiculo2))
else
  if NoVacio(Dialogo.Lista1)
    ACT(a:FAC+1, 'Vehiculo/s : '~Dialogo.Lista1) 
  else 
    ACT(a:FAC+1, 'Vehiculo : Todos')
  endif
endif

if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+2, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
 else
  ACT(a:FAC+2, 'Especie : Todos')
endif

if NoVacio(Dialogo.Book1)
   ACT(a:FAC+3, 'Book: '~Dialogo.Book1)
  else
   ACT(a:FAC+3, 'Book: Todos')
endif

if Dialogo.Radio2=1
   ACT(a:FAC+4, 'Consolidado: NO')
  else
   ACT(a:FAC+4, 'Consolidado: SI')
endif

ACT(a:FAC+5, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:FAC+6, 'Fecha Hasta: '~Dialogo.Fecha2)
ACT(a:FAC+7, 'Expresado en '~iif(Dialogo.Radio1=0,'Pesos','Dolares'))
SetFont(a:fac..N:FAC+7,2)
SetFilaActual(FAC+4)

*************************************************** - CONSULTA - *********************************************************
*- A FechaVto->Capital     **** MMCDIA Cert.Deposito Interes Anticipado  (Tasa = Precio1)

if Dialogo.Radio2=1
   SQL.ADD("Select O.Vehiculo1, CASE WHEN O.Indice = 'UVA' THEN CONCAT(O.Especie,' ',O.Indice) ELSE O.Especie END Especie, O.FechaOp, O.TipoOp, O.NrOperacion, O.Cliente1, ")
else
   SQL.ADD("Select 'Consolidado' Vehiculo1, CASE WHEN O.Indice = 'UVA' THEN CONCAT(O.Especie,' ',O.Indice) ELSE O.Especie END Especie, O.FechaOp, O.TipoOp, O.NrOperacion, O.Cliente1, ")
endIf
SQL.ADD(" O.FechaVto Vto,  O.MB3, ")
SQL.ADD(" O.Cantidad Cant, O.Cantidad Capital, O.Cantidad Final, O.Vehiculo1 Vehiculo, O.Precio1 TASA, O.Spread Sprd, O.TipoTasa, O.TotalIntereses, ")
SQL.ADD("O.TotalRetenciones, '0' RetGan, 0 Penalidad, O.Book1, O.Indice, O.Especie Moneda  ")

SQL.ADD(" from  "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMCDIA') ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(ZZ:6))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.Book1)
   SQL.ADD(" and O.Book1='"~Dialogo.Book1~"'")
endif
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto <= '"~IdxDate(Dialogo.Fecha2)~"' ")

SQL.ADD(" Union All")

*- A Fecha2 -> Intereses       **** MMCDIA Cert.Deposito Interes Anticipado  (Tasa = Precio1)
if Dialogo.Radio2=1
    SQL.ADD("Select O.Vehiculo1, CASE WHEN O.Indice = 'UVA' THEN CONCAT(O.Especie,' ',O.Indice) ELSE O.Especie END Especie, O.FechaOp, O.TipoOp, O.NrOperacion, O.Cliente1, ")
ELSE
    SQL.ADD("Select 'Consolidado' Vehiculo1, CASE WHEN O.Indice = 'UVA' THEN CONCAT(O.Especie,' ',O.Indice) ELSE O.Especie END Especie, O.FechaOp, O.TipoOp, O.NrOperacion, O.Cliente1, ")
ENDIF
SQL.ADD(" C.Fecha2 Vto,  O.MB3, ")
SQL.ADD(" Sum(C.Cantidad3) Cant, 0 Capital, Sum(C.Cantidad3) Final, O.Vehiculo1 Vehiculo, O.Precio1 TASA, O.Spread Sprd,  O.TipoTasa, O.TotalIntereses, ")
SQL.ADD(" O.TotalRetenciones, '0' RetGan, 0 Penalidad, O.Book1, O.Indice, O.Especie Moneda ")

SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.TipoOp In ('MMCDIA') ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(ZZ:6))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
EndIf
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.Book1)
   SQL.ADD(" and O.Book1='"~Dialogo.Book1~"'")
endif
SQL.ADD(" and  C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2 <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" group by O.Vehiculo1, O.Especie, O.FechaOp, O.TipoOp, O.NrOperacion,O.Cliente1, C.Fecha2, O.Precio1,  O.TipoTasa, O.TotalIntereses, O.TotalRetenciones, O.Spread, O.MB3, O.Book1, O.Indice ")
*---- 

*- MMCDP          **** MMCDP:  Cert.Deposito Precancelable (Tasa = Precio1)
SQL.ADD(" Union All")

if Dialogo.Radio2=1
    SQL.ADD("Select O.Vehiculo1, CASE WHEN O.Indice = 'UVA' THEN CONCAT(O.Especie,' ',O.Indice) ELSE O.Especie END Especie, O.FechaOp, O.TipoOp, O.NrOperacion, O.Cliente1, ")
ELSE
    SQL.ADD("Select 'Consolidado' Vehiculo1, CASE WHEN O.Indice = 'UVA' THEN CONCAT(O.Especie,' ',O.Indice) ELSE O.Especie END Especie, O.FechaOp, O.TipoOp, O.NrOperacion, O.Cliente1, ")
ENDIF
SQL.ADD(" CASE Plazo2 When 0 Then O.FechaVto Else O.FechaVto2 End Vto,  O.MB3,  ")
SQL.ADD(" CASE Plazo2 When 0 Then O.TotalBrutoCli1 Else O.TotalAux3 End Cant, O.Cantidad Capital, O.TotalBrutoCli1 Final, O.Vehiculo1 Vehiculo, O.Precio1 TASA, O.Spread Sprd, O.TipoTasa, O.TotalIntereses, ")
SQL.ADD(" O.TotalRetenciones,'0' RetGan, 0 Penalidad, O.Book1, O.Indice, O.Especie Moneda ")

SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMCDP') ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(ZZ:6))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
EndIf
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.Book1)
   SQL.ADD(" and O.Book1='"~Dialogo.Book1~"'")
endif
SQL.ADD(" and ((Plazo2=0 and O.FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaVto<='"~IdxDate(Dialogo.Fecha2)~"') ")
SQL.ADD("     or (Plazo2<>0 and O.FechaVto2>='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaVto2<='"~IdxDate(Dialogo.Fecha2)~"')) ")
*-------

SQL.ADD(" Union All")

if Dialogo.Radio2=1
    SQL.ADD("Select O.Vehiculo1, CASE WHEN O.Indice = 'UVA' THEN CONCAT(O.Especie,' ',O.Indice) ELSE O.Especie END Especie, O.FechaOp, O.TipoOp, O.NrOperacion, O.Cliente1, ")
ELSE
    SQL.ADD("Select 'Consolidado' Vehiculo1, CASE WHEN O.Indice = 'UVA' THEN CONCAT(O.Especie,' ',O.Indice) ELSE O.Especie END Especie, O.FechaOp, O.TipoOp, O.NrOperacion, O.Cliente1, ")
ENDIF
************************** MMCPM ** Colocacion a PF con Multiples Cuotas (tASA DESDE PRECIO2 de CUOTAS)

SQL.ADD("C.Fecha2 Vto, O.MB3,   ")
SQL.ADD("Sum(C.Total1) Cant, C.Cantidad1 Capital, C.Total2 Final, O.Vehiculo1 Vehiculo, C.Precio2 TASA, O.Spread Sprd,  O.TipoTasa, O.TotalIntereses, ")
SQL.ADD(" O.TotalRetenciones, Sum(C.Cantidad4) RetGanan, O.TotalAux1 Penalidad, O.Book1, O.Indice, O.Especie Moneda ")

SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and ( O.TipoOp In ('MMCPM')   or (O.TipoOp In ('MMSELN') and O.MB3 ='0') )   ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(ZZ:6))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
EndIf
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.Book1)
   SQL.ADD(" and O.Book1='"~Dialogo.Book1~"'")
endif
SQL.ADD(" and  C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2 <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" group by O.Vehiculo1, O.Especie, O.FechaOp, O.TipoOp, O.NrOperacion, O.Cliente1, C.Fecha2, C.Cantidad1, C.Total2, C.Precio2,  O.TipoTasa, ")
SQL.ADD(" O.TotalIntereses, O.TotalRetenciones, O.Spread, O.MB3, O.TotalAux1, O.Book1, O.Indice ")

SQL.ADD(" Union All")

if Dialogo.Radio2=1
    SQL.ADD("Select O.Vehiculo1, CASE WHEN O.Indice = 'UVA' THEN CONCAT(O.Especie,' ',O.Indice) ELSE O.Especie END Especie, O.FechaOp, O.TipoOp, O.NrOperacion, O.Cliente1, ")
ELSE
    SQL.ADD("Select 'Consolidado' Vehiculo1, CASE WHEN O.Indice = 'UVA' THEN CONCAT(O.Especie,' ',O.Indice) ELSE O.Especie END Especie, O.FechaOp, O.TipoOp, O.NrOperacion, O.Cliente1, ")
ENDIF

*- MMD  ******************** MMD:  DIVA (Tasa = Precio1)

SQL.ADD(" O.FechaVto Vto,   O.MB3,  ")
SQL.ADD(" O.TotalNetoCli1 Cant, O.Cantidad Capital, O.TotalBrutoCli1 Final, O.Vehiculo1 Vehiculo, O.Precio1 TASA, O.Spread Sprd, O.TipoTasa, O.TotalIntereses, ")
SQL.ADD(" O.TotalRetenciones, '0' RetGan, 0 Penalidad, O.Book1, O.Indice, O.Especie Moneda ")

SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMD') ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(ZZ:6))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
EndIf
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.Book1)
   SQL.ADD(" and O.Book1='"~Dialogo.Book1~"'")
endif
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto <= '"~IdxDate(Dialogo.Fecha2)~"' ")

SQL.ADD(" Union All")

if Dialogo.Radio2=1
    SQL.ADD("Select O.Vehiculo1, CASE WHEN O.Indice = 'UVA' THEN CONCAT(O.ContraEspecie,' ',O.Indice) ELSE O.ContraEspecie END Especie, O.FechaOp, O.TipoOp, O.NrOperacion, O.Cliente1, ")
ELSE
    SQL.ADD("Select 'Consolidado' Vehiculo1, CASE WHEN O.Indice = 'UVA' THEN CONCAT(O.ContraEspecie,' ',O.Indice) ELSE O.ContraEspecie END Especie, O.FechaOp, O.TipoOp, O.NrOperacion, O.Cliente1, ")
ENDIF

******************************** SERA ** REPO ACTIVO ******* (tASA DESDE PRECIO3 de Operaciones)

SQL.ADD(" O.FechaVto2 Vto,  O.MB3, ")
SQL.ADD(" O.TotalNetoCli2 Cant, TotalBrutoCli1 Capital, TotalBrutoCli2 Final, O.Vehiculo1 Vehiculo, Precio3 TASA, O.Spread Sprd,  O.TipoTasa, O.TotalIntereses, ")
SQL.ADD(" O.TotalRetenciones, '0' RetGan, 0 Penalidad, O.Book1, O.Indice, O.ContraEspecie Moneda ")

SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('SERA') ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(ZZ:6))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
EndIf
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.Book1)
   SQL.ADD(" and O.Book1='"~Dialogo.Book1~"'")
endif
SQL.ADD(" and  O.FechaVto2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto2 <= '"~IdxDate(Dialogo.Fecha2)~"' ")

SQL.ADD(" Union All")

if Dialogo.Radio2=1
    SQL.ADD("Select O.Vehiculo1, CASE WHEN O.Indice = 'UVA' THEN CONCAT(O.Especie,' ',O.Indice) ELSE O.Especie END Especie, O.FechaOp, O.TipoOp, O.NrOperacion, O.Cliente1, ")
ELSE
    SQL.ADD("Select 'Consolidado' Vehiculo1, CASE WHEN O.Indice = 'UVA' THEN CONCAT(O.Especie,' ',O.Indice) ELSE O.Especie END Especie, O.FechaOp, O.TipoOp, O.NrOperacion, O.Cliente1, ")
ENDIF

*************** MMDCA // MMCCR CAJA DE AHORROS y CUENTA CORRIENTES ******* (tASA DESDE PRECIO1 de Operaciones)

SQL.ADD(" O.FechaVto Vto,   O.MB3, ")
SQL.ADD(" O.Cantidad Cant, O.Cantidad Capital, O.TotalBrutoCli1 Final, O.Vehiculo1 Vehiculo, O.Precio1 TASA,O.Spread Sprd,  O.TipoTasa, O.TotalIntereses, ")
SQL.ADD(" O.TotalRetenciones, '0' RetGan, 0 Penalidad, O.Book1, O.Indice, O.Especie Moneda ")

SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMDCA','MMCCR') ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(ZZ:6))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
EndIf
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.Book1)
   SQL.ADD(" and O.Book1='"~Dialogo.Book1~"'")
endif
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto <= '"~IdxDate(Dialogo.Fecha2)~"' ")

SQL.ADD(" Union All")

if Dialogo.Radio2=1
   SQL.ADD("Select O.Vehiculo1, CASE WHEN O.Indice = 'UVA' THEN CONCAT(O.Especie,' ',O.Indice) ELSE O.Especie END Especie, O.FechaOp, O.TipoOp, O.NrOperacion, O.Cliente1, ")
ELSE
   SQL.ADD("Select 'Consolidado' Vehiculo1, CASE WHEN O.Indice = 'UVA' THEN CONCAT(O.Especie,' ',O.Indice) ELSE O.Especie END Especie, O.FechaOp, O.TipoOp, O.NrOperacion, O.Cliente1, ")
ENDIF
*************** MMO: OVERNIGHT ****** (tASA DESDE PRECIO1 de Operaciones)

SQL.ADD("O.FechaVto Vto ,  O.MB3,  ")
SQL.ADD("O.TotalBrutoCli1 Cant, 0 Capital, 0 Final, O.Vehiculo1 Vehiculo, O.Precio1 TASA, O.Spread Sprd, O.TipoTasa, O.TotalIntereses, ")
SQL.ADD(" O.TotalRetenciones, '0' RetGan, 0 Penalidad ,O.Book1, O.Indice, O.Especie Moneda")

SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMO') ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(ZZ:6))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
EndIf
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif

if NoVacio(Dialogo.Book1)
   SQL.ADD(" and O.Book1='"~Dialogo.Book1~"'")
endif
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("order by 1,7")

acn(AC:2,0)
acn(AC:3,0)

ACT(X1,' ')
acn(x2,0)
act(mo:99,iif(Dialogo.Radio1=0,Val(ml:1),val(me:1)))

acn(vi:55,0)
Recorrer SQL
   if val(vi:55)=0
    acn(vi:54, fac)
    acn(vi:55,1)
   endif
   Acn(co:99,CotizacionC(FBN['Moneda'],,,,Fsys,1,SI,Val(mo:99)))
   if val(ac1) <> FBN['Vto'] 
      If val(AC:2) = 1
        acn(m:fac-1,val(AC:3))   
        SetFont(m:FAC-1..m:FAC-1,2)
        FormatoCeldas(m:fac..m:fac,Exe('F2'))
      EndIF
      acd(ac1,FBN['Vto'])
      acn(AC:3,0)
   endif
   if Not EqStr(val(x1),fbn['Vehiculo1'])
      */TOTALES
      if Not EqStr(val(x1),' ') 
         SetFilaActual(FAC+2) 
         ACT(a:FAC, Copy(BuscarCampo('VEHICULOS','Descripcion','Codigo',Val(x1)),1,14))
         ACT(b:FAC  , 'Pesos')
         ACN(b:fac+1, val(pu:55))
         ACT(c:FAC  , 'Dolares')
         ACN(c:fac+1, val(pu:56))
         ACT(d:FAC  , 'Pesos UVA')
         ACN(d:fac+1, val(pu:60))
         ACT(e:FAC  , 'Otras')
         ACN(e:fac+1, val(pu:57))
         ACT(f:FAC  , 'Totales')
         ACN(f:FAC+1, Val(pu:58))
         ACT(a:FAC+1, 'Total1')
         ACT(a:FAC+2, 'Plazo')
         ACT(a:FAC+3, 'Promedio') 
         ACT(a:FAC+4, 'Ponderado')
         */ARP
         ACN(b:FAC+3,  Val(PR:99)/Val(pd:55))
         */USD
         ACN(C:FAC+3,  Val(PR:100)/Val(pd:56))
         *ARP UVA
         ACN(D:FAC+3, Val(PR:200)/Val(pd:60))
         */OTRO
         ACN(E:FAC+3,  Val(PR:101)/Val(PR:102))
         */TOTAL
         ACN(F:FAC+3,  Val(PR:103)/Val(pr104))
         ACT(a:FAC+5, 'Tasa')
         ACT(a:FAC+6, 'Promedio')
         */ARP
         ACN(b:FAC+5,  val(TA:99)/Val(te99))
         */USD
         ACN(c:FAC+5,  val(TA:100)/Val(TE:100))
         *UVA
         ACN(d:FAC+5,  val(TA:200)/Val(TE:200))
         */OTRO
         ACN(e:FAC+5,  val(TA:101)/Val(TE:101))
         */TOTAL
         ACN(f:FAC+5,  val(TA:102)/Val(TE:102))
         *FormatoCeldas(b:fac+5..e:fac+5, Exe('F8'))
         SetFont(a:FAC..f:FAC,2)
         SetFont(a:FAC+1..a:FAC+4,1)
         AgregarMarco(a:FAC..f:FAC,2,0,Exe('COLOR'))
         AgregarMarco(a:FAC..f:FAC+1,2,0)
         AgregarMarco(a:FAC..f:FAC+4,2,0)
         AgregarMarco(a:FAC..f:FAC+6,2,0)
