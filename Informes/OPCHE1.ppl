SetFont(A:fac-1..H:fac, 2)
AgregarMarco(F:fac..H:fac, 0, 0, Exe('COLOR2'))

ifa
ACN(A:fac,&TotalCapital)
ACN(B:fac,&TotalGastos)
ACN(C:fac,&TotalCapital + &TotalGastos)
ACN(F:fac,&TotalCapitalConci)
ACN(G:fac,&TotalInteresesConci)
ACN(H:fac,&TotalCapitalConci + &TotalInteresesConci)
AlinearCeldas(A:fac..H:fac,'C')
AgregarMarco(A:fac..C:fac, 0, 0, Exe('COLOR7'))
AgregarMarco(F:fac..H:fac, 0, 0, Exe('COLOR7'))

