SQL.ADD("select P.Especie,  P.NrSaldo, P.TipoNegocio, ")
SQL.ADD("       P.Vehiculo, E.Nombre, E.Cotiza,  E.InteresesC, ")
SQL.ADD("       Sum(P.CantidadFin) as Cantidad, ")
SQL.ADD("       Sum(P.CantidadFin*P.PrecioFin) as Monto, '' Observaciones, '' Cliente1, P.Vehiculo Vehiculo, E.Alias8,P.Book,P.Fecha ")
SQL.ADD(" from  "~DBO~".POSICIONES P, "~DBO~".ESPECIES E ")
SQL.ADD(" where P.Especie     = E.Codigo ")
SQL.ADD("   and P.NrSaldo     in ("~Val(yy:2)~") ")
SQL.ADD("   and P.TipoNegocio = 'SEC' ")
if NoVacio(Dialogo.Especie1)
  SQL.ADD("  and P.Especie     = '"~Dialogo.Especie1~"' ")
endif
If NoVAcio(Dialogo.Lista1)
   SQL.ADD(" AND P.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND P.Vehiculo IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
   Endif
Endif
***---SQL.ADD("   and P.CantidadFin <> 0 ")
SQL.ADD("   and P.Fecha       <= (select Max(Fecha) ")
SQL.ADD("                       from  "~DBO~".POSICIONES P2 ")
SQL.ADD("                       where P2.Especie     = P.Especie ")
***---SQL.ADD("                         and (LTrim(Rtrim(P2.Cupon)) = LTrim(Rtrim(P.Cupon)) or (P2.Cupon IS NULL and P.Cupon IS NULL)) ")
***---SQL.ADD("                         and P2.Cliente     = P.Cliente ")
SQL.ADD("                         and P2.Vehiculo    = P.Vehiculo ")
SQL.ADD("                         and P2.NrSaldo     = P.NrSaldo ")
SQL.ADD("                         and P2.TipoNegocio = P.TipoNegocio ")
SQL.ADD("                         and P2.Fecha      <= "~IdxDate2(Val(vv:1))~")  ")

***---No se valuan las Especies de companias de IRSA
SQL.ADD(" AND ((E.Alias8 Is Null OR E.Alias8 = '') Or (E.Alias8 > '9000' )) ")
SQL.ADD(" AND (E.EsCupon Is Null OR E.EsCupon = 'NO') ")
***/// PENDIENTE--SQL.ADD(" AND   P.Vehiculo    NOT IN ("~Pipe2Comillas(Var('VNOLIQUID')~Var('VNOLIQUID2'))~") ")

*SQL.ADD(" order by P.Especie, P.Cupon ")
SQL.ADD(" Group by P.Especie, P.NrSaldo, P.TipoNegocio, P.Vehiculo, E.Nombre, E.Cotiza, E.InteresesC, E.Alias8,P.Book,P.Fecha ")
watch(sql.batch)
Recorrer SQL
  IF Round(fbn('Cantidad'), 2) <> 0
    ACT(a:FAC, FBN('Especie'))
    ACT(b:FAC, FBN('Nombre'))
    ACT(c:FAC, FBN('Vehiculo'))
    ACT(d:FAC, FBN('Book'))
    ACD(e:FAC, FBN('Fecha'))
  *  ACT(c:Val(ww:1), FBN('Cupon'))
*  ACN(d:Val(ww:1), FBN('NrSaldo'))
*  ACT(e:Val(ww:1), FBN('TipoNegocio'))
  *  ACN(i:FAC, FBN('CantidadFin'))
*    ACN(j:FAC, FBN('PrecioFin'))
    ACN(f:FAC, FBN('Cantidad'))
    ACN(g:FAC, FBN('Monto')/FBN('Cantidad'))
    ACT(h:FAC, FBN('Cotiza'))
    ACN(i:FAC, CotizacionC(FBN('Especie'),,,,Val(vv:2),1,SI,FBN('Cotiza')))
    ACN(j:FAC, CotizacionC(FBN('Especie'),,,,Val(vv:1),1,SI,FBN('Cotiza')))
    ACN(k:FAC, Val(j:FAC)-Val(g:FAC))
    ACN(l:FAC, Val(f:FAC)*Val(k:FAC))
    ifa
  ENDIF
  dfa
proximo

ACN(ww:1, 10)
SQL.ADD("select M.FechaMov,    M.Cliente,     M.Especie,     M.Cupon,  ")
SQL.ADD("       M.NrSaldo,     M.TipoNegocio, M.Cantidad,    M.Precio, ")
SQL.ADD("       M.Vehiculo,    M.Book,        M.NrOperacion, ")
SQL.ADD("       E.Nombre,      E.Cotiza,      E.InteresesC,  ")
SQL.ADD("       O.TipoOp,      O.FechaOp, E.Tipo, V.Valor1, V.Valor2, E.Cotiza Moneda, O.ContraEspecie, ")
SQL.ADD("       O.PlazoRenovPredeter CotOp, O.Observaciones, E.Alias8 ")
SQL.ADD("  from "~DBO~".MOVPOSEJE M, "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O, "~DBO~".VEHICULOS V ")
SQL.ADD(" where M.NrSaldo     in ("~Val(yy:2)~") ")
SQL.ADD(" AND V.Codigo = M.Vehiculo ")
SQL.ADD("   and M.TipoNegocio = 'SEC' ")
if NoVacio(Dialogo.Especie1)
  SQL.ADD("  and M.Especie    = '"~Dialogo.Especie1~"' ")
endif
SQL.ADD("   and M.FechaMov    >= "~IdxDate2(Val(vv:3))~" ")
SQL.ADD("   and M.FechaMov    <=  "~IdxDate2(Val(vv:1))~" ")
SQL.ADD("   and M.Especie     = E.Codigo ")
SQL.ADD("   and M.NrOperacion = O.NrOperacion ")
***---No se valuan las Especies de companias de IRSA
SQL.ADD(" AND ((E.Alias8 Is Null OR E.Alias8 = '') Or (E.Alias8 > '9000' )) ")
If NoVAcio(Dialogo.Lista1)
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
  
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND O.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
   Endif
Endif
SQL.ADD(" AND (E.EsCupon Is Null OR E.EsCupon = 'NO') ")
***/// PENDIENTE--SQL.ADD(" AND  O.Vehiculo1    NOT IN ("~Pipe2Comillas(Var('VNOLIQUID')~Var('VNOLIQUID2'))~") ")

SQL.ADD(" order by M.Especie, M.NrOperacion ")
Recorrer SQL
  DFA
  SCN(ww:1,1)
  ACN(ww:2,0)
  if FAC>1
    recorrer&i 11,FAC
*      if EqStr(FBN('Especie'),Val(a:&i)) y EqStr(FBN('Cupon'),Val(c:&i))
      **//if EqStr(FBN('Especie'),Val(a:&i))
      if EqStr(FBN('Especie'),Val(a:&i)) Y EqStr(FBN('Vehiculo'),Val(c:&i))
       ACN(ww:2, &i)
        Break
      endif
    proximo
  endif
  if Val(ww:2)=0
    IFA
    ACT(a:FAC, FBN('Especie'))
    ACT(b:FAC, FBN('Nombre'))
    ACT(c:FAC, FBN('Vehiculo'))
    ACT(d:FAC, FBN('Book'))
    ACN(f:FAC, FBN('Cantidad'))
    ACD(e:FAC, FBN('FechaMov'))
    ACT(h:FAC, FBN('Cotiza'))
    ACN(i:FAC, CotizacionC(FBN('Especie'),,,,Val(vv:2),1,SI,FBN('Cotiza')))
    ACN(j:FAC, CotizacionC(FBN('Especie'),,,,Val(vv:1),1,SI,FBN('Cotiza')))
    ACN(k:FAC, Val(g:FAC)-Val(j:FAC))
    ACN(l:FAC, Val(f:FAC)*Val(k:FAC))
    *  ACT(c:Val(ww:1), FBN('Cupon'))
*  ACN(d:Val(ww:1), FBN('NrSaldo'))
*  ACT(e:Val(ww:1), FBN('TipoNegocio'))
    ACN(ww:2, FAC)
  endif

  ACT(p:Val(ww:1), FBN('Especie'))
  ACT(q:Val(ww:1), FBN('Nombre'))
*  ACT(ac:Val(ww:1), FBN('Cupon'))
*  ACN(ad:Val(ww:1), FBN('NrSaldo'))
*  ACT(ae:Val(ww:1), FBN('TipoNegocio'))
  ACT(r:Val(ww:1), FBN('Vehiculo'))
  ACT(s:Val(ww:1), FBN('Book'))
  ACD(t:Val(ww:1), FBN('FechaMov'))
  ACN(u:Val(ww:1), FBN('Cantidad'))
  IF Eqstr(fbn('Cotiza'), fbn('ContraEspecie'))
    ACN(v:Val(ww:1), FBN('Precio'))
  ELSE
      ACT(MD:2, SQL(" Select Modo From "~DBO~".MODOESPECIES Where Especie1 = '"~fbn('Cotiza')~"' AND Especie2 = '"~fbn('ContraEspecie')~"' "))
      ***---ACN(AJ:Val(W:1), IIF(Eqstr(Val(MD:2), 'INV'), fbn('Precio') / fbn('CotOp'), fbn('Precio') * fbn('CotOp')))
      ***---ACN(AJ:Val(W:1), IIF(Eqstr(Val(MD:2), 'INV'), fbn('Precio') * fbn('CotOp'), fbn('Precio') / fbn('CotOp')))
      ***---En la carga de operaciones se ingresa la cotizacion de cotiza en contraespecie.
      IF Eqstr(fbn('ContraEspecie'), Var('MONELOCA')) O Eqstr(fbn('Cotiza'), Var('MONELOCA'))
        ACN(v:Val(WW:1), fbn('Precio') / fbn('CotOp'))
      ELSE
        ACN(v:Val(WW:1), fbn('Precio') * fbn('CotOp'))
      ENDIF
  ENDIF
  ACT(w:Val(ww:1), FBN('Cotiza'))
  ACN(x:Val(ww:1), CotizacionC(FBN('Especie'),,,,Val(vv:2),1,SI,FBN('Cotiza')))
  ACN(y:Val(ww:1), Val(x:Val(ww:1))-Val(v:Val(ww:1)))
  ACN(z:Val(ww:1), Val(u:Val(ww:1))*Val(y:Val(ww:1)))
  ACN(aa:Val(ww:1), Val(ww:2))
  ACT(ab:Val(ww:1), FBN('NrOperacion'))
  ACLO(ab:Val(ww:1), FBN('NrOperacion'))
  ACT(ac:Val(ww:1), FBN('TipoOp'))
  ACD(ad:Val(ww:1), FBN('FechaOp'))
  ACT(ae:Val(ww:1), fbn('ContraEspecie'))
  ACN(af:Val(ww:1), fbn('CotOp'))
  SCN(m:Val(ww:2), Val(z:Val(ww:1)))
proximo

if FAC>1
