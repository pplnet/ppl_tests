CrearDialogo
  String1     : 'Cod.Ch.CVSA'                        ;;;;;;;;;
  Fecha1      : 'Fecha Desde'                        ;;;;;VACIO(Dialogo.String1);;;;PriDeMes(Fsys,SI);PriDeMes(Dialogo.Fecha1,SI)
  Fecha2      : 'Fecha Hasta'                        ;;;;;VACIO(Dialogo.String1);;;;FinDeMes(Fsys,SI);FinDeMes(Dialogo.Fecha2,SI)
  Vehiculo1   : 'Vehiculo'                           ;1;2;;;VACIO(Dialogo.String1);NoVacio(Dialogo.Vehiculo1);'Debe Ingresar un Vehiculo';NO;Var('DDVEHDEF')
  Book1       : 'Book'                               ;;;;SI;VACIO(Dialogo.String1);EqStr(Dialogo.Vehiculo1,BuscarCampo('BOOKS','Vehiculo','Codigo',Dialogo.Book1));'El book ingresado no corresponde al Vehiculo';NO;Var('BOOKDDCHE');BuscarCampo('VEHICULOS','Alias5','Codigo',Dialogo.Vehiculo1);;;;" Vehiculo = '"~Dialogo.Vehiculo1~"'"  
  Cliente1    : 'Comitente'                          ;4;1;;;VACIO(Dialogo.String1);;;;Var('DDCOMIDEF');;;;; "Codigo in (Select DISTINCT Cliente1 from OPERACIONES where TipoOp ='DDC')"
  Especie1    : 'Moneda'                             ;;;;NO;VACIO(Dialogo.String1);;;;Var('MONELOCA') 
  Radio1      : 'Segmento|No Avalado|Avalado|Ambos'  ;;;;;VACIO(Dialogo.String1);;;;2
  Radio2      : 'Cobrado|Si|No|Ambos'                ;;;;;VACIO(Dialogo.String1);;;;2
  Instrumento1: 'Instrumento'                        ;;;;;VACIO(Dialogo.String1);;;;  
FinDialogo

if Not Ok
  Cancelar
endif


CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,16,B')


let &filaLogo 1
@LOGO


SetFilaActual(fac+3)

ACT(F:1, 'Reporte Intereses Devengados')
SetFont(F:1, 3)
SetFilaActual(fac+2)

***---Header
If NoVacio(Dialogo.String1)
    ACT(A:fac, 'Cod.Ch.CVSA: '~Dialogo.String1)
    ifa
Else
    ACT(A:fac, 'Fecha Desde: ')
    ACT(B:fac,Dialogo.Fecha1)
    ifa

    ACT(A:fac, 'Fecha Hasta: ')
    ACT(B:fac,Dialogo.Fecha2)
    ifa
    If NoVacio(Dialogo.Vehiculo1)
        ACT(A:fac, 'Vehiculo:'~Dialogo.Vehiculo1)
        ifa
    Else
        ACT(A:fac, 'Vehiculos: Todos')
        ifa
    Endif
    If NoVacio(Dialogo.Book1)
        ACT(A:fac, 'Book:'~Dialogo.Book1)
        ifa
    Else
        ACT(A:fac, 'Books: Todos')
        ifa
    Endif
    If NoVacio(Dialogo.Cliente1)
        ACT(A:fac, 'Comitente: '~Dialogo.Cliente1)
        ifa
    Endif

    If NoVacio(Dialogo.Especie1)
        ACT(A:fac, 'Moneda: '~Dialogo.Especie1)
        ifa
    Endif


    If NoVacio(Dialogo.Instrumento1)
       ACT(A:fac, 'Instrumento:'~Dialogo.Instrumento1)
       ifa
    Else
       ACT(A:fac, 'Instrumento: Todos')
       ifa
    Endif
       
    IF Dialogo.Radio1 = 1
        ACT(A:fac, 'Segmento: Avalado')
        ifa
    ELSE
        If Dialogo.Radio1 = 0
        ACT(A:fac, 'Segmento: No Avalado')
            ifa
        Else
            ACT(A:fac, 'Segmento: Ambos')
            ifa
        Endif
    ENDIF

    IF Dialogo.Radio2 = 0
        ACT(A:fac, 'Cobrado: Si')
        ifa
    ELSE
        If Dialogo.Radio2 = 1
        ACT(A:fac, 'Cobrado: No')
            ifa
        Else
            ACT(A:fac, 'Cobrado/No: Ambos')
            ifa
        Endif
    ENDIF
Endif
SetFont(A:&fi1..A:fac, 2)
SetFont(B:&fi1..B:fac, 2)
ifa

***---Columnas
ACT(A:fac, 'Nro Item')
ACT(B:fac, 'NrOperacion')
ACT(C:fac, 'Subasta')
ACT(D:fac, 'Segmento')
ACT(E:fac, 'Moneda')
ACT(F:fac, 'Tasa')


ACT(G:fac, 'Concertacion')
ACT(H:fac, 'Liquidacion')
ACT(I:fac, 'Reg.Oper')
ACT(J:fac, 'Id.Cheque')
ACT(K:fac, 'Banco')
ACT(L:fac, 'Nro. Cheque')
ACT(M:fac, 'Acreditacion')
ACT(N:fac, 'Monto')

ACT(O:fac, 'Capital')
ACT(P:fac, 'Descuento')
ACT(Q:fac, 'Der.Mer.')
ACT(R:fac, 'Der.Bol.')
ACT(S:fac, 'Comitente')
ACT(T:fac, 'Cod.Ch.CVSA')
ACT(U:fac, 'Vto.')
ACT(V:fac, 'Nombre Banco') 
ACT(W:fac, 'Boleto') 
ACT(X:fac, 'Cobrado')

  

 
*** Columnas para devengados de cada mes segun el rango de fechas
let &CantMes DifMeses(Dialogo.Fecha1, Dialogo.Fecha2)

**escribo la columna  para el primer MES
 ACT(Z:fac, FinDeMes(Dialogo.Fecha1,SI))
 SetFont(Z:fac,2)
 AgregarMarco(Z:fac,2,0,Exe('COLOR'))
 

**Titulo Dev x mes
If &CantMes = 0
    ACT(Z:fac-2, 'Intereses')
    ACT(Z:fac-1, 'Devengados')
    SetFont(Z:fac-2..Z:fac-1,2)
    AgregarMarco(Z:fac-2..Z:fac-1,2,0,Exe('COLOR2'))
Else
    If &CantMes = 1
        ACT(Z:fac-1, 'Intereses')
        ACT(AA:fac-1, 'Devengados')
        SetFont(Z:fac-1..AA:fac-1,2)
        AgregarMarco(Z:fac-1..AA:fac-1,2,0,Exe('COLOR2'))
        AlinearCeldas(Z:fac-1,'D')
    Else
        ACT(Z+(&CantMes/2):fac-1, 'Intereses Devengados') 
        SetFont(Z+(&CantMes/2):fac-1,2)
        AgregarMarco(Z:fac-1..Z+&CantMes:fac-1,2,0,Exe('COLOR2')) 
    Endif
Endif

**Busco el siguiente mes y lo pongo dentro de una variable
let &SigMes Habiles(FinDeMes(Dialogo.Fecha1),+1)
Recorrer&i 1, &CantMes
        *Escribo el resto de meses  
        ACT(Z+&i:fac, FinDeMes(&SigMes,SI))

        ACO(25+&i+1,10)
        SetFont(Z+&i:fac,2)
        AgregarMarco(Z+&i:fac,2,0,Exe('COLOR'))
        **Utilizo la misma variable para ir recorriendo los meses
       let &SigMes Habiles(FinDeMes(&SigMes),+1)
Proximo

AlinearCeldas(A:FAC..Z+&CantMes:fac,'C')
SetFont(a:fac..Z+&CantMes:fac,2)
AgregarMarco(a:FAC..X:fac,2,0,Exe('COLOR'))
AgregarMarco(Z:FAC..Z+&CantMes:fac,2,0,Exe('COLOR'))

let &filaInicial fac
***---Query
SQL.ADD("   SELECT")
SQL.ADD(" O.NrOperacion,    O.NrOperacion2,    O.CB1,             O.Especie,      O.TipoOp, ")
SQL.ADD(" O.Precio1,        O.Cliente2,        O.FechaOp,         O.Hora1,        O.Hora2, ")
SQL.ADD(" O.FechaPago,      O.NrOperacion3,    O.NrOperacion4,    O.Cliente3,     O.OperacionRef, ")
SQL.ADD(" O.FechaVto2,      O.TotalBrutoCli1,  O.TotalIntereses,  O.Cantidad,     O.ImpComMer1,  ")
SQL.ADD(" O.ImpGastos1,     O.Cliente1,        O.MensajeChequeo,  O.MB2,          O.Numerador,")
SQL.ADD(" O.ObservacDoc,    O.ContraEspecie,   O.TipoCambio,      O.CB2,          O.CB3, ")
SQL.ADD(" O.FechaVto,       O.NrSucursal,      O.CB4,             O.CB5,          O.NrBoleto, ")
SQL.ADD(" O.TotalImpuestos, O.Plazo,           O.TipoDoc,         O.FechaCarga,   O.FechaCargaSys,")
SQL.ADD(" O.Cliente4,       O.Contrato,        O.Vehiculo1,       O.CodComitente, O.Book1,     ")
SQL.ADD(" O.Cuenta1,        O.RB1,             O.FechaEj,  ") 
*Modificación 03/04/2024 - Se incorpora query que estaba dentro del Recorrer SQL para optimizar tiempo de carga
SQL.ADD(" ISNULL((SELECT SUM(M.Monto) ")
SQL.ADD(" From "~DBO~".MOVDEVENGADOS M ")
SQL.ADD(" Where M.NrOperacion = O.NrOperacion ")
SQL.ADD(" AND M.Fecha >= '"~IdxDate(PriDeMes(Dialogo.Fecha1,SI))~"' ")
SQL.ADD(" AND M.Fecha <= '"~IdxDate(FinDeMes(Dialogo.Fecha1,SI))~"'),0) AS Monto ")
**************************************************************************************
SQL.ADD("FROM "~DBO~".OPERACIONES O")
SQL.ADD("INNER JOIN "~DBO~".OPERACIONESBITS OB ON O.NrOperacion=OB.NrOperacion")
SQL.ADD("WHERE O.TipoOp = 'DDC'")
SQL.ADD("AND OB.NrBit=50 AND OB.Valor=1")

If NoVacio(Dialogo.String1)
    SQL.ADD("AND O.ObservacDoc = '"~Dialogo.String1~"' ")
Else 
    SQL.ADD("AND O.FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"'  ") 

    If NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
    Endif
    If NoVacio(Dialogo.Book1)
         SQL.ADD("AND O.Book1 = '"~Dialogo.Book1~"' ")
    Endif

    If NoVacio(Dialogo.Cliente1)
        SQL.ADD("AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
    Endif

    If NoVacio(Dialogo.Especie1)
        SQL.ADD("AND O.Especie = '"~Dialogo.Especie1~"' ")
    Endif

    If NoVacio(Dialogo.Instrumento1)
            SQL.ADD("AND O.TipoDoc = '"~Dialogo.Instrumento1~"' ") 
    Endif
       
    IF Dialogo.Radio1 = 2
        SQL.ADD("AND (O.CB1 = 0 OR  O.CB1 = 1 )")
    ELSE
        SQL.ADD("AND O.CB1 = "~Fstr(Dialogo.Radio1,0,0)~" ")
    ENDIF 
    IF Dialogo.Radio2 = 0 
        SQL.ADD("AND O.RB1 >= 1 ")
    ELSE 
        IF Dialogo.Radio2 = 1
            SQL.ADD("AND O.RB1=0 ")
        ENDIF
    ENDIF
Endif

SQL.ADD("AND O.TipoOp IN ('DDC','DDV')   ")  
WATCH(SQL.BATCH)
let &contOperaciones 1
Recorrer SQL

    
    ACN(A:fac, &contOperaciones)       
    ACT(B:fac, fbn('NrOperacion'))
    ACLO(B:fac, fbn('NrOperacion'))
    ACT(C:fac, fbn('NrOperacion2'))
    
    IF fbn('CB1') = 1
        ACT(D:fac, 'Avalado')
    ELSE
        IF fbn('CB1') = 0
            ACT(D:fac, 'No Avalado')
        Endif
    ENDIF
    
    ACT(E:fac, fbn('Especie'))
    ACN(F:fac, fbn('Precio1'))
    ACD(G:fac, fbn('FechaOp'))
    ACD(H:fac, fbn('FechaPago'))
    ACT(I:fac, fbn('NrOperacion3'))
    ACT(J:fac, fbn('NrOperacion4'))
    ACT(K:fac, fbn('Cliente3'))
    ACT(L:fac, fbn('OperacionRef'))
    ACD(M:fac, fbn('FechaVto2'))
    ACN(N:fac, fbn('TotalBrutoCli1'))
    ACN(O:fac, fbn('Cantidad'))
    let &totalCapital &totalCapital+Val(O:fac)
    ACN(P:fac, fbn('TotalIntereses'))
    ACN(Q:fac, fbn('ImpGastos1'))
    ACN(R:fac, fbn('ImpComMer1'))
    ACT(S:fac, fbn('CodComitente'))
    ACT(T:fac, fbn('ObservacDoc'))
    ACD(U:fac, fbn('FechaVto'))
    ACT(V:fac, BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Cliente3'))) 
    ACT(W:fac, fbn('NrBoleto'))
    IF fbn('RB1') = 0 Y fbn('FechaVto')<FSYS
        ACT(X:fac, 'MORA')
    ELSE
        IF fbn('RB1') >= 1 
            ACT(X:fac, 'SI')
            let &capitalCobrado &capitalCobrado+Val(O:fac)
        ELSE
            ACT(X:fac, 'NO')
        Endif
    ENDIF


      *--Intereses Devengados de cada mes
      **Escribo la columna  para el primer MES
      *UPDATE 03/04/2024 - Se remueve sentencia SQL original para acelerar tiempos de carga. Revisar cambios en query principal.
      *ACN(Z:fac, SQL(" Select Sum(M.Monto) From "~DBO~".MOVDEVENGADOS M Where M.NrOperacion = '"~fbn('NrOperacion')~"' AND M.Fecha >= '"~IdxDate(PriDeMes(Dialogo.Fecha1,SI))~"' AND M.Fecha <= '"~IdxDate(FinDeMes(Dialogo.Fecha1,SI))~"'"))
      ACN(Z:fac, FBN('Monto'))
        **Busco el siguiente mes y lo pongo dentro de una variable
        let &SigMes Habiles(FinDeMes(Dialogo.Fecha1),+1)
        
        Recorrer&j 1, &CantMes

                *Escribo el resto de meses  
                ACN(Z+&j:fac, SQL(" Select Sum(M.Monto) From "~DBO~".MOVDEVENGADOS M Where M.NrOperacion = '"~fbn('NrOperacion')~"' AND M.Fecha >= '"~IdxDate(PriDeMes(&SigMes,SI))~"' AND M.Fecha <= '"~IdxDate(FinDeMes(&SigMes,SI))~"' "))
                 **Utilizo la misma variable para ir recorriendo los meses
               let &SigMes Habiles(FinDeMes(&SigMes),+1)
               let &totalIntereses &totalIntereses + Val(Z+&j:fac)
               IF fbn('RB1') = 1 O fbn('RB1') = 2
                    let &interesesCobrados &interesesCobrados + Val(Z+&j:fac)
               ENDIF
        Proximo
        let &contOperaciones &contOperaciones + 1
Proximo

AlinearCeldas(A:&filaInicial..E:fac,'C')
AlinearCeldas(G:&filaInicial..M:fac,'C')
AlinearCeldas(S:&filaInicial..X:fac,'C')
FormatoCeldas(A:&filaInicial..A:fac, Exe('F0'))
FormatoCeldas(F:&filaInicial..F:fac, Exe('F8'))
AgregarMarco(A:&filaInicial+1..X:fac,2,0,Exe('COLOR7'))
AgregarMarco(Z:&filaInicial+1..Z+&CantMes:fac,2,0,Exe('COLOR7'))


Recorrer&j 1, &CantMes
    
    Recorrer&k &filaInicial, fac
    
        SCN(100:fac, Val(Z:&k))
        ACN(Z:fac+1, Val(100:fac))
    
        SCN(100+&j:fac, Val(Z+&j:&k))
        ACN(Z+&j:fac+1, Val(100+&j:fac))
    Proximo
    SetFont(Z:fac+1,2)
    AgregarMarco(Z:fac+1,2,0,Exe('COLOR'))
    SetFont(Z+&j:fac+1,2)
    AgregarMarco(Z+&j:fac+1,2,0,Exe('COLOR'))
    
Proximo
 

**Totales Capital
SetFilaActual(fac+3)
ACT(O:fac, 'Planilla:')
ACN(P:fac, &totalCapital)
ifa
ifa
ACT(O:fac, 'Cobrado:')
ACN(P:fac, &capitalCobrado)
ifa
ifa
ACT(O:fac, 'Cartera:')
ACN(P:fac, &totalCapital - &capitalCobrado)

AlinearCeldas(O:fac-4..O:fac,'I')
SetFont(O:fac-4..P:fac, 2)
AgregarMarco(O:fac-4..P:fac,2,0,Exe('COLOR7'))
AgregarMarco(O:fac-4..P:fac-4,2,0,Exe('COLOR'))
AgregarMarco(O:fac-2..P:fac-2,2,0,Exe('COLOR'))
AgregarMarco(O:fac..P:fac,2,0,Exe('COLOR'))

**Totales Devengados   
SetFilaActual(fac-4)
ACT(Z:fac, 'Planilla:')
ACN(AA:fac, &totalIntereses)
ifa
ifa
ACT(Z:fac, 'Cobrado:')
ACN(AA:fac, &interesesCobrados)
ifa
ifa
ACT(Z:fac, 'Cartera:')
ACN(AA:fac, &totalIntereses - &interesesCobrados)

AlinearCeldas(z:fac-4..z:fac,'I')
SetFont(z:fac-4..aa:fac, 2)
AgregarMarco(Z:fac-4..aa:fac,2,0,Exe('COLOR7'))
AgregarMarco(Z:fac-4..aa:fac-4,2,0,Exe('COLOR'))
AgregarMarco(Z:fac-2..aa:fac-2,2,0,Exe('COLOR'))
AgregarMarco(Z:fac..aa:fac,2,0,Exe('COLOR'))




ACO(15,10)
ACO(20,10)
ACO(22,20)
ACO(26,10)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL INFORME')
SetFont(a:FAC, 2)
LimitesVision(Z+&CantMes+1:fac)


    