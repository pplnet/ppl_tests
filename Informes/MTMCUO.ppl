CrearDialogo
  NrOperacion1: 'Operacion'     ;2;1;;;;NoVacio(Dialogo.NrOperacion1);'Debe ingresar la operacion';NO;;
FinDialogo

If Not OK
  Cancelar
EndIf

CrearFont(1,'Arial,9,BU')
CrearFont(2,'Arial,8,B')
CrearFont(3,'Arial,8,')

ACT(A:2,'Detalle MTM Por Operacion')
SetFont(A:2,1)

SetFilaActual(4)

ACT(A:FAC,'NrOperacion:')
ACT(B:FAC,Dialogo.NrOperacion1)
ACLO(B:FAC,Val(B:FAC))
ACT(A:FAC+1,'VN:')
ACN(B:FAC+1,BuscarCampo('OPERACIONES','Cantidad','NrOperacion',Dialogo.NrOperacion1))
ACT(A:FAC+2,'Tipo Op:')
ACT(B:FAC+2,BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1))

FormatoCeldas(B:FAC+1, Exe('F2'))
SetFont(A:FAC..B:FAC+2,2)
AlinearCeldas(B:FAC..B:FAC+2,'D')

SetFilaActual(FAC+4)

ACT(A:FAC,'Fecha Hoy')
ACT(B:FAC,'Fecha Ayer')
ACT(C:FAC,'Cot. Hoy')
ACT(D:FAC,'Cot. Ayer')
ACT(E:FAC,'MTM')
ACN(CE:1,FAC)
AlinearCeldas(A:FAC..A:FAC,'C')
AgregarMarco(A:FAC..E:FAC,2,0,Exe('COLOR'))
SetFont(A:FAC..E:FAC,2)

SQL.ADD(" Select M.Fecha1, M.Fecha2, M.PrecioHoy, M.PrecioAyer, M.MTM, O.CB6")
SQL.ADD("   from "~DBO~".MTMDIARIO M")
SQL.ADD(" JOIN "~DBO~".OPERACIONES O ")
SQL.ADD(" ON O.NrOperacion = M.NrOperacion ")
SQL.ADD("  Where M.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" Order by Fecha1 ")
  
ACN(Z:1,FAC+1)

**Fecha 1 es la Fecha que voy a usar para poder extraer los datos
  
Recorrer SQL
  ACD(A:FAC,FBN['Fecha1'])
  ACD(B:FAC,FBN['Fecha2'])
  ACN(C:FAC, fbn('PrecioHoy'))
  ACN(D:FAC, fbn('PrecioAyer'))
  ACN(E:FAC, fbn('MTM'))
  let &Manual fbn('CB6')
  SCN(TO:1,Val(E:FAC))
Proximo
AlinearCeldas(A:Val(CE:1)+1..A:FAC,'C')

