IFA
ACT(A:FAC,&DescDerRegVto)
ACD(B:FAC,&FechaVto)
ACN(C:FAC,&DerechosRegistroVTO)
IFA
ACT(A:FAC,&DescIVADerRegVto)
ACD(B:FAC,&FechaVto)
ACN(C:FAC,&IVADerechosRegistroVTO)
IFA
ACT(A:FAC,&DescDerClearVto)
ACD(B:FAC,&FechaVto)
