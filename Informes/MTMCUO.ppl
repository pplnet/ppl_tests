IF &Manual = 0
    SQL.ADD(" SELECT Arancel1, TotalIVA3, CASE TipoOp WHEN 'FXVF' THEN -Arancel2 ELSE Arancel2 END Arancel2, CASE TipoOp WHEN 'FXVF' THEN -TotalIVA4 ELSE TotalIVA4 END TotalIVA4,  ")
    SQL.ADD(" ImpComMerEq1, TotalIVA, ImpComMerEq2, TotalIVA2, FechaOp, FechaVto, ")
    SQL.ADD(" CASE TipoOp WHEN 'FXVF' THEN -ImpComMerEq3 ELSE ImpComMerEq3 END ImpComMerEq3, CASE TipoOp WHEN 'FXVF' THEN -ImpComMerEq4 ELSE ImpComMerEq4 END ImpComMerEq4,")
    SQL.ADD(" CASE TipoOp WHEN 'FXVF' THEN -TotalIVA5 ELSE TotalIVA5 END TotalIVA5, CASE TipoOp WHEN 'FXVF' THEN -TotalIVA6 ELSE TotalIVA6 END TotalIVA6 ")
    SQL.ADD(" FROM "~DBO~".OPERACIONES ")
    SQL.ADD(" WHERE NrOperacion = '"~Dialogo.NrOperacion1~"' ")
ELSE
    SQL.ADD(" Select O.Arancel1, O.TotalIVA3, CASE O.TipoOp WHEN 'FXVF' THEN -O.Arancel2 ELSE O.Arancel2 END Arancel2, CASE O.TipoOp WHEN 'FXVF' THEN -O.TotalIVA4 ELSE O.TotalIVA4 END TotalIVA4,  ")
    SQL.ADD(" O.FechaOp, O.FechaVto, CU.Total2, CU.Total3, CU.Descripcion ")
    SQL.ADD(" FROM "~DBO~".OPERACIONES O JOIN "~DBO~".CUOTAS CU ")
    SQL.ADD(" ON O.NROPERACION = CU.NROPERACION ")
    SQL.ADD(" WHERE O.NROPERACION = '"~Dialogo.NrOperacion1~"' AND CU.Descripcion is not null ")
    SQL.ADD(" ORDER BY CU.Fecha1 ")
ENDIF

let &DerechosRegistro 0
let &IVADerechosRegistro 0
let &DerechosClearing 0
let &IVADerechosClearing 0

let &DerechosRegistroVTO 0
let &IVADerechosRegistroVTO 0
let &DerechosClearingVTO 0
let &IVADerechosClearingVTO 0

*HAY QUE DESARROLLAR PARA LAS CUOTAS QUE VENGAN DE ROFEX. NO ESTÁ COMPLETO
Recorrer SQL
    DFA
    IF &Manual = 0
     let &FechaOp FBN['FechaOp']
        let &FechaVto FBN['FechaVto']
        let &ArancelAlta FBN['Arancel1']
        let &IVAArancelAlta FBN['TotalIVA3']
        let &ArancelVto FBN['Arancel2']
        let &IVAArancelVto FBN['TotalIVA4']
        let &DerechosRegistro &DerechosRegistro+FBN['ImpComMerEq1']
        let &IVADerechosRegistro &IVADerechosRegistro+FBN['TotalIVA']
        let &DerechosClearing &DerechosClearing+FBN['ImpComMerEq2']
        let &IVADerechosClearing &IVADerechosClearing+FBN['TotalIVA2']
        let &DerechosRegistroVTO &DerechosRegistroVTO+FBN['ImpComMerEq3']
        let &IVADerechosRegistroVTO &IVADerechosRegistroVTO+FBN['TotalIVA5']
        let &DerechosClearingVTO &DerechosClearingVTO+FBN['ImpComMerEq4']
        let &IVADerechosClearingVTO &IVADerechosClearingVTO+FBN['TotalIVA6']
        let &DescDerClearAlt "Der. Clearing Alta"
        let &DescIVADerClearAlt "IVA Der. Clear. Alta"
        let &DescDerRegAlt "Der. Registro Alta"
        let &DescIVADerRegAlt "IVA Der. Reg. Alta"
        let &DescDerClearVTO "Der. Clearing VTO"
        let &DescIVADerClearVTO "IVA Der. Clear. VTO"
        let &DescDerRegVTO "Der. Registro VTO"
        let &DescIVADerRegVTO "IVA Der. Reg. VTO"
    ELSE
        let &FechaOp FBN['FechaOp']
        let &FechaVto FBN['FechaVto']
        let &ArancelAlta FBN['Arancel1']
        let &IVAArancelAlta FBN['TotalIVA3']
        let &ArancelVto FBN['Arancel2']
        let &IVAArancelVto FBN['TotalIVA4']
        let &DescDerClearAlt "Der. Clearing DLR Rofex"
        let &DescIVADerClearAlt "IVA Der. Clear. DLR Rofex"
        let &DescDerRegAlt "Der. Registro DLR Rofex"
        let &DescIVADerRegAlt "IVA Der. Reg. DLR Rofex"
        let &DescDerClearVTO "Der. Clearing DLR Rofex"
        let &DescIVADerClearVTO "IVA Der. Clear. DLR Rofex"
        let &DescDerRegVTO "Der. Registro DLR Rofex"
        let &DescIVADerRegVTO "IVA Der. Reg. DLR Rofex"
        let &DerechosRegistroVTO 0
        let &IVADerechosRegistroVTO 0
        let &DerechosClearingVTO 0
        let &IVADerechosClearingVTO 0
        IF Buscar('Registro',FBN['Descripcion'])
           let &DerechosRegistro &DerechosRegistro+FBN['Total2']
           let &IVADerechosRegistro &IVADerechosRegistro+FBN['Total3']
        ELSE
           let &DerechosClearing &DerechosClearing+FBN['Total2']
           let &IVADerechosClearing &IVADerechosClearing+FBN['Total3']
        ENDIF
    ENDIF
Proximo

IFA
