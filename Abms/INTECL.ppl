set ds_TipoDocum           = "CI:CI|DNI:DNI|LE:LE|LC:LC|PAS:Pasaporte|CIP:C.I.Provincial|CUI:CUIT|GCE:Grupo Crediticio/Economico|OTR:Otro|"
set ds_StatusPoder         = "VIG:Vigente|VEN:Vencido|REV:Revocado|"
set ds_TipoPoder           = "TIT:Titular|CTI:Co Titular|AUT:Autorizado|APO:Apoderado|"
set ds_Sexo                = "MAS:Masculino|FEM:Femenino|"
set ds_EstadoCivil         = "SOL:Soltero|CAS:Casado|DIV:Divorciado|VIU:Viudo|"

def abm "INTEGRANTESCLI"
    def grid
        Nombre:,
        TipoDocumento:,
        NrDocumento:,
        FechaNacimiento:,
        Sexo:,
        EstadoCivil:,
        Nacionalidad:,
        StatusPoder:,
        FechaVtoPoder:,
        TipoPoder:,
        Calle:,
        Numero:,
        Localidad:,
        CodigoPostal:,
        ActividadBCRA:,
        Codigo:
    end
    def filter
        "Codigo = '" + $.parent('Codigo') + "'"
    end
    def key
        Codigo:
    end
    def dialog
        #**************************************************************************
        tab "General"
            column
                Nombre:,, large_text
                NrDocumento:,, text
                Nacionalidad:,, large_text
                FechaNacimiento:, , date
                Calle:,'Direccion', large_text
                Numero:,, small_text
                Localidad:,, large_text
                CodigoPostal:,, large_text
                ActividadBCRA: , , autocomplete, 'ACTIVIDADESBCRA', 'Codigo,Descripcion' 
                TipoDocumento: , 'Tipo Documento', combo, ds_TipoDocum
                Codigo:,,
             column
                Sexo: , , combo, ds_Sexo
                EstadoCivil: , , combo, ds_EstadoCivil
                StatusPoder:,          , combo, ds_StatusPoder
                TipoPoder:,          , combo, ds_TipoPoder
    end

    disable_fields: Codigo:
    hide_fields: Codigo:;
    validates_max_length_of:
       Codigo:,10,true;
       NrDocumento:,12,true;
       Nacionalidad:,10,true;
       Calle:,20,true;
       Numero:,10,true;
       Localidad:,20,true;
       CodigoPostal:,10,true;

    validates_uniqueness_of: Codigo:
    before_show_create_dialog: do
        $.set_field  (Codigo:, $.parent("Codigo"))
    end

end