def abm 'books'
   def grid
   Codigo:, Descripcion: ,Vehiculo:
   end
   def key
       Codigo:
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Codigo: , 'Codigo', small_text
             Descripcion: ,          , large_text
             Vehiculo: , 'Vehiculo', autocomplete, 'VEHICULOS', 'Codigo,Descripcion'
             Responsable: , 'Responsable', autocomplete, 'RESPONSABLES', 'Codigo,Descripcion'
             TipoNegocio: , 'Tipo Negocio', autocomplete, 'TIPOSNEGOCIO', 'Codigo,Descripcion'
             TipoBook: , 'RMSBook', autocomplete, 'TIPOSBOOK', 'Codigo,Descripcion'
        %%ifdef BFSA
          column
            CB1: , 'Requiere instruccion', check
        %%endif
       #**************************************************************************
       tab 'Valores'
          column
             Alias1: , 'Alias 1',
             Alias2: , 'Alias 2', 
             Alias3: , 'Alias 3', 
             Alias4: , 'Alias 4', 
             Alias5: , 'Alias 5', 
          column
             Valor1: , 'Valor 1', numeric
             Valor2: , 'Valor 2', numeric
             Valor3: , 'Valor 3', numeric
             Valor4: , 'Valor 4', numeric
             Valor5: , 'Valor 5', numeric
          column          
             Fecha1: , 'Fecha 1', date 
             Fecha2: , 'Fecha 2', date
             Fecha3: , 'Fecha 3', date
             Fecha4: , 'Fecha 4', date
             Fecha5: , 'Fecha 5', date

       #**************************************************************************
       tab 'Listas'
          column
             TiposOperacion: , , autocomplete_ar_list, 'TiposOperacion', 'Codigo,Nombre'
          column 
             Especies: , , autocomplete_ar_list, 'Especies', 'Codigo,Nombre'
             
             #       tab 'NrItem'
             #column
             #Integrantes:, 'Integrantes' ,embeded_abm,"INTECL"
        %%ifdef BFSA
        tab 'Limites'
          column
             Limites: , , embeded_abm, "LIASBO"
        %%endif
   end
   upper_case_fields: Codigo:
   
   validates_max_length_of:
   Codigo:, 10,true;
   Descripcion:, 40,true;
   %%ifdef BFSA      
   Alias1:, 8,true;
   %%else 
   Alias1:, 15,true; 
   %%endif
   Alias2:, 15,true; 
   Alias3:, 15,true; 
   Alias4:, 15,true; 
   Alias5:, 15,true;
   
   validates_uniqueness_of: Codigo:
end