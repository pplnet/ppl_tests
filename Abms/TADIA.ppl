#*********************************************************************************
#combos data sources.
 set fsys = db.get_scalar("SELECT convert(datetime, Valor, 103) from "+Dbo+".VARIABLES where Codigo='FECHASYS' ") 
#*********************************************************************************
def abm 'TasasDia'
   def grid
   Fecha:, Especie:, TipoTasa:, PlazoDesde:, PlazoHasta:, Valor1: as 'Tasa' 
   end
   def key
       Fecha:, Especie:, TipoTasa:, PlazoDesde: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Fecha: ,          , date
             Especie: ,          , autocomplete, 'ESPECIES', 'Codigo,Nombre'
             TipoTasa: , 'Tipo Tasa', autocomplete, 'TIPOSTASA', 'Codigo,Nombre'
             PlazoDesde: , 'Plazo Desde', numeric ,'###0'
             PlazoHasta: , 'Plazo Hasta', numeric ,'###0'
       #**************************************************************************
       tab 'Valores'
          column
          Valor1: , 'Tasa', numeric ,'########0.00000000'
          Valor2: , 'Valor 2', numeric ,'########0.00000000'
          Valor3: , 'Valor 3', numeric ,'########0.00000000'
          Valor4: , 'Valor 4', numeric ,'########0.00000000'
          Valor5: , 'Valor 5', numeric ,'########0.00000000'
   end
   before_show_create_dialog: do
     $.set_field(Fecha:, fsys)
   end
   upper_case_fields: Especie:, TipoTasa:
   validates_uniqueness_of_set: Fecha:, Especie:, TipoTasa:
end