def abm 'ArancelesTiposCliente'
   def grid
      Arancel:, TipoCliente: 
   end
   def key
      Arancel: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Arancel: ,          , autocomplete, 'ARANCELES', 'Codigo,Descripcion'
             TipoCliente: , 'Tipo Cliente' , autocomplete, 'TIPOSCLIENTE', 'Codigo,Descripcion'
       tab 'Valores'
          column
             Porcentaje: ,          , numeric,'#######0.0000000000'
             Minimo: ,          , numeric,'#######0.0000000000'
             Fijo: ,          , numeric,'#######0.0000000000'
             BasePorcentaje: , 'Base Porcentaje', numeric,'#######0.0000000000'
             Maximo: ,  , numeric,'#######0.0000000000'
    end
        validates_max_length_of:
        Arancel: , 6,true;    
        TipoCliente: ,6,true; 
        Porcentaje: ,30,true; 
        Minimo: ,30,true; 
        Fijo: , 30  ,true;      
        BasePorcentaje:,30,true; 
        Maximo:,30,true;
       upper_case_fields: Arancel: 
end
