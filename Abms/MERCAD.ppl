def abm 'Mercados'
    def grid
       Codigo:, Descripcion:, Observaciones:
    end
    def key
       Codigo:
    end
    def dialog
        #**************************************************************************
        tab 'General'
            column
                Codigo: ,, small_text
                Descripcion: ,,large_text
                Observaciones: ,, large_text
    end
