# Instancio ExtendedPPL
set xppl = $.NewExtendedPPL()

#*********************************************************************************
def abm 'Especies'
   def grid
   Jerarquia:, Codigo:, Nombre:, Extendido:, ISIN: 
   end
   def key
       Jerarquia:, Codigo:
   end
   
   def context_menu
       "Copiar Especie", do
       set especie = sender.Codigo; 
       $.EjecutarEvento('COPESP', {especie1:especie})
       $.RefreshGrid()
       end 
   end
   
