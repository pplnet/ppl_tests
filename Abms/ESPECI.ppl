set ds_Status              = "HAB:Habilitada|DES:Deshabilitada|"
set ds_InteresesC          = "DIR:Dirty|CLE:Clean|"
set ds_CotizaMAE           = "DIR:Dirty|CLE:Clean|"
set ds_DiasMes             = "30:30|REA:Real|30E:30E|31E:30E+1|"
set ds_DiasAnio            = "360:360|365:365|REA:Real|"
set ds_Tipo                = ":|PUB:Publico|PRI:Privado|ONE:O.N.|FON:Fondo|MON:Moneda|OTR:Otro|IND:Indice"
set ds_TipoEC              = "ESC:Escritural|CAR:Cartular|"
set ds_TipoCartera         = "CON:Conservadora|MOD:Moderada|AGR:Agresiva|"
set ds_Modo                = "NOR:Normal|CAL:Called|PUT:Put|DEF:Default|"
set ds_IVA                 = "EXE:Exento|IVA:IVA|RNI:IVA RNI|"
set ds_FormaCalculoInts    = "IND:Indice|TAS:Tasa|"
set ds_PIKs                = "NO:No|SIE:Siempre|OPT:Optativo|"
set ds_Security            =  "0:I|1:II|2:III|3:Otro|" 
set ds_Tasa                =  "FIJ:Fija|FLO:Variable|"
set ds_DvTasa              =  "COR:Fecha Corte|PAG:Fecha Pago|PAO:Fecha Pago Original|"
set ds_Fondo               = "0:MM|1:Securities|"
set ds_Fondo1              = "0:Round|1:Trunc|"
