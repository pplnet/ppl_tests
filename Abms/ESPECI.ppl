   required_fields: Codigo:
   upper_case_fields: Codigo:, Alias9:
   disable:  Jerarquia:,1=1;
   # Esto hace que el campo no se grabe.
   do_not_map: Bcuelga:, Fondo:, Alias2Bis:, Fondo1:, Valor3Bis:, Fondo2:, Valor2Bis:,Alias6Bis:
   
   hide_fields: 
   Bcuelga:
   
   before_show_create_dialog: do 
        if $.Alta()
            # Se muestra solo en el alta
            $.show(Bcuelga:)
            set jerRef = $.val(sender.JERARQUIA)
            $.set_field Jerarquia:, ppl.GenerarJerarquiaByRef('ESPECIES', jerRef, $.val Bcuelga: = 'SI')
            #Combos que vienen con default
            $.set_field DiasMes:, 'REA'
            $.set_field DiasAnio:, 'REA'
            $.set_field ZeroCoupon:, false
            $.Enable(Cupon:)
            $.show(EsJerarquia:)
            $.Hide(TipoIndice:)
        endif
   end
   
   before_show_dialog: do 
   If ppl.DesciendeDeEspecie(val (sender.Codigo),'TITULO') 
         If $.val(MonedaEmision:) == 'USD'
             $.hide(Alias6:)
             $.show(Alias6Bis:)
         else
             $.show(Alias6:)
             $.hide(Alias6Bis:)
         endif
    else
         $.show(Alias6:)
         $.hide(Alias6Bis:)
    endif
    if $.Alta()
           $.set_field ZeroCoupon:, false
           $.Enable(Codigo:)
           $.Enable(EsJerarquia:)
           $.Enable(Cupon:)
           $.hide(Alias2:)
           $.hide(Fondo:)
           #$.hide(Alias2Bis:)
           $.hide(Valor3:)
           $.hide(Fondo1:)
           #$.hide(Valor3Bis:)
           $.hide(Valor2:)
           $.hide(Fondo2:)
           $.hide(Indice:)
          # $.hide(Valor2Bis:)
          $.set_field Tipo:, ''
           IF $.val(Tipo:) == 'FON'
               $.set_field Fondo:, null
               $.set_field Fondo1:, null
               $.set_field Alias2Bis:, null
               $.set_field Valor3Bis:, null
           end
           
        end
        
        IF  $.Modificacion() OR $.Baja()
            $.Disable(Codigo:)
            $.Disable(EsJerarquia:)
            $.hide(Alias2:)
            $.hide(Valor3:)
            $.hide(Valor2:)
            #$.show(Alias2:)
            If $.val Indexado: = 'SI'
                $.show(Indice:)
            else
                $.hide(Indice:)
                $.set_field Indice:, ''
            end
            If ppl.DesciendeDeEspecie(val (sender.Codigo),'TITULO') AND $.val MonedaEmision: = 'USD'
                $.set_field Alias6Bis:, $.val(Alias6:)
            else
                true
            endif
            If $.val(Tipo:) == 'FON'
                $.set_field Fondo:, $.val(Alias2:)
                $.show(Fondo:)
                $.hide(Alias2Bis:)
                $.set_field Fondo1:, $.val(Valor3:)
                $.show(Fondo1:)
                $.hide(Valor3Bis:)
                $.set_field Fondo2:, $.val(Valor2:)
                $.show(Fondo2:)
                $.hide(Valor2Bis:)
            else
                $.set_field Alias2Bis:, $.val(Alias2:)
                $.set_field Fondo:, null
                $.set_field Fondo1:, null
                $.set_field Fondo2:, null
                $.show(Alias2Bis:)
                $.hide(Fondo:)
                $.set_field Valor3Bis:, $.val(Valor3:)
                $.show(Valor3Bis:)
                $.hide(Fondo1:)
                $.set_field Valor2Bis:, $.val(Valor2:)
                $.show(Valor2Bis:)
                $.hide(Fondo2:)
            end
            
        endif
    end
   
   
   
   when_change: Bcuelga: do
        if $.Alta()
            set jerRef = $.val(sender.JERARQUIA)
            $.set_field Jerarquia:, ppl.GenerarJerarquiaByRef('ESPECIES', jerRef, $.val Bcuelga: = 'SI')
        endif
   end
   
   when_change: Indexado: do
        If $.val Indexado: = 'SI'
            $.show(Indice:)
        else
            $.hide(Indice:)
            $.set_field Indice:, ''
        end
    end   
   
   #**********************
   # INDICES
   when_change: Tipo: do
        If $.val(Tipo:) = 'IND'
            $.Show(TipoIndice:)
            $.Show(Alias2Bis:)
            $.hide(Fondo:)
            $.Show(Valor3Bis:)
            $.hide(Fondo1:)
            $.Show(Valor2Bis:)
            $.hide(Fondo2:)
        else
            $.Hide(TipoIndice:)
            $.set_field TipoIndice:, null
            If $.val(Tipo:) = 'FON'
                $.Show(Fondo:)
                $.hide(Alias2Bis:)
                $.Show(Fondo1:)
                $.hide(Valor3Bis:)
                $.Show(Fondo2:)
                $.hide(Valor2Bis:)
                $.set_field Fondo:, null
                $.set_field Fondo1:, null
            else
                $.Show(Alias2Bis:)
                $.hide(Fondo:)
                $.Show(Valor3Bis:)
                $.hide(Fondo1:)
                $.Show(Valor2Bis:)
                $.hide(Fondo2:)
                $.set_field Alias2Bis:, null
                $.set_field Valor3Bis:, null
            endif
        endif
   end
   
   before_show_dialog: do
       If $.val(Tipo:)='IND'
           $.Show(TipoIndice:)
       Endif
   end
   
   #**********************************************
   
   
    
    
   when_change: MonedaEmision: do
       If ppl.DesciendeDeEspecie(val (sender.Codigo),'TITULO') 
         If $.val(MonedaEmision:) == 'USD'
             $.hide(Alias6:)
             $.show(Alias6Bis:)
         else
             $.show(Alias6:)
             $.hide(Alias6Bis:)
         endif
       else
         $.show(Alias6:)
         $.hide(Alias6Bis:)
       endif
   end
    
      when_change: Tipo: do
        If $.val(Tipo:) = 'PUB' OR $.val(Tipo:) = 'ONE' 
           If $.val EsCupon: = 'NO'  
                $.set_field Alias3:, 'C'+$.val(Codigo:)
                $.Disable(Alias3:)
                set ds_TipoEnviar = $.val(Tipo:)
           end     
        else        
            $.set_field Alias3:, null
            $.Enable(Alias3:)
        endif  
      end

   before_save:  do
     If ppl.DesciendeDeEspecie(val (sender.Codigo),'TITULO') 
        If $.val ZeroCoupon: = 'SI'
           If $.val Cupon: > 1
              $.Alert('La especie es ZeroCoupon y el # cupon es > 1.')
              false
#              RespMessage = 2
#              set RespMessage =  ppl.MessageBox('La especie es ZeroCoupon y el # cupon NO es 0. Confirma?',1,1)
#              ppl.MessageBox(RespMessage)
#              if ppl.MessageBox('La especie es ZeroCoupon y el # cupon NO es 0. Confirma?',1,2) = 6
#                 true
#              else
#                 false
#              end
           else
              true
           end
        else
           If $.val Cupon: = 0
              $.Alert('El # cupon es 0 y la especie NO es ZeroCoupon.')
              false
           else
              true
           end
        end
     else
        true
     end
   end
   
   
   before_save: do
        If ppl.DesciendeDeEspecie(val (sender.Codigo),'TITULO') 
            If __action__ = "A"
           If $.val EsJerarquia: = 'NO'
              If $.val PaisOrigen: = null 
                 $.Alert('Debe completar el campo PaisOrigen antes de guardar ')
                 false
              else
                 true
              end
          else
             true
          end
        else
           true
        end
   else
        true
     end
   end
   
   
  
   
   before_save: do
    if $.val(Tipo:) = 'FON'
           If $.val Issuer: = null
              $.Alert('Emisor Obligatorio ')
              false
           else
               If $.val Fondo: = null 
                  $.Alert('TipoFci Obligatorio ')
                  false
               else
               if $.val Fondo1: = null 
                       $.Alert('Round/Trunc FCI Obligatorio ')
                       false
                   else
                       true
                   end
               end
            end
        else
            true
        end
   end
   
   before_save: do
        if  $.val(Tipo:) = 'FON'
            $.set_field Alias2:, $.val(Fondo:)
            $.set_field Valor3:, $.val(Fondo1:)
            $.set_field Valor2:, $.val(Fondo2:)
        else
            if $.val(Tipo:) <> null
                $.set_field Alias2:, $.val(Alias2Bis:)
                $.set_field Valor3:, $.val(Valor3Bis:)
                $.set_field Valor2:, $.val(Valor2Bis:)                
            else
                 if $.val(Tipo:) = null
                    if __action__ <> "B"
                        if $.val(EsJerarquia:) <> 'SI'
                            $.Alert('Tipo Obligatorio.')
                            false
                        else
                            true
                        endif
                    else
                        true
                    endif  
                    
                 else
                    
                            true
                endif
            endif
        endif
   end
   
   
   before_save: do
        if __action__ <> "B"
           if $.val(EsJerarquia:) <> 'SI'
            if $.val(Cotiza:) = null
            $.Alert('Cotiza En Obligatorio.')
              false
            else
               true
            endif
           else
              true
           endif
            
       else
           true
       endif  
   end
   
   before_save: do
   if __action__ <> "B"
    If ppl.DesciendeDeEspecie(val (sender.Codigo),'TITULO')
                If $.val(EsJerarquia:) <> 'SI'
                If $.val MonedaEmision: = null
                  $.Alert('Debe completar el campo MonedaEmision antes de guardar ')
                  false
               else 
                    If $.val MonedaEmision: = 'USD'
                        $.set_field Alias6:, $.val(Alias6Bis:)
                    else
                        true
                    endif
               end
              else
                true
              end
    else
           true
       endif
     else
           true
       endif    
   end
    
   
   before_save: do
        if $.val(Tipo:) = 'IND'
            if $.val(TipoIndice:) = ''
                $.Alert('TipoIndice Obligatorio.')
                false
            else
                true
            end
        else
            true
        end
   end
   
  before_save: do
    If __action__ = "A"
        If (($.val(Tipo:) = 'PUB' OR $.val(Tipo:) = 'ONE') AND $.val EsCupon: = 'SI')
            $.Alert('La Especie Cupón se genera automáticamente.')
             false
        else
            true
        end

    else
        true
    end
  end
        when_change: ZeroCoupon: do
      If $.val(ZeroCoupon:) = 'SI' 
             $.set_field Cupon:, 0
            $.Disable(Cupon:)
        else        
            $.set_field Cupon:, null
            $.Enable(Cupon:)

        endif  
      end
 
     
   
   validates_max_length_of:
   Codigo:, 6 ,true;
   Nombre:, 15,true;
   Cupon:, 10,true;
   Extendido: , 100,true;
   ISIN: , 12,true;
   CUSIP: , 9,true;
   Cedel: , 12,true;
   EuroClear: , 12,true;
   CodAlfCajaValores: , 5,true;
   CodNumCajaValores: , 5,true;
   DenominCajaValores: , 25,true;
   ClaseCajaValores: , 10,true;
   CodMAEContado: , 10,true;
   CodMAEPase: , 10,true;
   CodMAEPaseAforado: , 10,true;
   CodMAECaucion: , 10,true;
   PaisOrigen: , 10,true;
   Tranche: , 3,true;
   ISO: , 5,true;
   ExNumber: , 13,true;
   ExNumberS: , 15,true;
   Issue: , 10,true;
   SType: , 10,true;
   Issuer: , 10,true;
   Guarantor:, 10,true;
   CommonCode:, 12,true;
   Indice:, 12,true;
   Alias1: , 20,true; 
   Alias2: , 20,true; 
   Alias3: , 6,true; 
   Alias4: , 20,true; 
   Alias5: , 20,true; 
   Alias6: , 6,true;
   Alias7: , 20,true;
   Alias8: , 20,true;
   Alias9: , 20,true;
   Alias10: , 20,true;     
   LocalRating1: , 4,true;
   LocalRatingSource1: , 15,true;         
   LocalRating2: , 4,true;  
   LocalRatingSource2: , 15,true;        
   SyPRating: , 4,true;
   MoodysRating:, 4,true;
   
   
   
   
 
   # Este callback se ejecuta despues de grabar un registro.
   # (El evento necesita que ya exista la especie en la tabla)
   after_save:  do
      If __action__ = "A"
         If $.val ZeroCoupon: = 'SI'
            #$.Alert('Hay que generar cupon!')
            set especie = $.val(Codigo:);
            $.EjecutarEvento('GENZER', {especie1:especie})
         end
         If $.val(Tipo:) = 'PUB' 
            If $.val(EsCupon:) = 'NO' 
                set especie = $.val(Codigo:);
                set especieC = $.val(Alias3:);
                set monedaCot = $.val(Cotiza:);
                set monedaEmi= $.val(MonedaEmision:);
                $.EjecutarEvento('ALESCU', {especie1:especie,especie2:especieC,contraespecie1:monedaCot,contraespecie2:monedaEmi,String1:ds_TipoEnviar})
            end
         Else
            If $.val(Tipo:) = 'ONE'
                If $.val(EsCupon:) = 'NO' 
                    set especie = $.val(Codigo:);
                    set especieC = $.val(Alias3:);
                    set monedaCot = $.val(Cotiza:);
                    set monedaEmi= $.val(MonedaEmision:);
                    $.EjecutarEvento('ALESCU', {especie1:especie,especie2:especieC,contraespecie1:monedaCot,contraespecie2:monedaEmi,String1:ds_TipoEnviar})
                end
            end     
         end
         
      end
    
    end
   
   #before_save: do
   # set xppl = $.NewExtendedPPL()
   # #set value = $.Val(TipoIndice:)
   # If $.val(Tipo:) = 'IND' AND not xppl.NoVacio(TipoIndice:)
   #     $.Alert("El campo TipoIndice no debe quedar vacío");
   # endif
   #end
   
    #Antes de borrar, hay que ver que no tenga descendientes
    before_delete: do
        if xppl.Eqstr(xppl.Copy($.val(Jerarquia:),4,3),'000')
            set limiteJerarquia = 3
        else
            if xppl.Eqstr(xppl.Copy($.val(Jerarquia:),7,3),'000')
                set limiteJerarquia = 6
            else
                if xppl.Eqstr(xppl.Copy($.val(Jerarquia:),10,3),'000')
                    set limiteJerarquia = 9
                else
                    if xppl.Eqstr(xppl.Copy($.val(Jerarquia:),13,3),'000')
                        set limiteJerarquia = 12
                    else
                        set limiteJerarquia = 15
                    endif
                endif
            endif
        endif
        
        set raizBuscar = xppl.Copy($.val(Jerarquia:),1,limiteJerarquia)
        
        if ppl.NoVacio(ppl.SQL(" SELECT 1 FROM "+dbo+".ESPECIES WHERE Jerarquia like '"+raizBuscar+"%' and Jerarquia <> '"+$.val(Jerarquia:)+"' ")) AND limiteJerarquia <> 15
            $.Alert('La especie no puede eliminarse porque tiene descendientes')
            false
        else
            true
        endif
    end
   
   validates_uniqueness_of: Jerarquia:, Codigo:
   
end