def abm 'Automaticos'       
    def grid
        Usuario:, Orden:, Tipo: , Codigo: , Parametros:
    end
    def key
        Usuario:, Codigo:
    end
    def dialog_size
        550,300
    end
    def dialog
        #**************************************************************************
        tab 'General'     
            column          
                Usuario: ,, small_text
                Orden:   ,, small_text
                Tipo:    ,, small_text
                Codigo:  ,, small_text
                Parametros: ,, extra_large_text                         
    end
    
    upper_case_fields: Usuario:, Codigo:
    
end