   hide:
        Moneda:

   validations:
   FechaEj:, ($.val(CallPut:) <> 'CAL' and $.val(CallPut:) <> 'PUT') or ppl.NoVacio($.val(FechaEj:)),'debe ingresar una fecha';
   PrecioEj:, ($.val(CallPut:) <> 'CAL' and $.val(CallPut:) <> 'PUT') or ppl.NoVacio($.val(PrecioEj:)),'debe ingresar un Precio';    
   FechaEj:, $.val(CallPut:) <> 'FUT' or $.val(FechaEj:) > $.val(Fecha:),'Fecha Ej debe ser mayor a Fecha Cotizacion';
   
   validates_max_length_of:
        Codigo:, 6,true
        
        #validates_uniqueness_of_set: Fecha:, Codigo:, FechaEj:, PrecioEj:, CallPut:, Moneda:
        validates_uniqueness_of_set: Fecha:, Codigo:, FechaEj:, PrecioEj:, CallPut:
end