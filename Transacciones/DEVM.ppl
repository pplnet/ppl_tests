Eqstr(ABM, 'D') Y Eqstr(BuscarCampo('CNFORMASPAGOCOBRO','Tipo','Codigo',CNFORMAPAGO),'CHE');'CHEDEV';NrTrans1=NrTrans;Vehiculo1=Vehiculo1;Radio1 = 3;Chequera1 = Chequera1; Entero1 = Cantidad2


