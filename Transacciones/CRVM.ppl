CAMPOS:1; ;10100
ConceptoPago   : 'Concepto'    ;1;1;;;;NOVACIO(CONCEPTOPAGO) y Eqstr(BuscarCampo('CNCONCEPTOSPAGOCOBRO','TipoConcepto','Codigo',CONCEPTOPAGO),'DEP');'Concepto invalido';NO;'DEPOSI';;;;;;;" TipoConcepto='DEP'  ";
Fecha1         : 'FechaOp'     ;1;2;;VerificaAcceso('OPFVALOR');;FECHA1<=FSYS y EsHabil(FECHA1,'ARG');'Fecha Incorrecta';NO;FSYS;
Fecha2         : 'FechaAcredit';2;2;1;;;;;;FECHA1;FECHA1
Fecha3         : 'FechaAcredit';2;2;;NO;NO;;;;FECHA2;FECHA2
CodigoDatanet1 : 'Cod.Datanet' ;3;2;1;NO;

Vehiculo1      : 'Vehiculo '   ;3;1;;;;NoVacio(VEHICULO1);'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO','Vehiculo','Codigo',USUARIOACTIVO)
Especie        : 'Moneda '     ;4;1;1;;;NoVacio(ESPECIE) y DesciendeDeEspecie(ESPECIE,'MONEDA');'Moneda Invalida';NO;;;;;;;;"Status = 'HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','MONEDA')~"%' ";
Cantidad1      : 'Cantidad'    ;5;1;;;;CANTIDAD1>0;'Cantidad Invalida';NO;
CNFormaPago    : 'Forma Cobro' ;5;2;;;;NOVACIO(CNFORMAPAGO);'Forma de Pago Invalida';NO;
Cantidad3      : 'Ajuste'      ;6;1;1;NO;CANTIDAD3<>0;

Cliente2       : 'Banco'       ;7;1;;;;Eqstr(BuscarCampo('CLIENTES','Sector','Codigo',CLIENTE2),'BAN');'Banco invalido' ;NO;;;;;;;;"Sector='BAN' "
Cuenta2        : 'Cuenta'      ;8;1;;;;NoVacio(CUENTA2) ;'Cuenta Invalida';NO;;Query(" SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente='"~VEHICULO1~"' AND (Especies Like '%"~ESPECIE~"%' OR Especies LIKE '%MONEDA%') and Estado='HAB' AND Comitente='"~CLIENTE2~"'");;;;;;"Cliente = '"~VEHICULO1~"' AND (Especies Like '%"~ESPECIE~"%' OR Especies LIKE '%MONEDA%') and Estado='HAB' AND Comitente = '"~CLIENTE2~"'";
VTXT2          : '#'           ;8;2;;NO;;;;;;BuscarCampo('CUENTAS','Numero','Codigo',CUENTA2);;;;;'XXXXXXXXXXXXXXXXXXXXXX'

Cambio1        : 'Nro.Boleta'   ;9;1;1;;;;;;;;;;;;"###,###,###,###,###"
CB1            : 'Cobranza'     ;9;2;1;;;;;;0
CB3            : 'Conc.Datanet' ;10;1;1;;;;;;0
CB4            : 'Ev.CargaAut.' ;11;1;1;NO;;;;;0

VCAN6: 'Boleta/Cuenta'; ; ;;NO;NO;;;;;IIF(CAMBIO1<>0 THEN Query("SELECT /*+first_rows*/ 1 FROM "~DBO~".TRANSACCIONES2 WHERE TipoTr2 IN ('CRVM') AND Cuenta2 = '"~CUENTA2~"' AND Cambio1 = "~fstr(CAMBIO1,1,0)~" ") ELSE 0 ENDIF)
VCAN8: 'Monto en ARP' ; ; ;1;NO;NO;;;;;IF(Eqstr(ESPECIE,'ARP'),CANTIDAD1,CANTIDAD1*CotizacionC(ESPECIE,,,,FECHA1,1,SI,'ARP'))


CONDICIONES
Incluido(VEHICULO1, UsrVehiculos(USUARIOACTIVO)) o VACIO(UsrVehiculos(USUARIOACTIVO)); 'El usuario activo no esta habilitado para operar con el vehiculo '~VEHICULO1;NO
EspecieCuenta(ESPECIE, CUENTA2) o VACIO(CUENTA2)  ;'La Moneda No Corresponde a Cuenta';NO
ClienteCuenta(VEHICULO1, CUENTA2) o VACIO(CUENTA2);'La Cuenta no corresponde al Vehiculo';NO
VCAN6<>1;'Nro.de Boleta de Deposito o Cuenta Invalidos';NO

MOVIMIENTOS
Fecha2;Vehiculo1;Especie;;;;;Vehiculo1;1; Cantidad1;;'Credito de '~Especie;SI;NO;;;;Cuenta2;;1;

BAJA
Not Eqstr(CNFORMAPAGO,'DATANE');'La Transaccion se genero por una Concilicion con Datanet. Se debe eliminar con el evento de Desconciliacion.';

EDICION
INSTANCIA=11;'La transaccion solo se puede modificar en la instancia de carga.'



