CAMPOS:1;;BuscarCampo('VEHICULOS','Alias3','Codigo',Vehiculo1)
Vehiculo1  : 'Vehiculo '        ;;;;;; NoVacio(VEHICULO1);'Vehiculo invalido';NO;;IF(NoVacio(CUENTA1),BuscarCampo('CUENTAS','Cliente','Codigo',CUENTA1),);;;;;;IF (Vacio(CUENTA1) y Vacio(CLIENTE1),"Codigo IN (Select DISTINCT Cliente From "~DBO~".CUENTAS)","Codigo IN (Select DISTINCT Cliente From "~DBO~".CUENTAS Where Comitente = '"~CLIENTE1~"')")
Cliente1   : 'Entidad'          ;;;;;; NoVacio(CLIENTE1) ;'Entidad invalida' ;NO;;IF (NoVacio(CUENTA1),BuscarCampo('CUENTAS','Comitente','Codigo',CUENTA1),);;;;;;IF(Vacio(VEHICULO1),"dbo.DesciendeDeCliente(Codigo,'BANCOS')=1 and Status = 'HAB' and Codigo IN (Select DISTINCT Comitente From "~DBO~".CUENTAS)","dbo.DesciendeDeCliente(Codigo,'BANCOS')=1 and Status = 'HAB' and Codigo IN (Select DISTINCT Comitente From "~DBO~".CUENTAS Where Cliente = '"~VEHICULO1~"')");;;
Cuenta1    : 'Cuenta'           ;;;;;;                   ;'Error en Cuenta'  ;NO;;;;;;;;IF (NoVacio(CLIENTE1) y NoVacio(Vehiculo1),"Cliente='"~VEHICULO1~"' and Comitente='"~CLIENTE1~"' and Estado = 'HAB'",IF(NoVacio(CLIENTE1),"Comitente='"~CLIENTE1~"' and Estado = 'HAB'",IF(NoVacio(VEHICULO1),"Cliente='"~VEHICULO1~"' and Estado = 'HAB'",)))
Fecha1     : 'FechaSaldo'       ;;;;;;                   ;NO                 ;Habiles(FSYS, -1, 'ARG', SI)                                       ;;;;;;;
Especie    : 'Moneda'           ;;;;NO                   ;                   ;DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE,ESPECIES);;;;Copy(BuscarCampo('CUENTAS','Especies','Codigo',CUENTA1),1,Longitud(BuscarCampo('CUENTAS','Especies','Codigo',CUENTA1))-1);;;;;;"Status = 'HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','MONEDA')~"%'"
Cantidad1  : 'Saldo'            ;;;;NO                   ;                   ;;;;;SQLSET("Select SaldoContable FROM SALDOSBANCARIOS Where FechaSaldo = '"~IdxDate(FECHA1)~"' and Banco = '"~BuscarCampo('CLIENTES','Alias3','Codigo',CLIENTE1)~"' and NrCuenta = '"~BuscarCampo('CUENTAS','Numero','Codigo',CUENTA1)~"'");;;;;;

*1.  [identificador de campo] 2.  [Nombre del campo en pantalla] 3.  [Fila ocupada en pantalla] 4.  [Columna ocupada en pantalla]
*5.  [Número de pantalla] 6.  [Campo editable] 7.  [Campo displayable] 8.  [Condición de validez] 9.  [Mensaje de error] 10. [Posibilidad de saltear validación]  11. [Fórmula default] 12. [Fórmula de cálculo] 13. [Momento de Recálculo] 14.  [Lista de Opciones] 15. [Permitir el F2]  16. [Prioridades de Recalculo] 17. [Máscara de Edición numérica]  18. [Condición para el doble click) 19. [Recalcula Campo Modificado] 

***-------------------VALIDACION
*Debemos validar que no haya otra INSABA para misma Fecha, vehiculo, cuenta, moneda y banco
*Tampoco deben haber SALDOSBANCARIOS EN caso de ocurrir, no se permite el ingreso de la transaccion
CONDICIONES
Incluido(VEHICULO1, UsrVehiculos(USUARIOACTIVO)) o VACIO(UsrVehiculos(USUARIOACTIVO)); 'El usuario activo no esta habilitado para operar con el vehiculo '~VEHICULO1;NO;
DesciendeDeCliente(CLIENTE1,'BANCOS');'El Cliente debe ser una Entidad Bancaria';NO;
Query("SELECT 1 FROM "~dbo~".SALDOSBANCARIOS WHERE FechaSaldo = '"~IdxDate(FECHA1)~"' AND NrCuenta = "~BuscarCampo('CUENTAS','Numero','Codigo', CUENTA1)~" AND Banco = '"~BuscarCampo('CLIENTES','Alias3','Codigo', CLIENTE1)~"' ") <> 1;'Ya Existe Saldo para la Cuenta '~CUENTA1~', Fecha '~FECHA1~' y Cantidad '~CANTIDAD1;NO;
Query("SELECT 1 FROM "~dbo~".TRANSACCIONES2 WHERE Fecha1 = '"~IdxDate(FECHA1)~"' AND Cuenta1 = '"~BuscarCampo('CUENTAS','Numero','Codigo', CUENTA1)~"' AND Vehiculo1 = '"~VEHICULO1~"' ") <> 1;'Ya Existe Una Transaccion para la Cuenta '~CUENTA1~', Fecha '~FECHA1~' y Cantidad '~CANTIDAD1;NO;

*Considerar usar la función BuscarCampo() 
*EJ: BuscarCampo('CUENTAS','NrCuenta','Codigo',Dialogo.Cuenta1)
*Los parametros serían TABLA,CampoATraer,CampoABuscar,ValorCampoABuscar
*seria como que de la tabla CUENTAS te trae el NRCUENTA del registro cuyo CODIGO sea DIALOGO.CUENTA1

*POSTEDICION
*SI;'INSABA'; Vehiculo1=Vehiculo1; Cliente1=Cliente1; Cuenta1=Cuenta1; Fecha1=Fecha1; Especie=Especie; Cantidad1=Cantidad1; Operador=UsuarioActivo  
*Vehiculo1 Cliente1 Cuenta1 Fecha1 Especie Cantidad1 Operador 