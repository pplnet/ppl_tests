FechaVto ;Cliente1;Especie       ;;;;;Vehiculo1;1;      -Cantidad;;'Imp.Rec.Spot '~TIPOOP~' '~ESPECIE~'/'~CONTRAESPECIE;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2') );;RB6=0 y Not EqStr(Especie,ContraEspecie);;Cuenta1;;1;
