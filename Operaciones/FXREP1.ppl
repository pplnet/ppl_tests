CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp           : 'Fecha Conc.'            ;1;1; ;NOT EV y VERIFICAACCESO('OPFVALOR');  ;EsHabil(FECHAOP,'ARG') Y ESHABIL(FECHAOP,TABLAFERIADOS1);'Fecha incorrecta';NO;FSYS;
@VEHITO
CB6               : 'Cot.Directa?'           ; ; ; ;  ;  ;;;;;IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE~"' "),'INV'),0,1)
Cliente1          : 'Entidad '               ;3;1; ;NOT EV;  ;NOVACIO(CLIENTE1);'El Cliente no es valido';NO;;;;
RB10              : 'Precancelable|Si|No'    ;2;1; ;  ;NO ;RB10>=0;'Precancelable Si/No';NO;1;
ValorRB1          : 'Valor|Hoy|Normal|Otro'  ;3;2; ;  ;  ;VALORRB1>=0;'Indique el Tipo de Valor';NO;-1;IF(PLAZO2=0 Y PLAZO<=1,0,IF(PLAZO2=1 Y PLAZO<=2,1,2))
Puesto            : 'Puesto'                 ;4;2; ;  ;  ;PUESTO>=0;'Indique Puesto o No Puesto';NO;1;IF(PLAZO2=PLAZO,1,0)
Especie           : 'Especie'                ;5;1; ;NOT EV;  ;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'Debe INGRESAR una ESPECIE de COMPRA SPOT y VENTA A TERMINO';NO;;;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";;
ContraEspecie     : 'ContraEspecie'          ;5;2; ;NOT EV;  ;NOVACIO(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE,ESPECIE);'Debe ingresar una ContraEspecie';NO;;COTIZAEN(ESPECIE);;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";;;;;
Plazo             : 'Pzo_Es_SP'              ;6;1; ;  ;  ;PLAZO>=0 Y PLAZO<=3;'El Plazo DEBE SER >=0 Y <=3';NO;IF(VALORRB1<0,0,IF(VALORRB1=0 Y PUESTO=1,0,IF(VALORRB1=1 Y [PUESTO=0],2,IF(VALORRB1=2,3,1))));IF(VALORRB1<0,0,IF(VALORRB1=0 Y PUESTO=1,0,IF(VALORRB1=1 Y [PUESTO=0],2,IF(VALORRB1=2,PLAZO,1))))
Plazo2            : 'Pzo_CEs_SP'             ;6;2; ;  ;  ;PLAZO2>=0 Y PLAZO2<=3;'El Plazo DEBE SER >=0 Y <=3';NO;IF(VALORRB1<0,0,IF(VALORRB1=0,0,IF(VALORRB1=2,3,1)));IF(VALORRB1<0,0,IF(VALORRB1=0,0,IF(VALORRB1=2,PLAZO,1)))
FechaVto          : 'Vto_Es_SP'              ;7;1; ;NO;  ;EsHabil(FECHAVTO,TABLAFERIADOS1);'No es un Dia Habil';NO;0;HABILES(FECHAOP,PLAZO,TABLAFERIADOS1)
Plazo3            : 'Pzo_Es_FU'              ; ; ; ;  ;  ;PLAZO3>3;'El Plazo Futuro de Titulos debe ser Superior a 3 Dias';NO;0;FECHAVTO2-FECHAOP
FechaVto2         : 'Vto_Es_FU'              ; ; ; ;  ;  ;ESHABIL(FECHAVTO2,TABLAFERIADOS1);'El Vto. Futuro de la Especie debe ser DIA HABIL';NO;FECHAOP+PLAZO3;FECHAOP+PLAZO3
FechaPago         : 'Vto_CEs_SP'             ;7;2; ;NO;  ;EsHabil(FECHAPAGO,TABLAFERIADOS1);'No es un Dia Habil';NO;0;HABILES(FECHAOP,PLAZO2,TABLAFERIADOS2)
Plazo4            : 'Pzo_CEs_FU'             ; ; ; ;  ;  ;PLAZO4>3;'El Plazo Futuro de Moneda debe ser Superior a 72Hs.';NO;0;FECHAOP2-FECHAOP
FechaOp2          : 'Vto_CEs_FU'             ; ; ; ;  ;  ;ESHABIL(FECHAOP2,TABLAFERIADOS2);'El Vto. Futuro de la ContraEspecie debe ser DIA HABIL';NO;FECHAOP+PLAZO4;FECHAOP+PLAZO4
RB6               : 'Partida_Operada|VN_Rec|VN_Entr';10;1; ;NOT EV;  ;;;;1;
Cantidad          : 'Imp.Rec.Spot'           ;11;1; ;RB6=0;  ;CANTIDAD>0;'El Importe debe ser Positivo';NO;IF(EQSTR(RB6,'1'),(TOTALBRUTOCLI1*IF(CB6=0,1/PRECIO1,PRECIO1)),CANTIDAD);IF(EQSTR(RB6,'1'),(TOTALBRUTOCLI1*IF(CB6=0,1/PRECIO1,PRECIO1)),CANTIDAD)
Precio1           : 'Precio Spot'            ; ; ; ;  ;  ;PRECIO1>0 ;'El Tipo de Cambio debe ser Positivo';NO;0;;;;;;'###.########';

TotalBrutoCli1    : 'Imp.Ent.Spot'           ; ; ; ;RB6=1;  ;;;;;IF(RB6=0,IF(CB6=1,PRECIO1*CANTIDAD,CANTIDAD/PRECIO1),TOTALBRUTOCLI1)
TotalNetoCli1     : 'Imp_Neto_SP'            ;15; ; ;NO;  ;;;;;IF(RB6=0, IF(EQSTR(ESPECIE,CONTRAESPECIE2),CANTIDAD-IF(RB7=0,IMPCOMCOREQ1,0), IF(EQSTR(CONTRAESPECIE,CONTRAESPECIE2),TOTALBRUTOCLI1+IF(RB7=0,IMPCOMCOREQ1,0),TOTALBRUTOCLI1)), IF(EQSTR(ESPECIE,CONTRAESPECIE2),TOTALBRUTOCLI1+IF(RB7=0,IMPCOMCOREQ1,0), IF(EQSTR(CONTRAESPECIE,CONTRAESPECIE2),CANTIDAD-IF(RB7=0,IMPCOMCOREQ1,0),CANTIDAD)))
Precio3           : 'Tasa (%)'               ; ; ; ;  ;  ;PRECIO3>=0;'La tasa es negativa';SI;;((PRECIO2-PRECIO1)*IF(RB8=0,36000,36500))/(PRECIO1*PLAZO4)
TotalBrutoCli2    : 'Imp.Rec.Fut.'           ;11;2; ;NO;  ;TOTALBRUTOCLI2>0;;NO;IF(RB6=1,TOTALBRUTOCLI1,IF(CB6=1,PRECIO2*CANTIDAD,CANTIDAD/PRECIO2));IF(RB6=1,TOTALBRUTOCLI1,IF(CB6=1,PRECIO2*CANTIDAD,CANTIDAD/PRECIO2))
Precio2           : 'Precio Futuro'          ;12;2; ;  ;  ;PRECIO2>=0;'El Precio Futuro es menor que el Precio Spot';SI; ;PRECIO1+((PRECIO1*PRECIO3*PLAZO4)/IF(RB8=0,36000,36500));;;;;'###.########';
TotalBrutoCli3    : 'Imp.Ent.Fut.'           ;13;2; ;NO;  ;;;;IF(RB6=0, CANTIDAD,IF(CB6=1,PRECIO2*TOTALBRUTOCLI2,TOTALBRUTOCLI2/PRECIO2));IF(RB6=0, CANTIDAD,IF(CB6=1,PRECIO2*TOTALBRUTOCLI2,TOTALBRUTOCLI2/PRECIO2))
RB8               : 'U.Tiempo|360|365'       ;15;2; ;  ;  ;RB8>=0;'Unidad de Tiempo Tasa Interes INVALIDA';NO;;
TablaFeriados1    : 'Feriados Esp.'          ;17;1; ;  ;  ;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE)) 
TablaFeriados2    : 'Feriados Con.'          ; ; ; ;  ;  ;NOVACIO(TABLAFERIADOS2);'Se debe indicar feriados a utilizar';NO;;BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',CONTRAESPECIE)) 
Operador          :                          ;17;2; ;  ;  ;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
Observac2         : 'Op.Contraparte'         ; ; ; ;  ;  ;NOVACIO(OBSERVAC2);'El Operador Contraparte no es valido';SI;;;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
Precio4           : 'Cotizacion'             ;10;3; ;NO;NO;;;;;IF(CB6=1,COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VTXT40)/COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,VTXT40),COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,VTXT40)/COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VTXT40))
Corredor          : 'Corredor'               ;1;1;2;;;
ContraEspecie2    : 'Moneda Comision'        ;2;1;2;;  ;VACIO(CORREDOR) O [NOVACIO(CONTRAESPECIE2) y DESCIENDEDEESPECIE(CONTRAESPECIE2,'MONEDA') y ESTERMINAL(CONTRAESPECIE2,ESPECIE)];'Especie de Pago Comision Corredor INVALIDA';NO;;IF(MODI,CONTRAESPECIE2,CONTRAESPECIE);;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~")and Status = 'HAB' ";;;;
PorComCor1        : 'Comision'               ;3;1;2;;  ;;;;;IF(MODI,PORCOMCOR1,BuscarCampo('CORREDORES','ComisionDefault1','Codigo',CORREDOR));
TCComCor1         : 'T.Cambio'               ;4;1;2;;  ;VACIO(CORREDOR) O TCCOMCOR1>=0;'Tipo de Cambio del Corredor INVALIDO';NO;;
ImpComCor1        : 'Imp.Comision'           ;5;1;2;NO;  ;;;;;IF(RB6=0,TOTALBRUTOCLI1,CANTIDAD)*(PORCOMCOR1/100)
ImpComCorEq1      : 'Importe Eq.'            ;6;1;2;NO;  ;;;;;IMPCOMCOR1*IF(CB7=1,TCCOMCOR1,IF(TCCOMCOR1<>0,1/TCCOMCOR1,0))
RB7               : 'Deducible|Si|No'        ;7;1;2;;  ;VACIO(CORREDOR) O RB7>=0;'Indique Deducible / No Deducible';NO;;
Cotizacion1       : 'TC_Concert.'            ; ; ;2;  ;Not [Eqstr(ESPECIE,VAR('MONEEXTR')) o Eqstr(CONTRAESPECIE,VAR('MONEEXTR'))];[Eqstr(ESPECIE,VAR('MONEEXTR')) o Eqstr(CONTRAESPECIE,VAR('MONEEXTR'))] O [COTIZACION1<=VPRE1*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE1*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE1*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE1*(1+VAR('RPRECIO2')/100),1,7);NO;;IF([Eqstr(ESPECIE,VAR('MONEEXTR')) o Eqstr(CONTRAESPECIE,VAR('MONEEXTR'))],1)
Cotizacion2       : 'TC_Vencim.'             ; ;2;2;COTIZACION2<>0;COTIZACION2<>0;;;;
TipoCambio2       : 'Cot.Contr/ComCor'       ; ; ;2;NO;NO;;;;;IF(CB7=1,COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,VTXT40)/COTIZACIONC(CONTRAESPECIE2,,,,FECHAOP,1,SI,VTXT40),COTIZACIONC(CONTRAESPECIE2,,,,FECHAOP,1,SI,VTXT40)/COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,VTXT40))
CB7               : 'Cot.Contr/ComCorDirecta'; ; ;2;NO;NO;;;;;IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~CONTRAESPECIE~"' and Especie2='"~CONTRAESPECIE2~"' "),'INV'),0,1)
RB1               : 'Genera Arbitraje'       ; ;3;2;NO;NO;;;;;
RB3               : 'MOF'                    ;10;2; ;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa           : 'Modificado'             ;10;2; ;NO;NO;;;;0
VPRE1             : 'Cot.TC/USD'             ;10;2; ;NO;NO;;;;;IF(RB6=0,COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(CONTRAESPECIE,VAR('MONEEXTR')),'DIR'),1,-1),COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(ESPECIE,VAR('MONEEXTR')),'DIR'),1,-1))

VCAN2             : 'LimCon Especie'        ;10;1; ;NO;NO;;;;;LIMCONSUMIDO(CLIENTE1,'SETTLEMENT',ESPECIE,FECHAVTO,,,,NROPERACION)
VCAN3             : 'LimCon C-Esp'          ;11;1; ;NO;NO;;;;;LIMCONSUMIDO(CLIENTE1,'SETTLEMENT',CONTRAESPECIE,FECHAPAGO,,,,NROPERACION)
VCAN4             : 'Especie'               ;12;1; ;NO;NO;;;;;IF(VCAN2+VCAN8>0,IF(VCAN2<0,VCAN2+VCAN8,VCAN8),0)
VCAN5             : 'ContraEspecie'         ;13;1; ;NO;NO;;;;;IF(VCAN3>0,IF(VCAN3-VCAN8>0,-VCAN8,-VCAN3),0)
VCAN1             : 'Total Settlement'      ;14;1; ;NO;NO;;;;;LIMSUMADO(CLIENTE1,'SETTLEMENT',FECHAVTO,,,,NROPERACION)+VCAN4+VCAN5
VCAN6             : 'Total SetCre'          ;15;1;2;NO;NO;;;;;LIMCONSUMIDO(CLIENTE1,'SETCRE','USD',0,,,,NROPERACION,FECHAPAGO)+VCAN8
VCAN7             : 'Total Sett.c/SetCre'   ;16;1;2;NO;NO;;;;;LIMCONSUMIDO(CLIENTE1,'SETCRE','USD',0,,,,NROPERACION,FECHAPAGO)+VCAN1
VCAN8             : 'Equivalente USD'       ;17;1;2;NO;NO;;;;;if(EqStr(ESPECIE,'USD'),CANTIDAD,TOTALBRUTOCLI1*if(EqStr(Modo(CONTRAESPECIE,'USD'),'DIR'),COTIZACION1,1/IF(COTIZACION1<=0,1,COTIZACION1)))
VCAN9             : 'Total Contract'        ;18;1;2;NO;NO;;;;;LIMCONSUMIDO(CLIENTE1,'CONTRACT','USD',0,,,,NROPERACION,FECHAPAGO)+VCAN8

VPRE2             : 'LimCon Especie'        ;10;2; ;NO;NO;;;;;LIMCONSUMIDO(CLIENTE1,'SETTLEMENT',ESPECIE,FECHAVTO2,,,,NROPERACION)
VPRE3             : 'LimCon C-Esp'          ;11;2; ;NO;NO;;;;;LIMCONSUMIDO(CLIENTE1,'SETTLEMENT',CONTRAESPECIE,FECHAOP2,,,,NROPERACION)
VPRE4             : 'Especie'               ;12;2; ;NO;NO;;;;;IF(VPRE2>0,IF(VPRE2-VPRE8>0,-VPRE8,-VPRE2),0)
VPRE5             : 'ContraEspecie'         ;13;2; ;NO;NO;;;;;IF(VPRE3+VPRE8>0,IF(VPRE3<0,VPRE3+VPRE8,VPRE8),0)
VPRE10            : 'Total Settlement'      ;14;2; ;NO;NO;;;;;LIMSUMADO(CLIENTE1,'SETTLEMENT',FECHAVTO2,,,,NROPERACION)+VPRE4+VPRE5
VPRE6             : 'Total SetCre'          ;15;2;2;NO;NO;;;;;LIMCONSUMIDO(CLIENTE1,'SETCRE','USD',0,,,,NROPERACION,FECHAVTO2)+VPRE8
VPRE7             : 'Total Sett.c/SetCre'   ;16;2;2;NO;NO;;;;;LIMCONSUMIDO(CLIENTE1,'SETCRE','USD',0,,,,NROPERACION,FECHAVTO2)+VPRE10
VPRE8             : 'Equivalente USD'       ;17;2;2;NO;NO;;;;;if(EqStr(ESPECIE,'USD'),TOTALBRUTOCLI3,TOTALBRUTOCLI2*if(EqStr(Modo(CONTRAESPECIE,'USD'),'DIR'),COTIZACION1,1/IF(COTIZACION1<=0,1,COTIZACION1)))
OperacionRef      : 'OperacionRef'          ;1;1;2;NO;NO;

@FXCTACONT
@CUENTAS

CONDICIONES
Not Incluido(ESPECIE,VAR('BONOCANJ'));'La Moneda no debe estar Incluida en la Lista '~VAR('BONOCANJ');NO
DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') O DESCIENDEDECLIENTE(CLIENTE1,'EMPRESAS');'El Cliente debe ser una Entidad Bancaria o una Empresa';NO
EsHabil(FECHAVTO,'ARG');'La Fecha de Vencimiento NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'VTOINH'
EsHabil(FECHAVTO2,'ARG');'La Fecha de Vencimiento Futuro NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'VTOFUTINH'
EsHabil(FECHAPAGO,'ARG');'La Fecha de Vencimiento ContraEspecie SPOT NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'VTOCESINH'
EsHabil(FECHAOP2,'ARG');'La Fecha de Vencimiento ContraEspecie FUTURO NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'VTOCEFINH'
Vacio(Cliente1) o EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB');'El Cliente No esta Habilitado';NO
EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La Especie No esta Habilitada';NO
EqStr(BuscarCampo('Especies','Status','Codigo',ContraEspecie),'HAB');'La ContraEspecie No esta Habilitada';NO

PRECIO1<=PRECIO4*(1+VAR('RPRECIO') /100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO') /100);'Tipo de Cambio FUERA DE RANGO: '~FSTR(PRECIO4*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO')/100),1,7)  ;SI;SI;FSYS;'RANGOPRECIO'
PRECIO1<=PRECIO4*(1+VAR('RPRECIO2')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO2')/100);'Tipo de Cambio Fuera de Rango: '~FSTR(PRECIO4*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO2')/100),1,7);SI;SI;FSYS;'RANGOPRECIO2'

PRECIO2<=PRECIO4*(1+VAR('RPRECIO') /100) Y PRECIO2>=PRECIO4*(1-VAR('RPRECIO') /100);'Tipo de Cambio FUERA DE RANGO: '~FSTR(PRECIO4*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO')/100),1,7)  ;SI;SI;FSYS;'RANGOPRECIO'
PRECIO2<=PRECIO4*(1+VAR('RPRECIO2')/100) Y PRECIO2>=PRECIO4*(1-VAR('RPRECIO2')/100);'Tipo de Cambio Fuera de Rango: '~FSTR(PRECIO4*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO2')/100),1,7);SI;SI;FSYS;'RANGOPRECIO2'

Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'El Cliente esta Observado';SI;SI;FSYS;'CLIOBS'
SI O [VACIO(Corredor) o [PORCOMCOR1>=VAR('RCOMCOR1') y PORCOMCOR1<=VAR('RCOMCOR2')]];'El % Comision Corredor EXCEDE Los Limites: Min.'~VAR('RCOMCOR1')~' Max.'~VAR('RCOMCOR2');NO
VACIO(CORREDOR) O [TCCOMCOR1<=TIPOCAMBIO2*(1+VAR('RPRECIO2')/100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-VAR('RPRECIO2')/100)];'Cambio COMISION CORREDOR Fuera de Rango: '~FSTR(TIPOCAMBIO2*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+VAR('RPRECIO2')/100),1,7);SI;SI;FSYS;'RANGOPRECIO2'
VACIO(CORREDOR) O [TCCOMCOR1<=TIPOCAMBIO2*(1+VAR('RPRECIO') /100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-VAR('RPRECIO') /100)];'Cambio  COMISION CORREDOR  FUERA DE RANGO: '~FSTR(TIPOCAMBIO2*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOPRECIO'
NOT EQSTR (VEHICULO1,CLIENTE1);'El Cliente y el Vehiculo deben ser distintos';NO
ESTERMINAL(VEHICULO1,VEHICULO);'El Vehiculo debe ser Terminal';NO
ESTERMINAL(CLIENTE1,CLIENTE);'El Cliente debe ser Terminal';NO
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
VACIO(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR)) O  VERIFICAPERFIL(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR),'TO'~TIPOOP);'Operador no habilitado para ingresar Operaciones del Tipo '~TIPOOP;NO

[NOT NOVACIO(CLIENTE1)] o [FechaPago>FechaVto y FechaVto2>FechaOp2] o ExisteLimite('SETTLEMENT',Cliente1,'USD')                                                        ; 'Settlement no asignado'                                                                  ;SI;SI;FSYS;'SETTLENOAS'
[NOT NOVACIO(CLIENTE1)] o [FechaPago>FechaVto y FechaVto2>FechaOp2] o Not ExisteLimite('SETTLEMENT',Cliente1,'USD') o VtoLimite('SETTLEMENT',Cliente1,'USD') >= FechaOp; 'Settlement vencido el '~FECHA(VtoLimite('SETTLEMENT',Cliente1,'USD'))                    ;SI;SI;FSYS;'SETTLEVENC'
[NOT NOVACIO(CLIENTE1)] o [FechaPago>FechaVto y FechaVto2>FechaOp2] o Not LimCancelado('SETTLEMENT',Cliente1,'USD')                                                    ; 'Settlement cancelado'                                                                    ;SI;SI;FSYS;'SETTLECANC'
[NOT NOVACIO(CLIENTE1)] o [FechaPago>FechaVto] o LimAsignado(Cliente1,'SETTLEMENT','USD') >= VCAN6                                                                     ; 'Settlement excedido en U$D '~PYC(VCAN6-LimAsignado(Cliente1,'SETTLEMENT','USD'),1,0)~'.-';SI;SI;FSYS;'SETTLEEXCE'
[NOT NOVACIO(CLIENTE1)] o [FechaVto2>FechaOp2] o LimAsignado(Cliente1,'SETTLEMENT','USD') >= VPRE6                                                                     ; 'Settlement excedido en U$D '~PYC(VPRE6-LimAsignado(Cliente1,'SETTLEMENT','USD'),1,0)~'.-';SI;SI;FSYS;'SETTLEEXCE'

si o [[NOT NOVACIO(CLIENTE1)] o ExisteLimite('CONTRACT',Cliente1,'USD')                                                      ]; 'Contract no asignado'                                                                   ;SI;SI;FSYS;'CONTNOAS'
si o [[NOT NOVACIO(CLIENTE1)] o Not ExisteLimite('CONTRACT',Cliente1,'USD') o VtoLimite('CONTRACT',Cliente1,'USD') >= FechaOp]; 'Contract vencido el '~FECHA(VtoLimite('CONTRACT',Cliente1,'USD'))                       ;SI;SI;FSYS;'CONTVENC'
si o [[NOT NOVACIO(CLIENTE1)] o Not LimCancelado('CONTRACT',Cliente1,'USD')                                                  ]; 'Contract cancelado'                                                                     ;SI;SI;FSYS;'CONTCANC'
si o [[NOT NOVACIO(CLIENTE1)] o LimAsignado(Cliente1,'CONTRACT','USD') >= VCAN9                                              ]; 'Contract excedido en U$D '~PYC(-(LimAsignado(Cliente1,'CONTRACT','USD')-VCAN9),1,0)~'.-';SI;SI;FSYS;'CONTEXCE'



EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

SQL
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('COTORNOAS','COTORVENC','COTOREXCE','SETTLENOAS','SETTLEVENC','SETTLECANC') ";EqStr(ABM,'E')
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('SETTLEEXCE','CONTNOAS','CONTVENC','CONTCANC','CONTEXCE')";EqStr(ABM,'E')

