OperacionRef   : 'Id_Partida'             ;3;2;;NOT EV;;VACIO(OPERACIONREF) O [EqStr(BuscarCampo('Operaciones','TipoOp','NrOperacion',OPERACIONREF),'MMP')];'El Codigo de Id. Partida es Incorrecto';NO;;;;
Cuotas2        : 'Cuota FMat'             ;;;;OPREF.RB6=1;OPREF.RB6=1;OPREF.RB6<>1 o [CUOTAS2<=OPREF.CUOTAS1 y CUOTAS2>=1];'Debe INGRESAR la Cantidad DE PERIODOS Menor o Igual a los Periodos de la Partida '~Fstr(OPREF.CUOTAS1,0,0)~' ...';NO;1;;
Cuotas1        : 'Nr_Periodos'            ;;;;VACIO(OPERACIONREF) O OPREF.RB6<0;;CUOTAS1>=1;'Debe INGRESAR la Cantidad DE PERIODOS';NO;;OPREF.CUOTAS1-IF(CUOTAS2>0,CUOTAS2-1,0);
RB6            : 'Fondeo|BLocFex|BcoExt'  ;;;;NOT EV y VACIO(OPERACIONREF);;RB6>=0;'Indique Tipo de Caso';NO;1;IF(VACIO(OPERACIONREF),RB6,OPREF.MB5-2)
VCAN2          : 'VN_Disponible'          ;;;;NO;NOVACIO(OPERACIONREF);VACIO(OPERACIONREF) O VCAN2+VCAN1>0;'La Partida '~OPERACIONREF~' Fue Completamente Asignada';NO;;(OPREF.PRECIOEJ-OPREF.TOTALAUX3);;;;;'###,###,###,###,###.##'
Cliente1       : 'Ent_Contratante'        ;7;1;;NOT EV y VACIO(OPERACIONREF);;NOVACIO(CLIENTE1); 'La Entidad Contratante es Invalida';NO;;IF(VACIO(OPERACIONREF),CLIENTE1,OPREF.CLIENTE1);;;;;;"Status = 'HAB'";;;;
Especie        : 'Moneda'                 ;;;;NOT EV y VACIO(OPERACIONREF);;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'Debe Ingresar una Moneda';NO;;IF(VACIO(OPERACIONREF),Var('MONEEXTR'),OPREF.ESPECIE);;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";;
Cliente2       : 'Ent_Negociadora'        ;7;2;;NOT EV y VACIO(OPERACIONREF) Y RB6=0;RB6=0;RB6<>0 O NOVACIO(CLIENTE2);'Entidad Negociadora Invalida';NO;;IF(VACIO(OPERACIONREF),IF(RB6=0,CLIENTE2,""),OPREF.CLIENTE2);;;;;;"Status = 'HAB'";;;;
Cantidad       : 'Capital'                ;9;1;;NOT EV;;CANTIDAD>0 Y [VACIO(OPERACIONREF) O [[EQSTR(ABM,'A') Y CANTIDAD<=VCAN2] O [NOT EQSTR(ABM,'A') Y CANTIDAD<=(VCAN2+VCAN1)]]];'El Capital Es Incorrecto';NO;;;;;;;'###,###,###,###,###.##'
Plazo          : 'Plazo'                  ;;;;OPREF.RB6<>1;;PLAZO>0;'Debe INGRESAR el PLAZO';NO;0;IF(NoVacio(OPERACIONREF),IF(OPREF.RB6=0,OPREF.CUOTAS1*OPREF.PLAZO2,FECHAVTO-FECHAOP),FECHAVTO-FECHAOP)
FechaVto       : 'Vto_Monto'              ;;;;OPREF.RB6<>1;;;;;FECHAOP+PLAZO;IF(OPREF.RB6=1,OPREF.FECHAVTO2,IF(INCLUIDO(CAMPOMODIFICADO,'PLAZO|FECHAOP'),FECHAOP+PLAZO,FECHAVTO))
TipoTasa       : 'Tipo_Tasa'              ;12;1;;VACIO(OPERACIONREF);;NOVACIO(TIPOTASA);'El Tipo de Tasa ES INVALIDO';NO;'FIJA';IF(VACIO(OPERACIONREF),TIPOTASA,OPREF.TIPOTASA)
Spread         :                          ;12;2; ;VACIO(OPERACIONREF) Y NOT EQSTR(TIPOTASA,'FIJA');NOT EQSTR(TIPOTASA,'FIJA');SPREAD>=0;'El SPREAD Debe SER POSITIVO';NO;0;IF(VACIO(OPERACIONREF),IF(EQSTR(TIPOTASA,'FIJA'),0,SPREAD),OPREF.SPREAD)

Precio1        : 'Tasa'                   ;13;1; ;EQSTR(TIPOTASA,'FIJA');EQSTR(TIPOTASA,'FIJA');PRECIO1>=0;'La Tasa debe SER POSITIVA';NO;0;IF(NOT EQSTR(TIPOTASA,'FIJA'),0,PRECIO1);;;;;;'###,###.######'
Plazo4         : 'Dias Seteo Tasa'        ;13;1;;;NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA);[PLAZO4>=0] O [EQSTR(TIPOTASA,'FIJA')];'Indique la Cantidad de Dias Previos al Inicio para Setear la Tasa';NO;;
RB16           : 'Setea|InicioPer|FinPer' ;14;1;;;NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA) ;RB16=0 O RB16=1 O [EQSTR(TIPOTASA,'FIJA') o VACIO(TIPOTASA)];'Indique Inicio o Fin de Periodo';NO;
RB8            : 'Day Count|ActAct|Act365F|Act360|360360|30E360'   ;15;1;;VACIO(OPERACIONREF);;RB8>=0;'Unidad de Tiempo Tasa Interes INVALIDA';NO;2;IF(VACIO(OPERACIONREF),IF(MODI,RB8,IF(RB6=0,1,0)),OPREF.RB8)
