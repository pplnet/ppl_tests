Precio1         : 'Tasa'                       ;12;1;;EQSTR(TIPOTASA,'FIJA');EQSTR(TIPOTASA,'FIJA');PRECIO1>=0;'La Tasa debe SER POSITIVA';NO;0;;;;;;;'###,###.######'
