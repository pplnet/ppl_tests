VCAN4           : 'Sum Iva'                    ;;;2;NO;NO;;;;;Query("Select SUM(C.Precio1) from "~DBO~".CUOTAS C,"~DBO~".OPERACIONES O where O.NrOperacion=C.NrOperacion and O.OperacionRef='"~NrOperacion~"' ");;;;;'###,###,###,###,###.##'
