
CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp2        : 'Fecha Conc.'                     ; 1;1; ;VERIFICAACCESO('OPFVALOR');;FECHAOP2<=FECHAOP;'Fecha incorrecta';NO;FSYS;
FechaOp         : 'Fecha_Origen'                    ; 2;1; ;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1);'La Fecha de Origen no es Habil en la Tabla de Feriados Seleccionada';RB11 = 0;FSYS;
@VEHITO
RB6             : 'Caso|Local|ClTe|CeTl|ExtIJ|ExtDJ'; 3;1; ;NOT EV y VACIO(OPERACIONREF);SI;RB6>=0;'Indique Tipo de Caso';;0;IF(VACIO(OPERACIONREF),RB6,OPREF.MB5);
Vehiculo2       : 'Veh Cprte'                       ; 4;1; ;NOT EV y VACIO(OPERACIONREF) Y EQSTR(ABM, 'A');;NOVACIO(Vehiculo2);'Debe ingresar un Vehiculo Contraparte';NO;;IF(VACIO(OPERACIONREF),VEHICULO2,OPREF.VEHICULO2);;
Book2           : 'Book Cprte'                      ; 5;1; ;  ;  ;[SI O BookValido(BOOK2, TIPOOP, ESPECIE, VEHICULO2, OPERADOR, '' )] Y NoVacio(BOOK2);'Book del Vehiculo Contraparte inválido';NO;;Var('BOOKDEF');;;;;;;
Cliente1        : 'Veh.Cprte'                       ; 5;1; ;NO;NO;;;;;VEHICULO2;;;;;;"Status = 'HAB'";;;;
Especie         : 'Moneda'                          ; 6;1; ;NOT EV y VACIO(OPERACIONREF);;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'Debe Ingresar una Moneda';NO;;IF(VACIO(OPERACIONREF),ESPECIE,OPREF.ESPECIE);;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";;

OperacionRef    : 'Id_Partida'                      ; 4;2; ;NOT EV;  ;VACIO(OPERACIONREF) O [EqStr(BuscarCampo('Operaciones','TipoOp','NrOperacion',OPERACIONREF),'MMPV')];'El Codigo de Id. Partida es Incorrecto';NO;;;;
VCAN2           : 'VN_Disponible'                   ; 5;2; ;NO;NOVACIO(OPERACIONREF);VACIO(OPERACIONREF) O VCAN2+VCAN1>0;'La Partida '~OPERACIONREF~' Fue Completamente Asignada';NO;;(OPREF.CANTIDAD-OPREF.TOTALAUX3);;;;;'###,###,###,###,###.##'
MB3             : 'Tipo|Tomador|Colocador'          ; 6;2; ;;  ;;;;1;
RB10            : 'Precancelable|Si|No'             ; 7;2; ;  ;NO;RB10>=0;'Precancelable Si/No';NO;1; 
RB12            : 'Prec.Capital|PEPS|UEPS|Prorrat.' ; 8;2; ;RB10=0;RB10=0;RB12>=0 o RB10<>0;'Modo Precancelacion Capital Incorecto';NO;0;
RB13            : 'Ord.Prec.|Int+Gtos|Gtos+Int'     ; 9;2; ;RB10=0;RB10=0;RB13>=0 o RB10<>0;'Orden Precancelacion Incorecto';NO;0;
Plazo           : 'Plazo'                           ; 8;1; ;  ;  ;PLAZO>0;'Debe INGRESAR el PLAZO';NO;0;FECHAVTO-FECHAOP
FechaVto        : 'Vto_Monto'                       ; 9;1; ;  ;  ;;;;FECHAOP+PLAZO;FECHAOP+PLAZO
Cantidad        : 'V_Nominal'                       ;10;1; ;NOT EV;;[EV y 1=1] o [CANTIDAD>0 Y [VACIO(OPERACIONREF) O [[EQSTR(ABM,'A') Y CANTIDAD<=VCAN2] O [NOT EQSTR(ABM,'A') Y CANTIDAD<=(VCAN2+VCAN1)]]]];'El Valor Nominal DEBE SER INFERIOR AL Valor Total de la Op.Referencia';NO;;IF(CANTIDADORI<>0,CANTIDADORI*COEFICIENTE,CANTIDADORI);;;;;'###,###,###,###,###.##'
TipoTasa        : 'Tipo_Tasa'                       ;11;1; ;VACIO(OPERACIONREF);VACIO(OPERACIONREF)  ;NOVACIO(TIPOTASA);'El Tipo de Tasa ES INVALIDO';NO;'FIJA';IF(VACIO(OPERACIONREF),IF(RB6=0,'FIJA',TIPOTASA),OPREF.TIPOTASA)
Precio1         : 'Tasa Interes'                    ;  ; ; ;EQSTR(TIPOTASA,'FIJA');EQSTR(TIPOTASA,'FIJA');PRECIO1>=0;'La Tasa debe SER POSITIVA';NO;0;;;;;;;'###,###.######'

RB8: 'Day Count|ActAct|Act365F|Act360|360360|30E360';13;1; ;NOT EV y VACIO(OPERACIONREF);;;;;IF(VACIO(OPERACIONREF),1,OPREF.RB8);IF(VACIO(OPERACIONREF),RB8,OPREF.RB8)
Plazo4          : 'Dias Seteo Tasa'                 ;12;2; ;;NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA);[PLAZO4>=0] O [EQSTR(TIPOTASA,'FIJA')];'Indique la Cantidad de Dias Previos al Inicio para Setear la Tasa';NO;;
ImpGastos2      : 'Tasa_IVA'                        ;14;1; ;RB6=0 O [RB6=2 y MB3=0];RB6=0 O [RB6=2 y MB3=0];;;;VAR('TASAIVA');IF(Incluido(VEHICULO1,VAR('VEHIEXTRAN')),0,IF(VACIO(OPERACIONREF),IF(RB6=0 O [RB6=2 y MB3=0],IMPGASTOS2,0),OPREF.IMPGASTOS2));;;;;'###,###.######'
RB16            : 'Setea|InicioPer|FinPer'          ;12;1;;;NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA);RB16=0 O RB16=1 o [EQSTR(TIPOTASA,'FIJA') o VACIO(TIPOTASA)];'Indique Inicio o Fin de Periodo';NO;
TotalAux1       : 'Tasa WH'                         ;10;2; ;RB6=2;RB6=2;Incluido(Fstr(TOTALAUX1,2,4),VAR('TASAWH'));'El Valor de TASA WH es Erroneo: '~VAR('TASAWH')~' ...';NO;VAR('DEFWH1');IF(VACIO(OPERACIONREF),TOTALAUX1,OPREF.TOTALAUX1);;;;;'###,###.######'
ContraEspecie   : 'Esp_Pago_Imp'                    ;10;2; ;RB6=3 O RB6=4;RB6=3 O RB6=4;[RB6<>3 y RB6<>4] O [RB6=3 Y NOVACIO(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE, ESPECIE)] O [RB6=4 Y NOVACIO(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE, ESPECIE)];'NO INGRESO LA ESPECIE DE PAGO IMPUESTO';NO;;;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";;;
TasaPrecan      : 'Alic Imp_Extr'                   ;11;2; ;RB6=3 O RB6=4;RB6=3 O RB6=4;[RB6<>3 y RB6<>4] O [RB6=3 Y TASAPRECAN<=30] O [RB6=4 Y TASAPRECAN<=30];'EL IMPUESTO EXTRANJERO DEBE SER <=30';NO;VAR('ALICIMPU');;;;;;'###,###.######'

Cuotas1         : 'Nr_Periodos'                     ;15;1; ;  ;  ;CUOTAS1>=1;'Debe INGRESAR la Cantidad DE PERIODOS';NO;;;
MB4             : 'Gen_Contra|No|Si'                ;16;1; ;NOT EV;  ;MB4>=0;'Genera Contra Operacion?';NO;;
NrOperacion2    : 'Op_Referencia'                   ;17;1; ;NOT EV;  ;;;;
CB5             : 'Seller Notes'                    ;18;1; ;  ;NO;
CB6             : 'Activado'                        ;19;1; ;NO;NO;;;;1;

CB3             : 'Renovacion'                      ;20;1; ;NOT EV;;;;;0
NrOperacion4    : 'Op.Renovacion'                   ;21;1; ;CB3=1 Y NOT EV;CB3=1; CB3=0 O [NOVACIO(NROPERACION4) y Incluido(NrOperacion4 , SqlSet("Select NrOperacion from "~DBO~".OPERACIONES Where TipoOp like 'MMPCCM%' and Vehiculo1= '"~VEHICULO1~"' and Especie= '"~ESPECIE~"' ") )] ; 'Operacion de Renovacion incorrecta: Debe ser mismo Tipo, Vehiculo y Moneda  ';NO;; if(CB3=0,'');;;;;; "  Vehiculo1= '"~VEHICULO1~"'    AND  Especie= '"~ESPECIE~"'  and (CB3 = '0' OR CB3 IS NULL)  AND TipoOp = '"~TIPOOP~"'    ";


NrOperacion5    : 'Prorroga'                        ;19;2; ;NO;NoVacio(NROPERACION5);
FechaVto2       : 'F.Prorr'                         ;20;2; ;NO;NoVacio(NROPERACION5);
NrOperacion6    : 'Precanc.'                        ;22;1; ;NO;NoVacio(NROPERACION6);
FechaPrecan     : 'F.Precan'                        ;21;2; ;NO;NoVacio(NROPERACION6);


NrOperacion3    : 'Op.Vinculada'                    ;14;2; ;NO;NOVACIO(NROPERACION3);
Operador        :                                   ;15;2; ;NO;  ;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
TablaFeriados1  : 'Feriados'                        ;16;2; ;VACIO(OPERACIONREF);;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;IF(VACIO(OPERACIONREF),BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE)) ,OPREF.TABLAFERIADOS1)

VCAN1           : 'CantAnt'                         ;12;3; ;NO;NO;;;;;BuscarCampo('OPERACIONES','Cantidad+TotalComisiones','NrOperacion',NrOperacion)
VCAN10          : 'ComEF'                           ;10;2; ;NO;NO;;;;;IF(NOVACIO(OPERACIONREF),QUERY(" Select Tasa1 from "~DBO~".COMISIONES2 where NrOperacion='"~OPERACIONREF~"' AND Tipo='5'"),0);;;;;'###.#####'
VPRE1           : 'UTEF'                            ;10;2; ;NO;NO;;;;;IF(NOVACIO(OPERACIONREF),IF(EQSTR(QUERY("Select RB2 from "~DBO~".COMISIONES2 where NrOperacion='"~OPERACIONREF~"' "),'0'),36000,36500),0)
RB3             : 'MOF'                             ;10;2; ;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa         : 'Modificado'                      ;10;3; ;NO;NO;;;;0
VCAN17          : 'Cuotas c/Afec'                   ;20;1;1;NO;NO;;;;0;QUERY("Select Count(*) from "~DBO~".CUOTAS where NrOperacion='"~NROPERACION~"' and Check9=1 ")

Cotizacion1     : 'TC_Concert.'                     ; 1;1;2;  ;Not Eqstr(ESPECIE,VAR('MONEEXTR'));Eqstr(ESPECIE,VAR('MONEEXTR')) O [COTIZACION1<=VPRE9*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE9*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE9*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE9*(1+VAR('RPRECIO2')/100),1,7);NO;;IF(Eqstr(ESPECIE,VAR('MONEEXTR')),1,COTIZACIONC(Var('MONEEXTR'),,,,FECHAOP,1,SI,ESPECIE))
Cotizacion2     : 'TC_Vencim.'                      ; 2;1;2;COTIZACION2<>0;COTIZACION2<>0;;;;
TasaBase        : '%Percep. I.B.'                   ; 3;1;2;Eqstr(ABM, 'A') O MB3=1;Eqstr(ABM, 'A') O MB3=1 Y NO;SI O TASABASE > 0;'% Ret. Ingresos Brutos en 0 (cero)';SI;;;;;;;'###,###.######'
RB11            : 'Ajuste|NO|SI'                    ; 5;1;2;  ;No;;;;0;
CB1             : 'Op.Automatica'                   ; 6;1;2;NO;;;;;0

VPRE9           : 'Cot.TC/USD'                      ;10;2;2;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(ESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)
PrecioMer       : 'Monto USD WF'                    ; 1;2;2;NO;NO;;;;CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'));CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))
RB7             : 'RB7'                             ;  ; ;2;NO;NO; 
RB9             : 'RB9'                             ;  ; ;2;NO;NO;    
TotalComisiones : 'TotalComisiones'                 ;  ; ;2;NO;NO; 
