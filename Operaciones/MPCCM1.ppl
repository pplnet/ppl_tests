Precio6         : 'Precio6'                    ;1;1;1;NO;NO;

VTXT18          : 'Book Def'                        ; 1;2;2;NO;NO;;;;;BuscarCampo('VEHICULOS','Alias5','Codigo',VEHICULO1)
VTXT19          : 'Codigo Book'                     ; 2;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Codigo','Codigo',VTXT18)
VTXT20          : 'Vehic.Book'                      ; 3;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Vehiculo','Codigo',VTXT19)

@CUENTAS3
@INDICE1
@RANGOTASA

LISTA:SI;IF(ESINICIO,2,CUOTAS1);
  Tasa1    : 'Tasa Amort'      ;  ;  ;CUOTASL.TASA1[Fila]>=0;'La Tasa de Amortizacion debe SER POSITIVA';(100/CUOTAS1);((CUOTASL.CANTIDAD1[Fila]/CUOTASL.COEFICIENTE[Fila])*100)/CANTIDADORI;100;;Numero;'###,###.######';NO;NO;'2'
  Cantidad1: 'Imp Amort'       ;  ;  ;CUOTASL.CANTIDAD1[Fila]>=0;'El Importe Amortizacion debe SER POSITIVO';(CANTIDADORI*(100/CUOTAS1)/100)*CUOTASL.COEFICIENTE[Fila] ;(CANTIDADORI*CUOTASL.TASA1[Fila]/100)*CUOTASL.COEFICIENTE[Fila] ;200;;Numero;'###,###,###,###,###.##';NO;NO;'1'
  Plazo1   : 'Plazo'           ;  ;  ;CUOTASL.PLAZO1[Fila]>0;'El Plazo DEBE SER POSITIVO';IF(Fila=CUOTAS1 Y (PLAZO MOD CUOTAS1)<>0,(PLAZO DIV CUOTAS1)+(PLAZO MOD CUOTAS1),(PLAZO DIV CUOTAS1));CUOTASL.FECHA2[Fila]-CUOTASL.FECHA1[Fila];60;;Numero;'####';NO;NO;'5'
  Fecha1   : 'F.Origen'        ;NO;  ;SI O [EqStr(TABLAFERIADOS1,'USA') Y ESHABIL(CUOTASL.FECHA1[Fila],TABLAFERIADOS1)] O [Not EqStr(TABLAFERIADOS1,'USA') Y ESHABIL(CUOTASL.FECHA1[Fila],TABLAFERIADOS1) Y ESHABIL(CUOTASL.FECHA1[Fila],'ARG')];'La Fecha Origen de la Cuota '~Fstr(Fila, 0, 0)~' No es HABIL';IF(Fila=1,FECHAOP,CUOTASL.FECHA2[Fila-1]);IF(Fila=1,FECHAOP,CUOTASL.FECHA2[Fila-1]);90;;Fecha;;;;;;;;RB11 = 0
  Fecha2   : 'F.Vto'           ;  ;  ;  ; ;IF(Fila=CUOTAS1,FECHAVTO,CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila]);CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila];90;;Fecha;NO;NO;'3;6';;;;;RB11 = 0
  Fecha3   : 'F.Sett'          ;SI;SI;CUOTASL.FECHA3[Fila]>=CUOTASL.FECHA2[Fila] Y ESHABIL(CUOTASL.FECHA3[Fila],TABLAFERIADOS1) Y ESHABIL(CUOTASL.FECHA3[Fila],'ARG'); 'El Vto Settlement de la Cuota '~Fstr(Fila, 0, 0)~' No es HABIL o Es Menor a la Fecha de Vto' ;IF((Not EsHabil(CUOTASL.FECHA2[Fila], TABLAFERIADOS1) O Not EsHabil(CUOTASL.FECHA2[Fila], 'ARG')),Habiles2(CUOTASL.FECHA2[Fila],1,TABLAFERIADOS1~'|ARG', SI), CUOTASL.FECHA2[Fila]);IF((Not EsHabil(CUOTASL.FECHA2[Fila], TABLAFERIADOS1) O Not EsHabil(CUOTASL.FECHA2[Fila], 'ARG')),Habiles2(CUOTASL.FECHA2[Fila],1,TABLAFERIADOS1~'|ARG', SI), CUOTASL.FECHA2[Fila]);90;;Fecha;NO;NO
  Cantidad2: 'V.Nominal'       ;NO;  ;CUOTASL.CANTIDAD2[Fila]>=0;'El Valor Nominal debe SER POSITIVO';;IF(Fila=1,CANTIDADORI,CUOTASL.CANTIDAD2ORI[Fila-1]-CUOTASL.CANTIDAD1ORI[Fila-1])*CUOTASL.COEFICIENTE[Fila] ;200;;Numero;'###,###,###,###,###.##'
  Precio2  : 'Tasa Interes'    ;;;VACIO('OPREF') O [SI o [NOT EQSTR(TIPOTASA,'FIJA') Y Fila>1 Y CUOTASL.PRECIO2[Fila]=0 ]] O [SI O CUOTASL.PRECIO2[Fila]>0];'TASA INVALIDA O FALTA TASA';;IF(NOVACIO(OPERACIONREF) Y EQSTR(TIPOTASA,'FIJA'),OPREF.PRECIO1,IF(EV,CUOTASL.PRECIO2[FILA],PRECIO1));100;;Numero;'###,###.######';NO;NO;'14'

  Precio4  : 'Spread'          ;  ;VACIO('OPREF') O NOT EQSTR(TIPOTASA,'FIJA');EQSTR(TIPOTASA,'FIJA') O [NOT EQSTR(TIPOTASA,'FIJA') Y CUOTASL.PRECIO4[Fila]=0] O [NOT EQSTR(TIPOTASA,'FIJA') Y CUOTASL.PRECIO4[Fila]>=VAR('RSPREAD1') Y CUOTASL.PRECIO4[Fila]<=VAR('RSPREAD2')];'El Spread esta Fuera de Rango:'~VAR('RSPREAD1')~' '~VAR('RSPREAD2');IF(NOVACIO(OPERACIONREF),OPREF.SPREAD,CUOTASL.PRECIO4[Fila]);IF(EQSTR(TIPOTASA,'FIJA'),0,CUOTASL.PRECIO4[Fila]);100;;Numero;'###,###.######';NO;NO;'14'
  Tasa2    : 'Tasa_Int_IVA'    ;  ;RB6=0 O [RB6=2 y MB3=0];;;;IF(RB6<=2,CUOTASL.PRECIO2[Fila]+CUOTASL.PRECIO4[Fila],0);100;;Numero;'###,###.######';NO;NO;'11';
  Total4   : 'Importe_Iva'     ;EV;RB6=0 O [RB6=2 y MB3=0];NOT EV o [[ROUND(CUOTASL.TOTAL4[Fila],2) <= ROUND((CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.TOTAL4[Fila],2) >= ROUND((CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe IVA Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(RB6=0 O [RB6=2 y MB3=0],((CUOTASL.CANTIDAD2[Fila]*CUOTASL.TASA2[Fila]/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1))*(IMPGASTOS2/100),0);200;NO;Numero;'###,###,###,###,###.##';NO;NO;'10';
  Total6   : 'Tasa_Int_WH'     ;  ;RB6=2;;;;IF(RB6=2,CUOTASL.PRECIO2[Fila]+CUOTASL.PRECIO4[Fila],0);100;;Numero;'###,###.######';NO;NO;'13';
  Total7   : 'WH_a_Liquidar'   ;EV;RB6=2 y MB3=0;NOT EV o [[ROUND(CUOTASL.TOTAL7[Fila],2) <= ROUND((CUOTASL.PRECIO7[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.TOTAL7[Fila],2) >= ROUND((CUOTASL.PRECIO7[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe WHT Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO7[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO7[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(RB6=2 y MB3=0,(( (CUOTASL.CANTIDAD2[Fila]*CUOTASL.TOTAL6[Fila]/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1))*(TOTALAUX1/100)),0);200;NO;Numero;'###,###,###,###,###.##';NO;NO;'12';
  Cantidad3: 'Interes'         ;EV;  ;NOT EV o [[ROUND(CUOTASL.CANTIDAD3[Fila],2) <= ROUND((CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.CANTIDAD3[Fila],2) >= ROUND((CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100)),2)]];'Interes Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100),2),0,2);;CUOTASL.CANTIDAD2[Fila]*((CUOTASL.PRECIO4[Fila]+CUOTASL.PRECIO2[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1);200;NO;Numero;'###,###,###,###,###.##';NO;NO;'8;9';
  Cantidad4: 'Imp.Imp_Extr.'   ;NO;RB6=3 O [RB6=4 y MB3=0];NOT EV o [[ROUND(CUOTASL.CANTIDAD4[Fila],2) <= ROUND((CUOTASL.PRECIO8[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.CANTIDAD4[Fila],2) >= ROUND((CUOTASL.PRECIO8[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe Impuesto Extranjero Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO8[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO8[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(RB6=3 O [RB6=4 y MB3=0],CUOTASL.CANTIDAD3[Fila]*TASAPRECAN/100,0);200;NO;Numero;'###,###,###,###,###.##';NO;NO
  Total3   : 'Interes Neto'    ;NO;  ;;;;CUOTASL.CANTIDAD3[Fila]+CUOTASL.TOTAL7[Fila]+IF(RB6=4 y MB3=0,CUOTASL.CANTIDAD4[Fila],0);200;;Numero;'###,###,###,###,###.##'
  Total9   : 'Ingresos Brutos' ;NO;NO Y MB3=1;SI;;;IF(CUOTASL.CANTIDAD3[Fila] > Var('IBMINIMO'), CUOTASL.CANTIDAD3[Fila]*TASABASE/100, 0);200;;Numero;'###,###.########';
  Precio3  : 'Tasa T.Neta'     ;NO;  ;SI Y [CUOTASL.Precio3[Fila]=0 y Fila>1 o [CUOTASL.Precio3[Fila]<=VAR('RTTN2') Y CUOTASL.Precio3[Fila]>=VAR('RTTN1')]] O SI;'Tasa Total Neta Fuera de Rango:'~VAR('RTTN1')~" Y "~VAR('RTTN2');;;200;;Numero;'###.######';NO;NO
  Total2   : 'Monto'           ;NO;  ;;;;(CUOTASL.CANTIDAD1[Fila]+CUOTASL.CANTIDAD3[Fila]);200;;Numero;'###,###,###,###,###.##'
  Total1   : 'Monto Neto'      ;NO;  ;;;;(CUOTASL.CANTIDAD1[Fila]+CUOTASL.TOTAL3[Fila]);200;;Numero;'###,###,###,###,###.##'
  Precio5  : 'MOD INT'         ;NO;NO;;;CUOTASL.CANTIDAD2[Fila]*((CUOTASL.PRECIO4[Fila]+CUOTASL.PRECIO2[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1);CUOTASL.CANTIDAD2[Fila]*((CUOTASL.PRECIO4[Fila]+CUOTASL.PRECIO2[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1);200;;Numero;'###.######'
  Precio6  : 'MOD IVA'         ;NO;NO;;;IF(RB6=0 O [RB6=2 y MB3=0],((CUOTASL.CANTIDAD2[Fila]*CUOTASL.PLAZO1[Fila]*CUOTASL.TASA2[Fila])/IF(RB7=0,36000,36500))*(IMPGASTOS2/100),0);IF(RB6=0,((CUOTASL.CANTIDAD2[Fila]*CUOTASL.PLAZO1[Fila]*CUOTASL.TASA2[Fila])/IF(RB7=0,36000,36500))*(IMPGASTOS2/100),0);200;;Numero;'###.######'
  Precio7  : 'MOD WHT'         ;NO;NO;;;IF(RB6=2 y MB3=0,(( (CUOTASL.CANTIDAD2[Fila]*CUOTASL.PLAZO1[Fila]*CUOTASL.TOTAL6[Fila])/IF(RB9=1,36500,36000)) *(TOTALAUX1/100)),0);IF(RB6=2 y MB3=0,(( (CUOTASL.CANTIDAD2[Fila]*CUOTASL.PLAZO1[Fila]*CUOTASL.TOTAL6[Fila])/IF(RB9=1,36500,36000)) *(TOTALAUX1/100)),0);200;;Numero;'###.######'
  Precio8  : 'MOD IMP'         ;NO;NO;;;IF(RB6=3 O [RB6=4 y MB3=0],CUOTASL.CANTIDAD3[Fila]*TASAPRECAN/100,0);IF(RB6=3 O [RB6=4 y MB3=0],CUOTASL.CANTIDAD3[Fila]*TASAPRECAN/100,0);200;;Numero;'###.######'
  Cantidad6: 'Imp_ExtrVinc'    ;NO;NO;;;IF(RB6=3 O [RB6=4 y MB3=1],CUOTASL.CANTIDAD3[Fila]*TASAPRECAN/100,0);IF(RB6=3 O [RB6=4 y MB3=1],CUOTASL.CANTIDAD3[Fila]*TASAPRECAN/100,0);200;;Numero;'###,###,###,###,###.##';NO;NO
  Total5   : 'WH_Vinc'         ;NO;NO;;;IF(RB6=2 y MB3=1,(( (CUOTASL.CANTIDAD2[Fila]*CUOTASL.PLAZO1[Fila]*CUOTASL.TOTAL6[Fila])/IF(RB9=1,36500,36000)) *(TOTALAUX1/100)),0);IF(RB6=2 y MB3=1,(( (CUOTASL.CANTIDAD2[Fila]*CUOTASL.PLAZO1[Fila]*CUOTASL.TOTAL6[Fila])/IF(RB9=1,36500,36000)) *(TOTALAUX1/100)),0);200;;Numero;'###,###,###,###,###.##'
  Total8   : 'Int_Neto Vinc'   ;NO;NO;;;CUOTASL.CANTIDAD3[Fila]+CUOTASL.TOTAL5[Fila]+IF(RB6=4 y MB3=1,CUOTASL.CANTIDAD6[Fila],0);CUOTASL.CANTIDAD3[Fila]+CUOTASL.TOTAL5[Fila]+IF(RB6=4 y MB3=1,CUOTASL.CANTIDAD6[Fila],0);200;;Numero;'###,###,###,###,###.##'
  Cantidad5: 'Monto_Neto_Vinc' ;NO;NO;;;(CUOTASL.CANTIDAD1[Fila]+CUOTASL.TOTAL8[Fila]);(CUOTASL.CANTIDAD1[Fila]+CUOTASL.TOTAL8[Fila]);200;;Numero;'###,###,###,###,###.##'
  Precio1  : 'TTN_Vinc'        ;NO;NO;;;(CUOTASL.TOTAL8[Fila]*36500)/(CUOTASL.CANTIDAD2[Fila]*CUOTASL.PLAZO1[Fila]);(CUOTASL.TOTAL8[Fila]*36500)/(CUOTASL.CANTIDAD2[Fila]*CUOTASL.PLAZO1[Fila]);200;;Numero;'###.######'
  
  Radio1   : 'Cta. Prorrogada' ;NO;  ;;;-1;;70;;Combo;'NO|SI';

  Cantidad9: 'Cta Prorrogable' ;NO;NO;;;;;200;;Numero;'###,###,###,###,###.##'
  Check1   : 'x Precan'        ;NO;SI;;;;;200;;Check;
  Cantidad12: 'Saldo VN Amort.';NO;SI;;;;CUOTASL.CANTIDAD1[Fila];200;NO;Numero;'###,###,###,###,###.##';NO;NO;
  Check9    : 'Afec.Dev.Saldo' ;NO;SI;;;0;;50;;Check;;;;;;;;SI
@INDICECTAS
  Fecha4   : 'F.Reset'         ;NO;NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA);;;;HABILES(IF(RB16=0,CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila]),-PLAZO4,TABLAFERIADOS1,SI); 90;;Fecha;NO;NO;;;;;;
  Tasa7    : '% Amort Orig'   ;NO;SI;;;IF(VACIO(OPERACIONREF) o CUOTAS2=0 o OPREF.RB6<=0,if(EqStr(ABM,'A'),(100/CUOTAS1),CUOTASL.TASA1[Fila]),IF(Fila>1,QUERY("SELECT Tasa1 FROM "~DBO~".CUOTAS Where NrOperacion='"~OPERACIONREF~"' and NrCuota="~Fstr(Fila+CUOTAS2-1,0,0)~" "),QUERY("SELECT Sum(Tasa1) FROM "~DBO~".CUOTAS Where NrOperacion='"~OPERACIONREF~"' and NrCuota<="~Fstr(Fila+CUOTAS2-1,0,0)~" ")));IF(SUM(CUOTASL, 24)=0, CUOTASL.TASA1[Fila], CUOTASL.TASA7[Fila]);100;;Numero;'###,###.######';NO;NO;

@COMIOP


CONDICIONES
Not EqStrI(Vehiculo1,Vehiculo2);'El Vehiculo Contraparte debe ser diferente al Vehiculo por el cual se ingresa la Operacion';NO;NO;FSYS;'VEHDUPL'
ESHABIL(FECHAOP,'ARG');'La Fecha de Origen no es Dia Habil en Argentina';SI;SI;FSYS;'ORIGINH'
ESHABIL(FECHAVTO,'ARG');'La Fecha de Vencimiento NO ES DIA HABIL en Argentina';SI;SI;FSYS;'VTOINH'
VACIO(NROPERACION2) O [EQSTR(TIPOOP,BuscarCampo('Operaciones','TipoOp','NrOperacion',NROPERACION2)) y BuscarCampo('Operaciones','FechaVto','NrOperacion',NROPERACION2)=Fsys y EQSTR(BuscarCampo('Operaciones','Vehiculo1','NrOperacion',NROPERACION2),VEHICULO1) y EQSTR(ESPECIE,BuscarCampo('Operaciones','Especie','NrOperacion',NROPERACION2))];'La Operacion de Referencia es INVALIDA';NO
RB6>2 O [Incluido(Fstr(ImpGastos2,2,2),VAR('IVA'))];'El Valor de TASA IVA es Erroneo: '~VAR('IVA');NO
[EV y 1=1] o [NOT EV y [VACIO(OPERACIONREF) O [OPREF.FECHAVTO>=FECHAOP Y OPREF.MB3=0 Y OPREF.CANTIDAD>=(OPREF.TOTALAUX3-VCAN1+CANTIDAD)]]];'La Partida '~OPERACIONREF~' No se puede Asociar a esta Operacion';NO
VACIO(OPERACIONREF) O [FECHAOP>=OPREF.FECHAOP Y FECHAOP<=OPREF.FECHAVTO];'LA FECHA DE ORIGEN DEBE ESTAR INCLUIDA EN EL PLAZO DE LA PARTIDA';NO
SUM(CUOTASL,3)=PLAZO;'LA SUMATORIA DE LOS PLAZOS PARCIALES DEBE SER IGUAL AL PLAZO TOTAL';NO
ROUND(SUM(CUOTASL,1),2)=100;'La Sumatoria de la Tasa de Amortizacion debe ser 100';NO
ESTERMINAL(VEHICULO2,VEHICULO);'El Vehiculo ContraParte debe ser Terminal';NO
FECHAOP2=Fsys;'La Fecha de Concertacion no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
@CONDIOP
@CONDBOOK

CONDICIONESCUOTAS
SI O [CUOTASL.PRECIO2[Fila]>=VPRE11 Y CUOTASL.PRECIO2[Fila]<=VPRE12];'La Tasa de la Cuota '~Fstr(Fila, 0, 0)~' esta fuera de rango' ;SI;SI;FSYS;'RTASA';
CUOTASL.PRECIO2[Fila]>=VAR('RTASA1') Y CUOTASL.PRECIO2[Fila]<=VAR('RTASA2');'La Tasa de la Cuota '~Fstr(Fila, 0, 0)~' esta fuera de rango' ;SI;SI;FSYS;'RTASA';


EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador
MB3=0 O QUERY("SELECT 1 FROM "~DBO~".SOLFAC WHERE NrOperacion='"~NROPERACION~"' and Tipo= 'FC' and (Estado = 'A' or Estado = 'C') ") <> 1;'No se puede dar de baja, pendiente envio de NC a SAP'

REFERENCIA
'TotalAux3='~FStr(OPREF.TotalAux3-VCAN1+Cantidad,0,2)
'Cuotas1='~FStr(OPREF.Cuotas1+1,0,2)

SQL
"INSERT INTO "~DBO~".CUOTAS (NrOperacion,Mercado1,NrCuota,Fecha1,Cantidad1) "~"Values ('"~OPERACIONREF~"','"~NROPERACION~"',"~Fstr(OPREF.Cuotas1+1,0,0)~", '"~IdxDate(FechaOp)~"', "~Fstr(Cantidad,0,4)~") ";NOVACIO(OPERACIONREF) Y EQSTR(ABM,'A')

POSTEDICION
EqStr(ABM,'A') y QUERY("SELECT COUNT(*) FROM "~DBO~".COMISIONES2 WHERE NrOperacion='"~OPERACIONREF~"' and Tipo='0' ")>0 Y OPREF.TOTALAUX3=0;'MESSAG';String='Debe ACTUALIZAR la Fecha de la Comision FPD para la Operacion '~OPERACIONREF
NOVACIO(OPERACIONREF) Y EQSTR(ABM,'A');'INSCOM';NrOperacion1=OPERACIONREF;NrOperacion2=NROPERACION;String=" Tipo  IN ('5','3')"
EqStr(ABM,'A') y MB4=1;'INVIMV';NrOperacion1=NROPERACION;TipoOp1=TIPOOP;String="MB3="~Fstr(IF(MB3=0,1,0),1,0)~",Book1=Book2,Book2=Book1 ";Vehiculo1=VEHICULO2;Vehiculo2=VEHICULO1;String1=" Total3=Total8,Total1=Cantidad5,Total7=Total5,Precio3=Precio1,Cantidad4=Cantidad6 ";String2='';
EqStr(ABM,'B') ;'FWVIN5';NrOperacion1=NROPERACION3

@POSTEMM

MOVIMIENTOS
FechaOp;Cliente1;Especie;;;;;Vehiculo1;1;IF(MB3=0,-Cantidad,Cantidad);;TIPOOP;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;CB5=0;;Cuenta1;;1;

POSICION
FechaOp;Vehiculo1;Especie;;;;Vehiculo1;;;;;122;IF(MB3=0,Cantidad,-Cantidad);COTIZACIONC(ESPECIE,,,,FECHAOP-1,1,SI,'ARP')  ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD');
FechaOp;Vehiculo1;Especie;;;;Vehiculo1;;;;;132;IF(MB3=0,Cantidad,-Cantidad);COTIZACIONC(ESPECIE,,,,FECHAOP-1,1,SI,'USD')  ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD');

MOVCUOTAS
CuotasL.Fecha3[Fila];Cliente1 ;Especie;;Vehiculo1;1;IF(MB3=0, CuotasL.Cantidad1[Fila],-CuotasL.Cantidad1[Fila]);'Vto.Capital '~TIPOOP;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;CB6=1 y CUOTASL.Check1[Fila]<>1;(Fila+500);Cuenta1;;(Fila+500)  ;'CUOTAS'
CuotasL.Fecha3[Fila];Cliente1 ;Especie;;Vehiculo1;1;IF(MB3=0, CuotasL.Cantidad3[Fila],-CuotasL.Cantidad3[Fila]);'Vto.Interes '~TIPOOP;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;CB6=1 y CUOTASL.Check1[Fila]<>1;(Fila+5000);Cuenta1;;(Fila+5000) ;'CUOTAS'
CuotasL.Fecha3[Fila];Cliente1 ;Especie;;Vehiculo1;1;IF(MB3=0, CuotasL.Total7[Fila],-CuotasL.Total7[Fila]);'WH '~TIPOOP;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;CuotasL.Total7[Fila]<>0 Y CB6=1 y CUOTASL.Check1[Fila]<>1;(Fila+7000);Cuenta1;;(Fila+7000) ;'CUOTAS'
CuotasL.Fecha3[Fila];Cliente1 ;Especie;;Vehiculo1;1;IF(MB3=0, CuotasL.Total4[Fila],-CuotasL.Total4[Fila]);'IVA '~TIPOOP;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;CuotasL.Total4[Fila]<>0 Y CB6=1 y CUOTASL.Check1[Fila]<>1;Fila;Cuenta1;;(Fila+1000);'CUOTAS'
CuotasL.Fecha3[Fila];Cliente1 ;Especie;;Vehiculo1;1;-CuotasL.Total9[Fila];'I.B. '~TIPOOP;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;NO y CuotasL.Total9[Fila]<>0 Y MB3 = 0 Y CB6=1 y CUOTASL.Check1[Fila]<>1;Fila;Cuenta1;;(Fila+11000);'CUOTAS'

POSCUOTAS
CuotasL.Fecha2[Fila];Vehiculo1;Especie;;;;Vehiculo1;;;;;122;IF(MB3=0,-CuotasL.Cantidad1[Fila],CuotasL.Cantidad1[Fila]);COTIZACIONC(ESPECIE,,,,CuotasL.Fecha2[Fila]-1,1,SI,'ARP')  ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD') y CUOTASL.Check1[Fila]<>1;
CuotasL.Fecha2[Fila];Vehiculo1;Especie;;;;Vehiculo1;;;;;132;IF(MB3=0,-CuotasL.Cantidad1[Fila],CuotasL.Cantidad1[Fila]);COTIZACIONC(ESPECIE,,,,CuotasL.Fecha2[Fila]-1,1,SI,'USD')  ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD') y CUOTASL.Check1[Fila]<>1;
CuotasL.Fecha2[Fila];Vehiculo1;Especie;;;;Vehiculo1;;;;;122;IF(MB3=0,-CuotasL.Cantidad3[Fila],CuotasL.Cantidad3[Fila]);COTIZACIONC(ESPECIE,,,,CuotasL.Fecha2[Fila]-1,1,SI,'ARP')  ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD') y CUOTASL.Check1[Fila]<>1;
CuotasL.Fecha2[Fila];Vehiculo1;Especie;;;;Vehiculo1;;;;;132;IF(MB3=0,-CuotasL.Cantidad3[Fila],CuotasL.Cantidad3[Fila]);COTIZACIONC(ESPECIE,,,,CuotasL.Fecha2[Fila]-1,1,SI,'USD')  ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD') y CUOTASL.Check1[Fila]<>1;

DEVENGADOSCUOTAS
CUOTASL.FECHA1[Fila]+1;CUOTASL.FECHA2[Fila];RB8<>4;SI;NO;TablaFeriados1;SI;SI;'INTLEN';IF(MB3=0, -CuotasL.Cantidad3[Fila], CuotasL.Cantidad3[Fila]);140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;Fstr(Fila,0,0);Especie;;;;;;;;
CUOTASL.FECHA1[Fila]+1;CUOTASL.FECHA2[Fila];RB8<>4;SI;NO;TablaFeriados1;SI;SI;'INTWHT';IF(MB3=0, -CuotasL.Total7[Fila], CuotasL.Total7[Fila]);140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;Fstr(Fila,0,0);Especie;;;;;;;;
CUOTASL.FECHA1[Fila];CUOTASL.FECHA2[Fila]-1;RB8=4 ;SI;NO;TablaFeriados1;SI;SI;'INTLEN';IF(MB3=0, -CuotasL.Cantidad3[Fila], CuotasL.Cantidad3[Fila]);140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;Fstr(Fila,0,0);Especie;2;IF(MB3=0, -CUOTASL.CANTIDAD2[Fila], CUOTASL.CANTIDAD2[Fila]);(CUOTASL.PRECIO2[Fila]+CUOTASL.PRECIO4[Fila]);360;NO;;5;
CUOTASL.FECHA1[Fila];CUOTASL.FECHA2[Fila]-1;RB8=4 ;SI;NO;TablaFeriados1;SI;SI;'INTWHT';IF(MB3=0, -CuotasL.Total7[Fila], CuotasL.Total7[Fila]);140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;Fstr(Fila,0,0);Especie;2;IF(MB3=0, -CUOTASL.CANTIDAD3[Fila], CUOTASL.CANTIDAD3[Fila]);TotalAux1;360;NO;;5;


