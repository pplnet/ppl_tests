Especie        : 'Moneda'       ;;;;;;Incluido(ESPECIE,VAR('MONEEXTR')~'|'~VAR('MONELOCA'));'La Especie debe ser '~VAR('MONEEXTR')~' O '~VAR('MONELOCA');NO;;VAR('MONEEXTR');
