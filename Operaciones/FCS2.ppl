CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
Especie       : 'Fondo'                          ;1;1; ;NOT EV;;NOVACIO(ESPECIE)  Y DESCIENDEDEESPECIE(ESPECIE ,'FONDOS');'Debe ingresar un fondo';NO;;;;;;;;" Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES','FONDOS'))~") and Status = 'HAB'"
ContraEspecie : 'Moneda'                         ; ; ; ;NO;;NOVACIO(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE,ESPECIE);'Debe ingresar una ContraEspecie';NO;VTXT40;CotizaEn(ESPECIE)
Cliente1      : 'Entidad '                       ; ; ; ;NO;;NoVacio(CLIENTE1);'La Especie debe tener Issuer';NO;;BuscarCampo('ESPECIES','Issuer','Codigo',ESPECIE);;;;;;"Status = 'HAB'";;;;
RB7           : 'Opera en|CuotasParte|Efectivo'     ;5;1; ;;;;;NO;1;
RB6           : 'Tipo|Money Markets|Securities'  ;11;2; ;NO;;;;;0;BuscarCampo('ESPECIES','Alias2','Codigo',ESPECIE)

Precio1       : 'Valor CuotaParte'               ;7;1;;     ;;;;;0;COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,CONTRAESPECIE);;;;;'###,###.##########';;
Cantidad      : 'CuotasParte'                    ;8;1;;RB7=0 o EV;;RB7=1 o CANTIDAD>0;'La Cantidad de CuotasParte debe ser Positiva';NO; ;IF(PRECIO1>0,TOTALNETOCLI1/PRECIO1,CANTIDAD)  ;;;;;'###,###,###,###.########';;
TotalNetoCli1 : 'Efectivo'                       ;9; ;;RB7=1 o EV;;RB7=0 o TOTALNETOCLI1>0;'La Cantidad en Efectivo debe ser Positiva';NO;;IF(PRECIO1>0,CANTIDAD*PRECIO1,TOTALNETOCLI1);;;;;'###,###,###,###.##';;
Operador      :                                  ;11;1;;NO;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
Observac2     : 'Op.Contraparte'                 ; ; ;;;;NOVACIO(OBSERVAC2);'El Operador Contraparte no es valido';SI;;;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
CB7           : 'Int.CtaParte'                   ;13;1;;NO;NO;CB7=0;'Es un Interes Pagado en Cuotas Partes';SI;0;
@VEHITO
FechaOp       : 'Fecha Conc.'                    ;4;2;;VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1);'Fecha incorrecta';NO;FSYS;
FechaOp2      : 'F.Origen'                       ; ; ;;;;ESHABIL(FECHAOP2,TABLAFERIADOS1);'Fecha de Inicio Invalida';NO;FSYS;
FechaVto      : 'Fecha Vto.'                     ; ; ; ;NO;;ESHABIL(FECHAVTO,TABLAFERIADOS1);'La Fecha de Vto. no es Habil en la Tabla de Feriados Seleccionada';NO;FECHAOP2+PLAZO;FECHAOP2+PLAZO;
Plazo         : 'Plazo'                          ;;;;;;PLAZO>=0;'El PLAZO debe ser Positivo';NO;0;IF(MODI,PLAZO,IF(RB6=0,0,BuscarCampo('Especies','PlazoLiq','Codigo',ESPECIE) DIV 24))
TablaFeriados1: 'Feriados'                       ;9; ;;;;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;BuscarCampo('ESPECIES','PaisOrigen','Codigo', ESPECIE)
Cotizacion1   : 'TC_Concert.'                    ;;;2;;Not Eqstr(CONTRAESPECIE,VAR('MONEEXTR'));;;;;IF(Eqstr(CONTRAESPECIE,VAR('MONEEXTR')),1,COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR')))
VPRE1         : 'Cot.TC/USD'                     ;10;2;2;NO;NO;;;;;COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(CONTRAESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)
Cotizacion2   : 'TC_Vencim.'                     ;;;2;COTIZACION2<>0;COTIZACION2<>0;;;;
VPRE6         : 'Cot.CONTESP/USD'                ;10;3;;NO;NO;;;;;COTIZACIONC(CONTRAESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
RB3           : 'MOF'                            ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa       : 'Modificado'                     ;10;3;;NO;NO;;;;0
CB6           : 'Cot.Esp/ContDirecta'            ;4;2;2;NO;NO;;;;;IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE~"' "),'INV'),0,1)
Precio4       : 'Cotizacion'                     ;12;2;2;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,CONTRAESPECIE)
VCAN9         : 'Total Consumido'                ;13;2;2;NO;NO;;;;;VCAN8+LIMCONSUMIDO(CLIENTE1,'COTOR',VTXT6,0,,,,NROPERACION)
VCAN8         : 'Equivalente USD'                ;14;2;2;NO;NO;;;;;TOTALNETOCLI1*COTIZACIONC(CONTRAESPECIE,,,,Fsys,1,SI,VTXT6)
VCAN7         : 'Limite Asignado'                ;15;2;2;NO;NO;;;;;LimAsignado(Cliente1,'COTOR',VTXT6)

VCAN1         : 'CuotasPAnt'                     ;18;1;2;NO;NO;;;;;QUERY("SELECT Cantidad FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~NROPERACION~"' ")
VCAN2         : 'EfectivoAnt'                    ;18;1;2;NO;NO;;;;;QUERY("SELECT TotalNetoCli1 FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~NROPERACION~"' ")
VTXT6         : 'EspecieLimiteCotor'             ; 1;2;2;NO;NO;;;;;QUERY("SELECT Especie FROM "~DBO~".LIMASIGNADOS WHERE Cliente='"~CLIENTE1~"' AND Limite='COTOR' ")
PrecioMer     : 'Monto USD WF'                   ;10;2;2;NO;NO;;;;TOTALNETOCLI1*VPRE6;TOTALNETOCLI1*VPRE6

VTXT18        : 'Book Def'                       ;1;2;2;NO;NO;;;;;BuscarCampo('VEHICULOS','Alias5','Codigo',VEHICULO1)
VTXT19        : 'Codigo Book'                    ;2;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Codigo','Codigo',VTXT18)
VTXT20        : 'Vehic.Book'                     ;3;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Vehiculo','Codigo',VTXT19)
OperacionRef  : 'OpRef'                          ;;;2;NO;NO;


@FCCTACONT
@CUENTAS

CONDICIONES
SI O [NOT EV o [CANTIDAD<=VCAN1*(1+Var('PORVAR')/100) y CANTIDAD>=VCAN1*(1-Var('PORVAR')/100)]];'CuotasPartes Fuera de Rango: '~FSTR(VCAN1*(1-Var('PORVAR')/100),0,7)~' y '~FSTR(VCAN1*(1+Var('PORVAR')/100),0,7);NO
SI O [NOT EV o [TOTALNETOCLI1<=VCAN2*(1+Var('PORVAR')/100) y TOTALNETOCLI1>=VCAN2*(1-Var('PORVAR')/100)]];'Efectivo Fuera de Rango: '~FSTR(VCAN2*(1-Var('PORVAR')/100),0,7)~' y '~FSTR(VCAN2*(1+Var('PORVAR')/100),0,7);NO
FECHAOP=Fsys;'La Fecha de Concertacion no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP2=Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'

[NOT NOVACIO(CLIENTE1)] o ExisteLimite('COTOR',Cliente1,VTXT6); 'Lim.Credito no asignado';SI;SI;FSYS;'COTORNOAS'
[NOT NOVACIO(CLIENTE1)] o Not ExisteLimite('COTOR',Cliente1,VTXT6) o VtoLimite('COTOR',Cliente1,VTXT6) >= FechaOp; 'Lim.Credito vencido el '~FECHA(VtoLimite('COTOR',Cliente1,VTXT6));SI;SI;FSYS;'COTORVENC'
[NOT NOVACIO(CLIENTE1)] o LimAsignado(Cliente1,'COTOR',VTXT6) >= VCAN9; 'Lim.Credito excedido en U$D '~PYC(-(LimAsignado(Cliente1,'COTOR',VTXT6)-VCAN9),1,0)~'.-';SI;SI;FSYS;'COTOREXCE'
@CONDIOP

SI O Incluido(ContraEspecie, VTXT40~'|'~Var('MONEEXTR')) o NoVacio(VTXT18);'El Vehiculo no tiene Book Default para Monedas';NO
SI O Incluido(ContraEspecie, VTXT40~'|'~Var('MONEEXTR')) o NoVacio(VTXT19);'El Book default '~VTXT18~' no es valido';NO
SI O Incluido(ContraEspecie, VTXT40~'|'~Var('MONEEXTR')) o EqStr(VTXT20,Vehiculo1);'El Book default '~VTXT18~' corresponde a otro vehiculo';NO
PRECIO1<=PRECIO4*(1+VAR('RPRECIO') /100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO') /100);'Tipo de Cambio FUERA DE RANGO: '~FSTR(PRECIO4*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO')/100),1,7)  ;SI;SI;FSYS;'RANGOPRECIO'
PRECIO1<=PRECIO4*(1+VAR('RPRECIO2')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO2')/100);'Tipo de Cambio Fuera de Rango: '~FSTR(PRECIO4*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO2')/100),1,7);SI;SI;FSYS;'RANGOPRECIO2'

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

MOVIMIENTOS
FechaVto;Cliente1 ;Especie      ;;;;;Vehiculo1;1;-Cantidad;;'Suscripcion de Fondos Cuotasparte';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;Round(TotalNetoCli1, 2)<>0 Y Cantidad>0;;Cuenta1;;1;;;;;;;;;;;;;;700
FechaVto;Cliente1 ;ContraEspecie;;;;;Vehiculo1;1;+TotalNetoCli1;;'Suscripcion de Fondos Efectivo';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;Round(TotalNetoCli1, 2)<>0;;Cuenta2;;2
FechaOp ;Vehiculo1;Especie      ;;;;;Vehiculo1;2;+Cantidad;;'Suscripcion de Fondos';SI;SI;;Round(TotalNetoCli1, 2)<>0 Y Cantidad>0;;Cuenta1;;;;;;;;;Book1;

FechaOp ;Vehiculo1;ContraEspecie;;;;;Vehiculo1;50;-TotalNetoCli1;;'Suscripcion de Fondos '~ESPECIE';SI;SI;;;;'CAJA';;10;;;;;;;Book1;;;;;;;


POSICION
FechaOp;Vehiculo1;Especie;;;;Vehiculo1;;;;;101;Cantidad;Precio1;;;Book1;;'FC'

FechaOp;Vehiculo1;Especie;;;;Vehiculo1;;;;;121;Cantidad;Precio1*if(EqStr(ContraEspecie,VTXT40),1,COTIZACIONC(CONTRAESPECIE,,,,FECHAOP-1,1,SI,VTXT40));;;BOOK1;;'FC';
FechaOp;Vehiculo1;Especie;;;;Vehiculo1;;;;;131;Cantidad;Precio1*if(EqStr(ContraEspecie,Var('MONEEXTR')),1,COTIZACIONC(CONTRAESPECIE,,,,FECHAOP-1,1,SI,Var('MONEEXTR')));;;BOOK1;;'FC';

FechaOp;Vehiculo1;ContraEspecie;;;;Vehiculo1;;;;;122;-TotalNetoCli1;COTIZACIONC(CONTRAESPECIE,,,,FECHAOP-1,1,SI,VTXT40);;;VTXT19;;'FXS'; NOT Incluido(ContraEspecie, VTXT40~'|'~Var('MONEEXTR')) y CB7=0;
FechaOp;Vehiculo1;ContraEspecie;;;;Vehiculo1;;;;;132;-TotalNetoCli1;COTIZACIONC(CONTRAESPECIE,,,,FECHAOP-1,1,SI,Var('MONEEXTR'));;;VTXT19;;'FXS';NOT Incluido(ContraEspecie, VTXT40~'|'~Var('MONEEXTR')) y CB7=0;

POSICION2
FechaOp;Vehiculo1;Book1;'FC';Especie;'0';1;ContraEspecie;Cantidad;Precio1;0;'1';
FechaVto;Vehiculo1;Book1;'FC';Especie;'0';2;ContraEspecie;Cantidad;Precio1;0;'1';CB15=1

POSTEDICION
CB7=1 y Incluido(ABM,'A|E');'DIVFON';Radio2=0;NrOperacion1=NROPERACION;Radio1=0;Fecha1=FECHAOP;Check1=1
CB7=1 y Incluido(ABM,'D');'DIVFON';Radio2=0;NrOperacion1=NROPERACION;Radio1=1;Fecha1=FECHAOP;Check1=1
RB7=1;'DECFCI';NrOperacion1=NROPERACION;

LIMITES
FechaVto;Cliente1;'COTOR';VTXT6;; VCAN8;TipoOp~' '~Especie;RB15=1 Y NoVacio(Cliente1);;;;;;;;Especie;;;

