CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp2        : 'Fecha Conc.'                ;1;1 ; ;VERIFICAACCESO('OPFVALOR');;FECHAOP2<=FECHAOP;'Fecha incorrecta';NO;FSYS;
FechaOp         : 'Fecha_Origen'               ;2;1 ;;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1);'Fecha de Origen Incorrecta';RB11 = 0;FSYS;
@VEHITO
Operador        :                              ; ;2 ;;;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
Cliente1        : 'Entidad'                    ;3;1 ;;NOT EV;;NOVACIO(CLIENTE1) Y DESCIENDEDECLIENTE(CLIENTE1,'BLOCAL');'La Entidad Contratante DEBE SER UN BANCO LOCAL';NO;;
Observac2       : 'Op.Contraparte'             ;3;2 ;;;;NOVACIO(OBSERVAC2);'El Operador CONTRAPARTE es INVALIDO';SI;;;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
Especie         : 'Moneda'                     ; ;1 ;;NOT EV;;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'Debe Ingresar una Moneda';NO;;;;'ARP|USD|'
Cantidad        : 'Valor Nominal'              ; ;1 ;;NOT EV;;CANTIDAD>0;'El Valor Nominal DEBE SER POSITIVO';NO;;;;;;'###,###,###,###,###.##'
Plazo           : 'Plazo V.N.'                 ; ;  ;;;;PLAZO>0;'Debe INGRESAR el PLAZO';NO;0;FECHAVTO-FECHAOP
FechaVto        : 'Vto. V.N.'                  ; ;  ;;NO;;ESHABIL(FECHAVTO,TABLAFERIADOS1);'La Fecha de Vencimiento NO ES DIA HABIL';RB11 = 0;FECHAOP+PLAZO;FECHAOP+PLAZO
TipoTasa        : 'Tipo_Tasa'                  ;4;2 ;;;;NOVACIO(TIPOTASA);'El Tipo de Tasa ES INVALIDO';NO;'FIJA';
Precio1         : 'Tasa (%)'                   ;5;2 ;;;;PRECIO1>0;'La Tasa Debe ser positiva';NO;
Spread          :                              ; ;2 ;;NOT EQSTR(TIPOTASA,'FIJA');NOT EQSTR(TIPOTASA,'FIJA');SPREAD>=0;'El SPREAD Debe SER POSITIVO';NO;0;
Plazo2          : 'Plazo Interes'              ; ;  ;;;;PLAZO2>=PLAZO Y PLAZO2<=60;'El Plazo de Interes no puede ser inferior al Plazo del Capital y NO DEBE SUPERAR los 60 Dias';NO;0;FECHAPAGO-FECHAOP
FechaPago       : 'Vto.Interes'                ; ;  ;;NO;;ESHABIL(FECHAPAGO,TABLAFERIADOS1);'La Fecha de Vto. del Interes NO ES DIA HABIL';NO;FECHAOP;FECHAOP+PLAZO2
TotalIntereses  : 'Interes'                    ;10;1;;EV;;NOT EV o [TotalIntereses<= ROUND(VCAN7*(1+Var('PORVAR')/100),2) y TotalIntereses >= ROUND(VCAN7*(1-Var('PORVAR')/100),2)];'Interes Fuera de Rango: '~FSTR(ROUND(VCAN7*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN7*(1+Var('PORVAR')/100),2),0,2);NO;;CANTIDAD*(SPREAD+PRECIO1)*PLAZO/IF(RB8=1,36500,36000);;;;;'###,###,###,###,###.##'
ImpGastos1      : 'Alicuota Imp.'              ; ;  ;;EQSTR(ESPECIE,'ARP');EQSTR(ESPECIE,'ARP');[NOT EQSTR(ESPECIE,'ARP')] O [EQSTR(ESPECIE,'ARP') Y IMPGASTOS1>=0];'La Alicuota Impuesto  DEBE SER POSITIVA';NO;VAR('ALICIMPU')
TotalRetenciones: 'Imp.Impuesto'               ; ;  ;;EV;EQSTR(ESPECIE,'ARP');NOT EV o [TotalRetenciones<= ROUND(VCAN6*(1+Var('PORVAR')/100),2) y TotalRetenciones>= ROUND(VCAN6*(1-Var('PORVAR')/100),2)];'Importe Impuesto Fuera de Rango: '~FSTR(ROUND(VCAN6*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN6*(1+Var('PORVAR')/100),2),0,2);NO;;IF(EQSTR(ESPECIE,'ARP'),TOTALINTERESES*IMPGASTOS1/100,0);;;;;'###,###,###,###,###.##'
TotalNetoCli2   : 'Interes Neto'               ; ;  ;;NO;;;;;;TOTALINTERESES-TOTALRETENCIONES;
RB8             : 'U.Tiempo|360|365'           ;10;2;;;;RB8>=0;'Unidad de Tiempo Tasa Interes INVALIDA';NO;1;
Precio4         : 'Tasa_T_Neta'                ; ;2 ;;NO;PRECIO4>0;;;;;
TablaFeriados1  : 'Feriados'                   ; ;  ;;;;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;VAR('FERIADODEF')
OperacionRef    : 'Op_Referencia'              ; ;  ;;;;;;;
RB3             : 'MOF'                        ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa         : 'Modificado'                 ;10;3;;NO;NO;;;;0

DeltaTasa       : '%Imp.DB/CR'                 ;15;1;;;;[Incluido(Fstr(DELTATASA,2,2),VAR('IMPCHEQUE'))];'El Valor de TASA Impuesto CHEQUE Es Erroneo: '~VAR('IMPCHEQUE')~' ...';NO;0;;;;;;'###,###.######'
PeriodoInts     : 'Imp.DB/CR'                  ;  ; ;;EV;;NOT EV o [PERIODOINTS   <= ROUND(VPRE3*(1+Var('PORVAR')/100),2) y PERIODOINTS>= ROUND(VPRE3*(1-Var('PORVAR')/100),2)];'Impuesto al Cheque CR Fuera de Rango: '~FSTR(ROUND(VPRE3*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VPRE3*(1+Var('PORVAR')/100),2),0,2);NO;;CANTIDAD*(DELTATASA/100);;;;;'###,###,###,###,###.##'
VPRE3           : 'Imp_Cheque CR'              ;  ; ;;NO;NO;;;;;CANTIDAD*(DELTATASA/100);;;;;'###,###,###,###,###.##'

Cotizacion1     : 'TC_Concert.'                ;1;1 ;2;;Not Eqstr(ESPECIE,VAR('MONEEXTR'));Eqstr(ESPECIE,VAR('MONEEXTR')) O [COTIZACION1<=VPRE1*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE1*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE1*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE1*(1+VAR('RPRECIO2')/100),1,7);NO;1;IF(Eqstr(ESPECIE,VAR('MONEEXTR')),1)
Cotizacion2     : 'TC_Vencim.'                 ; ;  ;;COTIZACION2<>0;COTIZACION2<>0;;;;

RB11            : 'Ajuste|NO|SI'               ;5;1;2;;NO;;;;0;

VPRE1           : 'Cot.TC/USD'                 ;10;2; ;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(ESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)
VCAN6           : 'IMP MOD'                    ;18;1;2;NO;NO;;;;;IF(EQSTR(ESPECIE,'ARP'),TOTALINTERESES*IMPGASTOS1/100,0)
VCAN7           : 'INTERES MOD'                ;18;1;2;NO;NO;;;;;CANTIDAD*(SPREAD+PRECIO1)*PLAZO/IF(RB8=1,36500,36000)
VCAN8           : 'Equivalente USD'            ;17;2;2;NO;NO;;;;;if(EqStr(ESPECIE,VTXT6),CANTIDAD+TOTALINTERESES,(CANTIDAD+TOTALINTERESES)*COTIZACIONC(ESPECIE,,,,Fsys,1,SI,VTXT6))
VCAN9           : 'Total Consumido'            ;16;2;2;NO;NO;;;;;VCAN10+LIMCONSUMIDO(CLIENTE1,'COTOR',VTXT6,0,,,,NROPERACION)
VCAN10          : 'Capital  USD'               ;17;2;2;NO;NO;;;;;if(EqStr(ESPECIE,VTXT6),CANTIDAD,CANTIDAD*COTIZACIONC(ESPECIE,,,,Fsys,1,SI,VTXT6))
VTXT6           : 'EspecieLimiteSett'          ; 1;2;2;NO;NO;;;;;QUERY("SELECT Especie FROM "~DBO~".LIMASIGNADOS WHERE Cliente='"~CLIENTE1~"' AND Limite='COTOR' ")
PrecioMer       : 'Monto USD WF'               ;17;2;2;NO;NO;;;;VCAN8;VCAN8

VTXT18            : 'Book Def'    ; 1;2;2;NO;NO;;;;;BuscarCampo('VEHICULOS','Alias5','Codigo',VEHICULO1)
VTXT19            : 'Codigo Book' ; 2;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Codigo','Codigo',VTXT18)
VTXT20            : 'Vehic.Book'  ; 3;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Vehiculo','Codigo',VTXT19)
ContraEspecie    : 'Contraespecie' ;;;;NO;NO;

@CUENTAS
@CTAMONLOC


CONDICIONES
ESHABIL(FECHAOP,'ARG');'La Fecha de Origen NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'CONCINH'
ESHABIL(FECHAVTO,'ARG');'La Fecha de Vencimiento NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'VTOINH'
ESHABIL(FECHAPAGO,'ARG');'La Fecha de Vencimiento del Interes NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'VTOINTINH'
PRECIO1<=VAR('RTASA2') Y PRECIO1>=VAR('RTASA1');'Tasa Fuera de Rango:'~VAR('RTASA1')~" Y "~VAR('RTASA2');SI;SI;FSYS;'RTASA'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'El Cliente esta Observado';SI;SI;FSYS;'CLIOBS'
VACIO(OPERACIONREF) O [EQSTR(TIPOOP,BuscarCampo('Operaciones','TipoOp','NrOperacion',OPERACIONREF)) y BuscarCampo('Operaciones','FechaVto','NrOperacion',OPERACIONREF)=Fsys y EQSTR(BuscarCampo('Operaciones','Vehiculo1','NrOperacion',OPERACIONREF),VEHICULO1) y EQSTR(ESPECIE,BuscarCampo('Operaciones','Especie','NrOperacion',OPERACIONREF))];'La Operacion de Referencia es INVALIDA';NO
Incluido(Fstr(IMPGASTOS1,2,2),VAR('LISTIMPU'));'El Valor de la Alicuota Impuesto es Erroneo: '~VAR('LISTIMPU')~' ...';NO
EQSTR(TIPOTASA,'FIJA') O [SPREAD>=VAR('RSPREAD1') Y SPREAD<=VAR('RSPREAD2')];'El Spread esta Fuera de Rango '~VAR('RSPREAD1')~' '~VAR('RSPREAD2');NO
SI Y [PRECIO4<=VAR('RTTN2') Y PRECIO4>=VAR('RTTN1')];'Tasa Total Neta Fuera de Rango:'~VAR('RTTN1')~" Y "~VAR('RTTN2');SI
FECHAOP2=Fsys;'La Fecha de Concertacion no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
[NOT NOVACIO(CLIENTE1)] o ExisteLimite('COTOR',Cliente1,VTXT6)                                                   ; 'Lim.Credito no asignado'                                                                ;NO;SI;FSYS;'COTORNOAS'
[NOT NOVACIO(CLIENTE1)] o Not ExisteLimite('COTOR',Cliente1,VTXT6) o VtoLimite('COTOR',Cliente1,VTXT6) >= FechaOp; 'Lim.Credito vencido el '~FECHA(VtoLimite('COTOR',Cliente1,VTXT6))                       ;NO;SI;FSYS;'COTORVENC'
[NOT NOVACIO(CLIENTE1)] o LimAsignado(Cliente1,'COTOR',VTXT6) >= VCAN9                                           ; 'Lim.Credito excedido '~PYC(-(LimAsignado(Cliente1,'COTOR',VTXT6)-VCAN9),1,0)~'.-';NO;SI;FSYS;'COTOREXCE'

@CONDIOP

SI O Incluido(Especie,'ARP|USD') o NoVacio(VTXT18);'El Vehiculo no tiene Book Default para Monedas';NO
SI O Incluido(Especie,'ARP|USD') o NoVacio(VTXT19);'El Book default '~VTXT18~' no es valido';NO
SI O Incluido(Especie,'ARP|USD') o EqStr(VTXT20,Vehiculo1);'El Book default '~VTXT18~' corresponde a otro vehiculo';NO

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

SQL
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('COTORNOAS','COTORVENC','COTOREXCE','SETTLENOAS','SETTLEVENC','SETTLECANC') ";EqStr(ABM,'E')
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('SETTLEEXCE','CONTNOAS','CONTVENC','CONTCANC','CONTEXCE')";EqStr(ABM,'E')

POSTEDICION
@POSTEMM


MOVIMIENTOS
FechaOp  ;Cliente1;Especie ;;;;;Vehiculo1;1;Cantidad;;'Alta Deposito en C.A.(Retiro del Vehiculo)';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;1;
FechaVto ;Cliente1;Especie ;;;;;Vehiculo1;1;-Cantidad;;'Vto.Cap. Deposito en Caja de Ahorro';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;2;;;;;;;;;;;;;;600
FechaPago;Cliente1;Especie ;;;;;Vehiculo1;1;-TotalIntereses;;'Vto.Interes Deposito en Caja de Ahorro';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;3;
FechaPago;Cliente1;VAR('MONELOCA') ;;;;;Vehiculo1;1; TotalRetenciones;;'Vto.Impuestos Deposito en Caja de Ahorro';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;TotalRetenciones<>0;;Cuenta3;;4;
FechaOp  ;Cliente1;Especie ;;;;;Vehiculo1;1; PeriodoInts             ;;'Imp.DB/CR'              ;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;PeriodoInts<>0     ;;Cuenta1;;5;


LIMITES
FechaOp2                           ;Cliente1;'COTOR';VTXT6;; VCAN8         ;TipoOp~' '~Especie;NoVacio(Cliente1);
Habiles(FechaVto ,1,TablaFeriados1);Cliente1;'COTOR';VTXT6;;-VCAN10        ;TipoOp~' '~Especie;RB15=1 Y NoVacio(Cliente1) y Incluido(Vehiculo1,Var('VLIQUIDAA'));
Habiles(FechaPago,1,TablaFeriados1);Cliente1;'COTOR';VTXT6;;-(VCAN8-VCAN10);TipoOp~' '~Especie;RB15=1 Y NoVacio(Cliente1) y Incluido(Vehiculo1,Var('VLIQUIDAA'));
FechaVto                           ;Cliente1;'COTOR';VTXT6;;-VCAN10        ;TipoOp~' '~Especie;RB15=1 Y NoVacio(Cliente1) y Not Incluido(Vehiculo1,Var('VLIQUIDAA')) y Not EqStr(BuscarCampo('CLIENTES','Alias10','Codigo',CLIENTE1),'LIMITELIQ');

@INSTOPE
@INST19MM
@INST19BITS
