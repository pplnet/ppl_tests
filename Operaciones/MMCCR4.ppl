Observac2       : 'Op.Contraparte'             ;5;2;;;;NoVacio(OBSERVAC2);'El Operador CONTRAPARTE es INVALIDO';SI;;;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
Especie         : 'Moneda'                     ;6;1;;NOT EV Y VACIO(OPERACIONREF);;NoVacio(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'Debe Ingresar una Moneda';NO;VAR('MONELOCA');If(VACIO(OPERACIONREF),ESPECIE,OPREF.ESPECIE);;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";
Cantidad        : 'Importe'                    ;;;;NOT EV;;CANTIDAD>0;'El Valor Nominal DEBE SER POSITIVO';NO;;If(VACIO(OPERACIONREF),CANTIDAD,IF(EqStr(CAMPOMODIFICADO,'CANTIDAD'),CANTIDAD,OPREF.CANTIDAD));;;;;'###,###,###,###,###.##'
