TotalIntereses  : 'Interes'                    ;;;;EV;;NOT EV o [TotalIntereses <= ROUND(VCAN7*(1+Var('PORVAR')/100),2) y TotalIntereses >= ROUND(VCAN7*(1-Var('PORVAR')/100),2)];'Interes Fuera de Rango: '~FSTR(ROUND(VCAN7*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN7*(1+Var('PORVAR')/100),2),0,2);NO;;(CANTIDAD-PERIODOINTS)*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000);;;;;'###,###,###,###,###.##'

ImpGastos1      : '%Ret.Gan'                   ;;;;Incluido(ESPECIE,VAR('MONDCCR'));Incluido(ESPECIE,VAR('MONDCCR'));[NOT Incluido(ESPECIE,VAR('MONDCCR'))] O [Incluido(ESPECIE,VAR('MONDCCR')) Y IMPGASTOS1>=0];'La Alicuota Impuesto  DEBE SER POSITIVA';NO;VAR('ALICIMPU')
TotalRetenciones: 'Ret. Gan'                   ;;;;EV;Incluido(ESPECIE,VAR('MONDCCR'));NOT EV o [TotalRetenciones<= ROUND(VCAN6*(1+Var('PORVAR')/100),2) y TotalRetenciones>= ROUND(VCAN6*(1-Var('PORVAR')/100),2)];'Importe Impuesto Fuera de Rango: '~FSTR(ROUND(VCAN6*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN6*(1+Var('PORVAR')/100),2),0,2);NO;;IF(Incluido(ESPECIE,VAR('MONDCCR')),TOTALINTERESES*IMPGASTOS1/100,0);;;;;'###,###,###,###,###.##'

DeltaTasa       : '%Imp.DB/CR'                ;;;;;;[Incluido(Fstr(DELTATASA,2,2),VAR('IMPCHEQUE'))];'El Valor de TASA Impuesto CHEQUE Es Erroneo: '~VAR('IMPCHEQUE')~' ...';NO;0;;;;;;'###,###.######'
PeriodoInts     : 'Imp.DB/CR'                 ;;;;EV;;NOT EV o [PERIODOINTS   <= ROUND(VPRE3*(1+Var('PORVAR')/100),2) y PERIODOINTS>= ROUND(VPRE3*(1-Var('PORVAR')/100),2)];'Impuesto al Cheque CR Fuera de Rango: '~FSTR(ROUND(VPRE3*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VPRE3*(1+Var('PORVAR')/100),2),0,2);NO;;IF(CANTIDAD-OPREF.CANTIDAD>0,(CANTIDAD-OPREF.CANTIDAD)*(DELTATASA/100),0);;;;;'###,###,###,###,###.##'
