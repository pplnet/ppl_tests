FechaPago;Cliente1;Especie;;;;;Vehiculo1;1;-TotalIntereses  ;;'Vto Int '~TIPOOP;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;CB1=0;;Cuenta1;;3;

