CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp2        : 'Fecha Conc.'                ; 1;1; ;VERIFICAACCESO('OPFVALOR');;FECHAOP2<=FECHAOP;'Fecha incorrecta';NO;FSYS;
FechaOp         : 'Fecha_Origen'               ; 2;1; ;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1);'Fecha de Origen Incorrecta';RB11 = 0;FSYS;
@VEHITO
Operador        :                              ;  ;2; ;NO;  ;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
Cliente1        : 'Entidad'                    ; 3;1; ;NOT EV;;NOVACIO(CLIENTE1);'La Entidad Contratante ES INCORRECTA';NO;;;;;;;;"Status = 'HAB'";;;;
Cliente2        : 'Garante'                    ; 3;2; ;NOT EV;;DESCIENDEDECLIENTE(CLIENTE2,'GARANTES');'DEBE INGRESAR UN GARANTE';NO;;;;;;;;"Status = 'HAB' and Jerarquia Like '"~Jerarquia('CLIENTES','GARANTES')~"%' and SubString(Jerarquia,4,3) <> '000' "
Observac2       : 'Op.Contraparte'             ; 4;2; ;  ;  ;NOVACIO(OBSERVAC2);'Operador Contraparte Invalido';SI;;;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
Especie         : 'Moneda'                     ;  ;1; ;NOT EV;;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'Debe Ingresar una Moneda ';NO;;;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";
Cantidad        : 'Valor Nominal'              ;  ;1; ;NOT EV;;CANTIDAD>0;'El Valor Nominal DEBE SER POSITIVO';NO;;;;;;;'###,###,###,###,###.##'
Plazo           : 'Plazo'                      ;  ; ; ;  ;  ;PLAZO>0;'Debe INGRESAR el PLAZO';NO;0;
FechaVto        : 'Fecha_Vto'                  ;  ; ; ;NO;  ;ESHABIL(FECHAVTO,TABLAFERIADOS1);'La Fecha de Vencimiento NO ES DIA HABIL';RB11 = 0;FECHAOP;FECHAOP+PLAZO
RB8             : 'U.Tiempo|360|365'           ;  ; ; ;  ;  ;RB8>=0;'Unidad de Tiempo Tasa Interes INVALIDA';NO;IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),1,0);IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),1,0)
ImpGastos1      : '%Ret.Gan.'                  ;  ; ; ;DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));;;;IF(DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),VAR('ALICIMPU'),0);IF(DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),VAR('ALICIMPU'),0)
ImpGastos2      : 'Tasa IVA'                   ;  ; ; ;NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));;;;;;;;;;'###,###.######'
TotalAux2       : '%Perc_Iva'                  ;  ; ; ;  ;NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));TOTALAUX2=VAR('RG3337') O TOTALAUX2=0;'Tasa de Percepcion Iva Invalida!!';NO;VAR('RG3337');;;;;;'###,###.######'
TipoTasa        : 'Tipo_Tasa'                  ; 5;2; ;  ;  ;NOVACIO(TIPOTASA);'El Tipo de Tasa ES INVALIDO';NO;'FIJA';

Precio1         : 'Tasa'                       ; 6;2; ;EQSTR(TIPOTASA,'FIJA');EQSTR(TIPOTASA,'FIJA');PRECIO1>=0;'La Tasa debe SER POSITIVA';NO;0;;;;;;;'###,###.######'

Spread          :                              ; 6;2; ;NOT EQSTR(TIPOTASA,'FIJA');NOT EQSTR(TIPOTASA,'FIJA');SPREAD>=0;'El SPREAD Debe SER POSITIVO';NO;0;
Plazo4          : 'Dias Seteo Tasa'            ; 7;2; ;;NOT EQSTR(TIPOTASA,'FIJA') y NOVACIO(TIPOTASA)];[PLAZO4>=0] O [EQSTR(TIPOTASA,'FIJA')];'Indique la Cantidad de Dias Previos al Inicio para Setear la Tasa';NO;;
RB16            : 'Setea|InicioPer|FinPer'     ; 8;2; ;;NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA);RB16=0 O RB16=1 O [EQSTR(TIPOTASA,'FIJA') o VACIO(TIPOTASA)];'Indique Inicio o Fin de Periodo';NO;
TablaFeriados1  : 'Feriados'                   ;10; ; ;  ;  ;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO; IF(NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),'USA',IF(DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y NOT EQSTR(ESPECIE,'ARP'),'USD','ARG'));IF(NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),'USA',IF(DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y NOT EQSTR(ESPECIE,'ARP'),'USA','ARG'))
OperacionRef    : 'Op_Referencia'              ;  ; ; ;  ;  ;;;;
Cuotas1         : 'Nr_Periodos'                ;  ; ; ;  ;  ;CUOTAS1>=1;'Debe INGRESAR la Cantidad DE PERIODOS';NO;0;;
PlazoGracia     : 'Plazo_Gracia'               ;  ; ; ;  ;NO;PLAZOGRACIA>=0 Y PLAZOGRACIA<=CUOTAS1;'Plazo de Gracia >=0 y <= '~CUOTAS1;NO;1;

DeltaTasa       : '%Imp.DB/CR'                 ;  ; ; ;  ;  ;[Incluido(Fstr(DELTATASA,2,2),VAR('IMPCHEQUE'))];'El Valor de TASA Impuesto CHEQUE Es Erroneo: '~VAR('IMPCHEQUE')~' ...';NO;0;;;;;;'###,###.######'
PeriodoInts     : 'Imp.DB/CR'                  ;  ; ; ;EV;;NOT EV o [PERIODOINTS   <= ROUND(VPRE3*(1+Var('PORVAR')/100),2) y PERIODOINTS>= ROUND(VPRE3*(1-Var('PORVAR')/100),2)];'Impuesto al Cheque CR Fuera de Rango: '~FSTR(ROUND(VPRE3*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VPRE3*(1+Var('PORVAR')/100),2),0,2);NO;;CANTIDAD*(DELTATASA/100);;;;;'###,###,###,###,###.##'
VPRE3           : 'Imp_Cheque CR'              ;  ; ; ;NO;NO;;;;;CANTIDAD*(DELTATASA/100);;;;;'###,###,###,###,###.##'
RB7             : 'Convenio|NO|SI'             ;13;1; ;NO;NO;RB7 >= 0;'Debe Indicar si es Convenio';NO;0

RB3             : 'MOF'                        ;10;2; ;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa         : 'Modificado'                 ;10;3; ;NO;NO;;;;0

Cotizacion1     : 'TC_Concert.'                ; 1;1;2;;Not Eqstr(ESPECIE,VAR('MONEEXTR'));Eqstr(ESPECIE,VAR('MONEEXTR')) O [COTIZACION1<=VPRE1*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE1*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE1*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE1*(1+VAR('RPRECIO2')/100),1,7);NO;;IF(Eqstr(ESPECIE,VAR('MONEEXTR')),1)
Cotizacion2     : 'TC_Vencim.'                 ;  ;1;2;COTIZACION2<>0;COTIZACION2<>0;;;;
RB11            : 'Ajuste|NO|SI'               ;5;1;2;;NO;;;;0;

VPRE1           : 'Cot.TC/USD'                 ;10;2; ;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(ESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)
VCAN8           : 'Equivalente USD'            ;10;2;2;NO;NO;;;;;if(EqStr(ESPECIE,VTXT6),CANTIDAD+SUM(CUOTASL,8),(CANTIDAD+SUM(CUOTASL,8))*COTIZACIONC(ESPECIE,,,,Fsys,1,SI,VTXT6))
VCAN6           : 'Interes'                    ;11;2;2;NO;NO;;;;;SUM(CUOTASL,8)
VCAN7           : 'Total Consumido'            ;10;2;2;NO;NO;;;;;VCAN10+LIMCONSUMIDO(CLIENTE1,'COTOR',VTXT6,0,,,,NROPERACION)
VCAN10          : 'Capital  USD'               ;10;2;2;NO;NO;;;;;if(EqStr(ESPECIE,VTXT6),CANTIDAD,CANTIDAD*COTIZACIONC(ESPECIE,,,,Fsys,1,SI,VTXT6))
RB9             : 'Alic imp|Si|No'             ;10;2;2;NO;NO;;;;if(DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),0,1);
VTXT6           : 'EspecieLimiteSett'          ; 1;2;2;NO;NO;;;;;QUERY("SELECT Especie FROM "~DBO~".LIMASIGNADOS WHERE Cliente='"~CLIENTE1~"' AND Limite='COTOR' ")
PrecioMer       : 'Monto USD WF'               ;17;2;2;NO;NO;;;;CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'));CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))

VTXT18            : 'Book Def'    ; 1;2;2;NO;NO;;;;;BuscarCampo('VEHICULOS','Alias5','Codigo',VEHICULO1)
VTXT19            : 'Codigo Book' ; 2;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Codigo','Codigo',VTXT18)
VTXT20            : 'Vehic.Book'  ; 3;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Vehiculo','Codigo',VTXT19)

ContraEspecie    : 'Contraespecie' ;;;;NO;NO;
MB3            : 'Tipo|Pasiva|Activo'         ;15;1;1;NO;NO;;;;IF(Incluido(TIPOOP,VAR('OPEACT')),1,0);IF(Incluido(TIPOOP,VAR('OPEACT')),1,0)

@CUENTAS
@CTAMONLOC
@INDICE
@RANGOTASA


LISTA:SI;IF(ESINICIO,100,CUOTAS1);
  Tasa1    : 'Tasa Amort'     ;NOT EV;  ;CUOTASL.TASA1[Fila]>=0;'La Tasa de Amortizacion debe SER POSITIVA';100/CUOTAS1;CUOTASL.CANTIDAD1[Fila]*100/CANTIDAD;100;  ;Numero;'###,###.######';NO;NO;'2';
  Cantidad1: 'Imp Amort'      ;NOT EV;  ;CUOTASL.CANTIDAD1[Fila]>=0;'El Importe Amortizacion debe SER POSITIVO';CANTIDAD*(100/CUOTAS1)/100;CANTIDAD*CUOTASL.TASA1[Fila]/100;200;;Numero;'###,###,###,###,###.##';NO;NO;'1';
  Plazo1   : 'Plazo'          ;      ;  ;[CUOTASL.PLAZO1[Fila]>0 Y NOT [DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1))]] O [CUOTASL.PLAZO1[Fila]> 0 Y DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1))] ;'El Plazo del Periodo Debe ser Positivo';IF(Fila=CUOTAS1 Y (PLAZO MOD CUOTAS1)<>0,(PLAZO DIV CUOTAS1)+(PLAZO MOD CUOTAS1),(PLAZO DIV CUOTAS1));; 60;  ;Numero;'####'

  Fecha1   : 'F.Origen'       ;NO    ;  ;ESHABIL(CUOTASL.FECHA1[Fila],TABLAFERIADOS1) Y ESHABIL(CUOTASL.FECHA1[Fila],'ARG');'La Fecha Origen de la Cuota '~Fstr(Fila, 0, 0)~' No es HABIL';IF(Fila=1,FECHAOP,CUOTASL.FECHA2[Fila-1]);IF(Fila=1,FECHAOP,CUOTASL.FECHA2[Fila-1]);90;;Fecha;;;;;;;;RB11 = 0
  Fecha2   : 'F.Vto'          ;NO    ;  ;ESHABIL(CUOTASL.FECHA2[Fila],TABLAFERIADOS1) Y ESHABIL(CUOTASL.FECHA2[Fila],'ARG');'El Vencimiento de la Cuota '~Fstr(Fila, 0, 0)~' No es HABIL';IF(Fila=CUOTAS1,FECHAVTO,CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila]);IF(Fila=CUOTAS1,FECHAVTO,CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila]);90;;Fecha;;;;;;;;RB11 = 0
  Cantidad2: 'V.Nominal'      ;NO    ;  ;CUOTASL.CANTIDAD2[Fila]>=0;'El Valor Nominal debe SER POSITIVO';;IF(Fila=1,CANTIDAD,CUOTASL.CANTIDAD2[Fila-1]-CUOTASL.CANTIDAD1[Fila-1]);200;  ;Numero;'###,###,###,###,###.##'
  Precio2  : 'Tasa Interes'   ;      ;  ;[FILA>1 Y CUOTASL.PRECIO2[Fila]>=0] O [Fila=1 Y CUOTASL.PRECIO2[Fila]>=0 Y NOT EQSTR(TIPOTASA,'FIJA') Y RB16 = 1] O [Fila=1 Y CUOTASL.PRECIO2[Fila]>0];'TASA INVALIDA O FALTA TASA';;IF(EQSTR(TIPOTASA,'FIJA'),PRECIO1,CUOTASL.PRECIO2[Fila]);100;  ;Numero;'###,###.######';NO;SI;'8';

  Cantidad5: 'Imp. IVA'       ;EV    ;  ;NOT EV o [[ROUND(CuotasL.Cantidad5[Fila],2) <= ROUND((CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CuotasL.Cantidad5[Fila],2) >= ROUND((CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe IVA Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),CUOTASL.CANTIDAD3[Fila]*IMPGASTOS2/100,0);200;NO;Numero;'###,###,###,###,###.##';NO;NO
  Cantidad3: 'Imp Interes'    ;EV    ;  ;NOT EV o [[ROUND(CUOTASL.CANTIDAD3[Fila],2) <= ROUND((CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.CANTIDAD3[Fila],2) >= ROUND((CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100)),2)]];'Interes Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(Fila<PlazoGracia,0,(CUOTASL.CANTIDAD2[Fila]*(SPREAD+CUOTASL.PRECIO2[Fila])*CUOTASL.PLAZO1[Fila])/IF(RB8=0,36000,36500));200;NO;Numero;'###,###,###,###,###.##';NO;NO;'7';
  Total5   : 'Imp_Perc_IVA'   ;EV    ;  ;NOT EV o [[ROUND(CuotasL.Total5[Fila],2)    <= ROUND((CUOTASL.PRECIO7[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CuotasL.Total5[Fila],2)    >= ROUND((CUOTASL.PRECIO7[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe Perc. IVA Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO7[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO7[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),CUOTASL.CANTIDAD3[Fila]*TOTALAUX2/100,0);200;NO;Numero;'###,###,###,###,###.##';NO;NO
  Cantidad6: 'Imp_Neto_IVA'   ;NO    ;  ;;;;IF(NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),CUOTASL.CANTIDAD5[Fila]+CUOTASL.TOTAL5[Fila],0);200;  ;Numero;'###,###,###,###,###.##'
  Cantidad4: 'Ret.Gan'        ;EV    ;  ;NOT EV o [[ROUND(CuotasL.Cantidad4[Fila],2) <= ROUND((CUOTASL.PRECIO8[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CuotasL.Cantidad4[Fila],2) >= ROUND((CUOTASL.PRECIO8[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe Impuesto Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO8[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO8[Fila]*(1+Var('PORVAR')/100),2),0,2) ;;IF(DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),CUOTASL.CANTIDAD3[Fila]*IMPGASTOS1/100,0);200;NO;Numero;'###,###,###,###,###.##';NO;NO
  Total3   : 'Imp.Int.Neto'   ;NO    ;  ;;;;CUOTASL.CANTIDAD3[Fila]-CUOTASL.CANTIDAD4[Fila]  ;200;  ;Numero;'###,###,###,###,###.##'
  Total2   : 'Monto'          ;NO    ;  ;;;;(CUOTASL.CANTIDAD1[Fila]+CUOTASL.CANTIDAD3[Fila]);200;  ;Numero;'###,###,###,###,###.##'
  Total1   : 'Monto Neto'     ;NO    ;  ;;;;(CUOTASL.TOTAL2[Fila]-CUOTASL.CANTIDAD4[Fila])   ;200;  ;Numero;'###,###,###,###,###.##'
  Precio4  : 'Tasa T.Neta'    ;NO    ;  ;SI Y [CUOTASL.Precio4[Fila]<=VAR('RTTN2') Y CUOTASL.Precio4[Fila]>=VAR('RTTN1')];'Tasa Total Neta Fuera de Rango:'~VAR('RTTN1')~" Y "~VAR('RTTN2');;;200;;Numero;'###.######';NO;NO;
  Precio6  : 'MOD IVA'        ;NO    ;NO;;;;IF(NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),CUOTASL.CANTIDAD3[Fila]*IMPGASTOS2/100,0);200;;Numero;'###.######'
  Precio5  : 'MOD INT'        ;NO    ;NO;;;;IF(Fila<PlazoGracia,0,(CUOTASL.CANTIDAD2[Fila]*(SPREAD+CUOTASL.PRECIO2[Fila])*CUOTASL.PLAZO1[Fila])/IF(RB8=0,36000,36500));200;;Numero;'###.######'
  Precio7  : 'MOD I P IVA'    ;NO    ;NO;;;;IF(NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),CUOTASL.CANTIDAD3[Fila]*TOTALAUX2/100,0);200;;Numero;'###.######'
  Precio8  : 'MOD IMP'        ;NO    ;NO;;;;IF(DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),CUOTASL.CANTIDAD3[Fila]*IMPGASTOS1/100,0);200;;Numero;'###.######'
  *Fecha4   : 'F.Reset'        ;NO    ;NOT EQSTR(TIPOTASA,'FIJA') y NOVACIO(TIPOTASA)];;;;HABILES(IF(RB16=0,CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila]),-PLAZO4,TABLAFERIADOS1,SI); 90;;Fecha;NO;NO;;;;;;
  Fecha4   : 'F.Reset'        ;NO;NOT EQSTR(TIPOTASA,'FIJA') y NOVACIO(TIPOTASA);;;;HABILES(IF(RB16=0,CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila]),-PLAZO4,TABLAFERIADOS1,SI);90;;Fecha;
  
@INDICECTAS

CONDICIONES
ESHABIL(FECHAOP,'ARG');'La Fecha de Origen no es Dia Habil en Argentina';SI;SI;FSYS;'ORIGINH'
ESHABIL(FECHAVTO,'ARG');'La Fecha de Vencimiento NO ES DIA HABIL en Argentina';SI;SI;FSYS;'VTOINH'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'El Cliente esta Observado';SI;SI;FSYS;'CLIOBS'
[DESCIENDEDECLIENTE(CLIENTE1,'BLOCAL') Y PLAZO>=VAR('PLAZOBLOCA')] O [NOT DESCIENDEDECLIENTE(CLIENTE1,'BLOCAL') Y PLAZO>=0];"El Plazo es Invalido Banco Local>="~VAR('PLAZOBLOCA');NO
VACIO(OPERACIONREF) O [EQSTR(TIPOOP,BuscarCampo('Operaciones','TipoOp','NrOperacion',OPERACIONREF)) y BuscarCampo('Operaciones','FechaVto','NrOperacion',OPERACIONREF)=Fsys y EQSTR(BuscarCampo('Operaciones','Vehiculo1','NrOperacion',OPERACIONREF),VEHICULO1) y EQSTR(ESPECIE,BuscarCampo('Operaciones','Especie','NrOperacion',OPERACIONREF))];'La Operacion de Referencia es INVALIDA';NO
SUM(CUOTASL,3)=PLAZO;'La Sumatoria de los Plazos Individuales DEBE SER IGUAL a la del Plazo Total';NO
Not DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') O  Incluido(Fstr(IMPGASTOS1,2,2),VAR('LISTIMPU'));'El Valor de la Alicuota Impuesto es Erroneo: '~VAR('LISTIMPU')~' ...';NO
EQSTR(TIPOTASA,'FIJA') O [SPREAD>=VAR('RSPREAD1') Y SPREAD<=VAR('RSPREAD2')];'El Spread esta Fuera de Rango '~VAR('RSPREAD1')~' '~VAR('RSPREAD2');SI;SI;FSYS;'RANGOSPREAD'
SUM(CUOTASL,1)=100;' La Sumatoria de La Tasa de Amortizacion debe ser el 100%';SI
SI O [[DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) Y IMPGASTOS1>=0] O NOT [DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) Y IMPGASTOS1>=0]];'La Alicuota Impuesto  DEBE SER POSITIVA';NO
[NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) Y INCLUIDO(FSTR(IMPGASTOS2,2,2),VAR('IVA'))] O NOT [NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) Y INCLUIDO(FSTR(IMPGASTOS2,2,2),VAR('IVA'))];"El Valor de TASA IVA es Erroneo: "~VAR('IVA');NO
FECHAOP2=Fsys;'La Fecha de Concertacion no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
[NOT NOVACIO(CLIENTE1)] o ExisteLimite('COTOR',Cliente1,VTXT6); 'Lim.Credito no asignado';SI;SI;FSYS;'COTORNOAS'
[NOT NOVACIO(CLIENTE1)] o Not ExisteLimite('COTOR',Cliente1,VTXT6) o VtoLimite('COTOR',Cliente1,VTXT6) >= FechaOp; 'Lim.Credito vencido el '~FECHA(VtoLimite('COTOR',Cliente1,VTXT6));SI;SI;FSYS;'COTORVENC'
[NOT NOVACIO(CLIENTE1)] o LimAsignado(Cliente1,'COTOR',VTXT6) >= VCAN7; 'Lim.Credito excedido '~PYC(-(LimAsignado(Cliente1,'COTOR',VTXT6)-VCAN7),1,0)~'.-';SI;SI;FSYS;'COTOREXCE'
@CONDIOP

SI O Incluido(Especie,'ARP|USD') o NoVacio(VTXT18);'El Vehiculo no tiene Book Default para Monedas';NO
SI O Incluido(Especie,'ARP|USD') o NoVacio(VTXT19);'El Book default '~VTXT18~' no es valido';NO
SI O Incluido(Especie,'ARP|USD') o EqStr(VTXT20,Vehiculo1);'El Book default '~VTXT18~' corresponde a otro vehiculo';NO

CONDICIONESCUOTAS
SI O [CUOTASL.PRECIO2[Fila]>=VPRE11 Y CUOTASL.PRECIO2[Fila]<=VPRE12];'La Tasa de la Cuota '~Fstr(Fila, 0, 0)~' esta fuera de rango' ;SI;SI;FSYS;'RTASA ';
CUOTASL.PRECIO2[Fila]>=VAR('RTASA1') Y CUOTASL.PRECIO2[Fila]<=VAR('RTASA2');'La Tasa de la Cuota '~Fstr(Fila, 0, 0)~' esta fuera de rango' ;SI;SI;FSYS;'RTASA ';

MOVIMIENTOS
FechaOp ;Cliente1;Especie ;;;;;Vehiculo1;1;Cantidad   ;;'Alta Colocacion a Plazo MV '~ESPECIE;SI;NOt Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;1;
FechaOp ;Cliente1;Especie ;;;;;Vehiculo1;1;PeriodoInts;;'Imp.DB/CR';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;PeriodoInts<>0 ;;Cuenta1;;6;

POSICION
FechaOp  ;Vehiculo1;Especie;;;;Vehiculo1;;;;;122;-Cantidad;COTIZACIONC(ESPECIE,,,,FECHAOP-1,1,SI,'ARP')  ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD');
FechaOp  ;Vehiculo1;Especie;;;;Vehiculo1;;;;;132;-Cantidad;COTIZACIONC(ESPECIE,,,,FECHAOP-1,1,SI,'USD')  ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD');

MOVCUOTAS
CuotasL.Fecha2[Fila];Cliente1 ;Especie;;Vehiculo1;1;-CuotasL.Cantidad3[Fila];'Vto.Interes Colocacion a Plazo MV';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;(Fila+5000);
CuotasL.Fecha2[Fila];Cliente1 ;Especie;;Vehiculo1;1; CuotasL.Cantidad4[Fila];'Vto.Ret.Gan Colocacion a Plazo MV';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;NO Y CuotasL.Cantidad4[Fila]<>0;;Cuenta3;;(Fila+7000);
CuotasL.Fecha2[Fila];Cliente1 ;Especie;;Vehiculo1;1;-CuotasL.Cantidad1[Fila];'Vto.Capital Colocacion a Plazo MV';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;CuotasL.Cantidad1[Fila]<>0;;Cuenta1;;(Fila+500);;;;;;;;;;;;;;600
CuotasL.Fecha2[Fila];Cliente1 ;Especie;;Vehiculo1;1;-CuotasL.Cantidad5[Fila];'Vto. IVA Colocacion a Plazo MV'   ;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;CuotasL.Cantidad5[Fila]<>0 Y NO;;Cuenta1;;(Fila+3*CUOTAS1)+2;

POSCUOTAS
CuotasL.Fecha2[Fila];Vehiculo1;Especie;;;;Vehiculo1;;;;;122; CuotasL.Cantidad1[Fila];COTIZACIONC(ESPECIE,,,,CuotasL.Fecha2[Fila]-1,1,SI,'ARP')  ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD');
CuotasL.Fecha2[Fila];Vehiculo1;Especie;;;;Vehiculo1;;;;;132; CuotasL.Cantidad1[Fila];COTIZACIONC(ESPECIE,,,,CuotasL.Fecha2[Fila]-1,1,SI,'USD')  ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD');
CuotasL.Fecha2[Fila];Vehiculo1;Especie;;;;Vehiculo1;;;;;122; CuotasL.Cantidad3[Fila];COTIZACIONC(ESPECIE,,,,CuotasL.Fecha2[Fila]-1,1,SI,'ARP')  ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD');
CuotasL.Fecha2[Fila];Vehiculo1;Especie;;;;Vehiculo1;;;;;132; CuotasL.Cantidad3[Fila];COTIZACIONC(ESPECIE,,,,CuotasL.Fecha2[Fila]-1,1,SI,'USD')  ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD');

DEVENGADOSCUOTAS
CUOTASL.FECHA1[Fila]+1;CUOTASL.FECHA2[Fila];SI;SI;NO;TablaFeriados1;SI;SI;'INTLEN';CUOTASL.CANTIDAD3[Fila];140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;Fstr(Fila,0,0);Especie;

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

POSTEDICION
@POSTEMM

SQL
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('COTORNOAS','COTORVENC','COTOREXCE','SETTLENOAS','SETTLEVENC','SETTLECANC') ";EqStr(ABM,'E')
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('SETTLEEXCE','CONTNOAS','CONTVENC','CONTCANC','CONTEXCE')";EqStr(ABM,'E')

LIMITES
FechaOp2;Cliente1;'COTOR';VTXT6;; VCAN8;TipoOp~' '~Especie;NoVacio(Cliente1);
Habiles(FechaVto,1,TablaFeriados1);Cliente1;'COTOR';VTXT6;;-VCAN8;TipoOp~' '~Especie;RB15=1 Y NoVacio(Cliente1) y Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));
FechaVto;Cliente1;'COTOR';VTXT6;;-VCAN8;TipoOp~' '~Especie;RB15=1 Y NoVacio(Cliente1) y Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2')) y Not EqStr(BuscarCampo('CLIENTES','Alias10','Codigo',CLIENTE1),'LIMITELIQ');

@INSTOPE
@INST19MM
@INST19BITS