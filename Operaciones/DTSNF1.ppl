TotalBrutoCli2 : 'C In Ex'                    ;11;2;2;NOT EQSTR(ESPECIE, CONTRAESPECIE); NOT EQSTR(ESPECIE, CONTRAESPECIE);EQSTR(ESPECIE, CONTRAESPECIE) O TOTALBRUTOCLI2>=0;'Contraparte Initial Exchange Invalido';NO;0;IF(EQSTR(ESPECIE,CONTRAESPECIE),0,TOTALBRUTOCLI2)
