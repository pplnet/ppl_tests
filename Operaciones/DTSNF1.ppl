LISTA:SI;IF(ESINICIO,100,CUOTAS1);
 Fecha1    : 'Inicio Per'     ;CB8=0;;ESHABIL(CUOTASL.FECHA1[Fila],TABLAFERIADOS1);'FECHA INICIO PERIODO NO HABIL EN TABLA SELECCIONADA O < A FECHA CONC. EN EL PRIMER PERIODO';IF(Fila=1,Habiles(FECHAEJ,2,'ARG',SI),CUOTASL.FECHA2[Fila-1]);IF(Fila=1,CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila-1]);90;;Fecha;;;;;;;;RB11 = 0
