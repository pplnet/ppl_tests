TotalAux4      : 'V Fi Ex'                    ;;;2;NOT EQSTR(ESPECIE, CONTRAESPECIE); NOT EQSTR(ESPECIE, CONTRAESPECIE);EQSTR(ESPECIE, CONTRAESPECIE) O TOTALAUX4>=0;'Vehiculo Final Exchange Invalido';NO;0;IF(EQSTR(ESPECIE,CONTRAESPECIE),0,TOTALAUX4)
FechaEx1       : 'Initial_Ex_Date'            ;;;2;TOTALAUX3>0 Y NOT EQSTR(ESPECIE,CONTRAESPECIE);TOTALAUX3>0 Y NOT EQSTR(ESPECIE,CONTRAESPECIE);[TOTALAUX3=0 O EQSTR(ESPECIE,CONTRAESPECIE)] O ESHABIL(FECHAEX1,TABLAFERIADOS1);'FECHA INITIAL EXCHANGE NO HABIL EN TABLA SELECCIONADA';RB11 = 0;;IF(TOTALAUX3>0 Y NOT EQSTR(CONTRAESPECIE,ESPECIE),FECHAEX1,0)
FechaEx2       : 'Final_Ex_Date'              ;;;2;TOTALAUX4>0 Y NOT EQSTR(ESPECIE,CONTRAESPECIE);TOTALAUX3>0 Y NOT EQSTR(ESPECIE,CONTRAESPECIE);[TOTALAUX4=0 O EQSTR(ESPECIE,CONTRAESPECIE)] O ESHABIL(FECHAEX2,TABLAFERIADOS1);'FECHA FINAL EXCHANGE NO HABIL EN TABLA SELECCIONADA';RB11 = 0;;IF(TOTALAUX4>0 Y NOT EQSTR(ESPECIE,CONTRAESPECIE),FECHAEX2,0)
ContraEspecie  : 'C Moneda'                   ;1;2;2;;;NOVACIO(CONTRAESPECIE) Y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') Y ESTERMINAL(CONTRAESPECIE,ESPECIE);'DEBE INGRESAR UNA MONEDA CONTRAPARTE VALIDA';NO;'USD';;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~")and Status = 'HAB' ";;;;;
