 Cantidad1 : 'V_Notional'     ;CB8=0;;CUOTASL.CANTIDAD1[Fila]>0;'NOTIONAL AMMOUNT DEL VEHICULO INCORRECTO';;;200;;Numero;'###,###,###,###,###.##'
 Precio1   : 'V_Tasa'         ;CB8=0;;RB9=1 O [RB9=0 Y CUOTASL.PRECIO1[Fila]>=VAR('RTASA1') Y CUOTASL.PRECIO1[Fila]<=VAR('RTASA2')];'La Tasa del Vehiculo ESTA FUERA DE RANGO: '~VAR('RTASA1')~' y '~VAR('RTASA2');;;100;;Numero;'###,###.######';NO;NO;'7'
 Total3    : 'V_Spread'       ;CB8=0;;RB9<>1 O CUOTASL.TOTAL3[Fila]=0 O [CUOTASL.TOTAL3[Fila]>=VAR('RSPREAD1') Y CUOTASL.TOTAL3[Fila]<=VAR('RSPREAD2')];'El Spread del Vehiculo esta Fuera de Rango '~VAR('RSPREAD1')~' '~VAR('RSPREAD2');;;100;;Numero;'###,###.######'
 Cantidad3 : 'V_Interes'      ;CB8=0 y EV;;NOT EV o [[ROUND(CUOTASL.CANTIDAD3[Fila],2) <= ROUND((CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.CANTIDAD3[Fila],2) >= ROUND((CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100)),2)]];'Interes Vehiculo Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(RB9=0,((CUOTASL.CANTIDAD1[Fila]*(CUOTASL.PRECIO1[Fila]+CUOTASL.TOTAL3[Fila]))/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1),IF(CUOTASL.PRECIO1[Fila]>0,((CUOTASL.CANTIDAD1[Fila]*(CUOTASL.PRECIO1[Fila]+CUOTASL.TOTAL3[Fila]))/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1),0));200;NO;Numero;'###,###,###,###,###.##';NO;NO;'5'
 Cantidad2 : 'C_Notional'     ;CB8=0;;CUOTASL.CANTIDAD2[Fila]>0;'NOTIONAL AMMOUNT DE LA CONTRAPARTE INCORRECTO';;;200;;Numero;'###,###,###,###,###.##'
 Precio2   : 'C_Tasa'         ;CB8=0;;RB9=0 O [RB9=1 Y CUOTASL.PRECIO2[Fila]>=VAR('RTASA1') Y CUOTASL.PRECIO2[Fila]<=VAR('RTASA2')];'La Tasa de la Contraparte ESTA FUERA DE RANGO: '~VAR('RTASA1')~' '~VAR('RTASA2');;;100;;Numero;'###,###.######';NO;NO;'11'
 Total4    : 'C_Spread'       ;CB8=0;;RB9<>0 O CUOTASL.TOTAL4[Fila]=0 O [CUOTASL.TOTAL4[Fila]>=VAR('RSPREAD1') Y CUOTASL.TOTAL4[Fila]<=VAR('RSPREAD2')];'El Spread de la Contraparte esta Fuera de Rango '~VAR('RSPREAD1')~' '~VAR('RSPREAD2');;;100;;Numero;'###,###.######'
 Cantidad4 : 'C_Interes'      ;CB8=0 y EV;;NOT EV o [[ROUND(CUOTASL.CANTIDAD4[Fila],2) <= ROUND((CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.CANTIDAD4[Fila],2) >= ROUND((CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100)),2)]];'Interes Contraparte Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(RB9=1,((CUOTASL.CANTIDAD2[Fila]*(CUOTASL.PRECIO2[Fila]+CUOTASL.TOTAL4[Fila]))/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB5+1),IF(CUOTASL.PRECIO2[Fila]>0,((CUOTASL.CANTIDAD2[Fila]*(CUOTASL.PRECIO2[Fila]+CUOTASL.TOTAL4[Fila]))/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB5+1),0));200;NO;Numero;'###,###,###,###,###.##';NO;NO;'9'
 Fecha4    : 'F.Reset'        ;NO;[NOT EQSTR(TIPOTASA,'FIJA') y NOVACIO(TIPOTASA)] O [NOT EQSTR(TIPOTASA2,'FIJA') y NOVACIO(TIPOTASA2)];;;;HABILES(IF(RB16=0,CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila]),-PLAZO4,TABLAFERIADOS1,SI); 90;;Fecha;NO;NO;;;;;;
 Fecha3    : 'Settlement'     ;CB8=0;;ESHABIL(CUOTASL.FECHA3[Fila],TABLAFERIADOS1);'FECHA SETTLEMENT NO HABIL EN TABLA SELECCIONADA';CUOTASL.FECHA2[Fila];CUOTASL.FECHA2[Fila];90;NO;Fecha;;NO
 Precio3   : 'PENDIENTE DE REVISAR EVENTO'         ;CB8=0;;RB9=1 O [RB9=0 Y CUOTASL.PRECIO3[Fila]>=VAR('RTASA1') Y CUOTASL.PRECIO3[Fila]<=VAR('RTASA2')];'La Tasa del Vehiculo ESTA FUERA DE RANGO: '~VAR('RTASA1')~' y '~VAR('RTASA2');;;100;;Numero;'###,###.######';NO;NO;'7'
 Precio4   : 'PENDIENTE DE REVISAR EVENTO'         ;CB8=0;;RB9=1 O [RB9=0 Y CUOTASL.PRECIO4[Fila]>=VAR('RTASA1') Y CUOTASL.PRECIO4[Fila]<=VAR('RTASA2')];'La Tasa del Vehiculo ESTA FUERA DE RANGO: '~VAR('RTASA1')~' y '~VAR('RTASA2');;;100;;Numero;'###,###.######';NO;NO;'7'
 *Los campos PRECIO3 y PRECIO4 deben estar en un evento. Hay que encontrarlo
 Total2    : 'Resultado'      ;NO;NO;;;IF(RB10=0,IF(EQSTR(ESPECIE,CONTRAESPECIE),CUOTASL.CANTIDAD3[Fila] - CUOTASL.CANTIDAD4[Fila],((CUOTASL.CANTIDAD3[Fila]*CUOTASL.PRECIO3[Fila]) - (CUOTASL.CANTIDAD4[Fila]*CUOTASL.PRECIO4[Fila]))),0);IF(RB10=0,IF(EQSTR(ESPECIE,CONTRAESPECIE),CUOTASL.CANTIDAD3[Fila] - CUOTASL.CANTIDAD4[Fila],((CUOTASL.CANTIDAD3[Fila]*CUOTASL.PRECIO3[Fila]) - (CUOTASL.CANTIDAD4[Fila]*CUOTASL.PRECIO4[Fila]))),0);200;;Numero;'###,###,###,###,###.##'
 Check1    : 'Ejercio?'       ;NO;NO;;;;;50;NO;Check

 Precio5   : 'V MOD INT'      ;NO;NO;;;; IF(RB9=0,((CUOTASL.CANTIDAD1[Fila]*(CUOTASL.PRECIO1[Fila]+CUOTASL.TOTAL3[Fila]))/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1),IF(CUOTASL.PRECIO1[Fila]>0,((CUOTASL.CANTIDAD1[Fila]*(CUOTASL.PRECIO1[Fila]+CUOTASL.TOTAL3[Fila]))/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1),0));200;;Numero;'###.######'
 Precio6   : 'C MOD INT'      ;NO;NO;;;; IF(RB9=1,((CUOTASL.CANTIDAD2[Fila]*(CUOTASL.PRECIO2[Fila]+CUOTASL.TOTAL4[Fila]))/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB5+1),IF(CUOTASL.PRECIO2[Fila]>0,((CUOTASL.CANTIDAD2[Fila]*(CUOTASL.PRECIO2[Fila]+CUOTASL.TOTAL4[Fila]))/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB5+1),0));200;;Numero;'###.######'
 Cantidad8 : 'Exposicion MM' ;NO;NO;;;;;100;;Numero;'###,###,###,###.##'

CONDICIONES
[CB8=0 Y [[RB9=0 Y SUM(CUOTASL,6)=0 Y SUM(CUOTASL,7)>=0 Y SUM(CUOTASL,9)=0 Y SUM(CUOTASL,10)>=0] O [RB9=1 Y SUM(CUOTASL,10)=0 Y SUM(CUOTASL,9)>=0 Y SUM(CUOTASL,5)=0 Y SUM(CUOTASL,6)>=0]]];'ERROR EN ALGUNA TASA O SPREAD: TENER EN CUENTA CONDICION FIJO/VARIABLE';NO
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'El Cliente esta  Observado';SI;SI;FSYS;'CLIOBS'
Vacio(Cliente1) o EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB');'El Cliente No esta Habilitado';NO
EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La Especie No esta Habilitada';NO
EqStr(BuscarCampo('Especies','Status','Codigo',ContraEspecie),'HAB');'La ContraEspecie No esta Habilitada';NO
NOT EQSTR (VEHICULO1,CLIENTE1);'El Cliente y el Vehiculo deben ser distintos';NO
ESTERMINAL(VEHICULO1,VEHICULO);'El Vehiculo debe ser Terminal';NO
ESTERMINAL(CLIENTE1,CLIENTE);'El Cliente debe ser Terminal';NO
VACIO(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR)) O  VERIFICAPERFIL(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR),'TO'~TIPOOP);'Operador no habilitado para ingresar Operaciones del Tipo '~TIPOOP;NO
EQSTR(ESPECIE,CONTRAESPECIE2) O [TCCOMCOR1<=TIPOCAMBIO2*(1+VAR('RPRECIO2')/100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Especie de Liquidacion Fuera de Rango: '~FSTR(TIPOCAMBIO2*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+VAR('RPRECIO2')/100),1,7);NO
EQSTR(CONTRAESPECIE,CONTRAESPECIE2) O [TCCOMCOR1<=TIPOCAMBIO2*(1+VAR('RPRECIO2')/100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Especie de Liquidacion Fuera de Rango: '~FSTR(TIPOCAMBIO2*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+VAR('RPRECIO2')/100),1,7);NO

[FECHAEX1=0 Y FECHAEX2=0] O FECHAEX2>FECHAEX1;'FECHA DE FINAL EXCHANGE DEBE SER MAYOR QUE FECHA DE INITIAL EXCHANGE'; NO
FECHAOP =Fsys;'FECHA CONCERTACION NO COINCIDE CON LA DEL SISTEMA';SI;SI;FSYS;'ORIGFVALOR'
[TOTALAUX3=0 O EQSTR(ESPECIE,CONTRAESPECIE)] O ESHABIL(FECHAEX1,'ARG');'LA FECHA DE INITIAL EXCHANGE NO ES DIA HABIL EN ARGENTINA';SI;SI;FSYS;'IEXINH'
[TOTALAUX4=0 O EQSTR(ESPECIE,CONTRAESPECIE)] O ESHABIL(FECHAEX2,'ARG');'LA FECHA DE FINAL EXCHANGE NO ES DIA HABIL EN ARGENTINA';SI;SI;FSYS;'FEXINH'
SI O [Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE) O PLAZORENOVPREDETER<=VCAN12*(1+VAR('RPRECIO2')/100) Y PLAZORENOVPREDETER>=VCAN12*(1-VAR('RPRECIO2')/100)];'COTIZACION CONTABLE Fuera de Rango: '~FSTR(VCAN12*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO2')/100),1,7);NO
SI O [Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE) O PLAZORENOVPREDETER<=VCAN12*(1+VAR('RPRECIO') /100) Y PLAZORENOVPREDETER>=VCAN12*(1-VAR('RPRECIO') /100)];'COTIZACION CONTABLE FUERA DE RANGO: '~FSTR(VCAN12*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOCOTCON'


EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

MOVIMIENTOS
FechaVto ;Cliente1;ContraEspecie2 ;;;;;Vehiculo1;1;IF(MB3=0,TotalNetoCli1,-TotalNetoCli1);;IF(MB3=0,'Compra de Opciones','Venta de Opciones');SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;TotalNetoCli1<>0;;If( EqStr(ContraEspecie,ContraEspecie2),Cuenta2,If(EqStr(Especie,ContraEspecie2),Cuenta1,Cuenta2)) ;;1;

