80;1;FW=2 y QUERY("SELECT 1 FROM "~DBO~".MOVEJECUTADOS WHERE NrOperacion = '"~NROPERACION~"' AND NrSaldo = 1  ") <> 1 y [[NoVacio(FechaPrecan)] o [FechaOp>FSYS] o [[Mes(FechaOp)=Mes(FSYS) y Anio(FechaOp) = Anio(FSYS)] y [DifDias(FechaOp,FSYS,'ARG',SI)<=Var('FVALORMES')]] o [[Mes(FechaOp)+1=Mes(Fsys)] y [FechaOp >= Habiles(FinDeMes(FechaOp,SI,'ARG'),-Var('FVALORMESA'),'ARG',SI)] y [DifDias(FechaOp,FSYS,'ARG',SI)<=Var('FVALORMES')]]]

