CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp        : 'Fecha Conc.'                ;1;1;;NOT EV y VERIFICAACCESO('OPFVALOR');;EsHabil(FECHAOP,'ARG') y ESHABIL(FECHAOP,TABLAFERIADOS1);'FECHA INCORRECTA';NO;FSYS;
@VEHITO
Operador       :                              ;;;;NO;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
TipoOpcion     : 'C_Ej|Europea|Americana'     ;;;;NOT EV;;;;;0;0
RB10           : 'C_Settlement|Cash|Delivery'    ;;;;NOT EV;;;;;0;
MB3            : 'Tipo|COMPRA |VENTA'         ;2;1;;NOT EV;;;;;0;
MB1            : '    |CALL   |PUT'           ;;;;NOT EV;;;;;0;
CB9            : 'Mark_To_Mkt'                ;;;;;NO;;;;0;
Cliente1       : 'ContraParte'                ;5;1;;NOT EV;;NOVACIO(CLIENTE1);'El Clientes es Invalido';NO;;;;;;;;"Status = 'HAB'";;;;
Observac2      : 'Op.Contraparte'             ;6;2;;;;NOVACIO(OBSERVAC2);'EL OPERADOR CONTRAPARTE NO ES VALIDO';SI;;;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
Especie        : 'Especie'                    ;7;1;;NOT EV;;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'TITULO');'Debe Ingresar una Especie Valida';NO;;;;
RB9            : 'Proteccion Div|No|Si'       ;;;;DESCIENDEDEESPECIE(ESPECIE,'PRIVA');DESCIENDEDEESPECIE(ESPECIE,'PRIVA');;;;0;;
PrecioEj       : 'Precio_Ejerc'               ;;;;;;PRECIOEJ>0;'El Precio de Ejercicio debe ser Positivo';NO;;;;;;;'##,###,###.########';;

Cantidad       : 'Cantidad'                   ;11;1;;NOT EV;;CANTIDAD>0;'La Cantidad Debe ser Positiva';NO;
TotalAux1      : 'Notional Ammount'           ;;;;NO;;;;;;CANTIDAD*PRECIOEJ*TOTALBRUTOCLI1
FechaOp2       : 'F_Inicio'                   ;7;2;;;;FECHAOP2>=FECHAOP Y ESHABIL(FECHAOP2,TABLAFERIADOS1);'Fecha de Inicio de Opcion Invalida';NO;0;
Plazo          : 'Plazo_Op'                   ;;;;;;PLAZO>0;'Plazo de la Opcion Invalido';NO;;IF(EQSTR(CAMPOMODIFICADO,'FECHAVTO'),FECHAVTO-FECHAOP,BuscarCampo('Especies','PlazoLiq','Codigo',ESPECIE) DIV 24))
FechaEj        : 'F_Fin'                      ;;;;NO;;ESHABIL(FECHAEJ,TABLAFERIADOS1);'Fecha de Fin de Opcion Invalida';NO;0;IF(FECHAOP2=0,0,FECHAOP2+PLAZO-1)
FechaPago      : 'F_Settlement'               ;11;2;;;TIPOOPCION=0;TIPOOPCION=1 O [FECHAPAGO>=FECHAOP Y ESHABIL(FECHAPAGO,TABLAFERIADOS1)];'Fecha de Settlement Incorrecta';NO;HABILES(FECHAEJ,(BuscarCampo('Especies','PlazoLiq','Codigo',ESPECIE) DIV 24),'ARG',SI);HABILES(FECHAEJ,(BuscarCampo('Especies','PlazoLiq','Codigo',ESPECIE) DIV 24),'ARG',SI)
TablaFeriados1 : 'Feriados'                   ;;;;;;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE)) ;
Precio1        : 'Prima'                      ;14;1;;;;PRECIOMER>=0 y PRECIO1<=100;'La Prima Debe ser Positiva';NO;;;;;;;'###.########'
ContraEspecie  : 'Especie_Liq'                ;14;2;;No;;NOVACIO(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE,ESPECIE);'Debe ingresar una ContraEspecie';NO;;BuscarCampo('Especies','Cotiza','Codigo',ESPECIE);;;;;;"Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA')) ~")and Status = 'HAB'"
FechaVto       : 'Fecha_Prima'                ;;;;NOT EV;;FECHAVTO>=FECHAOP Y ESHABIL(FECHAVTO,TABLAFERIADOS1);'FECHA INCORRECTA';NO;FECHAOP;
TotalNetoCli1  : 'Monto_Prima'                ;15;1;;NO;;;;;;CANTIDAD*PRECIO1*TOTALBRUTOCLI1;

@COMISEC

FechaUltCupon  : 'Ult.Cupon'                  ;9;1;2;NO;Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE');;;;;IF(EsHabil(UltCupon(ESPECIE,FECHAVTO),'USA'),UltCupon(ESPECIE,FECHAVTO),Habiles(UltCupon(ESPECIE,FECHAVTO),IF(EqStr(BuscarCampo('ESPECIES','CuponFeriado','Codigo',ESPECIE),'SIG'),1,IF(EqStr(BuscarCampo('ESPECIES','CuponFeriado','Codigo',ESPECIE),'ANT'),-1,0)),'USA'))
Cotizacion1    : 'TC_Concert.'                ; ; ;2;;Not Eqstr(CONTRAESPECIE,VAR('MONEEXTR'));Eqstr(CONTRAESPECIE,VAR('MONEEXTR')) O [COTIZACION1<=VPRE1*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE1*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE1*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE1*(1+VAR('RPRECIO2')/100),1,7);NO;;IF(Eqstr(CONTRAESPECIE,VAR('MONEEXTR')),1)
Cotizacion2    : 'TC_Vencim.'                 ; ; ;;COTIZACION2<>0;COTIZACION2<>0;;;;
TotalBrutoCli1 : 'ValorResidual'              ;9;2;2;NO;Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE');;;;;IF(Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE'),ValorTeorico2(ESPECIE),1);;;;;"##,###.#####"
Cupon1         : 'Cupon'                      ;;;2;NO;;;;;;if(MODI,CUPON1,BuscarCampo('ESPECIES','Cupon','Codigo',ESPECIE))
CB8            : 'Ejercicio'                  ;;;2;NO;CB8=1;;;;0
FechaVto2      : 'F_Ejercicio'                ;;;2;NO;CB8=1;;;;
Precio4        : 'Resultado'                  ;;;2;NO;CB8=1;;;;
Precio2        : 'Precio_Ref'                 ;;;2;NO;CB8=1;;;;
CB6            : 'Cot. Esp/ContDirecta'       ;4;3;2;NO;NO;;;;;IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE~"' "),'INV'),0,1)
TipoCambio2    : 'Cotizacion'                 ;14;3;;NO;NO;;;;;IF(CB6=1,COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'ARP')/COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,'ARP'),COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,'ARP')/COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'ARP'))
RB3            : 'MOF'                        ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa        : 'Modificado'                 ;10;3;;NO;NO;;;;0
VPRE5          : 'Cot.ESP/USD'                ;10;3;;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
VPRE6          : 'Cot.CONTESP/USD'            ;10;3;;NO;NO;;;;;COTIZACIONC(CONTRAESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
VPRE1          : 'Cot.TC/USD'                 ;10;2;;NO;NO;;;;;COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(CONTRAESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)

TotalAux3       : 'Monto USD WF'               ;1;2;2;NO;NO;;;;CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'));CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))
TotalIntereses : 'Interes Total'              ;;;2;NO;NO;
PrecioMer      : 'Prima'                      ;;;2;NO;NO;
OperacionRef   : 'OpRef'                      ;;;2;NO;NO;
@CUENTAS

LISTA:NO Y Not ESINICIO;Query("SELECT Count(*) FROM "~DBO~".CUOTAS Where NrOperacion='"~NROPERACION~"' ");  
  Fecha1   : 'F.Posicion'     ;NO;;;;;; 90;;Fecha
  Radio1   : 'Evento'         ;NO;;;;;; 90;NO;Combo;'DIV|CUP'
  Cantidad1: 'Cantidad'       ;NO;;;;;;200;;Numero;'###,###,###.##'
  Precio1  : 'PrecioEj'       ;NO;;;;;;100;;Numero;'##,###.######'
  Fecha2   : 'Ult.Cupon'      ;NO;;;;;; 90;;Fecha
  Precio2  : 'TasaIntCupon'   ;NO;;;;;;100;;Numero;'##,###.######'
  Precio3  : 'ValorResidual'  ;NO;;;;;;200;;Numero;'###,###.######'
  Cantidad2: 'N.Amount'       ;NO;;;;;;200;;Numero;'###,###,###.##'



CONDICIONES
EsHabil(FECHAEJ,'ARG');'La Fecha de Fin de Opcion NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'FINOINH'
EsHabil(FECHAOP2,'ARG');'La Fecha de Inicio de Opcion NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'INICOINH'
EsHabil(FECHAPAGO,'ARG');'La Fecha de Settlement NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'FSETTINH'
EsHabil(FECHAVTO,'ARG');'La Fecha de Prima NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'FPRIMAINH'
FECHAEJ<=FECHAPAGO;'LA FECHA DE SETTLEMENT DEBE SER MAYOR O IGUAL A LA FECHA DE FIN DE LA OPCION';NO
FechaOp>Fecha(Var('FECHAVALOR'));'La Fecha Valor No Debe Superar el '~Var('FECHAVALOR');NO
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'

SI O [RB12<>0 O VACIO(Corredor) O [PORCOMCOR1>=VAR('RCOMCOR1') y PORCOMCOR1<=VAR('RCOMCOR2')]];'El % Comision Corredor EXCEDE Los Limites: Min.'~VAR('RCOMCOR1')~' Max.'~VAR('RCOMCOR2');NO
SI O [RB13<>0 O EqStr(Mercado,'OTC')  o [PORCOMMER1>=VAR('RCOMMER1') y PORCOMMER1<=VAR('RCOMMER2')]];'El % Comision Mercado EXCEDE Los Limites: Min.'~VAR('RCOMMER1')~' Max.'~VAR('RCOMMER2');NO

@CONDIOP

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

MOVIMIENTOS
FechaVto ;Cliente1;ContraEspecie ;;;;;Vehiculo1;1;IF(MB3=0,TotalNetoCli1,-TotalNetoCli1);;IF(MB3=0,'Compra de Opciones','Venta de Opciones');SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta2;;1;
FechaVto2;Cliente1;ContraEspecie ;;;;;Vehiculo1;1;-Precio4;;'Resultado Ejercicio Net';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;Precio4<>0 y RB10=0;;Cuenta2;;2;

FechaVto;Cliente1;ContraEspecie;;;;;Vehiculo1;1;ImpComMer1;;'Compra Comision Mercado' ;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta2;;30;
FechaVto;IF(VACIO(Corredor),Cliente1,Corredor);ContraEspecie;;;;;Vehiculo1;1;ImpComCor1;;'Compra Comision Corredor';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta2;;40;
FechaVto;IF(VACIO(Corredor),Cliente1,Corredor);ContraEspecie;;;;;Vehiculo1;1;TotalIva  ;;'Comision IVA Corredor'   ;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta2;;50;


