CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
OperacionRef   : 'Set Like'       ;1;1; ;  ;  ;Vacio(OPERACIONREF) o EqStr(OPREF.TIPOOP,'MMPRA');'La Operacion de Referencia No es un Prestamo Sistema Aleman';NO;;;;;;;;"TipoOp = 'MMPRA' and FechaOp2 = '"~IdxDate(Fsys)~"' "
Especie        : 'Moneda'         ;3;1; ;  ;  ;NoVacio(ESPECIE) y Incluido(ESPECIE,Var('MMMONEDA'));'Debe Ingresar una Moneda Valida';NO;;IF(VACIO(OPERACIONREF) o MODI o Incluido(ABM,'E'),ESPECIE,OPREF.ESPECIE);;;;;;"Status = 'HAB' and Codigo In ("~Pipe2Comillas(Var('MMMONEDA'))~") ";
Cliente1       : 'Cliente'        ; ; ; ;  ;  ;Vacio(Cliente1) o Incluido(Var('MMCPRES'),Ascendientes('CLIENTES',CLIENTE1),1);'El Cliente debe pertenecer a las jerarquias '~Pipe2Comillas(Var('MMCPRES'));NO;;IF(VACIO(OPERACIONREF) o MODI o Incluido(ABM,'E'),CLIENTE1,OPREF.CLIENTE1);;;;;;"select C.Codigo, C.RazonSocial from "~DBO~".CLIENTES C where C.Status Like 'HAB' and (Nacionalidad = '080' or TipoDocum = 'CUI') and C.Codigo In (Select C.Codigo from "~DBO~".CLIENTES X "~"where C.Jerarquia like SubString(X.Jerarquia,1,Charindex('000',X.Jerarquia)-1)+'%' "~"and X.Codigo In ("~Pipe2Comillas(Var('MMCPRES'))~"))"
Cantidad       : 'Cantidad'       ; ; ; ;  ;  ;CANTIDAD>0;'La Cantidad debe ser Positiva';NO;;IF(VACIO(OPERACIONREF) o Incluido(ABM,'E'),CANTIDAD,OPREF.CANTIDAD);;;;;'####,###,###,###.##'

FechaOp2       : 'Fecha Origen'   ;1;2; ;NO;  ;;;;FSYS;
FechaOp        : 'Fecha Conc.'    ; ;2; ;VerificaAcceso('OPFVALOR');  ;EsHabil(FECHAOP,'ARG');'Fecha Conc.Incorrecta';NO;FSYS;
Plazo          : 'Plazo'          ; ;2; ;  ;  ;PLAZO>0 y PLAZO<29372;'El Plazo debe ser > 0 y < 29372';NO;365;IF(VACIO(OPERACIONREF) o EqStr(CAMPOEDITADO,'FechaVto') o EqStr(CAMPOEDITADO,'FechaOp') o Incluido(ABM,'E'),IF(EqStr(CAMPOEDITADO,'FechaOp'),PLAZO,FECHAVTO-FECHAOP),OPREF.PLAZO);
FechaVto       : 'Fecha Vto.'     ;5;2; ;  ;  ;ESHABIL(FECHAVTO,'ARG');'No es un Dia Habil';NO;FECHAOP+PLAZO;FECHAOP+PLAZO;

MB1            : 'Periodo|Libre|Mensual|Bimestral|Trimestral|Semestral' ;7;1;;;;;;;1;IF(VACIO(OPERACIONREF) o Incluido(ABM,'E'),MB1,OPREF.MB1)
PeriodoInts    : 'Periodo Ints.'  ;8;1; ;;;PERIODOINTS<=PLAZO;'La Periodicidad debe ser Menor o Igual al Plazo';NO;30;IF(VACIO(OPERACIONREF) o EqStr(CAMPOEDITADO,'MB1') o Incluido(ABM,'E'),IF(EqStr(CAMPOEDITADO,'MB1'),IF(MB1=0,30,IF(MB1=1,30,IF(MB1=2,60,IF(MB1=3,90,180)))),PERIODOINTS),OPREF.PERIODOINTS);
Cuotas1        : 'Cuotas'         ;8;2; ;NO;;;;;;IF(((PLAZO MOD PERIODOINTS)/PERIODOINTS)>=0.5,(PLAZO DIV PERIODOINTS)+1,PLAZO DIV PERIODOINTS)
MB4            : 'Corr.Liq.|Sig.Habil|Ant.Habil|Sig.Modi.|Ant.Modi.'    ;9;1;;;CUOTAS1<>1;;;;0;IF(VACIO(OPERACIONREF) o Incluido(ABM,'E'),MB4,OPREF.MB4)
DiasAnio       : 'A#o Base'      ;10;1; ;;;;;;1;IF(VACIO(OPERACIONREF) o Incluido(ABM,'E'),DIASANIO,OPREF.DIASANIO)
DiasMes        : 'Mes Base'      ;10;2; ;;PERIODOINTS<>PLAZO;;;;1;IF(VACIO(OPERACIONREF) o Incluido(ABM,'E'),DIASMES,OPREF.DIASMES)
Precio1        : 'Tasa N.A.'     ;11;1; ;;;PRECIO1>=0; 'La Tasa No puede ser Negativa';NO;;IF(VACIO(OPERACIONREF) o Incluido(ABM,'E'),PRECIO1,OPREF.PRECIO1);;;;;'####.########'
Precio4        : 'T.Transf.'     ;12;1; ;  ;  ;PRECIO4>0;'La Tasa de Transferencia es Nula';SI;;;;;;;'####.########'
VPRE9          : 'NII'           ;12;2; ;NO;  ;;;;;PRECIO1-PRECIO4
VPRE5          : 'VPRE5'         ;18;1; ;NO;NO;;;;;(PERIODOINTS - 30)
VPRE6          : 'VPRE6'         ;18;2; ;NO;NO;;;;;(PERIODOINTS DIV 30)

