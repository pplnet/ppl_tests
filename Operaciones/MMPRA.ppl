Cuenta2        : 'Direc.Fondos'  ;15;1; ;;;;;;;IF(Incluido(ABM,'E'),CUENTA2,QUERY("Select Codigo from "~DBO~".CUENTAS where Cliente = '"~CLIENTE1~"' and (Especies = '"~ESPECIE~"|' or Especies = 'MONEDA|') and Estado = 'HAB' and Permanente = 'SI' and Mercado is Null "));;;;;;"Cliente = '"~CLIENTE1~"' and Estado = 'HAB' and Mercado is Null   and TipoCuenta Not In ('FCI','INV') ";
