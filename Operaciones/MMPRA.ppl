LISTA:SI; CUOTAS1;
  Fecha1   : 'F.Origen'     ;NO;  ;;;;IF(Fila=1,FECHAOP,IF(RB4=0,CUOTASL.FECHA2[Fila-1],CUOTASL.FECHA3[Fila-1]));90;;Fecha
  Fecha4   : 'F.Vto4'       ;NO;NO;;;;IF(Fila=CUOTAS1,FECHAVTO,FinDeMes(CUOTASL.FECHA1[Fila]+VPRE5,SI)+Dia(FechaOp));90;;Fecha
  Fecha5   : 'F.Vto5'       ;NO;NO;;;;IF(Fila=CUOTAS1,FECHAVTO,IF([[Mes(CUOTASL.FECHA4[Fila]) >= Mes(CUOTASL.FECHA1[Fila])] y [(Mes(CUOTASL.FECHA4[Fila])-Mes(CUOTASL.FECHA1[Fila]))<>VPRE6]] o [[Mes(CUOTASL.FECHA4[Fila]) < Mes(CUOTASL.FECHA1[Fila])] y [((Mes(CUOTASL.FECHA4[Fila])+12)-Mes(CUOTASL.FECHA1[Fila]))<>VPRE6]] o [Fila>1 y Mes(CUOTASL.FECHA1[Fila])<>Mes(CUOTASL.FECHA2[Fila-1])],IF([Fila>1] y [Mes(CUOTASL.FECHA1[Fila])<>Mes(CUOTASL.FECHA2[Fila-1])],FinDeMes(FinDeMes(CUOTASL.FECHA1[Fila]+VPRE5+IF(MB4=1,0,-Dia(CUOTASL.FECHA1[Fila])),SI)+1,SI)+IF(MB4=1,Dia(FechaOp),0),FinDeMes(FinDeMes(IF([(Mes(CUOTASL.FECHA1[Fila]+VPRE5)-(Mes(CUOTASL.FECHA1[Fila])))<>(VPRE6-1)],CUOTASL.FECHA1[Fila]+VPRE5-VPRE6,CUOTASL.FECHA1[Fila]+VPRE5),SI)+1,SI)),CUOTASL.FECHA4[Fila]));90;;Fecha
  Fecha2   : 'F.Vto.'       ;NO;  ;;;;IF(Fila=CUOTAS1,FECHAVTO,IF(MB1=0,CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO3[Fila],CUOTASL.Fecha5[Fila]));90;;Fecha
  Fecha3   : 'F.Liq.'       ;NO;  ;CUOTASL.FECHA3[Fila]>=FECHAOP2;'Cuotas Vencidas';;IF(ESHABIL(CUOTASL.FECHA2[Fila],'ARG'),CUOTASL.FECHA2[Fila],HABILES(CUOTASL.FECHA2[Fila],IF(MB4=0,1,IF(MB4=1,-1,IF(MB4=2,IF(Mes(CUOTASL.FECHA2[Fila])=Mes(HABILES(CUOTASL.FECHA2[Fila],1,'ARG',SI)),1,-1),IF(Mes(CUOTASL.FECHA2[Fila])=Mes(HABILES(CUOTASL.FECHA2[Fila],-1,'ARG',SI)),-1,1)))),'ARG',SI));90;;Fecha

  Fecha6   : 'F.Vto6'       ;NO;NO;;;;FinDeMes(CUOTASL.FECHA1[Fila]+VPRE5,SI)+Dia(CUOTASL.FECHA1[Fila]);90;;Fecha
  Fecha7   : 'F.Vto7'       ;NO;NO;;;;IF([[Mes(CUOTASL.FECHA6[Fila]) >= Mes(CUOTASL.Fecha1[Fila])] y [(Mes(CUOTASL.FECHA6[Fila])-Mes(CUOTASL.Fecha1[Fila]))<>VPRE6]] o [[Mes(CUOTASL.FECHA6[Fila]) < Mes(CUOTASL.Fecha1[Fila])] y [((Mes(CUOTASL.FECHA6[Fila])+12)-Mes(CUOTASL.Fecha1[Fila]))<>VPRE6]],FinDeMes(FinDeMes(IF((Mes(CUOTASL.Fecha1[Fila]+VPRE5)-(Mes(CUOTASL.Fecha1[Fila])))<>(VPRE6-1),CUOTASL.Fecha1[Fila]+VPRE5-VPRE6,CUOTASL.Fecha1[Fila]+VPRE5),SI)+1,SI),CUOTASL.FECHA6[Fila]);90;;Fecha
  Plazo1   : 'Dias'         ;NO;  ;;;;IF(RB4=0,IF(MB1=0,IF(DIASMES=0,PERIODOINTS+(CUOTASL.FECHA2[Fila]-CUOTASL.FECHA7[Fila]),CUOTASL.FECHA2[Fila]-CUOTASL.Fecha1[Fila]),IF(DIASMES=0,IF(Fila=CUOTAS1,PERIODOINTS+(CUOTASL.FECHA2[Fila]-CUOTASL.FECHA7[Fila]),PERIODOINTS),CUOTASL.FECHA2[Fila]-CUOTASL.Fecha1[Fila])),IF(MB1=0,IF(DIASMES=0,PERIODOINTS+(CUOTASL.FECHA3[Fila]-CUOTASL.FECHA7[Fila]),CUOTASL.FECHA3[Fila]-CUOTASL.Fecha1[Fila]),IF(DIASMES=0,PERIODOINTS+(CUOTASL.FECHA3[Fila]-CUOTASL.FECHA7[Fila]),CUOTASL.FECHA3[Fila]-CUOTASL.Fecha1[Fila])));40;;Numero;'####'

  Precio1  : 'Tasa N.A.'    ;NO;;;;PRECIO1;PRECIO1;80;;Numero;'###,###.######';NO;NO;
  Cantidad1: 'Imp.Amortiz.' ;NO;;;;;CANTIDAD/CUOTAS1;120;;Numero;'###,###,###.##';NO;NO;
  Total2   : 'Total Amort.' ;NO;;;;;IF(Fila=1,CUOTASL.CANTIDAD1[Fila],CUOTASL.CANTIDAD1[Fila]+CUOTASL.TOTAL2[Fila-1]);120;;Numero;'###,###,###.##';NO;NO;
  Cantidad3: 'Saldo'        ;NO;;;;;CANTIDAD*(1-(Fila/CUOTAS1));120;;Numero;'###,###,###.##';NO;NO;
  Cantidad2: 'Interes'      ;NO;;;;;IF(Fila=1,CANTIDAD*CUOTASL.PRECIO1[Fila]*CUOTASL.PLAZO1[Fila]/(DIASA(DIASANIO,FECHAVTO)*100),CUOTASL.CANTIDAD3[Fila-1]*CUOTASL.PRECIO1[Fila]*CUOTASL.PLAZO1[Fila]/(DIASA(DIASANIO,FECHAVTO)*100));120;;Numero;'###,###,###.##';NO;NO;
  Total1   : 'Cuota'        ;NO;;;;;CUOTASL.CANTIDAD2[Fila]+CUOTASL.CANTIDAD1[Fila];120;;Numero;'###,###,###.##';NO;NO;

  Precio4  : 'Por.IVA'      ;;;CUOTASL.PRECIO4[Fila]>=0;'IVA Negativo';;PORCAUCION;80;;Numero;'###,###.######';NO;NO;
  Cantidad4: 'IVA'          ;NO;;;;;ROUND(CUOTASL.CANTIDAD2[Fila]*CUOTASL.PRECIO4[Fila]/100,2);120;;Numero;'###,###.######';NO;NO;
  Tasa1    :'Por.Percepcion';;;CUOTASL.TASA1[Fila]>=0;'Percepcion Negativa';;PORIMPUESTOBOLSA;80;;Numero;'###,###.######';NO;NO;
  Total4   :'LALA'          ;NO;NO;;;;ROUND(CUOTASL.CANTIDAD2[Fila]*CUOTASL.TASA1[Fila]/100,2);120;;Numero;'###,###.######';NO;NO;
  Total3   :'Percepcion'    ;NO;;;;;IF(Incluido(VTXT1,'INS'),IF(CUOTASL.CANTIDAD2[Fila]>Var('INSMONTO') o CUOTASL.Total4[Fila]>Var('INSPERCEP'),CUOTASL.Total4[Fila],0),IF(Incluido(VTXT1,'NOI'),CUOTASL.Total4[Fila],IF(Incluido(VTXT1,'NOC'),IF(CUOTASL.CANTIDAD2[Fila]>Var('NOCMONTO') o CUOTASL.Total4[Fila]>Var('NOCPERCEP'),CUOTASL.Total4[Fila],0),0)));120;;Numero;'###,###.######';NO;NO;
  Tasa2    :'Por.Endeuda.'  ;;;CUOTASL.TASA2[Fila]>=0;'Endeudamiento Negativo';;PORDERECHOBOLSA;80;;Numero;'###,###.######';NO;NO;
  Total6   :'Endeudamiento' ;NO;;;;;IF(CUOTASL.PRECIO1[Fila]<=Var('TASAENDEU'),ROUND(CUOTASL.CANTIDAD2[Fila]*PORDERECHOBOLSA/100,2),IF(Fila=1,CANTIDAD*Var('TASAENDEU')*CUOTASL.Plazo1[Fila]/(DIASA(DIASANIO,FECHAVTO)*100),CUOTASL.CANTIDAD3[Fila-1]*Var('TASAENDEU')*CUOTASL.Plazo1[Fila]/(DIASA(DIASANIO,FECHAVTO)*100))*PORDERECHOBOLSA/100);120;;Numero;'###,###.######';NO;NO;
  Total5   :'Monto'         ;NO;;;;;ROUND(CUOTASL.TOTAL1[Fila]+CUOTASL.Cantidad4[Fila]+CUOTASL.Total3[Fila]+CUOTASL.Total6[Fila],2);120;;Numero;'###,###,###.##';NO;NO;
  Plazo3   : 'Plazo'        ;NO;;;;;IF(Fila=CUOTAS1,IF(((PLAZO MOD PERIODOINTS)/PERIODOINTS)>=0.5,(PLAZO MOD PERIODOINTS),PERIODOINTS+(PLAZO MOD PERIODOINTS)),PERIODOINTS);40;;Numero;'####'

*
*PRECONDICIONES
*HAbierto('PRESTA');'Sector Cerrado';NO;
*
CONDICIONES

SI;'El Cliente No tiene Habilitado el Tipo de Operacion';NO;
*EV o Incluido(TIPOOP, BuscarCampo('Clientes','TiposOperacionMM','Codigo',CLIENTE1));'El Cliente No tiene Habilitado el Tipo de Operacion';NO;

EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La Moneda No esta Habilitada';NO
Vacio(Cliente1) o EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB');'El Cliente No esta Habilitado';NO
Vacio(Cliente1) o EqStr(BuscarCampo('Clientes','Nacionalidad','Codigo',Cliente1),'080') o EqStr(BuscarCampo('Clientes','TipoDocum','Codigo',Cliente1),'CUI');'El Cliente debe ser Local';NO
Vacio(Cuenta2) o EqStr(BuscarCampo('Cuentas','Cliente','Codigo',Cuenta2),Cliente1) o EqStr(BuscarCampo('Cuentas','Cliente','Codigo',Cuenta2),Vehiculo1);'La Cuenta a Direccionar debe ser del Cliente o del Banco';NO

[Precio1 > 0];'La Tasa No puede ser Cero';NO;
[NoVacio(FechaPrecan)] o Precio1>=Precio4;'STRNEG_La Tasa es Menor que la Tasa de Transferencia';SI;SI;FSYS;'OPERAT' 

[NoVacio(FechaPrecan)] o DifDias(FechaOp,Fsys,'ARG',SI)<1;'Fecha Valor Mayor a un Dia: '~Fecha(FechaOp);SI;SI;FSYS;'FECHAVAL'
FechaOp > Fecha(Var('FECHAVALOR'));'La Fecha Valor No Debe Superar el '~Var('FECHAVALOR');NO
[NoVacio(FechaPrecan)] o [EqStr(Especie,'ARP')] o [EsHabil(FechaOp,'USA')];'Fecha de Operacion No Habil en USA';SI;SI;FSYS;'OPEWAR'
[NoVacio(FechaPrecan)] o [EqStr(Especie,'ARP')] o [EsHabil(FechaVto,'USA')];'Fecha de Vencimiento No Habil en USA';SI;SI;FSYS;'OPERAT'
[NoVacio(FechaPrecan)] o [FechaOp>FSYS] o [[Mes(FechaOp)=Mes(FSYS) y Anio(FechaOp) = Anio(FSYS)] y [DifDias(FechaOp,FSYS,'ARG',SI)<=VAR('FVALORMES')]] o [[Mes(FechaOp)+1=Mes(Fsys)] y [FechaOp >= Habiles(FinDeMes(FechaOp,SI,'ARG'),-VAR('FVALORMESA'),'ARG',SI)] y [DifDias(FechaOp,FSYS,'ARG',SI)<=VAR('FVALORMES')]];'Fecha de Concertacion Invalida';NO;


*Incluido(Vehiculo1,'BKB');'El Vehiculo no esta Habilitado para la Operacion';NO
Incluido(Vehiculo1, UsrVehiculos(Operador)) o Vacio(UsrVehiculos(Operador));'El Operador no esta habilitado para operar con el Vehiculo';NO

SI o [NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o [BuscarCampo('Clientes','Patrimonio','Codigo',Cliente1)>LimConsumido(CLIENTE1,'RPCCLI','USD',0,VEHICULO1,,,NROPERACION)];'Patrimonio del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
SI o [NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o [Not DesciendeDeCliente(Cliente1,'VINCULADOS')] o [DesciendeDeCliente(Cliente1,'VINCULADOS') y BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('PVINC')>LimConsumido(CLIENTE1,'RPCBCO','USD',0,VEHICULO1,,,NROPERACION)];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
SI o [NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o [Not DesciendeDeCliente(Cliente1,'BLOCAL')] o [DesciendeDeCliente(Cliente1,'BLOCAL') y BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('PFINAN')>LimConsumido(CLIENTE1,'RPCBCO','USD',0,VEHICULO1,,,NROPERACION)];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
SI o [NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o [Not DesciendeDeCliente(Cliente1,'BEXTER')] o [DesciendeDeCliente(Cliente1,'BEXTER') y BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('PFINEXT')>LimConsumido(CLIENTE1,'RPCBCO','USD',0,VEHICULO1,,,NROPERACION)];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
SI o [NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o [Not DesciendeDeCliente(Cliente1,'CORREXT')] o [DesciendeDeCliente(Cliente1,'CORREXT') y BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('PCORREXT')>LimConsumido(CLIENTE1,'RPCBCO','USD',0,VEHICULO1,,,NROPERACION)];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
SI o [NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o [DesciendeDeCliente(Cliente1,'BANCOS')] o [DesciendeDeCliente(Cliente1,'VINCULADOS')] o [DesciendeDeCliente(Cliente1,'CORRESP')] o [Not DesciendeDeCliente(Cliente1,'BANCOS') y Not DesciendeDeCliente(Cliente1,'VINCULADOS') y Not DesciendeDeCliente(Cliente1,'CORRESP') y BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('PCLIENTE')>LimConsumido(CLIENTE1,'RPCBCO','USD',0,VEHICULO1,,,NROPERACION)];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1

SI o [NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o [BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('P25')>BuscarCampo('Clientes','Patrimonio','Codigo',Cliente1)*3];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1

[NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o ExisteLimite(IF(EqStr(ESPECIE,'ARP'),'04','43'),Cliente1,'USD'); 'Sub-Limite No Asignado ';SI;SI;FSYS;'LINOAS';;;2
[NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o VtoLimite(IF(EqStr(ESPECIE,'ARP'),'04','43'),Cliente1,'USD') >= FechaOp; 'Sub-Limite Vencido '; SI;SI;FSYS;'LIVENC';;;2
[NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o [LimAsignado(Cliente1,IF(EqStr(ESPECIE,'ARP'),'04','43'),'USD')>=(LimConsumido(CLIENTE1,IF(EqStr(ESPECIE,'ARP'),'04','43'),'USD',0,VEHICULO1,,,NROPERACION) + TotalAux1)];'Sub-Limite Excedido en U$D '~PYC(((LimConsumido(CLIENTE1,IF(EqStr(ESPECIE,'ARP'),'04','43'),'USD',0,VEHICULO1,,,NROPERACION) + TotalAux1)-LimAsignado(Cliente1,IF(EqStr(ESPECIE,'ARP'),'04','43'),'USD')),1,0)~'.-';SI;SI;FSYS;'LIEXCE';;;2

[NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o VtoLimite('L1EL',Cliente1,'USD') >= FechaOp; 'Level 1 Exposure Limit Vencido '; SI;SI;FSYS;'LIVENC';;;3
[NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o [LimAsignado(Cliente1,'L1EL','USD')>=(LimConsumido(CLIENTE1,'TREASURY','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE1,'CREDIT','USD',0,VEHICULO1,,,NROPERACION) + TotalAux1)];'Level 1 Exposure Limit Excedido en U$D '~PYC(((LimConsumido(CLIENTE1,'TREASURY','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE1,'CREDIT','USD',0,VEHICULO1,,,NROPERACION) + TotalAux1)-LimAsignado(Cliente1,'L1EL','USD')),1,0)~'.-';SI;SI;FSYS;'LIEXCE';;;3

[NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o VtoLimite('TE',Cliente1,'USD') >= FechaOp; 'Total Exposure Limit Vencido '; SI;SI;FSYS;'LIVENC';;;3
[NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o [LimAsignado(Cliente1,'TE','USD')>=(LimConsumido(CLIENTE1,'TREASURY','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE1,'CREDIT','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE1,'SERVICE','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE1,'INDIRECT','USD',0,VEHICULO1,,,NROPERACION) + TotalAux1)];'Total Exposure Limit Excedido en U$D '~PYC(((LimConsumido(CLIENTE1,'TREASURY','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE1,'CREDIT','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE1,'SERVICE','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE1,'INDIRECT','USD',0,VEHICULO1,,,NROPERACION) + TotalAux1)-LimAsignado(Cliente1,'L1EL','USD')),1,0)~'.-';SI;SI;FSYS;'LIEXCE';;;3

[NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o [Not Incluido(Cliente1,Var('MPECLI'))] o [Incluido(Cliente1,Var('MPECLI')) y VtoLimite('MPE',Cliente1,'USD') >= FechaOp]; 'Maximum Potential Exposure Vencido '; SI;SI;FSYS;'LIVENC';;;3
[NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o [Not Incluido(Cliente1,Var('MPECLI'))] o [Incluido(Cliente1,Var('MPECLI')) y LimAsignado(Cliente1,'MPE','USD')>=(LimConsumido(CLIENTE1,'TREASURY','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE1,'CREDIT','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE1,'SERVICE','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE1,'INDIRECT','USD',0,VEHICULO1,,,NROPERACION) + TotalAux1)];'Maximum Potential Exposure Excedido en U$D '~PYC(((LimConsumido(CLIENTE1,'TREASURY','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE1,'CREDIT','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE1,'SERVICE','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE1,'INDIRECT','USD',0,VEHICULO1,,,NROPERACION) + TotalAux1)-LimAsignado(Cliente1,'MPE','USD')),1,0)~'.-';SI;SI;FSYS;'LIEXCE';;;3

[NoVacio(FechaPrecan)] o Vacio(Cliente5) o FechaOp > Fsys o ExisteLimite(IF(EqStr(ESPECIE,'ARP'),'04','43'),Cliente5,'USD'); 'Sub-Limite No Asignado para Grupo Economico';SI;SI;FSYS;'LINOAS';;;4
[NoVacio(FechaPrecan)] o Vacio(Cliente5) o FechaOp > Fsys o VtoLimite(IF(EqStr(ESPECIE,'ARP'),'04','43'),Cliente5,'USD') >= FechaOp; 'Sub-Limite Vencido para Grupo Economico '; SI;SI;FSYS;'LIVENC';;;4
[NoVacio(FechaPrecan)] o Vacio(Cliente5) o FechaOp > Fsys o [LimAsignado(Cliente5,IF(EqStr(ESPECIE,'ARP'),'04','43'),'USD')>=(LimConsumido(CLIENTE5,IF(EqStr(ESPECIE,'ARP'),'04','43'),'USD',0,VEHICULO1,,,NROPERACION) + TotalAux1)];'Sub-Limite Excedido para Grupo Economico en U$D '~PYC(((LimConsumido(CLIENTE5,IF(EqStr(ESPECIE,'ARP'),'04','43'),'USD',0,VEHICULO1,,,NROPERACION) + TotalAux1)-LimAsignado(Cliente5,IF(EqStr(ESPECIE,'ARP'),'04','43'),'USD')),1,0)~'.-';SI;SI;FSYS;'LIEXCE';;;4

[NoVacio(FechaPrecan)] o Vacio(Cliente5) o FechaOp > Fsys o [LimAsignado(Cliente5,'L1EL','USD')>=(LimConsumido(CLIENTE5,'TREASURY','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE5,'CREDIT','USD',0,VEHICULO1,,,NROPERACION) + TotalAux1)];'Level 1 Exposure Limit Excedido para Grupo Economico en U$D '~PYC(((LimConsumido(CLIENTE5,'TREASURY','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE5,'CREDIT','USD',0,VEHICULO1,,,NROPERACION) + TotalAux1)-LimAsignado(Cliente5,'L1EL','USD')),1,0)~'.-';SI;SI;FSYS;'LIEXCE';;;5
[NoVacio(FechaPrecan)] o Vacio(Cliente5) o FechaOp > Fsys o [LimAsignado(Cliente5,'TE','USD')>=(LimConsumido(CLIENTE5,'TREASURY','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE5,'CREDIT','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE5,'SERVICE','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE5,'INDIRECT','USD',0,VEHICULO1,,,NROPERACION) + TotalAux1)];'Total Exposure Limit Excedido para Grupo Economico en U$D '~PYC(((LimConsumido(CLIENTE5,'TREASURY','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE5,'CREDIT','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE5,'SERVICE','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE5,'INDIRECT','USD',0,VEHICULO1,,,NROPERACION) + TotalAux1)-LimAsignado(Cliente5,'L1EL','USD')),1,0)~'.-';SI;SI;FSYS;'LIEXCE';;;5
[NoVacio(FechaPrecan)] o Vacio(Cliente5) o FechaOp > Fsys o [Not Incluido(Cliente5,Var('MPECLI'))] o [Incluido(Cliente5,Var('MPECLI')) y LimAsignado(Cliente5,'MPE','USD')>=(LimConsumido(CLIENTE5,'TREASURY','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE5,'CREDIT','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE5,'SERVICE','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE5,'INDIRECT','USD',0,VEHICULO1,,,NROPERACION) + TotalAux1)];'Maximum Potential Exposure Excedido para Grupo Economico en U$D '~PYC(((LimConsumido(CLIENTE5,'TREASURY','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE5,'CREDIT','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE5,'SERVICE','USD',0,VEHICULO1,,,NROPERACION) + LimConsumido(CLIENTE5,'INDIRECT','USD',0,VEHICULO1,,,NROPERACION) + TotalAux1)-LimAsignado(Cliente5,'MPE','USD')),1,0)~'.-';SI;SI;FSYS;'LIEXCE';;;5

*[NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o Vacio(NrOperacion3) o [LimAsignado(Cliente1,IF(EqStr(ESPECIE,'ARP'),'RE04','RE43'),'USD',,,,,,,,,,,PLAZO)>=(LimConsumido(CLIENTE1,IF(EqStr(ESPECIE,'ARP'),'RE04','RE43'),'USD',0,VEHICULO1,,,NROPERACION,,,,,,,,,PLAZO) + TotalAux1)];'Sub-Limite de Renovacion Excedido en U$D '~PYC(((LimConsumido(CLIENTE1,IF(EqStr(ESPECIE,'ARP'),'RE04','RE43'),'USD',0,VEHICULO1,,,NROPERACION,,,,,,,,,PLAZO) + TotalAux1)-LimAsignado(Cliente1,IF(EqStr(ESPECIE,'ARP'),'RE04','RE43'),'USD',,,,,,,,,,,PLAZO)),1,0)~'.-';SI;SI;FSYS;'LIEXCE';;;2
[NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o Vacio(NrOperacion3) o [LimAsignado(Cliente1,IF(EqStr(ESPECIE,'ARP'),'RE04','RE43'),'USD',,,,,,,,,,,)>=(LimConsumido(CLIENTE1,IF(EqStr(ESPECIE,'ARP'),'RE04','RE43'),'USD',0,VEHICULO1,,,NROPERACION,,,,,,,,,) + TotalAux1)];'Sub-Limite de Renovacion Excedido en U$D '~PYC(((LimConsumido(CLIENTE1,IF(EqStr(ESPECIE,'ARP'),'RE04','RE43'),'USD',0,VEHICULO1,,,NROPERACION,,,,,,,,,) + TotalAux1)-LimAsignado(Cliente1,IF(EqStr(ESPECIE,'ARP'),'RE04','RE43'),'USD',,,,,,,,,,,)),1,0)~'.-';SI;SI;FSYS;'LIEXCE';;;2

LIMITES
FechaOp;Cliente1;IF(EqStr(ESPECIE,'ARP'),'04','43')  ;'USD';;TotalAux1              ;TipoOp~' '~Especie  ; NoVacio(Cliente1) y FechaVto >= Fsys y [VPRE8 = VPRE7]                                 y FechaOp<=FSys ;Vehiculo1;;;;;;;;;;Plazo
FechaOp;Cliente1;IF(EqStr(ESPECIE,'ARP'),'RE04','RE43');'USD';;TotalAux1              ;TipoOp~' '~Especie; NoVacio(Cliente1) y FechaVto >= Fsys y [(VPRE8 - VPRE7)>=TotalAux1]                    y FechaOp<=FSys ;Vehiculo1;;;;;;;;;;Plazo
FechaOp;Cliente1;IF(EqStr(ESPECIE,'ARP'),'RE04','RE43');'USD';;(VPRE8-VPRE7)          ;TipoOp~' '~Especie; NoVacio(Cliente1) y FechaVto >= Fsys y [(VPRE8 - VPRE7)< TotalAux1] y [VPRE8 <> VPRE7] y FechaOp<=FSys ;Vehiculo1;;;;;;;;;;Plazo
FechaOp;Cliente1;IF(EqStr(ESPECIE,'ARP'),'04','43')  ;'USD';;TotalAux1-(VPRE8-VPRE7);TipoOp~' '~Especie  ; NoVacio(Cliente1) y FechaVto >= Fsys y [(VPRE8 - VPRE7)< TotalAux1] y [VPRE8 <> VPRE7] y FechaOp<=FSys ;Vehiculo1;;;;;;;;;;Plazo

FechaOp;Cliente1;'CREDIT';'USD';;TotalAux1;TipoOp~' '~Especie; NoVacio(Cliente1) y FechaVto >= Fsys y FechaOp<=FSys;Vehiculo1;

FechaOp;Cliente5;IF(EqStr(ESPECIE,'ARP'),'04','43');'USD';;TotalAux1;TipoOp~' '~Especie; NoVacio(Cliente1) y NoVacio(Cliente5) y FechaVto >= Fsys y FechaOp<=FSys;Vehiculo1;;;;;;;;;;Plazo
FechaOp;Cliente5;'CREDIT';'USD';;TotalAux1;TipoOp~' '~Especie                          ; NoVacio(Cliente1) y NoVacio(Cliente5) y FechaVto >= Fsys y FechaOp<=FSys;Vehiculo1;

MOVIMIENTOS
FechaOp ;Cliente1 ;Especie ;;;;MERCADO;Vehiculo1;1;Cantidad;;'Prestamo Aleman';SI;NO;1;NOVACIO(CLIENTE1);;;;1;'MMPR';;;;;;;;UDN1

MOVCUOTAS
CuotasL.Fecha3[Fila];Cliente1 ;Especie ;;Vehiculo1;1;-ROUND(CuotasL.Total5[Fila],2);'Vencimiento Cuota '~TIPOOP;SI;NO;;NOVACIO(CLIENTE1);;;;(Fila+1);'MMPR';;;;;;;;UDN1


CASHFLOW
FechaOp  ;Vehiculo1;;;Especie;TipoOp;; -Cantidad;3;;UDN1

CASHFLOWCUOTAS
CuotasL.Fecha3[Fila];Vehiculo1;;;Especie;TipoOp;;ROUND(CuotasL.Total1[Fila],2);3;NOVACIO(CLIENTE1) Y CuotasL.Total1[Fila]>0;UDN1

