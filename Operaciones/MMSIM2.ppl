 Plazo1   : 'Plazo'          ;NO;[NOT EQSTR(ABM,'A')];;;;;60;;Numero;'####'
 Fecha2   : 'Fin Per'        ;NO;[NOT EQSTR(ABM,'A')];;;;;90;NO;Fecha
