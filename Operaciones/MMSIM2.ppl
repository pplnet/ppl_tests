 Precio2  : 'Tasa Interes'   ;NO;[NOT EQSTR(ABM,'A')];;;;;100;;Numero;'###,###.######'
 Precio4  : 'Spread'         ;NO;[NOT EQSTR(ABM,'A')];;;;;100;;Numero;'###,###.######'
 Precio1  : 'IVA'            ;EV;[NOT EQSTR(ABM,'A')];NOT EV o [[ROUND(CUOTASL.PRECIO1[Fila],2) <= ROUND((CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.PRECIO1[Fila],2) >= ROUND((CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe IVA Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100),2),0,2);;((CUOTASL.CANTIDAD2[Fila]*CUOTASL.TASA2[Fila]/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1))*(IMPGASTOS2/100);200;NO;Numero;'###,###,###,###,###.##';NO;NO;
 Tasa2    : 'Tasa_Int_IVA'   ; ;;;;;;100;;Numero;'###,###.######'
 Precio3  : 'WH'             ;EV;NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) Y [NOT EQSTR(ABM,'A')];NOT EV o [[ROUND(CUOTASL.PRECIO3[Fila],2) <= ROUND((CUOTASL.PRECIO7[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.PRECIO3[Fila],2) >= ROUND((CUOTASL.PRECIO7[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe WHT Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO7[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO7[Fila]*(1+Var('PORVAR')/100),2),0,2);;((CUOTASL.CANTIDAD2[Fila]*CUOTASL.TOTAL6[Fila]/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1))*(TOTALAUX1/100);200;NO;Numero;'###,###,###,###,###.##';NO;NO;
 Total6   : 'Tasa_Int_WH'    ;  ;NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));;;;;100;;Numero;'###,###.######'
 Cantidad3: 'Interes'        ;NO;[NOT EQSTR(ABM,'A')];;;;;200;NO;Numero;'###,###,###,###,###.##'
 Total9   : 'Impto.Interes'  ;EV;EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) Y [NOT EQSTR(ABM,'A')];NOT EV o [[ROUND(CUOTASL.TOTAL9[Fila],2) <= ROUND((NUM(CUOTASL.PRECIOREF1[Fila])*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.TOTAL9[Fila],2) >= ROUND((NUM(CUOTASL.PRECIOREF1[Fila])*(1-Var('PORVAR')/100)),2)]];'Importe Impuesto Interes Fuera de Rango: '~FSTR(ROUND(NUM(CUOTASL.PRECIOREF1[Fila])*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(NUM(CUOTASL.PRECIOREF1[Fila])*(1+Var('PORVAR')/100),2),0,2);;IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),CUOTASL.CANTIDAD3[Fila]*(TASAIMP1/100),0);200;NO;Numero;'###,###,###,###,###.##';NO;NO;
 Cantidad5: 'Interes Total'  ;NO;[NOT EQSTR(ABM,'A')];;;;CUOTASL.TOTAL9[Fila]+CUOTASL.CANTIDAD3[Fila]+IF(NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),CUOTASL.PRECIO3[Fila],0);200;NO;Numero;'###,###,###,###,###.##'
 Total2   : 'Monto'          ;NO;[NOT EQSTR(ABM,'A')];;;;CUOTASL.CANTIDAD4[Fila]+CUOTASL.CANTIDAD3[Fila];200;NO;Numero;'###,###,###,###,###.##'
 Total1   : 'Monto Total'    ;NO;[NOT EQSTR(ABM,'A')];;;;CUOTASL.CANTIDAD4[Fila]+CUOTASL.CANTIDAD5[Fila];200;NO;Numero;'###,###,###,###,###.##'
 Total3   : 'Tasa T.Neta'    ;NO;[NOT EQSTR(ABM,'A')];;;;;200;NO;Numero;'###,###.#####'
 Precio6  : 'MOD IVA'        ;NO;NO;;;;((CUOTASL.CANTIDAD2[Fila]*CUOTASL.TASA2[Fila]/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1))*(ImpGastos2/100);200;;Numero;'###.######'
 Precio7  : 'MOD WHT'        ;NO;NO;;;;((CUOTASL.CANTIDAD2[Fila]*CUOTASL.TOTAL6[Fila]/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1))*(TotalAux1/100);200;;Numero;'###.######'
