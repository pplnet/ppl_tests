@INDICECTAS
 Fecha4   : 'F.Reset'        ;NO;NOT EQSTR(ABM,'A') Y OPREF.PLAZO4>=0;;;;HABILES(IF(RB16=0,CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila]),-PLAZO4,TABLAFERIADOS1,SI); 90;;Fecha;;;;;;;;
