TotalBrutoCli2  : 'VNO'                        ;11;1;;NOT EV Y TOTALBRUTOCLI2=CANTIDAD;;TOTALBRUTOCLI2>0 Y [[EQSTR(ABM,'A') Y TOTALBRUTOCLI2<=VCAN2] O [NOT EQSTR(ABM,'A') Y TOTALBRUTOCLI2<=(VCAN2+VCAN1)]];'EL VNO DEBE SER MENOR O IGUAL AL VALOR NOMINAL DISPONIBLE';NO;;IF(EQSTR(ABM,'A'),IF(MODI,OPREF.CANTIDAD,VCAN2),OPREF.CANTIDAD);;;;;'###,###,###,###,###.##'
