CUOTASL.FECHA1[Fila]+1;CUOTASL.FECHA2[Fila];RB8<>4;SI;NO;TablaFeriados1;SI;SI;'INTWHT';-CUOTASL.PRECIO3[Fila];140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;Fstr(Fila,0,0);Especie;;;;;;;;
