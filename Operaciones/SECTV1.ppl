FechaVto ;Vehiculo1;Especie     ;;;;;Vehiculo1;2;       Cantidad;;'Compra de '~ESPECIE;;SI;;PaseCB=0;;Cuenta1;;7;;;Cupon1;;;;Book1;
FechaVto ;Vehiculo1;Especie     ;;;;;         ;3;       Cantidad;;'Compra de '~ESPECIE;;SI;;PaseCB=0;;Cuenta1;;8;;;Cupon1;;;;Book1

