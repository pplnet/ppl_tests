CuotasL.Fecha2[Fila];Cliente1 ;Especie;;Vehiculo1;1;IF(MB3=0, CuotasL.Total4[Fila]   ,-CuotasL.Total4[Fila])   ;'IVA '~TIPOOP        ;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;NO y CuotasL.Total4[Fila]<>0 Y CB6=1 y CUOTASL.Check1[Fila]<>1                                               ;Fila       ;Cuenta1                    ;;(Fila+11000);'CUOTAS'
