TotalDerechos   :  IF(MB3=1,'Prima','Descuento');;;2;NO;MB3<>0;;;;PRECIOEJ*(1-TOTALGASTOS);PRECIOEJ*(1-TOTALGASTOS);;;;;'###,###,###.######'
ContraEspecie   : 'Titulo'                     ;;;2;;MB3<>0;[DESCIENDEDEESPECIE(CONTRAESPECIE,'TITULO') y NOVACIO(CONTRAESPECIE) ] o [MB3=0];'Debe Ingresar un Titulo valido';NO;;;;;;;;"dbo.DESCIENDEDEESPECIE(Codigo,'TITULO') = 1"

