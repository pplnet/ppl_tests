TotalAux1       : 'Tasa WH'                    ;;;;RB6=1;RB6=1;Incluido(Fstr(TOTALAUX1,2,4),VAR('TASAWH'));'El Valor de TASA WH es Erroneo: '~VAR('TASAWH')~' ...';NO;;;;;;;'###,###.######'
TotalAux2       : 'Tasa_Int_WH'                ;;;;RB6=1;RB6=1;;;;IF(MODI,TOTALAUX2,IF(RB6=1,PRECIO1+SPREAD,0));IF(MODI,TOTALAUX2,IF(RB6=1,PRECIO1+SPREAD,0));;;;'###,###.######'
