Observac2       : 'Op.Arranger'                ;5;2;;;;NOVACIO(OBSERVAC2);'EL OPERADOR ARRANGER NO ES VALIDO';NO;;;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
