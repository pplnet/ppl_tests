CONDICIONES
FECHAOP2=Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP =Fsys;'La Fecha de Concertacion no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'

SI O [NOT EV o [CANTIDAD <= VCAN1*(1+Var('PORVAR')/100) y CANTIDAD >= VCAN1*(1-Var('PORVAR')/100)]];'CuotasPartes Fuera de Rango: '~FSTR(VCAN1*(1-Var('PORVAR')/100),0,7)~' y '~FSTR(VCAN1*(1+Var('PORVAR')/100),0,7);NO
SI O [NOT EV o [TOTALNETOCLI1 <= VCAN2*(1+Var('PORVAR')/100) y TOTALNETOCLI1 >= VCAN2*(1-Var('PORVAR')/100)]];'Efectivo Fuera de Rango: '~FSTR(VCAN2*(1-Var('PORVAR')/100),0,7)~' y '~FSTR(VCAN2*(1+Var('PORVAR')/100),0,7);NO
PRECIO1<=PRECIO4*(1+VAR('RPRECIO') /100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO') /100);'Tipo de Cambio FUERA DE RANGO: '~FSTR(PRECIO4*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO')/100),1,7)  ;SI;SI;FSYS;'RANGOPRECIO'
PRECIO1=0 O PRECIO1<=PRECIO4*(1+VAR('RPRECIO2')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO2')/100);'Tipo2 de Cambio Fuera de Rango: '~FSTR(PRECIO4*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO2')/100),1,7);SI;SI;FSYS;'RANGOPRECIO2'

SI O VACIO(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR)) O  VERIFICAPERFIL(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR),'TO'~TIPOOP);'Operador no habilitado para ingresar Operaciones del Tipo '~TIPOOP;NO
Vacio(Cliente1) o EqStr(BuscarCampo('CLIENTES','Status','Codigo',CLIENTE1),'HAB');'El Cliente No esta Habilitado';NO
Eqstr(TipoOp, 'MRO') O EqStr(BuscarCampo('ESPECIES','Status','Codigo',ESPECIE),'HAB');'La Especie No esta Habilitada';NO
NOT EQSTR (VEHICULO1,CLIENTE1);'El Cliente y el Vehiculo deben ser distintos';NO
ESTERMINAL(VEHICULO1,VEHICULO);'El Vehiculo debe ser Terminal';NO
ESTERMINAL(CLIENTE1,CLIENTE);'El Cliente debe ser Terminal';NO
INSTANCIA=1 o INSTANCIA=2 o ESEVENTUAL;'Instancia de Carga Incorrecta !!!';SI
FECHAOP2<=Fsys O Incluido(TipoOp, 'FXREPV|MODIF|POSOPE');'La Fecha de Concertacion no puede ser futuro';NO



SI O Incluido(ContraEspecie, VTXT40~'|'~Var('MONEEXTR')) o NoVacio(VTXT18);'El Vehiculo no tiene Book Default para Monedas';NO
SI O Incluido(ContraEspecie, VTXT40~'|'~Var('MONEEXTR')) o NoVacio(VTXT19);'El Book default '~VTXT18~' no es valido';NO
SI O Incluido(ContraEspecie, VTXT40~'|'~Var('MONEEXTR')) o EqStr(VTXT20,Vehiculo1);'El Book default '~VTXT18~' corresponde a otro vehiculo';NO


EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

