  Tasa1      : 'Tasa Amort'      ;SUM(CUOTASL, 24)=0;  ;CUOTASL.TASA1[Fila]>=0;'La Tasa de Amortizacion debe SER POSITIVA';IF(VACIO(OPERACIONREF) o CUOTAS2=0 o OPREF.RB6<=0,if(EqStr(ABM,'A'),(100/CUOTAS1),CUOTASL.TASA1[Fila]),IF(Fila>1,QUERY("SELECT Tasa1 FROM "~DBO~".CUOTAS Where NrOperacion='"~OPERACIONREF~"' and NrCuota="~Fstr(Fila+CUOTAS2-1,0,0)~" "),QUERY("SELECT Sum(Tasa1) FROM "~DBO~".CUOTAS Where NrOperacion='"~OPERACIONREF~"' and NrCuota<="~Fstr(Fila+CUOTAS2-1,0,0)~" ")));IF(VACIO(OPERACIONREF) o CUOTAS2=0 o OPREF.RB6<=0,if(EqStr(ABM,'A'),IIF(CB2=1  Y SUM(CUOTASL, 24)>0 THEN (CUOTASL.TASA6[Fila]-CUOTASL.TASA6[Fila]) + CUOTASL.TASA7[Fila] / CUOTASL.TASA8[Fila] * 100 ELSE CUOTASL.CANTIDAD1[Fila]*100/CANTIDAD ENDIF),CUOTASL.TASA1[Fila]),IF(Fila>1,QUERY("SELECT Tasa1 FROM "~DBO~".CUOTAS Where NrOperacion='"~OPERACIONREF~"' and NrCuota="~Fstr(Fila+CUOTAS2-1,0,0)~" "),QUERY("SELECT Sum(Tasa1) FROM "~DBO~".CUOTAS Where NrOperacion='"~OPERACIONREF~"' and NrCuota<="~Fstr(Fila+CUOTAS2-1,0,0)~" ")));100;;Numero;'###,###.######';NO;SI;'2;29;30';;
  Cantidad1  : 'Imp Amort'       ;[EqStr(ABM,'A') O CB2=0] Y SUM(CUOTASL, 24)=0;;CUOTASL.CANTIDAD1[Fila]>=0;'El Importe Amortizacion debe SER POSITIVO';IF(OPREF.RB6<>1,(CUOTAS2-CUOTAS2)+(CANTIDADORI+(CANTIDADORI*VCAN10/100))*(100/CUOTAS1)/100,CUOTAS2-CUOTAS2+(CANTIDADORI+(CANTIDADORI*VCAN10/100))*CUOTASL.TASA1[Fila]/100)*CUOTASL.COEFICIENTE[Fila] ;IF(CB2=1 Y SUM(CUOTASL, 24)>0,CUOTAS2-CUOTAS2+CUOTASL.CANTIDAD2[Fila]*CUOTASL.TASA1[Fila]/100,(CUOTAS2-CUOTAS2+(CANTIDADORI+(CANTIDADORI*VCAN10/100))*CUOTASL.TASA1[Fila]/100)*CUOTASL.COEFICIENTE[Fila]);200;;Numero;'###,###,###,###,###.##';NO;SI;'1'
  Plazo1     : 'Plazo'           ;  ;  ;CUOTASL.PLAZO1[Fila]>0;'El Plazo DEBE SER POSITIVO';IF(NOVACIO(OPERACIONREF) Y OPREF.RB6=0,IF(Fila<OPREF.CUOTAS1,OPREF.PLAZO2,PLAZO-(OPREF.PLAZO2*(OPREF.CUOTAS1-1))),IF(VACIO(OPERACIONREF) O OPREF.RB6<0,IF(Fila=CUOTAS1 Y (PLAZO MOD CUOTAS1)<>0,(PLAZO DIV CUOTAS1)+(PLAZO MOD CUOTAS1),(PLAZO DIV CUOTAS1)),CUOTASL.FECHA2[Fila]-CUOTASL.FECHA1[Fila]));CUOTASL.FECHA2[Fila]-CUOTASL.FECHA1[Fila]; 60;  ;Numero;'####';NO;NO;'5;4'
  Fecha1     : 'F.Origen'        ;  ;  ;SI O [ESHABIL(CUOTASL.FECHA1[Fila],TABLAFERIADOS1) Y ESHABIL(CUOTASL.FECHA1[Fila],'ARG')];'La Fecha Origen de la Cuota '~Fstr(Fila, 0, 0)~' No es HABIL';IF(Fila=1,IF(Vacio(FECHAPAGO),FECHAOP,FECHAPAGO),CUOTASL.FECHA2[Fila-1]);IF(Fila=1,FECHAOP,CUOTASL.FECHA2[Fila-1]); 90;  ;Fecha;NO;NO;'5;3';;;;;RB11 = 0
  Fecha2     : 'F.Vto'           ;  ;  ;    ;    ;IF(VACIO(OPERACIONREF) O OPREF.RB6<=0,IF(Fila=CUOTAS1,FECHAVTO,CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila]),QUERY("SELECT Fecha2 FROM "~DBO~".CUOTAS Where NrOperacion='"~OPERACIONREF~"' and NrCuota="~Fstr(Fila+CUOTAS2-1,0,0)~" "));IF(VACIO(OPERACIONREF) O OPREF.RB6<=0,IF(Fila=CUOTAS1,FECHAVTO,CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila]),QUERY("SELECT Fecha2 FROM "~DBO~".CUOTAS Where NrOperacion='"~OPERACIONREF~"' and NrCuota="~Fstr(Fila+CUOTAS2-1,0,0)~" ")); 90;;Fecha;NO;NO;'3;4;6';;;;;RB11 = 0
  Fecha3     : 'F.Sett'          ;  ;  ;CUOTASL.FECHA3[Fila]>=CUOTASL.FECHA2[Fila] Y ESHABIL(CUOTASL.FECHA3[Fila],TABLAFERIADOS1) Y ESHABIL(CUOTASL.FECHA3[Fila],'ARG');'El Settlement No es HABIL o es Menor que el Vto';IF(Not EsHabil(CUOTASL.FECHA2[Fila], TABLAFERIADOS1) O Not EsHabil(CUOTASL.FECHA2[Fila], 'ARG'),Habiles(CUOTASL.FECHA2[Fila],1,TABLAFERIADOS1, SI), CUOTASL.FECHA2[Fila]);IF(Not EsHabil(CUOTASL.FECHA2[Fila], TABLAFERIADOS1) O Not EsHabil(CUOTASL.FECHA2[Fila], 'ARG'),Habiles(CUOTASL.FECHA2[Fila],1,TABLAFERIADOS1, SI), CUOTASL.FECHA2[Fila]);90;;Fecha;NO;NO
  Cantidad2  : 'V.Nominal'       ;NO;  ;CUOTASL.CANTIDAD2[Fila]>=0;'El Valor Nominal debe SER POSITIVO';;IF(Fila=1,(CANTIDADORI+(CANTIDADORI*VCAN10/100)),If(CB2=1 Y SUM(CUOTASL, 24)>0,CUOTASL.PRECIO2[Fila]-CUOTASL.PRECIO2[Fila]+CUOTASL.PRECIO4[Fila]-CUOTASL.PRECIO4[Fila]+CUOTASL.CANTIDAD2[Fila-1]-CUOTASL.CANTIDAD1[Fila-1]+CUOTASL.CANTIDAD9[Fila-1],CUOTASL.CANTIDAD2ORI[Fila-1]-CUOTASL.CANTIDAD1ORI[Fila-1])*CUOTASL.COEFICIENTE[Fila]);200;;Numero;'###,###,###,###,###.##'
  Precio2    : 'Tasa Interes'    ;  ;                                           ;SI O [ VACIO('OPREF') O [NOT EQSTR(TIPOTASA,'FIJA') Y Fila>1  Y CUOTASL.PRECIO2[Fila]=0] O [CUOTASL.PRECIO2[Fila]>0] O [Fila=1 Y CUOTASL.PRECIO2[Fila]>=0 Y NOT EQSTR(TIPOTASA,'FIJA') Y RB16 = 1]] ;'TASA INVALIDA O FALTA TASA'                                        ;;IF(VACIO(OPERACIONREF),IF(EQSTR(TIPOTASA,'FIJA'),PRECIO1, IF(Eqstr(CampoEditado, 'TIPOTASA'), CUOTASL.PRECIO2[Fila],0)),OPREF.PRECIO1);100;;Numero;'###,###.######';NO;SI;'16;9;11'
  Precio4    : 'Spread'          ;  ;VACIO('OPREF') O NOT EQSTR(TIPOTASA,'FIJA');EQSTR(TIPOTASA,'FIJA') O [NOT EQSTR(TIPOTASA,'FIJA') Y CUOTASL.PRECIO4[Fila]=0] O [NOT EQSTR(TIPOTASA,'FIJA') Y CUOTASL.PRECIO4[Fila]>=VAR('RSPREAD1') Y CUOTASL.PRECIO4[Fila]<=VAR('RSPREAD2')];'El Spread esta Fuera de Rango:'~VAR('RSPREAD1')~' '~VAR('RSPREAD2');;IF(VACIO(OPERACIONREF),IF(EQSTR(TIPOTASA,'FIJA'),CUOTASL.PRECIO4[Fila],SPREAD),OPREF.SPREAD) ;100;;Numero;'###,###.######';NO;SI;'16;9;11'
  Tasa2      : 'Tasa_Int_IVA'    ;  ;VACIO('OPREF') O RB6=1;;;;IF(RB6=1,CUOTASL.PRECIO2[Fila]+CUOTASL.PRECIO4[Fila]);100;  ;Numero;'###,###.######';NO;NO;'10;7;8'
  Total4     : 'Importe_Iva'     ;EV;;SI O NOT EV o [[ROUND(CUOTASL.TOTAL4[Fila],2) <= ROUND((CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.TOTAL4[Fila],2) >= ROUND((CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe IVA Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(RB6=1,((((CUOTASL.CANTIDAD2[Fila]*CUOTASL.TASA2[Fila]/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1))+CUOTASL.CANTIDAD6[Fila])*(IMPGASTOS2/100)), ((CUOTASL.CANTIDAD2[Fila]*((CUOTASL.PRECIO2[Fila]+CUOTASL.PRECIO4[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1)))*(IMPGASTOS2/100));200;NO;Numero;'###,###,###,###,###.##';NO;NO;'9';
  Especie1   : 'Especie_CEC'     ;  ;VACIO('OPREF') O RB6=1;[RB6<>1] O [RB6=1 Y PRECIO3=0 Y VACIO(CUOTASL.ESPECIE1[Fila])] O [RB6=1 Y PRECIO3<>0 Y VACIO(CUOTASL.ESPECIE1[Fila]) Y Fila>1] O [RB6=1 Y PRECIO3<>0 Y NOVACIO(CUOTASL.ESPECIE1[Fila])];'COMISION CEC INCORRECTA';;;90;NO;Tabla;'Especies';'Codigo';'Codigo;Nombre'
  Cantidad5  : 'Imp.Fijo_CEC'    ;  ;VACIO('OPREF') O RB6=1;[RB6<>1] O [RB6=1 Y NOT[PRECIO3=0 Y CUOTASL.CANTIDAD5[Fila]<>0]];'IMPORTE FIJO CEC INCORRECTO';;IF(RB6=1,CUOTASL.CANTIDAD5[Fila],0);200;  ;Numero;'###,###,###,###,###.##'
  Total5     : 'Tasa_Base_CEC'   ;  ;VACIO('OPREF') O RB6=1;[RB6<>1 Y CUOTASL.TOTAL5[Fila]=0] O [RB6=1 Y CUOTASL.TOTAL5[Fila]=0 Y PRECIO3=0] O [RB6=1 Y CUOTASL.TOTAL5[Fila]>0 Y PRECIO3>0] O [RB6=1 Y CUOTASL.TOTAL5[Fila]=0 Y PRECIO3>0 Y Fila>1];'TASA BASE CEC INCORRECTA';;IF(RB6=1,CUOTASL.TOTAL5[Fila],0);200;  ;Numero;'###,###.######'
  Cantidad4  : 'Imp.Var._CEC'    ;EV;VACIO('OPREF') O RB6=1;NOT EV o [[ROUND(CUOTASL.CANTIDAD4[Fila],2) <= ROUND((CUOTASL.PRECIO7[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.CANTIDAD4[Fila],2) >= ROUND((CUOTASL.PRECIO7[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe Variable CEC Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO7[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO7[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(RB6=1,((CUOTASL.CANTIDAD2[Fila]*CUOTASL.TOTAL5[Fila]*CUOTASL.PLAZO1[Fila])/IF(MB1=0,36000,36500))*(PRECIO3/100),0);200;NO;Numero;'###,###,###,###,###.##';NO;NO
  Cantidad6  : 'Imp.Tot._CEC'    ;NO;VACIO('OPREF') O RB6=1;;;;IF(RB6=1, CUOTASL.CANTIDAD5[Fila]+CUOTASL.CANTIDAD4[Fila], 0);200;  ;Numero;'###,###,###,###,###.##'
  Cantidad7  : 'Imp_Cs_Fin_CEC'  ;EV;VACIO('OPREF') O RB6=1;NOT EV o [[ROUND(CUOTASL.CANTIDAD7[Fila],2)<=ROUND((NUM(CUOTASL.CANTIDAD8[Fila])*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.CANTIDAD7[Fila],2)>=ROUND((NUM(CUOTASL.CANTIDAD8[Fila])*(1-Var('PORVAR')/100)),2)]];'Impuesto Costo Financiero CEC Fuera de Rango: '~FSTR(ROUND(NUM(CUOTASL.CANTIDAD8[Fila])*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(NUM(CUOTASL.CANTIDAD8[Fila])*(1+Var('PORVAR')/100),2),0,2);;If(RB6=1,CUOTASL.CANTIDAD6[Fila]*(DELTATASA/100),0);200;NO;Numero;'###,###,###,###,###.##';NO;NO;
  Cantidad3  : 'Interes'         ;EV;  ;SI O NOT EV o [[ROUND(CUOTASL.CANTIDAD3[Fila],2) <= ROUND((CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.CANTIDAD3[Fila],2) >= ROUND((CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100)),2)]];'Interes Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(Fila<PlazoGracia,0,CUOTASL.CANTIDAD2[Fila]*((CUOTASL.PRECIO4[Fila]+CUOTASL.PRECIO2[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1));200;NO;Numero;'###,###,###,###,###.##';NO;NO;'8;9';
  Cantidad9  : 'Int Capit'       ;NO;CB2=1;;;;CUOTASL.CANTIDAD3[Fila]*CUOTASL.TASA6[Fila]/100;200;NO;Numero;'###,###,###,###,###.##';NO;NO;;
  Total3     : 'Interes Total'   ;NO;  ;;;;CUOTASL.CANTIDAD7[Fila]+CUOTASL.TOTAL9[Fila]+CUOTASL.CANTIDAD3[Fila]+IF(RB6=1,CUOTASL.CANTIDAD6[Fila],0);200;  ;Numero;'###,###,###,###,###.##'
  Total9     : 'Impto.Interes'   ;EV;VACIO('OPREF') O RB6>=0;NOT EV o [[ROUND(CUOTASL.TOTAL9[Fila],2) <= ROUND((NUM(CUOTASL.PRECIOREF1[Fila])*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.TOTAL9[Fila],2) >= ROUND((NUM(CUOTASL.PRECIOREF1[Fila])*(1-Var('PORVAR')/100)),2)]];'Importe Impuesto Interes Fuera de Rango: '~FSTR(ROUND(NUM(CUOTASL.PRECIOREF1[Fila])*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(NUM(CUOTASL.PRECIOREF1[Fila])*(1+Var('PORVAR')/100),2),0,2)   ;;IF(TASAIMP1<>0,IF((VAR('DEFAINT')*CUOTASL.CANTIDAD3[Fila]/100)>((CUOTASL.CANTIDAD2[Fila]*(VAR('TASAIMPINT')/100)*CUOTASL.PLAZO1[Fila])/365),((CUOTASL.CANTIDAD2[Fila]*(VAR('TASAIMPINT')/100)*CUOTASL.PLAZO1[Fila])/365),CUOTASL.CANTIDAD3[Fila]*(TASAIMP1/100)), 0);200;NO;Numero;'###,###,###,###,###.##';NO;NO;
  Fecha4     : 'F.SeteoTasa'     ;NO;NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA);;;;HABILES(IF(RB16=0,CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila]),-PLAZO4,TABLAFERIADOS1,SI); 90;;Fecha;NO;NO;;;;;;
  Cotizacion2: 'Tasa N.Neta'     ;NO;NOT EQSTR(TIPOTASA,'FIJA');;;  ;CUOTASL.PRECIO2[Fila]+CUOTASL.PRECIO4[Fila];100;;Numero;'###,###.######'
  Precio3    : 'Tasa T.Neta'     ;NO;  ;;;  ;;200;  ;Numero;'###.######'
  Tasa6      : '% Capit'         ;SI O EqStr(ABM,'A');CB2=1;CUOTASL.TASA6[Fila]>=0 ;;;;100;;Numero;'###,###.######';;;'1;7';
  Tasa7      : '% Amort Orig'    ;NO;SI;;;IF(VACIO(OPERACIONREF) o CUOTAS2=0 o OPREF.RB6<=0,if(EqStr(ABM,'A'),(100/CUOTAS1),CUOTASL.TASA1[Fila]),IF(Fila>1,QUERY("SELECT Tasa1 FROM "~DBO~".CUOTAS Where NrOperacion='"~OPERACIONREF~"' and NrCuota="~Fstr(Fila+CUOTAS2-1,0,0)~" "),QUERY("SELECT Sum(Tasa1) FROM "~DBO~".CUOTAS Where NrOperacion='"~OPERACIONREF~"' and NrCuota<="~Fstr(Fila+CUOTAS2-1,0,0)~" ")));IF(SUM(CUOTASL, 24)=0, CUOTASL.TASA1[Fila], CUOTASL.TASA7[Fila]);100;;Numero;'###,###.######';NO;NO;
  Tasa8      : '% Amort Rest'    ;NO;SI;;;;IF(Fila=1, 100, CUOTASL.TASA8[Fila-1] - CUOTASL.TASA7[Fila-1]);100;;Numero;'###,###.######'
  Cantidad10 : 'V Nominal Ori'   ;NO;SI;;;CUOTASL.CANTIDAD2[Fila];(CANTIDAD+TOTALCOMISIONES)*CUOTASL.TASA8[Fila]/100;200;;Numero;'###,###,###,###,###.##'
  Total2     : 'Monto'           ;NO;  ;;;  ;(CUOTASL.CANTIDAD1[Fila]+CUOTASL.CANTIDAD3[Fila]);200;  ;Numero;'###,###,###,###,###.##'
  Total1     : 'Monto Total'     ;NO;  ;;;  ;(CUOTASL.CANTIDAD1[Fila]+CUOTASL.TOTAL3[Fila]);200;  ;Numero;'###,###,###,###,###.##'
  Precio5    : 'MOD INT'         ;NO;NO;;;IF(Fila<PlazoGracia,0,CUOTASL.CANTIDAD2[Fila]*((CUOTASL.PRECIO4[Fila]+CUOTASL.PRECIO2[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1));IF(Fila<PlazoGracia,0,CUOTASL.CANTIDAD2[Fila]*((CUOTASL.PRECIO4[Fila]+CUOTASL.PRECIO2[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1));200;  ;Numero;'###,###,###,###,###.##'
  Precio6    : 'MOD IVA'         ;NO;NO;;;IF(RB6=1,((((CUOTASL.CANTIDAD2[Fila]*CUOTASL.TASA2[Fila]/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1))+CUOTASL.CANTIDAD6[Fila])*(IMPGASTOS2/100)), ((CUOTASL.CANTIDAD2[Fila]*((CUOTASL.PRECIO2[Fila]+CUOTASL.PRECIO4[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1)))*(IMPGASTOS2/100));IF(RB6=1,((((CUOTASL.CANTIDAD2[Fila]*CUOTASL.TASA2[Fila]/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1))+CUOTASL.CANTIDAD6[Fila])*(IMPGASTOS2/100)), ((CUOTASL.CANTIDAD2[Fila]*((CUOTASL.PRECIO2[Fila]+CUOTASL.PRECIO4[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1)))*(IMPGASTOS2/100));200;  ;Numero;'###,###,###,###,###.##'
  Precio7    : 'MOD VAR CEC'     ;NO;NO;;;  ;IF(RB6=1,((CUOTASL.CANTIDAD2[Fila]*CUOTASL.TOTAL5[Fila]*CUOTASL.PLAZO1[Fila])/IF(MB1=0,36000,36500))*(PRECIO3/100),0);200;  ;Numero;'###.######'
  Cotizacion1: 'TC_IVA'          ;NO;NO;;;-1;-1;200;  ;Numero;'###.######'
  PrecioRef1 : 'MOD Impto.Inter.';NO;NO;;;  ;Fstr(CUOTASL.CANTIDAD3[Fila]*TASAIMP1/100,0,2);200;NO;String;
  Cantidad8  : 'Imp_Cs_Fin_CEC'  ;NO;NO;;;  ;If(RB6=1,CUOTASL.CANTIDAD6[Fila]*(DELTATASA/100),0);200;NO;Numero;'###,###,###,###,###.##';NO;NO;
  Cantidad12 : 'Saldo VN Amort.' ;NO;SI;;;;CUOTASL.CANTIDAD1[Fila];200;NO;Numero;'###,###,###,###,###.##';NO;NO;
  Check9     : 'Afec.Dev.Saldo'  ;NO;SI;;;0;;50;;Check;;;;;;;;SI
@INDICECTAS


@COMIOP

CONDICIONES
[CB10=0 Y RB6<=1 Y DESCIENDEDECLIENTE(CLIENTE1,'BANCOS')] O [DESCIENDEDECLIENTE(CLIENTE1,'EMPRESAS') Y RB6=0 Y CB10=0];'Entidad Contratante Invalida => FONDEO LOCAL: Entidad o Banco, FONDEO EXTR: Banco ';NO
RB6<>2 O [RB6=2 Y DESCIENDEDECLIENTE(CLIENTE2,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE2))] ;'La Entidad Negociadora debe ser un Banco Local';NO
ESHABIL(FECHAOP,'ARG');'La Fecha de Origen no es Dia Habil en Argentina';SI;SI;FSYS;'ORIGINH'
ESHABIL(FECHAVTO,'ARG');'La Fecha de Vencimiento NO ES DIA HABIL en Argentina';SI;SI;FSYS;'VTOINH'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'La Entidad Contratante esta Deshabilitada';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'La Entidad Contratante esta Observada';SI;SI;FSYS;'CLIOBS'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE2));'La Entidad Negociadora esta deshabilitada';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE2));'La Entidad Negociadora esta Observada';SI;SI;FSYS;'CLIOBS'
SI O [VACIO(NROPERACION2) O [EQSTR(TIPOOP,BuscarCampo('Operaciones','TipoOp','NrOperacion',NROPERACION2)) y BuscarCampo('Operaciones','FechaVto','NrOperacion',NROPERACION2)=Fsys y EQSTR(BuscarCampo('Operaciones','Vehiculo1','NrOperacion',NROPERACION2),VEHICULO1) y EQSTR(ESPECIE,BuscarCampo('Operaciones','Especie','NrOperacion',NROPERACION2))]];'La Operacion de Referencia es INVALIDA';NO
RB6>2 O [Incluido(Fstr(ImpGastos2,2,2),VAR('IVA'))];'El Valor de TASA IVA es Erroneo: '~VAR('IVA');NO
VACIO(OPERACIONREF) O [OPREF.MB3=0 Y OPREF.MB5<=1 y OPREF.PRECIOEJ>=(OPREF.TOTALAUX3-VCAN1+PRECIOEJ)];'La Partida '~OPERACIONREF~' No se puede Asociar a esta Operacion';NO
VACIO(OPERACIONREF) O [FECHAOP>=OPREF.FECHAOP Y FECHAOP<=OPREF.FECHAVTO];'LA FECHA DE ORIGEN DEBE ESTAR INCLUIDA EN EL PLAZO DE LA PARTIDA';NO
ROUND(SUM(CUOTASL,1),2)=100 O CB2=1;' La Sumatoria de La Tasa de Amortizacion debe ser el %100';NO
SUM(CUOTASL,3)=PLAZO O NOVACIO(FECHAPAGO);'LA SUMATORIA DE LOS PLAZOS PARCIALES DEBE SER IGUAL AL PLAZO TOTAL';NO
FECHAOP2=Fsys;'La Fecha de Concertacion no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
@CONDIOP
@CONDBOOK

CONDICIONESCUOTAS
SI O [CUOTASL.PRECIO2[Fila]>=VPRE11 Y CUOTASL.PRECIO2[Fila]<=VPRE12];'La Tasa de la Cuota '~Fstr(Fila, 0, 0)~' esta fuera de rango' ;SI;SI;FSYS;'RTASA';
CUOTASL.PRECIO2[Fila]>=VAR('RTASA1') Y CUOTASL.PRECIO2[Fila]<=VAR('RTASA2');'La Tasa de la Cuota '~Fstr(Fila, 0, 0)~' esta fuera de rango' ;SI;SI;FSYS;'RTASA';

MOVIMIENTOS
FechaOp   ;Cliente1;Especie ;;;;;Vehiculo1;1; -PrecioEj;;'Alta Pmo. en Ctas. Locales';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;1;

POSICION
FechaOp;Vehiculo1;Especie;;;;Vehiculo1;;;;;122; PrecioEj;COTIZACIONC(ESPECIE,,,,FECHAOP-1,1,SI,VTXT40);;;VTXT19;;'FXS';Not Incluido(Especie,VTXT40~"|"~VAR('MONEEXTR'));
FechaOp;Vehiculo1;Especie;;;;Vehiculo1;;;;;132; PrecioEj;COTIZACIONC(ESPECIE,,,,FECHAOP-1,1,SI,VAR('MONEEXTR'));;;VTXT19;;'FXS';Not Incluido(Especie,VTXT40~"|"~VAR('MONEEXTR'));

MOVCUOTAS
CuotasL.Fecha3[Fila];Cliente1;Especie;;Vehiculo1;1;CuotasL.Cantidad1[Fila];'Vto. Pmo. en Ctas. Locales';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;(Fila+500);Cuenta1;;(Fila+500);'CUOTAS'
CuotasL.Fecha3[Fila];Cliente1;Especie;;Vehiculo1;1;CuotasL.Cantidad3[Fila] - CuotasL.Cantidad9[Fila];'Int. Pmo. en Ctas. Locales';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;(Fila+5000);Cuenta1;;(Fila+5000);'CUOTAS'
CuotasL.Fecha3[Fila];Cliente1;Especie;;Vehiculo1;1;CuotasL.Cantidad9[Fila];'Int.Cap. Pmo. Ctas. Locales';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;(Fila+ 5500);Cuenta1;;(Fila+ 5500);'CUOTAS'
CuotasL.Fecha3[Fila];Cliente1;If(CuotasL.Cotizacion1[Fila]<0,Especie,VAR('MONELOCA'));;Vehiculo1;1; CuotasL.Cantidad7[Fila]*If(CuotasL.Cotizacion1[Fila]<0,1,CuotasL.Cotizacion1[Fila]);'Costo Financiero CEC';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;CuotasL.Cantidad7[Fila]<>0 Y NO;Fila;Cuenta3;;(Fila+2500);'CUOTAS'
CuotasL.Fecha3[Fila];Cliente1;If(CuotasL.Cotizacion1[Fila]<0,Especie,VAR('MONELOCA'));;Vehiculo1;1; CuotasL.Total9[Fila]*If(CuotasL.Cotizacion1[Fila]<0,1,CuotasL.Cotizacion1[Fila]);'Impto.Int Pmo. en Ctas. Locales';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;CuotasL.Total9[Fila]<>0 Y NO;Fila;Cuenta3;;(Fila+2000);'CUOTAS'
CuotasL.Fecha3[Fila];Cliente1;If(CuotasL.Cotizacion1[Fila]<0,Especie,VAR('MONELOCA'));;Vehiculo1;1; CuotasL.Total4[Fila]*If(CuotasL.Cotizacion1[Fila]<0,1,CuotasL.Cotizacion1[Fila]);'IVA  Pmo. en Ctas. Locales';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;CuotasL.Total4[Fila]<>0;Fila;Cuenta3;;(Fila+1000);'CUOTAS'
CuotasL.Fecha3[Fila];Cliente1;CuotasL.Especie1[Fila];;Vehiculo1;1; CuotasL.Cantidad6[Fila];'Vto. Comision CEC';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;CuotasL.Cantidad6[Fila]<>0 Y NO;Fila;Cuenta1;;(Fila+1000);'CUOTAS'

POSCUOTAS
CuotasL.Fecha2[Fila];Vehiculo1;Especie;;;;Vehiculo1;;;;;122;-CuotasL.Cantidad1[Fila];COTIZACIONC(ESPECIE,,,,CuotasL.Fecha2[Fila]-1,1,SI,VTXT40);;;VTXT19;;'FXS';Not Incluido(Especie,VTXT40~"|"~VAR('MONEEXTR'));
CuotasL.Fecha2[Fila];Vehiculo1;Especie;;;;Vehiculo1;;;;;132;-CuotasL.Cantidad1[Fila];COTIZACIONC(ESPECIE,,,,CuotasL.Fecha2[Fila]-1,1,SI,VAR('MONEEXTR'));;;VTXT19;;'FXS';Not Incluido(Especie,VTXT40~"|"~VAR('MONEEXTR'));
CuotasL.Fecha2[Fila];Vehiculo1;Especie;;;;Vehiculo1;;;;;122;-CuotasL.Cantidad3[Fila];COTIZACIONC(ESPECIE,,,,CuotasL.Fecha2[Fila]-1,1,SI,VTXT40);;;VTXT19;;'FXS';Not Incluido(Especie,VTXT40~"|"~VAR('MONEEXTR'));
CuotasL.Fecha2[Fila];Vehiculo1;Especie;;;;Vehiculo1;;;;;132;-CuotasL.Cantidad3[Fila];COTIZACIONC(ESPECIE,,,,CuotasL.Fecha2[Fila]-1,1,SI,VAR('MONEEXTR'));;;VTXT19;;'FXS';Not Incluido(Especie,VTXT40~"|"~VAR('MONEEXTR'));

DEVENGADOSCUOTAS
CUOTASL.FECHA1[Fila]+1;CUOTASL.FECHA2[Fila];RB8<>4;SI;NO;TablaFeriados1;SI;SI;'INTLEN';-CUOTASL.CANTIDAD3[Fila];140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;Fstr(Fila,0,0);Especie;;;;;;;;
CUOTASL.FECHA1[Fila];CUOTASL.FECHA2[Fila]-1;RB8=4 ;SI;NO;TablaFeriados1;SI;SI;'INTLEN';-CUOTASL.CANTIDAD3[Fila];140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;Fstr(Fila,0,0);Especie;2;CUOTASL.CANTIDAD2[Fila];(CUOTASL.PRECIO2[Fila]+CUOTASL.PRECIO4[Fila]);360;NO;;5;


EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador
VACIO(OPERACIONREF);'No se puede dar de baja, Operacion Relacionada con Partida'

REFERENCIA
'TotalAux3='~FStr(OPREF.TotalAux3-VCAN1+Cantidad+TotalComisiones,0,2)

SQL
"UPDATE "~DBO~".COMISIONES2 Set Fecha1='"~IdxDate(FECHAOP)~"' Where NrOperacion='"~OPERACIONREF~"' and Tipo='0' and Fecha1 Is Null ";EqStr(ABM,'A') y QUERY("SELECT COUNT(*) FROM "~DBO~".COMISIONES2 WHERE NrOperacion='"~OPERACIONREF~"' and Tipo='0' ")>0 Y OPREF.TOTALAUX3=0;

POSTEDICION
NOVACIO(OPERACIONREF) y EQSTR(ABM,'A');'INCOMV';NrOperacion1=OPERACIONREF;NrOperacion2=NROPERACION;String=" Tipo  IN ('5','3')";String1=""
NOVACIO(OPERACIONREF) y EQSTR(ABM,'A');'ACTMOV';Vehiculo1=VEHICULO1;Fecha1=FECHAOP;Fecha2=FECHAOP;NrOperacion1=NROPERACION;TipoOp1=TIPOOP;Especie1=ESPECIE;Radio1=-1;Radio2=0
@POSTEMM

@INSTOPE
@INST19MM
@INST19BITS