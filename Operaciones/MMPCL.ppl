CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp2        : 'Fecha Conc.'                ;1;1;;VERIFICAACCESO('OPFVALOR');;FECHAOP2<=FECHAOP;'LA FECHA DE CONCERTACION DEBE SER <= A LA FECHA DE ORIGEN';NO;FSYS;
FechaOp         : 'Fecha_Origen'               ;2;1;;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1);'La Fecha de Origen no es Habil en la Tabla de Feriados Seleccionada';RB11 = 0;FSYS;
RB10            : 'Precancelable|Si|No'        ;;;;;NO;RB10>=0;'Precancelable Si/No';NO;1; 
@VEHITO
OperacionRef    : 'Id_Partida'                 ;3;2;1;;;VACIO(OPERACIONREF) O [EqStr(BuscarCampo('Operaciones','TipoOp','NrOperacion',OPERACIONREF),'MMP')];'El Codigo de Id. Partida es Incorrecto';NO;;;;
VCAN2           : 'VN_Disponible'              ;;;;NO;NOVACIO(OPERACIONREF);VACIO(OPERACIONREF) O VCAN2+VCAN1>0;'La Partida '~OPERACIONREF~' Fue Completamente Asignada';NO;;(OPREF.PRECIOEJ-OPREF.TOTALAUX3);;;;;'###,###,###,###,###.##'
RB6             : 'Fondeo|Local|Extranjero'    ;;;;NOT EV y VACIO(OPERACIONREF);;RB6>=0;'Indique Tipo de Caso';NO;;IF(VACIO(OPERACIONREF),RB6,OPREF.MB5);
Cliente1        : 'Ent_Contratante'            ;4;1;;NOT EV y VACIO(OPERACIONREF);;NOVACIO(CLIENTE1); 'La Entidad Contratante es Invalida';NO;;IF(VACIO(OPERACIONREF),CLIENTE1,OPREF.CLIENTE1)
Especie         : 'Moneda'                     ;5;1;;NOT EV y VACIO(OPERACIONREF);;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'Debe Ingresar una Moneda';NO;;IF(VACIO(OPERACIONREF),ESPECIE,OPREF.ESPECIE);;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";
Cantidad        : 'Capital'                    ;;;;NOT EV;;CANTIDAD>0 Y [VACIO(OPERACIONREF) O [[EQSTR(ABM,'A') Y CANTIDAD<=VCAN2] O [NOT EQSTR(ABM,'A') Y CANTIDAD<=(VCAN2+VCAN1)]]];'El Capital DEBE SER INFERIOR AL Valor Total de la Op.Referencia';NO;;IF(CANTIDADORI<>0,CANTIDADORI*COEFICIENTE,CANTIDADORI);;;;;'###,###,###,###,###.##'
FechaVto        : 'Vto_Monto'                  ;8;1;;;;;;;FECHAOP+PLAZO;IF(INCLUIDO(CAMPOMODIFICADO,'PLAZO|FECHAOP'),FECHAOP+PLAZO,FECHAVTO)
FechaPago       : 'Vto_Sett'                   ;;;;;;FECHAPAGO >= FECHAVTO Y ESHABIL(FECHAPAGO,TABLAFERIADOS1);'Fecha Settlement Es Menor que Fecha Vto O No es Dia Habil';NO;FECHAOP+PLAZO;IF(INCLUIDO(CAMPOMODIFICADO,'PLAZO|FECHAOP|FECHAVTO|'),FECHAOP+PLAZO,FECHAPAGO)
Plazo           : 'Plazo'                      ;7;1;;;;PLAZO>0;'Debe INGRESAR el PLAZO';NO;0;FECHAVTO-FECHAOP
TipoTasa        : 'Tipo_Tasa'                  ;10;1;;VACIO(OPERACIONREF);;NOVACIO(TIPOTASA);'El Tipo de Tasa ES INVALIDO';NO;;IF(VACIO(OPERACIONREF),TIPOTASA,OPREF.TIPOTASA)
Precio1         : 'Tasa (%)'                   ;;;;;;PRECIO1>0;'La Tasa Debe ser positiva';NO;;IF(VACIO(OPERACIONREF),PRECIO1,OPREF.PRECIO1)
Precio4         : 'Tasa Total Neta'            ;;;;NO;PRECIO4>0;
RB8             : 'Day Count|ActAct|Act365F|Act360|360360|30E360' ;;;;VACIO(OPERACIONREF);;RB8>=0;'Unidad de Tiempo Tasa Interes INVALIDA';NO;2;IF(VACIO(OPERACIONREF),IF(MODI,RB8,0),OPREF.RB8)
TotalIntereses  : 'Interes'                    ;;;;EV;;NOT EV o [TotalIntereses <= ROUND(VCAN7*(1+Var('PORVAR')/100),2) y TotalIntereses >= ROUND(VCAN7*(1-Var('PORVAR')/100),2)];'Interes Fuera de Rango: '~FSTR(ROUND(VCAN7*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN7*(1+Var('PORVAR')/100),2),0,2);NO;;PRECIOEJ*((PRECIO1+SPREAD)/100)*FACTORDIAS(FECHAOP,FECHAVTO,RB8+1);;;;;'###,###,###,###,###.###########'
TotalNetoCli2   : 'Interes Total'              ;;;;NO;;;;;;TOTALINTERESES+IMPORTEIMP+IF(RB6=1,IMPCOMCOR1,0);;;;;'###,###,###,###,###.##'
TotalBrutoCli1  : 'Monto'                      ;;;;NO;;;;;;PRECIOEJ+TOTALINTERESES ;;;;;'###,###,###,###,###.##'
TotalNetoCli1   : 'Monto Total'                ;;;;NO;;;;;;PRECIOEJ+TOTALNETOCLI2;;;;;'###,###,###,###,###.##'
TotalComisiones : 'Comision EF'                ;5;2;;NO;;;;;;CANTIDAD*VCAN10/100;;;;;'###,###,###,###,###.##'
PrecioEj        : 'V. Nominal'                 ;;2;;NO;;;;;;CANTIDAD+TOTALCOMISIONES;;;;;'###,###,###,###,###.##'
ImpGastos2      : 'Tasa_IVA'                   ;;2;;VACIO(OPERACIONREF);RB6<=2;;;;VAR('TASAIVA');IF(Incluido(VEHICULO1,VAR('VEHIEXTRAN')),0,IF(VACIO(OPERACIONREF),IF(RB6<=2,IMPGASTOS2,0),OPREF.IMPGASTOS2));;;;;'###,###.######'
TotalAux4       : 'Tasa_Int_IVA'               ;;2;;;RB6=1;;;;IF(RB6=1,PRECIO1+SPREAD,0);;;;;;'###,###.######'
TotalIVA        : 'Importe_Iva'                ;;2;;EV;RB6<=2;NOT EV o [TOTALIVA<= ROUND(VCAN8*(1+Var('PORVAR')/100),2) y TOTALIVA >= ROUND(VCAN8*(1-Var('PORVAR')/100),2)];'Importe IVA Fuera de Rango: '~FSTR(ROUND(VCAN8*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN8*(1+Var('PORVAR')/100),2),0,2);NO;;IF(RB6=1,((PRECIOEJ*TOTALAUX4/100*FACTORDIAS(FECHAOP,FECHAVTO,RB8+1))+IMPCOMCOR1)*(IMPGASTOS2/100),((PRECIOEJ*((PRECIO1+SPREAD)/100)*FACTORDIAS(FECHAOP,FECHAVTO,RB8+1))+IMPCOMCOR1)*(IMPGASTOS2/100));;;;;'###,###,###,###,###.##'

Spread          :                              ;10;2;;VACIO(OPERACIONREF) Y NOT EQSTR(TIPOTASA,'FIJA');NOT EQSTR(TIPOTASA,'FIJA');SPREAD>=0;'El SPREAD Debe SER POSITIVO';NO;0;IF(VACIO(OPERACIONREF),IF(EQSTR(TIPOTASA,'FIJA'),0,SPREAD),OPREF.SPREAD)
Operador        :                              ;15;2;;;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
Observac2       : 'Op.Contraparte'             ;;2;;;;NOVACIO(OBSERVAC2);'El Operador CONTRAPARTE es INVALIDO';SI;;IF(VACIO(OPERACIONREF),OBSERVAC2,OPREF.OBSERVAC2);;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
TablaFeriados1  : 'Feriados'                   ;18;1;;VACIO(OPERACIONREF);;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;IF(VACIO(OPERACIONREF),IF(MODI,TABLAFERIADOS1,BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE))),OPREF.TABLAFERIADOS1)
NrOperacion2    : 'Op_Referencia'              ;17;2;;NO;NOVACIO(NROPERACION2);;;;
CB10            : 'Pmo.|Local|Extranjero'      ;16;3;;NO;NO;CB10=0;'La Entidad Contratante debe ser Local';NO;;IF(EQSTR(BuscarCampo('Clientes','PaisDir','Codigo',VEHICULO1),BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),0,1)

FechaVto2       : 'Fecha_CEC'                  ;1;1;2;NO y RB6=1;NO y RB6=1;RB6<>1 O [RB6=1 Y IMPCOMCOR1=0] O [RB6=1 Y IMPCOMCOR1>0 Y ESHABIL(FECHAVTO2,TABLAFERIADOS1)];'LA FECHA CEC NO ES DIA HABIL O NO LA INGRESO';NO;;FECHAVTO
ContraEspecie   : 'Esp_Pago_CEC'               ;;;2;RB6=1;RB6=1;RB6<>1 O [RB6=1 Y IMPCOMCOR1=0] O [RB6=1 Y IMPCOMCOR1>=0 Y NOVACIO(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE, ESPECIE)];'NO INGRESO LA ESPECIE DE PAGO CEC';NO;;;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";;;
MB1             : 'UT_CEC|360|365'             ;;;2;RB6=1;RB6=1;RB6<>1 O [RB6=1 Y IMPCOMCOR1=0] O [RB6=1 Y IMPCOMCOR1>0 Y MB1>=0];'NO INGRESO LA UNIDAD DE TIEMPO CEC';NO;0;
ImpComCor2      : 'Imp.Fijo_CEC'               ;;;2;RB6=1;RB6=1;[RB6<>1 Y IMPCOMCOR2=0] O [RB6=1 Y IMPCOMCOR2>=0];'EL IMPORTE CEC SE INGRESA EN CASO DE FONDEO EXTRANJERO Y DEBE SER POSITIVO';NO;;IF(RB6=1,IMPCOMCOR2,0);;;;;'###,###,###,###,###.##'
Precio3         : 'Tasa_CEC'                   ;;;2;RB6=1;RB6=1;[RB6<>1 Y PRECIO3=0] O [RB6=1 Y PRECIO3>=0];'LA TASA CEC SE INGRESA EN CASO DE FONDEO EXTRANJERO Y DEBE SER POSITIVA';NO;;IF(RB6=1,PRECIO3,0)
ImpGastos1      : 'Tasa_Base_CEC'              ;;;2;RB6=1;RB6=1;[RB6<>1 Y IMPGASTOS1=0] O [RB6=1 Y IMPGASTOS1=0 Y PRECIO3=0] O [RB6=1 Y IMPGASTOS1>0 Y PRECIO3>0];'SI SE INGRESA LA TASA CEC, SE DEBE INGRESAR LA TASA BASE CEC Y VICEVERSA';NO;;IF(RB6=1,IMPGASTOS1,0);;;;;'###,###.######'
ImpComCorEq2    : 'Imp.Var._CEC'               ;;;2;EV;RB6=1;NOT EV o [ImpComCorEq2 <= ROUND(VCAN6*(1+Var('PORVAR')/100),2) y ImpComCorEq2>= ROUND(VCAN6*(1-Var('PORVAR')/100),2)];'Importe Variable CEC Fuera de Rango: '~FSTR(ROUND(VCAN6*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN6*(1+Var('PORVAR')/100),2),0,2);NO;;IF(RB6=1,((PRECIOEJ*IMPGASTOS1*PLAZO)/IF(MB1=0,36000,36500))*(PRECIO3/100),0);;;;;'###,###,###,###,###.##'
ImpComCor1      : 'Imp.Tot._CEC'               ;;;2;NO;RB6=1;;;;;IMPCOMCOR2+IMPCOMCOREQ2;;;;;'###,###,###,###,###.##'

DeltaTasa       : '%_Cs_Fin_CEC'               ;10;1;2;RB6=1;RB6=1;RB6<>1 O [Incluido(Fstr(DELTATASA,2,4),VAR('TASAINT'))];'El Valor de TASA Costo Financiero CEC Es Erroneo: '~VAR('TASAINT')~' ...';NO;VAR('DEFAINT');;;;;;'###,###.######'
PeriodoInts     : 'Imp_Cs_Fin_CEC'             ;11;1;2;EV;RB6=1;NOT EV o [PERIODOINTS<= ROUND(VPRE3*(1+Var('PORVAR')/100),2) y PERIODOINTS>= ROUND(VPRE3*(1-Var('PORVAR')/100),2)];'Costo Financiero CEC Fuera de Rango: '~FSTR(ROUND(VPRE3*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VPRE3*(1+Var('PORVAR')/100),2),0,2);NO;;If(RB6=1,IMPCOMCOR1*(DELTATASA/100),0);;;;;'###,###,###,###,###.##'

ImporteImp      : 'Importe Interes'            ;;;2;EV;;NOT EV o [IMPORTEIMP<= ROUND(VCAN3*(1+Var('PORVAR')/100),2) y IMPORTEIMP>= ROUND(VCAN3*(1-Var('PORVAR')/100),2)];'Importe Impuesto Interes Fuera de Rango: '~FSTR(ROUND(VCAN3*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN3*(1+Var('PORVAR')/100),2),0,2);NO;;IF(TASAIMP1 <> 0,IF(PRECIO1 > VAR('TASAIMPINT'),((((PRECIOEJ*(VAR('TASAIMPINT')/100)*PLAZO)/36500)) * TASAIMP1),TOTALINTERESES*TASAIMP1/100), 0);;;;;'###,###,###,###,###.##'
TasaImp1        : '% Imp.Interes'              ;;;2;VACIO(OPERACIONREF);;;;;VAR('DEFAINT');IF(PRECIO1 <= VAR('TASAIMPINT'),VAR('DEFAINT'), ((100*IMPORTEIMP)/TOTALINTERESES));;;;;'###,###.######'

VCAN1           : 'CantAnt'                    ;1;1;2;NO;NO;;;;;BuscarCampo('OPERACIONES','Cantidad+TotalComisiones','NrOperacion',NrOperacion)
VCAN10          : 'ComEF'                      ;1;2;2;NO;NO;;;;IF(NOVACIO(OPERACIONREF),QUERY(" Select Tasa1 from "~DBO~".COMISIONES2 where NrOperacion='"~OPERACIONREF~"' AND Tipo='5'"),SUM(COM2L,2,1,5));IF(NOVACIO(OPERACIONREF),QUERY(" Select Tasa1 from "~DBO~".COMISIONES2 where NrOperacion='"~OPERACIONREF~"' AND Tipo='5'"),SUM(COM2L,2,1,5));;;;;'###.########'
VPRE1           : 'UTEF'                       ;1;2;2;NO;NO;;;;;IF(EQSTR(IF(NOVACIO(OPERACIONREF),QUERY("Select RB2 from "~DBO~".COMISIONES2 where NrOperacion='"~OPERACIONREF~"' "),Fstr(SUM(COM2L,12,1,5),1,0)),'0'),36000,36500)
RB3             : 'MOF'                        ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa         : 'Modificado'                 ;10;3;;NO;NO;;;;0
VPRE5           : 'Cot.ESP/USD'                ;10;3;;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
VPRE6           : 'Cot.CONTESP/USD'            ;10;3;;NO;NO;;;;;COTIZACIONC(CONTRAESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))

Cotizacion1     : 'TC_Concert.'                ;15;1;2;;Not Eqstr(ESPECIE,VAR('MONEEXTR'));Eqstr(ESPECIE,VAR('MONEEXTR')) O [COTIZACION1<=VPRE9*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE9*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE9*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE9*(1+VAR('RPRECIO2')/100),1,7);NO;;IF(Eqstr(ESPECIE,VAR('MONEEXTR')),1)
Cotizacion2     : 'TC_Vencim.'                 ;;;;COTIZACION2<>0;COTIZACION2<>0;;;;

RB11            : 'Ajuste|NO|SI'               ;1;2;2;NO;NO;;;;0;
ValorRB1        : 'Tasa|Real|Estimada'         ;2;2;2;;;VALORRB1 = 0;'La Tasa es Estimada';SI;0;

VPRE9           : 'Cot.TC/USD'                 ;10;2; ;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(ESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)
VCAN6           : 'CEC MOD'                    ;18;1;2;NO;NO;;;;; IF(RB6=1,((PRECIOEJ*IMPGASTOS1*PLAZO)/IF(MB1=0,36000,36500))*(PRECIO3/100),0)
VCAN7           : 'INTERES MOD'                ;18;1;2;NO;NO;;;;; PRECIOEJ*((PRECIO1+SPREAD)/100)*FACTORDIAS(FECHAOP,FECHAVTO,RB8+1)
VCAN8           : 'IVA MOD'                    ;18;1;2;NO;NO;;;;; IF(RB6=1,((PRECIOEJ*TOTALAUX4/100*FACTORDIAS(FECHAOP,FECHAVTO,RB8+1))+IMPCOMCOR1)*(IMPGASTOS2/100),((PRECIOEJ*((PRECIO1+SPREAD)/100)*FACTORDIAS(FECHAOP,FECHAVTO,RB8+1))+IMPCOMCOR1)*(IMPGASTOS2/100))
VCAN3           : 'Impuesto INTERES'           ;18;1;2;NO;NO;;;;; IF(RB6=1,TOTALINTERESES,TOTALINTERESES)*(TASAIMP1/100)
VPRE3           : 'Imp_Csto_Fin_CEC'           ;11;1;2;NO;NO;;;;;If(RB6=1,IMPCOMCOR1*(DELTATASA/100),0);;;;;'###,###,###,###,###.##'
IntDevengados2  : 'TC_IVA'                     ;11;3;1;NO;NO;;;;-1;
PrecioMer       : 'Monto USD WF'               ;1;2;2;NO;NO;;;;PRECIOEJ*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'));PRECIOEJ*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))

VTXT18            : 'Book Def'    ; 1;2;2;NO;NO;;;;;BuscarCampo('VEHICULOS','Alias5','Codigo',VEHICULO1)
VTXT19            : 'Codigo Book' ; 2;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Codigo','Codigo',VTXT18)
VTXT20            : 'Vehic.Book'  ; 3;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Vehiculo','Codigo',VTXT19)
Cuotas1            : 'Cuota1'      ;;;2;NO;NO; 
Cliente2          : 'Cliente2'    ;;;2;NO;NO; 

@INDICE

@CUENTAS
@CTAMONLOC

***---@COMIOP

CONDICIONES
[CB10=0 Y RB6<=1 Y DESCIENDEDECLIENTE(CLIENTE1,'BANCOS')] O [DESCIENDEDECLIENTE(CLIENTE1,'EMPRESAS') Y RB6=0 Y CB10=0];'Entidad Contratante Invalida => FONDEO LOCAL: Entidad o Banco FONDEO EXTR: Banco ';NO
RB6<>2 O [RB6=2 Y DESCIENDEDECLIENTE(CLIENTE2,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE2))] ;'La Entidad Negociadora debe ser un Banco Local';NO
PRECIO1<=VAR('RTASA2') Y PRECIO1>=VAR('RTASA1');'Tasa Fuera de Rango:'~VAR('RTASA1')~" Y "~VAR('RTASA2');SI;SI;FSYS;'RTASA'
ESHABIL(FECHAOP,'ARG');'La Fecha de Origen no es Dia Habil en Argentina';SI;SI;FSYS;'ORIGINH'
ESHABIL(FECHAVTO,'ARG');'La Fecha de Vencimiento NO ES DIA HABIL en Argentina';SI;SI;FSYS;'VTOINH'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'La Entidad Contratante esta Deshabilitada';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'La Entidad Contratante esta Observada';SI;SI;FSYS;'CLIOBS'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE2));'La Entidad Negociadora esta deshabilitada';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE2));'La Entidad Negociadora esta Observada';SI;SI;FSYS;'CLIOBS'
SI O [VACIO(NROPERACION2) O [EQSTR(TIPOOP,BuscarCampo('Operaciones','TipoOp','NrOperacion',NROPERACION2)) y BuscarCampo('Operaciones','FechaVto','NrOperacion',NROPERACION2)=Fsys y EQSTR(BuscarCampo('Operaciones','Vehiculo1','NrOperacion',NROPERACION2),VEHICULO1) y EQSTR(ESPECIE,BuscarCampo('Operaciones','Especie','NrOperacion',NROPERACION2))]];'La Operacion de Referencia es INVALIDA';NO
RB6>2 O [Incluido(Fstr(ImpGastos2,2,2),VAR('IVA'))];'El Valor de TASA IVA es Erroneo: '~VAR('IVA');NO
EQSTR(TIPOTASA,'FIJA') O [SPREAD>=VAR('RSPREAD1') Y SPREAD<=VAR('RSPREAD2')];'El Spread esta Fuera de Rango '~VAR('RSPREAD1')~' '~VAR('RSPREAD2');NO
VACIO(OPERACIONREF) O [OPREF.MB3=0 Y OPREF.MB5<=1 y OPREF.PRECIOEJ>=(OPREF.TOTALAUX3-VCAN1+PRECIOEJ)];'La Partida '~OPERACIONREF~' No se puede Asociar a esta Operacion';NO
SI Y [PRECIO4<=VAR('RTTN2') Y PRECIO4>=VAR('RTTN1')];'Tasa Total Neta Fuera de Rango:'~VAR('RTTN1')~" Y "~VAR('RTTN2');SI
VACIO(OPERACIONREF) O [FECHAOP>=OPREF.FECHAOP Y FECHAOP<=OPREF.FECHAVTO];'LA FECHA DE ORIGEN DEBE ESTAR INCLUIDA EN EL PLAZO DE LA PARTIDA';NO
FECHAOP2=Fsys;'La Fecha de Concertacion no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'

@CONDIOP

SI O Incluido(Especie,'ARP|USD') o NoVacio(VTXT18);'El Vehiculo no tiene Book Default para Monedas';NO
SI O Incluido(Especie,'ARP|USD') o NoVacio(VTXT19);'El Book default '~VTXT18~' no es valido';NO
SI O Incluido(Especie,'ARP|USD') o EqStr(VTXT20,Vehiculo1);'El Book default '~VTXT18~' corresponde a otro vehiculo';NO

MOVIMIENTOS
FechaOp  ;Cliente1;Especie                                         ;;;;;Vehiculo1;1;-PrecioEj                                           ;;'Alta Pmo. en Ctas. Locales';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;1;
FechaPago;Cliente1;Especie                                         ;;;;;Vehiculo1;1; PrecioEj                                          ;;'Vto. Pmo. en Ctas. Locales';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;2;
FechaPago;Cliente1;Especie                                         ;;;;;Vehiculo1;1; TotalIntereses                                    ;;'Int. Pmo. en Ctas. Locales';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;7;
FechaPago;Cliente1;If(IntDevengados2<0,Especie,VAR('MONELOCA'))    ;;;;;Vehiculo1;1; TotalIVA*If(IntDevengados2<0,1,IntDevengados2)    ;;'IVA  Pmo. en Ctas. Locales';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;TotalIVA<>0;;;;3;
FechaVto2;Cliente1;ContraEspecie                                   ;;;;;Vehiculo1;1; ImpComCor1                                         ;;'Vto. Comision CEC';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;ImpComCor1<>0;;Cuenta3;;4;
FechaPago;Cliente1;If(IntDevengados2<0,Especie,VAR('MONELOCA'))    ;;;;;Vehiculo1;1; ImporteImp *If(IntDevengados2<0,1,IntDevengados2) ;;'Impto.Int Pmo. en Ctas. Locales';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;ImporteImp<>0  ;;Cuenta3;;5;
FechaPago;Cliente1;If(IntDevengados2<0,Especie,VAR('MONELOCA'))    ;;;;;Vehiculo1;1; PeriodoInts*If(IntDevengados2<0,1,IntDevengados2) ;;'Costo Financiero CEC';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;PeriodoInts<>0;;Cuenta3;;6;

DEVENGADOS
FechaOp+1;FechaVto;SI;SI;NO;'ARG';SI;SI;'INTLEN';-TotalIntereses;140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;;Especie;
FechaOp+1;FechaVto;NO;SI;NO;'ARG';SI;SI;'INTLEN';-TotalIntereses;150;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;;Especie;1;-PRECIOEJ;PRECIO1+SPREAD;;;;RB8+1
FechaOp+1;FechaVto;NO;SI;NO;'ARG';SI;SI;'INTLEN';-TotalIntereses;160;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;;Especie;2;-PRECIOEJ;PRECIO1+SPREAD;365;;;RB8+1


EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
[EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'))];'No se puede dar de baja, Operador: '~Operador
VACIO(OPERACIONREF);'No se puede dar de baja, Operacion Relacionada con Partida'
  
REFERENCIA
'TotalAux3='~FStr(OPREF.TotalAux3-VCAN1+Cantidad+TotalComisiones,0,2)
'Cuotas1='~FStr(OPREF.Cuotas1+1,0,2)

SQL
"INSERT INTO "~DBO~".CUOTAS (NrOperacion,Mercado1,NrCuota,Fecha1,Cantidad1) "~"Values ('"~OPERACIONREF~"','"~NROPERACION~"',"~Fstr(OPREF.Cuotas1+1,0,0)~", '"~IdxDate(FechaOp)~"', "~Fstr(Cantidad,0,4)~") ";NOVACIO(OPERACIONREF) Y EQSTR(ABM,'A')
"UPDATE "~DBO~".COMISIONES2 Set Fecha1='"~IdxDate(FECHAOP)~"' Where NrOperacion='"~OPERACIONREF~"' and Tipo='0' and Fecha1 Is Null ";EqStr(ABM,'A') y QUERY("SELECT COUNT(*) FROM "~DBO~".COMISIONES2 WHERE NrOperacion='"~OPERACIONREF~"' and Tipo='0' ")>0 Y OPREF.TOTALAUX3=0;

POSTEDICION
NOVACIO(OPERACIONREF) y EQSTR(ABM,'A');'INSCOM';NrOperacion1=OPERACIONREF;NrOperacion2=NROPERACION;String=" Tipo  IN ('5','3')"
NOVACIO(OPERACIONREF) y EQSTR(ABM,'A');'ACTMOV';Vehiculo1=VEHICULO1;Fecha1=FECHAOP;Fecha2=FECHAOP;NrOperacion1=NROPERACION;TipoOp1=TIPOOP;Especie1=ESPECIE;Radio1=-1;Radio2=0
@POSTEMM


