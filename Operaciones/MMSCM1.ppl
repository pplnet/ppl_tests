Cantidad        : 'V. Nominal'                 ;;;;NO;;;;;;PRECIOEJ+TOTALCOMISIONES;;;;;'###,###,###,###,###.##'
Plazo           : 'Plazo '                     ;5;2;;;;PLAZO>0;'PLAZO INVALIDO';NO;0;FECHAVTO-FECHAOP
FechaVto        : 'Fecha_Vto'                  ;;2;;;;  ;    ;    ;FECHAOP+PLAZO;FECHAOP+PLAZO
TotalBrutoCli2  : 'VN_Utilizado'               ;;;;NO;;;;;0;;;;;;'###,###,###,###,###.##'
TotalNetoCli3   : 'VN_Disponible'              ;;;;NO;;;;;CANTIDAD;CANTIDAD;;;;;'###,###,###,###,###.##'
