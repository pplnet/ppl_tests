Cuotas1         : 'Cant_Per'                   ;;;;RB9=0;;CUOTAS1>0;'La Cantidad de Per¦odos debe ser Positiva';NO;IF(RB9=0,0,1);IF(RB9=0,0,1)
VCAN10          : 'ComEF'                      ;5;3;;NO;NO;;;;;IF(NOVACIO(OPERACIONREF),QUERY(" Select Tasa1 from "~DBO~".COMISIONES2 where NrOperacion='"~OPERACIONREF~"' AND Tipo='5'"),SUM(COM2L,2,1,5));;;;;'###.########'
