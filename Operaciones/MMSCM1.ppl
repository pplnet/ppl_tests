Cliente2        : 'Ent_Agente  '               ;4;2;;NOT EV;;NOVACIO(CLIENTE2);'La Entidad Agente es Invalida';NO;;;;;;;;"Status = 'HAB'";;;;
Especie         : 'Especie'                    ;5;1;;NOT EV;;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'Debe Ingresar una Moneda';NO;;;;;;;;"Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA'))~") and Status = 'HAB'"
