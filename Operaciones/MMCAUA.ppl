CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp2        : 'Fecha Conc.'                ;1 ;1;;VERIFICAACCESO('OPFVALOR');;FECHAOP2<=FECHAOP;'Fecha incorrecta';NO;FSYS;
FechaOp         : 'Fecha_Origen'               ;2 ;1;;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1);'Fecha de Origen Incorrecta';;FSYS;
@VEHITO
Operador        :                              ;  ;2;;NO;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
Cliente1        : 'Entidad'                    ;4 ;1;;NOT EV;;NOVACIO(CLIENTE1);'La Entidad Contratante ES INCORRECTA';NO;TotalIntereses=TotalIntereses; TotalIntereses=TotalIntereses;
Observac2       : 'Op.Contraparte'             ;4 ;2;;;;NOVACIO(OBSERVAC2);'El Operador CONTRAPARTE es INVALIDO';SI;;;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
Especie         : 'Moneda'                     ;6 ;1;;NOT EV;;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'Debe Ingresar una Moneda ';NO;;;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";;;
Cantidad        : 'Valor Nominal'              ;  ;;;NOT EV;;CANTIDAD>0;'El Valor Nominal DEBE SER POSITIVO';NO;;;;;;;'###,###,###,###,###.##'
TipoTasa        : 'Tipo_Tasa'                  ;6 ;2;;;NO;NOVACIO(TIPOTASA);'El Tipo de Tasa ES INVALIDO';NO;'FIJA';
Plazo           : 'Plazo'                      ;  ;2;;;;PLAZO>0;'Debe INGRESAR el PLAZO';NO;0;
Spread          :                              ;  ;2;;NOT EQSTR(TIPOTASA,'FIJA');NOT EQSTR(TIPOTASA,'FIJA');SPREAD>=0;'El SPREAD Debe SER POSITIVO';NO;0;
FechaVto        : 'Fecha_Vto'                  ;9 ;2;;NO;;ESHABIL(FECHAVTO,TABLAFERIADOS1);'La Fecha de Vencimiento NO ES DIA HABIL';;;FECHAOP+PLAZO

Precio1         : 'Tasa (%)'                   ;8 ;1;;;;PRECIO1 > 0;'Tasa Invalida';NO;;;;;;;'###,###.######'
Plazo4          : 'Dias Seteo Tasa'            ;9;1;;;Not EqStr(TIPOTASA, 'FIJA') Y NOVACIO(TIPOTASA)];[PLAZO4>=0] O [EQSTR(TIPOTASA,'FIJA')];'Indique la Cantidad de Dias Previos al Inicio para Setear la Tasa';NO;;
TotalIntereses  : 'Interes'                    ;10 ;1;;EV;;NOT EV o [TotalIntereses <= ROUND(VCAN7*(1+Var('PORVAR')/100),2) y TotalIntereses >= ROUND(VCAN7*(1-Var('PORVAR')/100),2)];'Interes Fuera de Rango: '~FSTR(ROUND(VCAN7*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN7*(1+Var('PORVAR')/100),2),0,2);NO;IF(Incluido(CLIENTE1,Var('CLIRED')) Y EQSTR (ESPECIE,'USD'),ROUND(CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000),0),CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000));IF(Incluido(CLIENTE1,Var('CLIRED')) Y EQSTR (ESPECIE,'USD'),ROUND(CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000),0),CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000));;;;;'###,###,###,###,###.##'
TotalBrutoCli1  : 'Monto'                      ;11;1;;NO;;;;;;CANTIDAD+TOTALINTERESES;;;;;'###,###,###,###,###.##'

ImpGastos2      : 'Tasa IVA'                   ;13;2;;;;;;;VAR('TASAIVA');IF(Incluido(VEHICULO1,VAR('VEHIEXTRAN')),0,VAR('TASAIVA'));;;;;'###,###.######'

DeltaTasa       : '%Imp.DB/CR'                 ;  ; ;;;;[Incluido(Fstr(DELTATASA,2,2),VAR('IMPCHEQUE'))];'El Valor de TASA Impuesto CHEQUE Es Erroneo: '~VAR('IMPCHEQUE')~' ...';NO;0;;;;;;'###,###.######'
PeriodoInts     : 'Imp.DB/CR'                  ;  ; ;;EV;;NOT EV o [PERIODOINTS   <= ROUND(VPRE3*(1+Var('PORVAR')/100),2) y PERIODOINTS>= ROUND(VPRE3*(1-Var('PORVAR')/100),2)];'Impuesto al Cheque CR Fuera de Rango: '~FSTR(ROUND(VPRE3*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VPRE3*(1+Var('PORVAR')/100),2),0,2);NO;;CANTIDAD*(DELTATASA/100);;;;;'###,###,###,###,###.##'
VPRE3           : 'Imp_Cheque CR'              ;  ; ;;NO;NO;;;;;CANTIDAD*(DELTATASA/100);;;;;'###,###,###,###,###.##'

Precio4         : 'Tasa_T_Neta'                ;12;1;;NO;PRECIO4>0;;;;;
RB8             : 'U.Tiempo|360|365'           ;  ;1;;;;RB8>=0;'Unidad de Tiempo Tasa Interes INVALIDA';NO;IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),1,0);IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),1,0)
TablaFeriados1  : 'Feriados'                   ;  ;1;;;NOVACIO(TABLAFERIADOS1);;'Se debe indicar feriados a utilizar';NO; IF(NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),'USA',IF(DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y NOT EQSTR(ESPECIE,'ARP'),'USD','ARG'));IF(NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),'USA',IF(DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y NOT EQSTR(ESPECIE,'ARP'),'USA','ARG'))
OperacionRef    : 'Op_Referencia'              ;15;1;;;;;;;
RB3             : 'MOF'                        ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa         : 'Modificado'                 ;10;3;;NO;NO;;;;0
VPRE5           : 'Cot.ESP/USD'                ;10;3;;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
VPRE6           : 'Cot.CONTESP/USD'            ;10;3;;NO;NO;;;;;COTIZACIONC(CONTRAESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
VPRE1           : 'Cot.TC/USD'                 ;10;2;2;NO;NO;;;;;COTIZACIONBNA(ESPECIE,FECHAOP-1,1,NO,NO)

Cotizacion1     : 'TC_Concert.'                ;16;1;2; Not Eqstr(ESPECIE,VAR('MONELOCA')); Not Eqstr(ESPECIE,VAR('MONELOCA')) ;[COTIZACION1<=VPRE1*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE1*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE1*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE1*(1+VAR('RPRECIO2')/100),1,7);NO;;COTIZACIONBNA(ESPECIE,FECHAOP-1,1,NO,NO) 

VCAN8           : 'IVA MOD'                    ;3 ;1;2;NO;NO;;;;;IF(NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),(TOTALINTERESES*IMPGASTOS2)/100,0)
VCAN5           : 'IMP MOD'                    ;3 ;1;2;NO;NO;;;;;IF(DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),TOTALINTERESES*IMPGASTOS1/100,0)
*VCAN7           : 'INTERES MOD'                ;3 ;1;2;NO;NO;;;;;IF(Incluido(CLIENTE1,Var('CLIRED')) Y EQSTR (ESPECIE,'USD'),ROUND(CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000),0),CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000))
VCAN7           : 'INTERES MOD'                ;3 ;1;2;NO;NO;;;;;IF(Incluido(CLIENTE1,Var('CLIRED')) Y EQSTR (ESPECIE,'USD'),ROUND(CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000)),0)
VCAN6           : 'Equivalente USD'            ;17;2;2;NO;NO;;;;;TOTALBRUTOCLI1*COTIZACIONC(ESPECIE,,,,Fsys,1,SI,VTXT6))
PrecioMer       : 'Monto USD WF'               ;17;2;2;NO;NO;;;;VCAN6;VCAN6

VCAN9           : 'Total Consumido'            ;16;2;2;NO;NO;;;;;VCAN10+LIMCONSUMIDO(CLIENTE1,'COTOR',VTXT6,0,,,,NROPERACION)
VCAN10          : 'Capital  USD'               ;17;2;2;NO;NO;;;;;If(EqStr(ESPECIE,VTXT6),CANTIDAD,CANTIDAD*COTIZACIONC(ESPECIE,,,,Fsys,1,SI,VTXT6))
CB10            : 'Entidad|Local|Extranjero'   ;16;3; ;NO;NO;;;;;IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),0,1)
VTXT6           : 'EspecieLimiteSett'          ; 1;2;2;NO;NO;;;;;QUERY("SELECT Especie FROM "~DBO~".LIMASIGNADOS WHERE Cliente='"~CLIENTE1~"' AND Limite='COTOR' ")

@COMICAU

FechaPrecan     : 'F.Reset'                    ;10;1;2;NO;Not EqStr(TIPOTASA, 'FIJA') Y NOVACIO(TIPOTASA)];;;;;HABILES(FECHAOP,-PLAZO4,TABLAFERIADOS1,SI);
ContraEspecie    : 'ContraEspecie';;;2;NO;NO;
ImpGastos1       : 'Imp';;;2;NO;NO;

MB3            : 'Tipo|Pasiva|Activo'         ;15;1;1;NO;NO;;;;IF(Incluido(TIPOOP,VAR('OPEACT')),1,0);IF(Incluido(TIPOOP,VAR('OPEACT')),1,0)

@CUENTASCAU
@CTAMONLOC
@RANGOTASA


CONDICIONES
SI O [PRECIO1<=VPRE12 Y PRECIO1>=VPRE11];'Tasa Fuera de Rango: '~VPRE11~" Y "~VPRE12;SI;SI;FSYS;'RTASA'
PRECIO1<=VAR('RTASA2') Y PRECIO1>=VAR('RTASA1');'Tasa Fuera de Rango: '~VAR('RTASA1')~" Y "~VAR('RTASA2');SI;SI;FSYS;'RTASA'
SI Y [PRECIO4<=VAR('RTTN2') Y PRECIO4>=VAR('RTTN1')];'Tasa Total Neta Fuera de Rango:'~VAR('RTTN1')~" Y "~VAR('RTTN2');SI
ESHABIL(FECHAOP,'ARG');'La Fecha de Origen no es Dia Habil en Argentina';SI;SI;FSYS;'ORIGINH'
ESHABIL(FECHAVTO,'ARG');'La Fecha de Vencimiento NO ES DIA HABIL en Argentina';SI;SI;FSYS;'VTOINH'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'El Cliente esta Observado';SI;SI;FSYS;'CLIOBS'
VACIO(OPERACIONREF) O [EQSTR(TIPOOP,BuscarCampo('Operaciones','TipoOp','NrOperacion',OPERACIONREF)) y BuscarCampo('Operaciones','FechaVto','NrOperacion',OPERACIONREF)=Fsys y EQSTR(BuscarCampo('Operaciones','Vehiculo1','NrOperacion',OPERACIONREF),VEHICULO1) y EQSTR(ESPECIE,BuscarCampo('Operaciones','Especie','NrOperacion',OPERACIONREF))];'La Operacion de Referencia es INVALIDA';NO
Not DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') O  Incluido(Fstr(IMPGASTOS1,2,2),VAR('LISTIMPU'));'El Valor de la Alicuota Impuesto es Erroneo: '~VAR('LISTIMPU')~' ...';NO
EQSTR(TIPOTASA,'FIJA') O [SPREAD>=VAR('RSPREAD1') Y SPREAD<=VAR('RSPREAD2')];'El Spread esta Fuera de Rango '~VAR('RSPREAD1')~' '~VAR('RSPREAD2');SI;SI;FSYS;'RANGOSPREAD'
SI O [[DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) Y IMPGASTOS1>=0] O NOT [DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) Y IMPGASTOS1>=0]];'La Alicuota Impuesto  DEBE SER POSITIVA';NO
[NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) Y INCLUIDO(FSTR(IMPGASTOS2,2,2),VAR('IVA'))] O NOT [NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) Y INCLUIDO(FSTR(IMPGASTOS2,2,2),VAR('IVA'))];"El Valor de TASA IVA es Erroneo: "~VAR('IVA');NO
FECHAOP2 = Fsys;'La Fecha de Concertacion no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP  = Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
[NOT NOVACIO(CLIENTE1)] o ExisteLimite('COTOR',CLIENTE1,VTXT6); 'Lim.Credito no asignado';SI;SI;FSYS;'COTORNOAS'
[NOT NOVACIO(CLIENTE1)] o Not ExisteLimite('COTOR',CLIENTE1,VTXT6) o VtoLimite('COTOR',CLIENTE1,VTXT6) >= FechaOp; 'Lim.Credito vencido el '~FECHA(VtoLimite('COTOR',CLIENTE1,VTXT6));SI;SI;FSYS;'COTORVENC'
[NOT NOVACIO(CLIENTE1)] o LimAsignado(CLIENTE1,'COTOR',VTXT6) >= VCAN9; 'Lim.Credito excedido '~PYC(-(LimAsignado(CLIENTE1,'COTOR',VTXT6)-VCAN9),1,0)~'.-';SI;SI;FSYS;'COTOREXCE'

@CONDIOP

EDICION
NO O [EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'))];'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

POSTEDICION
@POSTEMM

SQL
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('COTORNOAS','COTORVENC','COTOREXCE','SETTLENOAS','SETTLEVENC','SETTLECANC') ";EqStr(ABM,'E')
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('SETTLEEXCE','CONTNOAS','CONTVENC','CONTCANC','CONTEXCE')";EqStr(ABM,'E')

MOVIMIENTOS
FechaOp ;IF(VACIO(Corredor), Cliente1, Corredor);Especie;;;;;Vehiculo1;1; Cantidad;;'Alta Caucion Activa';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;1;
FechaVto;IF(VACIO(Corredor), Cliente1, Corredor);Especie;;;;;Vehiculo1;1;-Cantidad;;'Vto.Cap Caucion Activa';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;2;;;;;;;;;;;;;;600
FechaVto;IF(VACIO(Corredor), Cliente1, Corredor);Especie;;;;;Vehiculo1;1;-TotalIntereses  ;;'Vto.Int. Caucion Activa' ;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;3;
FechaOp ;IF(VACIO(Corredor), Cliente1, Corredor);Especie;;;;;Vehiculo1;1; PeriodoInts;;'Imp.DB/CR';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;PeriodoInts<>0;;Cuenta1;;5;
FechaVto;IF(VACIO(Corredor), Cliente1, Corredor);Especie;;;;;Vehiculo1;1;ImpComMer1;;'Comision Derecho Mercado';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;30;
FechaVto;IF(VACIO(Corredor), Cliente1, Corredor);Especie;;;;;Vehiculo1;1;TotalGastos;;'IVA Comision Mercado';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;NO;;Cuenta1;;25;
FechaVto;IF(VACIO(Corredor), Cliente1, Corredor);Especie;;;;;Vehiculo1;1;TotalComisiones;;'Comision Arancel';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;NO;;Cuenta1;;21;
FechaVto;IF(VACIO(Corredor), Cliente1, Corredor);Especie;;;;;Vehiculo1;1;TotalIva;;'IVA Comision Arancel';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;NO;;Cuenta1;;26;

FechaVto;IF(VACIO(Corredor), Cliente1, Corredor);Especie;;;;;Vehiculo1;1;ImpComCor1;;'Comision Corredor:'~Corredor;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;40;
FechaVto;IF(VACIO(Corredor), Cliente1, Corredor);Especie;;;;;Vehiculo1;1;TotalIVA;;'IVA Comision Corredor';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;50;


DEVENGADOS
FechaOp+1;FechaVto;SI;SI;NO;'ARG';SI;SI;'INTLEN';TotalIntereses;140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;;Especie;

LIMITES
FechaOp2;CLIENTE1;'COTOR';VTXT6;; VCAN6;TipoOp~' '~Especie;NoVacio(CLIENTE1);
Habiles(FechaVto,1,TablaFeriados1);CLIENTE1;'COTOR';VTXT6;;-VCAN6;TipoOp~' '~Especie;RB15=1 Y NoVacio(CLIENTE1) y Incluido(Vehiculo1,Var('VLIQUIDAA'));
FechaVto;CLIENTE1;'COTOR';VTXT6;;-VCAN6;TipoOp~' '~Especie;RB15=1 Y NoVacio(CLIENTE1) y Not Incluido(Vehiculo1,Var('VLIQUIDAA')) y Not EqStr(BuscarCampo('CLIENTES','Alias10','Codigo',CLIENTE1),'LIMITELIQ');


