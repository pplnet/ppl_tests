MTM.Fecha3[Fila];Cliente1;ContraEspecie;Mercado;Vehiculo1;1; -MTM.MTM[Fila];'MTM Diario';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;NO;Fila+100;Cuenta1;;Fila+100;

