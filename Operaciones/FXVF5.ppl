FechaVto;Cliente1;ContraEspecie ;;;;;Vehiculo1;1;Arancel2;;'Arancel al Vto'                ;SI; Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;11;
FechaVto;Cliente1;ContraEspecie ;;;;;Vehiculo1;1;TotalIVA4;;'IVA Arancel al Vto'            ;SI; Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;12;

