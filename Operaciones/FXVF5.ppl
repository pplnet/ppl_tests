NrBoleto      : 'Nro Boleto'               ;12;1; ;  ;;NRBOLETO > 9999999 Y NRBOLETO < 100000000;'El Nro Boleto DEBE SER DE 8 DÍGITOS';NO;10000000;;;;;;'########'
