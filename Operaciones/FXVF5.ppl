FechaVto;Cliente1;ContraEspecie ;;;;;Vehiculo1;1;ImpComMerEq2;;'Derecho de Clearing al Vto'    ;SI; Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;8;
