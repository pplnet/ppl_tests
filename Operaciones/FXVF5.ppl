PorArancel1    : '% Arancel Alta'                ;12;1;2;  ;;;;;;MontoArancelC(TIPOOP,CLIENTE1,CONTRAESPECIE,,'AOPER',,4,,,SI,,,,,SI,SI,,SI);
Arancel1  : 'Monto Aran Alta'            ;12;2;2;NO;;;;0;;(PRECIO1*CANTIDAD)*PORARANCEL1/100
TasaIVA3       : 'Tasa Iva Alta'              ;13;1;2;  ;;;;;VAR('IVAGAFM');
TotalIVA3  : 'Iva Alta'                      ;13;2;2;NO;;ARANCEL1=0 O TOTALIVA3>0;'El IVA no puede ser vacio porque hay Arancel';NO;0;ARANCEL1*TASAIVA3/100;

Label5        : ''                         ;15;1;2;  ;;;;;'Aranceles al Vto';'Aranceles al Vto';;;;;;
PorArancel2    : '% Arancel Vto'                ;16;1;2;  ;;;;;;MontoArancelC(TIPOOP,CLIENTE1,CONTRAESPECIE,,'AOPER',,4,,,SI,,,,,SI,SI,,SI);
Arancel2  : 'Monto Aran Vto'            ;16;2;2;NO;;;;0;;(PRECIO1*CANTIDAD)*PORARANCEL2/100
TasaIVA4       : 'Tasa Iva Vto'              ;17;1;2;  ;;;;;VAR('IVAGAFM');
TotalIVA4  : 'Iva Vto'                      ;17;2;2;NO;;ARANCEL2=0 O TOTALIVA4>0;'El IVA no puede ser vacio porque hay Arancel';NO;0;ARANCEL2*TASAIVA4/100;

