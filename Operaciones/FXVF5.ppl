FechaEj       : 'F.Cierre'                 ;10;2; ;NO;NoVacio(FECHAEJ);
Precio2       : 'Pr.Cierre'                ;11;2; ;NO;NoVacio(PRECIO2);

Label6        : ''                         ;1;1;2;  ;;;;;'Derecho de Registro';'Derecho de Registro';;;;;;
PorComMer1   :   '%Der Registro'           ;2;1;2;;;PORCOMMER1 >= 0;'El porcentaje de Derecho de Registro DEBE SER POSITIVO';NO;Var('FMPODREG') 
ImpComMer1    : 'D. Registro'              ;2;2;2;NO;;;;;;CANTIDAD*PORCOMMER1/100;
TCComMer1    :   'Tipo Cambio'             ;3;1;2;;;TCCOMMER1 >= 0;'El Tipo de Cambio de Derecho de Registro DEBE SER POSITIVO';NO;;CotizacionC(Var('FMTCDER'),'CON',,,Habiles(FECHAOP,-1,'ARG',NO),1,SI,CONTRAESPECIE);
ImpComMerEq1 :   'D.Reg ARP'               ;3;2;2;NO;;;;;;IMPCOMMER1*TCCOMMER1
TasaIVA1    : 'Tasa de Iva'                ;4;1;2;;;TASAIVA1 >= 0;'La Tasa de Iva de Derecho de Registro DEBE SER POSITIVA';NO;Var('IVAGAFM') 
TotalIVA    : 'Iva'                        ;4;2;2;NO;;;;;;IMPCOMMEREQ1*TASAIVA1/100;;;;;'###,###,###,###.##'

Label7        : ''                         ;6;1;2;  ;;;;;'Derecho de Clearing';'Derecho de Clearing';;;;;;
PorComMer2  :   '%Der Clearing'            ;7;1;2;;;PORCOMMER2 >= 0;'El porcentaje de Derecho de Clearing DEBE SER POSITIVO';NO;Var('FMPODCLE') 
ImpComMer2    : 'D. Clearing'              ;7;2;2;NO;;;;;;CANTIDAD*PORCOMMER2/100;
TCComMer2   :   'Tipo Cambio'              ;8;1;2;;;TCCOMMER2 >= 0;'El Tipo de Cambio de Derecho de Clearing DEBE SER POSITIVO';NO;;CotizacionC(Var('FMTCDER'),'CON',,,Habiles(FECHAOP,-1,'ARG',NO),1,SI,CONTRAESPECIE);
ImpComMerEq2 :  'D.Cle ARP'                ;8;2;2;NO;;;;;;IMPCOMMER2*TCCOMMER2
TasaIVA2    : 'Tasa de Iva'                ;9;1;2;;;TASAIVA2 >= 0;'La Tasa de Iva de Derecho de Clearing DEBE SER POSITIVA';NO;Var('IVAGAFM') 
TotalIVA2    : 'Iva'                  ;9;2;2;NO;;;;;;IMPCOMMEREQ2*TASAIVA2/100

