CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp2        : 'Fecha Conc.'                ;1 ;1;;VERIFICAACCESO('OPFVALOR');;FECHAOP2<=FECHAOP;'Fecha incorrecta';NO;FSYS;
FechaOp         : 'Fecha_Origen'               ;2 ;1;;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1);'Fecha de Origen Incorrecta';RB11=0;FSYS;
@VEHITO
Operador        :                              ;  ;2;;;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
Cliente1        : 'Entidad'                    ;4 ;1;;NOT EV;;NOVACIO(CLIENTE1);'La Entidad Contratante ES INCORRECTA';NO;;;
Observac2       : 'Op.Contraparte'             ;4 ;2;;;;NOVACIO(OBSERVAC2);'El Operador CONTRAPARTE es INVALIDO';SI;;;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
Especie         : 'Moneda'                     ;6 ;1;;NOT EV;;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'Debe Ingresar una Moneda ';NO;;;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";;;
Cantidad        : 'Valor Nominal'              ;  ;;;NOT EV;;CANTIDAD>0;'El Valor Nominal DEBE SER POSITIVO';NO;;;;;;;'###,###,###,###,###.##'
TipoTasa        : 'Tipo_Tasa'                  ;6 ;2;;;;NOVACIO(TIPOTASA);'El Tipo de Tasa ES INVALIDO';NO;'FIJA';
Plazo           : 'Plazo'                      ;  ;2;;;;PLAZO>0;'Debe INGRESAR el PLAZO';NO;0;
Spread          :                              ;  ;2;;NOT EQSTR(TIPOTASA,'FIJA');NOT EQSTR(TIPOTASA,'FIJA');SPREAD>=0;'El SPREAD Debe SER POSITIVO';NO;0;
FechaVto        : 'Fecha_Vto'                  ;9 ;2;;NO;;ESHABIL(FECHAVTO,TABLAFERIADOS1);'La Fecha de Vencimiento NO ES DIA HABIL';RB11=0;;FECHAOP+PLAZO
Precio1         : 'Tasa (%)'                   ;8 ;1;;;;PRECIO1>0;'La Tasa Debe ser positiva';NO;;;;;;;'###,###.######'
TotalIntereses  : 'Interes'                    ;9 ;1;;EV;;NOT EV o [TotalIntereses <= ROUND(VCAN7*(1+Var('PORVAR')/100),2) y TotalIntereses >= ROUND(VCAN7*(1-Var('PORVAR')/100),2)];'Interes Fuera de Rango: '~FSTR(ROUND(VCAN7*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN7*(1+Var('PORVAR')/100),2),0,2);NO;IF(Incluido(CLIENTE1,Var('CLIRED')) Y EQSTR (ESPECIE,'USD'),ROUND(CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000),0),CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000));IF(Incluido(CLIENTE1,Var('CLIRED')) Y EQSTR (ESPECIE,'USD'),ROUND(CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000),0),CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000));;;;;'###,###,###,###,###.##'
TotalNetoCli2   : 'Int_Neto'                   ;10;1;;NO;;;;;;TOTALINTERESES-TOTALRETENCIONES;;;;;'###,###,###,###,###.##'
TotalBrutoCli1  : 'Monto'                      ;11;1;;NO;;;;;;CANTIDAD+TOTALINTERESES;;;;;'###,###,###,###,###.##'
TotalNetoCli1   : 'Monto_Neto'                 ;12;1;;NO;;;;;;TOTALBRUTOCLI1-TOTALRETENCIONES;;;;;'###,###,###,###,###.##'
ImpGastos1      : '%Ret.Gan'                   ;14;1;;DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));;;;VAR('ALICIMPU');IF(MODI,IMPGASTOS1,IF(EqStr(VAR('MONELOCA'),ESPECIE),VAR('ALICIMPU'),0))
TotalRetenciones: 'Ret.Gan'                    ;15;1;;EV;DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));NOT EV o [TotalRetenciones<= ROUND(VCAN5*(1+Var('PORVAR')/100),2) y TotalRetenciones >= ROUND(VCAN5*(1-Var('PORVAR')/100),2)];'Importe Impuesto Fuera de Rango: '~FSTR(ROUND(VCAN5*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN5*(1+Var('PORVAR')/100),2),0,2);NO;;IF(DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),TOTALINTERESES*IMPGASTOS1/100,0);;;;;'###,###,###,###,###.##'
ImpGastos2      : 'Tasa IVA'                   ;14;1;;NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));;;;VAR('TASAIVA');IF(Incluido(VEHICULO1,VAR('VEHIEXTRAN')),0,VAR('TASAIVA'));;;;;'###,###.######'
TotalAux1       : 'Imp_IVA'                    ;15;1;;EV;NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));NOT EV o [TotalAux1<= ROUND(VCAN8*(1+Var('PORVAR')/100),2) y TotalAux1 >= ROUND(VCAN8*(1-Var('PORVAR')/100),2)];'Importe IVA Fuera de Rango: '~FSTR(ROUND(VCAN8*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN8*(1+Var('PORVAR')/100),2),0,2);NO;0;IF(NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),(TOTALINTERESES*IMPGASTOS2)/100,0);;;;;'###,###,###,###,###.##'

DeltaTasa       : '%Imp.DB/CR'                 ;  ; ;;;;[Incluido(Fstr(DELTATASA,2,2),VAR('IMPCHEQUE'))];'El Valor de TASA Impuesto CHEQUE Es Erroneo: '~VAR('IMPCHEQUE')~' ...';NO;0;;;;;;'###,###.######'
PeriodoInts     : 'Imp.DB/CR'                  ;  ; ;;EV;;NOT EV o [PERIODOINTS   <= ROUND(VPRE3*(1+Var('PORVAR')/100),2) y PERIODOINTS>= ROUND(VPRE3*(1-Var('PORVAR')/100),2)];'Impuesto al Cheque CR Fuera de Rango: '~FSTR(ROUND(VPRE3*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VPRE3*(1+Var('PORVAR')/100),2),0,2);NO;;CANTIDAD*(DELTATASA/100);;;;;'###,###,###,###,###.##'
VPRE3           : 'Imp_Cheque CR'              ;  ; ;;NO;NO;;;;;CANTIDAD*(DELTATASA/100);;;;;'###,###,###,###,###.##'

TotalAux2       : '%Perc_Iva'                  ;14;2;;;NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));TOTALAUX2=VAR('RG3337') O TOTALAUX2=0;'Tasa de Percepcion Iva Invalida!!';NO;VAR('RG3337');;;;;;'###,###.######'
TotalAux3       : 'Imp_Perc_IVA'               ;  ;;;NO;NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));;;;;IF(NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),(TOTALINTERESES*TOTALAUX2)/100,0);;;;;'###,###,###,###,###.##'
TotalIVA        : 'Imp_Neto_IVA'               ;  ;;;NO;NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));;;;;IF(NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),(TOTALAUX1+TOTALAUX3),0);;;;;'###,###,###,###,###.##'
Precio4         : 'Tasa_T_Neta'                ;10;2;;NO;PRECIO4>0;;;;;
RB8             : 'U.Tiempo|360|365'           ;  ;;;;;RB8>=0;'Unidad de Tiempo Tasa Interes INVALIDA';NO;IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),1,0);IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),1,0)
TablaFeriados1  : 'Feriados'                   ;  ;;;;;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO; IF(NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),'USA',IF(DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y NOT EQSTR(ESPECIE,'ARP'),'USD','ARG'));IF(NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),'USA',IF(DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y NOT EQSTR(ESPECIE,'ARP'),'USA','ARG'))
RB7             : 'Convenio|NO|SI'             ;13;1;;NO;NO;RB7 >= 0;'Debe Indicar si es Convenio';NO;0
OperacionRef    : 'Op_Referencia'              ;13;2;;;;;;;
RB3             : 'MOF'                        ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa         : 'Modificado'                 ;10;3;;NO;NO;;;;0
VPRE5           : 'Cot.ESP/USD'                ;10;3;;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
VPRE1           : 'Cot.TC/USD'                 ;10;2; ;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(ESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)
Cotizacion1     : 'TC_Concert.'                ;1 ;1;2;;Not Eqstr(ESPECIE,VAR('MONEEXTR'));;;;;IF(Eqstr(ESPECIE,VAR('MONEEXTR')),1)
Cotizacion2     : 'TC_Vencim.'                 ;  ;;;COTIZACION2<>0;COTIZACION2<>0;;;;
RB11            : 'Ajuste|NO|SI'               ;5;1;2;;NO;;;;0;
VCAN8           : 'IVA MOD'                    ;3 ;1;2;NO;NO;;;;;IF(NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),(TOTALINTERESES*IMPGASTOS2)/100,0)
VCAN5           : 'IMP MOD'                    ;3 ;1;2;NO;NO;;;;;IF(DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),TOTALINTERESES*IMPGASTOS1/100,0)
VCAN7           : 'INTERES MOD'                ;3 ;1;2;NO;NO;;;;;IF(Incluido(CLIENTE1,Var('CLIRED')) Y EQSTR (ESPECIE,'USD'),ROUND(CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000),0),CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000))
VCAN6           : 'Equivalente USD'            ;17;2;2;NO;NO;;;;;TOTALBRUTOCLI1*COTIZACIONC(ESPECIE,,,,Fsys,1,SI,VTXT6))
PrecioMer       : 'Monto USD WF'               ;17;2;2;NO;NO;;;;VCAN6;VCAN6
VCAN9           : 'Total Consumido'            ;16;2;2;NO;NO;;;;;VCAN10+LIMCONSUMIDO(CLIENTE1,'COTOR',VTXT6,0,,,,NROPERACION)
VCAN10          : 'Capital  USD'               ;17;2;2;NO;NO;;;;;If(EqStr(ESPECIE,VTXT6),CANTIDAD,CANTIDAD*COTIZACIONC(ESPECIE,,,,Fsys,1,SI,VTXT6))
CB10            : 'Entidad|Local|Extranjero'   ;16;3; ;NO;NO;;;;;IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),0,1)
VTXT6           : 'EspecieLimiteSett'          ; 1;2;2;NO;NO;;;;;QUERY("SELECT Especie FROM "~DBO~".LIMASIGNADOS WHERE Cliente='"~CLIENTE1~"' AND Limite='COTOR' ")

VTXT18            : 'Book Def'    ; 1;2;2;NO;NO;;;;;BuscarCampo('VEHICULOS','Alias5','Codigo',VEHICULO1)
VTXT19            : 'Codigo Book' ; 2;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Codigo','Codigo',VTXT18)
VTXT20            : 'Vehic.Book'  ; 3;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Vehiculo','Codigo',VTXT19)

ContraEspecie    : 'Contraespecie' ;;;;NO;NO;

@CUENTAS
@CTAMONLOC
@INDICE  


CONDICIONES
PRECIO1<=VAR('RTASA2') Y PRECIO1>=VAR('RTASA1');'Tasa Fuera de Rango:'~VAR('RTASA1')~" Y "~VAR('RTASA2');SI;SI;FSYS;'RTASA'
SI Y [PRECIO4<=VAR('RTTN2') Y PRECIO4>=VAR('RTTN1')];'Tasa Total Neta Fuera de Rango:'~VAR('RTTN1')~" Y "~VAR('RTTN2');SI
ESHABIL(FECHAOP,'ARG');'La Fecha de Origen no es Dia Habil en Argentina';SI;SI;FSYS;'ORIGINH'
ESHABIL(FECHAVTO,'ARG');'La Fecha de Vencimiento NO ES DIA HABIL en Argentina';SI;SI;FSYS;'VTOINH'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'El Cliente esta Observado';SI;SI;FSYS;'CLIOBS'
[DESCIENDEDECLIENTE(CLIENTE1,'BLOCAL') Y PLAZO>=VAR('PLAZOBLOCA')] O [NOT DESCIENDEDECLIENTE(CLIENTE1,'BLOCAL') Y PLAZO>=0];"El Plazo es Invalido Banco Local>="~VAR('PLAZOBLOCA');NO
VACIO(OPERACIONREF) O [EQSTR(TIPOOP,BuscarCampo('Operaciones','TipoOp','NrOperacion',OPERACIONREF)) y BuscarCampo('Operaciones','FechaVto','NrOperacion',OPERACIONREF)=Fsys y EQSTR(BuscarCampo('Operaciones','Vehiculo1','NrOperacion',OPERACIONREF),VEHICULO1) y EQSTR(ESPECIE,BuscarCampo('Operaciones','Especie','NrOperacion',OPERACIONREF))];'La Operacion de Referencia es INVALIDA';NO
Not DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') O  Incluido(Fstr(IMPGASTOS1,2,2),VAR('LISTIMPU'));'El Valor de la Alicuota Impuesto es Erroneo: '~VAR('LISTIMPU')~' ...';NO
EQSTR(TIPOTASA,'FIJA') O [SPREAD>=VAR('RSPREAD1') Y SPREAD<=VAR('RSPREAD2')];'El Spread esta Fuera de Rango '~VAR('RSPREAD1')~' '~VAR('RSPREAD2');NO
[DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) Y IMPGASTOS1>=0] O NOT [DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) Y IMPGASTOS1>=0];'La Alicuota Impuesto  DEBE SER POSITIVA';NO
[NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) Y INCLUIDO(FSTR(IMPGASTOS2,2,2),VAR('IVA'))] O NOT [NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) Y INCLUIDO(FSTR(IMPGASTOS2,2,2),VAR('IVA'))];"El Valor de TASA IVA es Erroneo: "~VAR('IVA');NO
FECHAOP2=Fsys;'La Fecha de Concertacion no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
[NOT NOVACIO(CLIENTE1)] o ExisteLimite('COTOR',Cliente1,VTXT6); 'Lim.Credito no asignado';NO;SI;FSYS;'COTORNOAS'
[NOT NOVACIO(CLIENTE1)] o Not ExisteLimite('COTOR',Cliente1,VTXT6) o VtoLimite('COTOR',Cliente1,VTXT6) >= FechaOp; 'Lim.Credito vencido el '~FECHA(VtoLimite('COTOR',Cliente1,VTXT6));NO;SI;FSYS;'COTORVENC'
[NOT NOVACIO(CLIENTE1)] o LimAsignado(Cliente1,'COTOR',VTXT6) >= VCAN9; 'Lim.Credito excedido '~PYC(-(LimAsignado(Cliente1,'COTOR',VTXT6)-VCAN9),1,0)~'.-';NO;SI;FSYS;'COTOREXCE'
@CONDIOP

SI O Incluido(Especie,'ARP|USD') o NoVacio(VTXT18);'El Vehiculo no tiene Book Default para Monedas';NO
SI O Incluido(Especie,'ARP|USD') o NoVacio(VTXT19);'El Book default '~VTXT18~' no es valido';NO
SI O Incluido(Especie,'ARP|USD') o EqStr(VTXT20,Vehiculo1);'El Book default '~VTXT18~' corresponde a otro vehiculo';NO

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

POSTEDICION
@POSTEMM

SQL
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('COTORNOAS','COTORVENC','COTOREXCE','SETTLENOAS','SETTLEVENC','SETTLECANC') ";EqStr(ABM,'E')
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('SETTLEEXCE','CONTNOAS','CONTVENC','CONTCANC','CONTEXCE')";EqStr(ABM,'E')

MOVIMIENTOS
FechaOp ;Cliente1;Especie;;;;;Vehiculo1;1; Cantidad;;'Alta Colocacion a plazo' ;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;1;
FechaVto;Cliente1;Especie;;;;;Vehiculo1;1;-Cantidad;;'Vto.Cap Colocacion a plazo' ;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;2;;;;;;;;;;;;;;600
FechaVto;Cliente1;Especie;;;;;Vehiculo1;1;-TotalIntereses  ;;'Vto.Int. Colocacion a plazo';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;3;
FechaVto;Cliente1;Especie;;;;;Vehiculo1;1; TotalRetenciones;;'Ret. Ganancias Colocacion a plazo'  ;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;TotalRetenciones<>0;;Cuenta3;;4;
FechaVto;Cliente1;Especie;;;;;Vehiculo1;1;-TotalIVA;;'Imp.IVA Colocacion a plazo'  ;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;TotalIVA<>0;;Cuenta1;;5;
FechaOp ;Cliente1;Especie;;;;;Vehiculo1;1; PeriodoInts;;'Imp.DB/CR';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;PeriodoInts<>0     ;;Cuenta1;;6;

DEVENGADOS
FechaOp+1;FechaVto;SI;SI;NO;'ARG';SI;SI;'INTLEN';TotalIntereses;140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;;Especie;

LIMITES
FechaOp2;Cliente1;'COTOR';VTXT6;; VCAN6;TipoOp~' '~Especie;NoVacio(Cliente1);
Habiles(FechaVto,1,TablaFeriados1);Cliente1;'COTOR';VTXT6;;-VCAN6;TipoOp~' '~Especie;RB15=1 Y NoVacio(Cliente1) y Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));
FechaVto;Cliente1;'COTOR';VTXT6;;-VCAN6;TipoOp~' '~Especie;RB15=1 Y NoVacio(Cliente1) y Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2')) y Not EqStr(BuscarCampo('CLIENTES','Alias10','Codigo',CLIENTE1),'LIMITELIQ');

@INSTOPE
@INST19MM
@INST19BITS