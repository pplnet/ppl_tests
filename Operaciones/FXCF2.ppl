FechaOp;Cliente1;ContraEspecie ;;;;;Vehiculo1;1;   ImpComMer2;;'Derecho de Clearing al Alta'    ;SI; Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;2;
