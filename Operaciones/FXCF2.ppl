*FechaOp;Cliente1;ContraEspecie ;;;;;Vehiculo1;1; ImpComCorEq2;;'IVA Arancel'            ;SI; Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;6;
FechaVto;Cliente1;ContraEspecie ;;;;;Vehiculo1;1;   ImpComMer1;;'Derecho de Registro al Vto'    ;SI; Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;7;
FechaVto;Cliente1;ContraEspecie ;;;;;Vehiculo1;1;   ImpComMer2;;'Derecho de Clearing al Vto'    ;SI; Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;8;
FechaVto;Cliente1;ContraEspecie ;;;;;Vehiculo1;1;   TotalIVA;;'IVA Derecho de Registro al Vto';SI; Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;9;
FechaVto;Cliente1;ContraEspecie ;;;;;Vehiculo1;1;   TotalImpuestos;;'IVA Derecho de Clearing al Vto';SI; Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;10;

MOVCUOTAS
CuotasL.Fecha3[Fila];Cliente1;ContraEspecie;Mercado;Vehiculo1; 1; -CuotasL.Precio1[Fila];'MTM Diario';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;Fila+100;Cuenta1;;Fila+100;;;;;;;;;;;;;;;;FECHAVTO

