CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp2        : 'Fecha Conc.'                ;1;1;;VERIFICAACCESO('OPFVALOR');;FECHAOP2<=FECHAOP;'Fecha incorrecta';NO;FSYS;
FechaOp         : 'Fecha_Origen'               ;2;1;;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1);'Fecha de Origen Incorrecta';RB11 = 0;FSYS;
@VEHITO
Operador        :                              ;;2;;NO;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
Cliente1        : 'Entidad'                    ;4;1;;NOT EV;;NOVACIO(CLIENTE1) Y DESCIENDEDECLIENTE(CLIENTE1,'BANCOS'); 'La Entidad Contratante DEBE SER BANCO';NO;;;;;;;;"Status = 'HAB'";;;;
Observac2       : 'Op.Contraparte'             ;4;2;;;;NOVACIO(OBSERVAC2);'El Operador CONTRAPARTE es INVALIDO';SI;;;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
CB10            : 'Caso Pmo.|Local|Extranjero' ;5;1;;NO;NO;CB10>=0;'Debe actualizar el Pais del Cliente Seleccionado para Identificar si es Local o Extranjero';NO;;IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),0,1)
Especie         : 'Moneda'                     ;6;1;;NOT EV;;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'Debe Ingresar una Moneda';NO;;;;;;;;" Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~")and Status = 'HAB' "
Cantidad        : 'Valor Nominal'              ;;;;;;NOT EV y CANTIDAD>0;'El Valor Nominal DEBE SER POSITIVO';NO;;;;;;'###,###,###,###,###.##'
TipoTasa        : 'Tipo_Tasa'                  ;;;;;;NOVACIO(TIPOTASA);'El Tipo de Tasa ES INVALIDO';NO;'FIJA';
Precio1         : 'Tasa (%)'                   ;;;;;;PRECIO1>=0;'La Tasa Debe ser positiva';NO;
Spread          :                              ;;;;NOT EQSTR(TIPOTASA,'FIJA');NOT EQSTR(TIPOTASA,'FIJA');SPREAD>=0;'El SPREAD Debe SER POSITIVO';NO;0;
Plazo4          : 'Dias Seteo Tasa'            ;;;;;NOT EQSTR(TIPOTASA,'FIJA') y NOVACIO(TIPOTASA)];[PLAZO4>=0] O [EQSTR(TIPOTASA,'FIJA')];'Indique la Cantidad de Dias Previos al Inicio para Setear la Tasa';NO;;
RB8             : 'U.Tiempo|360|365'           ;;;;;;RB8>=0;'Unidad de Tiempo Tasa Interes INVALIDA';NO;IF(CB10=0,1,0);IF(CB10=0,1,0)
TotalIntereses  : 'Interes Pact'               ;;;;NO;;;;;;CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000);;;;;'###,###,###,###,###.##'
Plazo           : 'Plazo_VN'                   ;6;2;;;;PLAZO>0;'Debe INGRESAR el PLAZO';NO;0;
FechaVto        : 'FechaVto'                   ;;;;NO;;ESHABIL(FECHAVTO,TABLAFERIADOS1);'La Fecha de Vencimiento NO ES DIA HABIL';RB11 = 0;FECHAOP+PLAZO;FECHAOP+PLAZO
TablaFeriados1  : 'Feriados'                   ;;;;;;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE)) 
RB10            : 'Interes|Consumido|Pactado'  ;;;;;;RB10=0 o RB10=1;'Indique si es consumido o pactado';NO;;
RB14            : 'Liquidacion|Mensual|al Vto' ;;;;SI;RB10=1;RB10=0 o RB14=0 o RB14=1;'Indique Tipo de Liquidacion';NO;;;

RB3             : 'MOF'                        ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa         : 'Modificado'                 ;10;3;;NO;NO;;;;0

Cotizacion1     : 'TC_Concert.'                ;1;1;2;;Not Eqstr(ESPECIE,VAR('MONEEXTR'));;;;;IF(Eqstr(ESPECIE,VAR('MONEEXTR')),1)
Cotizacion2     : 'TC_Vencim.'                 ;;;;COTIZACION2<>0;COTIZACION2<>0;;;;
FechaPrecan     : 'F.Reset'                    ;3;1;2;NO;NOT EQSTR(TIPOTASA,'FIJA') y NOVACIO(TIPOTASA)];;;;;HABILES(FECHAOP,-PLAZO4,TABLAFERIADOS1,SI);
RB11            : 'Ajuste|NO|SI'               ;5;1;2;;NO;;;;0;
TotalAux1       : 'Saldo consumido'            ;6;1;2;NO;;;;;;;;;;'###,###,###,###,###.##'
VPRE1           : 'Cot.TC/USD'                 ;10;2; ;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(ESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)
VTXT18          : 'Book Def'    ; 1;2;2;NO;NO;;;;;BuscarCampo('VEHICULOS','Alias5','Codigo',VEHICULO1)
VTXT19          : 'Codigo Book' ; 2;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Codigo','Codigo',VTXT18)
VTXT20          : 'Vehic.Book'  ; 3;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Vehiculo','Codigo',VTXT19)
OperacionRef    : ''            ;;;;NO;NO;                 
ContraEspecie   : 'ContraEspecie';;;;NO;NO;;;;
MB3            : 'Tipo|Pasiva|Activo'         ;15;1;1;NO;NO;;;;IF(Incluido(TIPOOP,VAR('OPEACT')),1,0);IF(Incluido(TIPOOP,VAR('OPEACT')),1,0)

@CUENTAS
@RANGOTASA


LISTA:Not Eqstr(ABM, 'A');;
  Fecha1    : 'Fecha Liq.'   ;NO;;;;;;90;;Fecha;
  Cantidad1 : 'Cantidad'     ;NO;RB10=0;;;;;120;;Numero;'###,###,###,###,###.##';
  Cantidad2 : 'Interes'      ;NO;;;;;;120;;Numero;'###,###,###,###,###.##';
  Fecha2    : 'Fecha Desde.' ;NO;[RB10=1 Y RB14=0] O RB10=0;;;;;90;;Fecha;
  Fecha3    : 'Fecha Hasta'  ;NO;[RB10=1 Y RB14=0] O RB10=0;;;;;90;;Fecha;


CONDICIONES
SI O [PRECIO1<=VPRE12 Y PRECIO1>=VPRE11];'Tasa Fuera de Rango: '~VPRE11~" Y "~VPRE12;SI;SI;FSYS;'RTASA'
PRECIO1<=VAR('RTASA2') Y PRECIO1>=VAR('RTASA1');'Tasa Fuera de Rango: '~VAR('RTASA1')~" Y "~VAR('RTASA2');SI;SI;FSYS;'RTASA'
ESHABIL(FECHAOP,'ARG');'La Fecha de Origen no es Dia Habil en Argentina';SI;SI;FSYS;'ORIGINH'
ESHABIL(FECHAVTO,'ARG');'La Fecha de Vencimiento NO ES DIA HABIL en Argentina';SI;SI;FSYS;'VTOINH'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'El Cliente esta Observado';SI;SI;FSYS;'CLIOBS'
EQSTR(TIPOTASA,'FIJA') O [SPREAD>=VAR('RSPREAD1') Y SPREAD<=VAR('RSPREAD2')];'El Spread esta Fuera de Rango '~VAR('RSPREAD1')~' '~VAR('RSPREAD2');SI;SI;FSYS;'RANGOSPREAD'
FECHAOP2=Fsys;'La Fecha de Concertaci¦n no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'

@CONDIOP

SI O Incluido(Especie,'ARP|USD') o NoVacio(VTXT18);'El Vehiculo no tiene Book Default para Monedas';NO
SI O Incluido(Especie,'ARP|USD') o NoVacio(VTXT19);'El Book default '~VTXT18~' no es valido';NO
SI O Incluido(Especie,'ARP|USD') o EqStr(VTXT20,Vehiculo1);'El Book default '~VTXT18~' corresponde a otro vehiculo';NO


POSTEDICION
RB10=1 Y RB14=0;'DESCGE';NrOperacion1=NROPERACION

MOVIMIENTOS
FechaVto;Cliente1;Especie;;;;;Vehiculo1;1; TotalIntereses  ;;'Interes Pactado Descubierto';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;RB10=1 Y RB14=1;;Cuenta1;;3;

DEVENGADOS
FechaOp+1;FechaVto;RB10=1;SI;NO;'ARG';SI;SI;'INTLEN';-TotalIntereses;140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;;Especie;

POSICION

DEVENGADOSCUOTAS
CUOTASL.FECHA2[Fila]+1;CUOTASL.FECHA3[Fila];RB10=0;SI;NO;TablaFeriados1;SI;SI;'INTLEN';-CUOTASL.CANTIDAD2[Fila];140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;Fstr(Fila,0,0);Especie;;;;;;;;

MOVCUOTAS
CuotasL.Fecha1[Fila];Cliente1;Especie;;Vehiculo1;1;CuotasL.Cantidad2[Fila];'Intereses Consumido Descubierto';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;RB10=0;(Fila+5000);Cuenta1;;(Fila+5000);'CUOTAS'
CuotasL.Fecha1[Fila];Cliente1;Especie;;Vehiculo1;1;CuotasL.Cantidad2[Fila];'Intereses Pactados Mensuales Descubierto';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;RB10=1 Y RB14=0;(Fila+5000);Cuenta1;;(Fila+5000);'CUOTAS'

POSCUOTAS
CuotasL.Fecha1[Fila];Vehiculo1;Especie;;;;Vehiculo1;;;;;122; CuotasL.Cantidad2[Fila];COTIZACIONC(ESPECIE,,,,CuotasL.Fecha1[Fila]-1,1,SI,'ARP')  ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD');
CuotasL.Fecha1[Fila];Vehiculo1;Especie;;;;Vehiculo1;;;;;132; CuotasL.Cantidad2[Fila];COTIZACIONC(ESPECIE,,,,CuotasL.Fecha1[Fila]-1,1,SI,'USD')  ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD');

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

@INSTOPE
@INST19MM
@INST19BITS
