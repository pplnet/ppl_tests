CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp       : 'Fecha Conc.'              ; 1;1; ;NOT EV Y VERIFICAACCESO('OPFVALOR');;EsHabil(FECHAOP,TABLAFERIADOS1) Y EsHabil(FECHAOP,'ARG');'Fecha incorrecta';NO;FSYS;
@VEHITO

Especie       : 'Especie'                  ; 3;1; ;NOT EV y [CB13=0 o [CB13=1 y CB14=0]];;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'TITULO') y [CB13=0 o [CB13=1 y [[CB14=0 y Not EqStr(ESPECIE,VTXT2)] o [CB14=1 y EqStr(ESPECIE,VTXT2)]]]];'Debe Ingresar una Especie Valida';NO;;IF(CB13=1 y CB14=1,BuscarCampo('OPERACIONES','Especie','NrOperacion',NROPERACION5),ESPECIE);;;;;;" dbo.DESCIENDEDEESPECIE(Codigo,'TITULO') = 1 and Status = 'HAB'"
Plazo         : 'Plazo_Mon'                ; 4;1; ;  ;  ;PLAZO>=2;'El PLAZO de la MONEDA EXTRANJERA DEBE ser SUPERIOR a 1 Dia';NO;0;FECHAVTO-FECHAOP
FechaVto      : 'Vto.Mon.'                 ; 5;1; ;  ;  ;EsHabil(FECHAVTO,TABLAFERIADOS1);'No es dia habil';NO;FECHAOP+PLAZO;FECHAOP+PLAZO
ContraEspecie : 'ContraEspecie'            ; 3;2; ;NOT EV;;NoVacio(CONTRAESPECIE) y DesciendeDeEspecie(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE,ESPECIE);'Debe ingresar una ContraEspecie';NO;;COTIZAEN(ESPECIE)

Cliente1      : 'Entidad '                 ; 7;1; ;NOT EV;  ;NoVacio(CLIENTE1);'El Cliente no es valido';NO;;;;;;;;"Status = 'HAB'";;;;
Cantidad      : 'V_Nominal'                ; 8;1; ;  ;  ;CANTIDAD>0;'El Valor Nominal DEBE SER POSITIVO';NO;
Precio1       : 'Precio'                   ; 9;1; ;  ;  ;PRECIO1>0;'El Precio DEBE SER POSITIVO';NO;;
TotalBrutoCli1: 'Imp_Bruto'                ;10;1; ;NO;  ;;;;;PRECIO1*CANTIDAD;
OperacionRef  : 'Op_Referencia'            ;11;1; ;NO;NoVacio(OPERACIONREF);

Operador      :                            ; 5;2; ;NO;  ;NoVacio(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
Observac2     : 'Op.Contraparte'           ; 6;2; ;  ;  ;NoVacio(OBSERVAC2);'El Operador Contraparte no es valido';NO;;;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
TablaFeriados1: 'Feriados'                 ; 7;2; ;  ;  ;NoVacio(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE)) 

Precio4       : 'Cotizacion'               ; 8;2; ;NO;NO;;;;;CotizacionC(ESPECIE,'FUT',FECHAVTO,,FECHAOP,1,SI,CONTRAESPECIE)
TotalNetoCli1 : 'Imp_Neto'                 ; 9;2; ;NO;  ;;;;;TOTALBRUTOCLI1+(IMPGASTOS1+IMPGASTOS2+IMPCOMCOREQ1)+(IMPCOMCOR1+IMPCOMCOR2+IMPCOMCOREQ2);
FechaEj       : 'F.Cierre'                 ;10;2; ;NO;FECHAEJ > 0;
Precio2       : 'Pr.Cierre'                ;11;2; ;NO;PRECIO2 > 0;

Label6        : ''                         ;1;1;2;  ;;;;;'Derecho de Registro';'Derecho de Registro';;;;;;
ImpGastos1    : 'D. Registro'              ;2;1;2;  ;;;;;0
PorComCor1    : 'Tasa de Iva'              ;2;2;2;  ;;;;;Var('IVAGAFM') 
ImpComCor1    : 'Iva'                      ;3;1;2;NO;;IMPGASTOS1=0 O IMPCOMCOR1 > 0;'El IVA no puede ser vacio porque hay Derecho de Registro';NO;0;IMPGASTOS1*PORCOMCOR1/100
ContraEspecie2: 'Moneda'                   ;3;2;2;NO;;;;;Var('MONELOCA');

Label7        : ''                         ;6;1;2;  ;;;;;'Derecho de Clearing';'Derecho de Clearing';;;;;;
ImpGastos2    : 'D. Clearing'              ;7;1;2;  ;;;;;0
PorComMer1    : 'Tasa de Iva'              ;7;2;2;  ;;;;;Var('IVAGAFM') 
ImpComCor2    : 'Iva'                      ;8;1;2;NO;;IMPGASTOS2=0 O IMPCOMCOR2>0;'El IVA no puede ser vacio porque hay Derecho de Clearing';NO;0;IMPGASTOS2*PORCOMMER1/100
ContraEspecie3: 'Moneda'                   ;8;2;2;NO;;;;;Var('MONELOCA');

Label8        : ''                         ;11;1;2;  ;;;;;'Aranceles';'Aranceles';;;;;;
PorComCor2    : '% Arancel'                ;12;1;2;  ;;;;;Var('PORARANCEL') ;;
ImpComCorEq1  : 'Monto de Arancel'         ;12;2;2;  ;;;;;0;TOTALBRUTOCLI1*PORCOMCOR2/100;
PorComMer2    : 'Tasa de Iva'              ;13;1;2;  ;;;;;Var('IVAGAFM');
ImpComCorEq2  : 'Iva'                      ;13;2;2;NO;;IMPCOMCOREQ1=0 O IMPCOMCOREQ2>0;'El IVA no puede ser vacio porque hay Arancel';NO;0;IMPCOMCOREQ1*PORCOMMER2/100;
ContraEspecie4: 'Moneda'                   ;14;1;2;NO;;;;;Var('MONELOCA');

Mercado       : 'Mercado'                  ;15;1;2;SI;SI;;;;;Var('MERROFEX')
CB5           : 'MTM'                      ;15;2;2;NO;;
UMedida       : 'Numero AFIP'              ;16;1;2;NO;NO;;;;;;;;;

VCAN2         : 'LimCon Especie'           ;10;2;2;NO;NO;;;;;LimConsumido(CLIENTE1,'SETTLEMENT',ESPECIE,FECHAVTO,,,,NROPERACION)
VCAN3         : 'LimCon C-Esp'             ;11;2;2;NO;NO;;;;;LimConsumido(CLIENTE1,'SETTLEMENT',CONTRAESPECIE,FECHAPAGO,,,,NROPERACION)
VCAN4         : 'Especie'                  ;12;2;2;NO;NO;;;;;IF(VCAN2+VCAN8>0,IF(VCAN2<0,VCAN2+VCAN8,VCAN8),0)
VCAN5         : 'ContraEspecie'            ;13;2;2;NO;NO;;;;;IF(VCAN3>0,IF(VCAN3-VCAN8>0,-VCAN8,-VCAN3),0)
VCAN1         : 'T.Settlement'             ;14;2;2;NO;NO;;;;;LIMSUMADO(CLIENTE1,'SETTLEMENT',FECHAVTO,,,,NROPERACION)+VCAN4+VCAN5
VCAN6         : 'T.SetCre'                 ;15;2;2;NO;NO;;;;;LimConsumido(CLIENTE1,'SETCRE',VTXT6,0,,,,NROPERACION,FECHAPAGO)+VCAN8
VCAN7         : 'T.Sett.c/SetCre'          ;16;2;2;NO;NO;;;;;LimConsumido(CLIENTE1,'SETCRE',VTXT6,0,,,,NROPERACION,FECHAPAGO)+VCAN1
VCAN8         : 'Equivalente Sett'         ;17;2;2;NO;NO;;;;;If(EqStr(ESPECIE,VTXT6),CANTIDAD,TOTALBRUTOCLI1*CotizacionC(CONTRAESPECIE,,,,Fsys,1,SI,VTXT6) )
VPRE8         : 'Equivalente Contract'     ;17;2;2;NO;NO;;;;;If(EqStr(ESPECIE,VTXT7),CANTIDAD,TOTALBRUTOCLI1*CotizacionC(CONTRAESPECIE,,,,Fsys,1,SI,VTXT7) )
VCAN9         : 'T.Contract'               ;18;2;2;NO;NO;;;;;LimConsumido(CLIENTE1,'CONTRACT',VTXT6,0,,,,NROPERACION,FECHAPAGO)+VPRE8
VTXT6         : 'EspecieLimiteSett'        ; 1;2;2;NO;NO;;;;;Query("SELECT Especie FROM "~DBO~".LIMASIGNADOS WHERE Cliente='"~CLIENTE1~"' AND Limite='SETTLEMENT' ")
VTXT7         : 'EspecieLimiteContract'    ; 1;2;2;NO;NO;;;;;Query("SELECT Especie FROM "~DBO~".LIMASIGNADOS WHERE Cliente='"~CLIENTE1~"' AND Limite='CONTRACT'   ")
VPRE6         : 'Cot.CONTESP/USD'          ;10;3;2;NO;NO;;;;;CotizacionC(CONTRAESPECIE,,,,Fsys,1,SI,Var('MONEEXTR'))
PrecioMer     : 'Monto USD WF'             ;10;2;2;NO;NO;;;;TOTALBRUTOCLI1*VPRE6;TOTALBRUTOCLI1*VPRE6
SectorRB      : 'Fuera Param Mer|NO|SI'    ; 2;2;2;NO;NO;;;;
Cuotas1       : 'Movimientos'              ;  ; ; ;NO;NO;;;;;Query("SELECT Max(NrCuota) FROM "~DBO~".CUOTAS WHERE NrOperacion='"~NROPERACION~"'")
TotalAux3     : 'Total MTM'                ;  ; ; ;NO;NO;;;;;0

@FXCTACONT
@CUENTAS
@CUENTAS2

MTMDIARIO:Fsys>FECHAOP Y NOT EQSTR(ABM,'A');;  
  NrOperacion : 'Operacion'   ;NO;;;;;;100;NO;String;;  
  Fecha       : 'Fecha MTM'   ;NO;;;;;;100;NO;Fecha;  
  PrecioHoy   : 'Precio Hoy'  ;NO;;;;;;90;NO;Numero;'###.########';  
  PrecioAyer  : 'Precio Ayer' ;NO;;;;;;90;NO;Numero;'###.########';  
  MTM         : 'MTM'         ;NO;;;;;;90;NO;Numero;'###,###.##';  

CONDICIONES
NOT EqStr(Especie,ContraEspecie);'La Moneda de Compra y la CONTRAESPECIE son IGUALES';NO
EqStr(ContraEspecie,'ARP');'La Moneda de Pago DEBE SER PESOS';NO
EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB');'El Cliente No esta Habilitado';NO
EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La Especie No esta Habilitada';NO
EqStr(BuscarCampo('Especies','Status','Codigo',ContraEspecie),'HAB');'La ContraEspecie No esta Habilitada';NO
PRECIO1<=PRECIO4*(1+Var('RPRECIO2')/100) Y PRECIO1>=PRECIO4*(1-Var('RPRECIO2')/100);'Tipo de Cambio Fuera de Rango: '~FSTR(PRECIO4*(1-Var('RPRECIO2')/100),1,7)~' y '~FSTR(PRECIO4*(1+Var('RPRECIO2')/100),1,7);NO
PRECIO1<=PRECIO4*(1+Var('RPRECIO') /100) Y PRECIO1>=PRECIO4*(1-Var('RPRECIO') /100);'Tipo de Cambio FUERA DE RANGO: '~FSTR(PRECIO4*(1-Var('RPRECIO')/100),1,7)~' y '~FSTR(PRECIO4*(1+Var('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOPRECIO'
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'El Cliente esta Observado';SI;SI;FSYS;'CLIOBS'
VACIO(CORREDOR) o [PORCOMCOR1>=Var('RCOMCOR1') y PORCOMCOR1<=Var('RCOMCOR2')];'El % Comision Corredor EXCEDE Los Limites: Min.'~Var('RCOMCOR1')~' Max.'~Var('RCOMCOR2');NO
VACIO(CORREDOR) O [TCCOMCOR1<=TIPOCAMBIO2*(1+Var('RPRECIO2')/100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-Var('RPRECIO2')/100)];'Cambio COMISION CORREDOR Fuera de Rango: '~FSTR(TIPOCAMBIO2*(1-Var('RPRECIO2')/100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+Var('RPRECIO2')/100),1,7);NO
VACIO(CORREDOR) O [TCCOMCOR1<=TIPOCAMBIO2*(1+Var('RPRECIO') /100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-Var('RPRECIO') /100)];'Cambio  COMISION CORREDOR  FUERA DE RANGO: '~FSTR(TIPOCAMBIO2*(1-Var('RPRECIO')/100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+Var('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOPRECIO'
NOT EQSTR (VEHICULO1,CLIENTE1);'El Cliente y el Vehiculo deben ser distintos';NO
EsTerminal(VEHICULO1,VEHICULO);'El Vehiculo debe ser Terminal';NO
EsTerminal(CLIENTE1,CLIENTE);'El Cliente debe ser Terminal';NO
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
VACIO(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR)) O  VERIFICAPERFIL(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR),'TO'~TIPOOP);'Operador no habilitado para ingresar Operaciones del Tipo '~TIPOOP;NO
FinDeMes(FECHAVTO, NO, TABLAFERIADOS1)=FECHAVTO;'La fecha de vencimiento no es fin de mes';SI


SI O [NOT NoVacio(CLIENTE1)] o [FormaLiquidacion1=1] o ExisteLimite('SETTLEMENT',Cliente1,VTXT6)                                                        ; 'Settlement no asignado'                                                                  ;NO;SI;FSYS;'SETTLENOAS'
SI O [NOT NoVacio(CLIENTE1)] o [FormaLiquidacion1=1] o Not ExisteLimite('SETTLEMENT',Cliente1,VTXT6) o VtoLimite('SETTLEMENT',Cliente1,VTXT6) >= FechaOp; 'Settlement vencido el '~FECHA(VtoLimite('SETTLEMENT',Cliente1,VTXT6))                    ;NO;SI;FSYS;'SETTLEVENC'
SI O [NOT NoVacio(CLIENTE1)] o [FormaLiquidacion1=1] o Not LimCancelado('SETTLEMENT',Cliente1,VTXT6)                                                    ; 'Settlement cancelado'                                                                    ;NO;SI;FSYS;'SETTLECANC'
SI O [NOT NoVacio(CLIENTE1)] o [FormaLiquidacion1=1] o LimAsignado(Cliente1,'SETTLEMENT',VTXT6) >= VCAN6                                                ; 'Settlement excedido en '~PYC(VCAN6-LimAsignado(Cliente1,'SETTLEMENT',VTXT6),1,0)~'.-';NO;SI;FSYS;'SETTLEEXCE'

SI O [[NOT NoVacio(CLIENTE1)] o [FormaLiquidacion1=1] o ExisteLimite('CONTRACT',Cliente1,VTXT7)                                                          ]; 'Contract no asignado'                                                                    ;SI;SI;FSYS;'CONTNOAS'
SI O [[NOT NoVacio(CLIENTE1)] o [FormaLiquidacion1=1] o Not ExisteLimite('CONTRACT',Cliente1,VTXT7) o VtoLimite('CONTRACT',Cliente1,VTXT7) >= FechaOp    ]; 'Contract vencido el '~FECHA(VtoLimite('CONTRACT',Cliente1,VTXT7))                        ;SI;SI;FSYS;'CONTVENC'
SI O [[NOT NoVacio(CLIENTE1)] o [FormaLiquidacion1=1] o Not LimCancelado('CONTRACT',Cliente1,VTXT7)                                                      ]; 'Contract cancelado'                                                                      ;SI;SI;FSYS;'CONTCANC'
SI O [[NOT NoVacio(CLIENTE1)] o [FormaLiquidacion1=1] o LimAsignado(Cliente1,'CONTRACT',VTXT7) >= VCAN9                                                  ]; 'Contract excedido en '~PYC(VCAN9-LimAsignado(Cliente1,'CONTRACT',VTXT7),1,0)~'.-'        ;SI;SI;FSYS;'CONTEXCE'

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

SQL
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('COTORNOAS','COTORVENC','COTOREXCE','SETTLENOAS','SETTLEVENC','SETTLECANC') ";EqStr(ABM,'E')
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('SETTLEEXCE','CONTNOAS','CONTVENC','CONTCANC','CONTEXCE')";EqStr(ABM,'E')

MOVIMIENTOS 
FechaOp;Cliente1;ContraEspecie ;;;;;Vehiculo1;1;   ImpGastos1;;'Derecho de Registro'    ;SI; Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta2;;1;
FechaOp;Cliente1;ContraEspecie ;;;;;Vehiculo1;1;   ImpGastos2;;'Derecho de Clearing'    ;SI; Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta2;;2;
FechaOp;Cliente1;ContraEspecie ;;;;;Vehiculo1;1; ImpComCorEq1;;'Arancel'                ;SI; Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta2;;3;
FechaOp;Cliente1;ContraEspecie ;;;;;Vehiculo1;1;   ImpComCor1;;'IVA Derecho de Registro';SI; Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta2;;4;
FechaOp;Cliente1;ContraEspecie ;;;;;Vehiculo1;1;   ImpComCor2;;'IVA Derecho de Clearing';SI; Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta2;;5;
FechaOp;Cliente1;ContraEspecie ;;;;;Vehiculo1;1; ImpComCorEq2;;'IVA Arancel'            ;SI; Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta2;;6;

MOVMTMDIARIO  
MTM.Fecha[Fila];Cliente1;ContraEspecie;Mercado;Vehiculo1;1;-MTM.MTM[Fila];'Liquidacion MTM '~Especie;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;Fila+100;Cuenta2;;Fila+100;'TI';;;;;;Book1

