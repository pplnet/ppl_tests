    ContraEspecie : 'Moneda'                         ; ; ; ;NO;;NOVACIO(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE,ESPECIE);'Debe ingresar una ContraEspecie';NO;VTXT40;IF(RB4=0 Y NoVacio(NRORDEN),BuscarCampo('ORDENES','Especie','NrOrden',NRORDEN),CotizaEn(ESPECIE))
