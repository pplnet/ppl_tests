    *Cantidad Completada Ordenes
    @ORCCTNC
%%endif
@CONDIOP

SI O Incluido(ContraEspecie, VTXT40~'|'~Var('MONEEXTR')) o NoVacio(VTXT18);'El Vehiculo no tiene Book Default para Monedas';NO
SI O Incluido(ContraEspecie, VTXT40~'|'~Var('MONEEXTR')) o NoVacio(VTXT19);'El Book default '~VTXT18~' no es valido';NO
SI O Incluido(ContraEspecie, VTXT40~'|'~Var('MONEEXTR')) o EqStr(VTXT20,Vehiculo1);'El Book default '~VTXT18~' corresponde a otro vehiculo';NO


EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

MOVIMIENTOS
FechaVto ;Cliente1 ;Especie      ;;;;;Vehiculo1;1;      Cantidad;;'Rescate de Fondos Cuotapartes';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;Round(TotalNetoCli1, 2)<>0 Y Cantidad>0;;Cuenta1;;1;;;;;;;;;;;;;;500
FechaVto2;Cliente1 ;ContraEspecie;;;;;Vehiculo1;1;-TotalNetoCli1;;'Rescate de Fondos Efectivo'   ;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;Round(TotalNetoCli1, 2)<>0;;Cuenta2;;2;;;;;;;;;;;;;;600
FechaOp  ;Vehiculo1;Especie      ;;;;;Vehiculo1;2;     -Cantidad;;'Rescate de Fondos Cuotapartes';SI;SI;;Round(TotalNetoCli1, 2)<>0 Y Cantidad>0;;Cuenta1;;;;;;;;;Book1;

FechaVto2;Vehiculo1;ContraEspecie;;;;;Vehiculo1;50;TotalNetoCli1;;'Rescate de Fondos '~ESPECIE;SI;SI;;Eqstr(BuscarCampo('CUENTAS','TipoCuenta','Codigo', Cuenta2), 'CUS') Y FechaVto2>=Fecha(Var('FECHAMIGRA'));;Cuenta2;;10;;;;;;;;;;;;;;

POSICION
FechaOp;Vehiculo1;Especie;;;;Vehiculo1;;;;;101;-Cantidad;Precio1;;;Book1;;'FC'

FechaOp;Vehiculo1;Especie;;;;Vehiculo1;;;;;121;-Cantidad;Precio1*if(EqStr(ContraEspecie,VTXT40),1,COTIZACIONC(CONTRAESPECIE,,,,FECHAOP-1,1,SI,VTXT40));;;BOOK1;;'FC';
FechaOp;Vehiculo1;Especie;;;;Vehiculo1;;;;;131;-Cantidad;Precio1*if(EqStr(ContraEspecie,Var('MONEEXTR')),1,COTIZACIONC(CONTRAESPECIE,,,,FECHAOP-1,1,SI,Var('MONEEXTR')));;;BOOK1;;'FC';

FechaOp;Vehiculo1;ContraEspecie;;;;Vehiculo1;;;;;122; TotalNetoCli1;COTIZACIONC(CONTRAESPECIE,,,,FECHAOP-1,1,SI,VTXT40);;;VTXT19;;'FXS';Not Incluido(ContraEspecie, VTXT40~'|'~Var('MONEEXTR'));
FechaOp;Vehiculo1;ContraEspecie;;;;Vehiculo1;;;;;132; TotalNetoCli1;COTIZACIONC(CONTRAESPECIE,,,,FECHAOP-1,1,SI,Var('MONEEXTR'));;;VTXT19;;'FXS';Not Incluido(ContraEspecie, VTXT40~'|'~Var('MONEEXTR'));


POSICION2
FechaOp;Vehiculo1;Book1;'FC';Especie;'0';1;ContraEspecie;-Cantidad;Precio1;0;'1';  
