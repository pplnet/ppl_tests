    *Actualiza ejecuciones cuando se da de baja la operación. NOTA: El campo cantidad se invierte el signo en el evento
    NoVacio(NRORDEN) Y EqStr(ABM,'D') ;'ACTEJE';Radio1=1;NrOrden=NRORDEN;NrOperacion1=NROPERACION;TipoOp1=TIPOOP;Cliente1 = CLIENTE1;Fecha1=FECHAOP;Fecha2=FECHAVTO;Cantidad1=TOTALNETOCLI1
%%endif
