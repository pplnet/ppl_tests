CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp        : 'Fecha Conc.'                  ; 1;1; ;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,'ARG') y ESHABIL(FECHAOP,TABLAFERIADOS1);'Fecha incorrecta';NO;FSYS;
@VEHITO
CB6            : 'Cot_Directa?'                 ; 2;1; ;  ;  ;;;;;IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE~"' "),'INV'),0,1)
Especie        : 'Mon_Recibida'                 ; 3;1; ;NOT EV;  ;NOVACIO(ESPECIE) y [DESCIENDEDEESPECIE(ESPECIE,'MONEDA') o EqStr(Especie,'ORO')] y ESTERMINAL(ESPECIE, ESPECIE);'Debe Ingresar una Especie Valida';NO;;;;;;;;" Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA'))~") and Status = 'HAB'";;;
ContraEspecie  : 'Mon_Entregada'                ; 4;1; ;NOT EV;  ;NOVACIO(CONTRAESPECIE) y [DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') o EqStr(ContraEspecie,'ORO')] y ESTERMINAL(CONTRAESPECIE,ESPECIE);'Debe ingresar una ContraEspecie';NO;;;;;;;;" Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA'))~")and Status = 'HAB' ";;;;;;
FechaVto       : 'Vto.M.Rec'                    ; 3;2; ;VALORRB1=4;  ;EsHabil(FECHAVTO,TABLAFERIADOS1);'No es un Dia Habil';NO;0;IF(VALORRB1<0,0,IF(VALORRB1<>4,HABILES(FECHAOP,VALORRB1,TABLAFERIADOS1),FECHAOP))
FechaPago      : 'Vto.M.Ent'                    ; 4;2; ;VALORRB2=4;  ;EsHabil(FECHAPAGO,TABLAFERIADOS2);'No es un Dia Habil';NO;0;IF(VALORRB2<0,0,IF(VALORRB2<>4,HABILES(FECHAOP,VALORRB2,TABLAFERIADOS2),FECHAOP))
ValorRB1: 'Plazo M.Rec.|Hoy|24Hs|48Hs|72Hs|Otro'; 5;2; ;  ;  ;
ValorRB2: 'Plazo M.Ent.|Hoy|24Hs|48Hs|72Hs|Otro'; 6;2; ;  ;  ;
Cliente1       : 'Entidad '                     ; 7;1; ;NOT EV;  ;NOVACIO(CLIENTE1);'El Cliente no es valido';NO;;;;;;;;"Status = 'HAB'";;;;
Cantidad       : 'VN_Recibir'                   ; 8;1; ;RB6=0;  ;CANTIDAD>0;'El Importe a Recibir debe ser Positivo';NO;;IF(RB6=1,TOTALBRUTOCLI1*IF(CB6=0,PRECIO1,1/PRECIO1),CANTIDAD)
Precio1        : 'Precio'                       ; 9;1; ;  ;  ;PRECIO1>0 ;'El Tipo de Cambio debe ser Positivo';NO;0;;;;;;'###.########';;
TotalBrutoCli1 : 'VN_Entregar'                  ;10;1; ;RB6=1;  ;CANTIDAD>0;'El Importe a entregar debe ser Positivo';NO;;IF(RB6=0,CANTIDAD*IF(CB6=1,PRECIO1,1/PRECIO1),TOTALBRUTOCLI1)
RB6           : 'Partida_Operada|VN_Rec|VN_Entr'; 7;2; ;  ;  ;;;;1;
Operador       :                                ; 8;2; ;NO; ;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
Observac2      : 'Op.Contraparte'               ; 9;2; ;  ;  ;NOVACIO(OBSERVAC2);'El Operador Contraparte no es valido';SI;;;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
TablaFeriados1 : 'Feriados Rec.'                ;13;1; ;  ;  ;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE)) 
Cotizacion1    : 'TC_Concert.'                  ;14;1; ;  ;Not [Eqstr(ESPECIE,VAR('MONEEXTR')) o Eqstr(CONTRAESPECIE,VAR('MONEEXTR'))];[Eqstr(ESPECIE,VAR('MONEEXTR')) o Eqstr(CONTRAESPECIE,VAR('MONEEXTR'))] O [COTIZACION1<=VPRE1*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE1*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE1*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE1*(1+VAR('RPRECIO2')/100),1,7);NO;;IF([Eqstr(ESPECIE,VAR('MONEEXTR')) o Eqstr(CONTRAESPECIE,VAR('MONEEXTR'))],1)
Cotizacion2    : 'TC_Vencim.'                   ;15;1; ;COTIZACION2<>0;COTIZACION2<>0;;;;

DeltaTasa       : '%Imp.DB/CR'                  ;16;1; ;;;[Incluido(Fstr(DELTATASA,2,2),VAR('IMPCHEQUE'))];'El Valor de TASA Impuesto CHEQUE Es Erroneo: '~VAR('IMPCHEQUE')~' ...';NO;0;;;;;;'###,###.######'
PeriodoInts     : 'Imp.DB/CR'                   ;17;1; ;EV;;NOT EV o [PERIODOINTS   <= ROUND(VPRE3*(1+Var('PORVAR')/100),2) y PERIODOINTS>= ROUND(VPRE3*(1-Var('PORVAR')/100),2)];'Impuesto al Cheque CR Fuera de Rango: '~FSTR(ROUND(VPRE3*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VPRE3*(1+Var('PORVAR')/100),2),0,2);NO;;TOTALBRUTOCLI1*(DELTATASA/100);;;;;'###,###,###,###,###.##'
VPRE3           : 'Imp_Cheque CR'               ;18;1; ;NO;NO;;;;;TOTALBRUTOCLI1*(DELTATASA/100);;;;;'###,###,###,###,###.##'

VPRE2          : 'Pr.Pos/USD'                   ;16;2; ;NO;NO;;;;;PRECIO1^If(EqStr(Modo(IF(EqStr(ESPECIE,'USD'),CONTRAESPECIE,ESPECIE),VAR('MONEEXTR')),'DIR'),1,-1)
VPRE4          : 'Pr.Pos/ARP'                   ;17;2; ;NO;NO;;;;;VPRE2*COTIZACIONC('USD',,,,FECHAOP-1,1,SI,VTXT40)
VPRE1          : 'Cot.TC/USD'                   ;10;2; ;NO;NO;;;;;COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(CONTRAESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)
TablaFeriados2 : 'Feriados Ent.'                ;13;2; ;  ;  ;NOVACIO(TABLAFERIADOS2);'Se debe indicar feriados a utilizar';NO;;BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',CONTRAESPECIE)) 
OperacionRef   : 'Op_Referencia'                ;14;2; ;NO;NOVACIO(OPERACIONREF);;;;;; 

Precio4        : 'Cotizacion'                   ; 2;2;2;NO;NO;;;;;IF(CB6=1,COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VTXT40)/COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,VTXT40),COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,VTXT40)/COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VTXT40))
TotalNetoCli1  : 'Imp.Neto'                     ;11;2; ;NO;  ;;;;;IF(RB6=0, IF(EQSTR(ESPECIE,CONTRAESPECIE2),CANTIDAD-IF(RB7=0,IMPCOMCOREQ1,0), IF(EQSTR(CONTRAESPECIE,CONTRAESPECIE2),TOTALBRUTOCLI1+IF(RB7=0,IMPCOMCOREQ1,0),TOTALBRUTOCLI1)), IF(EQSTR(ESPECIE,CONTRAESPECIE2),CANTIDAD-IF(RB7=0,IMPCOMCOREQ1,0), IF(EQSTR(CONTRAESPECIE,CONTRAESPECIE2),TOTALBRUTOCLI1+IF(RB7=0,IMPCOMCOREQ1,0),CANTIDAD)))
Corredor       : 'Corredor'                     ; 1;1;2;  ;  ;
ContraEspecie2 : 'Moneda Comision'              ; 2;1;2;;  ;VACIO(CORREDOR) O [NOVACIO(CONTRAESPECIE2) y DESCIENDEDEESPECIE(CONTRAESPECIE2,'MONEDA') y ESTERMINAL(CONTRAESPECIE2,ESPECIE)];'Especie de Pago Comision Corredor INVALIDA';NO;;IF(MODI,CONTRAESPECIE2,CONTRAESPECIE);;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~")and Status = 'HAB' ";;
PorComCor1     : 'Comision'                     ; 3;1;2;;  ;;;;;IF(MODI,PORCOMCOR1,BuscarCampo('CORREDORES','ComisionDefault1','Codigo',CORREDOR));
TCComCor1      : 'T.Cambio'                     ; 4;1;2;;  ;VACIO(CORREDOR) O TCCOMCOR1>=0;'Tipo de Cambio del Corredor INVALIDO';NO;;
ImpComCor1     : 'Imp.Comision'                 ; 5;1;2;NO;  ;;;;;IF(RB6=0,TOTALBRUTOCLI1,CANTIDAD)*(PORCOMCOR1/100)
ImpComCorEq1   : 'Importe Eq.'                  ; 6;1;2;NO;  ;;;;;IMPCOMCOR1*IF(CB7=1,TCCOMCOR1,IF(TCCOMCOR1<>0,1/TCCOMCOR1,0))
RB7            : 'Deducible|SI|NO'              ; 7;1;2;;  ;VACIO(CORREDOR) O RB7>=0;'Indique Deducible / No Deducible';NO;1;
PlazoRenovPredeter : 'Cot.Contable'             ; 7;2;2;NO Y[NOT EQSTR (COTIZAEN(ESPECIE),CONTRAESPECIE)];NO Y [NOT EQSTR(COTIZAEN(ESPECIE),CONTRAESPECIE)];SI O [EQSTR(COTIZAEN(ESPECIE),CONTRAESPECIE) o PLAZORENOVPREDETER > 0];'REQUIERE COTIZACION CONTABLE';NO;;IF(MODI, PLAZORENOVPREDETER, IF(Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE), IF(Eqstr(CotizaEn(ESPECIE), VAR('MONELOCA') ), 1 , COTIZACIONBNA(CONTRAESPECIE,FECHAOP,1,NO,NO) )   ))

TipoCambio2    : 'Cot.Esp/ComCor'               ; 8;2;2;NO;NO;;;;;IF(CB7=1,COTIZACIONC(IF(RB6=0,CONTRAESPECIE,ESPECIE),,,,FECHAOP,1,SI,VTXT40)/COTIZACIONC(CONTRAESPECIE2,,,,FECHAOP,1,SI,VTXT40),COTIZACIONC(CONTRAESPECIE2,,,,FECHAOP,1,SI,VTXT40)/COTIZACIONC(IF(RB6=0,CONTRAESPECIE,ESPECIE),,,,FECHAOP,1,SI,VTXT40))
CB7            : 'Cot.Esp/ComCorDirecta'        ; 9;2;2;NO;NO;;;;;IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~IF(RB6=0,CONTRAESPECIE,ESPECIE)~"' and Especie2='"~CONTRAESPECIE2~"' "),'INV'),0,1)
RB1            : 'Genero CV|NO|SI'              ; 7;1;3;NO;NO;;;;;;
RB3            : 'MOF'                          ;10;2; ;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa        : 'Modificado'                   ;10;3; ;NO;NO;;;;0
VPRE5          : 'Cot.Esp/USD'                  ;10;3; ;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,Fsys,1,SI,'USD')
VPRE6          : 'Cot.ConEsp/USD'               ;10;3; ;NO;NO;;;;;COTIZACIONC(CONTRAESPECIE,,,,Fsys,1,SI,'USD')
PaseCB         : 'Proviene de Repo'             ;10;3; ;NO;NO;;;;0
VCAN2          : 'LimCon Especie'               ;10;3; ;NO;NO;;;;;LIMCONSUMIDO(CLIENTE1,'SETTLEMENT',ESPECIE,FECHAVTO,,,,NROPERACION)
VCAN3          : 'LimCon C-Esp'                 ;11;3; ;NO;NO;;;;;LIMCONSUMIDO(CLIENTE1,'SETTLEMENT',CONTRAESPECIE,FECHAPAGO,,,,NROPERACION)
VCAN4          : 'Especie'                      ;12;3; ;NO;NO;;;;;IF(VCAN2+VCAN8>0,IF(VCAN2<0,VCAN2+VCAN8,VCAN8),0)
VCAN5          : 'ContraEspecie'                ;13;3; ;NO;NO;;;;;IF(VCAN3>0,IF(VCAN3-VCAN8>0,-VCAN8,-VCAN3),0)
VCAN1          : 'Total Settlement'             ;14;3; ;NO;NO;;;;;LIMSUMADO(CLIENTE1,'SETTLEMENT',FECHAVTO,,,,NROPERACION)+VCAN4+VCAN5
VCAN6          : 'Total SetCre'                 ;15;2;2;NO;NO;;;;;LIMCONSUMIDO(CLIENTE1,'SETCRE',VTXT6,0,,,,NROPERACION,FECHAPAGO)+VCAN8
VCAN7          : 'Total Sett.c/SetCre'          ;16;2;2;NO;NO;;;;;LIMCONSUMIDO(CLIENTE1,'SETCRE',VTXT6,0,,,,NROPERACION,FECHAPAGO)+VCAN1
VCAN8          : 'Equivalente USD'              ;17;2;2;NO;NO;;;;;if(EqStr(ESPECIE,VTXT6),CANTIDAD,TOTALBRUTOCLI1*COTIZACIONC(CONTRAESPECIE,,,,Fsys,1,SI,VTXT6))
VCAN12         : 'Cotizacion de Mercado'        ;18;2;2;No;No;;;;;COTIZACIONC(COTIZAEN(ESPECIE),,,,FECHAOP,1,SI,CONTRAESPECIE))

VTXT6          : 'EspecieLimiteSett'            ; 1;2;2;NO;NO;;;;;QUERY("SELECT Especie FROM "~DBO~".LIMASIGNADOS WHERE Cliente='"~CLIENTE1~"' AND Limite='SETTLEMENT' ")
PrecioMer      : 'Monto USD WF'                 ;10;2;2;NO;NO;;;;;IF(Eqstr(ESPECIE, Var('MONEEXTR')), CANTIDAD, IF(Eqstr(CONTRAESPECIE, Var('MONEEXTR')), TOTALBRUTOCLI1, TOTALBRUTOCLI1*VPRE6))

VCB1          : 'Usa Tolerancia 3er Nivel' ;14;1;2;NO;NO;;;;IF(Incluido(TIPOOP,VAR('OPETENITO')),1,0);IF(Incluido(TIPOOP,VAR('OPETENITO')),1,0)
VPRE11        : 'Rango p/ TC Concertacion' ;14;2;2;NO;NO;;;;IF(Incluido(TIPOOP,VAR('OPETENITO')),VAR('RPRECIO3'),VAR('RPRECIO2'));IF(Incluido(TIPOOP,VAR('OPETENITO')),VAR('RPRECIO3'),VAR('RPRECIO2'))

@FXCTACONT
@CUENTAS


CONDICIONES
Not Incluido(ESPECIE,VAR('BONOCANJ'));'La Moneda no debe estar Incluida en la Lista '~VAR('BONOCANJ');NO
[FECHAVTO<=HABILES(FECHAOP,3,TABLAFERIADOS1) Y FECHAVTO>=FECHAOP];'La Fecha de Vencimiento de la Moneda Recibida Debe estar dentro de las 72 Hs.';NO
[FECHAPAGO<=HABILES(FECHAOP,3,TABLAFERIADOS2) Y FECHAPAGO>=FECHAOP];'La Fecha de Vencimiento de la Moneda Entregada Debe estar dentro de las 72 Hs.';NO
NOT EqStr(Especie,ContraEspecie);'La Moneda de Compra y la CONTRAESPECIE son IGUALES';NO
NOT EqStr(ContraEspecie, VTXT40) Y NOT EqStr(Especie, VTXT40);'No pueden existir arbitrajes En Moneda Local';NO
Vacio(Cliente1) o EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB');'El Cliente No esta Habilitado';NO
EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La Especie No esta Habilitada';NO
EqStr(BuscarCampo('Especies','Status','Codigo',ContraEspecie),'HAB');'La ContraEspecie No esta Habilitada';NO

SI O [VCB1=1 O [PRECIO1<=PRECIO4*(1+VAR('RPRECIO')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO')/100)]];'Tipo de Cambio Fuera de Rango Nivel 1: ['~FSTR(PRECIO4*(1-VAR('RPRECIO') /100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO') /100),1,7)~']';SI;SI;FSYS;'RANGOPREC1'
PRECIO1<=PRECIO4*(1+VAR('RPRECIO')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO')/100);'Tipo de Cambio FUERA DE RANGO: '~FSTR(PRECIO4*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOPRECIO'
SI O [VCB1=1 O [PRECIO1<=PRECIO4*(1+VAR('RPRECIO2')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO2')/100)]];'Tipo de Cambio Fuera de Rango Nivel 2: ['~FSTR(PRECIO4*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO2')/100),1,7)~']';SI;SI;FSYS;'RANGOPREC2'
PRECIO1<=PRECIO4*(1+VAR('RPRECIO2')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO2')/100);'Tipo de Cambio Fuera de Rango: '~FSTR(PRECIO4*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO2')/100),1,7);SI;SI;FSYS;'RANGOPRECIO2'
SI O [VCB1=0 O [PRECIO1<=PRECIO4*(1+VAR('RPRECIO3')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO3')/100)]];'Tipo de Cambio Fuera de Rango Nivel 3: ['~FSTR(PRECIO4*(1-VAR('RPRECIO3')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO3')/100),1,7)~']';SI;SI;FSYS;'RANGOPREC3'

SI O VCB1=1 O [Eqstr(COTIZAEN(ESPECIE),CONTRAESPECIE) O PlazoRenovPredeter = 0 O PlazoRenovPredeter<=VCAN12*(1+VAR('RPRECIO') /100) Y PlazoRenovPredeter>=VCAN12*(1-VAR('RPRECIO') /100)];'COTIZACION CONTABLE FUERA DE RANGO: '~FSTR(VCAN12*(1-VAR('RPRECIO') /100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO') /100),1,7);SI;SI;FSYS;'RANGOCOTCON'
SI O VCB1=1 O [Eqstr(COTIZAEN(ESPECIE),CONTRAESPECIE) O PlazoRenovPredeter = 0 O PlazoRenovPredeter<=VCAN12*(1+VAR('RPRECIO2')/100) Y PlazoRenovPredeter>=VCAN12*(1-VAR('RPRECIO2')/100)];'COTIZACION CONTABLE Fuera de Rango: '~FSTR(VCAN12*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO2')/100),1,7);NO
SI O VCB1=0 O [Eqstr(COTIZAEN(ESPECIE),CONTRAESPECIE) O PlazoRenovPredeter = 0 O PlazoRenovPredeter<=VCAN12*(1+VAR('RPRECIO3')/100) Y PlazoRenovPredeter>=VCAN12*(1-VAR('RPRECIO3')/100)];'COTIZACION CONTABLE FUERA DE RANGO: '~FSTR(VCAN12*(1-VAR('RPRECIO3')/100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO3')/100),1,7);NO

Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'El Cliente esta Observado';SI;SI;FSYS;'CLIOBS'
SI O [VACIO(Corredor) o [PORCOMCOR1>=VAR('RCOMCOR1') y PORCOMCOR1<=VAR('RCOMCOR2')]];'El % Comision Corredor EXCEDE Los Limites: Min.'~VAR('RCOMCOR1')~' Max.'~VAR('RCOMCOR2');NO
EsHabil(FECHAPAGO,'ARG');'La Fecha de Vencimiento para Entregar NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'VTOEINH'
EsHabil(FECHAVTO ,'ARG');'La Fecha de Vencimiento para Recibir NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'VTORINH'

SI O [VCB1=1 O VACIO(CORREDOR) O [TCCOMCOR1<=TIPOCAMBIO2*(1+VAR('RPRECIO')/100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-VAR('RPRECIO')/100)]];'Cambio COMISION CORREDOR Fuera de Rango Nivel 1: ['~FSTR(TIPOCAMBIO2*(1-VAR('RPRECIO') /100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+VAR('RPRECIO')/100),1,7)~']';SI;SI;FSYS;'RANGOPREC1'
VACIO(CORREDOR) O [TCCOMCOR1<=TIPOCAMBIO2*(1+VAR('RPRECIO')/100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-VAR('RPRECIO')/100)];'Cambio COMISION CORREDOR FUERA DE RANGO: '~FSTR(TIPOCAMBIO2*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOPRECIO'
SI O [VCB1=1 O VACIO(CORREDOR) O [TCCOMCOR1<=TIPOCAMBIO2*(1+VAR('RPRECIO2')/100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-VAR('RPRECIO2')/100)]];'Cambio COMISION CORREDOR Fuera de Rango Nivel 2: ['~FSTR(TIPOCAMBIO2*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+VAR('RPRECIO2')/100),1,7)~']';SI;SI;FSYS;'RANGOPREC2'
VACIO(CORREDOR) O [TCCOMCOR1<=TIPOCAMBIO2*(1+VAR('RPRECIO2')/100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-VAR('RPRECIO2')/100)];'Cambio COMISION CORREDOR Fuera de Rango: '~FSTR(TIPOCAMBIO2*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+VAR('RPRECIO2')/100),1,7);SI;SI;FSYS;'RANGOPRECIO2'
SI O [VCB1=0 O VACIO(CORREDOR) O [TCCOMCOR1<=TIPOCAMBIO2*(1+VAR('RPRECIO3')/100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-VAR('RPRECIO3')/100)]];'Cambio COMISION CORREDOR Fuera de Rango Nivel 3: ['~FSTR(TIPOCAMBIO2*(1-VAR('RPRECIO3')/100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+VAR('RPRECIO3')/100),1,7)~']';SI;SI;FSYS;'RANGOPREC3'

NOT EQSTR (VEHICULO1,CLIENTE1);'El Cliente y el Vehiculo deben ser distintos';NO
ESTERMINAL(VEHICULO1,VEHICULO);'El Vehiculo debe ser Terminal';NO
ESTERMINAL(CLIENTE1,CLIENTE);'El Cliente debe ser Terminal';NO
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
VACIO(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR)) O  VERIFICAPERFIL(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR),'TO'~TIPOOP);'Operador no habilitado para ingresar Operaciones del Tipo '~TIPOOP;NO

[NOT NOVACIO(CLIENTE1)] o [FechaPago>FechaVto] o ExisteLimite('SETTLEMENT',Cliente1,VTXT6); 'Settlement no asignado';SI;SI;FSYS;'SETTLENOAS'
[NOT NOVACIO(CLIENTE1)] o [FechaPago>FechaVto] o Not ExisteLimite('SETTLEMENT',Cliente1,VTXT6) o VtoLimite('SETTLEMENT',Cliente1,VTXT6) >= FechaOp; 'Settlement vencido el '~FECHA(VtoLimite('SETTLEMENT',Cliente1,VTXT6));SI;SI;FSYS;'SETTLEVENC'
[NOT NOVACIO(CLIENTE1)] o [FechaPago>FechaVto] o Not LimCancelado('SETTLEMENT',Cliente1,VTXT6) ; 'Settlement cancelado';SI;SI;FSYS;'SETTLECANC'
[NOT NOVACIO(CLIENTE1)] o [FechaPago>FechaVto] o LimAsignado(Cliente1,'SETTLEMENT',VTXT6) >= VCAN6;'Settlement excedido '~PYC(VCAN6-LimAsignado(Cliente1,'SETTLEMENT',VTXT6),1,0)~'.-';SI;SI;FSYS;'SETTLEEXCE'

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

SQL
