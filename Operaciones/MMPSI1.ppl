CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp2        : 'Fecha Conc.'                ;1;1;;VERIFICAACCESO('OPFVALOR');;FECHAOP2<=FECHAOP y FECHAOP2>=OPREF.FECHAOP2;'Fecha incorrecta';NO;FSYS;
FechaOp         : 'Fecha_Origen'               ;2;1;;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1) y FECHAOP>=OPREF.FECHAOP;'Fecha de Origen Incorrecta';RB11 = 0;FSYS;
RB10            : 'Precancelable|Si|No'        ;;;;NO;NO;RB10>=0;'Precancelable Si/No';NO;1;OPREF.RB10
@VEHITO
OperacionRef    : 'Op_Referencia'              ;3;2;;NOT EV;;NOVACIO(OPERACIONREF);'Indique el Codigo del Prestamo Sindicado Principal';NO; 
Cliente3        : 'Ent_Arranger'               ;4;1;;NO;;NOVACIO(CLIENTE3); 'La Entidad Contratante es Invalida';NO;;OPREF.CLIENTE1
Cliente2        : 'Ent_Agente  '               ;;;;NO;;NOVACIO(CLIENTE2);'La Entidad Agente es Invalida';NO;;OPREF.CLIENTE2
Especie         : 'Especie'                    ;;;;NO;;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'Debe Ingresar una Moneda';NO;;OPREF.ESPECIE;;;;;;"Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA')) ~")and Status = 'HAB' ";;;;
Cliente1        : 'Ent_Participante'           ;4;2;;NOT EV;;NOVACIO(CLIENTE2);'La Entidad Participante es Invalida';NO;;
Plazo           : 'Plazo '                     ;5;2;;NO;;PLAZO>0;'PLAZO INVALIDO';NO;0;OPREF.PLAZO
FechaVto        : 'Fecha_Vto'                  ;6;2;;NO;;;;  ;               ;OPREF.FECHAVTO
FechaPrecan     : 'Fecha_Sett'                 ;7;2;;NO;;;;  ;               ;OPREF.FECHAPRECAN

Spread          :                              ;8;2;;NO;NOT EQSTR(TIPOTASA,'FIJA');SPREAD>=0;'El SPREAD Debe SER POSITIVO';NO;0;OPREF.SPREAD
VCAN2           : 'VN_Disponible'              ;;;;NO;;EV O [NOT EV Y VCAN2>0];'La Operacion '~OPERACIONREF~' Fue Completamente Asignada';NO;;OPREF.TOTALNETOCLI3;;;;;'###,###,###,###,###.##'

TipoTasa        : 'Tipo_Tasa'                  ;7;1;;NO;;NOVACIO(TIPOTASA);'El Tipo de Tasa ES INVALIDO';NO;'FIJA';OPREF.TIPOTASA
Precio1         : 'Tasa (%)'                   ;;;;NO;;PRECIO1>0;'La Tasa Debe ser positiva';NO;;OPREF.PRECIO1
RB8             : 'Day Count|ActAct|Act365F|Act360|360360|30E360'           ;;;;NO;;RB8>=0;'Unidad de Tiempo Tasa Interes INVALIDA';NO;;OPREF.RB8

TotalBrutoCli2  : 'VNO'                        ;10;1;;NOT EV Y TOTALBRUTOCLI2=CANTIDAD;;TOTALBRUTOCLI2>0 Y [[EQSTR(ABM,'A') Y TOTALBRUTOCLI2<=VCAN2] O [NOT EQSTR(ABM,'A') Y TOTALBRUTOCLI2<=(VCAN2+VCAN1)]];'EL VNO DEBE SER MENOR O IGUAL AL VALOR NOMINAL DISPONIBLE';NO;;IF(EQSTR(ABM,'A'),IF(MODI,OPREF.CANTIDAD,VCAN2),OPREF.CANTIDAD);;;;;'###,###,###,###,###.##'
FechaPago       : 'Fecha VNO'                  ;;;;NO;NO;ESHABIL(FECHAPAGO,TABLAFERIADOS1) Y FECHAPAGO<=FECHAVTO2;'La Fecha de V.N.O Entidad Participante ES INVALIDA';NO;;IF(EQSTR(ABM,'A'),IF(MODI,FECHAPAGO,FECHAOP),FECHAPAGO)

Cantidad        : 'VNA'                        ;10;2;;NO;;;;;;IF(EQSTR(ABM,'A') O VCAN1=VCAN3,TOTALBRUTOCLI2,CANTIDAD);;;;;'###,###,###,###,###.##'
FechaVto2       : 'Fecha VNA'                  ;;;;NO;;[ESHABIL(FECHAVTO2,TABLAFERIADOS1) Y FECHAVTO2<=FECHAVTO Y FECHAVTO2>=FECHAPAGO];'La Fecha de V.N.A Entidad Participante ES INVALIDA';NO;;IF(EQSTR(ABM,'A'),IF(MODI,FECHAVTO2,FECHAPAGO),FECHAVTO2)

TotalIntereses  : 'Interes'                    ;13;1;;EV;;NOT EV o [TotalIntereses <= ROUND(VCAN7*(1+Var('PORVAR')/100),2) y TotalIntereses >= ROUND(VCAN7*(1-Var('PORVAR')/100),2)];'Inter¦s Fuera de Rango: '~FSTR(ROUND(VCAN7*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN7*(1+Var('PORVAR')/100),2),0,2);NO;;CANTIDAD*((PRECIO1+SPREAD)/100)*FACTORDIAS(FECHAOP,FECHAVTO,RB8+1);;;;;'###,###,###,###,###.##'
TotalNetoCli2   : 'Interes Total'              ;;;;NO;;;;;;TOTALINTERESES+TOTALAUX3+IMPORTEIMP;;;;;'###,###,###,###,###.##'

Precio4         : 'Tasa Total Neta'            ;;;;NO;PRECIO4>0;;;;;;;;;;'###,###,###,###,###.##'
TablaFeriados1  : 'Feriados'                   ;;;;;;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;IF(NOVACIO(OPERACIONREF),OPREF.TABLAFERIADOS1,BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE)))
NrOperacion3    : 'Op.Original'                ;;;;NO;NOVACIO(NROPERACION3);;;;;
TotalBrutoCli1  : 'Monto'                      ;13;2;;NO;;;;;;CANTIDAD+TOTALINTERESES;;;;;'###,###,###,###,###.##'
TotalNetoCli1   : 'Monto Total'                ;;;;NO;;;;;;CANTIDAD+TOTALNETOCLI2;;;;;'###,###,###,###,###.##'

Observac2       : 'Operador EAr'               ;;;;NO;;;;;;OPREF.OBSERVAC2;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
Operador        :                              ;;;;;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
CB10            : 'Pmo.|Local|Extranjero'      ;16;3;;NO;NO;;;;;IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),0,1)
TotalAux1       : 'Tasa WH'                    ;1;1;2;CB10=1;CB10=1;CB10=0 O Incluido(Fstr(TotalAux1,2,4),VAR('TASAWH'));'El Valor de TASA WH es Erroneo: '~VAR('TASAWH')~' ...';NO;;;;;;;'###,###.######'
TotalAux2       : 'Tasa_Int_WH'                ;;1;2;;CB10=1;;;;;IF(CB10=1,IF(MODI,TOTALAUX2,PRECIO1+SPREAD),0);;;;;'###,###.######'
TotalAux3       : 'Importe WH'                 ;;1;2;EV;CB10=1;NOT EV o [TotalAux3 <= ROUND(VCAN9*(1+Var('PORVAR')/100),2) y TotalAux3>= ROUND(VCAN9*(1-Var('PORVAR')/100),2)];'Importe WHT Fuera de Rango: '~FSTR(ROUND(VCAN9*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN9*(1+Var('PORVAR')/100),2),0,2);NO;;((CANTIDAD*(TOTALAUX2/100))*FACTORDIAS(FECHAOP,FECHAVTO,RB8+1))*(TOTALAUX1/100);;;;;'###,###,###,###,###.##'
VCAN1           : 'VNAAnt'                     ;;2;2;NO;NO;;;;;BuscarCampo('OPERACIONES','Cantidad','NrOperacion',NrOperacion)
VCAN3           : 'VNOAnt'                     ;;2;2;NO;NO;;;;;BuscarCampo('OPERACIONES','TotalBrutoCli2','NrOperacion',NrOperacion)

ImpGastos2      : 'Tasa_IVA'                   ;1;2;2;;;;;;;;;;;;'###,###.######'
TotalAux4       : 'Tasa_Int_IVA'               ;;;2;;;;;;;IF(MODI,TOTALAUX2,PRECIO1+SPREAD);;;;;'###,###.#####'
TotalIVA        : 'Importe_Iva'                ;;;2;EV;;NOT EV o [TOTALIVA<= ROUND(VCAN8*(1+Var('PORVAR')/100),2) y TOTALIVA >= ROUND(VCAN8*(1-Var('PORVAR')/100),2)];'Importe IVA Fuera de Rango: '~FSTR(ROUND(VCAN8*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN8*(1+Var('PORVAR')/100),2),0,2);NO;;((CANTIDAD*(TOTALAUX4/100))*FACTORDIAS(FECHAOP,FECHAVTO,RB8+1))*(IMPGASTOS2/100);;;;;'###,###,###,###,###.##'

TasaImp1        : '% Imp.Interes'              ;;;2;;CB10=0;CB10<>0 o [Incluido(Fstr(TASAIMP1,2,4),VAR('TASAINT'))];'El Valor de TASA Impuesto  INTERES es Erroneo: '~VAR('TASAINT')~' ...';NO;IF(CB10=0,VAR('DEFAINT'),0);IF(CB10=0,TASAIMP1,0) ;;;;;'###,###.######'
ImporteImp      : 'Importe Interes'            ;;;2;EV;CB10=0;NOT EV o [IMPORTEIMP<= ROUND(VCAN4*(1+Var('PORVAR')/100),2) y IMPORTEIMP>= ROUND(VCAN4*(1-Var('PORVAR')/100),2)];'Importe Impuesto Interes Fuera de Rango: '~FSTR(ROUND(VCAN4*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN4*(1+Var('PORVAR')/100),2),0,2);NO;;TOTALINTERESES*(TASAIMP1/100);;;;;'###,###,###,###,###.##'

VCAN10          : 'ComEF'                      ;;2;2;NO;NO;;;;;IF(NOVACIO(OPERACIONREF),QUERY(" Select Tasa1 from "~DBO~".COMISIONES2 where NrOperacion='"~OPERACIONREF~"' AND Tipo='5'"),SUM(COM2L,2,1,5));;;;;'###.########'
VPRE1           : 'UTEF'                       ;;2;2;NO;NO;;;;;IF(EQSTR(IF(NOVACIO(OPERACIONREF),QUERY("Select RB2 from "~DBO~".COMISIONES2 where NrOperacion='"~OPERACIONREF~"' "),Fstr(SUM(COM2L,12,1,5),1,0)),'0'),36000,36500)
RB3             : 'MOF'                        ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa         : 'Modificado'                 ;10;3;;NO;NO;;;;0
VPRE5           : 'Cot.ESP/USD'                ;10;3;;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
Cotizacion1     : 'TC_Concert.'                ;10;1;2;;Not Eqstr(ESPECIE,VAR('MONEEXTR'));Eqstr(ESPECIE,VAR('MONEEXTR')) O [COTIZACION1<=VPRE9*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE9*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertaci#n Fuera de Rango: '~FSTR(VPRE9*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE9*(1+VAR('RPRECIO2')/100),1,7);NO;;IF(Eqstr(ESPECIE,VAR('MONEEXTR')),1)
Cotizacion2     : 'TC_Vencim.'                 ;;;;COTIZACION2<>0;COTIZACION2<>0;;;;
VPRE9           : 'Cot.TC/USD'                 ;10;2; ;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(ESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)

VTXT1           : 'Participo?'                 ;9;2;;NO;NO;;;;;QUERY("Select NrOperacion from "~DBO~".OPERACIONES where OperacionRef='"~OPERACIONREF~"'  and Cliente1='"~CLIENTE1~"' and TipoOp='"~TIPOOP~"' and NrOperacion<>'"~NROPERACION~"' ")

VCAN7           : 'INTERES MOD'                ;18;1;2;NO;NO;;;;; CANTIDAD*((PRECIO1+SPREAD)/100)*FACTORDIAS(FECHAOP,FECHAVTO,RB8+1)
VCAN8           : 'IVA MOD'                    ;18;1;2;NO;NO;;;;; ((CANTIDAD*(TOTALAUX4/100))*FACTORDIAS(FECHAOP,FECHAVTO,RB8+1))*(IMPGASTOS2/100)
VCAN9           : 'WHT MOD'                    ;18;1;2;NO;NO;;;;; ((CANTIDAD*(TOTALAUX2/100))*FACTORDIAS(FECHAOP,FECHAVTO,RB8+1))*(TOTALAUX1/100)
IntDevengados2  : 'TC_IVA'                     ;11;3;1;NO;NO;;;;-1;
VCAN4           : 'Impuesto INTERES'           ;18;1;2;NO;NO;;;;; TOTALINTERESES*(TASAIMP1/100)

RB11            : 'Ajuste|NO|SI'               ;8;1;2;;NO;;;;0;
ValorRB1        : 'Tasa|Real|Estimada'         ;9;1;2;;;VALORRB1 = 0;'La Tasa es Estimada';SI;0;

Precio5         : 'Precio5'                    ;1;1;1;NO;NO;
ContraEspecie5  : 'ContraEspecie5'             ;1;1;1;NO;NO;
ContraEspecie6  : 'ContraEspecie6'             ;1;1;1;NO;NO;
Precio6         : 'Precio6'                    ;1;1;1;NO;NO;

VTXT18          : 'Book Def'    ; 1;2;2;NO;NO;;;;;BuscarCampo('VEHICULOS','Alias5','Codigo',VEHICULO1)
VTXT19          : 'Codigo Book' ; 2;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Codigo','Codigo',VTXT18)
VTXT20          : 'Vehic.Book'  ; 3;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Vehiculo','Codigo',VTXT19)
VFEC1           : 'F.Vto DEV 30360'            ;5;2;2;NO;NO;;;;IF(PLAZO < 30 O Dia(FECHAOP) > DiasM(1,FECHAVTO),FECHAVTO,Fecha(Fstr(Dia(FECHAOP),0,0)~'/'~Fstr(Mes(FECHAVTO),0,0)~'/'~Fstr(Anio(FECHAVTO),0,0)));IF(PLAZO < 30 O Dia(FECHAOP) > DiasM(1,FECHAVTO),FECHAVTO,Fecha(Fstr(Dia(FECHAOP),0,0)~'/'~Fstr(Mes(FECHAVTO),0,0)~'/'~Fstr(Anio(FECHAVTO),0,0)));;;;
ContraEspecie   : 'ContraEspecie';;;2;NO;NO;
PrecioEj        : 'PrecioEj'      ;;;2;NO;NO;
TotalComisiones : 'Comsiones'     ;;;2;NO;NO;

@CUENTAS
@CTAMONLOC
@INDICEFRN
***---@COMIOP

CONDICIONES
SI Y [PRECIO4<=VAR('RTTN2') Y PRECIO4>=VAR('RTTN1')];'Tasa Total Neta Fuera de Rango:'~VAR('RTTN1')~" Y "~VAR('RTTN2');SI
DESCIENDEDECLIENTE(CLIENTE1,'BANCOS');'Entidad Participante debe ser Banco Local o Extranjero';NO
PRECIO1<=VAR('RTASA2') Y PRECIO1>=VAR('RTASA1');'Tasa Fuera de Rango:'~VAR('RTASA1')~" Y "~VAR('RTASA2');SI;SI;FSYS;'RTASA'
ESHABIL(FECHAOP,'ARG');'La Fecha de Origen no es Dia Habil en Argentina';SI;SI;FSYS;'ORIGINH'
ESHABIL(FECHAVTO2,'ARG');'La Fecha de Vencimiento NO ES DIA HABIL en Argentina';SI;SI;FSYS;'VTOINH'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'La Entidad Contratante esta Deshabilitada';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'La Entidad Contratante esta Observada';SI;SI;FSYS;'CLIOBS'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE2));'La Entidad Negociadora esta deshabilitada';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE2));'La Entidad Negociadora esta Observada';SI;SI;FSYS;'CLIOBS'
EQSTR('MMPSC',BuscarCampo('Operaciones','TipoOp','NrOperacion',OPERACIONREF));'La Operacion de Referencia es INVALIDA';NO
EQSTR(TIPOTASA,'FIJA') O [SPREAD>=VAR('RSPREAD1') Y SPREAD<=VAR('RSPREAD2')];'El Spread esta Fuera de Rango '~VAR('RSPREAD1')~' '~VAR('RSPREAD2');NO
VACIO(VTXT1);'La Entidad '~CLIENTE1~' Es Participante en la Operaci¦n '~VTXT1~' !!!';NO
FECHAOP2=Fsys;'La Fecha de Concertaci¦n no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
[Incluido(Fstr(ImpGastos2,2,2),VAR('IVA'))];'El Valor de TASA IVA es Erroneo: '~VAR('IVA');NO

@CONDIOP

SI O Incluido(Especie,'ARP|USD') o NoVacio(VTXT18);'El Vehiculo no tiene Book Default para Monedas';NO
SI O Incluido(Especie,'ARP|USD') o NoVacio(VTXT19);'El Book default '~VTXT18~' no es valido';NO
SI O Incluido(Especie,'ARP|USD') o EqStr(VTXT20,Vehiculo1);'El Book default '~VTXT18~' corresponde a otro vehiculo';NO

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

REFERENCIA
'TotalBrutoCli2='~FStr(OPREF.TotalBrutoCli2+Cantidad,0,2);NOT EV
'TotalNetoCli3='~FStr(OPREF.TotalNetoCli3-Cantidad,0,2);NOT EV

SQL
"UPDATE "~DBO~".COMISIONES2 Set Fecha1='"~IdxDate(FECHAOP)~"' Where NrOperacion='"~OPERACIONREF~"' and Tipo='0' and Fecha1 Is Null ";EqStr(ABM,'A') y QUERY("SELECT COUNT(*) FROM "~DBO~".COMISIONES2 WHERE NrOperacion='"~OPERACIONREF~"' and Tipo='0' ")>0 Y OPREF.TOTALAUX3=0;

POSTEDICION
NOVACIO(OPERACIONREF) y EQSTR(ABM,'A');'INSCOM';NrOperacion1=OPERACIONREF;NrOperacion2=NROPERACION;String=" Tipo  IN ('5','3')"
@POSTEMM


MOVIMIENTOS
FechaPrecan   ;Cliente1;If(IntDevengados2<0,Especie,VAR('MONELOCA'))      ;;;;;Vehiculo1;1;TotalIVA *If(IntDevengados2<0,1,IntDevengados2)  ;;'IVA';SI; Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;TotalIVA<>0;;Cuenta3;;4;
FechaPrecan   ;Cliente1;If(IntDevengados2<0,Especie,VAR('MONELOCA'))      ;;;;;Vehiculo1;1;TotalAux3*If(IntDevengados2<0,1,IntDevengados2)  ;;'WH';SI; Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;TotalAux3<>0;;Cuenta3;;7000;
FechaPrecan   ;Cliente1;If(IntDevengados2<0,Especie,VAR('MONELOCA'))      ;;;;;Vehiculo1;1; ImporteImp*If(IntDevengados2<0,1,IntDevengados2);;'Impto.Int';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;ImporteImp<>0  ;;Cuenta3;;6;

DEVENGADOS
FechaOp+1;FechaVto;RB8<>4;SI;NO;'ARG';SI;SI;'INTLEN';-TotalIntereses;140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;;Especie;;;;;;;;
FechaOp+1;FechaVto;RB8<>4;SI;NO;'ARG';SI;SI;'INTWHT';-TotalAux3     ;140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;;Especie;;;;;;;;
FechaOp+1;IF(Dia(FECHAOP) = 31 Y PLAZO = 30,VFEC1+1,VFEC1);RB8=4;SI;NO;'ARG';SI;SI;'INTLEN';-TotalIntereses;140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;;Especie;;;;;;;;SI
FechaOp+1;IF(Dia(FECHAOP) = 31 Y PLAZO = 30,VFEC1+1,VFEC1);RB8=4;SI;NO;'ARG';SI;SI;'INTWHT';-TotalAux3     ;140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;;Especie;;;;;;;;SI

@INSTOPE
@INST19MM
@INST19BITS