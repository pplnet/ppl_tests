FechaVto ;Cliente1;Especie;;;;;Vehiculo1;1;-Cantidad;;'Compra de Moneda '~ESPECIE;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;PaseCB=0 y Arbitraje=0 y CB9=0;;Cuenta1;;1;;;;;;;;;;;;;;600
FechaPago;Cliente1;ContraEspecie;;;;;Vehiculo1;1;TotalBrutoCli1;;'Compra de Moneda Imp.Liq '~CONTRAESPECIE;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;PaseCB=0 y Arbitraje=0 y CB9=0;;Cuenta2;;2;
FechaPago;Cliente1;ContraEspecie;;;;;Vehiculo1;1;   PeriodoInts;;'Imp.DB/CR';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;PeriodoInts<>0;;Cuenta1;;5;
FechaPago;Cliente1;ContraEspecie;;;;;Vehiculo1;1;  -Precio3;;'Resultado NDF';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;PaseCB=0 y Arbitraje=0 y CB9=1 y CB8=1;;Cuenta2;;10;


LIMITES
FechaOp;Cliente1;'CONTRACT';'USD';; TotalBrutoCli1*VPRE6;TipoOp~' '~Especie;Arbitraje=0 y PaseCB=0 y EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',Cliente1),'NOC') ;Vehiculo1
Habiles(FechaVto,1,TablaFeriados1) ;Cliente1;'CONTRACT';'USD';;-TotalBrutoCli1*VPRE6;TipoOp~' '~Especie;RB15=1 Y Arbitraje=0 y PaseCB=0 y EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',Cliente1),'NOC') y FechaVto>=FechaPago y Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));Vehiculo1
Habiles(FechaPago,1,TablaFeriados1);Cliente1;'CONTRACT';'USD';;-TotalBrutoCli1*VPRE6;TipoOp~' '~Especie;RB15=1 Y Arbitraje=0 y PaseCB=0 y EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',Cliente1),'NOC') y FechaVto<FechaPago y Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));Vehiculo1
Habiles(FechaVto,1,TablaFeriados1) ;Cliente1;'CONTRACT';'USD';;-TotalBrutoCli1*VPRE6;TipoOp~' '~Especie;RB15=1 Y Arbitraje=0 y PaseCB=0 y EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',Cliente1),'NOC') y FechaVto>=FechaPago y Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2')) y Not EqStr(BuscarCampo('CLIENTES','Alias10','Codigo',CLIENTE1),'LIMITELIQ');Vehiculo1
Habiles(FechaPago,1,TablaFeriados1);Cliente1;'CONTRACT';'USD';;-TotalBrutoCli1*VPRE6;TipoOp~' '~Especie;RB15=1 Y Arbitraje=0 y PaseCB=0 y EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',Cliente1),'NOC') y FechaVto<FechaPago y Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2')) y Not EqStr(BuscarCampo('CLIENTES','Alias10','Codigo',CLIENTE1),'LIMITELIQ');Vehiculo1


POSICION
FechaOp ;Vehiculo1;Especie;;FechaVto;;Vehiculo1;;;;;41; Cantidad;Precio1;;;;;'FX';CB9=0;
