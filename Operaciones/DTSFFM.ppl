CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp        : 'Fecha Conc.'                ;1;1;;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1);'FECHA CONCERTACION NO HABIL EN TABLA SELECCIONADA';RB11 = 0;FSYS;
@VEHITO
Operador       :                              ;2;1;;NO;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
Cliente1       : 'ContraParte'                ;3;1;;NOT EV;;NOVACIO(CLIENTE1);'EL CLIENTE NO ES VALIDO';NO;;;;;;;;"Status = 'HAB'";;;;
Observac2      : 'Op.Contraparte'             ;3;2;;;;NOVACIO(OBSERVAC2);'EL OPERADOR CONTRAPARTE NO ES VALIDO';SI;;;
TablaFeriados1 : 'Feriados'                   ;5;1;;;;NOVACIO(TABLAFERIADOS1);'SE DEBE INDICAR FERIADOS A UTILIZAR';NO;;BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE)) 
CB9            : 'Mark_To_Mkt'                ;;;;NO;NO;;;;0;
Cuotas1        : 'Cant_Sett'                  ;6;2;;;;CUOTAS1>1;'La Cantidad de Settlements debe ser Superior a 1';NO;
Especie        : 'V Moneda'                   ;1;1;2;NOT EV;;NOVACIO(ESPECIE) Y [DESCIENDEDEESPECIE(ESPECIE,'MONEDA') Y ESTERMINAL(ESPECIE,ESPECIE)];'DEBE INGRESAR UNA MONEDA DE VEHICULO VALIDA';NO;'USD';;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";;;;
RB8            : 'V Day Count|Act Act|Act 365 F|Act 360|360 360|30E 360' ;3;;2;;;;;;0;
RB5            : 'C Day Count|Act Act|Act 365 F|Act 360|360 360|30E 360' ;4;1;2;;;;;;0;
TotalAux3      : 'V Notional'                 ;6;;2;;;TOTALAUX3>=0;'Debe Ingresar el Vehiculo Initial Exchange';NO;0;IF(COTIZACION1=0 O COTIZACION1=TOTALAUX3 O TOTALBRUTOCLI2=0,TOTALAUX3,IF(EqStr(Modo(ESPECIE,CONTRAESPECIE),'DIR'),TOTALBRUTOCLI2/COTIZACION1,TOTALBRUTOCLI2*COTIZACION1))
FechaEx1       : 'Notional_Date'              ;;;2;TOTALAUX3>0;TOTALAUX3>0;[TOTALAUX3=0 ] O ESHABIL(FECHAEX1,TABLAFERIADOS1);'FECHA INITIAL EXCHANGE NO HABIL EN TABLA SELECCIONADA';RB11 = 0;;IF(TOTALAUX3>0 Y NOT EQSTR(CONTRAESPECIE,ESPECIE),FECHAEX1,0)
ContraEspecie  : 'C Moneda'                   ;1;2;2;NOT EV;;NOVACIO(CONTRAESPECIE) Y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') Y ESTERMINAL(CONTRAESPECIE,ESPECIE);'DEBE INGRESAR UNA MONEDA CONTRAPARTE VALIDA';NO;'USD';;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";;;;;;
TotalBrutoCli2 : 'C Notional'                 ;6;2;2;;;TOTALBRUTOCLI2>=0;'Contraparte Initial Exchange Invalido';NO;0;IF(COTIZACION1=0 O COTIZACION1=TOTALAUX3 O TOTALBRUTOCLI2<>0,TOTALBRUTOCLI2,IF(EqStr(Modo(ESPECIE,CONTRAESPECIE),'DIR'),TOTALAUX3*COTIZACION1,TOTALAUX3/COTIZACION1))
PlazoRenovPredeter : 'Cot.Contable'           ;7;2;2;NO Y [NOT EQSTR (COTIZAEN(ESPECIE),CONTRAESPECIE)];NO Y [NOT EQSTR(COTIZAEN(ESPECIE),CONTRAESPECIE)];SI O [EQSTR(COTIZAEN(ESPECIE),CONTRAESPECIE) o PLAZORENOVPREDETER > 0];'REQUIERE COTIZACION CONTABLE';NO;;IF(MODI, PLAZORENOVPREDETER, IF(Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE),  IF(Eqstr(CotizaEn(ESPECIE), VAR('MONELOCA') ), 1 , COTIZACIONBNA(CONTRAESPECIE,FECHAOP,1,NO,NO) )   ))

VPRE1          : 'Cot.ESP/CONTRAESP'          ;;;2;NO;NO;;;;;IF(EqStr(Modo(ESPECIE,CONTRAESPECIE),'DIR'),TOTALBRUTOCLI2/TOTALAUX3,TOTALAUX3/TOTALBRUTOCLI2)
Cotizacion1    : 'Tipo Cambio'                ;;;2;Not Eqstr(ESPECIE,CONTRAESPECIE);Not Eqstr(ESPECIE,CONTRAESPECIE);Eqstr(ESPECIE,CONTRAESPECIE) o [COTIZACION1<=VPRE1*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE1*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE1*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE1*(1+VAR('RPRECIO2')/100),1,7);NO;;IF(Eqstr(ESPECIE,CONTRAESPECIE),1,VPRE1)

RB11           : 'Ajuste|NO|SI'               ;10;1;2;;NO;;;;0;

Impresa        : 'Modificado'                 ;10;3;;NO;NO;;;;0
RB3            : 'MOF'                        ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)

VPRE5          : 'Cot.ESP/USD'                ;10;3;;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
VPRE6          : 'Cot.CONTESP/USD'            ;10;3;;NO;NO;;;;;COTIZACIONC(CONTRAESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
VCAN12         : 'Cotizacion de Mercado'      ;18;2;2;No;No;;;;;COTIZACIONC(COTIZAEN(ESPECIE),,,,FECHAOP,1,SI,CONTRAESPECIE))
PrecioMer      : 'Monto USD WF'               ;1;2;2;NO;NO;;;;CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'));CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))

Cantidad       : ''                           ;;;;NO;NO;;;;
RB10           : ''                           ;;;;NO;NO;;;;
MB3            : 'Tipo|Pasiva|Activo'         ;15;1;1;NO;NO;;;;0;

@CUENTAS
@RANGOTASA

@DTREFER


LISTA:SI;IF(ESINICIO,100,CUOTAS1);
 Fecha1    : 'V_Inicio Per'   ;;;EsHabil(CUOTASL.FECHA1[Fila], TABLAFERIADOS1);'La Fecha Inicio del Vehiculo en la Cuota '~Fstr(Fila, 0, 0)~' NO ES HABIL';IF(Fila=1,FECHAOP,CUOTASL.FECHA2[Fila-1]);IF(Fila=1,CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila-1]);90;;Fecha;;;;;;;;RB11 = 0
 Plazo1    : 'V_Plazo'        ;;;CUOTASL.PLAZO1[Fila]>0;'El PLAZO DEBE SER POSITIVO';;;60;;Numero;'####'
 Fecha2    : 'V_Fin Per'      ;NO;;[[Fila=1 Y CUOTASL.FECHA2[Fila]>FECHAOP] O [Fila>1]] Y CUOTASL.FECHA2[Fila]>=CUOTASL.FECHA1[Fila] Y [EsHabil(CUOTASL.FECHA2[Fila], TABLAFERIADOS1)];IF(Not EsHabil(CUOTASL.FECHA2[Fila], TABLAFERIADOS1), 'La Fecha Fin Periodo del Vehiculo en la Cuota '~Fstr(Fila, 0, 0)~' NO ES HABIL', 'FECHA FIN PERIODO V DEBE SER MAYOR QUE FECHA CONC. V');;CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila];90;;Fecha;;;;;;;;RB11 = 0

 Cantidad6 : 'V_Imp_Amor'     ;NOT EV;;CUOTASL.CANTIDAD6[Fila]>=0;'El Importe Amortizacion del Vehiculo debe SER POSITIVO';IF(Fila=CUOTAS1,TOTALAUX3,0)-TOTALBRUTOCLI2+TOTALBRUTOCLI2-TOTALAUX3+TOTALAUX3-COTIZACION1+COTIZACION1;IF(Fila=CUOTAS1,TOTALAUX3,0)-TOTALBRUTOCLI2+TOTALBRUTOCLI2-TOTALAUX3+TOTALAUX3-COTIZACION1+COTIZACION1;200;;Numero;'###,###,###,###.##';NO;NO;'5'
 Cantidad1 : 'V_Notional'     ;NOT EV;;CUOTASL.CANTIDAD1[Fila]>=0;'Notional Ammount del Vehiculo Incorrecto';IF(Fila=1,TOTALAUX3,CUOTASL.CANTIDAD1[Fila-1]-CUOTASL.CANTIDAD6[Fila-1])-TOTALBRUTOCLI2+TOTALBRUTOCLI2-TOTALAUX3+TOTALAUX3-COTIZACION1+COTIZACION1;IF(Fila=1,TOTALAUX3,CUOTASL.CANTIDAD1[Fila-1]-CUOTASL.CANTIDAD6[Fila-1])-TOTALBRUTOCLI2+TOTALBRUTOCLI2-TOTALAUX3+TOTALAUX3-COTIZACION1+COTIZACION1;200;;Numero;'###,###,###,###,###.##';NO;NO;'4'
 Precio1   : 'V_Tasa'         ;;;CUOTASL.PRECIO1[Fila]>=VAR('RTASA1') Y CUOTASL.PRECIO1[Fila]<=VAR('RTASA2');'La Tasa del Vehiculo ESTA FUERA DE RANGO: '~VAR('RTASA1')~' '~VAR('RTASA2');;;100;;Numero;'###,###.######';NO;NO;'7'
 Cantidad3 : 'V_Interes'      ;EV;;NOT EV o [[ROUND(CUOTASL.CANTIDAD3[Fila],2) <= ROUND((CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.CANTIDAD3[Fila],2) >= ROUND((CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100)),2)]];'Interes Vehiculo Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100),2),0,2);;((CUOTASL.CANTIDAD1[Fila]*CUOTASL.PRECIO1[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1);200;NO;Numero;'###,###,###,###,###.##';NO;NO;'6'
 Fecha3    : 'Settlement'     ;;;ESHABIL(CUOTASL.FECHA3[Fila],TABLAFERIADOS1);'Fecha Settlement Vehiculo no habil en la tabla seleccionada';CUOTASL.FECHA2[Fila];CUOTASL.FECHA2[Fila];90;NO;Fecha;;NO

 Fecha5    : 'C_Inicio Per'   ;;;EsHabil(CUOTASL.FECHA5[Fila], TABLAFERIADOS1);'La Fecha Inicio ContraParte en la Cuota '~Fstr(Fila, 0, 0)~' NO ES HABIL';IF(Fila=1,FECHAOP,CUOTASL.FECHA6[Fila-1]);IF(Fila=1,CUOTASL.FECHA5[Fila],CUOTASL.FECHA6[Fila-1]);90;;Fecha;;;;;;;;RB11 = 0
 Plazo2    : 'C_Plazo'        ;;;CUOTASL.PLAZO2[Fila]>=0;'El Plazo ContraParte debe ser Positivo ';IF(EQSTR(CAMPOMODIFICADO,'CUOTASL.PLAZO2['~Fstr(Fila,1,0)~']'),CUOTASL.PLAZO2[Fila],CUOTASL.PLAZO1[Fila]);;60;;Numero;'####';;;'11'
 Fecha6    : 'C_Fin Per'      ;NO;;CUOTASL.FECHA6[Fila]>=CUOTASL.FECHA5[Fila] Y EsHabil(CUOTASL.FECHA6[Fila], TABLAFERIADOS1);IF(Not EsHabil(CUOTASL.FECHA6[Fila], TABLAFERIADOS1), 'Fecha Fin ContraParte en Cuota '~Fstr(Fila, 0, 0)~' NO ES HABIL', 'FECHA FIN PERIODO C DEBE SER MAYOR QUE FECHA CONC. C');;CUOTASL.FECHA5[Fila]+CUOTASL.PLAZO2[Fila];90;;Fecha;;;;;;;;RB11 = 0
  
 Cantidad5 : 'C_Imp_Amor'     ;NOT EV;;CUOTASL.CANTIDAD5[Fila]>=0;'El Importe Amortizacion de la ContraParte debe SER POSITIVO';IF(Fila=CUOTAS1,TOTALBRUTOCLI2,0)-TOTALBRUTOCLI2+TOTALBRUTOCLI2-TOTALAUX3+TOTALAUX3-COTIZACION1+COTIZACION1;IF(Fila=CUOTAS1,TOTALBRUTOCLI2,0)-TOTALBRUTOCLI2+TOTALBRUTOCLI2-TOTALAUX3+TOTALAUX3-COTIZACION1+COTIZACION1;200;;Numero;'###,###,###,###.##';NO;NO;'13'
 Cantidad2 : 'C_Notional'     ;NOT EV;;CUOTASL.CANTIDAD2[Fila]>=0;'Notional Ammount de la ContraParte Incorrecto';IF(Fila=1,TOTALBRUTOCLI2,CUOTASL.CANTIDAD2[Fila-1]-CUOTASL.CANTIDAD5[Fila-1])-TOTALBRUTOCLI2+TOTALBRUTOCLI2-TOTALAUX3+TOTALAUX3-COTIZACION1+COTIZACION1;IF(Fila=1,TOTALBRUTOCLI2,CUOTASL.CANTIDAD2[Fila-1]-CUOTASL.CANTIDAD5[Fila-1])-TOTALBRUTOCLI2+TOTALBRUTOCLI2-TOTALAUX3+TOTALAUX3-COTIZACION1+COTIZACION1;200;;Numero;'###,###,###,###,###.##';NO;NO;'12'
 Precio2   : 'C_Tasa'         ;;;CUOTASL.PRECIO2[Fila]>=VAR('RTASA1') Y CUOTASL.PRECIO2[Fila]<=VAR('RTASA2');'La Tasa de la Contraparte ESTA FUERA DE RANGO: '~VAR('RTASA1')~' y '~VAR('RTASA2');;;100;;Numero;'###,###.######';NO;NO;'15'
 Cantidad4 : 'C_Interes'      ;EV;;NOT EV o [[ROUND(CUOTASL.CANTIDAD4[Fila],2) <= ROUND((CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.CANTIDAD4[Fila],2) >= ROUND((CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100)),2)]];'Interes Contraparte Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100),2),0,2);;((CUOTASL.CANTIDAD2[Fila]*CUOTASL.PRECIO2[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB5+1);200;NO;Numero;'###,###,###,###,###.##';NO;NO;'14'
 Fecha7    : 'Settlement'     ;;;ESHABIL(CUOTASL.FECHA7[Fila],TABLAFERIADOS1);'Fecha Settlement ContraParte no habil en tabla seleccionada';;IF(EQSTR(CAMPOMODIFICADO,'CUOTASL.FECHA7['~Fstr(Fila,1,0)~']'),CUOTASL.FECHA7[Fila],CUOTASL.FECHA6[Fila]);90;NO;Fecha;;NO

 *Total2    : 'Resultado'      ;NO;NO;;;IF(RB10=0,IF(EQSTR(ESPECIE,CONTRAESPECIE),CUOTASL.CANTIDAD3[Fila] - CUOTASL.CANTIDAD4[Fila],((CUOTASL.CANTIDAD3[Fila]*CUOTASL.PRECIO3[Fila]) - (CUOTASL.CANTIDAD4[Fila]*CUOTASL.PRECIO4[Fila]))),0);IF(RB10=0,IF(EQSTR(ESPECIE,CONTRAESPECIE),CUOTASL.CANTIDAD3[Fila] - CUOTASL.CANTIDAD4[Fila],((CUOTASL.CANTIDAD3[Fila]*CUOTASL.PRECIO3[Fila]) - (CUOTASL.CANTIDAD4[Fila]*CUOTASL.PRECIO4[Fila]))),0);200;;Numero;'###,###,###,###,###.##'
 Check1    : 'Ejercio?'       ;NO;NO;;;;IF(CUOTASL.CANTIDAD3[Fila]=0 O CUOTASL.CANTIDAD4[Fila]=0 ,0,1);50;NO;Check

 Precio5   : 'V MOD INT'      ;NO;NO;;;; ((CUOTASL.CANTIDAD1[Fila]*CUOTASL.PRECIO1[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1);200;;Numero;'###.######'
 Precio6   : 'C MOD INT'      ;NO;NO;;;; ((CUOTASL.CANTIDAD2[Fila]*CUOTASL.PRECIO2[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB5+1);200;;Numero;'###.######'
 Cantidad8 : 'Exposicion MM'  ;NO;NO;;;;;100;;Numero;'###,###,###,###.##'
 

CONDICIONES
Round(SUM(CUOTASL,4), 2) =TOTALAUX3;'El Imp. de Amortizacion del Vehiculo debe ser igual que el Initial Exchange Vehiculo ';NO
Round(SUM(CUOTASL,12), 2)=TOTALBRUTOCLI2;'El Imp. de Amortizacion de la ContraParte debe ser igual que el Initial Exchange Contraparte';NO
ESHABIL(FECHAOP,'ARG');'LA FECHA DE CONCERTACION NO ES DIA HABIL EN ARGENTINA';SI;SI;FSYS;'COINH'
[TOTALAUX3=0 O EQSTR(ESPECIE,CONTRAESPECIE)] O ESHABIL(FECHAEX1,'ARG');'LA FECHA DE INITIAL EXCHANGE NO ES DIA HABIL EN ARGENTINA';SI;SI;FSYS;'IEXINH'
NOT EQSTR(ESPECIE, CONTRAESPECIE);'LAS MONEDAS DEL SWAP FIJO FIJO DEBEN SER DIFERENTES';NO
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'El Cliente esta Observado';SI;SI;FSYS;'CLIOBS'
Vacio(Cliente1) o EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB');'El Cliente No esta Habilitado';NO
EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La Especie No esta Habilitada';NO
EqStr(BuscarCampo('Especies','Status','Codigo',ContraEspecie),'HAB');'La ContraEspecie No esta Habilitada';NO
NOT EQSTR (VEHICULO1,CLIENTE1);'El Cliente y el Vehiculo deben ser distintos';NO
ESTERMINAL(VEHICULO1,VEHICULO);'El Vehiculo debe ser Terminal';NO
ESTERMINAL(CLIENTE1,CLIENTE);'El Cliente debe ser Terminal';NO
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
VACIO(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR)) O  VERIFICAPERFIL(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR),'TO'~TIPOOP);'Operador no habilitado para ingresar Operaciones del Tipo '~TIPOOP;NO
SI O [Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE) O PLAZORENOVPREDETER<=VCAN12*(1+VAR('RPRECIO2')/100) Y PLAZORENOVPREDETER>=VCAN12*(1-VAR('RPRECIO2')/100)];'COTIZACION CONTABLE Fuera de Rango: '~FSTR(VCAN12*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO2')/100),1,7);NO
SI O [Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE) O PLAZORENOVPREDETER<=VCAN12*(1+VAR('RPRECIO') /100) Y PLAZORENOVPREDETER>=VCAN12*(1-VAR('RPRECIO') /100)];'COTIZACION CONTABLE FUERA DE RANGO: '~FSTR(VCAN12*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOCOTCON'


EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

MOVIMIENTOS
FechaEx1 ;Cliente1 ;Especie       ;;;;;Vehiculo1;1;-TotalAux3     ;;'Initial Exchange Vehiculo';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;1;
FechaEx1 ;Cliente1 ;ContraEspecie ;;;;;Vehiculo1;1; TotalBrutoCli2;;'Initial Exchange Contraparte';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta2;;2;

MOVCUOTAS
CuotasL.Fecha3[Fila];Cliente1 ;Especie       ;;Vehiculo1;1; CuotasL.Cantidad3[Fila];'Interest Payment Vehiculo'   ;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;Fila+5000;
CuotasL.Fecha7[Fila];Cliente1 ;ContraEspecie ;;Vehiculo1;1;-CuotasL.Cantidad4[Fila];'Interest Payment Contraparte';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta2;;Fila+6000;
CuotasL.Fecha3[Fila];Cliente1 ;Especie       ;;Vehiculo1;1; CuotasL.Cantidad6[Fila];'Final Exchange Vehiculo'     ;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;Fila+4000;
CuotasL.Fecha7[Fila];Cliente1 ;ContraEspecie ;;Vehiculo1;1;-CuotasL.Cantidad5[Fila];'Final Exchange Contraparte'  ;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta2;;Fila+2000;
*CuotasL.Fecha7[Fila];Cliente1 ;ContraEspecie ;;Vehiculo1;1;-CuotasL.Total2[Fila]   ;'Resultado por Modificacion '~TIPOOP;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;Eqstr(Especie,ContraEspecie) y CuotasL.Total2[Fila]<>0;;Cuenta2;;Fila+3000;

DEVENGADOSCUOTAS
CUOTASL.FECHA1[Fila]+1;CUOTASL.FECHA2[Fila];EQSTR(Especie,ContraEspecie)    ;SI;NO;TablaFeriados1;SI;SI;'INTLEN';(-CUOTASL.CANTIDAD3[Fila]+CUOTASL.CANTIDAD4[Fila]);140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'DT';;Fstr(Fila,0,0);Especie;
CUOTASL.FECHA1[Fila]+1;CUOTASL.FECHA2[Fila];Not EQSTR(Especie,ContraEspecie);SI;NO;TablaFeriados1;SI;SI;'INTLEN';-CUOTASL.CANTIDAD3[Fila]                          ;140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'DT';;Fstr(Fila,0,0);Especie;
CUOTASL.FECHA1[Fila]+1;CUOTASL.FECHA2[Fila];Not EQSTR(Especie,ContraEspecie);SI;NO;TablaFeriados1;SI;SI;'INTLEN'; CUOTASL.CANTIDAD4[Fila]                          ;140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;ContraEspecie;;;;;;Book1;Operador;'DT';;Fstr(Fila,0,0);ContraEspecie;

@INSTOPE
@INST19DT
@INST19BITS