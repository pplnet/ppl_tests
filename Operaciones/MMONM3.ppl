  Cantidad9: 'Prima/Desc'      ;NO;NO;;;(TOTALDERECHOS*(100/CUOTAS1)/100)+(TOTALGASTOS-TOTALGASTOS);(TOTALDERECHOS*CUOTASL.TASA1[Fila]/100)+(TOTALGASTOS-TOTALGASTOS);200;;Numero;'###,###,###,###.##';NO;NO;;SI;

CONDICIONES
[MB3 = 0] O [Not Eqstr(ABM, 'A')] O [Eqstr(ABM, 'A') Y Query(" Select 1 From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B Where O.ContraEspecie = '"~CONTRAESPECIE~"' and O.TipoOp='"~TIPOOP~"' and O.NrOperacion=B.NrOperacion and B.NrBit <> 8 and B.Valor='1'   ")  <> 1];'Este Titulo ya se encuentra emitido';NO
[MB3 = 0] O [Not Eqstr(ABM, 'E')] O [Eqstr(ABM, 'E') Y Query(" Select 1 From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B Where O.ContraEspecie = '"~CONTRAESPECIE~"' and O.TipoOp='"~TIPOOP~"' and O.NrOperacion=B.NrOperacion and B.NrBit <> 8 and B.Valor='1' and O.NrOperacion <>'"~NrOperacion~"'")  <> 1];'Este Titulo ya se encuentra emitido';NO

EQSTR(TIPOTASA,'FIJA') O [NOT EQSTR(TIPOTASA,'FIJA') Y CUOTASL.PRECIO4[Fila]=0] O [NOT EQSTR(TIPOTASA,'FIJA') Y CUOTASL.PRECIO4[Fila]>=VAR('RSPREAD1') Y CUOTASL.PRECIO4[Fila]<=VAR('RSPREAD2')];'El Spread esta Fuera de Rango '~VAR('RSPREAD1')~' '~VAR('RSPREAD2');SI;SI;FSYS;'RANGOSPREAD'
SI O [RB10>0 O [[PUTSL.FECHAEJ[1]>0 Y PUTSL.PRECIOEJ[1]>0] O [CALLSL.FECHAEJ[1]>0 Y CALLSL.PRECIOEJ[1]>0]]];'Debe tener al menos un Put o un Call Declarado';NO
SI O [NOVACIO (PRECIOREF) Y NOT EQSTR (TIPOTASA, 'FIJA')] O [VACIO (PRECIOREF) Y EQSTR (TIPOTASA, 'FIJA')];'FUENTE DE REFERENCIA TASA INTERES INVALIDO';NO
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'La Entidad Arranger esta deshabilitada';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'La Entidad Arranger esta Observada';SI;SI;FSYS;'CLIOBS'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE2));'La Entidad Agente esta deshabilitada';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE2));'La Entidad Agente esta Observada';SI;SI;FSYS;'CLIOBS'
ROUND(SUM(CUOTASL,7),2)=100;' La Sumatoria de La Tasa de Amortizacion debe ser el 100%';NO
SUM(CUOTASL,9)=PLAZO;'La Sumatoria de Plazos de los Periodos debe ser igual al Plazo Total de la Operaci#n';NO
FECHAOP2=Fsys;'La Fecha de Concertacion no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'

@CONDIOP

SI O Incluido(Especie,'ARP|USD') o NoVacio(VTXT18);'El Vehiculo no tiene Book Default para Monedas';NO
SI O Incluido(Especie,'ARP|USD') o NoVacio(VTXT19);'El Book default '~VTXT18~' no es valido';NO
SI O Incluido(Especie,'ARP|USD') o EqStr(VTXT20,Vehiculo1);'El Book default '~VTXT18~' corresponde a otro vehiculo';NO


CONDICIONESCUOTAS
SI O [CUOTASL.PRECIO2[Fila]>=VPRE11 Y CUOTASL.PRECIO2[Fila]<=VPRE12];'La Tasa de la Cuota '~Fstr(Fila, 0, 0)~' esta fuera de rango' ;SI;SI;FSYS;'RTASA';
CUOTASL.PRECIO2[Fila]>=VAR('RTASA1') Y CUOTASL.PRECIO2[Fila]<=VAR('RTASA2');'La Tasa de la Cuota '~Fstr(Fila, 0, 0)~' esta fuera de rango' ;SI;SI;FSYS;'RTASA';


EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
[EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'))] y QUERY("Select 1 FROM "~DBO~".OPERACIONES where TipoOp='MMONRE' and OperacionRef='"~NROPERACION~"' ")<>1;IF(QUERY("Select 1 FROM "~DBO~".OPERACIONES where TipoOp='MMONRE' and OperacionRef='"~NROPERACION~"' ")<>1,'No se puede dar de baja, Operador: '~Operador,'Existen operaciones MMONRE relacionadas con esta operacion')


SQL
"UPDATE "~DBO~".ESPECIES SET Alias7='"~BOOK1~"' WHERE Codigo='"~CONTRAESPECIE~"'  ";EqStr(ABM,'A')

