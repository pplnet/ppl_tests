CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp        : 'Fecha Conc.'                ;1;1;;NOT EV y VERIFICAACCESO('OPFVALOR');;EsHabil(FECHAOP,'ARG') Y ESHABIL(FECHAOP,TABLAFERIADOS1);'Fecha incorrecta';NO;FSYS;
Vehiculo1      : 'Vehiculo'                   ;1;2;;NOT EV y EqStr(ABM,'A');;NOVACIO(VEHICULO1);'El VEHICULO es INVALIDO';NO;
VTXT40         : 'Moneda Loc. Veh.'           ;1;2;;NO;NO;NoVacio(VTXT40);'No se ha especificado moneda local para el vehiculo '~VEHICULO1;NO;;BuscarCampo('VEHICULOS', 'Alias4', 'Codigo', VEHICULO1);
Operador       :                              ;;;;;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
MB3            : 'Tipo|COMPRA |VENTA'         ;3;1;;NOT EV;;;;;0;
PrecioRef      : 'Referencia'                 ;3;2;;;;NOVACIO(PRECIOREF);"Indique Precio de Referencia";NO;"PLATTS"
Cliente1       : 'ContraParte'                ;5;1;;;;NOVACIO(CLIENTE1);'El Cliente no es valido';NO;;;;
Especie        : 'Commodity'                  ;;;;NOT EV;;NoVacio(ESPECIE) y DesciendeDeEspecie(ESPECIE,'COMMOD');'Debe Ingresar una Especie';NO;'WTI'
PrecioEj       : 'Precio_Pactado'             ;;;;;;PRECIOEJ>0;'El Precio Pactado Debe ser Positivo';NO;
FechaOp2       : 'Fecha_Inicio'               ;;;;NO;NO;;;;FECHAOP;IF(Incluido(UMEDIDA,'BBLSD|ONZAS'),FECHAEJ,FECHAOP);
FechaEj        : 'Fecha Vto'                  ;;;;;;FECHAEJ>=FECHAOP Y FECHAEJ>=FECHAOP2;'La Fecha de Vencimiento Debe Ser Posterior a la Concertacion y Dia Habil en la Tabla de Feriados';NO;FECHAOP;;
Plazo          : 'Plazo'                      ;;;;NO;NOT EQSTR(UMEDIDA,'BBLSD');PLAZO>0;'Debe INGRESAR el PLAZO';NO;;EXE2(VTXT1)+(FECHAEJ-FECHAEJ+FECHAOP2-FECHAOP2)
Cantidad       : 'Volumen'                    ;;;;NOT EV;;CANTIDAD>0;'El Volumen DEBE SER POSITIVO';NO;
TotalAux2      : 'Vol_Total'                  ;;;;NO;NOT Incluido(UMEDIDA,'BBLSD|ONZAS');;;;;EXE2(VTXT2)+(CANTIDAD-CANTIDAD+PLAZO-PLAZO)
Observac2      : 'Op.Contraparte'             ;5;2;;;;NOVACIO(OBSERVAC2);'El Operador CONTRAPARTE es INVALIDO';SI;;;;
ContraEspecie  : 'Especie_Liq'                ;;;;NOT EV;;NOVACIO(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE,ESPECIE);'Debe ingresar una ContraEspecie';NO;'USD';;;;;;;" Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~") and Status = 'HAB'"
FechaVto       : 'F.Liquidacion'              ;;;;;;NoVacio(FECHAVTO) Y EsHabil(FECHAVTO,TABLAFERIADOS1);'No es un Dia Habil';NO;;HABILES(FECHAOP,5,TABLAFERIADOS1,SI);
CB9            : 'Mark_To_Mkt'                ;;;;;;;;;0;
UMedida        : 'U.Medida'                   ;;;;;;NOVACIO(UMEDIDA);'Indique Unidad de Medida';NO;BuscarCampo('Especies','Alias1','Codigo',Especie)
TotalAux1      : 'Notional_Amount'            ;;;;NO;;;;;;CANTIDAD*PRECIOEJ*PLAZO
TablaFeriados1 : 'Feriados'                   ;13;1;;;;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE)) 
CB8            : 'Ejercicio|No|Si'            ;15;1;;NO;NO;;;;0
Precio2        : 'Precio_Real'                ;1;1;2;NO;CB8=1;;;;
Precio3        : 'Res/Un.'                    ;;;2;NO;CB8=1;;;;
Precio4        : 'Res_Total'                  ;;;2;NO;CB8=1;;;;
Cotizacion1    : 'TC_Concert.'                ;;;2;;Not Eqstr(CONTRAESPECIE,VAR('MONEEXTR'));Eqstr(CONTRAESPECIE,VAR('MONEEXTR')) O [COTIZACION1<=VPRE1*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE1*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE1*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE1*(1+VAR('RPRECIO2')/100),1,7);NO;;IF(Eqstr(CONTRAESPECIE,VAR('MONEEXTR')),1)
Cotizacion2    : 'TC_Vencim.'                 ;;;2;NO;COTIZACION2<>0;;;;
VPRE1          : 'Cot.TC/USD'                 ;10;2; ;NO;NO;;;;;COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(CONTRAESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)
VPRE5          : 'Cot.ESP/USD'                ;10;3;;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
VPRE6          : 'Cot.CONTESP/USD'            ;10;3;;NO;NO;;;;;COTIZACIONC(CONTRAESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
VTXT1          : 'C_PLAZO'                    ;16;2;;NO;NO;;;;;BuscarCampo('UMEDIDAS','Formula1','Codigo',UMEDIDA)
VTXT2          : 'C_VOL_TOT'                  ;16;2;;NO;NO;;;;;BuscarCampo('UMEDIDAS','Formula2','Codigo',UMEDIDA)
VTXT3          : 'V_FECHAINI'                 ;16;2;;NO;NO;;;;;BuscarCampo('UMEDIDAS','Validacion1','Codigo',UMEDIDA)
VTXT4          : 'V_FECHAFIN'                 ;16;2;;NO;NO;;;;;BuscarCampo('UMEDIDAS','Validacion2','Codigo',UMEDIDA)
VTXT5          : 'C_PLAZOSETT'                ;16;2;;NO;NO;;;;;BuscarCampo('UMEDIDAS','Formula3','Codigo',UMEDIDA)
VTXT6          : 'C_VOLSETT'                  ;16;2;;NO;NO;;;;;BuscarCampo('UMEDIDAS','Formula4','Codigo',UMEDIDA)
Impresa        : 'Modificado'                 ;10;3;;NO;NO;;;;0
RB3            : 'MOF'                        ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)


CONDICIONES
VACIO(VTXT3) O EXE2(VTXT3);'Fecha de Inicio INVALIDA';NO
VACIO(VTXT4) O EXE2(VTXT4);'Fecha de Vencimiento INVALIDA';NO
EsHabil(FECHAVTO,'ARG');'La Fecha de Liquidacion NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'LIQINH' 
FECHAVTO>=FECHAOP Y FECHAVTO>=FECHAEJ;'La Fecha de Liq. debe ser posterior a la Concertacion y Superar la F.de Vencimiento';NO
EsTerminal(ContraEspecie,Especie);'La ContraEspecie No puede ser una Jerarquia';NO
EqStr(BuscarCampo('Especies','Status','Codigo',ContraEspecie),'HAB');'La ContraEspecie No esta Habilitada';NO
FechaOp > Fecha(Var('FECHAVALOR'));'La Fecha Valor No Debe Superar el '~Var('FECHAVALOR');NO
DifDias(FechaOp,Fsys,'ARG',SI)<=1;'Fecha Valor Mayor a un Dia: '~Fecha(FechaOp);SI;SI;FSYS;'FECHAVAL'
VACIO(OPERACIONREF) O [EQSTR(TIPOOP,BuscarCampo('Operaciones','TipoOp','NrOperacion',OPERACIONREF)) y BuscarCampo('Operaciones','FechaVto','NrOperacion',OPERACIONREF)=Fsys y EQSTR(BuscarCampo('Operaciones','Vehiculo1','NrOperacion',OPERACIONREF),VEHICULO1) y EQSTR(ESPECIE,BuscarCampo('Operaciones','Especie','NrOperacion',OPERACIONREF))];'La Operacion de Referencia es INVALIDA';NO
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
@CONDIOP

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

MOVIMIENTOS
FechaVto;Cliente1;ContraEspecie ;;;;;Vehiculo1;1;-Precio4;;'Resultado '~TIPOOP;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;Precio4<>0;;;;1;

@INSTOPE
@INST19DT
@INST19BITS