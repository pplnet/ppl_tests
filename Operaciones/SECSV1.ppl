CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp2          : 'Fecha Conc.'           ; 1;1;1;VERIFICAACCESO('OPFVALOR');;FECHAOP2<=FECHAOP;'Fecha incorrecta';NO;FSYS;
FechaOp           : 'Fecha_Origen'          ; 2;1;1;NOT EV y VERIFICAACCESO('OPFVALOR');NO;;;;FSYS;FECHAOP2
@VEHITO
@CAMPSINT

Especie           : 'Especie'               ; 3;1; ;NOT EV y [CB13=0 o [CB13=1 y CB14=0]];;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'TITULO') y [CB13=0 o [CB13=1 y [[CB14=0 y Not EqStr(ESPECIE,VTXT2)] o [CB14=1 y EqStr(ESPECIE,VTXT2)]]]];'Debe Ingresar una Especie Valida';NO;;IF(CB13=1 y CB14=1,BuscarCampo('OPERACIONES','Especie','NrOperacion',NROPERACION5),ESPECIE);;;;;;" Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES','TITULO'))~") and Status = 'HAB'"
VTXT8             : 'Clean'                 ; 3;1; ;NO;NO;;;;;BuscarCampo('ESPECIES','InteresesC','Codigo', ESPECIE);
Plazo             : 'Plazo Titulos'         ; 3;3; ;NO;NO;(PLAZO DIV 24)*24=PLAZO;'El Plazo de Titulos debe ser multiplo de 24';NO;IF(RB5=0,0,IF(RB5=1,24,IF(RB5=2,48,72)));IF(RB5=0,0,IF(RB5=1,24,IF(RB5=2,48,72)))
RB5             : 'Plazo Titulos|0|24|48|72'; 4;1; ;  ;  ;RB5>=0;'Plazo Titulos Incorrecto';NO;;IF(MODI,RB5,(BuscarCampo('Especies','PlazoLiq','Codigo',ESPECIE) DIV 24))
FechaVto          : 'Fecha Liq Titulo'      ; 5;1; ;NO;  ;ESHABIL(FECHAVTO,TABLAFERIADOS1) y [CB13=0 o [CB13=1 y FechaVto=VFEC7]];'El Vto. de la Especie debe ser DIA HABIL o no coincide con el vto de la cuota del Pmo relacionado'                         ;NO;0                                                     ;IF(RB5<0  ,0,HABILES(FECHAOP,(PLAZO DIV 24),TABLAFERIADOS1,SI))
RB8               : 'PIKs|SI|NO'            ; 6;1; ;Eqstr(BuscarCampo('ESPECIES', 'PIKs', 'Codigo', ESPECIE),'OPT');NO;;;;IF(MODI, RB8, IF(Incluido(BuscarCampo('ESPECIES', 'PIKs', 'Codigo', ESPECIE),'SIE|OPT'), 0, 1));IF(MODI, RB8, IF(Incluido(BuscarCampo('ESPECIES', 'PIKs', 'Codigo', ESPECIE),'SIE|OPT'), 0, 1))
ContraEspecie     : 'ContraEspecie'         ; 3;2; ;NOT EV;;NOVACIO(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE,ESPECIE);'Debe ingresar una ContraEspecie';NO;;COTIZAEN(ESPECIE)
Plazo2            : 'Plazo Moneda'          ; 3;3; ;NO;NO;(PLAZO2 DIV 24)*24=PLAZO2;'El Plazo de Moneda debe ser multiplo de 24';NO;IF(RB6=0,0,IF(RB6=1,24,IF(RB6=2,48,72)));IF(RB6=0,0,IF(RB6=1,24,IF(RB6=2,48,72)))
RB6              : 'Plazo Moneda|0|24|48|72'; 4;2; ;  ;  ;RB6>=0;'Plazo Moneda Incorrecto';NO;;IF(MODI,RB6,(BuscarCampo('Especies','PlazoLiq','Codigo',CONTRAESPECIE) DIV 24))
FechaPago         : 'Fecha Liq Moneda'      ; 5;2; ;NO;;ESHABIL(FECHAPAGO,TABLAFERIADOS2);'El Vto. de la Especie debe ser DIA HABIL';NO;0;IF(RB6<0,0,HABILES(FECHAOP,(PLAZO2 DIV 24),TABLAFERIADOS2,SI))

Vehiculo2         : 'Veh. Cprte.'           ; 6;1; ;NOT EV y CB13=0 Y EQSTR(ABM,'A');;NOVACIO(VEHICULO2);'El Vehiculo Contraparte no es valido' ;NO;;IF(CB13=0,BuscarCampo('OPERACIONES','VEHICULO2','NrOperacion',NROPERACION5),VEHICULO2);;;;;;"Status = 'HAB'";
Cliente1          : 'Cliente'               ; 6;1;1;NO;NO;;;;;VEHICULO2;;;;;;"Status = 'HAB'";;;;
Book2             : 'Book Cprte'            ; 7;1; ;CB13=0;  ;[SI O BookValido(BOOK2, TIPOOP, ESPECIE, VEHICULO2, OPERADOR, '' )] Y NoVacio(BOOK2);'Book del Vehiculo Contraparte invalido';NO;;IF(CB13=1,BuscarCampo('OPERACIONES','BOOK2','NrOperacion',NROPERACION5),Var('BOOKDEF'));;;;;;" Vehiculo='"~VEHICULO2~"' AND (TiposOperacion='' OR TiposOperacion Is Null OR TiposOperacion Like '%"~TIPOOP~"|%') ";

Cantidad          : 'Cantidad '             ; 8;1; ;  ;  ;CANTIDAD>0 y [CB13=0 o CB14=0 o CANTIDAD<=VCAN10];'El Valor Nominal esta fuera del rango [>0 y <=Saldo(Sintetico)]';NO;
Precio1           : 'Precio'                ; 9;1; ;  ;  ;PRECIO1>0;'El Precio DEBE SER POSITIVO';NO;;IF(VCAN6=1,1-(TIPOCAMBIO/100*(FechaMaduracion(ESPECIE)-FECHAVTO)/360),PRECIO1);;;;;'######.########'
VCAN22            : 'Nominal Capitalizado'  ;15;1; ;NO;SI;;;;;CANTIDAD+(CANTIDAD*IntsCapitalizados2(ESPECIE,FECHAVTO));
VCAN20            : 'Int.Capitalizado'      ;16;1; ;NO;NO;;;;;IF(Eqstr(VTXT8,'CLE'),VCAN22*PRECIO1*ValorTeorico2(ESPECIE,FECHAVTO)*CampoAgenda(ESPECIE,CUPON1,4)/100*VCAN14/IF(VCAN11=0, 360, IF(VCAN11=1, 365, DiasA(2, FECHAVTO))),0);
VCAN21            : 'Int.Corrido'           ;17;1; ;NO;NO;;;;;IF(Eqstr(VTXT8,'CLE'),IF(RB8=0, ValorTeorico2(ESPECIE,FECHAVTO)*CANTIDAD*(BuscarCampo('ESPECIES','TasaIntPIKsVigente','Codigo', ESPECIE)+(BuscarCampo('ESPECIES','TasaPIKsVigente','Codigo', ESPECIE)*PRECIO1))/DIASA(EspecieDiasAnio(ESPECIE),FSYS)*IF(EspecieDiasAnio(ESPECIE)=0 y EspecieDiasMes(ESPECIE)=0,Dif360(FECHAULTCUPON,FECHAVTO,4),DifDias(FECHAULTCUPON,FECHAVTO,'USA',NO)), InteresEspecie(ESPECIE, FECHAVTO, VCAN22)),0);


TotalBrutoCli1    : 'Importe Bruto'         ;10;1; ;Eqstr(VTXT8,'CLE')                                                ;;;;;;IF(MODI,TOTALBRUTOCLI1,IF(Eqstr(VTXT8,'CLE'),PRECIO1*VCAN22*ValorTeorico2(ESPECIE,FECHAVTO),PRECIO1*CANTIDAD));
OperacionRef      : 'Op_Referencia'         ;11;1; ;NO;NOVACIO(OPERACIONREF);;;;;; 
TotalIntereses    : 'Interes'               ;10;2; ;NO;Eqstr(VTXT8,'CLE');;;;;IF(MODI,TOTALINTERESES, VCAN20+VCAN21) * IF(Eqstr(Modo(COTIZAEN(ESPECIE), CONTRAESPECIE), 'INV'), 1/COTIZACION1, COTIZACION1);
TotalImpuesto1    : 'InteresVto'            ;11;2; ;NO;NO;;;;;ValorTeorico2(ESPECIE,FECHAVTO)*VCAN22*TASAINTERESESCUPON/DIASA(EspecieDiasAnio(ESPECIE),FSYS)/100*IF(EspecieDiasAnio(ESPECIE)=0 y EspecieDiasMes(ESPECIE)=0,Dif360(FECHAULTCUPON,FECHAVTO,4),DifDias(FECHAULTCUPON,FECHAVTO,'USA',NO)) * IF(Eqstr(Modo(COTIZAEN(ESPECIE), CONTRAESPECIE), 'INV'), 1/COTIZACION1, COTIZACION1);
Precio6           : 'Precio Clean'          ;12;2; ;NO;NO;;;;;IF(TOTALIMPUESTO1 > 0, IF(Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE'), PRECIO1, ((CANTIDAD * PRECIO1) - TOTALIMPUESTO1) / CANTIDAD), PRECIO1) * IF(ValorTeorico2(ESPECIE,FECHAVTO) > 0  Y Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE'), ValorTeorico2(ESPECIE,FECHAVTO), 1);;;;;'######.########'
TotalNetoCli1     : 'Imp_Liquidar'          ;11;2; ;NO;Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE');;;;;TOTALBRUTOCLI1+TOTALINTERESES;
CB5               : 'Repo Sintetico'        ; 6;2; ;  ;NO;;;;
FormaLiquidacion1 :'Liquidacion|FOP|DVP|RVP'; 7;2; ;  ;  ;FORMALIQUIDACION1>=0;'La Forma de Liquidacion es Invalida';NO;;IF(INCLUIDO(MERCADO,'CV'),IF(MODI,FORMALIQUIDACION1,LIQHABITUAL(CLIENTE1)),0);
Cartera           : 'Cartera|HM|SA|AS|TR'   ; 8;2; ;  ;  ;CARTERA>=0;'Indique EL TIPO DE CARTERA';NO;3;;
Spread            : 'Precio Dirty'          ;  ; ; ;NO;Eqstr(VTXT8,'CLE');SPREAD>0;'El Precio Dirty DEBE SER POSITIVO';NO;;IF(Eqstr(VTXT8,'CLE'),(TOTALBRUTOCLI1+TOTALINTERESES)/VCAN22,PRECIO1);;;;;'######.########'
Operador          :                         ;12;1; ;NO;  ;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
Cotizacion1       : 'TC_Concert.'           ;12;2; ;  ;Not Eqstr(CONTRAESPECIE, COTIZAEN(ESPECIE));Eqstr(CONTRAESPECIE,COTIZAEN(ESPECIE)) O [COTIZACION1<=VPRE1*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE1*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE1*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE1*(1+VAR('RPRECIO2')/100),1,7);NO;;IF(Eqstr(CONTRAESPECIE,COTIZAEN(ESPECIE)),1,IF(Eqstr(Modo(COTIZAEN(ESPECIE), CONTRAESPECIE), 'INV'), 1/COTIZACIONC(COTIZAEN(ESPECIE),,,,FECHAOP,1,SI,CONTRAESPECIE), COTIZACIONC(COTIZAEN(ESPECIE),,,,FECHAOP,1,SI,CONTRAESPECIE)))
TablaFeriados1    : 'Feriados Esp.'         ;13;1; ;  ;  ;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE)) 
TablaFeriados2    : 'Feriados Con.'         ;13;2; ;  ;  ;NOVACIO(TABLAFERIADOS2);'Se debe indicar feriados a utilizar';NO;;BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',CONTRAESPECIE)) 
Precio4           : 'Cotizacion'            ;10;2; ;NO;NO;;;;;IF(CB6=1,COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'ARP')/COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,'ARP'),COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,'ARP')/COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'ARP'))

MB4               : 'Gen_Contra|Si|No'      ;16;1; ;  ;  ;MB4>=0;'Genera Contra Operacion?';NO;;
NrOperacion3      : 'Op.Asociada'           ;16;2; ;NO;NOVACIO(NROPERACION3)

@COMISEC

VCAN11            : 'DiasAnio'              ;  ; ;2;NO;NO;;;;;EspecieDiasAnio(ESPECIE);
VCAN13            : 'DiasMes'               ;  ; ;2;NO;NO;;;;;EspecieDiasMes(ESPECIE);
VCAN14            : 'Dias'                  ;  ; ;2;NO;NO;;;;;IF(VCAN11=0 Y VCAN13=0, Dif360(FECHAULTCUPON,FECHAVTO, 4), DifDias(FECHAULTCUPON,FECHAVTO,'USA',NO));

TotalAux1         : 'Int.Capitalizado'      ;10;2;2;NO;Eqstr(VTXT8, 'CLE');;;;;VCAN20;
TotalAux2         : 'Int.Corrido'           ;11;2;2;NO;Eqstr(VTXT8, 'CLE');;;;;VCAN21;

CB1               : 'Op.Automatica'         ;10;2;2;NO;  ;;;;0
VTXT13            : 'Cupon Anterior'        ; 9;2;2;NO;NO;;;;IF(EqStr(VTXT14,'0'),'0',FStr(NrCupon2(ESPECIE,FECHAVTO)-1,0,0));IF(EqStr(VTXT14,'0'),'0',FStr(NrCupon2(ESPECIE,FECHAVTO)-1,0,0));
VTXT14            : 'Cupon Actual'          ;10;2;2;NO;NO;;;;FStr(NrCupon2(ESPECIE,FECHAVTO),0,0);FStr(NrCupon2(ESPECIE,FECHAVTO),0,0);
RB9               : 'ExCupon|Si|No'         ; 9;1;2;  ;  ;;;;1
Cupon1            : 'Cupon'                 ;10;1;2;RB9=0;;[RB9=0 y EqStr(CUPON1,VTXT13)] o RB9=1 ;'Cupon Incorrecto';NO;IF(RB9=0,VTXT13,VTXT14);IF(RB9=0,VTXT13,VTXT14);;;;;'###'

TipoCambio        : 'Tasa'                  ;14;1;2;  ;VCAN6=1;;;;;IF(VCAN6=1,(1-PRECIO1)*36000/(FechaMaduracion(ESPECIE)-FECHAVTO),0)
FechaUltCupon     : 'Ult.Cupon'             ;14;2;2;NO;Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE');;;;;IF(EsHabil(UltCupon2(ESPECIE,FECHAVTO),'USA'),UltCupon2(ESPECIE,FECHAVTO),Habiles(UltCupon2(ESPECIE,FECHAVTO),IF(EqStr(BuscarCampo('ESPECIES','CuponFeriado','Codigo',ESPECIE),'SIG'),1,IF(EqStr(BuscarCampo('ESPECIES','CuponFeriado','Codigo',ESPECIE),'ANT'),-1,0)),'USA'))
TasaInteresesCupon: 'Tasa (%)'              ;15;2;2;NO;Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE');;;;;IF(BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',ESPECIE) > FECHAULTCUPON y BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',ESPECIE) <= FECHAVTO,((BuscarCampo('ESPECIES','TasaIntAnterior','Codigo',ESPECIE)*IF(EspecieDiasAnio(ESPECIE)=0 y EspecieDiasMes(ESPECIE)=0,Dif360(FECHAULTCUPON,BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',ESPECIE)-1,4),DifDias(FECHAULTCUPON,BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',ESPECIE)-1,'USA',NO)))+(BuscarCampo('ESPECIES','TasaIntVigente','Codigo',ESPECIE)*(IF(EspecieDiasAnio(ESPECIE)=0 y EspecieDiasMes(ESPECIE)=0,Dif360(BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',ESPECIE)-1,FECHAVTO,4),DifDias(BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',Especie)-1,FECHAVTO,'USA',NO)))))/(IF(EspecieDiasAnio(ESPECIE)=0 y EspecieDiasMes(ESPECIE)=0,Dif360(FECHAULTCUPON,FECHAVTO,4),DifDias(FECHAULTCUPON,FECHAVTO,'USA',NO))),BuscarCampo('ESPECIES','TasaIntVigente','Codigo',ESPECIE))*100;
VPRE1             : 'Cot.TC/COTIZA'            ;10;2;2;NO;NO;;;;;COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,COTIZAEN(ESPECIE))^If(EqStr(Modo(CONTRAESPECIE,COTIZAEN(ESPECIE)),'DIR'),1,-1)
PlazoRenovPredeter: 'Cot.Contable'          ;11;2;2;NO Y [NOT EQSTR (COTIZAEN(ESPECIE),CONTRAESPECIE)];NO Y [NOT EQSTR(COTIZAEN(ESPECIE),CONTRAESPECIE)];SI O [EQSTR(COTIZAEN(ESPECIE),CONTRAESPECIE) o PLAZORENOVPREDETER > 0];'REQUIERE COTIZACION CONTABLE';NO;;IF(MODI, PLAZORENOVPREDETER, IF(Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE), IF(Eqstr(CotizaEn(ESPECIE), VAR('MONELOCA') ), 1 , COTIZACIONBNA(CONTRAESPECIE,FECHAOP,1,NO,NO) )   ))
Cotizacion2       : 'TC_Vencim.'            ;12;2;2;NO;COTIZACION2<>0;;;;

CB6               : 'Cot. Esp/ContDirecta'  ;12;3;2;NO;NO;;;;;IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE~"' "),'INV'),0,1)
PaseCB            : 'Origen Repo'           ; 9;3;2;NO;NO;;;;0;
RB3               : 'MOF'                   ;10;2;2;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa           : 'Modificado'            ;10;3;2;NO;NO;;;;0

VPRE5             : 'Cot.ESP/USD'           ;10;3;2;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
VPRE6             : 'Cot.CONTESP/USD'       ;10;3;2;NO;NO;;;;;COTIZACIONC(CONTRAESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
VCAN6             : 'ZeroCoupon'            ; 9;2;2;NO;NO;;;;;IF(Eqstr(BuscarCampo('ESPECIES','ZeroCoupon','Codigo',ESPECIE),'SI'),1,0)
VCAN12            : 'Cotizacion de Mercado' ;19;2;2;No;No;;;;;COTIZACIONC(COTIZAEN(ESPECIE),,,,FECHAOP,1,SI,CONTRAESPECIE))
VTXT1             : 'TipoEspecie'           ; 9;2;2;NO;NO;;;;;BuscarCampo('ESPECIES','Tipo','Codigo',ESPECIE)

VTXT18            : 'Book Def'    ; 1;2;2;NO;NO;;;;;BuscarCampo('VEHICULOS','Alias5','Codigo',VEHICULO1)
VTXT19            : 'Codigo Book' ; 2;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Codigo','Codigo',VTXT18)
VTXT20            : 'Vehic.Book'  ; 3;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Vehiculo','Codigo',VTXT19)
VTXT21            : 'Book Def'    ; 4;2;2;NO;NO;;;;;BuscarCampo('VEHICULOS','Alias5','Codigo',VEHICULO2)
VTXT22            : 'Codigo Book' ; 7;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Codigo','Codigo',VTXT21)
VTXT23            : 'Vehic.Book'  ; 6;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Vehiculo','Codigo',VTXT22)

@CUENTAS
@CUENTAS2

CONDICIONES
ESHABIL(FECHAOP,'ARG');'La Fecha de Origen no es Dia Habil en Argentina';SI;SI;FSYS;'ORIGINH'
Not EqStrI(Vehiculo1,Vehiculo2);'El Vehiculo Contraparte debe ser diferente al Vehiculo por el cual se ingresa la Operacion';NO;NO;FSYS;'VEHDUPL'
EsHabil(FECHAVTO,'ARG') ;'La Fecha de Liquidacion de Titulos NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'LIQTIINH'
EsHabil(FECHAPAGO,'ARG');'La Fecha de Liquidacion de Moneda NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'LIQMONINH'
EqStr(BuscarCampo('Especies','Status','Codigo',ContraEspecie),'HAB');'La ContraEspecie No esta Habilitada';NO
PRECIO1<=PRECIO4*(1+VAR('RPRECIO') /100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO') /100);'Tipo de Cambio FUERA DE RANGO: '~FSTR(PRECIO4*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO')/100),1,7)  ;SI;SI;FSYS;'RANGOPRECIO'
PRECIO1<=PRECIO4*(1+VAR('RPRECIO2')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO2')/100);'Tipo de Cambio Fuera de Rango: '~FSTR(PRECIO4*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO2')/100),1,7);SI;SI;FSYS;'RANGOPRECIO2'

SI O [Eqstr(COTIZAEN(ESPECIE),CONTRAESPECIE) O PlazoRenovPredeter<=VCAN12*(1+VAR('RPRECIO2')/100) Y PlazoRenovPredeter>=VCAN12*(1-VAR('RPRECIO2')/100)];'COTIZACION CONTABLE Fuera de Rango: '~FSTR(VCAN12*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO2')/100),1,7);NO
SI O [Eqstr(COTIZAEN(ESPECIE),CONTRAESPECIE) O PlazoRenovPredeter<=VCAN12*(1+VAR('RPRECIO') /100) Y PlazoRenovPredeter>=VCAN12*(1-VAR('RPRECIO') /100)];'COTIZACION CONTABLE FUERA DE RANGO: '~FSTR(VCAN12*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOCOTCON'

SI O [RB12<>0 O VACIO(Corredor) O [PORCOMCOR1>=VAR('RCOMCOR1') y PORCOMCOR1<=VAR('RCOMCOR2')]];'El % Comision Corredor EXCEDE Los Limites: Min.'~VAR('RCOMCOR1')~' Max.'~VAR('RCOMCOR2');NO
SI O [RB13<>0 O EqStr(Mercado,'OTC')  o [PORCOMMER1>=VAR('RCOMMER1') y PORCOMMER1<=VAR('RCOMMER2')]];'El % Comision Mercado EXCEDE Los Limites: Min.'~VAR('RCOMMER1')~' Max.'~VAR('RCOMMER2');NO

NOT EQSTR (VEHICULO1,CLIENTE1);'El Cliente y el Vehiculo deben ser distintos';NO
FECHAOP2=Fsys;'La Fecha de Concertaci¦n no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
@CONDIOP
@CONDCUPON

SI O Incluido(ContraEspecie,'ARP|USD') o NoVacio(VTXT18);'El Vehiculo no tiene Book Default para Monedas';NO
SI O Incluido(ContraEspecie,'ARP|USD') o NoVacio(VTXT19);'El Book default '~VTXT18~' no es valido';NO
SI O Incluido(ContraEspecie,'ARP|USD') o EqStr(VTXT20,Vehiculo1);'El Book default '~VTXT18~' corresponde a otro vehiculo';NO
SI O Incluido(ContraEspecie,'ARP|USD') o NoVacio(VTXT21);'El Vehiculo Contraparte tiene Book Default para Monedas';NO
SI O Incluido(ContraEspecie,'ARP|USD') o NoVacio(VTXT22);'El Book default Contraparte '~VTXT21~' no es valido';NO
SI O Incluido(ContraEspecie,'ARP|USD') o EqStr(VTXT23,Vehiculo2);'El Book default Contraparte '~VTXT21~' corresponde a otro vehiculo';NO


EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

POSTEDICION
INCLUIDO(ABM,'A') y CB13=1 y CB14=1;'ACTSPE';NrOperacion1=NROPERACION5;Entero1=CUOTAS1;Cantidad1=CANTIDAD;Radio1=0;Check1=1
INCLUIDO(ABM,'D') y CB13=1 y CB14=1;'ACTSPE';NrOperacion1=NROPERACION5;Entero1=CUOTAS1;Cantidad1=CANTIDAD;Radio1=1;Check1=1
