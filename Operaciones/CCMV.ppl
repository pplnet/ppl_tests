CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp2       : 'Fecha_Conc.'                ;1;1;;VERIFICAACCESO('OPFVALOR');;FECHAOP2<=FECHAOP;'FECHA DE CONCERTACION INCORRECTA';NO;FSYS;
FechaOp        : 'Fecha_Origen'               ;2;1;;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1);'FECHA DE ORIGEN INCORRECTA';NO;FSYS;
@VEHITO
Operador       : '     Operador'              ;;2;;;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
RB6            : '     Urgente|Si|No'         ;4;2;;;;RB6>=0;'Indique el Caracter de la Operacion';NO;
RB8            : '     U.Tiempo|360|365'      ;;;;;;RB8>=0;'Unidad de Tiempo Tasa Interes INVALIDA';NO;365
RB7            : '     Transfer|No|Si'        ;;;;;;;;;0;
RB10           : '     Confirm|No|Si'         ;;;;;;;;;1;
RB9            : '     Revocab|No|Si'         ;;;;;;;;;0;
Observac2      : 'Proveedor'                  ;4;1;;;;NOVACIO(OBSERVAC2);'Debe Ingresar el Proveedor';NO;
ObservacDoc    : 'Origen'                     ;;;;;;NOVACIO(OBSERVACDOC);'Origen Invalido';NO;;
Observac3      : 'Mercaderia'                 ;;;;;;NOVACIO(OBSERVAC3);'Indique la Mercaderia';NO;;
Plaza1         : 'Plaza'                      ;;;;;;NOVACIO(PLAZA1) Y Longitud(PLAZA1)<11;'Plaza Invalida';NO
Especie        : 'Moneda'                     ;8;1;;NOT EV;;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE,ESPECIE);'Debe Ingresar una Moneda ';NO;;;;;;;;" Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~") and Status = 'HAB'"
Pais           : 'Pais'                       ;;;;;;NOVACIO(PAIS);'Se debe indicar el Pais';NO;;
Cantidad       : 'Importe'                    ;11;1;;;;CANTIDAD>0;'El Importe DEBE SER POSITIVO';NO;
FechaVto       : 'F_Solicitud'                ;;;;;;FECHAVTO>0 y FECHAVTO<=FECHAOP;'La Fecha de Solicitud debe ser Anterior al Origen';NO;;
Plazo2         : 'Val_Embarque'               ;;;;;;PLAZO2>0;'La Validez del Embarque Debe ser Positiva';NO;FECHAEX1-FECHAOP;FECHAEX1-FECHAOP
Plazo3         : 'Val_Negociacion'            ;;;;;;PLAZO3>0;'La Validez de la Negociacion Debe ser Positiva';NO;
FechaEx1       : 'F_Val_Embarque'             ;13;2;;;;FECHAEX1>0;'La Fecha de Validez de Embarque Es Incorrecto';NO;FECHAOP;FECHAOP+PLAZO2
RB5            : 'Pago|Vista|Difer|Plazo'     ;11;2;;;;RB5>=0;'Indique el Plazo de Pago';NO
Plazo4         : 'Plazo'                      ;;;;RB5>0;RB5>0;RB5=0 O PLAZO4>0;'Indique el Plazo Correspondiente';NO;;IF(RB5=0,0,PLAZO4)
Plazo          : 'Pzo_Total'                  ;14;2;;;;PLAZO<=PLAZO2+PLAZO3+PLAZO4 Y PLAZO>0;'Debe INGRESAR el PLAZO';NO;;PLAZO2+PLAZO3+PLAZO4
TablaFeriados1 : 'Feriados'                   ;;;;;;NOVACIO(TABLAFERIADOS1);'Se debe indicar la Tabla de Feriados';NO;VAR('FERIADODEF');
Cliente1       : 'Entidad'                    ;1;1;2;NOT EV;;NOVACIO(CLIENTE1) y DESCIENDEDECLIENTE(CLIENTE1,'BANCOS');'Seleccione la Entidad Bancaria';NO;;
Precio1        : 'Tasa_Anual'                 ;;;2;NO;;PRECIO1>=0;'La Tasa Debe ser positiva';NO;;IF(IMPCOMMER1>0,(IMPCOMMER1*IF(RB8=0,360,365))/(PLAZO*CANTIDAD),IF(PORCOMMER1>0,(PORCOMMER1/100)*IF(RB8=0,360,365)/PLAZO,0))*100
ImpComMer1     : 'Comision'                   ;;;2;;;;;;;IF(PORCOMMER1>0,(PORCOMMER1/100)*CANTIDAD,IF(PRECIO1>0,(((PRECIO1/100)*PLAZO*CANTIDAD)/IF(RB8=0,360,365))))
ImpComMerEq1   : 'ContraValor'                ;;;2;NO;NOT EQSTR(ESPECIE,CONTRAESPECIE2);;;;;IMPCOMMER1*IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE2~"' "),'DIR'),TCCOMCOR1,IF(TCCOMCOR1<>0,1/TCCOMCOR1,0))
PorComMer1     : 'Tasa_Flat'                  ;;;2;;;;;;;IF(IMPCOMMER1>0,IMPCOMMER1/CANTIDAD,IF(PRECIO1>0,(PRECIO1/100)*PLAZO/IF(RB8=0,360,365),0))*100
ContraEspecie2 : '     Mon_Gs'                ;1;2;2;;;NOVACIO(CONTRAESPECIE2) y DESCIENDEDEESPECIE(CONTRAESPECIE2,'MONEDA') y ESTERMINAL(CONTRAESPECIE2,ESPECIE);'Especie de Pago Gastos';NO;;IF(MODI,ESPECIE,CONTRAESPECIE2);;;;;;" Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~") and Status = 'HAB'"
ImpGastos2     : '     Gastos'                ;;;2;;;IMPGASTOS2>=0 Y IMPGASTOS2<=CANTIDAD*0.10;'El Importe de Gastos debe ser Inferior al 10% del Importe';NO;;IMPCOMCOREQ1*IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE2~"' "),'DIR'),1/TCCOMCOR1,IF(TCCOMCOR1<>0,TCCOMCOR1,0))
TCComCor1      : '     TC Gastos'             ;;;2;NOT EQSTR(ESPECIE,CONTRAESPECIE2);NOT EQSTR(ESPECIE,CONTRAESPECIE2);TCCOMCOR1>=0;'Tipo de Cambio del Gastos INVALIDO';NO;1;IF(EQSTR(ESPECIE,CONTRAESPECIE2),0,TCCOMCOR1)
ImpComCorEq1   : '     ContraValor'           ;;;2;;NOT EQSTR(ESPECIE,CONTRAESPECIE2);;;;;IF(NOT EQSTR(ESPECIE,CONTRAESPECIE2),IMPGASTOS2*IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE2~"' "),'DIR'),TCCOMCOR1,IF(TCCOMCOR1<>0,1/TCCOMCOR1,0)),0)
ImpGastos1     : '     Alicuota IVA'          ;;;2;;;INCLUIDO(Fstr(IMPGASTOS1,2,2),VAR('IVA'));"El Valor de TASA IVA es Erroneo: "~VAR('IVA');NO;VAR('TASAIVA');IF(Incluido(VEHICULO1,VAR('VEHIEXTRAN')),0,VAR('TASAIVA'));
TotalRetenciones:'     Impuesto'              ;;;2;;;;;;;IF(NOT EQSTR(ESPECIE,CONTRAESPECIE2),TOTALCOMISIONES,PRECIO4)*IMPGASTOS1/100;
Precio4        : 'Costo Total'                ;6;1;2;NO;;;;;;IMPCOMMER1+IMPGASTOS2
TotalComisiones: 'Costo Contr'                ;;;2;NO;NOT EQSTR(ESPECIE,CONTRAESPECIE2);;;;;IF(NOT EQSTR(ESPECIE,CONTRAESPECIE2),PRECIO4*IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE2~"' "),'DIR'),TCCOMCOR1,IF(TCCOMCOR1<>0,1/TCCOMCOR1,0)),0)
MensajeChequeo : 'Contacto '                  ;8;2;2;;;NOVACIO(MENSAJECHEQUEO);'Indique el Contacto PC';NO;;;
Cliente2       : 'Bco_Negociador'             ;9;1;2;;;NOVACIO(CLIENTE2) y DESCIENDEDECLIENTE(CLIENTE2,'BANCOS');'Seleccione el Banco Negociador';NO;;
Cliente3       : 'Bco_Confirmador'            ;;;2;;;NOVACIO(CLIENTE3) y DESCIENDEDECLIENTE(CLIENTE3,'BANCOS');'Seleccione el Banco Confirmador';NO;;
Cliente4       : 'Bco_Avisador'               ;;;2;;;NOVACIO(CLIENTE4) y DESCIENDEDECLIENTE(CLIENTE4,'BANCOS');'Seleccione el Banco Avisador';NO;;
FechaEx2       : 'Vto_Validez'                ;9;2;2;NO;;ESHABIL(FECHAEX2,'ARG');'Fecha de Vto. Validez Invalida';NO;;FECHAOP+PLAZO
RB4            : 'Oper_Asociada'              ;12;1;2;;;;;;0;
TipoOp2        : 'Tipo_OpAsoc'                ;13;1;2;RB4=1;RB4=1;;;;;
PlazoGracia    : 'Plazo_OpAsoc '              ;;;2;RB4=1;RB4=1;;;;;
Cliente5       : 'Entidad_OpAsoc'             ;;;2;RB4=1;RB4=1;RB4=0 O NOVACIO(CLIENTE5) ;'Seleccione la Entidad de la Operacion Asociada';NO;;
Cotizacion1    : 'TC_Concert.'                ;;;2;;Not Eqstr(ESPECIE,VAR('MONEEXTR'));Eqstr(ESPECIE,VAR('MONEEXTR')) O [COTIZACION1<=VPRE1*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE1*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE1*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE1*(1+VAR('RPRECIO2')/100),1,7);NO;;IF(Eqstr(ESPECIE,VAR('MONEEXTR')),1)
Cotizacion2    : 'TC_Vencim.'                 ;;;2;COTIZACION2<>0;COTIZACION2<>0;;;;
VPRE1          : 'Cot.TC/USD'                 ;10;2; ;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(ESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)
Spread         : 'Spred_OpAsoc'               ;13;2;2;RB4=1;RB4=1;SPREAD>=0;'El SPREAD Debe SER POSITIVO';NO;0;
Precio3        : 'Tasa_OpAsoc'                ;14;2;2;RB4=1;RB4=1;PRECIO3>=0;'La Tasa de la Operacion Debe Ser Positiva';NO;
MB1            : 'Activa|No|Si'               ;;;2;;;;;;0;;    
Cuotas1        : 'Nr_Embarques'               ;;;2;;;CUOTAS1>=1;'Debe INGRESAR la Cantidad De Embarques';NO;;;
RB3            : 'MOF'                        ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)
VPRE3          : 'Cot.Esp/ARP'                ;14;2;2;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONELOCA'))
Impresa        : 'Modificado'                 ;10;3;;NO;NO;;;;0
OperacionRef   : ''                           ;;;2;NO;NO;

LISTA:SI;IF(ESINICIO,100,CUOTAS1);
  Fecha1   : 'F.Origen'        ;NO;;ESHABIL(CUOTASL.FECHA1[Fila],TABLAFERIADOS1) Y ESHABIL(CUOTASL.FECHA1[Fila],'ARG');'La Fecha Origen No es HABIL';IF(Fila=1,FECHAOP,CUOTASL.FECHA2[Fila-1]);IF(Fila=1,FECHAOP,CUOTASL.FECHA2[Fila-1]);90;;Fecha
  Fecha2   : 'F.Vto'           ;;;ESHABIL(CUOTASL.FECHA2[Fila],TABLAFERIADOS1) Y ESHABIL(CUOTASL.FECHA2[Fila],'ARG');'El Vencimiento No es HABIL';IF(Fila=CUOTAS1,FECHAEX2,CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila]);IF(Fila=CUOTAS1,FECHAEX2,IF(EQSTR(CAMPOMODIFICADO,'CUOTASL.FECHA2['~Fstr(Fila,1,0)~']'),CUOTASL.FECHA2[Fila],CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila]));90;;Fecha
  Plazo1   : 'Plazo'           ;;;CUOTASL.PLAZO1[Fila]>0;'El Plazo DEBE SER POSITIVO';IF(Fila=CUOTAS1 Y (PLAZO MOD CUOTAS1)<>0,(PLAZO DIV CUOTAS1)+(PLAZO MOD CUOTAS1),(PLAZO DIV CUOTAS1));IF(EQSTR(CAMPOMODIFICADO,'CUOTASL.PLAZO1['~Fstr(Fila,1,0)~']'),CUOTASL.PLAZO1[Fila],CUOTASL.FECHA2[Fila]-CUOTASL.FECHA1[Fila]);60;;Numero;'####'
  Cantidad1: 'Importe'         ;NO;;;;;IF(Fila=1,CANTIDAD,CUOTASL.CANTIDAD3[Fila-1]);200;;Numero;'###,###,###.##'
  Tasa1    : 'Tasa Amort'      ;;;CUOTASL.TASA1[Fila]>=0;'La Tasa de Amortizacion debe SER POSITIVA';100/CUOTAS1;IF(EQSTR(CAMPOMODIFICADO,'CUOTASL.TASA1['~Fstr(Fila,1,0)~']'),CUOTASL.TASA1[Fila],CUOTASL.CANTIDAD2[Fila]*100/CANTIDAD);100;;Numero;'###,###.######'
  Cantidad2: 'Importe Amort'   ;;;;;;IF(EQSTR(CAMPOMODIFICADO,'CUOTASL.CANTIDAD2['~Fstr(Fila,1,0)~']'),CUOTASL.CANTIDAD2[Fila],CUOTASL.TASA1[Fila]*CANTIDAD/100);200;;Numero;'###,###,###.##'
  Cantidad3: 'Saldo'           ;NO;;;;;CUOTASL.CANTIDAD1[Fila]-CUOTASL.CANTIDAD2[Fila];200;;Numero;'###,###,###.##'
  Precio1  : 'Tasa Anual'      ;NO;;;;;IF(EQSTR(CAMPOMODIFICADO,'CUOTASL.PRECIO2['~Fstr(Fila,1,0)~']'),((CUOTASL.PRECIO2[Fila]*IF(RB8=0,360,365))/(CUOTASL.PLAZO1[Fila]*CUOTASL.CANTIDAD1[Fila]))*100,IF(EQSTR(CAMPOMODIFICADO,'CUOTASL.PRECIO3['~Fstr(Fila,1,0)~']'),((CUOTASL.PRECIO3[Fila]/100)*IF(RB8=0,360,365)/CUOTASL.PLAZO1[Fila])*100,CUOTASL.PRECIO1[Fila]));200;;Numero;'###,###.######'
  Precio2  : 'Comision'        ;;;;;;IF(EQSTR(CAMPOMODIFICADO,'CUOTASL.PRECIO1['~Fstr(Fila,1,0)~']'),(((CUOTASL.PRECIO1[Fila]/100)*CUOTASL.PLAZO1[Fila]*CUOTASL.CANTIDAD1[Fila])/IF(RB8=0,360,365)),IF(EQSTR(CAMPOMODIFICADO,'CUOTASL.PRECIO3['~Fstr(Fila,1,0)~']'),(CUOTASL.PRECIO3[Fila]/100)*CUOTASL.CANTIDAD1[Fila],CUOTASL.PRECIO2[Fila]));200;;Numero;'###,###,###.##'
  Total7   : 'ContraValor'     ;NO;NOT EQSTR(ESPECIE,CONTRAESPECIE2);;;;CUOTASL.PRECIO2[Fila]*IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE2~"' "),'DIR'),CUOTASL.TOTAL1[Fila],IF(CUOTASL.TOTAL1[Fila]<>0,1/CUOTASL.TOTAL1[Fila],0));200;;Numero;'###,###,###.##'
  Precio3  : 'Tasa_Flat'       ;;;;;;IF(EQSTR(CAMPOMODIFICADO,'CUOTASL.PRECIO2['~Fstr(Fila,1,0)~']'),(CUOTASL.PRECIO2[Fila]/CUOTASL.CANTIDAD1[Fila])*100,IF(EQSTR(CAMPOMODIFICADO,'CUOTASL.PRECIO1['~Fstr(Fila,1,0)~']'),(CUOTASL.PRECIO1[Fila])*CUOTASL.PLAZO1[Fila]/IF(RB8=0,360,365)*100,CUOTASL.PRECIO3[Fila]));200;;Numero;'###,###.######'
  Cantidad4: 'Gastos'          ;;;CUOTASL.CANTIDAD4[Fila]>=0 Y CUOTASL.CANTIDAD4[Fila]<=CANTIDAD*0.10;'El Importe de Gastos debe ser Inferior al 10% del Importe';;IF(EQSTR(CAMPOMODIFICADO,'CUOTASL.TOTAL6['~Fstr(Fila,1,0)~']'),CUOTASL.TOTAL6[Fila]*IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE2~"' "),'DIR'),1/CUOTASL.TOTAL1[Fila],IF(CUOTASL.TOTAL1[Fila]<>0,CUOTASL.TOTAL1[Fila],0)),CUOTASL.CANTIDAD4[Fila]);200;;Numero;'###,###,###.##'
  Total6   : 'ContraValor'     ;NO;NOT EQSTR(ESPECIE,CONTRAESPECIE2);;;;CUOTASL.CANTIDAD4[Fila]*IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE2~"' "),'DIR'),CUOTASL.TOTAL1[Fila],IF(CUOTASL.TOTAL1[Fila]<>0,1/CUOTASL.TOTAL1[Fila],0));200;;Numero;'###,###,###.##'
  Total1   : 'TC Gastos'       ;;NOT EQSTR(ESPECIE,CONTRAESPECIE2);CUOTASL.TOTAL1[Fila]>=0;'Tipo de Cambio del Gastos INVALIDO';1;;200;;Numero;'###,###.######'
  Total2   : 'Costo Total'     ;NO;;;;;CUOTASL.CANTIDAD4[Fila]+CUOTASL.PRECIO2[Fila];200;;Numero;'###,###,###.##'
  Total3   : 'ContraValor'     ;NO;NOT EQSTR(ESPECIE,CONTRAESPECIE2);;;;CUOTASL.TOTAL2[Fila]*IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE2~"' "),'DIR'),CUOTASL.TOTAL1[Fila],IF(CUOTASL.TOTAL1[Fila]<>0,1/CUOTASL.TOTAL1[Fila],0));200;;Numero;'###,###,###.##'
  Total5   : 'Impuesto'        ;NO;;;;;(CUOTASL.PRECIO2[Fila]+CUOTASL.CANTIDAD4[Fila])*IMPGASTOS1/100;200;;Numero;'###,###,###.##'
  Total8   : 'ContraValor'     ;NO;NOT EQSTR(ESPECIE,CONTRAESPECIE2);;;;CUOTASL.TOTAL5[Fila]*IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE2~"' "),'DIR'),CUOTASL.TOTAL1[Fila],IF(CUOTASL.TOTAL1[Fila]<>0,1/CUOTASL.TOTAL1[Fila],0));200;;Numero;'###,###,###.##'

CONDICIONES
SUM(CUOTASL,3)=PLAZO;'La Sumatoria del Plazo debe coincidir con el total';NO
SUM(CUOTASL,5)=100;'La Sumatoria de la Tasa de Amortizacion debe ser 100';NO
SUM(CUOTASL,6)=CANTIDAD;'La Sumatoria de los Importes de Embarque debe coincidir con el Importe de la Operacion';NO
RB4=0 O [SPREAD>=VAR('RSPREAD1') Y SPREAD<=VAR('RSPREAD2')];'El Spread Op.Asociada esta Fuera de Rango '~VAR('RSPREAD1')~' '~VAR('RSPREAD2');NO
RB4=0 O [PRECIO3<=VAR('RTASA2') Y PRECIO3>=VAR('RTASA1')];'Tasa Op.Asociada Fuera de Rango:'~VAR('RTASA1')~" Y "~VAR('RTASA2');SI;SI;FSYS;'RTASA'
PORCOMMER1<=VAR('RTASA2') Y PORCOMMER1>=VAR('RTASA1');'Tasa Flat Fuera de Rango:'~VAR('RTASA1')~" Y "~VAR('RTASA2');SI;SI;FSYS;'RTASA'
PRECIO1<=VAR('RTASA2') Y PRECIO1>=VAR('RTASA1');'Tasa Anual Fuera de Rango:'~VAR('RTASA1')~" Y "~VAR('RTASA2');SI;SI;FSYS;'RTASA'
FECHAOP2=Fsys;'La Fecha de Concertaci¦n no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
@CONDIOP

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador


@INSTOPE
@INST19GENE
@INST19BITS

