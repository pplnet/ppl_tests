CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp2        : 'Fecha Conc.'                ;1;1;;VERIFICAACCESO('OPFVALOR');;FECHAOP2<=FECHAOP;'Fecha incorrecta';NO;FSYS;
FechaOp         : 'Fecha_Orig.'                ;2;1;;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1);'Fecha de Origen Incorrecta';RB11 = 0;FSYS;
RB10            : 'PreCanc|Si|No'              ;;;;;NO;RB10>=0;'Precancelable Si/No';NO;1; 
RB6             : 'Prestamo|E.Local|E.Extr_N.Local|E.Extranjera'    ;;;;NOT EV y VACIO(OPERACIONREF);;NOVACIO(OPERACIONREF) O RB6>=0;'Indique Tipo de Caso de Prestamo';NO;;IF(VACIO(OPERACIONREF),RB6,OPREF.MB6)
@VEHITO
OperacionRef    : 'Id_Partida'                 ;;;;;;VACIO(OPERACIONREF) O [EqStr(BuscarCampo('Operaciones','TipoOp','NrOperacion',OPERACIONREF),'MMP')];BuscarCampo('Operaciones','TipoOp','NrOperacion',OPERACIONREF)~' El Codigo de Id. Partida es Incorrecto';NO;;;;
VCAN2           : 'VN_Disponible'              ;;;;NO;NOVACIO(OPERACIONREF);VACIO(OPERACIONREF) O VCAN2+VCAN1>0;'La Partida '~OPERACIONREF~' Fue Completamente Asignada';NO;;(OPREF.PRECIOEJ-OPREF.TOTALAUX3);;;;;'###,###,###,###,###.##'
Cliente1        : 'Ent_Contrat.'               ;5;1;;NOT EV y VACIO(OPERACIONREF);;NOVACIO(CLIENTE1); 'La Entidad Contratante es Invalida';NO;;IF(VACIO(OPERACIONREF),CLIENTE1,OPREF.CLIENTE1);;;;;;"Status = 'HAB'";;;;
Cliente2        : 'Ent_Negoc.'                 ;5;2;;NOT EV y VACIO(OPERACIONREF) Y RB6=1;RB6=1;;;;;IF(VACIO(OPERACIONREF),IF(RB6=1,CLIENTE2,""),OPREF.CLIENTE2);;;;;;"Status = 'HAB'";;;;
Especie         : 'Moneda'                     ;6;1;;NOT EV y VACIO(OPERACIONREF);;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'Debe Ingresar una Moneda';NO;;IF(VACIO(OPERACIONREF),ESPECIE,OPREF.ESPECIE);;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'"
Cantidad        : 'Capital'                    ;;;;NOT EV;;CANTIDAD>0 Y [VACIO(OPERACIONREF) O [[EQSTR(ABM,'A') Y CANTIDAD<=VCAN2] O [NOT EQSTR(ABM,'A') Y CANTIDAD<=(VCAN2+VCAN1)]]];'El Capital Es Incorrecto';NO;;IF(CANTIDADORI<>0,CANTIDADORI*COEFICIENTE,CANTIDADORI);;;;;'###,###,###,###,###.##'
Plazo           : 'Plazo'                      ;;;;OPREF.RB6<>1;;PLAZO>0;'Debe INGRESAR el PLAZO';NO;0;IF(NoVacio(OPERACIONREF),IF(OPREF.RB6=0,OPREF.CUOTAS1*OPREF.PLAZO2,FECHAVTO-FECHAOP),FECHAVTO-FECHAOP)
FechaVto        : 'Vto_Monto'                  ;;;;OPREF.RB6<>1;;;;;FECHAOP+PLAZO;IF(OPREF.RB6=1,OPREF.FECHAVTO2,IF(INCLUIDO(CAMPOMODIFICADO,'PLAZO|FECHAOP'),FECHAOP+PLAZO,FECHAVTO))
TipoTasa        : 'Tipo_Tasa'                  ;;;;VACIO(OPERACIONREF);;NOVACIO(TIPOTASA)       ;'El Tipo de Tasa ES INVALIDO';NO;'FIJA';IF(VACIO(OPERACIONREF),TIPOTASA,OPREF.TIPOTASA)
Precio1         : 'Tasa'                       ;11;1;;EQSTR(TIPOTASA,'FIJA');EQSTR(TIPOTASA,'FIJA');PRECIO1>=0;'La Tasa debe SER POSITIVA';NO;0;;;;;;;'###,###.######'
Spread          :                              ;11;2;;VACIO(OPERACIONREF) Y Not EQSTR(TIPOTASA,'FIJA');NOT EQSTR(TIPOTASA,'FIJA');SPREAD>=0;'El SPREAD Debe SER POSITIVO';NO;0;IF(VACIO(OPERACIONREF),IF(EQSTR(TIPOTASA,'FIJA'),0,SPREAD),OPREF.SPREAD)

RB16            : 'Setea|InicioPer|FinPer'     ;11;1;;;NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA);RB16=0 O RB16=1 O [EQSTR(TIPOTASA,'FIJA') o VACIO(TIPOTASA)];'Indique Inicio o Fin de Periodo';NO;
RB8             : 'Day Count|ActAct|Act365F|Act360|360360|30E360' ;12;;;VACIO(OPERACIONREF);;RB8>=0;'Unidad de Tiempo Tasa Interes INVALIDA';NO;2;IF(VACIO(OPERACIONREF),IF(MODI,RB8,0),OPREF.RB8)
MB2             : 'CDI Asoc|Si|No'             ;;;;NO;NO;MB2>=0;'CDI Asociada Invalida';NO;1;
NrOperacion2    : 'Op_Ref.'                    ;;;;;;;;;
TotalComisiones : 'Comision EF'                ;6;2;;NO;;;;;;CANTIDAD*VCAN10/100;;;;;'###,###,###,###,###.##'
PrecioEj        : 'V. Nominal'                 ;;2;;NO;;;;;;CANTIDAD+TOTALCOMISIONES;;;;;'###,###,###,###,###.##'
ImpGastos2      : 'Tasa_IVA'                   ;;;;VACIO(OPERACIONREF);;;;;VAR('TASAIVA');IF(Incluido(VEHICULO1,VAR('VEHIEXTRAN')),0,IF(VACIO(OPERACIONREF),IMPGASTOS2,OPREF.IMPGASTOS2));;;;;'###,###.######'
TablaFeriados1  : 'Feriados'                   ;;2;;VACIO(OPERACIONREF);;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;IF(VACIO(OPERACIONREF),BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE)),OPREF.TABLAFERIADOS1)
Plazo4          : 'Dias Seteo Tasa'            ;;;;;NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA);[PLAZO4>=0] O [EQSTR(TIPOTASA,'FIJA')];'Indique la Cantidad de Dias Previos al Inicio para Setear la Tasa';NO;;
TotalAux1       : 'Tasa WH'                    ;13;2;;VACIO(OPERACIONREF) Y RB6>=1;RB6>=1;RB6<1 O [RB6>=1 Y Incluido(Fstr(TotalAux1,2,4),VAR('TASAWH'))];'El Valor de TASA WH es Erroneo: '~VAR('TASAWH')~' ...';NO;;IF(VACIO(OPERACIONREF),TOTALAUX1,OPREF.TOTALAUX1);;;;;'###,###.######'
Operador        :                              ;;2;;NO;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
Observac2       : 'Op.Contraparte'             ;;2;;;;NOVACIO(OBSERVAC2);'El Operador CONTRAPARTE es INVALIDO';SI;;IF(VACIO(OPERACIONREF),OBSERVAC2,OPREF.OBSERVAC2);;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
Cuotas2         : 'Cuota FMat'                 ;;2;;OPREF.RB6=1;OPREF.RB6=1;OPREF.RB6<>1 o [CUOTAS2<=OPREF.CUOTAS1 y CUOTAS2>=1];'Debe INGRESAR la Cantidad DE PERIODOS Menor o Igual a los Periodos de la Partida '~Fstr(OPREF.CUOTAS1,0,0)~' ...';NO;1;;
Cuotas1         : 'Nr_Periodos'                ;;2;;VACIO(OPERACIONREF) O OPREF.RB6<0;;CUOTAS1>=1;'Debe INGRESAR la Cantidad DE PERIODOS';NO;;OPREF.CUOTAS1-IF(CUOTAS2>0,CUOTAS2-1,0);
VCAN1           : 'CantAnt'                    ;;;2;NO;NO;;;;;BuscarCampo('OPERACIONES','Cantidad+TotalComisiones','NrOperacion',NrOperacion)
CB10            : 'Pmo.|Local|Extranjero'      ;11;3;;NO;NO;;;;;IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),0,1)

Precio3         : 'Tasa_CEC'                   ;1;1;2;VACIO(OPERACIONREF) Y RB6=0;RB6=0;[RB6<>0 Y PRECIO3=0] O [RB6=0 Y PRECIO3>=0];'LA TASA CEC SE INGRESA SOLO EN EL CASO ELFE Y DEBE SER POSITIVA';NO;;IF(NOVACIO(OPERACIONREF),OPREF.PRECIO3,IF(RB6=0,PRECIO3,0))
MB1             : 'UT_CEC|360|365'             ;;;2;VACIO(OPERACIONREF) Y RB6=0;RB6=0;RB6<>0 O MB1 >=0 ;'NO INGRESO LA UNIDAD DE TIEMPO CEC';NO;0;IF(NOVACIO(OPERACIONREF),OPREF.MB1,MB1)

Precio2         : 'Tasa_CEN'                   ;;;2;VACIO(OPERACIONREF) Y RB6=1;RB6=1;RB6<>1 O PRECIO2>=0;'LA TASA CEN SOLO SE INGRESA EN EL CASO EE Y DEBE SER POSITIVA';NO;;IF(NOVACIO(OPERACIONREF),OPREF.PRECIO2,IF(RB6=1,PRECIO2,0))
MB3             : 'UT_CEN|360|365'             ;;;2;VACIO(OPERACIONREF) Y RB6=1;RB6=1;;;;0;
TasaImp1        : '% Imp.Interes'              ;;;2;VACIO(OPERACIONREF) Y RB6<>2;RB6<>2;RB6=2 O [Incluido(Fstr(TASAIMP1,2,4),VAR('TASAINT'))];'El Valor de TASA Impuesto  INTERES es Erroneo: '~VAR('TASAINT')~' ...';NO;IF(RB6<>2,VAR('DEFAINT'),0);IF(RB6<>2,OPREF.TASAIMP1,0);;;;;'###,###.######'
IntDevengados1  : '%_IVA_CEN'                  ;;;2;VACIO(OPERACIONREF) y RB6=1;RB6=1;;;;VAR('TASAIVA');IF(Incluido(VEHICULO1,VAR('VEHIEXTRAN')),0,IF(VACIO(OPERACIONREF),IF(RB6=1,IF(MODI,INTDEVENGADOS1,IMPGASTOS2),0),OPREF.INTDEVENGADOS1));;;;;'###,###.######'
DeltaTasa       : '%_Cs_Fin_CEC'               ;;;2;RB6=0;RB6=0;RB6<>0 O [Incluido(Fstr(DELTATASA,2,4),VAR('TASAINT'))];'El Valor de TASA Costo Financiero CEC Es Erroneo: '~VAR('TASAINT')~' ...';NO;VAR('DEFAINT');;;;;;'###,###.######'
VCAN10          : 'ComEF'                      ;;2;2;NO;NO;;;;;IF(NOVACIO(OPERACIONREF),QUERY(" Select Tasa1 from "~DBO~".COMISIONES2 where NrOperacion='"~OPERACIONREF~"' AND Tipo='5'"),SUM(COM2L,2,1,5));;;;;'###.########'
VPRE1           : 'UTEF'                       ;;2;2;NO;NO;;;;;IF(EQSTR(IF(NOVACIO(OPERACIONREF),QUERY("Select RB2 from "~DBO~".COMISIONES2 where NrOperacion='"~OPERACIONREF~"' "),Fstr(SUM(COM2L,12,1,5),1,0)),'0'),36000,36500)
RB3             : 'MOF'                        ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa         : 'Modificado'                 ;10;3;;NO;NO;;;;0
VPRE5           : 'Cot.ESP/USD'                ;10;3;;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
VPRE6           : 'Cot.CONTESP/USD'            ;10;3;;NO;NO;;;;;COTIZACIONC(CONTRAESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
Cotizacion1     : 'TC_Concert.'                ;12;1;2;;Not Eqstr(ESPECIE,VAR('MONEEXTR'));;;NO;;IF(Eqstr(ESPECIE,VAR('MONEEXTR')),1)
Cotizacion2     : 'TC_Vencim.'                 ;;;;COTIZACION2<>0;COTIZACION2<>0;;;;
VPRE9           : 'Cot.TC/USD'                 ;10;2; ;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(ESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)

RB11            : 'Ajuste|NO|SI'               ;1;2;2;;NO;;;;0;
PrecioMer       : 'Monto USD WF'               ;1;2;2;NO;NO;;;;PRECIOEJ*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'));PRECIOEJ*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))

VTXT18            : 'Book Def'    ; 1;2;2;NO;NO;;;;;BuscarCampo('VEHICULOS','Alias5','Codigo',VEHICULO1)
VTXT19            : 'Codigo Book' ; 2;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Codigo','Codigo',VTXT18)
