CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp2       : 'Fecha Conc.'             ; 1;1;1;VERIFICAACCESO('OPFVALOR');;FECHAOP2<=FECHAOP;'LA FECHA DE CONCERTACION DEBE SER <= A LA FECHA DE ORIGEN';NO;FSYS;
FechaOp        : 'Fecha_Origen'            ; 2;1; ;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1);'La Fecha de Origen no es Habil en la Tabla de Feriados Seleccionada';RB11 = 0;FSYS;
FechaPago      : 'OrigenCedente'           ;14;1; ;NO;NOVACIO(FECHAPAGO);
RB10           : 'Precancelable|Si|No'     ;18;1; ;  ;NO;RB10>=0;'Precancelable Si/No';NO;1; 
@VEHITO
OperacionRef   : 'Id_Partida'              ;3;2;;NO;NO;VACIO(OPERACIONREF) O [EqStr(BuscarCampo('Operaciones','TipoOp','NrOperacion',OPERACIONREF),'MMP')];'El Codigo de Id. Partida es Incorrecto';SI;;;;

Cuotas2        : 'Cuota FMat'              ;  ;2; ;OPREF.RB6=1;OPREF.RB6=1;OPREF.RB6<>1 o [CUOTAS2<=OPREF.CUOTAS1 y CUOTAS2>=1];'Debe INGRESAR la Cantidad DE PERIODOS Menor o Igual a los Periodos de la Partida '~Fstr(OPREF.CUOTAS1,0,0)~' ...';NO;1;;
Cuotas1        : 'Nr_Periodos'             ; 7;2; ;VACIO(OPERACIONREF) O OPREF.RB6<0;;CUOTAS1>=1;'Debe INGRESAR la Cantidad DE PERIODOS';NO;;OPREF.CUOTAS1-IF(CUOTAS2>0,CUOTAS2-1,0);
ImpGastos2     : 'Tasa_IVA'                ; 8;2; ;VACIO(OPERACIONREF);RB6<=2;;;;VAR('TASAIVA');IF(Incluido(VEHICULO1,VAR('VEHIEXTRAN')),0,IF(VACIO(OPERACIONREF),IF(RB6<=2,IMPGASTOS2,0),OPREF.IMPGASTOS2));;;;;'###,###.######'
TasaImp1       : '% Imp.Interes'           ; 9;2; ;VACIO(OPERACIONREF);;;;;VAR('DEFAINT');if(VACIO(OPERACIONREF),IF((VAR('DEFAINT')*TOTALINTERESES/100)>((PRECIOEJ*(VAR('TASAIMPINT')/100)*PLAZO)/365),((100*IMPORTEIMP)/TOTALINTERESES),VAR('DEFAINT')),OPREF.TASAIMP1);;;;;'###,###.######'
RB16           : 'Setea|InicioPer|FinPer';10;2;;;NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA) ;RB16=0 O RB16=1 O [EQSTR(TIPOTASA,'FIJA') o VACIO(TIPOTASA)];'Indique Inicio o Fin de Periodo';NO;;;
Plazo4         : 'Dias Seteo Tasa'         ;11;2; ;  ;NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA);[PLAZO4>=0] O [EQSTR(TIPOTASA,'FIJA')];'Indique la Cantidad de Dias Previos al Vto para Setear la Tasa';NO;;
RB6            : 'Fondeo|Local|Extranjero' ;12;2; ;VACIO(OPERACIONREF);NO;RB6>=0;'Indique Tipo de Caso';NO;0;IF(VACIO(OPERACIONREF),RB6,OPREF.MB5);
Cliente1       : 'Ent_Contratante'         ; 4;1; ;NOT EV y VACIO(OPERACIONREF);;NOVACIO(CLIENTE1); 'La Entidad Contratante es Invalida';NO;;IF(VACIO(OPERACIONREF),CLIENTE1,OPREF.CLIENTE1);;;;;;"Status = 'HAB'";;;;
ContraEspecie  : 'Moneda'                  ; 4;2; ;NOT EV y VACIO(OPERACIONREF);;NOVACIO(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE, ESPECIE);'Debe Ingresar una Moneda';NO; ; COTIZAEN(ESPECIE) ;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'"
Especie        : 'Especie'                 ; 5;1; ;NOT EV y VACIO(OPERACIONREF);;NOVACIO(ESPECIE) Y ESTERMINAL(ESPECIE, ESPECIE) Y [DESCIENDEDEESPECIE(ESPECIE,'TITULO') O DESCIENDEDEESPECIE(ESPECIE,'FONDOS')];'Especie Invalida' ;NO;;IF(VACIO(OPERACIONREF),ESPECIE,OPREF.ESPECIE);;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','TITULO' ))~','~Pipe2Comillas(Descendientes('ESPECIES','FONDOS' ))~") and Status = 'HAB'"
Precio1        : 'Precio'                  ; 5;2; ;NO;;PRECIO1 > 0;'Ingresar Precio mayor a Cero';NO; ;CotizacionC(ESPECIE, 'CON',,,FECHAOP,1,SI,CONTRAESPECIE);;;;;'######.########'

Cantidad       : 'Capital'                 ; 6;1; ;NOT EV;;CANTIDAD>0 Y [VACIO(OPERACIONREF) O [[EQSTR(ABM,'A') Y CANTIDAD<=VCAN2] O [NOT EQSTR(ABM,'A') Y CANTIDAD<=(VCAN2+VCAN1)]]];'El Capital DEBE SER INFERIOR AL Valor Total de la Op.Referencia';NO;;IF(CANTIDADORI<>0,CANTIDADORI*COEFICIENTE,CANTIDADORI);;;;;'###,###,###,###,###.##'
TotalBrutoCli1 : 'Total Moneda'            ; 6;2; ;NO;;;;;;PRECIOEJ*PRECIO1
FechaVto       : 'Vto_Monto'               ; 8;1; ;OPREF.RB6<>1;;ESHABIL(FECHAVTO,TABLAFERIADOS1);'La Fecha de Vencimiento del Monto NO ES DIA HABIL';RB11 = 0;FECHAOP+PLAZO;IF(OPREF.RB6=1,OPREF.FECHAVTO2,IF(INCLUIDO(CAMPOMODIFICADO,'PLAZO|FECHAOP'),FECHAOP+PLAZO,FECHAVTO))
Plazo          : 'Plazo'                   ; 7;1; ;OPREF.RB6<>1;;PLAZO>0;'Debe INGRESAR el PLAZO';NO;0;IF(NoVacio(OPERACIONREF),IF(OPREF.RB6=0,OPREF.CUOTAS1*OPREF.PLAZO2,FECHAVTO-FECHAOP),FECHAVTO-FECHAOP)
TipoTasa       : 'Tipo_Tasa'               ; 9;1; ;VACIO(OPERACIONREF);;NOVACIO(TIPOTASA);'El Tipo de Tasa ES INVALIDO';NO;;IF(VACIO(OPERACIONREF),TIPOTASA,OPREF.TIPOTASA)
TotalComisiones: 'Comision EF'             ;10;1; ;NO;;;;;;CANTIDAD*VCAN10/100;;;;;'###,###,###,###,###.##'
PrecioEj       : 'V. Nominal'              ;11;1; ;NO;;;;;;CANTIDAD+TOTALCOMISIONES;;;;;'###,###,###,###,###.##'
RB8            : 'Day Count|ActAct|Act365F|Act360|360360|30E360';12;1; ;VACIO(OPERACIONREF);;RB8>=0;'Unidad de Tiempo Tasa Interes INVALIDA';NO;0;IF(VACIO(OPERACIONREF),IF(MODI,RB8,1),OPREF.RB8)
Observac2      : 'Op.Contraparte'          ;14;1; ;;;NOVACIO(OBSERVAC2);'El Operador CONTRAPARTE es INVALIDO';SI;;IF(VACIO(OPERACIONREF),OBSERVAC2,OPREF.OBSERVAC2)
Operador       :                           ;;1; ;NO;  ;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
PlazoGracia    : 'Plazo_Gracia'            ;15;2; ;NO;NO;PLAZOGRACIA>0 Y PLAZOGRACIA<=CUOTAS1;'Plazo de Gracia >=1 y <= '~CUOTAS1;NO;1;
NrOperacion2   : 'Op.Cedente'              ;16;2; ;NO;NoVacio(NROPERACION2);;
VCAN2          : 'VN_Disponible'           ;18;2; ;NO;NOVACIO(OPERACIONREF);VACIO(OPERACIONREF) O VCAN2+VCAN1>0;'La Partida '~OPERACIONREF~' Fue Completamente Asignada';NO;;(OPREF.PRECIOEJ-OPREF.TOTALAUX3)
TablaFeriados1 : 'Feriados'                ;17;1; ;VACIO(OPERACIONREF);;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;IF(VACIO(OPERACIONREF),IF(MODI,TABLAFERIADOS1,BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE))),OPREF.TABLAFERIADOS1)
CB10           : 'Pmo.|Local|Extranjero'   ;16;3; ;NO;NO;CB10=0;'ENTIDAD CONTRATANTE Y VEHICULO DEBEN SER DEL MISMO PAIS';NO;;IF(EQSTR(BuscarCampo('Clientes','PaisDir','Codigo',VEHICULO1),BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),0,1)
VCAN17         : 'Cuotas c/Afec'           ;20;1;1;NO;NO;;;;0;QUERY("Select Count(*) from "~DBO~".CUOTAS where NrOperacion='"~NROPERACION~"' and Check9=1 ")

Precio3        : 'Tasa_CEC'                ; 1;1;2;RB6=1;RB6=1;RB6=0 O PRECIO3>=0;'LA TASA CEC SE INGRESA EN EL FONDEO EXTRANJERO Y DEBE SER POSITIVA';NO;;IF(RB6=1,PRECIO3,0)
MB1            : 'UT_CEC|360|365'          ; 2;1;2;RB6=1;RB6=1;;;;0;
DeltaTasa      : '%_Cs_Fin_CEC'            ;  ; ;2;RB6=1;RB6=1;RB6<>1 O [Incluido(Fstr(DELTATASA,2,4),VAR('TASAINT'))];'El Valor de TASA Costo Financiero CEC Es Erroneo: '~VAR('TASAINT')~' ...';NO;VAR('DEFAINT');;;;;;'###,###.######'
VCAN1          : 'CantAnt'                 ;  ; ;2;NO;NO;;;;;BuscarCampo('OPERACIONES','Cantidad+TotalComisiones','NrOperacion',NrOperacion)
VCAN10         : 'ComEF'                   ;  ;2;2;NO;NO;;;;;IF(NOVACIO(OPERACIONREF),QUERY(" Select Tasa1 from "~DBO~".COMISIONES2 where NrOperacion='"~OPERACIONREF~"' AND Tipo='5'"),SUM(COM2L,2,1,5));;;;;'###.########'
VPRE1          : 'UTEF'                    ;  ;2;2;NO;NO;;;;;IF(EQSTR(IF(NOVACIO(OPERACIONREF),QUERY("Select RB2 from "~DBO~".COMISIONES2 where NrOperacion='"~OPERACIONREF~"' "),Fstr(SUM(COM2L,12,1,5),1,0)),'0'),36000,36500)
RB3            : 'MOF'                     ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa        : 'Modificado'              ;10;3;;NO;NO;;;;0
TotalIntereses : 'Total Imp.Interes'       ;14;2; ;NO;NO;;;;SUM(CUOTASL,17);SUM(CUOTASL,17)
ImporteImp     : 'Importe Interes'         ;  ; ; ;NO;NO;;;;SUM(CUOTASL,19);SUM(CUOTASL,19)
RB11           : 'Ajuste|NO|SI'            ; 1;2;2;;NO;;;;0;
PrecioMer      : 'Monto USD WF'            ; 1;2;2;NO;NO;;;;PRECIOEJ*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'));PRECIOEJ*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))
MB3            : 'Tipo|Prestamo|Colocacion';17;2;1;NOT EV;;MB3>=0;'Indique Prestamo o Colocacion';NO;;

VTXT13         : 'Cupon Anterior'          ; 9;2;2;NO;NO;;;;IF(EqStr(VTXT14,'0'),'0',FStr(NrCupon2(ESPECIE,FECHAVTO)-1,0,0));IF(EqStr(VTXT14,'0'),'0',FStr(NrCupon2(ESPECIE,FECHAVTO)-1,0,0));;;;;'XXX';
VTXT14         : 'Cupon Actual'            ;10;2;2;NO;NO;;;;FStr(NrCupon2(ESPECIE,FECHAVTO),0,0);FStr(NrCupon2(ESPECIE,FECHAVTO),0,0);;;;;'XXX';
RB9            : 'ExCupon|Si|No'           ; 9;1;2;;DESCIENDEDEESPECIE(ESPECIE,'TITULO');;;;1
Cupon1         : 'Cupon'                   ;10;1;2;RB9=0;DESCIENDEDEESPECIE(ESPECIE,'TITULO');[RB9=0 y EqStr(CUPON1,VTXT13)] o RB9=1 ;'Cupon Incorrecto';NO;IF(DESCIENDEDEESPECIE(ESPECIE,'TITULO'),IF(RB9=0,VTXT13,VTXT14));IF(DESCIENDEDEESPECIE(ESPECIE,'TITULO'),IF(RB9=0,VTXT13,VTXT14));;;;;'###'

