CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
MB3          :'Tipo|Ctas.Propias|Intercompany'  ;;;;NO;;MB3 >= 0;'Tipo De Transferencia Invalida';NO;0;
Vehiculo2    :'a Vehiculo'                      ;2;1;;;MB3=1;MB3<>1 o [Not Eqstr(VEHICULO2,VEHICULO1) Y Incluido(VEHICULO1,SqlSet("Select Codigo from "~DBO~".VEHICULOS WHERE Codigo = '"~Vehiculo1~"' and Status ='HAB' "))];'Vehiculo Destino Invalido';NO;;;;;;;;"Status ='HAB' ";
Vehiculo1    :'Vehiculo'                        ;3;1;;;;NoVacio(VEHICULO1) Y Incluido(VEHICULO1,SqlSet("Select Codigo from "~DBO~".VEHICULOS WHERE Codigo = '"~Vehiculo1~"' and Status ='HAB' "));'Vehiculo invalido';NO;BuscarCampo('USRVEHICULO','Vehiculo','Codigo',USUARIOACTIVO);;;;;;;"Status ='HAB' ";
FechaOp      :'Fecha'                           ;2;2;;VerificaAcceso('OPFVALOR');;FECHAOP<=FSYS y EsHabil(FECHAOP,'ARG');'Fecha invalida';NO;FSYS
FechaVto     :'Fecha Acredit'                   ;3;2;;;;EsHabil(FECHAVTO,'ARG');'Fecha de Acreditacion Invalida';NO;FSYS;
Especie      :'Moneda'                          ;4;1;;;;NoVacio(ESPECIE) y DesciendeDeEspecie(ESPECIE,'MONEDA') y EsTerminal(ESPECIE,Especie);'Moneda invalida';NO;;;;;;;;"Status = 'HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','MONEDA')~"%' ";
Cantidad     :'Cantidad'                        ;5;1;;;;CANTIDAD>0 ;'Cantidad Invalida';NO
TotalGastos  :'Gastos'                          ;5;2;1;NO;NO;TOTALGASTOS>=0 ;'Gastos Invalidos';NO
Cliente1     :'Entidad Origen'                  ;7;1;;;;[Eqstr(BuscarCampo('CUENTAS','Comitente','Codigo', CUENTA1), CLIENTE1) y Eqstr(BuscarCampo('CLIENTES','Status','Codigo',CLIENTE1), 'HAB')];'Entidad Origen invalido';NO;;BuscarCampo('CUENTAS','Comitente','Codigo',CUENTA1);;;;;;"CategDepositante IN ('BAN','ALY','ABO','BRO') AND Status='HAB' "
Cuenta1      :'De Cuenta'                       ;8;1;;;;Eqstr(BuscarCampo('CUENTAS','Comitente','Codigo',CUENTA1), CLIENTE1);'Cuenta Origen invalida';NO;;QUERY("Select Codigo from "~DBO~".CUENTAS where Cliente='"~VEHICULO1~"' and Estado='HAB' and Comitente='"~CLIENTE1~"' AND (Especies LIKE '%"~ESPECIE~"%' or Especies LIKE '%MONEDA%') ");;;;;;IF(NoVacio(CLIENTE1), "Cliente='"~VEHICULO1~"' and Estado='HAB' and (Especies LIKE '%"~ESPECIE~"%' or Especies LIKE '%MONEDA%') AND Comitente = '"~CLIENTE1~"' ", "Cliente='"~VEHICULO1~"' and Estado='HAB' and (Especies LIKE '%"~ESPECIE~"%' or Especies LIKE '%MONEDA%')") 
Cliente2     :'Entidad Destino'                 ;7;2;;;;[Eqstr(BuscarCampo('CUENTAS','Comitente','Codigo', CUENTA2), CLIENTE2) y Eqstr(BuscarCampo('CLIENTES','Status','Codigo',CLIENTE2), 'HAB')];'Entidad Destino invalido';NO;;BuscarCampo('CUENTAS','Comitente','Codigo',CUENTA2);;;;;;"CategDepositante IN ('BAN','ALY','ABO','BRO') AND Status='HAB' "
Cuenta2      :'A Cuenta'                        ;8;2;;;;Eqstr(BuscarCampo('CUENTAS','Comitente','Codigo',CUENTA2), CLIENTE2);'Cuenta Destino Invalida';NO;;QUERY("select Codigo from "~DBO~".CUENTAS where Cliente='"~IF(MB3=1,VEHICULO2,VEHICULO1)~"' and Estado='HAB' and Comitente='"~CLIENTE2~"' AND (Especies LIKE '%"~ESPECIE~"%' or Especies LIKE '%MONEDA%') ");;;;;;IF(NoVacio(CLIENTE2), "Cliente='"~IF(MB3=1,VEHICULO2,VEHICULO1)~"' and Estado='HAB' and (Especies LIKE '%"~ESPECIE~"%' or Especies LIKE '%MONEDA%') AND Comitente = '"~CLIENTE2~"' " , "Cliente='"~IF(MB3=1,VEHICULO2,VEHICULO1)~"' and Estado='HAB' and (Especies LIKE '%"~ESPECIE~"%' or Especies LIKE '%MONEDA%') ") 
Operador     :                                  ;;1;;NO;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
PrecioMer    : 'Monto USD WF'                   ;10;2;2;NO;NO;;;;;CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'));
VTXT40       : 'Moneda Loc. Veh.'               ;11;2;;NO;NO;NoVacio(VTXT40);'No se ha especificado moneda local para el vehiculo '~VEHICULO1;NO;;BuscarCampo('VEHICULOS', 'Alias4', 'Codigo', VEHICULO1);
Sector2      : 'Perfil'                         ;16;2;2;NO;NO;;;;BuscarCampo('USUARIOS','Perfiles','Codigo',USUARIOACTIVO);BuscarCampo('USUARIOS','Perfiles','Codigo',USUARIOACTIVO);

CONDICIONES
Incluido(VEHICULO1, UsrVehiculos(USUARIOACTIVO))  o VACIO(UsrVehiculos(USUARIOACTIVO)); 'El usuario activo no esta habilitado para operar con el vehiculo '~VEHICULO1;NO
Vacio(VEHICULO2) O Incluido(VEHICULO2, UsrVehiculos(USUARIOACTIVO))  o VACIO(UsrVehiculos(USUARIOACTIVO)); 'El usuario activo no esta habilitado para operar con el vehiculo '~VEHICULO2;NO
EspecieCuenta(ESPECIE, CUENTA1) O VACIO(CUENTA1);'La Moneda No Corresponde con la Cuenta Origen';NO
ClienteCuenta(VEHICULO1, CUENTA1) o VACIO(CUENTA1);'La Cuenta Origen no corresponde al Vehiculo';SI
EspecieCuenta(ESPECIE, CUENTA2) o VACIO(CUENTA2);'La Moneda No Corresponde con la Cuenta Destino';NO
MB3<>1 o ClienteCuenta(VEHICULO2, CUENTA2) o VACIO(CUENTA2);'La Cuenta Destino no corresponde al Vehiculo '~VEHICULO2;SI
MB3<>0 o ClienteCuenta(VEHICULO1, CUENTA2) o VACIO(CUENTA2);'La Cuenta Destino no corresponde al Vehiculo '~VEHICULO1;SI
SI O SaldoC(Vehiculo1,Especie,,,,,,Cuenta1,1,FSYS)>=CANTIDAD;'Cantidad a transferir es superior al saldo en la cuenta origen.';SI

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador


MOVIMIENTOS
FechaVto;Cliente1;Especie;;;;;Vehiculo1 ;1; Cantidad;;'Transferencia de '~Especie;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;1;
FechaVto;Cliente1;Especie;;;;;Vehiculo1 ;1; TotalGastos;;'Gastos por Transferencia de '~Especie;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;2;

FechaVto;Cliente2;Especie;;;;;Vehiculo1 ;1;  -Cantidad;;'Transferencia de '~Especie;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;MB3=0;;Cuenta2;;3;
FechaVto;Cliente2;Especie;;;;;Vehiculo2 ;1;  -Cantidad;;'Transferencia de '~Especie;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;MB3=1;;Cuenta2;;3;

FechaVto ;Vehiculo1;Especie;;;;;Vehiculo1;50;-Cantidad;;'Transferencia de '~ESPECIE;SI;SI;;Incluido(BuscarCampo('CUENTAS','TipoCuenta','Codigo', Cuenta1), 'CUS|INV') Y FechaVto>=Fecha(Var('FECHAMIGRA'));;Cuenta1;;10;;;;;;;;;;;;;;
FechaVto ;Vehiculo1;Especie;;;;;Vehiculo1;50;Cantidad;;'Transferencia de '~ESPECIE;SI;SI;;Incluido(BuscarCampo('CUENTAS','TipoCuenta','Codigo', Cuenta2), 'CUS|INV') Y FechaVto>=Fecha(Var('FECHAMIGRA'));;Cuenta2;;11;;;;;;;;;;;;;;

POSTEDICION
%%ifdef BFSA
    SI;'DETRIE';TipoOp = TIPOOP;Especie1=CONTRAESPECIE;Cantidad1=TOTALNETOCLI1;Book1=BOOK1;NrOperacion=NROPERACION;Fecha1=FechaOp
%%endif


@INSTOPE
INSTANCIA19
CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1);FW=1
MB3          :'Tipo|Ctas.Propias|Intercompany'  ;;;;NO;;;;;;
Vehiculo2    :'a Vehiculo'                      ;2;1;;NO;MB3=1;;;;;;;;;;;
Vehiculo1    :'Vehiculo'                        ;3;1;;NO;;;;;;;;;;;;;
FechaOp      :'Fecha'                           ;2;2;;NO;;;;
FechaVto     :'Fecha Acredit'                   ;3;2;;NO;;;;;;
Especie      :'Moneda'                          ;4;1;;NO;;;;;;;;;;;;;
Cantidad     :'Cantidad'                        ;5;1;;NO;;;;
TotalGastos  :'Gastos'                          ;5;2;1;NO;NO;;;;;
Cliente1     :'Entidad Origen'                  ;7;1;;NO;;;;;;;;;;;;
Cuenta1      :'De Cuenta'                       ;8;1;;;;Eqstr(BuscarCampo('CUENTAS','Comitente','Codigo',CUENTA1), CLIENTE1);'Cuenta Origen invalida';NO;CUENTA1;QUERY("select Codigo from "~DBO~".CUENTAS where Cliente='"~VEHICULO1~"' and Estado='HAB' and Comitente='"~CLIENTE1~"' AND (Especies LIKE '%"~ESPECIE~"%' or Especies LIKE '%MONEDA%') ");;;;;;IF(NoVacio(CLIENTE1), "Cliente='"~VEHICULO1~"' and Estado='HAB' and (Especies LIKE '%"~ESPECIE~"%' or Especies LIKE '%MONEDA%') AND Comitente = '"~CLIENTE1~"' ", "Cliente='"~VEHICULO1~"' and Estado='HAB' and (Especies LIKE '%"~ESPECIE~"%' or Especies LIKE '%MONEDA%')") 
Cliente2     :'Entidad Destino'                 ;7;2;;NO;;;;;;;;;;;;"CategDepositante IN ('BAN','ALY','ABO','BRO') AND Status='HAB' "
Cuenta2      :'A Cuenta'                        ;8;2;;;;Eqstr(BuscarCampo('CUENTAS','Comitente','Codigo',CUENTA2), CLIENTE2);'Cuenta Destino Invalida';NO;CUENTA2;QUERY("select Codigo from "~DBO~".CUENTAS where Cliente='"~IF(MB3=1,VEHICULO2,VEHICULO1)~"' and Estado='HAB' and Comitente='"~CLIENTE2~"' AND (Especies LIKE '%"~ESPECIE~"%' or Especies LIKE '%MONEDA%') ");;;;;;IF(NoVacio(CLIENTE2), "Cliente='"~IF(MB3=1,VEHICULO2,VEHICULO1)~"' and Estado='HAB' and (Especies LIKE '%"~ESPECIE~"%' or Especies LIKE '%MONEDA%') AND Comitente = '"~CLIENTE2~"' " , "Cliente='"~IF(MB3=1,VEHICULO2,VEHICULO1)~"' and Estado='HAB' and (Especies LIKE '%"~ESPECIE~"%' or Especies LIKE '%MONEDA%') ") 
Operador     :                                  ;;1;;NO;;;;;USUARIOACTIVO;


POSTEDICION
@POSTERENT
FW=1;'ACTI19';NrOperacion1=NROPERACION
