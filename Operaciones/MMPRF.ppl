CAMPOS:1;;;FW=2
Observac2   : 'Obs.Anulacion' ;2;1;;;FW=2;;;;

POSTEDICION
FW=2; 'DESAFE'; NrOperacion1 = NrOperacion
FW=1 y NoVacio(Cliente1) y FechaOp <= Fsys y FechaOp2 < FechaOp; 'EJECON'; NrOperacion1 = NrOperacion

BITS
1;0;FW=1 y NoVacio(Cliente1) y FechaOp <= Fsys
12;1;FW=1 y NoVacio(Cliente1) y FechaOp <= Fsys
1;0;FW=2
30;1;FW=2

INSTANCIA2
CAMPOS:1;;;FW=2
Observac2   : 'Obs.Anulacion' ;2;1;;;FW=2;;;;

POSTEDICION
FW=2; 'DESAFE'; NrOperacion1 = NrOperacion

