CAMPOS:1;;IF(EqStr(Vehiculo1,'BKB'),1,IF(EqStr(Vehiculo1,'BS'),101,201))
OperacionRef   : 'Set Like'       ;1;1; ;  ;  ;Vacio(OPERACIONREF) o EqStr(OPREF.TIPOOP,'MMPRF');'La Operacion de Referencia No es un Prestamo Sistema Frances';NO;;;;;;;;"TipoOp = 'MMPRF' and FechaOp2 = '"~IdxDate(Fsys)~"' "
Especie       : 'Moneda'          ;3;1; ;  ;  ;NoVacio(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'Debe Ingresar una Moneda Valida';NO;;;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'"
Cliente1       : 'Ent_Contratante';4;1; ;NOT EV y VACIO(OPERACIONREF);;NOVACIO(CLIENTE1); 'La Entidad Contratante es Invalida';NO;;IF(VACIO(OPERACIONREF),CLIENTE1,OPREF.CLIENTE1);;;;;;"Status = 'HAB'";;;;
Cantidad       : 'Cantidad'       ; ; ; ;  ;  ;CANTIDAD>0;'La Cantidad debe ser Positiva';NO;;IF(VACIO(OPERACIONREF) o Incluido(ABM,'E'),CANTIDAD,OPREF.CANTIDAD);;;;;'####,###,###,###.##'

FechaOp2       : 'Fecha Origen'   ;1;2; ;NO;  ;;;;FSYS;
FechaOp        : 'Fecha Conc.'    ; ;2; ;VerificaAcceso('OPFVALOR');  ;EsHabil(FECHAOP,'ARG');'Fecha Conc.Incorrecta';NO;FSYS;
Plazo          : 'Plazo'          ; ;2; ;  ;  ;PLAZO>0 y PLAZO<29372;'El Plazo debe ser > 0 y < 29372';NO;365;IF(VACIO(OPERACIONREF) o EqStr(CAMPOEDITADO,'FechaVto') o EqStr(CAMPOEDITADO,'FechaOp') o Incluido(ABM,'E'),IF(EqStr(CAMPOEDITADO,'FechaOp'),PLAZO,FECHAVTO-FECHAOP),OPREF.PLAZO);
FechaVto       : 'Fecha Vto.'     ;5;2; ;  ;  ;ESHABIL(FECHAVTO,'ARG');'No es un Dia Habil';NO;FECHAOP+PLAZO;FECHAOP+PLAZO;

MB1            : 'Periodo|Libre|Mensual|Bimestral|Trimestral|Semestral' ;7;1;;;;;;;1;IF(VACIO(OPERACIONREF) o Incluido(ABM,'E'),MB1,OPREF.MB1)
PeriodoInts    : 'Periodo Ints.'  ;8;1; ;;;PERIODOINTS<=PLAZO;'La Periodicidad debe ser Menor o Igual al Plazo';NO;30;IF(NOVACIO(OPERACIONREF) y [Not EqStr(CAMPOEDITADO,'MB1')] y [Not EqStr(CAMPOEDITADO,'Plazo')] y [Not EqStr(CAMPOEDITADO,'FechaVto')],OPREF.PERIODOINTS,IF(EqStr(CAMPOEDITADO,'MB1') o MB1<>0 o [Incluido(ABM,'E') y [Not EqStr(CAMPOEDITADO,'Plazo')] y [Not EqStr(CAMPOEDITADO,'FechaVto')]],IF(MB1=0,PERIODOINTS,IF(MB1=1,30,IF(MB1=2,60,IF(MB1=3,90,180)))),PLAZO));
Cuotas1        : 'Cuotas'         ;8;2; ;NO;;;;;;IF(((PLAZO MOD PERIODOINTS)/PERIODOINTS)>=0.5,(PLAZO DIV PERIODOINTS)+1,PLAZO DIV PERIODOINTS)
MB4            : 'Corr.Liq.|Sig.Habil|Ant.Habil|Sig.Modi.|Ant.Modi.'    ;9;1;;;CUOTAS1<>1;;;;0;IF(VACIO(OPERACIONREF) o Incluido(ABM,'E'),MB4,OPREF.MB4)
DiasAnio       : 'A#o Base'      ;10;1; ;NO;;;;;0;
DiasMes        : 'Mes Base'      ;10;2; ;NO;;;;;0;
Precio1        : 'Tasa N.A.'     ;11;1; ;;;PRECIO1>=0; 'La Tasa No puede ser Negativa';NO;;IF(VACIO(OPERACIONREF) o Incluido(ABM,'E'),PRECIO1,OPREF.PRECIO1);;;;;'####.########'
Precio4        : 'T.Transf.'     ;12;1; ;  ;  ;PRECIO4>0;'La Tasa de Transferencia es Nula';SI;;;;;;;'####.########'
VPRE9          : 'NII'           ;12;2; ;NO;  ;;;;;PRECIO1-PRECIO4

VPRE5          : 'VPRE5'         ;19;1; ;NO;NO;;;;;(PERIODOINTS - 30)
VPRE6          : 'VPRE6'         ;19;2; ;NO;NO;;;;;(PERIODOINTS DIV 30)

Book1          : 'Book'          ;16;1; ;;;
Operador       :                 ;15;2; ;NO;  ;;;;USUARIOACTIVO;
Vehiculo1      : 'Vehiculo '     ;16;2; ;  ;  ;NoVacio(VEHICULO1);'Debe Ingresar el Vehiculo';NO;'BKB'

NrOperacion3   : 'Renueva Op.'    ;2;2;2;NO;
NrOperacion2   : 'Acuerdo'        ;3;2;2;NO;

CB9            : 'Pre-Cancelada'  ;5;2;2;NO;
FechaPrecan    : 'F.Original'     ;6;2;2;NO;CB9=1;
TasaPrecan     : 'TNA Original'   ;7;2;2;NO;CB9=1;
VCAN2          : 'Plazo Ori.'     ;8;2;2;NO;CB9=1;;;;;FECHAPRECAN-FECHAOP;;;;;'####'
VCAN4          : 'Plazo Rem.'     ;9;2;2;NO;CB9=1;;;;;FECHAPRECAN-FECHAVTO;;;;;'####'
TotalAux3      : 'Int. Original' ;10;2;2;NO;CB9=1;;;;;

MB5            : 'Modo|S/Interes|S/Capital|Fijo';11;2;2;NO;CB9=1;
PorArancel     : 'Penalty Fee'   ;12;2;2;NO;CB9=1;
TotalAux2      : 'Monto'         ;13;2;2;NO;CB9=1;

Cliente5       : 'Grupo Ec.'      ;6;1;2;NO;;;;;;QUERY("Select Controlante from "~DBO~".GRUPOSECONOMICOS where TipoGrupo = 'LC' and Cliente = '"~CLIENTE1~"' ")
Cotizacion1    : 'Tipo Cambio'    ; ; ;2;NO;;;;;;CotizacionC(ESPECIE,,,,FSYS,1,SI,'USD')
TotalAux1      : 'Afecta USD'     ; ; ;2;NO;;;;;;CANTIDAD*COTIZACION1

Observac2      : 'Obs.Anulacion' ;12;1;2;NO;INSTANCIA=30;;;;
Mercado4       : 'Area'          ;13;1;2;NO;;;;;;BuscarCampo('Clientes','TipoCliente','Codigo',CLIENTE1)

VTXT1          : 'Cond.IVA'      ;13;3;2;NO;NO;;;;;BuscarCampo('CLIENTES','CondicionIVA','Codigo',CLIENTE1);
PorCaucion     : 'Por.IVA'       ;14;1;2;NO;NO;;;;;IF(Incluido(VTXT1,'INS|RES'),Var('IVAMINIMO'),Var('IVA'));;;;;'###,###.##'
PorImpuestoBolsa:'Por.Percepcion';14;2;2;NO;NO;;;;;IF(Incluido(VTXT1,'INS'),Var('RG3337'),IF(Incluido(VTXT1,'NOI'),Var('RNI'),IF(Incluido(VTXT1,'NOC'),Var('IVANOCATEG'),0)));;;;;'###,###.##'
VTXT2          : 'Persona Fis.'  ;16;3;1;NO;NO;;;;;BuscarCampo('CLIENTES','Persona','Codigo',CLIENTE1);
PorDerechoBolsa: 'Por.Endeuda.'  ;16;1;2;NO;NO;;;;;IF(EqStr(VTXT2,'SI'),0,Var('IMPENDEU'));;;;;'###,###.##'
TotalBrutoCli3 : 'Tot.Intereses' ;  ; ;2;NO;NO;;;;;Sum(CUOTASL,9)+CUOTAS1-CUOTAS1;NO

ContraEspecie  :                  ;1;3;2;NO;NO;;;;;COTIZAEN(ESPECIE);
Cliente2       :                  ; ;3;2;NO;NO;;;;;CLIENTE1

TotalCaucion   : 'Monto Op.'      ; ; ;2;NO;NO;;;;;
VCAN1          : 'T.Mens.'       ;18;1;2;NO;NO;;;;;ROUND(Var('TASAENDEU')*PERIODOINTS/(DIASA(DIASANIO,FECHAVTO)*100),5);;;;;'###.#####'
VCAN3          : 'Cuota'          ; ; ;2;NO;NO;;;;;CANTIDAD*VCAN1/(1-(1/((1+VCAN1)^CUOTAS1)));;;;;

LISTA: SI; CUOTAS1+PRECIO1-PRECIO1;
  Fecha1   : 'F.Origen'     ;NO;  ;;;;IF(Fila=1,FECHAOP,CUOTASL.FECHA2[Fila-1]);90;;Fecha
  Fecha4   : 'F.Vto4'       ;NO;NO;;;;IF(Fila=CUOTAS1,FECHAVTO,FinDeMes(CUOTASL.FECHA1[Fila]+VPRE5,SI)+Dia(FechaOp));90;;Fecha
  Fecha5   : 'F.Vto5'       ;NO;NO;;;;IF(Fila=CUOTAS1,FECHAVTO,IF([[Mes(CUOTASL.FECHA4[Fila]) >= Mes(CUOTASL.FECHA1[Fila])] y [(Mes(CUOTASL.FECHA4[Fila])-Mes(CUOTASL.FECHA1[Fila]))<>VPRE6]] o [[Mes(CUOTASL.FECHA4[Fila]) < Mes(CUOTASL.FECHA1[Fila])] y [((Mes(CUOTASL.FECHA4[Fila])+12)-Mes(CUOTASL.FECHA1[Fila]))<>VPRE6]],FinDeMes(FinDeMes(IF((Mes(CUOTASL.FECHA1[Fila]+VPRE5)-(Mes(CUOTASL.FECHA1[Fila])))<>(VPRE6-1),CUOTASL.FECHA1[Fila]+VPRE5-VPRE6,CUOTASL.FECHA1[Fila]+VPRE5),SI)+1,SI),CUOTASL.FECHA4[Fila]));90;;Fecha
  Fecha2   : 'F.Vto.'       ;NO;  ;;;;IF(Fila=CUOTAS1,FECHAVTO,IF(MB1=0,CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila],CUOTASL.FECHA5[Fila]));90;;Fecha
  Fecha3   : 'F.Liq.'       ;NO;  ;CUOTASL.FECHA3[Fila]>=FECHAOP2;'Cuotas Vencidas';;IF(ESHABIL(CUOTASL.FECHA2[Fila],'ARG'),CUOTASL.FECHA2[Fila],HABILES(CUOTASL.FECHA2[Fila],IF(MB4=0,1,IF(MB4=1,-1,IF(MB4=2,IF(Mes(CUOTASL.FECHA2[Fila])=Mes(HABILES(CUOTASL.FECHA2[Fila],1,'ARG',SI)),1,-1),IF(Mes(CUOTASL.FECHA2[Fila])=Mes(HABILES(CUOTASL.FECHA2[Fila],-1,'ARG',SI)),-1,1)))),'ARG',SI));90;;Fecha

  Precio1  : 'Tasa N.A.'    ;NO;;;;PRECIO1;PRECIO1;80;;Numero;'###,###.######';NO;NO;
  Precio2  : 'Tasa Mensual' ;NO;;;;;CUOTASL.PRECIO1[Fila]*PERIODOINTS/(DIASA(DIASANIO,FECHAVTO)*100);80;;Numero;'###,###.######';NO;NO;

  Total1   : 'Cuota'        ;NO;;;;;CANTIDAD*CUOTASL.PRECIO2[Fila]/(1-(1/((1+CUOTASL.PRECIO2[Fila])^CUOTAS1)));120;;Numero;'###,###,###.##';NO;NO;

  Cantidad2: 'Interes'      ;NO;;;;;CUOTASL.CANTIDAD3[Fila]*CUOTASL.PRECIO2[Fila];120;;Numero;'###,###,###.##';NO;NO;

  Cantidad1: 'Imp.Amortiz.' ;NO;;;;;CUOTASL.TOTAL1[Fila]-CUOTASL.CANTIDAD2[Fila];120;;Numero;'###,###,###.##';NO;NO;

  Total2   : 'Total Amort.' ;NO;;;;;IF(Fila=1,CUOTASL.CANTIDAD1[Fila],CUOTASL.CANTIDAD1[Fila]+CUOTASL.TOTAL2[Fila-1]);120;;Numero;'###,###,###.##';NO;NO;

  Cantidad3: 'Saldo'        ;NO;;;;;IF(Fila=1,CANTIDAD,CUOTASL.CANTIDAD3[Fila-1]-CUOTASL.CANTIDAD1[Fila-1]);120;;Numero;'###,###,###.##';NO;NO;
  Plazo1   : 'Plazo'        ;NO;;;;;PERIODOINTS;40;;Numero;'####'

  Precio4  : 'Por.IVA'      ;;;CUOTASL.PRECIO4[Fila]>=0;'IVA Negativo';;PORCAUCION;80;;Numero;'###,###.######';NO;NO;
  Cantidad4: 'IVA'          ;NO;;;;;ROUND(CUOTASL.CANTIDAD2[Fila]*CUOTASL.PRECIO4[Fila]/100,2);120;;Numero;'###,###.######';NO;NO;
  Tasa1    :'Por.Percepcion';;;CUOTASL.TASA1[Fila]>=0;'Percepcion Negativa';;PORIMPUESTOBOLSA;80;;Numero;'###,###.######';NO;NO;
  Total4   :'LALA'          ;NO;NO;;;;ROUND(CUOTASL.CANTIDAD2[Fila]*CUOTASL.TASA1[Fila]/100,2);120;;Numero;'###,###.######';NO;NO;
  Total3   :'Percepcion'    ;NO;;;;;IF(Incluido(VTXT1,'INS'),IF(CUOTASL.CANTIDAD2[Fila]>Var('INSMONTO') o CUOTASL.TOTAL4[Fila]>Var('INSPERCEP'),CUOTASL.TOTAL4[Fila],0),IF(Incluido(VTXT1,'NOI'),CUOTASL.TOTAL4[Fila],IF(Incluido(VTXT1,'NOC'),IF(CUOTASL.CANTIDAD2[Fila]>Var('NOCMONTO') o CUOTASL.TOTAL4[Fila]>Var('NOCPERCEP'),CUOTASL.TOTAL4[Fila],0),0)));120;;Numero;'###,###.######';NO;NO;
  Tasa2    :'Por.Endeuda.'  ;;;CUOTASL.TASA2[Fila]>=0;'Endeudamiento Negativo';;PORDERECHOBOLSA;80;;Numero;'###,###.######';NO;NO;
  Total6   :'Endeudamiento' ;NO;;;;;IF(PRECIO1>Var('TASAENDEU'),ROUND(CUOTASL.TOTAL8[Fila]*CUOTASL.TASA2[Fila]/100,2),ROUND(CUOTASL.CANTIDAD2[Fila]*PORDERECHOBOLSA/100,2));120;;Numero;'###,###.######';NO;NO;
  Total5   :'Monto'         ;NO;;;;;ROUND(CUOTASL.TOTAL1[Fila]+CUOTASL.CANTIDAD4[Fila]+CUOTASL.TOTAL3[Fila]+CUOTASL.TOTAL6[Fila],2);120;;Numero;'###,###,###.##';NO;NO;

  Total8   : 'Interes'      ;NO;;;;;CUOTASL.TOTAL7[Fila]*VCAN1;120;;Numero;'###,###,###.##';NO;NO;
  Precio3  : 'Imp.Amortiz.' ;NO;;;;;VCAN3-CUOTASL.TOTAL8[Fila];120;;Numero;'###,###,###.##';NO;NO;
  Total7   : 'Saldo'        ;NO;;;;;IF(Fila=1,CANTIDAD,CUOTASL.TOTAL7[Fila-1]-CUOTASL.PRECIO3[Fila-1]);120;;Numero;'###,###,###.##';NO;NO;


CONDICIONES

EV o Incluido(TIPOOP, BuscarCampo('Clientes','TiposOperacionMM','Codigo',CLIENTE1));'El Cliente No tiene Habilitado el Tipo de Operacion';NO;

EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La Moneda No esta Habilitada';NO
Vacio(Cliente1) o EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB');'El Cliente No esta Habilitado';NO
Vacio(Cuenta2) o EqStr(BuscarCampo('Cuentas','Cliente','Codigo',Cuenta2),Cliente1) o EqStr(BuscarCampo('Cuentas','Cliente','Codigo',Cuenta2),Vehiculo1);'La Cuenta a Direccionar debe ser del Cliente o del Banco';NO

[Precio1 > 0];'La Tasa No puede ser Cero';NO;
[NoVacio(FechaPrecan)] o Precio1>=Precio4;'STRNEG_La Tasa es Menor que la Tasa de Transferencia';SI;SI;FSYS;'OPERAT' 

[NoVacio(FechaPrecan)] o DifDias(FechaOp,Fsys,'ARG',SI)<1;'Fecha Valor Mayor a un Dia: '~Fecha(FechaOp);SI;SI;FSYS;'FECHAVAL'
FechaOp > Fecha(Var('FECHAVALOR'));'La Fecha Valor No Debe Superar el '~Var('FECHAVALOR');NO
[NoVacio(FechaPrecan)] o [FechaOp>FSYS] o [[Mes(FechaOp)=Mes(FSYS) y Anio(FechaOp) = Anio(FSYS)] y [DifDias(FechaOp,FSYS,'ARG',SI)<=VAR('FVALORMES')]] o [[Mes(FechaOp)+1=Mes(Fsys)] y [FechaOp >= Habiles(FinDeMes(FechaOp,SI,'ARG'),-VAR('FVALORMESA'),'ARG',SI)] y [DifDias(FechaOp,FSYS,'ARG',SI)<=VAR('FVALORMES')]];'Fecha de Concertacion Invalida';NO;

[NoVacio(FechaPrecan)] o [EqStr(Especie,'ARP')] o [EsHabil(FechaOp,'USA')];'Fecha de Operacion No Habil en USA';SI;SI;FSYS;'OPEWAR'
[NoVacio(FechaPrecan)] o [EqStr(Especie,'ARP')] o [EsHabil(FechaVto,'USA')];'Fecha de Vencimiento No Habil en USA';SI;SI;FSYS;'OPEWAR'

Incluido(Vehiculo1, UsrVehiculos(Operador)) o Vacio(UsrVehiculos(Operador));'El Operador no esta habilitado para operar con el Vehiculo';NO

SI o [NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o [BuscarCampo('Clientes','Patrimonio','Codigo',Cliente1)>LimConsumido(CLIENTE1,'RPCCLI','USD',0,VEHICULO1,,,NROPERACION)];'Patrimonio del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
SI o [NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o [Not DesciendeDeCliente(Cliente1,'VINCULADOS')] o [DesciendeDeCliente(Cliente1,'VINCULADOS') y BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('PVINC')>LimConsumido(CLIENTE1,'RPCBCO','USD',0,VEHICULO1,,,NROPERACION)];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
SI o [NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o [Not DesciendeDeCliente(Cliente1,'BLOCAL')] o [DesciendeDeCliente(Cliente1,'BLOCAL') y BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('PFINAN')>LimConsumido(CLIENTE1,'RPCBCO','USD',0,VEHICULO1,,,NROPERACION)];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
SI o [NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o [Not DesciendeDeCliente(Cliente1,'BEXTER')] o [DesciendeDeCliente(Cliente1,'BEXTER') y BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('PFINEXT')>LimConsumido(CLIENTE1,'RPCBCO','USD',0,VEHICULO1,,,NROPERACION)];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
SI o [NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o [Not DesciendeDeCliente(Cliente1,'CORREXT')] o [DesciendeDeCliente(Cliente1,'CORREXT') y BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('PCORREXT')>LimConsumido(CLIENTE1,'RPCBCO','USD',0,VEHICULO1,,,NROPERACION)];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
SI o [NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o [DesciendeDeCliente(Cliente1,'BANCOS')] o [DesciendeDeCliente(Cliente1,'VINCULADOS')] o [DesciendeDeCliente(Cliente1,'CORRESP')] o [Not DesciendeDeCliente(Cliente1,'BANCOS') y Not DesciendeDeCliente(Cliente1,'VINCULADOS') y Not DesciendeDeCliente(Cliente1,'CORRESP') y BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('PCLIENTE')>LimConsumido(CLIENTE1,'RPCBCO','USD',0,VEHICULO1,,,NROPERACION)];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
SI o [NoVacio(FechaPrecan)] o Vacio(Cliente1) o FechaOp > Fsys o [BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('P25')>BuscarCampo('Clientes','Patrimonio','Codigo',Cliente1)*3];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1


MOVIMIENTOS
FechaOp ;Cliente1 ;Especie ;;;;MERCADO;Vehiculo1;1;         Cantidad;;'Prestamo Frances';SI;NO;1;NOVACIO(CLIENTE1);;;;1;'MMPR';;;;;;;;

MOVCUOTAS
CuotasL.Fecha3[Fila];Cliente1 ;Especie ;;Vehiculo1;1;-ROUND(CuotasL.Total5[Fila],2);'Vencimiento Cuota '~TIPOOP;SI;NO;;NOVACIO(CLIENTE1);;;;(Fila+1);'MMPR';;;;;;;;

CASHFLOW
FechaOp ;Vehiculo1;;;Especie;TipoOp;; -Cantidad;3;;

CASHFLOWCUOTAS
CuotasL.Fecha3[Fila];Vehiculo1;;;Especie;TipoOp;;ROUND(CuotasL.Total1[Fila],2);3;NOVACIO(CLIENTE1) Y CuotasL.Total1[Fila]>0;

POSTEDICION
Incluido(ABM,'A|M|E') y FechaOp <= Fsys; 'CONPOS'; NrOperacion1 = NrOperacion

SQL:EqStr(ABM,'E')
"Delete from "~DBO~".EXCEPCIONES where NrOperacion = '"~NrOperacion~"' "

BITS
1;1
2;0
7;0
12;0
13;0
14;0
28;0
30;0
70;0
80;0
20;0

