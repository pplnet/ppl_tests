2;0
28;1;FW=1 
30;1;FW=2 y Vacio(NrOperacion2)
7;0;FW=2
14;0;FW=2
28;0;FW=2
12;1;FW=2 y NoVacio(NrOperacion2)

INSTANCIA7
CAMPOS:1;;;FW=2 y [CB9=0 o Vacio(CB9)]
Observac2   : 'Obs.Anulacion' ;2;1;;;FW=2;;;;

POSTEDICION
FW=2 y [CB9=0 o Vacio(CB9)]; 'DESAFE'; NrOperacion1 = NrOperacion
FW=2 y  CB9=1; 'ANUPRE'; NrOperacion1 = NrOperacion

BITS
7;0
28;1;FW=1 
30;1;FW=2 y [CB9=0 o Vacio(CB9) o Vacio(NrOperacion2)]
2;0;FW=2 y [CB9=0 o Vacio(CB9)]
14;0;FW=2 y [CB9=0 o Vacio(CB9)]
28;0;FW=2 y [CB9=0 o Vacio(CB9)]
12;1;FW=2 y [CB9=1 o NoVacio(NrOperacion2)]

INSTANCIA28
CAMPOS:1;;;FW=2
Observac2   : 'Obs.Anulacion' ;2;1;;;FW=2;;;;

POSTEDICION
FW=2; 'DESAFE'; NrOperacion1 = NrOperacion

BITS
28;0;FW=1 y QUERY("Select Valor from "~DBO~".OPERACIONESBITS where NrOperacion = '"~NrOperacion~"' and NrBit = 2 ") = 0 y QUERY("Select Valor from "~DBO~".OPERACIONESBITS where NrOperacion = '"~NrOperacion~"' and NrBit = 7 ") = 0 y QUERY("Select Valor from "~DBO~".OPERACIONESBITS where NrOperacion = '"~NrOperacion~"' and NrBit = 14 ") = 0 
80;1;FW=1 y QUERY("Select Valor from "~DBO~".OPERACIONESBITS where NrOperacion = '"~NrOperacion~"' and NrBit = 2 ") = 0 y QUERY("Select Valor from "~DBO~".OPERACIONESBITS where NrOperacion = '"~NrOperacion~"' and NrBit = 7 ") = 0 y QUERY("Select Valor from "~DBO~".OPERACIONESBITS where NrOperacion = '"~NrOperacion~"' and NrBit = 14 ") = 0 
28;0;FW=2
30;1;FW=2
2;0;FW=2
7;0;FW=2
14;0;FW=2

INSTANCIA80
CAMPOS:1;;;FW=2 o FW=1 
Observac2      : 'Obs.Anulacion'  ;2;1; ;  ;FW=2;
