RB9         : 'Cpto.Prorrogar|Capital|Interes|Ambos';13;1; ;  ;  ;RB9>=0 Y [CB8=0 O RB9<>1];'Concepto a Prorrogar Invalido';NO;
CB7             : 'Capitaliza int'                  ;14;1; ;  ;  ;
CB8             : 'Amplia Capital'                  ;15;1; ;  ;  ;
TotalBrutoCli1  : 'Monto a Ampliar'                 ;16;1; ;  ;CB8=1;CB8=0 O TOTALBRUTOCLI1 > 0;'Ingrese Monto a Ampliar';NO;
CB6             : 'Activada'                        ;17;1; ;NO;;;;;0;

VCAN1           : 'CantAnt'                         ;10;3; ;NO;NO;;;;;BuscarCampo('OPERACIONES','Cantidad+TotalComisiones','NrOperacion',NrOperacion)
VCAN10          : 'ComEF'                           ;10;3; ;NO;NO;;;;;IF(NOVACIO(NROPERACION5),QUERY(" Select Tasa1 from "~DBO~".COMISIONES2 where NrOperacion='"~NROPERACION5~"' AND Tipo='5'"),0);;;;;'###.#####'
VPRE1           : 'UTEF'                            ;10;3; ;NO;NO;;;;;IF(NOVACIO(NROPERACION5),IF(EQSTR(QUERY("Select RB2 from "~DBO~".COMISIONES2 where NrOperacion='"~NROPERACION5~"' "),'0'),36000,36500),0)
