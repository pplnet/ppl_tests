NrOperacion6    : 'Op Original'                     ; 3;1; ;  ;  ;Query(" Select 1 From "~DBO~".OPERACIONES Where NrOperacion = '"~NROPERACION6~"' and TipoOp in ('MMPCCM') AND MB3 = 1 ") = 1;'Operacion a Prorrogar Invalida';NO;;;;;;;;" TipoOp in ('MMPCCM') AND MB3 = 1 AND (NrOperacion5 = Null OR NrOperacion5 = '' OR NrOperacion5 = ' ' OR 1=1) "
VTXT6           : 'Ult.Prorroga'                    ; 3;1; ;NO;NO;;;;;BuscarCampo('OPERACIONES','NrOperacion5','NrOperacion', NROPERACION6);
