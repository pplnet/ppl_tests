RB11            : 'Ajuste|NO|SI'                    ;5;1;2;  ;NO  ;;;;0;
CB1             : 'Op.Automatica'                   ;5;2;2;NO;;;;;0
VPRE9           : 'Cot.TC/USD'                      ;10;2;2;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(ESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)
PrecioMer       : 'Monto USD WF'                    ; 1;2;2;NO;NO;;;;CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'));CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))
VCAN8           : '1er Cuota Prorrogable'           ; 8;1;2;NO;  ;;;;;Query(" Select Min(NrCuota) From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND Fecha2 >= '"~IdxDate(FECHAPRECAN)~"' ");
VCAN9           : 'Nr_Periodos Op a Prorrogar'      ;17;2;1;NO;NO;;;;;BuscarCampo('OPERACIONES','Cuotas1','NrOperacion', NROPERACION5);
Cuotas1         : 'Nr_Periodos'                     ;16;2;1;  ;  ;CUOTAS1>=VCAN9;'Cantidad De Periodos no Puede ser Inferior a la Operacion a Prorrogar';NO;;IF(MODI, CUOTAS1, BuscarCampo('OPERACIONES','Cuotas1','NrOperacion', IF(Vacio(VTXT6), NROPERACION6, VTXT6)));




@CUENTAS3
@INDICE1

LISTA:SI;IF(CUOTAS1 > 0, 10+CUOTAS1-10, BuscarCampo('OPERACIONES','Cuotas1','NrOperacion', IF(Vacio(VTXT6), NROPERACION6, VTXT6)));
  Radio1      : 'Prorroga'              ;;;[[Fila > VCAN9 Y CUOTASL.RADIO1[Fila] = 0] O CUOTASL.RADIO1[Fila] = 0 O [Fila >= VCAN8 Y Query(" Select 1 From "~DBO~".MOVEJECUTADOS Where NrOperacion = '"~NROPERACION5~"' AND FechaMov = '"~IdxDate(Fecha(Query(" Select Max(Fecha2) From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" ")))~"' AND NrSaldo = 1 ") <> 1]];'Cuota No Prorrogable';IF(CUOTASL.FECHA2[Fila] < FECHAPRECAN,0);IIF(CUOTASL.TOTAL10[Fila] > 0 THEN 0 ELSE CUOTASL.RADIO1[Fila] ENDIF);60;;Combo;'NO|SI';NO;NO;
  Tasa1       : 'Tasa Amort'            ;;;[Fila >= VCAN8 Y CUOTASL.TASA1[Fila]>=0] O [Round(CUOTASL.TASA1[Fila], 6) = Round(Query(" Select Tasa1 From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" "), 6)];'La Tasa de Amortizacion debe SER POSITIVA o Cuota ya Vencida';Round(Query(" Select Tasa1 From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" "), 6);IIF(Fila>=VCAN8 THEN ((CUOTASL.CANTIDAD1[Fila]/CUOTASL.COEFICIENTE[Fila])*100)/CANTIDAD ELSE CUOTASL.TASA1[Fila] ENDIF);80;;Numero;'###,###.######';NO;NO;'3'
  Cantidad1   : 'Imp Amort'             ;NO;;;;IIF(Eqstr(TIPOOP, TIPOOP2) THEN Round(Query(" Select Case Radio1 When 0 Then Case Cantidad7 When 0 Then Cantidad1 When null Then Cantidad1 Else Cantidad7 END ELSE Cantidad2 END From "~DBO~".CUOTAS Where NrOperacion = '"~IF(SI,NROPERACION5,NROPERACION6)~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" "), 2) ELSE Round(Query(" Select Cantidad1 From "~DBO~".CUOTAS Where NrOperacion = '"~IF(SI,NROPERACION5,NROPERACION6)~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" "), 2) ENDIF);IIF(Fila > VCAN9 THEN CUOTASL.TOTAL10[Fila] ELSE CUOTASL.CANTIDAD1[Fila] ENDIF);160;;Numero;'###,###,###,###,###.##';NO;NO;'2'
  Total10     : 'Imp Amort Nueva Cuota' ;;CUOTAS1 > VCAN9;CUOTASL.TOTAL10[Fila] > 0 O FILA <= VCAN9;'Importe Nueva Cuota Invalido';;;160;;Numero;'###,###,###,###,###.##';NO;NO;
  Cantidad7   : 'Amort a Prorrogar'     ;;RB9<>1;[[RB9=1 O CUOTASL.RADIO1[Fila]=0] Y CUOTASL.CANTIDAD7[Fila]=0] O [RB9<>1 Y CUOTASL.RADIO1[Fila]=1 Y CUOTASL.CANTIDAD7[Fila]>0 Y CUOTASL.CANTIDAD7[Fila]<=CUOTASL.CANTIDAD1[Fila]];'Amort. a Prorrogar Invalida';;IIF(RB9<>1 THEN IIF(CUOTASL.RADIO1[Fila]=1 THEN IIF(RB7=1 THEN CUOTASL.CANTIDAD1[Fila] ELSE CUOTASL.CANTIDAD7[Fila] ENDIF) ELSE 0 ENDIF) ELSE 0 ENDIF);200;;Numero;'###,###,###,###,###.##'
  Cantidad10  : 'Monto Ampliado'        ;;CB8=1;;;;;200;;Numero;'###,###,###,###,###.##'
  Fecha3      : 'F.IniOri'              ;NO;;;;IIF(Eqstr(TIPOOP, TIPOOP2) THEN Query(" Select Case Radio1 When 0 Then Fecha3 Else Fecha1 END From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" ") ELSE Query(" Select Fecha1 From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" ") ENDIF);IIF(CUOTASL.TOTAL10[Fila] > 0 THEN CUOTASL.FECHA2[VCAN9] ELSE CUOTASL.FECHA3[Fila] ENDIF);90;;Fecha;;;;;;;;
  Fecha4      : 'F.Vto Ori'             ;NO;;;;IIF(Eqstr(TIPOOP, TIPOOP2) THEN Query(" Select Case Radio1 When 0 Then Fecha4 Else Fecha2 END From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" ") ELSE Query(" Select Fecha2 From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" ") ENDIF);IIF(FILA <= VCAN9 THEN CUOTASL.FECHA4[Fila] ELSE CUOTASL.FECHA3[Fila] + CUOTASL.PLAZO1[Fila] ENDIF);90;;Fecha;NO;NO;;;;;;
  Fecha1      : 'F.IniProrroga'         ;NO;;;;;IIF(CUOTASL.TOTAL10[Fila] > 0 THEN CUOTASL.FECHA2[VCAN9] ELSE CUOTASL.FECHA4[Fila] ENDIF);90;;Fecha;;;;;;;;
  Plazo1      : 'Plazo'                 ;;;CUOTASL.PLAZO1[Fila] > 0 Y IIF(CUOTASL.RADIO1[Fila]=0 THEN CUOTASL.PLAZO1[Fila]=CUOTASL.FECHA4[Fila]-CUOTASL.FECHA3[Fila] ELSE CUOTASL.PLAZO1[Fila]=CUOTASL.FECHA2[Fila]-CUOTASL.FECHA1[Fila] ENDIF);'Plazo Invalido';Query(" Select Plazo1 From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" ");IIF(FILA <= VCAN9 THEN IIF(CUOTASL.RADIO1[Fila]=0 THEN CUOTASL.FECHA4[Fila] - CUOTASL.FECHA3[Fila] ELSE CUOTASL.FECHA2[Fila]-CUOTASL.FECHA1[Fila] ENDIF) ELSE CUOTASL.PLAZO1[Fila] ENDIF);60;;Numero;'####';SI;NO;'11'
  Fecha2      : 'F.VtoProrroga'         ;;;[CUOTASL.FECHA2[Fila] > CUOTASL.FECHA2[Fila-1] O Fila <= VCAN9] Y CUOTASL.FECHA2[Fila] >= CUOTASL.FECHA4[Fila] Y [[EqStr(TABLAFERIADOS1,'USA') Y ESHABIL(CUOTASL.FECHA2[Fila],TABLAFERIADOS1)] O [Not EqStr(TABLAFERIADOS1,'USA') Y ESHABIL(CUOTASL.FECHA2[Fila],TABLAFERIADOS1) Y ESHABIL(CUOTASL.FECHA2[Fila],'ARG')]];'El Vencimiento de la Cuota '~Fstr(Fila, 0, 0)~' Es Invalido';IIF(Eqstr(CAMPOMODIFICADO, 'NROPERACION6') THEN Query(" Select Fecha2 From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" ") ELSE CUOTASL.FECHA2[Fila] ENDIF);IF(CUOTASL.RADIO1[Fila]=0, CUOTASL.FECHA4[Fila], CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila]);90;;Fecha;NO;NO;'10';;;;;
  Cantidad2   : 'V.Nominal de Prorroga' ;NO;;;;;IIF(Fila >= VCAN8 THEN CUOTASL.TOTAL10[Fila] + CUOTASL.CANTIDAD7[Fila] + CUOTASL.CANTIDAD10[Fila] + IIF(CB7=1 THEN CUOTASL.CANTIDAD8[Fila] ELSE 0 ENDIF) ELSE 0 ENDIF);200;;Numero;'###,###,###,###,###.##'
  Precio2     : 'Tasa Interes'          ;;;[Fila >= VCAN8 Y [[[[EQSTR(TIPOTASA,'FIJA') O Fila=1] Y CUOTASL.PRECIO2[Fila]>=VAR('RTASA1') Y CUOTASL.PRECIO2[Fila]<=VAR('RTASA2')] O Fila>1]]] O [Round(CUOTASL.PRECIO2[Fila],6) = Round(Query(" Select Precio2 From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" "),6)];'La Tasa de Intereses Fila '~Fstr(Fila,2,0)~' ESTA FUERA DE RANGO:'~VAR('RTASA1')~' '~VAR('RTASA2')~' o Cuota ya Vencida';Round(Query(" Select Precio2 From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" "),6);;100;;Numero;'###,###.######';NO;NO;'19'
  Precio4     : 'Spread'                ;;NOT EQSTR(TIPOTASA,'FIJA');[Fila >= VCAN8 Y [EQSTR(TIPOTASA,'FIJA') O [NOT EQSTR(TIPOTASA,'FIJA') Y CUOTASL.PRECIO4[Fila]=0] O [NOT EQSTR(TIPOTASA,'FIJA') Y CUOTASL.PRECIO4[Fila]>=VAR('RSPREAD1') Y CUOTASL.PRECIO4[Fila]<=VAR('RSPREAD2')]]] O [Round(CUOTASL.PRECIO4[Fila],6) = Round(Query(" Select Precio4 From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" "),6)];'El Spread esta Fuera de Rango:'~VAR('RSPREAD1')~' '~VAR('RSPREAD2')~' o Cuota ya Vencida';Round(Query(" Select Precio4 From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" "),6);;100;;Numero;'###,###.######';NO;NO;'19'
  Tasa2       : 'Tasa_Int_IVA'          ;;RB6=0 O [RB6=2 y MB3=0];[Fila >= VCAN8] O [CUOTASL.TASA2[Fila] = Round(Query(" Select Tasa2 From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" "),6)];'La Tasa de Int_IVA no puede modificarse porque la Cuota esta vencida';Round(Query(" Select Tasa2 From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" "),6);;100;;Numero;'###,###.######';NO;NO;'16';
  *Total4      : 'Importe_Iva'           ;EV;RB6=0 O [RB6=2 y MB3=0];NOT EV o [[ROUND(CUOTASL.TOTAL4[Fila],2) <= ROUND((CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.TOTAL4[Fila],2) >= ROUND((CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe IVA Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(RB6=0 O [RB6=2 y MB3=0],(((CUOTASL.CANTIDAD2[Fila] - CUOTASL.CANTIDAD10[Fila])*CUOTASL.TASA2[Fila]/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1))*(IMPGASTOS2/100)) + CUOTASL.TOTAL12[Fila],0);200;NO;Numero;'###,###,###,###,###.##';NO;NO;'15;34';
  Total4      : 'Importe_Iva'           ;EV;RB6=0 O [RB6=2 y MB3=0];NOT EV o [[ROUND(CUOTASL.TOTAL4[Fila],2) <= ROUND((CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.TOTAL4[Fila],2) >= ROUND((CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe IVA Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(RB6=0 O [RB6=2 y MB3=0],(((CUOTASL.CANTIDAD2[Fila] - CUOTASL.CANTIDAD10[Fila])*CUOTASL.TASA2[Fila]/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1)*(IMPGASTOS2/100) + CUOTASL.TOTAL12[Fila]),0);200;NO;Numero;'###,###,###,###,###.##';NO;NO;'15;34';
  Total6      : 'Tasa_Int_WH'           ;;RB6=2;[Fila >= VCAN8] O [CUOTASL.TOTAL6[Fila] = Round(Query(" Select Total6 From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" "),6)];'La Tasa de Int_WH no puede modificarse porque la Cuota esta vencida';Round(Query(" Select Total6 From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" "),6);;100;;Numero;'###,###.######';NO;NO;'18';
  Total7      : 'WH_a_Liquidar'         ;EV;RB6=2 y MB3=0;NOT EV o [[ROUND(CUOTASL.TOTAL7[Fila],2) <= ROUND((CUOTASL.PRECIO7[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.TOTAL7[Fila],2) >= ROUND((CUOTASL.PRECIO7[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe WHT Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO7[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO7[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(RB6=2 y MB3=0,((((CUOTASL.CANTIDAD2[Fila] - CUOTASL.CANTIDAD10[Fila])*CUOTASL.TOTAL6[Fila]/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1))*(TOTALAUX1/100)) + CUOTASL.TOTAL8[Fila],0);200;NO;Numero;'###,###,###,###,###.##';NO;NO;'17';
  Cantidad3   : 'Interes de la Prorroga';NO;;NOT EV o [[ROUND(CUOTASL.CANTIDAD3[Fila],2) <= ROUND((CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.CANTIDAD3[Fila],2) >= ROUND((CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100)),2)]];'Interes Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100),2),0,2);;(CUOTASL.CANTIDAD2[Fila] - CUOTASL.CANTIDAD10[Fila])*((CUOTASL.PRECIO4[Fila]+CUOTASL.PRECIO2[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1) + CUOTASL.TOTAL11[Fila];200;NO;Numero;'###,###,###,###,###.##';NO;NO;'13;14';
  Cantidad8   : 'Interes a Prorrogar'   ;;RB9>=1;RB9>=1 Y CUOTASL.RADIO1[Fila]=1 Y [[RB7=0 Y Round(CUOTASL.CANTIDAD8[Fila], 2) <= CUOTASL.CANTIDAD12[Fila] Y [CUOTASL.CANTIDAD8[Fila] > 0 O CUOTASL.CANTIDAD12[Fila] = 0]] O [RB7=1 Y Round(CUOTASL.CANTIDAD8[Fila], 2) = Round(CUOTASL.CANTIDAD12[Fila], 2)]] O [[RB9=0 O CUOTASL.RADIO1[Fila]=0] Y CUOTASL.CANTIDAD8[Fila]=0 ];'Interes a Prorrogar Invalido';;;200;;Numero;'###,###,###,###,###.##'
  Cantidad11  : 'Interes No Prorrogado' ;NO;RB9>=1;;;;CUOTASL.CANTIDAD12[Fila] - CUOTASL.CANTIDAD8[Fila];200;;Numero;'###,###,###,###,###.##'
  Cantidad3Ori: 'InteresOriginal'       ;;;;;;IIF(Eqstr(TIPOOP, TIPOOP2) THEN Round(Query(" Select Case Radio1 When 0 Then Cantidad3Ori Else Cantidad3 END From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" "), 2) ELSE Round(Query(" Select Cantidad3 From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" "), 2) ENDIF);200;;Numero;'###,###,###,###,###.##'
  Cantidad12  : 'Interes Total que Puede Prorrogarse';;RB9>=1;;;;IIF(RB9=0 THEN 0 ELSE IIF(FECHAPRECAN < CUOTASL.Fecha4[Fila] THEN IIF(Eqstr(TIPOOP, TIPOOP2) THEN Query(" Select Cantidad8 From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" ") ELSE 0 ENDIF) + Query(" Select Round(Abs(Sum(Monto)), 2) From "~DBO~".MOVDEVENGADOS Where NrOperacion = '"~NROPERACION5~"' AND Fecha >= '"~IdxDate(CUOTASL.FECHA3[Fila])~"' AND Fecha <= '"~IdxDate(FECHAPRECAN)~"' AND TipoDevengado = 'INTLEN' ") ELSE Round(Query(" Select Cantidad3 From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" "), 2) ENDIF) ENDIF);200;;Numero;'###,###,###,###,###.##'
  Cantidad4   : 'Imp.Imp_Extr.'         ;NO;RB6=3 O [RB6=4 y MB3=0];NOT EV o [[ROUND(CUOTASL.CANTIDAD4[Fila],2) <= ROUND((CUOTASL.PRECIO8[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.CANTIDAD4[Fila],2) >= ROUND((CUOTASL.PRECIO8[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe Impuesto Extranjero Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO8[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO8[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(RB6=3 O [RB6=4 y MB3=0],CUOTASL.CANTIDAD3[Fila]*TASAPRECAN/100,0);200;NO;Numero;'###,###,###,###,###.##';NO;NO
  Total3      : 'Interes Neto'          ;NO;;;;;CUOTASL.CANTIDAD3[Fila]+CUOTASL.TOTAL7[Fila]+IF(RB6=4 y MB3=0,CUOTASL.CANTIDAD4[Fila],0);200;;Numero;'###,###,###,###,###.##'
  Total9      : 'Ingresos Brutos'       ;NO;MB3=1;;;;IF(CUOTASL.CANTIDAD3[Fila] > Var('IBMINIMO'), CUOTASL.CANTIDAD3[Fila]*TASABASE/100, 0);200;;Numero;'###,###.########';
  Precio3     : 'Tasa T.Neta'           ;NO;;SI Y [CUOTASL.Precio3[Fila]=0 y Fila>1 o [CUOTASL.Precio3[Fila]<=VAR('RTTN2') Y CUOTASL.Precio3[Fila]>=VAR('RTTN1')]];'Tasa Total Neta Fuera de Rango:'~VAR('RTTN1')~" Y "~VAR('RTTN2');;;200;;Numero;'###.######';NO;NO
  Total2      : 'Monto'                 ;NO;;;;;(CUOTASL.CANTIDAD1[Fila]+CUOTASL.CANTIDAD3[Fila]);200;;Numero;'###,###,###,###,###.##'
  Total1      : 'Monto Neto'            ;NO;;;;;(CUOTASL.CANTIDAD1[Fila]+CUOTASL.TOTAL3[Fila]);200;;Numero;'###,###,###,###,###.##'

  Cantidad9   : 'Cta Prorrogable'       ;NO;NO;;;;IIF(Fila>=VCAN8 THEN 1 ELSE 0 ENDIF);200;;Numero;'###,###,###,###,###.##'
  Cantidad2Ori: 'VN Orig'               ;NO;NO;;;;Query(" Select Cantidad2 From "~DBO~".CUOTAS Where NrOperacion = '"~NROPERACION5~"' AND NrCuota = "~Fstr(Fila, 0, 0)~" ");200;;Numero;'###,###,###,###,###.##';NO;NO;;NO;NO
  Check1      : 'x Precan'              ;NO;SI;;;;;200;;Check;
  Total11     : 'Interes de Ampliacion' ;;;;;;CUOTASL.CANTIDAD10[Fila]*((CUOTASL.PRECIO4[Fila]+CUOTASL.PRECIO2[Fila])/100)*FACTORDIAS(FECHAPRECAN,CUOTASL.FECHA2[Fila],RB8+1);200;NO;Numero;'###,###,###,###,###.##';NO;NO;'13;14';
  Total12     : 'IVA_Ampliacion'        ;;;;;;((CUOTASL.CANTIDAD10[Fila]*CUOTASL.TASA2[Fila]/100)*FACTORDIAS(FECHAPRECAN,CUOTASL.FECHA2[Fila],RB8+1))*(IMPGASTOS2/100);200;NO;Numero;'###,###,###,###,###.##';NO;NO;'15;34';
  Total8      : 'WH_Ampliacion'         ;;;;;;IF(RB6=2 y MB3=0,((((CUOTASL.CANTIDAD10[Fila])*CUOTASL.TOTAL6[Fila]/100)*FACTORDIAS(FECHAPRECAN,CUOTASL.FECHA2[Fila],RB8+1))*(TOTALAUX1/100)),0);200;NO;Numero;'###,###,###,###,###.##';NO;NO;'17;35';

CONDICIONES
Round(Sum(CUOTASL, 1), 0) > 0;'Seleccione al Menos Una Cuota a Prorrogar';NO
CB8=0 O Sum(CUOTASL, 6) = TotalBrutoCli1;'La Suma del Monto Ampliado Debe ser de '~Fstr(TotalBrutoCli1, 0, 0);NO
Not EqStrI(Vehiculo1,Vehiculo2);'El Vehiculo Contraparte debe ser diferente al Vehiculo por el cual se ingresa la Operacion';NO;NO;FSYS;'VEHDUPL'
ESHABIL(FECHAOP,'ARG');'La Fecha de Origen no es Dia Habil en Argentina';SI;SI;FSYS;'ORIGINH'
ESHABIL(FECHAVTO,'ARG');'La Fecha de Vencimiento NO ES DIA HABIL en Argentina';SI;SI;FSYS;'VTOINH'
VACIO(NROPERACION2) O [EQSTR(TIPOOP,BuscarCampo('Operaciones','TipoOp','NrOperacion',NROPERACION2)) y BuscarCampo('Operaciones','FechaVto','NrOperacion',NROPERACION2)=Fsys y EQSTR(BuscarCampo('Operaciones','Vehiculo1','NrOperacion',NROPERACION2),VEHICULO1) y EQSTR(ESPECIE,BuscarCampo('Operaciones','Especie','NrOperacion',NROPERACION2))];'La Operacion de Referencia es INVALIDA';NO
RB6>2 O [Incluido(Fstr(ImpGastos2,2,2),VAR('IVA'))];'El Valor de TASA IVA es Erroneo: '~VAR('IVA');NO
SI O [CB8=1 Y Round(Sum(CUOTASL, 2, 34, 1), 2)=100] O [CB8=0 Y ROUND(SUM(CUOTASL,2),2)=100];IIF(CB8=1 THEN 'La Sumatoria de la Tasa de Amortizacion de las Cuotas Prorrogables Debe ser 100' ELSE 'La Sumatoria de la Tasa de Amortizacion debe ser 100' ENDIF);NO
ESTERMINAL(VEHICULO2,VEHICULO);'El Vehiculo ContraParte debe ser Terminal';NO
FECHAOP2=Fsys;'La Fecha de Concertacion no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'


@CONDIOP

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador
MB3=0 O QUERY("SELECT 1 FROM "~DBO~".SOLFAC WHERE NrOperacion='"~NROPERACION~"' and Tipo= 'FC' and (Estado = 'A' or Estado = 'C') ") <> 1;'No se puede dar de baja, pendiente envio de NC a SAP'

SQL
"UPDATE "~DBO~".OPERACIONES Set NrOperacion5 = '"~NROPERACION~"', FechaVto2='"~IdxDate(FECHAPRECAN)~"' Where NrOperacion = '"~NROPERACION6~"' ";NOVACIO(NROPERACION6) Y EQSTR(ABM,'A')

POSTEDICION
NO Y NOVACIO(OPERACIONREF) Y EQSTR(ABM,'A');'INSCOM';NrOperacion1=OPERACIONREF;NrOperacion2=NROPERACION;String=" Tipo  IN ('5','3')"
NOVACIO(NROPERACION5) Y EQSTR(ABM,'A');'MARPRO';NrOperacion1=NROPERACION;NrOperacion2=NROPERACION5
EqStr(ABM,'A') y MB4=1;'INVIMV';NrOperacion1=NROPERACION;TipoOp1=TIPOOP;String="MB3='"~Fstr(IF(MB3=0,1,0),1,0)~"',Book1=Book2,Book2=Book1 ";Vehiculo1=VEHICULO2;Vehiculo2=VEHICULO1;String1='';String2='';
NO Y EqStr(ABM,'B') ;'FWVIN5';NrOperacion1=NROPERACION3
SI;'ACTMOV';Vehiculo1='';Fecha1=FechaOp;Fecha2=FechaOp;NrOperacion1=NROPERACION5;TipoOp1='';Especie1='';Radio1=6;Radio2=0
SI;'ACTMOV';Vehiculo1='';Fecha1=FechaOp;Fecha2=FechaOp;NrOperacion1=NROPERACION5;TipoOp1='';Especie1='';Radio1=6;Radio2=3

