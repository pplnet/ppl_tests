FechaVto        : 'Vto_Monto'                       ; 8;1; ;NO;NO;ESHABIL(FECHAVTO,TABLAFERIADOS1) O SI;'La Fecha de Vencimiento del Monto NO ES DIA HABIL';RB11 = 0;FECHAOP+PLAZO;
Cantidad        : 'V_Nominal'                       ; 9;1; ;NO;  ;;;;;BuscarCampo('OPERACIONES','Cantidad','NrOperacion', NROPERACION5)+TOTALBRUTOCLI1+Sum(CUOTASL, 4);;;;;'###,###,###,###,###.##'
TipoTasa        : 'Tipo_Tasa'                       ;10;1; ;NO;  ;;;;'FIJA';BuscarCampo('OPERACIONES','TipoTasa','NrOperacion', NROPERACION5)
RB8: 'Day Count|ActAct|Act365F|Act360|360360|30E360';11;1; ;NO;  ;;;;;BuscarCampo('OPERACIONES','RB8','NrOperacion', NROPERACION5)

ImpGastos2      : 'Tasa_IVA'                        ; 9;2; ;RB6=0 O [RB6=2 y MB3=0];RB6=0 O [RB6=2 y MB3=0];;;;VAR('TASAIVA');IF(Incluido(VEHICULO1,VAR('VEHIEXTRAN')),0,IF(VACIO(NROPERACION5),IF(RB6=0 O [RB6=2 y MB3=0],IMPGASTOS2,0),BuscarCampo('OPERACIONES','ImpGastos2','NrOperacion', NROPERACION5)));;;;;'###,###.######'
TotalAux1       : 'Tasa WH'                         ; 8;2; ;RB6=2;RB6=2;Incluido(Fstr(TOTALAUX1,2,4),VAR('TASAWH'));'El Valor de TASA WH es Erroneo: '~VAR('TASAWH')~' ...';NO;VAR('DEFWH1');IF(VACIO(NROPERACION5),TOTALAUX1,BuscarCampo('OPERACIONES','TotalAux1','NrOperacion', NROPERACION5));;;;;'###,###.######'
ContraEspecie   : 'Esp_Pago_Imp'                    ; 8;2; ;RB6=3 O RB6=4;RB6=3 O RB6=4;[RB6<>3 y RB6<>4] O [RB6=3 Y NOVACIO(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE, ESPECIE)] O [RB6=4 Y NOVACIO(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE, ESPECIE)];'NO INGRESO LA ESPECIE DE PAGO IMPUESTO';NO;;;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";;;
TasaPrecan      : 'Alic Imp_Extr'                   ; 9;2; ;RB6=3 O RB6=4;RB6=3 O RB6=4;[RB6<>3 y RB6<>4] O [RB6=3 Y TASAPRECAN<=30] O [RB6=4 Y TASAPRECAN<=30];'EL IMPUESTO EXTRANJERO DEBE SER <=30';NO;VAR('ALICIMPU');;;;;;'###,###.######'

Operador        :                                   ;12;2; ;NO;  ;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
TablaFeriados1  : 'Feriados'                        ;13;2; ;NO;;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;BuscarCampo('OPERACIONES','TablaFeriados1','NrOperacion', NROPERACION5)
NrOperacion2    : 'Op_Referencia'                   ;14;2; ;  ;NoVacio(NROPERACION2);;;;
