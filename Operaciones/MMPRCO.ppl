FechaPrecan     : 'Fecha_Prorroga'                  ; 4;1; ;  ;  ;ESHABIL(FECHAPRECAN,TABLAFERIADOS1) y FECHAPRECAN>=FECHAOP;'Fecha de Prorroga Invalida';NO;FSYS;
Especie         : 'Moneda'                          ; 5;1; ;NO;  ;;;;;BuscarCampo('OPERACIONES','Especie','NrOperacion', NROPERACION5);;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";;
