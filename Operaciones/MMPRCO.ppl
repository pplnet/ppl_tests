INSTANCIA19
CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1);FW=1
FechaOp2        : 'Fecha Conc.'                ;1;1;;NO
FechaOp         : 'Fecha_Origen'               ;2;1;;NO
Vehiculo1       : 'Vehiculo'                   ;1;2;;NO
Book1           : 'Book'                       ;2;2;;NO 
   
Cliente1        : 'Entidad'                    ;4;1;;NO
Especie         : 'Especie'                    ;5;1;;NO
Cantidad        : 'Cantidad'                   ;6;1;;NO;;;;;;;;;;;'###,###,###,###,###.##';
TipoTasa        : 'Tipo_Tasa'                  ; ; ;;NO
Plazo           : 'Plazo'                      ; ; ;;NO

TablaFeriados1  : 'Feriados'                   ; ; ;;NO 
Operador        :                              ; ; ;;NO

VTXT11  : 'Ascend. Especie'  ;18;2;2;NO;NO;;;;Ascendientes('ESPECIES',ESPECIE);Ascendientes('ESPECIES',ESPECIE)
VTXT12  : 'Ascend. ContraE'  ;19;2;2;NO;NO;;;;Ascendientes('ESPECIES',CONTRAESPECIE);Ascendientes('ESPECIES',CONTRAESPECIE)

Label1  :    ''              ;17;1;2;NO;MB3=1 Y Not Incluido(TIPOOP, 'SEPVMV');;;;'Activa                                                        Pasiva';'Activa                                                        Pasiva';;;;;;
Label2  :    ''              ;17;1;2;NO;MB3=0 Y Not Incluido(TIPOOP, 'SEPVMV');;;;'Pasiva                                                        Activa';'Pasiva                                                        Activa';;;;;;
Label7  :    ''              ;17;1;2;NO;Incluido(TIPOOP, 'SEPVMV');;;;'Especie                                                        ContraEsp';'Especie                                                        ContraEsp';;;;;;

Cuenta1 : If(MB3=0,'Credito A','Debito  En');18;1;2;Not EV;;[CLIENTECUENTA(VEHICULO1,CUENTA1) y ESPECIECUENTA(ESPECIE,CUENTA1) y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA1),'HAB')] y NOVACIO(CUENTA1)          ;"Error en Cuenta de '"~If(MB3=0,'Credito a','Debito  En')~"' "~ESPECIE~' - '~VEHICULO1;SI;IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,ESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA1)      ;IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,ESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA1)      ;;;;;;"Cliente='"~VEHICULO1~"' and Estado = 'HAB' and (Especies Like '%"~Especie~"%' or Especies Like '%"~ItemLista(VTXT11,Elementos(VTXT11))~"%')";
Cuenta4 : If(MB3=0,'Debito En','Credito  A');19;1;2;Not EV;Incluido(TIPOOP, 'SEPVMV');[CLIENTECUENTA(VEHICULO1,CUENTA4) y ESPECIECUENTA(ESPECIE,CUENTA4) y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA4),'HAB')] y NOVACIO(CUENTA4)          ;"Error en Cuenta de '"~If(MB3=0,'Debito en','Credito A')~"' "~ESPECIE~' - '~VEHICULO1;SI;IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,ESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA4)      ;IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,ESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA4)      ;;;;;;"Cliente='"~VEHICULO1~"' and Estado = 'HAB' and (Especies Like '%"~Especie~"%' or Especies Like '%"~ItemLista(VTXT11,Elementos(VTXT11))~"%')";

Cuenta2 : If(MB3=0,'Debito En','Credito A');18;2;2;Not EV;;[NOVACIO(CUENTA2) y [[CLIENTECUENTA(VEHICULO2,CUENTA2) y ESPECIECUENTA(CONTRAESPECIE,CUENTA2) y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA2),'HAB')]]];"Error en Cuenta de '"~If(MB3=0,'Debito  en','Credito A')~"' "~ESPECIE~' - '~VEHICULO2;SI;IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO2,CONTRAESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA2);IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO2,CONTRAESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA2);;;;;;"Cliente='"~VEHICULO2~"' and Estado = 'HAB' and (Especies Like '%"~ContraEspecie~"%' or Especies Like '%"~ItemLista(VTXT12,Elementos(VTXT12))~"%')";
Cuenta5 : If(MB3=0,'Credito a','Debito  En');19;2;2;Not EV;Incluido(TIPOOP, 'SEPVMV');[NOVACIO(CUENTA5) y [[CLIENTECUENTA(VEHICULO2,CUENTA5) y ESPECIECUENTA(CONTRAESPECIE,CUENTA5) y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA5),'HAB')]]];"Error en Cuenta de '"~If(MB3=0,'Credito a','Debito En')~"' "~ESPECIE~' - '~VEHICULO2;SI;IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO2,CONTRAESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA5);IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO2,CONTRAESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA5);;;;;;"Cliente='"~VEHICULO2~"' and Estado = 'HAB' and (Especies Like '%"~ContraEspecie~"%' or Especies Like '%"~ItemLista(VTXT12,Elementos(VTXT12))~"%')";

POSTEDICION
FW=1;'ACTI19';NrOperacion1=NROPERACION
FW=2;'APROPE';NrOperacion1=NROPERACION;Radio1=1;

