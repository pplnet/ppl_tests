CUOTASL.FECHA1[Fila]+1;CUOTASL.FECHA2[Fila];SI;SI;NO;TablaFeriados1;SI;SI;'INTLEN';IF(MB3=0, -CuotasL.Cantidad3[Fila], CuotasL.Cantidad3[Fila]);140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;Fstr(Fila,0,0);Especie;
CUOTASL.FECHA1[Fila]+1;CUOTASL.FECHA2[Fila];SI;SI;NO;TablaFeriados1;SI;SI;'INTWHT';IF(MB3=0, -CuotasL.Total7[Fila], CuotasL.Total7[Fila]);140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;Fstr(Fila,0,0);Especie;

