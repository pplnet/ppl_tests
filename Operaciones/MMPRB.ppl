CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
OperacionRef   : 'Set Like'       ;1;1; ;  ;  ;Vacio(OPERACIONREF) o EqStr(OPREF.TIPOOP,TIPOOP);'La Operacion de Referencia No es un Prestamo Bullet';NO;;;;;;;;"TipoOp = '"~TIPOOP~"' and FechaOp2 = '"~IdxDate(Fsys)~"' "
Especie        : 'Moneda'         ;3;1; ;  ;  ;NoVacio(ESPECIE) y Incluido(ESPECIE,Var('MMMONEDA'));'Debe Ingresar una Moneda Valida';NO;;IF(VACIO(OPERACIONREF) o MODI o Incluido(ABM,'E'),ESPECIE,OPREF.ESPECIE);;;;;;"Status = 'HAB' and Codigo In ("~Pipe2Comillas(Var('MMMONEDA'))~") ";
Cliente1       : 'Cliente'        ; ; ; ;  ;  ;Vacio(Cliente1) o Incluido(Var('MMCPRES'),Ascendientes('CLIENTES',CLIENTE1),1);'El Cliente debe pertenecer a las jerarquias '~Pipe2Comillas(Var('MMCPRES'));NO;;IF(VACIO(OPERACIONREF) o MODI o Incluido(ABM,'E'),CLIENTE1,OPREF.CLIENTE1);;;;;;"select C.Codigo, C.RazonSocial from "~DBO~".CLIENTES C where C.Status Like 'HAB' and (Nacionalidad = '080' or TipoDocum = 'CUI') and C.Codigo In (Select C.Codigo from "~DBO~".CLIENTES X "~"where C.Jerarquia like SubString(X.Jerarquia,1,Charindex('000',X.Jerarquia)-1)+'%' "~"and X.Codigo In ("~Pipe2Comillas(Var('MMCPRES'))~")) order by C.Codigo"
Cantidad       : 'Cantidad'       ; ; ; ;  ;  ;CANTIDAD>0;'La Cantidad debe ser Positiva';NO;;IF(VACIO(OPERACIONREF) o MODI o Incluido(ABM,'E'),CANTIDAD,OPREF.CANTIDAD);;;;;'####,###,###,###.##'

FechaOp2       : 'Fecha Origen'   ;1;2; ;NO;  ;;;;FSYS;
FechaOp        : 'Fecha Conc.'    ; ;2; ;VerificaAcceso('OPFVALOR');  ;EsHabil(FECHAOP,'ARG');'Fecha Conc.Incorrecta';NO;FSYS;
Plazo          : 'Plazo'          ; ;2; ;  ;  ;PLAZO>0 y PLAZO<29372;'El Plazo debe ser > 0 y < 29372';NO;1;IF(VACIO(OPERACIONREF) o Incluido(ABM,'E') o EqStr(CAMPOEDITADO,'FechaVto') o EqStr(CAMPOEDITADO,'FechaOp'),IF(EqStr(CAMPOEDITADO,'FechaOp'),PLAZO,FECHAVTO-FECHAOP),OPREF.PLAZO));
FechaVto       : 'Fecha Vto.'     ;5;2; ;  ;  ;ESHABIL(FECHAVTO,'ARG');'No es un Dia Habil';NO;FECHAOP+PLAZO;FECHAOP+PLAZO;

MB1            : 'Periodo|Libre|Mensual|Bimestral|Trimestral|Semestral' ;7;1;;;;;;;0;IF(VACIO(OPERACIONREF) o Incluido(ABM,'E') ,MB1,OPREF.MB1)
PeriodoInts    : 'Periodo Ints.'  ;8;1; ;;;;;;1;IF(NOVACIO(OPERACIONREF) y [Not EqStr(CAMPOEDITADO,'MB1')] y [Not EqStr(CAMPOEDITADO,'Plazo')] y [Not EqStr(CAMPOEDITADO,'FechaVto')],OPREF.PERIODOINTS,IF(EqStr(CAMPOEDITADO,'MB1') o MB1<>0 o [Incluido(ABM,'E') y [Not EqStr(CAMPOEDITADO,'Plazo')] y [Not EqStr(CAMPOEDITADO,'FechaVto')]],IF(MB1=0,PERIODOINTS,IF(MB1=1,30,IF(MB1=2,60,IF(MB1=3,90,180)))),PLAZO));
Cuotas1        : 'Cuotas'         ;8;2; ;NO;;;;;;IF(((PLAZO MOD PERIODOINTS)/PERIODOINTS)>=0.5,(PLAZO DIV PERIODOINTS)+1,PLAZO DIV PERIODOINTS)
MB4            : 'Corr.Liq.|Sig.Habil|Ant.Habil|Sig.Modi.|Ant.Modi.'    ;9;1;;;CUOTAS1<>1;;;;0;IF(VACIO(OPERACIONREF) o Incluido(ABM,'E'),MB4,OPREF.MB4)
DiasAnio       : 'Anio Base'     ;10;1; ;;;;;;1;IF(VACIO(OPERACIONREF) o Incluido(ABM,'E') ,DIASANIO,OPREF.DIASANIO)
DiasMes        : 'Mes Base'      ;10;2; ;;PERIODOINTS<>PLAZO;;;;1;IF(VACIO(OPERACIONREF) o Incluido(ABM,'E'),DIASMES,OPREF.DIASMES)
VPRE5          : 'VPRE5'         ;11;1; ;NO;NO;;;;;(PERIODOINTS - 30)
VPRE6          : 'VPRE6'         ;11;2; ;NO;NO;;;;;(PERIODOINTS DIV 30)

MB2            : 'Tasa|Fija|Variable';12;1; ;  ;;;;;0;IF(VACIO(OPERACIONREF) o Incluido(ABM,'E') ,MB2,OPREF.MB2)
TipoTasa       : 'Tipo Tasa'         ;12;2; ;  ;MB2=1;;;;;IF(VACIO(OPERACIONREF) o Incluido(ABM,'E') ,TIPOTASA,OPREF.TIPOTASA);;;;;;"Tipo1 = 'P' ";
Precio1        : 'Tasa N.A.'         ;13;1; ;  ;;PRECIO1>=0; 'La Tasa No puede ser Negativa';NO;;IF(VACIO(OPERACIONREF) o Incluido(ABM,'E') o MB2 = 0,PRECIO1,OPREF.PRECIO1);;;;;'####.########'
TasaBase       : 'Tasa Base'         ;13;2; ;NO;MB2=1;;;;;IF([MB2=1 y NoVacio(TIPOTASA)] o Incluido(ABM,'E') ,IF(MB2=1 y NoVacio(TIPOTASA),TasaProducto(TIPOTASA,TIPOOP,ESPECIE,PERIODOINTS,1,NO,FECHAOP),TASABASE),OPREF.TASABASE);;;;;'####.########'
Precio2        : 'Tasa E.M.'         ;13;2; ;NO;MB2=0 y CUOTAS1<=1;;;;IF(MB2=1,0,((1+ PRECIO1*PLAZO/(DIASA(DIASANIO,FECHAVTO)*100))^(30/PLAZO)-1)*100);IF(MB2=1,0,((1+ PRECIO1*PLAZO/(DIASA(DIASANIO,FECHAVTO)*100))^(30/PLAZO)-1)*100);;;;;'####.########' 
**la tabla TASASPRODUCTO que no existe en STDCORP
*VPRE1          : 'T.Transf.'          ;1;1;2;NO;NO;;;;;IF(MB2=1,0,TasaProducto('TRANSF',TIPOOP,ESPECIE,PLAZO,1,SI,FECHAOP));;;;;'####.########'
VPRE1          : 'T.Transf.'          ;1;1;2;NO;NO;;;;;0;;;;;'####.########'
VPRE4          : 'T.Transf.'          ; ;1;2;NO;NO;;;;;IF(MB2=1,VPRE1,IF([(PLAZO DIV PERIODOINTS)=1] O [PLAZO>365 Y PERIODOINTS=180],VPRE1,IF(PLAZO<=365,(((1+VPRE1*PLAZO/(DIASA(DIASANIO,FECHAVTO)*100))^(PERIODOINTS/PLAZO))-1)*DIASA(DIASANIO,FECHAVTO)*100/PERIODOINTS,(((1+(VPRE1/200))^(PERIODOINTS/180))-1)*360*100/PERIODOINTS)));;;;;'####.########'
Precio4        : 'T.Transf.'         ;14;1; ;  ;;PRECIO4<>0 ;'La Tasa de Transferencia es Nula';SI;;IF(Incluido(ABM,'E') y [Not EqStr(CAMPOEDITADO,'Plazo')] y [Not EqStr(CAMPOEDITADO,'Especie')] y [Not EqStr(CAMPOEDITADO,'FechaOp')] y [Not EqStr(CAMPOEDITADO,'FechaVto')],PRECIO4,VPRE4);;;;;'####.########'
VPRE9          : 'NII'               ;14;2; ;NO;;;;;;PRECIO1-PRECIO4

RB4            : 'Ajuste Int.'       ;15;1; ;;CUOTAS1<>1;;;;1;IF(VACIO(OPERACIONREF) o Incluido(ABM,'E') ,RB4,OPREF.RB4)

Cuenta2        : 'Direc.Fondos'      ;16;1; ;;;;;;;IF(Incluido(ABM,'E'),CUENTA2,QUERY("Select Codigo from "~DBO~".CUENTAS where Cliente = '"~CLIENTE1~"' and (Especies = '"~ESPECIE~"|' or Especies = 'MONEDA|') and Estado = 'HAB' and Permanente = 'SI' and Mercado is Null "));;;;;;"Cliente = '"~CLIENTE1~"' and Estado = 'HAB' and Mercado is Null   and TipoCuenta Not In ('FCI','INV') ";
*No existe tabla EQUIPOS
*Responsable1   : 'Responsable'       ;17;1; ;;;NoVacio(RESPONSABLE1);'Debe indicar responsable';NO;;if(MODI o Incluido(ABM,'E'),RESPONSABLE1,IF(NOVACIO(OPERACIONREF),OPREF.RESPONSABLE1,Query("Select Responsable from "~DBO~".EQUIPOS where Codigo='"~BuscarCampo('CLIENTES','Equipo','Codigo',CLIENTE1)~"' and (Negocio= 'MM' or Negocio= NULL or Negocio=' ')")));;;;;;@HRESPONSAB
Responsable1   : 'Responsable'   ;16;1; ;;;;'Debe indicar responsable';NO;;if(MODI o Incluido(ABM,'E'),RESPONSABLE1,IF(NOVACIO(OPERACIONREF),OPREF.RESPONSABLE1,RESPONSABLE1));;;;;;@HRESPONSAB
*Book1          : 'Book'              ;18;1; ;;;BookValido2(VEHICULO1,TIPOOP,RESPONSABLE1,BOOK1);'Book Invalido';NO;BookDefault(VEHICULO1,TIPOOP,RESPONSABLE1);BookDefault(VEHICULO1,TIPOOP,RESPONSABLE1);;;;;;
Operador       :                     ;15;2; ;NO;  ;;;;USUARIOACTIVO;
Vehiculo1      : 'Vehiculo '         ;17;2; ;  ;  ;NoVacio(VEHICULO1);'Debe Ingresar el Vehiculo';NO;
UDN1           : 'Division'          ;18;2; ;NO;  ;NoVacio(UDN1);'El Usuario debe tener Division asignada';NO;BuscarCampo('USRVEHICULO','Udn','Codigo',USUARIOACTIVO);BuscarCampo('USRVEHICULO','Udn','Codigo',USUARIOACTIVO);;;;;;

TotalIntereses : 'Interes'            ;2;1;2;NO;CUOTAS1<=1;;;;;ROUND(CANTIDAD*(PRECIO1+TASABASE)*PLAZO/(DIASA(DIASANIO,FECHAVTO)*100),2);
TotalBrutoCli1 : 'Monto'              ;3;1;2;NO;CUOTAS1<=1;;;;;CANTIDAD+TOTALINTERESES;;;;;'####,###,###,###.##'
TotalNetoCli1  : 'Monto Total'        ; ;1;2;NO;  ;;;;;TOTALBRUTOCLI1+TOTALIVA+TOTALGASTOS+TOTALIMPUESTOS+TOTALAUX2
