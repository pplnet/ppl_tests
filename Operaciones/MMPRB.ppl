*VPRE3          : 'Max'                ; ;1;2;NO;NO;;;;;IF(MB2=1,0,TasaProducto('TRANSF',TIPOOP,ESPECIE,PLAZO,3,SI,FECHAOP));;;;;'####.########'
VPRE2          : 'Min'                ; ;1;2;NO;NO;;;;;0;;;;;'####.########'
VPRE3          : 'Max'                ; ;1;2;NO;NO;;;;;0;;;;;'####.########'

NrOperacion3   : 'Renueva Op.'    ;2;2;2;NO;
NrOperacion2   : 'Acuerdo'        ;3;2;2;NO;
OficialCuenta  : 'Oficial Cta.'   ;4;2;2;NO;
CB9            : 'Pre-Cancelada'  ;5;2;2;NO;
FechaPrecan    : 'F.Original'     ;6;2;2;NO;CB9=1;
TasaPrecan     : 'TNA Original'   ;7;2;2;NO;CB9=1;
VCAN2          : 'Plazo Ori.'     ;8;2;2;NO;CB9=1;;;;;FECHAPRECAN-FECHAOP;;;;;'####'
VCAN4          : 'Plazo Rem.'     ;9;2;2;NO;CB9=1;;;;;FECHAPRECAN-FECHAVTO;;;;;'####'
TotalAux3      : 'Int. Original' ;10;2;2;NO;CB9=1;;;;;

MB5            : 'Modo|S/Interes|S/Capital|Fijo';11;2;2;NO;CB9=1;
PorArancel     : '% Penalty'    ;12;2;2;NO;CB9=1;
TotalAux2      : 'M.Penalty'    ;13;2;2;NO;CB9=1;

Cliente5       : 'Grupo Ec.'      ;6;1;2;NO;;;;;;QUERY("Select Controlante from "~DBO~".GRUPOSECONOMICOS where TipoGrupo = 'LC' and Cliente = '"~CLIENTE1~"' ")
Cotizacion1    : 'Tipo Cambio'    ; ; ;2;NO;;;;;;CotizacionC(ESPECIE,,,,FSYS,1,SI,'USD')
TotalAux1      : 'Afecta USD'     ; ; ;2;NO;;;;;;CANTIDAD*COTIZACION1
