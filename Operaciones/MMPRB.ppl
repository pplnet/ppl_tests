VPRE10         : 'T.Tr.Pas.'      ; ; ; ;NO;NO;;;;;
DeltaTasa      : 'T.Tr.Pas.'     ;10;1;2;NO;;;;;;IF(Incluido(ABM,'E') y [Not EqStr(CAMPOEDITADO,'Plazo')] y [Not EqStr(CAMPOEDITADO,'Especie')] y [Not EqStr(CAMPOEDITADO,'FechaOp')] y [Not EqStr(CAMPOEDITADO,'FechaVto')] y [Not EqStr(CAMPOEDITADO,'Precio4')],DELTATASA,VPRE10);;;;;'####.########'

Observac2      : 'Obs.Anulacion' ;12;1;2;NO;INSTANCIA=30;;;;
*Mercado4       : 'Area'          ;13;1;2;NO;;;;;;BuscarCampo('Clientes','TipoCliente','Codigo',CLIENTE1)
Mercado4       : 'Area'          ;13;1;2;NO;;;;;;

VTXT1          : 'Cond.IVA'      ;13;3;2;NO;NO;;;;;BuscarCampo('CLIENTES','CondicionIVA','Codigo',CLIENTE1);
PorCaucion     : 'Por.IVA'       ;14;1;2;;CUOTAS1<=1;PORCAUCION>=0;'IVA Negativo';NO;;IF(Incluido(VTXT1,'INS|RES'),Var('IVAMINIMO'),Var('IVA'));;;;;'###,###.##'
TotalIVA       : 'IVA'           ;15;1;2;NO;CUOTAS1<=1;;;;;ROUND(TOTALINTERESES*PORCAUCION/100,2);;;;;'##,###,###.##'

PorImpuestoBolsa:'Por.Percepcion';14;2;2;;CUOTAS1<=1;PORIMPUESTOBOLSA>=0;'Percepcion Negativa';NO;;IF(Incluido(VTXT1,'INS'),Var('RG3337'),IF(Incluido(VTXT1,'NOI'),Var('RNI'),IF(Incluido(VTXT1,'NOC'),Var('IVANOCATEG'),0)));;;;;'###,###.##'
VCAN1          :                 ;16;2;2;NO;NO;;;;;ROUND(TOTALINTERESES*PORIMPUESTOBOLSA/100,2)
TotalGastos    : 'Percepcion'    ;15;2;2;NO;CUOTAS1<=1;;;;;IF(Incluido(VTXT1,'INS'),IF(TOTALINTERESES>Var('INSMONTO') o VCAN1>Var('INSPERCEP'),VCAN1,0),IF(Incluido(VTXT1,'NOI'),VCAN1,IF(Incluido(VTXT1,'NOC'),IF(TOTALINTERESES>Var('NOCMONTO') o VCAN1>Var('NOCPERCEP'),VCAN1,0),0)));;;;;'##,###,###.##'

VTXT2          : 'Persona Fis.'  ;16;3;1;NO;NO;;;;;BuscarCampo('CLIENTES','Persona','Codigo',CLIENTE1);
PorDerechoBolsa: 'Por.Endeuda.'  ;16;1;2;;[CUOTAS1<=1] y [Not EqStr(VTXT2,'SI')];PORDERECHOBOLSA>=0;'Endeudamiento Negativo';NO;;IF(EqStr(VTXT2,'SI'),0,Var('IMPENDEU'));;;;;'###,###.##'
TotalImpuestos : 'Endeudamiento' ;17;1;2;NO;CUOTAS1<=1;;;;;IF((PRECIO1+TASABASE)<=Var('TASAENDEU'),ROUND(TOTALINTERESES*PORDERECHOBOLSA/100,2),ROUND((CANTIDAD*Var('TASAENDEU')*PLAZO/(DIASA(DIASANIO,FECHAVTO)*100))*PORDERECHOBOLSA/100,2));;;;;'##,###,###.##'
TotalBrutoCli3 : 'Tot.Intereses' ;  ; ;2;NO;NO;;;;;Sum(CUOTASL,13)+CUOTAS1-CUOTAS1;NO

ContraEspecie  :                  ;1;3;2;NO;NO;;;;;COTIZAEN(ESPECIE);
Cliente2       :                  ; ;3;2;NO;NO;;;;;CLIENTE1
*Campo PLAZO en LimConsumido arma la consulta PlazoHasta
*VPRE7          : 'LimCons'        ; ;3;2;NO;NO;;;;;LimConsumido(CLIENTE1,IF(EqStr(ESPECIE,'ARP'),'RE04','RE43'),'USD',0,VEHICULO1,,,NROPERACION,,,,,,,,,PLAZO);;;;;
VPRE7          : 'LimCons'        ; ;3;2;NO;NO;;;;;LimConsumido(CLIENTE1,IF(EqStr(ESPECIE,'ARP'),'RE04','RE43'),'USD',0,VEHICULO1,,,NROPERACION,,,,,,,,,);;;;;
*Campo PLAZO en LimAsignado arma la consulta PlazoDesde/PlazoHasta
*VPRE8          : 'LimAsig'        ; ;3;2;NO;NO;;;;;LimAsignado(CLIENTE1, IF(EqStr(ESPECIE,'ARP'),'RE04','RE43'),'USD',,,,,,,,,,,PLAZO);;;;;
VPRE8          : 'LimAsig'        ; ;3;2;NO;NO;;;;;LimAsignado(CLIENTE1, IF(EqStr(ESPECIE,'ARP'),'RE04','RE43'),'USD',,,,,,,,,,,);;;;;
FormaLiquidacion2:'MarcaRep'      ; ;3;2;NO;NO;;;;0;
FormaLiquidacion1:'Marca'         ; ;3;2;NO;NO;;;;;IF([VPRE8 = VPRE7] y FORMALIQUIDACION2 = 0,0,2)
TotalAux4      : 'DesAfecta USD'  ; ;3;2;NO;NO;;;;;IF(FORMALIQUIDACION2 = 1,IF(TOTALCAUCION>TOTALAUX1,TOTALAUX1,TOTALCAUCION),IF((VPRE8 - VPRE7)>=TOTALAUX1,TOTALAUX1,(VPRE8-VPRE7)))

TotalCaucion   : 'Monto Op.'      ; ; ;2;NO;NO;;;;;

LISTA: CUOTAS1 > 1; CUOTAS1;
  Cantidad1: 'Imp Amort'    ;NO;;;;;IF(Fila=CUOTAS1,CANTIDAD,0);120;;Numero;'###,###,###,###,###.##';NO;NO;'1'
  Plazo1   : 'Plazo'        ;NO;;;;;IF(Fila=CUOTAS1,IF(((PLAZO MOD PERIODOINTS)/PERIODOINTS)>=0.5,(PLAZO MOD PERIODOINTS),PERIODOINTS+(PLAZO MOD PERIODOINTS)),PERIODOINTS);40;;Numero;'####'

  Fecha1   : 'F.Origen'     ;NO;  ;;;;IF(Fila=1,FECHAOP,IF(RB4=0,CUOTASL.FECHA2[Fila-1],CUOTASL.FECHA3[Fila-1]));90;;Fecha
  Fecha4   : 'F.Vto4'       ;NO;NO;;;;IF(Fila=CUOTAS1,FECHAVTO,FinDeMes(CUOTASL.FECHA1[Fila]+VPRE5,SI)+Dia(FechaOp));90;;Fecha
  Fecha5   : 'F.Vto5'       ;NO;NO;;;;IF(Fila=CUOTAS1,FECHAVTO,IF([[Mes(CUOTASL.FECHA4[Fila]) >= Mes(CUOTASL.FECHA1[Fila])] y [(Mes(CUOTASL.FECHA4[Fila])-Mes(CUOTASL.FECHA1[Fila]))<>VPRE6]] o [[Mes(CUOTASL.FECHA4[Fila]) < Mes(CUOTASL.FECHA1[Fila])] y [((Mes(CUOTASL.FECHA4[Fila])+12)-Mes(CUOTASL.FECHA1[Fila]))<>VPRE6]] o [Fila>1 y Mes(CUOTASL.FECHA1[Fila])<>Mes(CUOTASL.FECHA2[Fila-1])],IF([Fila>1] y [Mes(CUOTASL.FECHA1[Fila])<>Mes(CUOTASL.FECHA2[Fila-1])],FinDeMes(FinDeMes(CUOTASL.FECHA1[Fila]+VPRE5+IF(MB4=1,0,-Dia(CUOTASL.FECHA1[Fila])),SI)+1,SI)+IF(MB4=1,Dia(FechaOp),0),FinDeMes(FinDeMes(IF([(Mes(CUOTASL.FECHA1[Fila]+VPRE5)-(Mes(CUOTASL.FECHA1[Fila])))<>(VPRE6-1)],CUOTASL.FECHA1[Fila]+VPRE5-VPRE6,CUOTASL.FECHA1[Fila]+VPRE5),SI)+1,SI)),CUOTASL.FECHA4[Fila]));90;;Fecha
  Fecha2   : 'F.Vto.'       ;NO;  ;;;;IF(Fila=CUOTAS1,FECHAVTO,IF(MB1=0,CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila],CUOTASL.FECHA5[Fila]));90;;Fecha
  Fecha3   : 'F.Liq.'       ;NO;  ;[CUOTAS1=1] o [CUOTASL.FECHA3[Fila]>=FECHAOP2];'Cuotas Vencidas';;IF(ESHABIL(CUOTASL.FECHA2[Fila],'ARG'),CUOTASL.FECHA2[Fila],HABILES(CUOTASL.FECHA2[Fila],IF(MB4=0,1,IF(MB4=1,-1,IF(MB4=2,IF(Mes(CUOTASL.FECHA2[Fila])=Mes(HABILES(CUOTASL.FECHA2[Fila],1,'ARG',SI)),1,-1),IF(Mes(CUOTASL.FECHA2[Fila])=Mes(HABILES(CUOTASL.FECHA2[Fila],-1,'ARG',SI)),-1,1)))),'ARG',SI));90;;Fecha

  Fecha6   : 'F.Vto6'       ;NO;NO;;;;FinDeMes(CUOTASL.FECHA1[Fila]+VPRE5,SI)+Dia(CUOTASL.FECHA1[Fila]);90;;Fecha
  Fecha7   : 'F.Vto7'       ;NO;NO;;;;IF([[Mes(CUOTASL.FECHA6[Fila]) >= Mes(CUOTASL.FECHA1[Fila])] y [(Mes(CUOTASL.FECHA6[Fila])-Mes(CUOTASL.FECHA1[Fila]))<>VPRE6]] o [[Mes(CUOTASL.FECHA6[Fila]) < Mes(CUOTASL.FECHA1[Fila])] y [((Mes(CUOTASL.FECHA6[Fila])+12)-Mes(CUOTASL.FECHA1[Fila]))<>VPRE6]],FinDeMes(FinDeMes(IF((Mes(CUOTASL.FECHA1[Fila]+VPRE5)-(Mes(CUOTASL.FECHA1[Fila])))<>(VPRE6-1),CUOTASL.FECHA1[Fila]+VPRE5-VPRE6,CUOTASL.FECHA1[Fila]+VPRE5),SI)+1,SI),CUOTASL.FECHA6[Fila]);90;;Fecha
  Plazo2   : 'Dias'         ;NO;  ;;;;IF(RB4=0,IF(MB1=0,IF(DIASMES=0,PERIODOINTS+(CUOTASL.FECHA2[Fila]-CUOTASL.FECHA7[Fila]),CUOTASL.FECHA2[Fila]-CUOTASL.FECHA1[Fila]),IF(DIASMES=0,IF(Fila=CUOTAS1,PERIODOINTS+(CUOTASL.FECHA2[Fila]-CUOTASL.FECHA7[Fila]),PERIODOINTS),CUOTASL.FECHA2[Fila]-CUOTASL.FECHA1[Fila])),IF(MB1=0,IF(DIASMES=0,PERIODOINTS+(CUOTASL.FECHA3[Fila]-CUOTASL.FECHA7[Fila]),CUOTASL.FECHA3[Fila]-CUOTASL.FECHA1[Fila]),IF(DIASMES=0,PERIODOINTS+(CUOTASL.FECHA3[Fila]-CUOTASL.FECHA7[Fila]),CUOTASL.FECHA3[Fila]-CUOTASL.FECHA1[Fila])));40;;Numero;'####'

  Precio1  : 'Tasa N.A.'    ;NO;;;;;PRECIO1;80;;Numero;'###,###.######';NO;NO;
  Cantidad2: 'Interes'      ;NO;;;;;ROUND(CANTIDAD*(TASABASE+CUOTASL.PRECIO1[Fila])*CUOTASL.PLAZO2[Fila]/(DIASA(DIASANIO,FECHAVTO)*100),2);120;NO;Numero;'###,###,###,###,###.##';NO;NO;
  Total1   : 'Monto'        ;NO;;;;;(CUOTASL.CANTIDAD1[Fila]+CUOTASL.CANTIDAD2[Fila]+CUOTASL.CANTIDAD4[Fila]+CUOTASL.TOTAL3[Fila]+CUOTASL.TOTAL6[Fila]);120;;Numero;'###,###,###,###,###.##'

  Precio4  : 'Por.IVA'      ;;;CUOTASL.PRECIO4[Fila]>=0;'IVA Negativo';;IF(Incluido(VTXT1,'INS|RES'),Var('IVAMINIMO'),Var('IVA'));80;;Numero;'###,###.######';NO;NO;
  Cantidad4: 'IVA'          ;NO;;;;;ROUND(CUOTASL.CANTIDAD2[Fila]*CUOTASL.PRECIO4[Fila]/100,2);120;;Numero;'###,###.######';NO;NO;
  Tasa1    :'Por.Percepcion';;;CUOTASL.TASA1[Fila]>=0;'Percepcion Negativa';;IF(Incluido(VTXT1,'INS'),Var('RG3337'),IF(Incluido(VTXT1,'NOI'),Var('RNI'),IF(Incluido(VTXT1,'NOC'),Var('IVANOCATEG'),0)));80;;Numero;'###,###.######';NO;NO;
  Total2   :'LALA'          ;NO;NO;;;;ROUND(CUOTASL.CANTIDAD2[Fila]*CUOTASL.TASA1[Fila]/100,2);120;;Numero;'###,###.######';NO;NO;
  Total3   :'Percepcion'    ;NO;;;;;IF(Incluido(VTXT1,'INS'),IF(CUOTASL.CANTIDAD2[Fila]>Var('INSMONTO') o CUOTASL.TOTAL2[Fila]>Var('INSPERCEP'),CUOTASL.TOTAL2[Fila],0),IF(Incluido(VTXT1,'NOI'),CUOTASL.TOTAL2[Fila],IF(Incluido(VTXT1,'NOC'),IF(CUOTASL.CANTIDAD2[Fila]>Var('NOCMONTO') o CUOTASL.TOTAL2[Fila]>Var('NOCPERCEP'),CUOTASL.TOTAL2[Fila],0),0)));120;;Numero;'###,###.######';NO;NO;
  Tasa2    :'Por.Endeuda.'  ;;;CUOTASL.TASA2[Fila]>=0;'Endeudamiento Negativo';;IF(EqStr(VTXT2,'SI'),0,Var('IMPENDEU'));80;;Numero;'###,###.######';NO;NO;
  Total6   :'Endeudamiento' ;NO;;;;;IF((TASABASE+CUOTASL.PRECIO1[Fila])<=Var('TASAENDEU'),ROUND(CUOTASL.CANTIDAD2[Fila]*CUOTASL.TASA2[Fila]/100,2),ROUND((CANTIDAD*Var('TASAENDEU')*CUOTASL.PLAZO2[Fila]/(DIASA(DIASANIO,FECHAVTO)*100))*CUOTASL.TASA2[Fila]/100,2));120;;Numero;'###,###.######';NO;NO;

  *@CONDMMPRB

LIMITES
FechaOp;Cliente1;IF(EqStr(ESPECIE,'ARP'),'04','43')    ;'USD';;TotalAux1              ;TipoOp~' '~Especie; NoVacio(Cliente1) y FechaVto >= Fsys y [VPRE8 = VPRE7]                                 y FechaOp<=FSys ;Vehiculo1;;;;;;;;;;Plazo
FechaOp;Cliente1;IF(EqStr(ESPECIE,'ARP'),'RE04','RE43');'USD';;TotalAux1              ;TipoOp~' '~Especie; NoVacio(Cliente1) y FechaVto >= Fsys y [(VPRE8 - VPRE7)>=TotalAux1]                    y FechaOp<=FSys ;Vehiculo1;;;;;;;;;;Plazo
FechaOp;Cliente1;IF(EqStr(ESPECIE,'ARP'),'RE04','RE43');'USD';;(VPRE8-VPRE7)          ;TipoOp~' '~Especie; NoVacio(Cliente1) y FechaVto >= Fsys y [(VPRE8 - VPRE7)< TotalAux1] y [VPRE8 <> VPRE7] y FechaOp<=FSys ;Vehiculo1;;;;;;;;;;Plazo
FechaOp;Cliente1;IF(EqStr(ESPECIE,'ARP'),'04','43')    ;'USD';;TotalAux1-(VPRE8-VPRE7);TipoOp~' '~Especie; NoVacio(Cliente1) y FechaVto >= Fsys y [(VPRE8 - VPRE7)< TotalAux1] y [VPRE8 <> VPRE7] y FechaOp<=FSys ;Vehiculo1;;;;;;;;;;Plazo

FechaOp;Cliente1;'CREDIT';'USD';;TotalAux1;TipoOp~' '~Especie; NoVacio(Cliente1) y FechaVto >= Fsys y FechaOp<=FSys;Vehiculo1;

FechaOp;Cliente5;IF(EqStr(ESPECIE,'ARP'),'04','43');'USD';;TotalAux1;TipoOp~' '~Especie; NoVacio(Cliente1) y NoVacio(Cliente5) y FechaVto >= Fsys y FechaOp<=FSys ;Vehiculo1;;;;;;;;;;Plazo
FechaOp;Cliente5;'CREDIT';'USD';;TotalAux1;TipoOp~' '~Especie                          ; NoVacio(Cliente1) y NoVacio(Cliente5) y FechaVto >= Fsys y FechaOp<=FSys ;Vehiculo1;

MOVIMIENTOS
FechaOp ;Cliente1 ;Especie ;;;;MERCADO;Vehiculo1;1;               Cantidad;;'Prestamo Bullet'               ;SI;NO;1;NOVACIO(CLIENTE1)             ;;;;1;'MMPR';;;;;;;;UDN1
FechaVto;Cliente1 ;Especie ;;;;MERCADO;Vehiculo1;1;-ROUND(TotalNetoCli1,2);;'Vencimiento de Prestamo Bullet';SI;NO;1;NOVACIO(CLIENTE1) Y CUOTAS1<=1;;;;1;'MMPR';;;;;;;;UDN1

MOVCUOTAS
CuotasL.Fecha3[Fila];Cliente1 ;Especie ;;Vehiculo1;1;-ROUND(CuotasL.Total1[Fila],2);'Vencimiento Cuota '~TIPOOP;SI;NO;;NOVACIO(CLIENTE1) Y CUOTAS1>1;;;;(Fila+1);'MMPR';;;;;;;;UDN1

CASHFLOW
FechaOp  ;Vehiculo1;;;Especie;TipoOp;; -Cantidad;3;;UDN1
FechaVto ;Vehiculo1;;;Especie;TipoOp;; ROUND(TotalBrutoCli1,2);3;NOVACIO(CLIENTE1) Y CUOTAS1<=1;UDN1

CASHFLOWCUOTAS
CuotasL.Fecha3[Fila];Vehiculo1;;;Especie;TipoOp;;ROUND(CuotasL.Cantidad1[Fila]+CuotasL.Cantidad2[Fila],2);3;NOVACIO(CLIENTE1) Y CuotasL.Cantidad1[Fila]+CuotasL.Cantidad2[Fila]>0;UDN1

*POSTEDICION
*Incluido(ABM,'A|M|E') y FechaOp <= Fsys; 'CONPOS'; NrOperacion1 = NrOperacion

SQL:EqStr(ABM,'E')
"Delete from "~DBO~".EXCEPCIONES where NrOperacion = '"~NrOperacion~"' "

BITS
1;1
2;0
7;0
12;0
13;0
14;0
28;0
30;0
