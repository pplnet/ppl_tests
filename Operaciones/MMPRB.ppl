80;1;FW=1 y QUERY("Select Valor from "~DBO~".OPERACIONESBITS where NrOperacion = '"~NrOperacion~"' and NrBit = 2 ") = 0 y QUERY("Select Valor from "~DBO~".OPERACIONESBITS where NrOperacion = '"~NrOperacion~"' and NrBit = 7 ") = 0 y QUERY("Select Valor from "~DBO~".OPERACIONESBITS where NrOperacion = '"~NrOperacion~"' and NrBit = 14 ") = 0 
28;0;FW=2
30;1;FW=2
2;0;FW=2
7;0;FW=2
14;0;FW=2

