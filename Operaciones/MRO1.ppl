CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',VEHICULO1)
FechaOp         : 'Fecha Conc.'                ;1;1;;NOT EV y VERIFICAACCESO('OPFVALOR');;EsHabil(FECHAOP,'ARG') Y ESHABIL(FECHAOP,TABLAFERIADOS1) Y FECHAOP<=FECHAEX4 ;'La Fecha de Concertacion debe ser Habil y no puede ser posterior al LastTradingDate';NO;FSYS;
@VEHITO
MB3             : 'Tipo|COMPRA |VENTA'         ;2;1;;NOT EV;;;;;0;
MB1             : '    |CALL   |PUT'           ;;;;NOT EV;;;;;0;
MB4             : '|Equit|Comm|SE|FX|Indice|Tasa|Euro|Fut|'    ;3;1;;NO;;;;;;IF(EqStr(VTXT1,'EQU'),0,IF(EqStr(VTXT1,'COM'),1,IF(EqStr(VTXT1,'FIX'),2,IF(EqStr(VTXT1,'CUR'),3,IF(EqStr(VTXT1,'IND'),4,IF(EqStr(VTXT1,'TAS'),5,IF(EqStr(VTXT1,'EUR'),6,IF(EqStr(VTXT1,'FUT'),7,-1))))))))
