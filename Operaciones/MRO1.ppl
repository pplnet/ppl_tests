CB8             : 'Ejercicio|No|Si'            ;;;;NO;;;;;0
FechaVto2       : 'F_Real_Ej'                  ;;;;NO;CB8=1;
NrOperacion2    : 'Nr.Op.Futuro'               ;;;;NO;CB8=1;

