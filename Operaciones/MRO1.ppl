Cuotas1         : 'Nr Cierres'                 ;;;;NO;NO;;;;if(EqStr(ABM,'A'),0,Cuotas1);
VCAN12          : 'Cotizacion de Mercado'      ;18;2;1;No;No;;;;;COTIZACIONC(COTIZAEN(ESPECIE),,,,FECHAOP,1,SI,CONTRAESPECIE))

