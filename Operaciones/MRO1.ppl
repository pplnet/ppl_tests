Precio3         : 'TC_Venc_Com'                ;;;2;PRECIO3<>0;PRECIO3<>0;;;;
VPRE2           : 'Cot.Comision/USD'           ;10;3;;NO;NO;;;;;COTIZACIONC(CONTRAESPECIE3,,,,FECHAOP,1,SI,VAR('MONEEXTR'))

