Cantidad        : 'Cant. Ctos.'                ;8;1;;;;CANTIDAD>=1;'DEBE INGRESAR UNA CANTIDAD DE CONTRATOS POSITIVA';NO;
PrecioEj        : 'Precio Ejerc.'              ;10;1;;;;PRECIOEJ>0;'El Precio de Ejercicio Debe ser Positivo';NO;;;;;;;'#,###,###.########';;
Precio1         : 'Prima'                      ;;;;;;PRECIO1>=0;'La Prima debe ser Positiva';NO;;;;;;;'#,###,###.#######';; 

TotalNetoCli1   : 'Monto Prima'                ;;;;NO;;;;;;CANTIDAD*PRECIO1*LOTES;
FechaVto        : 'F.Liq.Prima'                ;;;;;;NoVacio(FECHAVTO) Y EsHabil(FECHAVTO,TABLAFERIADOS1);'La Fecha de Liquidacion de Prima No es Habil';NO;;HABILES(FECHAOP,1,'ARG',SI);

Operador        :                              ;;;;NO;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
