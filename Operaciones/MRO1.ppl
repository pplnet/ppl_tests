FechaEx3        : 'Pago_Com_Merc'              ;;;2;;;NOVACIO(FECHAEX3) y EsHabil(FECHAEX3,TABLAFERIADOS1);'La Fecha de Pago Comision Exchange debe ser Habil';NO;;FECHAVTO

