ContraEspecie   : 'Esp.Liq.'                   ;;;;NO;;NOVACIO(CONTRAESPECIE);'Indique la CONTRAESPECIE de la Opcion';NO;;BuscarCampo('OPCIONES2','CotizaEn','Codigo',OPCION)
FechaEx4        : 'LastTrading'                ;;;;NO;;;;;;BuscarCampo('OPCIONES2','LastTradingDate','Codigo',OPCION)
TotalAux1       : 'Notional_Amount'            ;;;;NO;;;;;;LOTES*CANTIDAD*PRECIOEJ
TablaFeriados1  : 'Feriados'                   ;;;;;;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;BuscarCampo('FERIADOS','Codigo','Codigo',BuscarCampo('ESPECIES','PaisOrigen','Codigo',CONTRAESPECIE)) 
Cotizacion1     : 'TC_Concert.'                ;;;;;Not Eqstr(CONTRAESPECIE,VAR('MONEEXTR'));Eqstr(CONTRAESPECIE,VAR('MONEEXTR')) O [COTIZACION1<=VPRE1*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE1*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE1*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE1*(1+VAR('RPRECIO2')/100),1,7);NO;;IF(Eqstr(CONTRAESPECIE,VAR('MONEEXTR')),1)
Cotizacion2     : 'TC_Vencim.'                 ;;;;COTIZACION2<>0;COTIZACION2<>0;;;;
VPRE1           : 'Cot.TC/USD'                 ;10;2; ;NO;NO;;;;;COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(CONTRAESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)
Impresa         : 'Modificado'                 ;10;3;;NO;NO;;;;0

Lotes           : 'Tamanio Contrato'           ;9;2;;NO;NO;;;;;BuscarCampo('OPCIONES2','Tamanio','Codigo',OPCION)
VTXT1           : 'Clase'                      ;;;;NO;NO;;;;;BuscarCampo('OPCIONES2','ClaseContrato','Codigo',OPCION)
TotalBrutoCli2  : 'Cant Ut.'                   ;15;1;3;NO;NO;;;;0;


ContraEspecie3  : 'Esp.Com.Inter'              ;1;1;2;;;IMPCOMMER1=0 o NOVACIO(CONTRAESPECIE3);'Moneda de Comision Intermediario INVALIDA';NO;'USD'
ImpComMer1      : 'Com_Int_Un'                 ;;;2;;;IMPCOMMER1>=0;'Debe INGRESAR un Importe Comision Intermediario';NO;;BuscarCampo('CLIENTES','Valor2','Codigo',CLIENTE1)
