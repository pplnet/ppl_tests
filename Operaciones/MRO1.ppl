Contrato        : 'ActSubyacente'              ;6;2;;NO;;NOVACIO(CONTRATO);"Indique el Contrato";NO;BuscarCampo('OPCIONES2','Contrato','Codigo',OPCION);BuscarCampo('OPCIONES2','Contrato','Codigo',OPCION);
Especie         : 'Opcion'                     ;6;1;;NO;NO;;;;OPCION;OPCION;;
Opcion          : 'Opcion'                     ;6;1;;NOT EV;;NOVACIO(OPCION);"Indique la Opcion";NO;;;;SqlSet("SELECT Codigo FROM "~DBO~".OPCIONES2 WHERE Estado='HAB' ");NO;
MensajeChequeo  : 'NombreOpcion'               ;6;1;;NO;NO;;;;BuscarCampo('OPCIONES2','Descripcion','Codigo',OPCION);BuscarCampo('OPCIONES2','Descripcion','Codigo',OPCION)

