 Fecha1    : 'Fecha Desembolso'     ;NO;;CUOTAS1=0 O [ESHABIL(CUOTASL.FECHA1[Fila],TABLAFERIADOS1) Y ESHABIL(CUOTASL.FECHA1[Fila],'ARG') Y CUOTASL.FECHA1[Fila]>=FECHAOP Y CUOTASL.FECHA1[Fila]<=FECHAVTO Y [[Fila>1 Y CUOTASL.FECHA1[Fila]>=CUOTASL.FECHA1[Fila-1]] O Fila=1]] ;'LA FECHA NO ES CORRECTA EN LA CUOTA '~Fstr(Fila, 0, 0);;;90;;Fecha;;;;;;;;RB11 = 0
