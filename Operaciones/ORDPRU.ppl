    Especie       : 'Fondo'                          ;1;1; ;NOT EV;;NOVACIO(ESPECIE)  Y DESCIENDEDEESPECIE(ESPECIE,'FONDOS');'Debe ingresar un fondo';NO;;;;;;;;IF(RB4=0 Y NoVacio(NRORDEN)," Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES','FONDOS'))~") and Status = 'HAB' AND Cotiza = '"~CONTRAESPECIE~"' "," Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES','FONDOS'))~") and Status = 'HAB'")
    ContraEspecie : 'Moneda'                         ; ; ; ;NO;;NOVACIO(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE,ESPECIE);'Debe ingresar una ContraEspecie';NO;VTXT40;IF(RB4=0 Y NoVacio(NRORDEN),BuscarCampo('ORDENES','Especie','NrOrden',NRORDEN),CotizaEn(ESPECIE))
%%else
    Especie       : 'Fondo'                          ;1;1; ;NOT EV;;NOVACIO(ESPECIE)  Y DESCIENDEDEESPECIE(ESPECIE,'FONDOS');'Debe ingresar un fondo';NO;;;;;;;;" Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES','FONDOS'))~") and Status = 'HAB'"
    ContraEspecie : 'Moneda'                         ; ; ; ;NO;;NOVACIO(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE,ESPECIE);'Debe ingresar una ContraEspecie';NO;VTXT40;CotizaEn(ESPECIE)
%%endif
