FechaOp;Vehiculo2;Especie;;;;;Vehiculo1;1;If(MB3=0,-PrecioEj, PrecioEj);;'Alta Pmo. con Vinculadas '~Especie;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;1;;;Cupon1;;;;;;;;;;;550
FechaOp;Vehiculo1;Especie;;;;;Vehiculo1;2;If(MB3=0,PrecioEj, -PrecioEj);;'Alta Pmo. con Vinculadas '~Especie;SI;SI;;;;Cuenta1;;2;;;Cupon1;;;;Book1;
FechaVto;Vehiculo1;Especie;;;;;;3;If(MB3=0,PrecioEj, -PrecioEj) ;;'Alta Pmo. con Vinculadas '~Especie;SI;SI;;;;Cuenta1;;3;;;Cupon1;;;;Book1;
FechaVto;Vehiculo1;Especie;;;;;;10;If(MB3=0,PrecioEj, -PrecioEj);;'Alta Pmo. con Vinculadas '~Especie;SI;SI;;;;Cuenta1;;4;;;Cupon1;;;;Book1;

MOVCUOTAS
CuotasL.Fecha3[Fila];Vehiculo2;Especie;;Vehiculo1;1;If(MB3=0,CuotasL.Cantidad1[Fila],-CuotasL.Cantidad1[Fila]);'Vto. Capital. con Vinculadas '~Especie;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2')) ;;;(Fila+500);Cuenta1;;(Fila+500);'CUOTAS';;Cupon1;;;;;;;;;;;500
CuotasL.Fecha3[Fila];Vehiculo1;Especie;;Vehiculo1;2;If(MB3=0,-CuotasL.Cantidad1[Fila],CuotasL.Cantidad1[Fila]);'Vto. Capital. con Vinculadas '~Especie;SI;SI;;;(Fila+600);Cuenta1;;(Fila+600);'CUOTAS';;Cupon1;;;;Book1;;;;
CuotasL.Fecha3[Fila];Vehiculo1;Especie;;;3;If(MB3=0,-CuotasL.Cantidad1[Fila],CuotasL.Cantidad1[Fila]);'Vto. Capital. con Vinculadas '~Especie;SI;SI;;;(Fila+700);Cuenta1;;(Fila+700);'CUOTAS';;Cupon1;;;;Book1;;;;
CuotasL.Fecha3[Fila];Vehiculo1;Especie;;;10;If(MB3=0,-CuotasL.Cantidad1[Fila],CuotasL.Cantidad1[Fila]);'Vto. Capital. con Vinculadas '~Especie;SI;SI;;;(Fila+800);Cuenta1;;(Fila+800);'CUOTAS';;Cupon1;;;;Book1;;;;

CuotasL.Fecha3[Fila];Vehiculo2;ContraEspecie;;Vehiculo1;1; If(MB3=0,CuotasL.Cantidad3[Fila],-CuotasL.Cantidad3[Fila]);'Vto Int. con Vinculadas '~Especie;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));; CuotasL.Cantidad3[Fila]<>0;(Fila+5000);Cuenta2;;(Fila+5000);'CUOTAS';;
CuotasL.Fecha3[Fila];Vehiculo2;If(CuotasL.Cotizacion1[Fila]<0,Especie,VAR('MONELOCA'));;Vehiculo1;1; CuotasL.Cantidad7[Fila]*If(CuotasL.Cotizacion1[Fila]<0,1,CuotasL.Cotizacion1[Fila]);'Costo Financiero CEC';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;NO y CuotasL.Cantidad7[Fila]<>0 Y NO;Fila;Cuenta2;;(Fila+2500);'CUOTAS';;
CuotasL.Fecha3[Fila];Vehiculo2;If(CuotasL.Cotizacion1[Fila]<0,Especie,VAR('MONELOCA'));;Vehiculo1;1; CuotasL.Total9[Fila]*If(CuotasL.Cotizacion1[Fila]<0,1,CuotasL.Cotizacion1[Fila]);'Impto.Int Pmo. en Ctas. Locales';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;NO y CuotasL.Total9[Fila]<>0 Y NO;Fila;Cuenta2;;(Fila+2000);'CUOTAS';;
CuotasL.Fecha3[Fila];Vehiculo2;ContraEspecie;;Vehiculo1;1;If(MB3=0, CuotasL.Total4[Fila]*If(CuotasL.Cotizacion1[Fila]<0,1,CuotasL.Cotizacion1[Fila]), -CuotasL.Total4[Fila]*If(CuotasL.Cotizacion1[Fila]<0,1,CuotasL.Cotizacion1[Fila]));'IVA  Pmo. en Ctas. Locales';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;CuotasL.Total4[Fila]<>0;Fila;Cuenta2;;(Fila+1000);'CUOTAS'
CuotasL.Fecha3[Fila];Vehiculo2;CuotasL.Especie1[Fila];;Vehiculo1;1; CuotasL.Cantidad6[Fila];'Vto. Comision CEC';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;NO y CuotasL.Cantidad6[Fila]<>0 Y NO;Fila;Cuenta2;;(Fila+1000);'CUOTAS'

POSICION2
FechaOp;Vehiculo1;Book1;IF(Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo', ESPECIE), 'FON'),'FC','SEC');Especie;IF(Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo', ESPECIE), 'FON'),'0',Cupon1);1;ContraEspecie;Cantidad;0;0;'12';MB3=1;
FechaOp;Vehiculo1;Book1;IF(Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo', ESPECIE), 'FON'),'FC','SEC');Especie;IF(Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo', ESPECIE), 'FON'),'0',Cupon1);2;ContraEspecie;Cantidad;0;0;'12';MB3=1 Y [CB15=1 O CB15=2];
FechaVto;Vehiculo1;Book1;IF(Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo', ESPECIE), 'FON'),'FC','SEC');Especie;IF(Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo', ESPECIE), 'FON'),'0',Cupon1);1;ContraEspecie;-Cantidad;0;0;'12';MB3=1;
FechaVto;Vehiculo1;Book1;IF(Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo', ESPECIE), 'FON'),'FC','SEC');Especie;IF(Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo', ESPECIE), 'FON'),'0',Cupon1);2;ContraEspecie;-Cantidad;0;0;'12';MB3=1 Y [CB15=1 O CB15=3];  
FechaOp;Vehiculo1;Book1;IF(Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo', ESPECIE), 'FON'),'FC','SEC');Especie;IF(Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo', ESPECIE), 'FON'),'0',Cupon1);1;ContraEspecie;Cantidad;0;0;'11';MB3=0;
FechaOp;Vehiculo1;Book1;IF(Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo', ESPECIE), 'FON'),'FC','SEC');Especie;IF(Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo', ESPECIE), 'FON'),'0',Cupon1);2;ContraEspecie;Cantidad;0;0;'11';MB3=0 Y [CB15=1 O CB15=2];
FechaVto;Vehiculo1;Book1;IF(Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo', ESPECIE), 'FON'),'FC','SEC');Especie;IF(Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo', ESPECIE), 'FON'),'0',Cupon1);1;ContraEspecie;-Cantidad;0;0;'11';MB3=0;
FechaVto;Vehiculo1;Book1;IF(Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo', ESPECIE), 'FON'),'FC','SEC');Especie;IF(Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo', ESPECIE), 'FON'),'0',Cupon1);2;ContraEspecie;-Cantidad;0;0;'11';MB3=0 Y [CB15=1 O CB15=3];

DEVENGADOSCUOTAS
CUOTASL.FECHA1[Fila]+1;CUOTASL.FECHA2[Fila];CUOTASL.CANTIDAD3[Fila]<>0;SI;NO;TablaFeriados1;SI;SI;'INTLEN';If(MB3=0,-CUOTASL.CANTIDAD3[Fila],CUOTASL.CANTIDAD3[Fila]);140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;ContraEspecie;;;;;;Book1;Operador;'SE';;Fstr(Fila,0,0);Especie;

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador
VACIO(OPERACIONREF);'No se puede dar de baja, Operacion Relacionada con Partida'
VCAN17=0;'No se puede dar de baja. La operacion tiene cuotas con saldo consumido x operaciones Sinteticas'

REFERENCIA
'TotalAux3='~FStr(OPREF.TotalAux3-VCAN1+Cantidad+TotalComisiones,0,2)

SQL
"UPDATE "~DBO~".COMISIONES2 Set Fecha1='"~IdxDate(FECHAOP)~"' Where NrOperacion='"~OPERACIONREF~"' and Tipo='0' and Fecha1 Is Null ";EqStr(ABM,'A') y QUERY("SELECT COUNT(*) FROM "~DBO~".COMISIONES2 WHERE NrOperacion='"~OPERACIONREF~"' and Tipo='0' ")>0 Y OPREF.TOTALAUX3=0;

POSTEDICION
NOVACIO(OPERACIONREF) y EQSTR(ABM,'A');'INCOMV';NrOperacion1=OPERACIONREF;NrOperacion2=NROPERACION;String=" Tipo  IN ('5','3')";String1=""
