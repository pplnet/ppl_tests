CONDICIONES
PRECIO1<=PRECIO4*(1+VAR('RPRECIO') /100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO') /100);'Tipo de Cambio FUERA DE RANGO: '~FSTR(PRECIO4*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO')/100),1,7)  ;SI;SI;FSYS;'RANGOPRECIO'
PRECIO1<=PRECIO4*(1+VAR('RPRECIO2')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO2')/100);'Tipo de Cambio Fuera de Rango: '~FSTR(PRECIO4*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO2')/100),1,7);SI;SI;FSYS;'RANGOPRECIO2'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'La Entidad Arranger esta deshabilitada';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'La Entidad Arranger esta Observada';SI;SI;FSYS;'CLIOBS'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE2));'La Entidad Agente esta deshabilitada';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE2));'La Entidad Agente esta Observada';SI;SI;FSYS;'CLIOBS'
FECHAOP2=Fsys;'La Fecha de Concertacion no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'

@CONDIOP

POSTEDICION
EqStr(ABM,'A');'REEMON';NrOperacion1=OPERACIONREF;Fecha1=FECHAOP2;Cantidad1=TOTALBRUTOCLI1;

EDICION
NO;'Operacion no editable. Puede borrarla y cargar una nueva';NO;

BAJA
[EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'))] y QUERY(" Select 1 From "~DBO~".OPERACIONES where TipoOp = '"~TIPOOP~"' and OperacionRef = '"~OPERACIONREF~"' and FechaOp > '"~IdxDate(FECHAOP)~"' ")<>1 y QUERY(" Select 1 From "~DBO~".MOVEJECUTADOS where NrOperacion = '"~OPERACIONREF~"' and FechaMov = (Select Fecha2 From "~DBO~".CUOTAS where Fecha1 < '"~IdxDate(FECHAOP)~"' and Fecha2 >= '"~IdxDate(FECHAOP)~"' and NrOperacion = '"~OPERACIONREF~"') and NrSaldo = 1 ")<>1;'No se puede dar de baja, Operador: '~Operador~' o existen reemisiones posteriores para la misma operacion o la cuota ya fue liquidada';

MOVIMIENTOS
FechaOp;Cliente1;Especie;;;;;Vehiculo1;1;-TotalBrutoCli1;;'ReEmision ON '~CONTRAESPECIE;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;1;
FechaOp;Cliente1;ContraEspecie;;;;;Vehiculo1;1;Cantidad;;'ReEmision de Titulo';SI;NO;;Not Incluido(Vehiculo1,Var('VLIQUIDAA'));;Cuenta2;;2;
FechaOp;Cliente1;Especie;;;;;Vehiculo1;1;-TotalIntereses;;'Intereses ReEmision ON '~CONTRAESPECIE;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;3;
FechaOp;Cliente1;Especie;;;;;Vehiculo1;1;TotalAux2;;'Comision ReEmision ON '~CONTRAESPECIE;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;4;
FechaOp;Cliente1;Especie;;;;;Vehiculo1;1;If(MB3=0,-1,1)*TotalDerechos;;IF(MB3=0,'Prima','Descuento')~' ON '~CONTRAESPECIE;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;5000;

FechaOp;Vehiculo1;ContraEspecie;;;;;;3;-Cantidad;;'ReEmision de Titulo';SI;SI;;;;Cuenta2;;11;;;;;;;Book1


