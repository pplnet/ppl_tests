Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'El Cliente esta Observado';SI;SI;FSYS;'CLIOBS'
VACIO(Corredor) o [PORCOMCOR1>=VAR('RCOMCOR1') y PORCOMCOR1<=VAR('RCOMCOR2')];'El % Comision Corredor EXCEDE Los Limites: Min.'~VAR('RCOMCOR1')~' Max.'~VAR('RCOMCOR2');NO
EqStr(Mercado,'OTC')  o [PORCOMMER1>=VAR('RCOMMER1') y PORCOMMER1<=VAR('RCOMMER2')];'El % Comision Mercado EXCEDE Los Limites: Min.'~VAR('RCOMMER1')~' Max.'~VAR('RCOMMER2');NO
SI O VACIO(CORREDOR) O [TCCOMCOR1<=TIPOCAMBIO2*(1+VAR('RPRECIO2')/100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-VAR('RPRECIO2')/100)];'Cambio COMISION CORREDOR Fuera de Rango: '~FSTR(TIPOCAMBIO2*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+VAR('RPRECIO2')/100),1,7);NO
SI O VACIO(CORREDOR) O [TCCOMCOR1<=TIPOCAMBIO2*(1+VAR('RPRECIO') /100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-VAR('RPRECIO') /100)];'Cambio  COMISION CORREDOR  FUERA DE RANGO: '~FSTR(TIPOCAMBIO2*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOPRECIO'
SI O EQSTR(MERCADO,'OTC') O [TCCOMMER1<=PORAFORO*(1+VAR('RPRECIO2')/100) Y TCCOMMER1>=PORAFORO*(1-VAR('RPRECIO2')/100)];'Cambio COMISION MERCADO Fuera de Rango: '~FSTR(PORAFORO*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(PORAFORO*(1+VAR('RPRECIO2')/100),1,7);NO
SI O EQSTR(MERCADO,'OTC') O [TCCOMMER1<=PORAFORO*(1+VAR('RPRECIO') /100) Y TCCOMMER1>=PORAFORO*(1-VAR('RPRECIO') /100)];'Cambio  COMISION MERCADO FUERA DE RANGO: '~FSTR(PORAFORO*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(PORAFORO*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOPRECIO'
NOT EQSTR (VEHICULO1,CLIENTE1);'El Cliente y el Vehiculo deben ser distintos';NO
ESTERMINAL(VEHICULO1,VEHICULO);'El Vehiculo debe ser Terminal';NO
ESTERMINAL(CLIENTE1,CLIENTE);'El Cliente debe ser Terminal';NO

[NOT NOVACIO(CLIENTE1)] o [FormaLiquidacion1=1] o [FechaPago>FechaVto] o ExisteLimite('SETTLEMENT',Cliente1,VTXT6)                                                        ; 'Settlement no asignado'                                                                  ;NO;SI;FSYS;'SETTLENOAS'
[NOT NOVACIO(CLIENTE1)] o [FormaLiquidacion1=1] o [FechaPago>FechaVto] o Not ExisteLimite('SETTLEMENT',Cliente1,VTXT6) o VtoLimite('SETTLEMENT',Cliente1,VTXT6) >= FechaOp; 'Settlement vencido el '~FECHA(VtoLimite('SETTLEMENT',Cliente1,VTXT6))                    ;si;SI;FSYS;'SETTLEVENC'
[NOT NOVACIO(CLIENTE1)] o [FormaLiquidacion1=1] o [FechaPago>FechaVto] o Not LimCancelado('SETTLEMENT',Cliente1,VTXT6)                                                    ; 'Settlement cancelado'                                                                    ;NO;SI;FSYS;'SETTLECANC'
[NOT NOVACIO(CLIENTE1)] o [FormaLiquidacion1=1] o [FechaPago>FechaVto] o LimAsignado(Cliente1,'SETTLEMENT',VTXT6) >= VCAN9                          ; 'Settlement excedido '~PYC(VCAN9-LimAsignado(Cliente1,'SETTLEMENT',VTXT6),1,0)~'.-';NO;SI;FSYS;'SETTLEEXCE'

FECHAOP2=Fsys;'La Fecha de Concertacion no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
VACIO(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR)) O  VERIFICAPERFIL(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR),'TO'~TIPOOP);'Operador no habilitado para ingresar Operaciones del Tipo '~TIPOOP;NO
@CONDCUPON

SI O Incluido(ContraEspecie,'ARP|USD') o NoVacio(VTXT18);'El Vehiculo no tiene Book Default para Monedas';NO
SI O Incluido(ContraEspecie,'ARP|USD') o NoVacio(VTXT19);'El Book default '~VTXT18~' no es valido';NO
SI O Incluido(ContraEspecie,'ARP|USD') o EqStr(VTXT20,Vehiculo1);'El Book default '~VTXT18~' corresponde a otro vehiculo';NO

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

SQL
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('COTORNOAS','COTORVENC','COTOREXCE','SETTLENOAS','SETTLEVENC','SETTLECANC') ";EqStr(ABM,'E')
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('SETTLEEXCE','CONTNOAS','CONTVENC','CONTCANC','CONTEXCE')";EqStr(ABM,'E')

MOVIMIENTOS
FechaVto ;Cliente1;Especie       ;;;;;Vehiculo1;1;      -Cantidad;;'Compra de Titulo';SI; Incluido(Vehiculo1,Var('VLIQUIDAA'));;PaseCB=0;;Cuenta1;;1;;;Cupon1;
FechaPago;Cliente1;ContraEspecie ;;;;;Vehiculo1;1;  TotalNetoCli1;;'Compra Imp. Liquidar';SI; Incluido(Vehiculo1,Var('VLIQUIDAA'));;PaseCB=0;;Cuenta2;;2;

FechaPago;Cliente1;ContraEspecie;;;;;Vehiculo1;1;  ImpComMer1 ;;'Comision Derecho Mercado';SI; Incluido(Vehiculo1,Var('VLIQUIDAA'));;PaseCB=0;;Cuenta2;;3;
FechaPago;Cliente1;ContraEspecie;;;;;Vehiculo1;1;  TotalGastos ;;'IVA Comision Mercado';SI; Incluido(Vehiculo1,Var('VLIQUIDAA'));;PaseCB=0;;Cuenta2;;4;
FechaPago;Cliente1;ContraEspecie;;;;;Vehiculo1;1;  TotalComisiones ;;'Comision Arancel';SI; Incluido(Vehiculo1,Var('VLIQUIDAA'));;PaseCB=0;;Cuenta2;;5;
FechaPago;Cliente1;ContraEspecie;;;;;Vehiculo1;1;  TotalIva ;;'IVA Comision Arancel';SI; Incluido(Vehiculo1,Var('VLIQUIDAA'));;PaseCB=0;;Cuenta2;;6;
FechaPago;IF(Vacio(Corredor),Cliente1,Corredor);ContraEspecie;;;;;Vehiculo1;1;  ImpComCor1 ;;'Comision: '~Corredor;SI; Incluido(Vehiculo1,Var('VLIQUIDAA'));;PaseCB=0;;Cuenta2;;7;

FechaVto ;Vehiculo1;Especie      ;;;;;         ;10;     Cantidad ;;'Compra de Titulo';;SI;;PaseCB=0;;Cuenta1;;8;;;Cupon1;;;;Book1;
FechaOp2 ;Vehiculo1;Especie      ;;;;;Vehiculo1;2;      Cantidad ;;'Compra de Titulo';;SI;;PaseCB=0;;Cuenta1;;9;;;Cupon1;;;;Book1;
FechaVto ;Vehiculo1;Especie      ;;;;;         ;3;      Cantidad ;;'Compra de Titulo';;SI;;PaseCB=0;;Cuenta1;;10;;;Cupon1;;;;Book1

LIMITES
FechaPago                          ;Cliente1;'SETCRE'  ;VTXT6;; VCAN8;TipoOp~' '~Especie;PaseCB=0 y FormaLiquidacion1 <> 1 y FechaPago<=FechaVto
Habiles(FechaVto,1,TablaFeriados1) ;Cliente1;'SETCRE'  ;VTXT6;;-VCAN8;TipoOp~' '~Especie;PaseCB=0 y FormaLiquidacion1 <> 1 y FechaPago<=FechaVto y Incluido(Vehiculo1,Var('VLIQUIDAA'))
FechaVto                           ;Cliente1;'SETCRE'  ;VTXT6;;-VCAN8;TipoOp~' '~Especie;PaseCB=0 y FormaLiquidacion1 <> 1 y FechaPago<=FechaVto y Not Incluido(Vehiculo1,Var('VLIQUIDAA')) y Not EqStr(BuscarCampo('CLIENTES','Alias10','Codigo',CLIENTE1),'LIMITELIQ');

POSICION
FechaOp;Vehiculo1;Especie;;;;Vehiculo1;;;;;101;Cantidad;Precio1;;;;;'SEC';;Cupon1
FechaOp;Vehiculo1;Especie;;;;Vehiculo1;;;;;110+Cartera;Cantidad;Precio1;;;;;'SEC';;Cupon1

FechaOp;Vehiculo1;Especie;;;;Vehiculo1;;;;;120;Cantidad;Precio1*if(EqStr(ContraEspecie,'ARP'),1,COTIZACIONC(CONTRAESPECIE,,,,FECHAOP-1,1,SI,'ARP'));;;BOOK1;;'SEC';PaseCB=0;Cupon1
FechaOp;Vehiculo1;Especie;;;;Vehiculo1;;;;;130;Cantidad;Precio1*if(EqStr(ContraEspecie,'USD'),1,COTIZACIONC(CONTRAESPECIE,,,,FECHAOP-1,1,SI,'USD'));;;BOOK1;;'SEC';PaseCB=0;Cupon1

FechaOp;Vehiculo1;ContraEspecie;;;;Vehiculo1;;;;;122;-TotalNetoCli1;COTIZACIONC(CONTRAESPECIE,,,,FECHAOP-1,1,SI,'ARP');;;VTXT19;;'FXS';Not Incluido(ContraEspecie,'ARP|USD');
FechaOp;Vehiculo1;ContraEspecie;;;;Vehiculo1;;;;;132;-TotalNetoCli1;COTIZACIONC(CONTRAESPECIE,,,,FECHAOP-1,1,SI,'USD');;;VTXT19;;'FXS';Not Incluido(ContraEspecie,'ARP|USD');

@INSTOPE 
INSTANCIA19
CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1);FW=1
FechaOp2      : 'Fecha Conc.'            ; 1;1;;NO
Vehiculo1     : 'Vehiculo'               ; 1;2;;NO
Book1         : 'Book'                   ; 2;2;;NO 

Especie       : 'Especie'                ;3;1; ;NO
FechaVto      : 'Vto.Tit.'               ; ; ; ;NO
ContraEspecie : 'ContraEspecie'          ;3;2; ;NO
Cliente1      : 'Entidad '               ;7;1; ;NO
Cantidad      : 'Cantidad '              ;8;1; ;NO
Precio1       : 'Precio'                 ;9;1; ;NO;;;;;;;;;;;'###.########';;
TotalBrutoCli1  : 'Importe Bruto'         ;10;1; ;NO


Operador        :                        ;12;1; ;NO
Observac2       : 'Op.Contraparte'       ;12;2; ;NO
TablaFeriados1  : 'Feriados Esp.'        ;13;1; ;NO 
TablaFeriados2  : 'Feriados Con.'        ;13;2; ;NO

VTXT11  : 'Ascend. Especie'  ;18;2;2;NO;NO;;;;Ascendientes('ESPECIES',ESPECIE);Ascendientes('ESPECIES',ESPECIE)
VTXT12  : 'Ascend. ContraE'  ;19;2;2;NO;NO;;;;Ascendientes('ESPECIES',CONTRAESPECIE);Ascendientes('ESPECIES',CONTRAESPECIE)
Label1     : ''              ;17;1;2;NO;NoVacio(CONTRAESPECIE);;;;'Especie                                                     ContraEspecie';'Especie                                                     ContraEspecie';;;;;;
Label2     : ''              ;17;1;2;NO;Vacio(CONTRAESPECIE);;;;'Especie';'Especie';;;;;;
Cuenta1 : If(Incluido(TIPOOP,EXE('CARTA1V')),'Debito en','Credito a')       ;18;1;2;;;[CLIENTECUENTA(VEHICULO1,CUENTA1) y ESPECIECUENTA(ESPECIE,CUENTA1) y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA1),'HAB')] y NOVACIO(CUENTA1);"Error en Cuenta '"~If(Incluido(TIPOOP,EXE('CARTA1V')),'Debito en','Credito a')~"' "~ESPECIE;SI;IF(Eqstr(ABM, 'A'), CUENTACLIENTE(VEHICULO1,ESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA1);IF(Eqstr(ABM, 'A'), CUENTACLIENTE(VEHICULO1,ESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA1);;;;;;"Cliente='"~VEHICULO1~"' and Estado = 'HAB' and (Especies Like '%"~Especie~"%' or Especies Like '%"~ItemLista(VTXT11,Elementos(VTXT11))~"%')"     
Cuenta2 : If(Incluido(TIPOOP,EXE('CARTA1V')),'Credito a','Debito en')       ;18;2;2;NoVacio(CONTRAESPECIE);NoVacio(CONTRAESPECIE);Vacio(CONTRAESPECIE) o [NOVACIO(CUENTA2) y [[CLIENTECUENTA(VEHICULO1,CUENTA2) y ESPECIECUENTA(CONTRAESPECIE,CUENTA2) y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA2),'HAB')]]];"Error en Cuenta '"~If(Incluido(TIPOOP,EXE('CARTA1V')),'Credito a','Debito en')~"' "~CONTRAESPECIE;SI;IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA2);IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA2);;;;;;"Cliente='"~VEHICULO1~"' and Estado = 'HAB' and (Especies Like '%"~ContraEspecie~"%' or Especies Like '%"~ItemLista(VTXT12,Elementos(VTXT12))~"%')" 

VTXT15  : 'Ascend. Especie'  ;18;2;2;NO;NO;;;;Ascendientes('ESPECIES',ESPECIE);Ascendientes('ESPECIES',ESPECIE)
VTXT16  : 'Ascend. ContraE'  ;19;2;2;NO;NO;;;;Ascendientes('ESPECIES',CONTRAESPECIE);Ascendientes('ESPECIES',CONTRAESPECIE)
Cuenta4 : If(Incluido(TIPOOP,EXE('CARTA1V')),'Credito A','Debito  En')  ;19;1;2;Not Incluido(Vehiculo1,VAR('VEHIEXTRAN')) y Not Incluido(Vehiculo2,VAR('VEHIEXTRAN'));;[CLIENTECUENTA(VEHICULO1,CUENTA4) y ESPECIECUENTA(ESPECIE,CUENTA4) y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA4),'HAB')] y NOVACIO(CUENTA4);"Error en Cuenta de '"~If(Incluido(TIPOOP,EXE('CARTA1V')),'Credito A','Debito  En')~"' "~ESPECIE;SI;IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,ESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA4);IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,ESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA4);;;;;;"Cliente='"~VEHICULO1~"' and Estado = 'HAB' and (Especies Like '%"~Especie~"%' or Especies Like '%"~ItemLista(VTXT15,Elementos(VTXT15))~"%')"     
Cuenta5 : If(Incluido(TIPOOP,EXE('CARTA1V')),'Debito  En','Credito A')  ;19;2;2;NoVacio(CONTRAESPECIE) y Not Incluido(Vehiculo1,VAR('VEHIEXTRAN')) y Not Incluido(Vehiculo2,VAR('VEHIEXTRAN'));NoVacio(CONTRAESPECIE);Vacio(CONTRAESPECIE) o [NOVACIO(CUENTA5) y [[CLIENTECUENTA(VEHICULO1,CUENTA5) y ESPECIECUENTA(CONTRAESPECIE,CUENTA5) y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA5),'HAB')]]];"Error en Cuenta de '"~If(Incluido(TIPOOP,EXE('CARTA1V')),'Debito  En','Credito A')~"' "~CONTRAESPECIE;SI;IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA5);IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA5);;;;;;"Cliente='"~VEHICULO1~"' and Estado = 'HAB' and (Especies Like '%"~ContraEspecie~"%' or Especies Like '%"~ItemLista(VTXT16,Elementos(VTXT16))~"%')"     

POSTEDICION
FW=1;'ACTI19';NrOperacion1=NROPERACION
FW=2;'APROPE';NrOperacion1=NROPERACION;Radio1=1;

