FechaVto;Cliente1;ContraEspecie2;;;;;Vehiculo1;1;Arancel1;;'Arancel al Vto';SI;;;;;Cuenta1;;12;
FechaVto;Cliente1;ContraEspecie2 ;;;;;Vehiculo1;1;TotalDerechos;;'Derechos de Mercado al Vto';SI;;;;;Cuenta1;;13;
FechaVto;Cliente1;ContraEspecie2 ;;;;;Vehiculo1;1;TotalIVA;;'IVA al Vto';SI;;;;;Cuenta1;;14;
FechaVto;Cliente1;ContraEspecie2 ;;;;;Vehiculo1;1;TotalNetoCli3;;'Importe Neto Gastos';SI;;;;;Cuenta1;;15;

MOVCUOTAS
FechaOp;Cliente1;CuotasL.Especie1[Fila];;Vehiculo1;1;-CuotasL.Cantidad1[Fila];'Alta Caucion Colocadora de Titulo';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;(Fila+500);CuotasL.Cuenta1[Fila];;(Fila+500);'CUOTAS'
FechaVto;Cliente1;CuotasL.Especie1[Fila];;Vehiculo1;1;CuotasL.Cantidad1[Fila];'Vto Caucion Colocadora de Titulo';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;(Fila+600);CuotasL.Cuenta1[Fila];;(Fila+600);'CUOTAS'
