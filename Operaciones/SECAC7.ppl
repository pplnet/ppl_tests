Arancel1               : 'Arancel'           ;1;1;2;;;ARANCEL1>=0;;;;;;;;;'####.#######0'
TotalDerechos          : 'Der. Mercado'      ;1;2;2;;;TOTALDERECHOS>=0;;;;;;;;;'####.#######0'
TotalIVA               : 'IVA'               ;2;1;2;;;TOTALIVA>=0;;;;;;;;;'####.#######0'
TotalNetoCli3          : 'Importe Neto'      ;2;2;2;;;TOTALNETOCLI3>=0;;;;;;;;;'####.#######0'
ContraEspecie2         : 'Moneda de Pago'    ;3;1;2;;;;;;ESPECIE;ESPECIE;;;;;'####.#######0';"Status='HAB' and Jerarquia LIKE '"~Jerarquia('ESPECIES','MONEDA')~"%' "
