ContraEspecie   : 'ContraEspecie'              ;;;;NO;NO;
FechaOp2        : ''                           ;;;;NO;NO;

@CUENTAS
@CUENTAS2

CONDICIONES
Not EqStrI(Vehiculo1,Vehiculo2);'El Vehiculo Contraparte debe ser diferente al Vehiculo por el cual se ingresa la Operacion';NO;NO;FSYS;'VEHDUPL'
ESHABIL(FECHAOP,'ARG');'La Fecha de la Provision no es Dia Habil en Argentina';SI;SI;FSYS;'PROVINH'
ESTERMINAL(VEHICULO2,VEHICULO);'El Vehiculo ContraParte debe ser Terminal';NO
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
EqStr(Copy(TIPOOP2,1,2),'MM') y Incluido(TIPOOP2,'MMCPRV|MMPCCM|MMPCCV|MMPV');'El Tipo de Operacion a Asociar debe ser de Money Market Vinculadas';NO
@CONDIOP

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador


POSTEDICION
MB4=1 Y EQSTR(ABM,'A');'INSEVI';NrOperacion1=NROPERACION;TipoOp1=TIPOOP;String=" MB3='"~IF(MB3=0,'1','0')~"' ";Vehiculo1=VEHICULO2;Vehiculo2=VEHICULO1;String1=""

MOVIMIENTOS
FechaOp ;Cliente1;Especie;;;;;Vehiculo1;11;if(MB3=0,-Cantidad,Cantidad);;'Carga Provisiones' ;SI;SI;;;;Cuenta1;;1;

