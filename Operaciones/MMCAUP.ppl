TablaFeriados1  : 'Feriados'                   ;13;2;1;;;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;IF(MODI,TABLAFERIADOS1,BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE)))
