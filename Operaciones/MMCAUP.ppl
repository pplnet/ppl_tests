FechaVto;IF(VACIO(Corredor), Cliente1, Corredor);ContraEspecie;;;;;Vehiculo1;1;TotalIVA;;'IVA Comision Corredor';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;50;

