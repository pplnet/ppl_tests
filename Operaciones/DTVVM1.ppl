CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp        : 'Fecha Conc.'                ;1;1;;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1);'FECHA CONCERTACION NO HABIL EN TABLA SELECCIONADA';RB11 = 0;FSYS;
@VEHITO
Operador       :                              ;2;1;;no;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
Cliente1       : 'ContraParte'                ;3;1;;NOT EV ;;NOVACIO(CLIENTE1);'EL CLIENTE NO ES VALIDO';NO;;;;;;;;"Status = 'HAB'";;;;
Observac2      : 'Op.Contraparte'             ;3;2;;;;NOVACIO(OBSERVAC2);'EL OPERADOR CONTRAPARTE NO ES VALIDO';SI;;;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'

CB9            : 'Mark To Mkt'                ;4;1;;NO;NO;;;;0;
TablaFeriados1 : 'Feriados'                   ;;;;;;NOVACIO(TABLAFERIADOS1);'SE DEBE INDICAR FERIADOS A UTILIZAR';NO;;BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE)) 
Cuotas1        : 'Cant_Sett'                  ;5;2;;;;CUOTAS1>1;'La Cantidad de Settlements debe ser superior a 1';NO;
RB6            : 'Liquida|Compensacion|Flujo de Fondos';6;1;;EQSTR(ESPECIE,CONTRAESPECIE);EQSTR(ESPECIE,CONTRAESPECIE);[EQSTR(ESPECIE,CONTRAESPECIE) Y RB6>=0] O Not EQSTR(ESPECIE,CONTRAESPECIE);'DEBE INGRESAR FORMA LIQUIDACION';NO;0;IF(EQSTR(ESPECIE,CONTRAESPECIE),RB6,-1);

Especie        : 'V Moneda'                   ;1;1;2;NOT EV ;;NOVACIO(ESPECIE) Y [DESCIENDEDEESPECIE(ESPECIE,'MONEDA') Y ESTERMINAL(ESPECIE,ESPECIE)];'DEBE INGRESAR UNA MONEDA DE VEHICULO VALIDA';NO;'USD';;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";;;
RB8            : 'V Day Count|Act Act|Act 365 F|Act 360|360 360|30E 360' ;3;;2;;;;;;0;
RB5            : 'C Day Count|Act Act|Act 365 F|Act 360|360 360|30E 360' ;4;1;2;;;;;;0;
PrecioRef2     : 'V Fte_Ref'                  ;6;1;2;;;;;;;;
TipoTasa       : 'V Tipo_Tasa'                ;;;2;;;NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA);'El Tipo de Tasa debe ser Variable';NO;;;
TotalAux3      : 'V Notional'                 ;;;2;;;TOTALAUX3>=0;'Debe Ingresar el Vehiculo Initial Exchange';NO;0;IF(COTIZACION1=0 O COTIZACION1=TOTALAUX3 O TOTALBRUTOCLI2=0,TOTALAUX3,IF(EqStr(Modo(ESPECIE,CONTRAESPECIE),'DIR'),TOTALBRUTOCLI2/COTIZACION1,TOTALBRUTOCLI2*COTIZACION1))
FechaEx1       : 'Notional_Date'              ;;;2;TOTALAUX3>0;TOTALAUX3>0 ;[TOTALAUX3=0] O ESHABIL(FECHAEX1,TABLAFERIADOS1);'FECHA INITIAL EXCHANGE NO HABIL EN TABLA SELECCIONADA';RB11 = 0;;IF(TOTALAUX3>0 Y NOT EQSTR(CONTRAESPECIE,ESPECIE),FECHAEX1,0)
ContraEspecie  : 'C Moneda'                   ;1;2;2;NOT EV ;;NOVACIO(CONTRAESPECIE) Y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') Y ESTERMINAL(CONTRAESPECIE,ESPECIE);'DEBE INGRESAR UNA MONEDA CONTRAPARTE VALIDA';NO;'USD';;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";;;;;
PrecioRef3     : 'C Fte_Ref'                  ;6;2;2;;;;;;;;
TipoTasa2      : 'C Tipo_Tasa'                ;;;2;;;NOT EQSTR(TIPOTASA2,'FIJA') Y NOVACIO(TIPOTASA2);'El Tipo de Tasa debe ser Variable';NO;;;
TotalBrutoCli2 : 'C Notional'                 ;;2;2;;;TOTALBRUTOCLI2>=0;'Contraparte Initial Exchange Invalido';NO;0;IF(COTIZACION1=0 O COTIZACION1=TOTALAUX3 O TOTALBRUTOCLI2<>0,TOTALBRUTOCLI2,IF(EqStr(Modo(ESPECIE,CONTRAESPECIE),'DIR'),TOTALAUX3*COTIZACION1,TOTALAUX3/COTIZACION1))
PlazoRenovPredeter : 'Cot.Contable'           ;9;2;2;NO Y [NOT EQSTR (COTIZAEN(ESPECIE),CONTRAESPECIE)];NO Y [NOT EQSTR(COTIZAEN(ESPECIE),CONTRAESPECIE)]; SI O [EQSTR(COTIZAEN(ESPECIE),CONTRAESPECIE) o PLAZORENOVPREDETER > 0];'REQUIERE COTIZACION CONTABLE';NO;;IF(MODI, PLAZORENOVPREDETER, IF(Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE), IF(Eqstr(CotizaEn(ESPECIE), VAR('MONELOCA') ), 1 , COTIZACIONBNA(CONTRAESPECIE,FECHAOP,1,NO,NO) )   ))
VPRE1          : 'Cot.ESP/CONTRAESP'          ;;;2;NO;NO;;;;;IF(EqStr(Modo(ESPECIE,CONTRAESPECIE),'DIR'),TOTALBRUTOCLI2/TOTALAUX3,TOTALAUX3/TOTALBRUTOCLI2)
Plazo4         : 'Dias Seteo Tasa'            ;11;1;2;;[Not EqStr(TIPOTASA,'FIJA') y NOVACIO(TIPOTASA)] O [Not EqStr(TIPOTASA2,'FIJA') y NOVACIO(TIPOTASA2)];PLAZO4>=0;'Indique la Cantidad de Dias Previos al Inicio para Setear la Tasa';NO;;
RB16           : 'Setea|InicioPer|FinPer';;;2;;[NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA)] O [NOT EQSTR(TIPOTASA2,'FIJA') Y NOVACIO(TIPOTASA2)];RB16=0 O RB16=1 O [EQSTR(TIPOTASA,'FIJA') o VACIO(TIPOTASA)] O [EQSTR(TIPOTASA2,'FIJA') o VACIO(TIPOTASA2)];'Indique Inicio o Fin de Periodo';NO;
Cotizacion1    : 'Tipo Cambio'                ;11;2;2;Not Eqstr(ESPECIE,CONTRAESPECIE);Not Eqstr(ESPECIE,CONTRAESPECIE);Eqstr(ESPECIE,CONTRAESPECIE) o [COTIZACION1<=VPRE1*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE1*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE1*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE1*(1+VAR('RPRECIO2')/100),1,7);NO;;IF(Eqstr(ESPECIE,CONTRAESPECIE),1,VPRE1)
VCAN12         : 'Cotizacion de Mercado'      ;18;2;2;No;No;;;;;COTIZACIONC(COTIZAEN(ESPECIE),,,,FECHAOP,1,SI,CONTRAESPECIE))
RB11           : 'Ajuste|NO|SI'               ;12;2;2;;NO;;;;0;

Impresa        : 'Modificado'                 ;10;3;;NO;NO;;;;0
RB3            : 'MOF'                        ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)
PrecioMer      : 'Monto USD WF'               ;1;2;2;NO;NO;;;;CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'));CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))

Cantidad       : ''                           ;;;;NO;NO;;;;

@CUENTAS
@DTREFER

LISTA:SI;IF(ESINICIO,100,CUOTAS1);
 Fecha1    : 'V_Inicio Per'   ;;;ESHABIL(CUOTASL.FECHA1[Fila],TABLAFERIADOS1);'Fecha Inicio Vehiculo Cuota '~Fstr(Fila, 0, 0)~' NO ES HABIL';IF(Fila=1,FECHAOP,CUOTASL.FECHA2[Fila-1]);IF(Fila=1,CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila-1]);90;;Fecha;;;;;;;;RB11 = 0
 Plazo1    : 'V_Plazo'        ;;;CUOTASL.PLAZO1[Fila]>0;'El PLAZO DEBE SER POSITIVO';;;60;;Numero;'####'
 Fecha2    : 'V_Fin Per'      ;NO;;ESHABIL(CUOTASL.FECHA2[Fila],TABLAFERIADOS1);'Fecha Fin Vehiculo Cuota '~Fstr(Fila, 0, 0)~' NO ES HABIL';;CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila];90;;Fecha;;;;;;;;RB11 = 0

 Cantidad6 : 'V_Imp_Amor'     ;NOT EV;;CUOTASL.CANTIDAD6[Fila]>=0;'El Importe Amortizacion del Vehiculo debe SER POSITIVO';IF(Fila=CUOTAS1,TOTALAUX3,0)-TOTALBRUTOCLI2+TOTALBRUTOCLI2-TOTALAUX3+TOTALAUX3-COTIZACION1+COTIZACION1;IF(Fila=CUOTAS1,TOTALAUX3,0)-TOTALBRUTOCLI2+TOTALBRUTOCLI2-TOTALAUX3+TOTALAUX3-COTIZACION1+COTIZACION1;200;;Numero;'###,###,###,###.##';NO;NO;'5'
 Cantidad1 : 'V_Notional'     ;NOT EV ;;CUOTASL.CANTIDAD1[Fila]>0;'EL NOTIONAL AMMOUNT DEL VEHICULO ES INCORRECTO';IF(Fila=1,TOTALAUX3,CUOTASL.CANTIDAD1[Fila-1]-CUOTASL.CANTIDAD6[Fila-1])-TOTALBRUTOCLI2+TOTALBRUTOCLI2-TOTALAUX3+TOTALAUX3-COTIZACION1+COTIZACION1;IF(Fila=1,TOTALAUX3,CUOTASL.CANTIDAD1[Fila-1]-CUOTASL.CANTIDAD6[Fila-1])-TOTALBRUTOCLI2+TOTALBRUTOCLI2-TOTALAUX3+TOTALAUX3-COTIZACION1+COTIZACION1;200;;Numero;'###,###,###,###,###.##';NO;NO;'5'
 Precio1   : 'V_Tasa'         ;;;;;;;100;;Numero;'###,###.######';NO;NO;'8'
 Total3    : 'V_Spread'       ;;;[CUOTASL.TOTAL3[Fila]>=VAR('RSPREAD1') Y CUOTASL.TOTAL3[Fila]<=VAR('RSPREAD2')];'El Spread del Vehiculo esta Fuera de Rango '~VAR('RSPREAD1')~' '~VAR('RSPREAD2');;;100;;Numero;'###,###.######'
 Cantidad3 : 'V_Interes'      ;EV;;NOT EV o [[ROUND(CUOTASL.CANTIDAD3[Fila],2) <= ROUND((CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.CANTIDAD3[Fila],2) >= ROUND((CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100)),2)]];'Interes Vehiculo Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100),2),0,2);;((CUOTASL.CANTIDAD1[Fila]*(CUOTASL.PRECIO1[Fila]+CUOTASL.TOTAL3[Fila]))/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1);200;NO;Numero;'###,###,###,###,###.##';NO;NO;'6'
 Fecha3    : 'Settlement'     ;;;ESHABIL(CUOTASL.FECHA3[Fila],TABLAFERIADOS1);'FECHA SETTLEMENT NO HABIL EN TABLA SELECCIONADA';;IF(EQSTR(CAMPOMODIFICADO,'CUOTASL.FECHA3['~Fstr(Fila,1,0)~']'),CUOTASL.FECHA3[Fila],CUOTASL.FECHA2[Fila]);90;NO;Fecha;;NO

 Fecha5    : 'C_Ini'          ;;;ESHABIL(CUOTASL.FECHA5[Fila],TABLAFERIADOS1);'Fecha Inicio ContraParte Cuota '~Fstr(Fila, 0, 0)~' NO ES HABIL';IF(Fila=1,FECHAOP,CUOTASL.FECHA6[Fila-1]);IF(Fila=1,CUOTASL.FECHA5[Fila],CUOTASL.FECHA6[Fila-1]);90;;Fecha;;;;;;;;RB11 = 0
 Plazo2    : 'C_Plazo'        ;;;CUOTASL.PLAZO2[Fila]>=0;'El PLAZO ContraParte DEBE SER POSITIVO ';IF(EQSTR(CAMPOMODIFICADO,'CUOTASL.PLAZO2['~Fstr(Fila,1,0)~']'),CUOTASL.PLAZO2[Fila],CUOTASL.PLAZO1[Fila]);;60;;Numero;'####';;;'12'
 Fecha6    : 'C_Fin'          ;NO;;ESHABIL(CUOTASL.FECHA6[Fila],TABLAFERIADOS1);'Fecha Fin ContraParte Cuota '~Fstr(Fila, 0, 0)~' NO ES HABIL';;CUOTASL.FECHA5[Fila]+CUOTASL.PLAZO2[Fila];90;;Fecha;;;;;;;;RB11 = 0

 Cantidad5 : 'C_Imp_Amor'     ;NOT EV;;CUOTASL.CANTIDAD5[Fila]>=0;'El Importe Amortizacion de la ContraParte debe SER POSITIVO';IF(Fila=CUOTAS1,TOTALBRUTOCLI2,0)-TOTALBRUTOCLI2+TOTALBRUTOCLI2-TOTALAUX3+TOTALAUX3-COTIZACION1+COTIZACION1;IF(Fila=CUOTAS1,TOTALBRUTOCLI2,0)-TOTALBRUTOCLI2+TOTALBRUTOCLI2-TOTALAUX3+TOTALAUX3-COTIZACION1+COTIZACION1;200;;Numero;'###,###,###,###.##';NO;NO;'14'
 Cantidad2 : 'C_Notional'     ;NOT EV ;;CUOTASL.CANTIDAD2[Fila]>0;'EL NOTIONAL AMMOUNT DE LA CONTRAPARTE ES INCORRECTO';IF(Fila=1,TOTALBRUTOCLI2,CUOTASL.CANTIDAD2[Fila-1]-CUOTASL.CANTIDAD5[Fila-1])-TOTALBRUTOCLI2+TOTALBRUTOCLI2-TOTALAUX3+TOTALAUX3-COTIZACION1+COTIZACION1;IF(Fila=1,TOTALBRUTOCLI2,CUOTASL.CANTIDAD2[Fila-1]-CUOTASL.CANTIDAD5[Fila-1])-TOTALBRUTOCLI2+TOTALBRUTOCLI2-TOTALAUX3+TOTALAUX3-COTIZACION1+COTIZACION1;200;;Numero;'###,###,###,###,###.##';NO;NO;'13'
 Precio2   : 'C_Tasa'         ;;;;;;;100;;Numero;'###,###.######';NO;NO;'17'
 Total4    : 'C_Spread'       ;;;[CUOTASL.TOTAL4[Fila]>=VAR('RSPREAD1') Y CUOTASL.TOTAL4[Fila]<=VAR('RSPREAD2')];'El Spread de la Contraparte esta Fuera de Rango '~VAR('RSPREAD1')~' '~VAR('RSPREAD2');;;100;;Numero;'###,###.######'
 Cantidad4 : 'C_Interes'      ;EV;;NOT EV o [[ROUND(CUOTASL.CANTIDAD4[Fila],2) <= ROUND((CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.CANTIDAD4[Fila],2) >= ROUND((CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100)),2)]];'Interes Contraparte Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100),2),0,2);;((CUOTASL.CANTIDAD2[Fila]*(CUOTASL.PRECIO2[Fila]+CUOTASL.TOTAL4[Fila]))/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB5+1);200;NO;Numero;'###,###,###,###,###.##';NO;NO;'15'
 Fecha7    : 'Settlement'     ;;;ESHABIL(CUOTASL.FECHA7[Fila],TABLAFERIADOS1);'FECHA SETTLEMENT ContraParte NO HABIL EN TABLA SELECCIONADA';;IF(EQSTR(CAMPOMODIFICADO,'CUOTASL.FECHA7['~Fstr(Fila,1,0)~']'),CUOTASL.FECHA7[Fila],CUOTASL.FECHA6[Fila]);90;NO;Fecha;;NO

 Fecha4    : 'F.Reset'        ;NO;[Not EqStr(TIPOTASA,'FIJA') y NOVACIO(TIPOTASA)] O [Not EqStr(TIPOTASA2,'FIJA') y NOVACIO(TIPOTASA2)];;;;HABILES(IF(RB16=0,CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila]),-PLAZO4,TABLAFERIADOS1,SI); 90;;Fecha;NO;NO;;;;;;
 Total2    : 'Resultado'      ;NO;;;;;IF(CUOTASL.PRECIO1[Fila]>0 y CUOTASL.PRECIO2[Fila]>0 Y EqStr(ESPECIE,CONTRAESPECIE) y RB6=0,CUOTASL.CANTIDAD4[Fila]-CUOTASL.CANTIDAD3[Fila],0);200;;Numero;'###,###,###,###,###.##'
 Check1    : 'Ejercio?'       ;NO;;;;;IF(CUOTASL.CANTIDAD3[Fila]=0 O CUOTASL.CANTIDAD4[Fila]=0,0,1);50;NO;Check;NO;SI;

 Precio5   : 'V MOD INT'      ;NO;NO;;;;((CUOTASL.CANTIDAD1[Fila]*(CUOTASL.PRECIO1[Fila]+CUOTASL.TOTAL3[Fila]))/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1);200;;Numero;'###,###.######'
 Precio6   : 'C MOD INT'      ;NO;NO;;;;((CUOTASL.CANTIDAD2[Fila]*(CUOTASL.PRECIO2[Fila]+CUOTASL.TOTAL4[Fila]))/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB5+1);200;;Numero;'###,###.######'
 Cantidad8 : 'Exposicion MM'  ;NO;NO;;;;;100;;Numero;'###,###,###,###.##'
 Check10   : 'Est.'           ;  ;  ;CUOTASL.CHECK10[Fila] = 0;'La Tasa de la Cuota '~Fstr(Fila, 0, 0)~' Es Estimada';0;;50;;Check;;;;;;;;SI
 Precio3   : 'CtaModiInteres' ;NO;NO;;;;IF(Round(QUERY("SELECT Cantidad3 FROM "~DBO~".CUOTAS WHERE NrOperacion='"~NROPERACION~"' and NrCuota="~Fstr(Fila,0,0)~" "),2)<>Round(CUOTASL.CANTIDAD3[Fila],2),Fila,0);100;;Numero;'###'


CONDICIONES
SUM(CUOTASL,4) =TOTALAUX3;'El Imp. de Amortizacion del Vehiculo debe ser igual que el Initial Exchange Vehiculo ';NO
SUM(CUOTASL,13)=TOTALBRUTOCLI2;'El Imp. de Amortizacion de la ContraParte debe ser igual que el Initial Exchange Contraparte';NO
ESHABIL(FECHAOP,'ARG');'LA FECHA DE CONCERTACION NO ES DIA HABIL EN ARGENTINA';SI;SI;FSYS;'COINH'
[TOTALAUX3=0 O EQSTR(ESPECIE,CONTRAESPECIE)] O ESHABIL(FECHAEX1,'ARG');'LA FECHA DE INITIAL EXCHANGE NO ES DIA HABIL EN ARGENTINA';SI;SI;FSYS;'IEXINH'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'El Cliente esta Observado';SI;SI;FSYS;'CLIOBS'
Vacio(Cliente1) o EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB');'El Cliente No esta Habilitado';NO
EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La Especie No esta Habilitada';NO
EqStr(BuscarCampo('Especies','Status','Codigo',ContraEspecie),'HAB');'La ContraEspecie No esta Habilitada';NO
NOT [EQSTR(ESPECIE,CONTRAESPECIE) Y EQSTR(TIPOTASA,TIPOTASA2)];'Error,  Monedas del Notional y Tipos de Tasa Iguales !!!';NO
NOT EQSTR (VEHICULO1,CLIENTE1);'El Cliente y el Vehiculo deben ser distintos';NO
ESTERMINAL(VEHICULO1,VEHICULO);'El Vehiculo debe ser Terminal';NO
ESTERMINAL(CLIENTE1,CLIENTE);'El Cliente debe ser Terminal';NO
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
VACIO(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR)) O  VERIFICAPERFIL(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR),'TO'~TIPOOP);'Operador no habilitado para ingresar Operaciones del Tipo '~TIPOOP;NO
SI O [Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE) O PLAZORENOVPREDETER<=VCAN12*(1+VAR('RPRECIO2')/100) Y PLAZORENOVPREDETER>=VCAN12*(1-VAR('RPRECIO2')/100)];'COTIZACION CONTABLE Fuera de Rango: '~FSTR(VCAN12*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO2')/100),1,7);NO
SI O [Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE) O PLAZORENOVPREDETER<=VCAN12*(1+VAR('RPRECIO') /100) Y PLAZORENOVPREDETER>=VCAN12*(1-VAR('RPRECIO') /100)];'COTIZACION CONTABLE FUERA DE RANGO: '~FSTR(VCAN12*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOCOTCON'
 

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

@POSTEDT

MOVIMIENTOS
FechaEx1 ;Cliente1 ;Especie       ;;;;;Vehiculo1;1;     -TotalAux3;;'Initial Exchange Vehiculo';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;Not Eqstr(Especie,ContraEspecie);;Cuenta1;;1;
FechaEx1 ;Cliente1 ;ContraEspecie ;;;;;Vehiculo1;1; TotalBrutoCli2;;'Initial Exchange Contraparte';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;Not Eqstr(Especie,ContraEspecie);;Cuenta2;;2;


MOVCUOTAS
CuotasL.Fecha2[Fila];Cliente1 ;Especie       ;;Vehiculo1;1; CuotasL.Cantidad3[Fila];'Interest Payment Vehiculo'   ;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;CuotasL.Cantidad3[Fila]<>0 y [Not Eqstr(Especie,ContraEspecie) o [Eqstr(Especie,ContraEspecie) y RB6=1]];;Cuenta1;;(Fila+2*CUOTAS1)+4;
CuotasL.Fecha6[Fila];Cliente1 ;ContraEspecie ;;Vehiculo1;1;-CuotasL.Cantidad4[Fila];'Interest Payment ContraParte';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;CuotasL.Cantidad4[Fila]<>0 y [Not Eqstr(Especie,ContraEspecie) o [Eqstr(Especie,ContraEspecie) y RB6=1]];;Cuenta2;;(Fila+3*CUOTAS1)+4;
CuotasL.Fecha3[Fila];Cliente1 ;Especie       ;;Vehiculo1;1; CuotasL.Cantidad6[Fila];'Final Exchange Vehiculo'     ;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;Not Eqstr(Especie,ContraEspecie);;Cuenta1;;(Fila+4*CUOTAS1)+4;
CuotasL.Fecha7[Fila];Cliente1 ;ContraEspecie ;;Vehiculo1;1;-CuotasL.Cantidad5[Fila];'Final Exchange Contraparte'  ;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;Not Eqstr(Especie,ContraEspecie);;Cuenta2;;(Fila+5*CUOTAS1)+4;
CuotasL.Fecha3[Fila];Cliente1 ;ContraEspecie ;;Vehiculo1;1;-CuotasL.Total2[Fila];'Resultado por Modificacion '~TIPOOP;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;Eqstr(Especie,ContraEspecie) y RB6=0 y CuotasL.Total2[Fila]<>0;;Cuenta2;;(Fila+6*CUOTAS1)+4;

DEVENGADOSCUOTAS
