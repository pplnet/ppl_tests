TipoTasa3      : 'Tipo_Tasa'                  ;7;2;;;;NOVACIO(TIPOTASA3) y NOT EQSTR(TIPOTASA3, 'FIJA');'EL TIPO DE TASA ES INVALIDO';NO;;
Plazo4         : 'Dias Seteo Tasa'            ;;;;;NOT EQSTR(TIPOTASA3,'FIJA') y NOVACIO(TIPOTASA3);[PLAZO4>=0] O [EQSTR(TIPOTASA3,'FIJA')];'Indique la Cantidad de Dias Previos al Inicio para Setear la Tasa';NO;;
RB16           : 'Setea|InicioPer|FinPer';;;;;NOT EQSTR(TIPOTASA3,'FIJA') Y NOVACIO(TIPOTASA3);RB16=0 O RB16=1 O [EQSTR(TIPOTASA3,'FIJA') o VACIO(TIPOTASA3)] ;'Indique Inicio o Fin de Periodo';NO;
Spread         : 'Spread'                     ;11;;;NOT EQSTR(TIPOTASA3,'FIJA');NOT EQSTR(TIPOTASA3,'FIJA');;;;0;IF(EQSTR(TIPOTASA3,'FIJA'),0,SPREAD);
FechaOp2       : 'F_Inicio'                   ;11;1;;;;ESHABIL(FECHAOP2,TABLAFERIADOS1);'Fecha de Inicio de Opcion Invalida';RB11 = 0;0;
