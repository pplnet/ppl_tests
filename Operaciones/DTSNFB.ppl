FechaEj        : 'F_Fin'                      ;;;;NO;;ESHABIL(FECHAEJ,TABLAFERIADOS1);'Fin de Swap debe ser Habil';RB11 = 0;0;IF(FECHAOP2=0,0,FECHAOP2+PLAZO)
Precio1        : 'Prima'                      ;13;2;;;;PRECIO1>0;'LA PRIMA DEBE SER POSITIVA';NO;;;;;;;'###.########';
TotalNetoCli1  : 'Monto_Prima'                ;;;;NO;;;;;;IF(MB3=0,CANTIDAD*PRECIO1,TOTALBRUTOCLI1*PRECIO1);
FechaVto       : 'Fecha_Prima'                ;;;;;;FECHAVTO>=FECHAOP Y ESHABIL(FECHAVTO,TABLAFERIADOS1);'FECHA INCORRECTA';NO;FECHAOP;
