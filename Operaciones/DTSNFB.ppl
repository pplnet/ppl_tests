TotalAux3      : 'V In Ex'                    ;6;;2;NOT EQSTR(ESPECIE, CONTRAESPECIE); NOT EQSTR(ESPECIE, CONTRAESPECIE);EQSTR(ESPECIE,CONTRAESPECIE) O TOTALAUX3>=0;'Debe Ingresar el Vehiculo Initial Exchange';NO;0;IF(EQSTR(ESPECIE,CONTRAESPECIE),0,TOTALAUX3)
FechaEx1       : 'Initial_Ex_Date'            ;;;2;TOTALAUX3>0 Y NOT EQSTR(ESPECIE,CONTRAESPECIE);TOTALAUX3>0 Y NOT EQSTR(CONTRAESPECIE, ESPECIE);[TOTALAUX3=0 O EQSTR(ESPECIE,CONTRAESPECIE)] O FECHAEX1>0;'Initial Exchange Date Invalida';NO;;IF(TOTALAUX3>0 Y NOT EQSTR(CONTRAESPECIE,ESPECIE),FECHAEX1,0)
TotalAux4      : 'V Fi Ex'                    ;;;2;NOT EQSTR(ESPECIE, CONTRAESPECIE); NOT EQSTR(ESPECIE, CONTRAESPECIE);EQSTR(ESPECIE, CONTRAESPECIE) O TOTALAUX4>=0;'Vehiculo Final Exchange Invalido';NO;0;IF(EQSTR(ESPECIE,CONTRAESPECIE),0,TOTALAUX4)
FechaEx2       : 'Final_Ex_Date'              ;;;2;TOTALAUX4>0 Y NOT EQSTR (ESPECIE,CONTRAESPECIE);TOTALAUX4>0 Y NOT EQSTR(ESPECIE,CONTRAESPECIE);[TOTALAUX4=0 O EQSTR(ESPECIE,CONTRAESPECIE)] O FECHAEX2>0;'Final Exchange Date Invalida';NO;;IF(TOTALAUX4>0 Y NOT EQSTR(ESPECIE,CONTRAESPECIE),FECHAEX2,0)
ContraEspecie  : 'C Moneda'                   ;1;2;2;NOT EV;;NOVACIO(CONTRAESPECIE) Y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') Y ESTERMINAL(CONTRAESPECIE,ESPECIE);'DEBE INGRESAR UNA MONEDA CONTRAPARTE VALIDA';NO;'USD';;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~")and Status = 'HAB' "
TotalBrutoCli1 : 'C N.A.'                     ;;;2;NOT EV;;TOTALBRUTOCLI1>0;'CONTRAPARTE NOTIONAL AMMOUNT INCORRECTO';NO;0;
TotalBrutoCli2 : 'C In Ex'                    ;6;2;2;NOT EQSTR(ESPECIE, CONTRAESPECIE); NOT EQSTR(ESPECIE, CONTRAESPECIE);EQSTR(ESPECIE, CONTRAESPECIE) O TOTALBRUTOCLI2>=0;'Contraparte Initial Exchange Invalido';NO;0;IF(EQSTR(ESPECIE,CONTRAESPECIE),0,TOTALBRUTOCLI2)
TotalBrutoCli3 : 'C Fi Ex'                    ;;;2;NOT EQSTR(ESPECIE,CONTRAESPECIE);NOT EQSTR(ESPECIE,CONTRAESPECIE);EQSTR(ESPECIE, CONTRAESPECIE) O TOTALBRUTOCLI3>=0;'Contraparte Final Exchange Date Invalido';NO;0;IF(EQSTR(ESPECIE,CONTRAESPECIE),0,TOTALBRUTOCLI3)
PlazoRenovPredeter : 'Cot.Contable'           ;9;2;2;NO Y  [NOT EQSTR (COTIZAEN(ESPECIE),CONTRAESPECIE)];NO Y [NOT EQSTR(COTIZAEN(ESPECIE),CONTRAESPECIE)];SI O [EQSTR(COTIZAEN(ESPECIE),CONTRAESPECIE) o PLAZORENOVPREDETER > 0];'REQUIERE COTIZACION CONTABLE';NO;;IF(MODI, PLAZORENOVPREDETER, IF(Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE),  IF(Eqstr(CotizaEn(ESPECIE), VAR('MONELOCA') ), 1 , COTIZACIONBNA(CONTRAESPECIE,FECHAOP,1,NO,NO) )   ))

Impresa        : 'Modificado'                 ;10;3;;NO;NO;;;;0
