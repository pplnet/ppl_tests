LISTA:SI;IF(ESINICIO,100,CUOTAS1);
 Fecha1    : 'Inicio Op'      ;;;[[Fila<>1 Y CUOTASL.FECHA1[Fila]>=FECHAOP] O [Fila=1]] Y ESHABIL(CUOTASL.FECHA1[Fila],TABLAFERIADOS1) Y ESHABIL(CUOTASL.FECHA1[Fila],'ARG');'La Fecha de Inicio de Opci¢n no es Habil';IF(Fila=1,FECHAOP,CUOTASL.FECHA2[Fila-1]);IF(Fila=1,CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila-1]);90;;Fecha;;;;;;;;RB11 = 0
 Plazo1    : 'Plazo'          ;;;CUOTASL.PLAZO1[Fila]>0;'El PLAZO DEBE SER POSITIVO';;;60;;Numero;'####'
 Fecha2    : 'Fin Opci¢n'     ;NO;;ESHABIL(CUOTASL.FECHA2[Fila],TABLAFERIADOS1) Y ESHABIL(CUOTASL.FECHA2[Fila],'ARG');'La Fecha de Fin de Opcion No es HABIL';;CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila];90;;Fecha;;;;;;;;RB11 = 0
 Cantidad1 : 'V_Notional'     ;;;CUOTASL.CANTIDAD1[Fila]>0;'NOTIONAL AMMOUNT DEL VEHICULO INCORRECTO';;;200;;Numero;'###,###,###,###.##'
 Precio1   : 'V_Tasa'         ;;;CUOTASL.PRECIO1[Fila]>=VAR('RTASA1') Y CUOTASL.PRECIO1[Fila]<=VAR('RTASA2');'La Tasa del Vehiculo ESTA FUERA DE RANGO: '~VAR('RTASA1')~' '~VAR('RTASA2');;;100;;Numero;'###,###.######'

 *Cantidad3 : 'V_Interes'      ;EV;;NOT EV o [CuotasL.Cantidad3[Fila]<=(CuotasL..Cantidad3[Fila])*(1+Var('PORVAR')/100) y CuotasL.Cantidad3[Fila] >= (CuotasL..Cantidad3[Fila])*(1-Var('PORVAR')/100)];'Importe de Interes Vehiculo Fuera de Rango';;((CUOTASL.CANTIDAD1[Fila]*CUOTASL.PRECIO1[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1);200;;Numero;'###,###,###.##';NO;NO
 Cantidad3 : 'V_Interes'      ;EV;;NOT EV o [CuotasL.Cantidad3[Fila]<=(CuotasL.Cantidad3[Fila])*(1+Var('PORVAR')/100) y CuotasL.Cantidad3[Fila] >= (CuotasL.Cantidad3[Fila])*(1-Var('PORVAR')/100)];'Importe de Interes Vehiculo Fuera de Rango';;((CUOTASL.CANTIDAD1[Fila]*CUOTASL.PRECIO1[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1);200;;Numero;'###,###,###.##';NO;NO
 Cantidad2 : 'C_Notional'     ;;;CUOTASL.CANTIDAD2[Fila]>0;'NOTIONAL AMMOUNT DE LA CONTRAPARTE INCORRECTO';;;200;;Numero;'###,###,###,###.##'
 Precio2   : 'C_Tasa'         ;;;CUOTASL.PRECIO2[Fila]>=VAR('RTASA1') Y CUOTASL.PRECIO2[Fila]<=VAR('RTASA2');'La Tasa de la Contraparte ESTA FUERA DE RANGO: '~VAR('RTASA1')~' '~VAR('RTASA2');;;100;;Numero;'###,###.######'

 *Cantidad4 : 'C_Interes'      ;EV;;NOT EV o [CuotasL.Cantidad4[Fila]<=(CuotasL..Cantidad4[Fila])*(1+Var('PORVAR')/100) y CuotasL.Cantidad4[Fila]>=(CuotasL..Cantidad4[Fila])*(1-Var('PORVAR')/100)];'Importe de Interes ContraParte Fuera de Rango';;((CUOTASL.CANTIDAD2[Fila]*CUOTASL.PRECIO2[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB5+1);200;;Numero;'###,###,###.##';NO;NO
 Cantidad4 : 'C_Interes'      ;EV;;NOT EV o [CuotasL.Cantidad4[Fila]<=(CuotasL.Cantidad4[Fila])*(1+Var('PORVAR')/100) y CuotasL.Cantidad4[Fila]>=(CuotasL.Cantidad4[Fila])*(1-Var('PORVAR')/100)];'Importe de Interes ContraParte Fuera de Rango';;((CUOTASL.CANTIDAD2[Fila]*CUOTASL.PRECIO2[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB5+1);200;;Numero;'###,###,###.##';NO;NO
 Fecha3    : 'Settlement'     ;;;CUOTASL.FECHA3[Fila]=0 O [CUOTASL.FECHA3[Fila]>=CUOTASL.FECHA2[Fila] Y ESHABIL(CUOTASL.FECHA3[Fila],TABLAFERIADOS1) Y ESHABIL(CUOTASL.FECHA3[Fila],'ARG')];'La Fecha de Settlement No es HABIL';;IF(EQSTR(CAMPOMODIFICADO,'CUOTASL.FECHA3['~Fstr(Fila,1,0)~']'),CUOTASL.FECHA3[Fila],CUOTASL.FECHA2[Fila]);90;;Fecha
 Fecha5    : 'F_Ejercicio'    ;NO;;;;;;90;;Fecha
 Fecha4    : 'F.Reset'        ;NO;NOT EQSTR(TIPOTASA3,'FIJA') y NOVACIO(TIPOTASA3);;;;HABILES(IF(RB16=0,CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila]),-PLAZO4,TABLAFERIADOS1,SI); 90;;Fecha;NO;NO;;;;;;
 Total2    : 'Resultado'      ;NO;;;;;;100;;Numero;'###,###.######'

CONDICIONES
NOT EQSTR (ESPECIE, CONTRAESPECIE); 'LAS MONEDAS DEL SWAPTION FIJO FIJO DEBEN SER DIFERENTES'; NO
[FECHAEX1=0 Y FECHAEX2=0] O FECHAEX2>FECHAEX1;'FECHA DE FINAL EXCHANGE DEBE SER MAYOR QUE FECHA DE INITIAL EXCHANGE'; NO
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'El Cliente est  Observado';SI;SI;FSYS;'CLIOBS'
Vacio(Cliente1) o EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB');'El Cliente No esta Habilitado';NO
EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La Especie No esta Habilitada';NO
EqStr(BuscarCampo('Especies','Status','Codigo',ContraEspecie),'HAB');'La ContraEspecie No esta Habilitada';NO
FECHAEX1=0 O [EsHabil(FECHAEX1,'ARG') y ESHABIL(FECHAEX1,TABLAFERIADOS1)];'El Initial Exchange Date debe ser dia Habil';NO
FECHAEX2=0 O [EsHabil(FECHAEX2,'ARG') y ESHABIL(FECHAEX2,TABLAFERIADOS1)];'El Final Exchange Date debe ser dia Habil';NO
NOT EQSTR (VEHICULO1,CLIENTE1);'El Cliente y el Vehiculo deben ser distintos';NO
ESTERMINAL(VEHICULO1,VEHICULO);'El Vehiculo debe ser Terminal';NO
ESTERMINAL(CLIENTE1,CLIENTE);'El Cliente debe ser Terminal';NO
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
VACIO(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR)) O  VERIFICAPERFIL(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR),'TO'~TIPOOP);'Operador no habilitado para ingresar Operaciones del Tipo '~TIPOOP;NO
SI O [Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE) O PLAZORENOVPREDETER<=VCAN12*(1+VAR('RPRECIO2')/100) Y PLAZORENOVPREDETER>=VCAN12*(1-VAR('RPRECIO2')/100)];'COTIZACION CONTABLE Fuera de Rango: '~FSTR(VCAN12*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO2')/100),1,7);NO
SI O [Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE) O PLAZORENOVPREDETER<=VCAN12*(1+VAR('RPRECIO') /100) Y PLAZORENOVPREDETER>=VCAN12*(1-VAR('RPRECIO') /100)];'COTIZACION CONTABLE FUERA DE RANGO: '~FSTR(VCAN12*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOCOTCON'


EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador


MOVIMIENTOS
FechaVto ;Cliente1;ContraEspecie ;;;;;Vehiculo1;1;IF(MB3=0,TotalNetoCli1,-TotalNetoCli1);;IF(MB3=0,'Compra de Opciones','Venta de Opciones');SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;TotalNetoCli1<>0;;Cuenta2;;1;

