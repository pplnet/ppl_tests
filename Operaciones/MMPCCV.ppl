*VCAN3           : 'WH Caso 3'                  ;18;3;;NO;NO;;;;;IF((RB6=2 y MB3=1,(((CANTIDAD+TOTALCOMISIONES)*PLAZO*TOTALAUX2)/IF(RB9=1,36500,36000))*(TOTALAUX1/100)),0)
