CB3             : 'Renovacion'                 ;17;1;;NOT EV;;;;;0 
NrOperacion4    : 'Op.Renovacion'              ;18;1;;CB3=1 Y NOT EV;CB3=1; CB3=0 O [NOVACIO(NROPERACION4) y Incluido(NrOperacion4 , SqlSet("Select NrOperacion from "~DBO~".OPERACIONES Where TipoOp like 'MMPCCV%' and Vehiculo1= '"~VEHICULO1~"' and Especie= '"~ESPECIE~"' ") )] ; 'Operacion de Renovacion incorrecta: Debe ser mismo Tipo, Vehiculo y Moneda  ';NO;; if(CB3=0,'')    ;;;;;; "  Vehiculo1= '"~VEHICULO1~"'    AND  Especie= '"~ESPECIE~"'  and (CB3 = '0' OR CB3 IS NULL)  AND TipoOp = '"~TIPOOP~"'    ";

OperacionRef    : 'Id_Partida'                 ;;2;;NO;NO;VACIO(OPERACIONREF) O [EqStr(BuscarCampo('Operaciones','TipoOp','NrOperacion',OPERACIONREF),'MMPV')];'El Codigo de Id. Partida es Incorrecto';NO;;;;
VCAN1           : 'CantAnt'                    ;12;3;;NO;NO;;;;;BuscarCampo('OPERACIONES','Cantidad+TotalComisiones','NrOperacion',NrOperacion)


ImpGastos2      : 'Tasa_IVA'                   ;1;1;2;RB6=0 O [RB6=2 y MB3=0];RB6=0 O [RB6=2 y MB3=0];;;;VAR('TASAIVA');IF(Incluido(VEHICULO1,VAR('VEHIEXTRAN')),0,IF(VACIO(OPERACIONREF),IF(RB6<=2,IMPGASTOS2,0),OPREF.IMPGASTOS2));;;;;'###,###.######'
TotalAux4       : 'Tasa_Int_IVA'               ;;;2;RB6=0 O [RB6=2 y MB3=0] ;RB6=0 O [RB6=2 y MB3=0];;;;;IF(RB6<=2,PRECIO1+SPREAD,0);;;;;'###,###.######'
TotalIVA        : 'Importe_Iva'                ;;;2;EV;RB6=0 O [RB6=2 y MB3=0];NOT EV o [TOTALIVA<= ROUND(VCAN8*(1+Var('PORVAR')/100),2) y TOTALIVA >= ROUND(VCAN8*(1-Var('PORVAR')/100),2)];'Importe IVA Fuera de Rango: '~FSTR(ROUND(VCAN8*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN8*(1+Var('PORVAR')/100),2),0,2);NO;;IF(RB6=0 O [RB6=2 y MB3=0],(CANTIDAD+TOTALCOMISIONES)*(TOTALAUX4/100)*FACTORDIAS(FECHAOP,FECHAVTO,RB8+1)*(IMPGASTOS2/100),0)  ;;;;;'###,###,###,###,###.##'

TasaBase        : '%Percep. I.B.'              ;5;1;2;[Eqstr(ABM,'A') O Eqstr(MB3,'1')] Y TOTALINTERESES > Var('IBMINIMO');[Eqstr(ABM,'A') O Eqstr(MB3,'1')] Y TOTALINTERESES > Var('IBMINIMO');[TOTALINTERESES > Var('IBMINIMO') Y TASABASE > 0] O [TOTALINTERESES <= Var('IBMINIMO')];'% Ret. Ingresos Brutos en 0 (cero).';SI;;;;;;;'###,###.######'
TotalImpuestos  : 'Importe I.B.'               ;5;2;2;NO;[Eqstr(ABM,'A') O Eqstr(MB3,'1')] Y TOTALINTERESES > Var('IBMINIMO');;;;;IF(TASABASE > 0,TOTALINTERESES * TASABASE / 100, 0);;;;;'###,###.##'

TotalAux1       : 'Tasa WH'                    ;6;1;2;RB6=2;RB6=2;Incluido(Fstr(TOTALAUX1,2,4),VAR('TASAWH'));'El Valor de TASA WH es Erroneo: '~VAR('TASAWH')~' ...';NO;VAR('DEFWH1');IF(VACIO(OPERACIONREF),TOTALAUX1,OPREF.TOTALAUX1);;;;;'###,###.######'
TotalAux2       : 'Tasa_Int_WH'                ;;;2;RB6=2;RB6=2;;;;;PRECIO1+SPREAD;;;;;'###,###.######'
TotalAux3       : 'WH_a_Liquidar'              ;;;2;EV;RB6=2 y MB3=0;NOT EV o [TotalAux3 <= ROUND(VCAN9*(1+Var('PORVAR')/100),2) y TotalAux3>= ROUND(VCAN9*(1-Var('PORVAR')/100),2)];'Importe WHT Fuera de Rango: '~FSTR(ROUND(VCAN9*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN9*(1+Var('PORVAR')/100),2),0,2);NO;;IF(RB6=2 y MB3=0,(CANTIDAD+TOTALCOMISIONES)*(TOTALAUX2/100)*FACTORDIAS(FECHAOP,FECHAVTO,RB8+1)*TOTALAUX1/100,0);;;;;'###,###,###,###,###.##'

ContraEspecie   : 'Esp_Pago_Imp'               ;1;1;2;RB6=3 O RB6=4;RB6=3 O RB6=4;[RB6<>3 y RB6<>4] O [RB6=3 Y NOVACIO(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE, ESPECIE)] O [RB6=4 Y NOVACIO(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE, ESPECIE)];'NO INGRESO LA ESPECIE DE PAGO IMPUESTO';NO;;;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~")and Status = 'HAB' "
TasaPrecan      : 'Alic Imp_Extr'              ;2;1;2;RB6=3 O RB6=4;RB6=3 O RB6=4;[RB6<>3 y RB6<>4] O [RB6=3 Y TASAPRECAN<=30] O [RB6=4 Y TASAPRECAN<=30];'EL IMPUESTO EXTRANJERO DEBE SER <=30';NO;IF(VACIO(OPERACIONREF),VAR('ALICIMPU'),OPREF.TASAPRECAN);;;;;;'###,###.######'
TotalRetenciones: 'Imp.Imp_Extr'               ;3;1;2;EV;RB6=3 O [RB6=4 y MB3=0];NOT EV o [TotalRetenciones<= ROUND(VPRE10*(1+Var('PORVAR')/100),2) y TotalRetenciones>= ROUND(VPRE10*(1-Var('PORVAR')/100),2)];'Importe Impuesto Extranjero Fuera de Rango: '~FSTR(ROUND(VPRE10*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VPRE10*(1+Var('PORVAR')/100),2),0,2);NO;;IF(RB6=3 O [RB6=4 y MB3=0],TOTALINTERESES*TASAPRECAN/100,0);;;;;'###,###,###,###,###.##'

TasaImp1        : '% Retencion'                ;1;2;2;;[INCLUIDO(VTXT5,'NO') y [MB3=0 y [[EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT4,'CERTIF')] o [Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT4,'CERTIF')]]] o [MB3=1 y [[Not EqStr(VTXT1,'AUTORET') y EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT3,'CERTIF')] o [Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT3,'CERTIF')]]] y (TOTALINTERESES-VAR('RETMINIMO'))>0] o [INCLUIDO(VTXT5,'NO') y MB3=1 y EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT3,'CERTIF') y (TOTALINTERESES-VAR('RETMINIMO'))>0] o [INCLUIDO(VTXT5,'NO') y [MB3=1 y [[EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT3,'CERTIF')] o [Not EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT3,'CERTIF')]]] o [MB3=0 y [[Not EqStr(VTXT2,'AUTORET') y EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT4,'CERTIF')] o [Not EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT4,'CERTIF')]]] y (TOTALINTERESES-VAR('RETMINIMO'))>0] o [INCLUIDO(VTXT5,'NO') y MB3=0 y EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT4,'CERTIF') Y (TOTALINTERESES-VAR('RETMINIMO'))>0];;;;VAR('RETINSC');VAR('RETINSC');;;;'###,###.######'
ImporteImp      : 'Imp.Retencion'              ;;;2;EV;INCLUIDO(VTXT5,'NO') y [MB3=0 y [[EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT4,'CERTIF')] o [Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT4,'CERTIF')]]] o [MB3=1 y [[Not EqStr(VTXT1,'AUTORET') y EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT3,'CERTIF')] o [Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT3,'CERTIF')]]];;;;;IF(INCLUIDO(VTXT5,'NO') y [MB3=0 y [[EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT4,'CERTIF')] o [Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT4,'CERTIF')]]] o [MB3=1 y [[Not EqStr(VTXT1,'AUTORET') y EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT3,'CERTIF')] o [Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT3,'CERTIF')]]] y (TOTALINTERESES-VAR('RETMINIMO'))>0,(TOTALINTERESES-VAR('RETMINIMO'))*(TASAIMP1/100),0);;;;;'###,###,###,###,###.##'
TotalGastos     : 'AutoRetencion'              ;;;2;EV;INCLUIDO(VTXT5,'NO') y MB3=1 y EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT3,'CERTIF');;;;;IF(INCLUIDO(VTXT5,'NO') y MB3=1 y EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT3,'CERTIF') y (TOTALINTERESES-VAR('RETMINIMO'))>0,(TOTALINTERESES-VAR('RETMINIMO'))*(TASAIMP1/100),0);;;;;'###,###,###,###,###.##'

