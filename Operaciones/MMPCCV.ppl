VTXT5           : 'Divisiones?'                ;10;2;2;NO;NO;;;;If(Incluido(Ascendientes('VEHICULOS',VEHICULO1),Ascendientes('VEHICULOS',VEHICULO2),1) y EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',VEHICULO1),'DIV') y EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',VEHICULO2),'DIV'),'SI','NO');If(Incluido(Ascendientes('VEHICULOS',VEHICULO1),Ascendientes('VEHICULOS',VEHICULO2),1) y EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',VEHICULO1),'DIV') y EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',VEHICULO2),'DIV'),'SI','NO')

VPRE6           : '% Retencion_Vinc'           ;10;2;2;NO;NO;;;;IF(INCLUIDO(VTXT5,'NO') y [[MB3=0 y [[EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT4,'CERTIF')] o [Not EqStr(VTXT2,'AUTORET') y EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT4,'CERTIF')] o [Not EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT4,'CERTIF')]]] o [MB3=1 y [[EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT3,'CERTIF')] o [Not EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT3,'CERTIF')]]] ],TASAIMP1,0);IF(INCLUIDO(VTXT5,'NO') y [[MB3=0 y [[EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT4,'CERTIF')] o [Not EqStr(VTXT2,'AUTORET') y EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT4,'CERTIF')] o [Not EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT4,'CERTIF')]]] o [MB3=1 y [[EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT3,'CERTIF')] o [Not EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT3,'CERTIF')]]] ],TASAIMP1,0)+RB6-RB6 ;;;;;'###,###.######'
VPRE7           : 'Imp.Retencion_Vinc'         ;;;2;NO;NO;;;;IF(INCLUIDO(VTXT5,'NO') y [MB3=1 y [[EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT3,'CERTIF')] o [Not EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT3,'CERTIF')]]] o [MB3=0 y [[Not EqStr(VTXT2,'AUTORET') y EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT4,'CERTIF')] o [Not EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT4,'CERTIF')]]] y (TOTALINTERESES-VAR('RETMINIMO'))>0,(TOTALINTERESES-VAR('RETMINIMO'))*(TASAIMP1/100),0);IF(INCLUIDO(VTXT5,'NO') y [MB3=1 y [[EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT3,'CERTIF')] o [Not EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT3,'CERTIF')]]] o [MB3=0 y [[Not EqStr(VTXT2,'AUTORET') y EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT4,'CERTIF')] o [Not EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT1,'AUTORET') y Not EqStr(VTXT4,'CERTIF')]]] y (TOTALINTERESES-VAR('RETMINIMO'))>0,(TOTALINTERESES-VAR('RETMINIMO'))*(TASAIMP1/100),0)+RB6-RB6;;;;;'###,###,###,###,###.##'
VPRE8           : 'AutoRetencion_Vinc'         ;;;2;NO;NO;;;;IF(INCLUIDO(VTXT5,'NO') y MB3=0 y EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT4,'CERTIF') Y (TOTALINTERESES-VAR('RETMINIMO'))>0,(TOTALINTERESES-VAR('RETMINIMO'))*(TASAIMP1/100),0);IF(INCLUIDO(VTXT5,'NO') y MB3=0 y EqStr(VTXT2,'AUTORET') y Not EqStr(VTXT4,'CERTIF') Y (TOTALINTERESES-VAR('RETMINIMO'))>0,(TOTALINTERESES-VAR('RETMINIMO'))*(TASAIMP1/100),0);;;;;'###,###,###,###,###.##'

RB3             : 'MOF'                        ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa         : 'Modificado'                 ;10;3;;NO;NO;;;;0

Cotizacion1     : 'TC_Concert.'                ;10;1;2;;Not Eqstr(ESPECIE,VAR('MONEEXTR'));Eqstr(ESPECIE,VAR('MONEEXTR')) O [COTIZACION1<=VPRE9*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE9*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE9*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE9*(1+VAR('RPRECIO2')/100),1,7);NO;;IF(Eqstr(ESPECIE,VAR('MONEEXTR')),1)
Cotizacion2     : 'TC_Vencim.'                 ;;;;COTIZACION2<>0;COTIZACION2<>0;;;;
VPRE9           : 'Cot.TC/USD'                 ;10;2; ;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(ESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)
VCAN7           : 'INTERES MOD'                ;18;1;2;NO;NO;;;;; (CANTIDAD+TOTALCOMISIONES)*((PRECIO1+SPREAD)/100)*FACTORDIAS(FECHAOP,FECHAVTO,RB8+1)
VCAN8           : 'IVA MOD'                    ;18;1;2;NO;NO;;;;; IF(RB6=0 O [RB6=2 y MB3=0],((((CANTIDAD+TOTALCOMISIONES)*PLAZO*TOTALAUX4)/IF(RB7=0,36000,36500))*(IMPGASTOS2/100)),0)
*VCAN9           : 'WHT MOD'                    ;18;1;2;NO;NO;;;;; IF(RB6=2 y MB3=0,(((CANTIDAD+TOTALCOMISIONES)*PLAZO*TOTALAUX2)/IF(RB9=1,36500,36000))*(TOTALAUX1/100)),0)
*VCAN9           : 'WHT MOD'                    ;18;1;2;NO;NO;;;;; IF((RB6=2 y MB3=0,(((CANTIDAD+TOTALCOMISIONES)*PLAZO*TOTALAUX2)/IF(RB9=1,36500,36000))*(TOTALAUX1/100)),0)
VCAN9           : 'WHT MOD'                    ;18;1;2;NO;NO;;;;;IF(RB6=2 y MB3=0,(((CANTIDAD+TOTALCOMISIONES)*PLAZO*TOTALAUX2)/IF(RB9=1,36500,36000))*(TOTALAUX1/100),0)
VPRE10          : 'IMP MOD'                    ;18;1;2;NO;NO;;;;; IF(RB6=3 O [RB6=4 y MB3=0],TOTALINTERESES*TASAPRECAN/100,0)
PrecioMer       : 'Monto USD WF'               ;1;2;2;NO;NO;;;;CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'));CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))
TotalComisiones : 'TotalComisiones'            ;;;2;NO;NO; 
RB9             : 'RB9'                        ;;;2;NO;NO;
RB7             : 'RB7'                        ;;;2;NO;NO; 


VTXT18            : 'Book Def'    ; 1;2;2;NO;NO;;;;;BuscarCampo('VEHICULOS','Alias5','Codigo',VEHICULO1)
VTXT19            : 'Codigo Book' ; 2;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Codigo','Codigo',VTXT18)
VTXT20            : 'Vehic.Book'  ; 3;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Vehiculo','Codigo',VTXT19)

@CUENTAS3
@INDICE1

CONDICIONES
Not EqStrI(Vehiculo1,Vehiculo2);'El Vehiculo Contraparte debe ser diferente al Vehiculo por el cual se ingresa la Operacion';NO;NO;FSYS;'VEHDUPL'
PRECIO1<=VAR('RTASA2') Y PRECIO1>=VAR('RTASA1');'Tasa Fuera de Rango:'~VAR('RTASA1')~" Y "~VAR('RTASA2');SI;SI;FSYS;'RTASA'
ESHABIL(FECHAOP,'ARG');'La Fecha de Origen no es Dia Habil en Argentina';SI;SI;FSYS;'ORIGINH'
ESHABIL(FECHAVTO,'ARG');'La Fecha de Vencimiento NO ES DIA HABIL en Argentina';SI;SI;FSYS;'VTOINH'
VACIO(NROPERACION2) O [EQSTR(TIPOOP,BuscarCampo('Operaciones','TipoOp','NrOperacion',NROPERACION2)) y BuscarCampo('Operaciones','FechaVto','NrOperacion',NROPERACION2)=Fsys y EQSTR(BuscarCampo('Operaciones','Vehiculo1','NrOperacion',NROPERACION2),VEHICULO1) y EQSTR(ESPECIE,BuscarCampo('Operaciones','Especie','NrOperacion',NROPERACION2))];'La Operacion de Referencia es INVALIDA';NO
RB6>2 O [Incluido(Fstr(ImpGastos2,2,2),VAR('IVA'))];'El Valor de TASA IVA es Erroneo: '~VAR('IVA');NO
EQSTR(TIPOTASA,'FIJA') O [SPREAD>=VAR('RSPREAD1') Y SPREAD<=VAR('RSPREAD2')];'El Spread esta Fuera de Rango '~VAR('RSPREAD1')~' '~VAR('RSPREAD2');NO
VACIO(OPERACIONREF) O [OPREF.FECHAVTO>=FECHAOP Y OPREF.MB3=0 Y OPREF.CANTIDAD>=(OPREF.TOTALAUX3-VCAN1+CANTIDAD)];'La Partida '~OPERACIONREF~' No se puede Asociar a esta Operacion';NO
SI Y [PRECIO4<=VAR('RTTN2') Y PRECIO4>=VAR('RTTN1')];'Tasa Total Neta Fuera de Rango:'~VAR('RTTN1')~" Y "~VAR('RTTN2');SI
VACIO(OPERACIONREF) O [FECHAOP>=OPREF.FECHAOP Y FECHAOP<=OPREF.FECHAVTO];'LA FECHA DE ORIGEN DEBE ESTAR INCLUIDA EN EL PLAZO DE LA PARTIDA';NO
ESTERMINAL(VEHICULO2,VEHICULO);'El Vehiculo ContraParte debe ser Terminal';NO
FECHAOP2=Fsys;'La Fecha de Concertacion no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'

@CONDIOP

SI O Incluido(Especie,'ARP|USD') o NoVacio(VTXT18);'El Vehiculo no tiene Book Default para Monedas';NO
SI O Incluido(Especie,'ARP|USD') o NoVacio(VTXT19);'El Book default '~VTXT18~' no es valido';NO
SI O Incluido(Especie,'ARP|USD') o EqStr(VTXT20,Vehiculo1);'El Book default '~VTXT18~' corresponde a otro vehiculo';NO

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador


REFERENCIA
'TotalAux3='~FStr(OPREF.TotalAux3-VCAN1+Cantidad+TotalComisiones,0,2)
'Cuotas1='~FStr(OPREF.Cuotas1+1,0,2)

SQL
"INSERT INTO "~DBO~".CUOTAS (NrOperacion,Mercado1,NrCuota,Fecha1,Cantidad1) "~"Values ('"~OPERACIONREF~"','"~NROPERACION~"',"~Fstr(OPREF.Cuotas1+1,0,0)~", '"~IdxDate(FechaOp)~"', "~Fstr(Cantidad,0,4)~") ";NOVACIO(OPERACIONREF) Y EQSTR(ABM,'A')

POSTEDICION
EqStr(ABM,'A') y QUERY("SELECT COUNT(*) FROM "~DBO~".COMISIONES2 WHERE NrOperacion='"~OPERACIONREF~"' and Tipo='0' ")>0 Y OPREF.TOTALAUX3=0;'MESSAG';String='Debe ACTUALIZAR la Fecha de la Comision FPD para la Operacion '~OPERACIONREF
NOVACIO(OPERACIONREF) Y EQSTR(ABM,'A');'INSCOM';NrOperacion1=OPERACIONREF;NrOperacion2=NROPERACION;String=" Tipo  IN ('5','3')"
EqStr(ABM,'A') y MB4=1;'INSEVI';NrOperacion1=NROPERACION;TipoOp1=TIPOOP;String="MB3='"~Fstr(IF(MB3=0,1,0),1,0)~"',TotalNetoCli2="~FStr(VCAN4,0,2)~",TotalNetoCli1="~FStr(VCAN5,0,2)~",TotalAux3="~FStr(VCAN3,0,2)~",Precio4="~FStr(VPRE2,0,7)~",TotalRetenciones="~FStr(VCAN6,0,2)~" ";Vehiculo1=VEHICULO2;Vehiculo2=VEHICULO1;String1=",ImpGastos2="~FStr(VPRE3,0,6)~",TotalAux4="~FStr(VPRE4,0,6)~",TotalIVA="~FStr(VPRE5,0,2)~",TasaImp1="~FStr(VPRE6,0,2)~",ImporteImp="~FStr(VPRE7,0,2)~",TotalGastos="~FStr(VPRE8,0,2)~" "
@POSTEMM

MOVIMIENTOS
FechaOp     ;Cliente1;Especie;;;;;Vehiculo1;1;IF(MB3=0,-Cantidad,Cantidad);;'Alta '~TIPOOP;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;1;
FechaPrecan ;Cliente1;Especie;;;;;Vehiculo1;1;IF(MB3=0,Cantidad,-Cantidad);;'Vto. '~TIPOOP;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;2;
FechaPrecan ;Cliente1;Especie;;;;;Vehiculo1;1;IF(MB3=0,TotalIntereses,-TotalIntereses);;'Ints.'~TIPOOP;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;;;Cuenta1;;3;
FechaPrecan ;Cliente1;Especie;;;;;Vehiculo1;1;IF(MB3=0,TotalIVA,-TotalIVA);;'IVA '~TIPOOP;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;TotalIVA<>0 Y NO;;Cuenta1;;4;
FechaPrecan ;Cliente1;Especie;;;;;Vehiculo1;1;IF(MB3=0,TotalAux3,-TotalAux3);;'WH '~TIPOOP;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;TotalAux3<>0;;Cuenta1;;7000;
FechaPrecan ;Cliente1;Especie;;;;;Vehiculo1;1;-TotalImpuestos;;'I.B. '~TIPOOP;SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;TotalImpuestos<>0 Y MB3 = 0;;Cuenta1;;6;

DEVENGADOS
FechaOp+1;FechaVto;SI;SI;NO;'ARG';SI;SI;'INTLEN';IF(MB3=0, -TotalIntereses, TotalIntereses);140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;;Especie;
FechaOp+1;FechaVto;SI;SI;NO;'ARG';SI;SI;'INTWHT';IF(MB3=0, -TotalAux3, TotalAux3);140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;;Especie;

@INSTOPVINC
@INST19MMV
@INST19VINC