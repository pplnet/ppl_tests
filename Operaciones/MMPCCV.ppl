CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp2        : 'Fecha Conc.'                ;1;1;;VERIFICAACCESO('OPFVALOR');;FECHAOP2<=FECHAOP;'Fecha incorrecta';NO;FSYS;
FechaOp         : 'Fecha_Origen'               ;2;1;;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1);'La Fecha de Origen no es Habil en la Tabla de Feriados Seleccionada';RB11 = 0;FSYS;

@VEHITO
Vehiculo2       : 'Veh Cprte '                 ;3;1;;NOT EV y VACIO(OPERACIONREF) Y EQSTR(ABM, 'A');;NOVACIO(Vehiculo2);'Debe ingresar un Vehiculo Contraparte';NO;;IF(VACIO(OPERACIONREF),VEHICULO2,OPREF.VEHICULO2);;
Cliente1        : 'Veh.Cprte '                 ;3;1;;NO;NO;;;;;VEHICULO2
Book2           : 'Book Cprte'                 ;3 ;2;;;;[SI O BookValido(BOOK2, TIPOOP, ESPECIE, VEHICULO2, OPERADOR, '' )] Y NoVacio(BOOK2);'Book del Vehiculo Contraparte inválido';NO;;Var('BOOKDEF');;;;;;;

RB6             : 'Caso|Local|ClTe|CeTl|ExtIJ|ExtDJ'    ;4;1;;NOT EV y VACIO(OPERACIONREF);;RB6>=0;'Indique Tipo de Caso';NO;;IF(VACIO(OPERACIONREF),RB6,OPREF.MB5);
MB3             : 'Tipo|Prestamo|Colocacion'   ;5;1;;NOT EV;;MB3>=0;'Indique Prestamo o Colocacion';NO;;
RB10            : 'Precancelable|Si|No'        ;5;2;;;NO;RB10>=0;'Precancelable Si/No';NO;1; 
Especie         : 'Moneda'                     ;6;1;;NOT EV y VACIO(OPERACIONREF);;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'Debe Ingresar una Moneda';NO;;IF(VACIO(OPERACIONREF),ESPECIE,OPREF.ESPECIE);;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";
Cantidad        : 'V_Nominal'                  ;7;1;;NOT EV;;CANTIDAD>0 Y [VACIO(OPERACIONREF) O [[EQSTR(ABM,'A') Y CANTIDAD<=VCAN2] O [NOT EQSTR(ABM,'A') Y CANTIDAD<=(VCAN2+VCAN1)]]];'El Valor Nominal DEBE SER INFERIOR AL Valor Total de la Op.Referencia';NO;;;;;;;'###,###,###,###,###.##'
VCAN2           : 'VN_Disponible'              ;8;1;;NO;NOVACIO(OPERACIONREF);VACIO(OPERACIONREF) O VCAN2+VCAN1>0;'La Partida '~OPERACIONREF~' Fue Completamente Asignada';NO;;(OPREF.CANTIDAD-OPREF.TOTALAUX3);;;;;'###,###,###,###,###.##'
Plazo           : 'Plazo'                      ;6;2;;;;PLAZO>0;'Debe INGRESAR el PLAZO';NO;0;FECHAVTO-FECHAOP
FechaVto        : 'Vto_Monto'                  ;7;2;;;;  ;  ;  ;FECHAOP+PLAZO;FECHAOP+PLAZO
FechaPago       : 'Vto_Monto'                  ;7;2;;;;;;;;FECHAVTO
FechaPrecan     : 'Fecha_Sett'                 ;8;2;;;;EsHabil(FECHAPRECAN,TABLAFERIADOS1) Y FECHAPRECAN >= FECHAVTO;'LA FECHA DE SETTLEMENT NO ES HABIL';NO;FECHAOP+PLAZO;IF(MODI,FECHAPRECAN,FECHAVTO) 

RB8             : 'Day Count|ActAct|Act365F|Act360|360360|30E360' ;9;1;;NOT EV y VACIO(OPERACIONREF);;;;;IF(VACIO(OPERACIONREF),2,OPREF.RB8);IF(VACIO(OPERACIONREF),RB8,OPREF.RB8)
TipoTasa        : 'Tipo_Tasa'                  ;10;1;;VACIO(OPERACIONREF);;NOVACIO(TIPOTASA);'El Tipo de Tasa ES INVALIDO';NO;'FIJA';IF(VACIO(OPERACIONREF),TIPOTASA,OPREF.TIPOTASA)
Precio1         : 'Tasa (%)'                   ;11;1;;VACIO(OPERACIONREF) O NOT EQSTR(TIPOTASA, 'FIJA');;NOVACIO(OPERACIONREF) O [PRECIO1>0];'La Tasa debe ser Positiva';NO;IF(VACIO(OPERACIONREF), PRECIO1, OPREF.Precio1);IF(VACIO(OPERACIONREF), PRECIO1, OPREF.Precio1)
Spread          :                              ;11;2;;VACIO(OPERACIONREF) Y NOT EQSTR(TIPOTASA,'FIJA');NOT EQSTR(TIPOTASA,'FIJA');SPREAD>=0;'El SPREAD Debe SER POSITIVO';NO;0;IF(VACIO(OPERACIONREF),IF(EQSTR(TIPOTASA,'FIJA'),0,SPREAD),OPREF.SPREAD)

TotalIntereses  : 'Interes'                    ;12;1;;EV;;NOT EV o [TotalIntereses <= ROUND(VCAN7*(1+Var('PORVAR')/100),2) y TotalIntereses >= ROUND(VCAN7*(1-Var('PORVAR')/100),2)];'Interes Fuera de Rango: '~FSTR(ROUND(VCAN7*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN7*(1+Var('PORVAR')/100),2),0,2);NO;;(CANTIDAD+TOTALCOMISIONES)*((PRECIO1+SPREAD)/100)*FACTORDIAS(FECHAOP,FECHAVTO,RB8+1);;;;;'###,###,###,###,###.##'
