Precio4         : 'TTN'                        ;12;2;;NO;PRECIO4>0;;;;;
TablaFeriados1  : 'Feriados'                   ;;;;VACIO(OPERACIONREF);;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;IF(VACIO(OPERACIONREF),BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE)) ,OPREF.TABLAFERIADOS1)
MB4             : 'Gen_Contra|No|Si'           ;;;;NOT EV;;MB4>=0;'Genera Contra Operacion?';NO;;
Operador        :                              ;;;;;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
NrOperacion2    : 'Op_Referencia'              ;;;;NO;NO;;;;
