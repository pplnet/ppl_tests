NrOperacion4   : 'Op.Renovacion'              ;; ;;CB3=1;CB3=1; CB3=0 O [NOVACIO(NROPERACION4) y Incluido(NrOperacion4 , SqlSet("Select NrOperacion from "~DBO~".OPERACIONES Where TipoOp like 'MMPCCV%' and Vehiculo1= '"~VTXT1~"' and Especie= '"~VTXT2~"' ") )] ; '**** Operacion incorrecta ';NO;;;;

                                                                                          



Operador       :                              ;;;;;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
