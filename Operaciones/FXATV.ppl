CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp2       : 'Fecha'                      ;1;1;;NO;NO;;;;FECHAOP;FECHAOP;
FechaOp        : 'Fecha Conc.'                ;1;1;;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,'ARG') y ESHABIL(FECHAOP,TABLAFERIADOS1);'Fecha incorrecta';NO;FSYS;
@VEHITO
CB6            : 'Cot.Directa?'               ;;;;;;;;;;IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE~"' "),'INV'),0,1)
RB10           : 'Precancelable|Si|No'        ;2;1;;;NO;RB10>=0;'Precancelable Si/No';NO;1;
Especie        : 'Mon_Recibida'               ;3;1;;NOT EV;;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'Debe Ingresar una Especie Valida';NO;;;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";
Plazo          : 'Plazo_Mon'                  ;;;;;;PLAZO>=VAR('PLMINTERFX');'El PLAZO de la MONEDA DEBE ser mayor o igual a '~VAR('PLMINTERFX')~' dias';NO;0;FECHAVTO-FECHAOP
FechaVto       : 'Vto.Mon.'                   ;;;;;;EsHabil(FECHAVTO,TABLAFERIADOS1);'No es un dia Habil';NO;FECHAOP+PLAZO;FECHAOP+PLAZO
ContraEspecie  : 'Mon_Entregada'              ;3;2;;NOT EV;;NOVACIO(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE,ESPECIE);'Debe ingresar una ContraEspecie';NO;;;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";;;;;
Plazo2         : 'Plazo_M.Ent '               ;;2;;;;PLAZO2>=VAR('PLMINTERFX');'El PLAZO de la MONEDA DE PAGO DEBE ser mayor o igual a '~VAR('PLMINTERFX')~' dias';NO;0;FECHAPAGO-FECHAOP
FechaPago      : 'Vto.M.Ent'                  ;;;;;;EsHabil(FECHAPAGO,TABLAFERIADOS2);'No es un dia Habil';NO;FECHAOP+PLAZO2;FECHAOP+PLAZO2
Vehiculo2      : 'Veh. Cpte. '                ;6;1;;NOT EV;;NOVACIO(VEHICULO2);'El Vehiculo Contraparte no es valido';NO;;;;
Cliente1       : 'Cliente'                    ;6;1;;NO;NO;;;;VEHICULO2;VEHICULO2;;;;;;"Status = 'HAB'";;;;
Book2          : 'Book Cprte'                 ;7;1;;;;[SI O BookValido(BOOK2, TIPOOP, ESPECIE, VEHICULO2, OPERADOR, '' )] y NoVacio(BOOK2);'Book del Vehiculo Contraparte inválido';NO;;Var('BOOKDEF');;;;;;;

Cantidad       : 'VN_Recibir'                 ;;;;RB6=0;;CANTIDAD>0;'El Importe debe ser Positivo';NO;;IF(RB6=1,TOTALBRUTOCLI1*IF(CB6=0,PRECIO1,1/PRECIO1),CANTIDAD)
Precio1        : 'Precio'                     ;;;;;;PRECIO1>0 ;'El Tipo de Cambio debe ser Positivo';NO;0;;;;;;'####.########';
TotalBrutoCli1 : 'VN_Entregar'                ;;;;RB6=1;;;;;;IF(RB6=0,IF(CB6=1,PRECIO1*CANTIDAD,CANTIDAD/PRECIO1),TOTALBRUTOCLI1)
RB6            : 'Partida_Operada|VN_Rec|VN_Entr'     ;7;2;;;;;;;1;;
Operador       :                              ;8;2;;no;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
MB4            : 'Gen_Contra|Si|No'           ;9;2;;;;MB4>=0;'Genera Operacion Contraparte INVALIDO';NO;;
TablaFeriados1 : 'Feriados Rec.'              ;12;1;;;;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE)) 
Cotizacion1    : 'TC_Concert.'                ;;;;;Not [Eqstr(ESPECIE,VAR('MONEEXTR')) o Eqstr(CONTRAESPECIE,VAR('MONEEXTR'))];[Eqstr(ESPECIE,VAR('MONEEXTR')) o Eqstr(CONTRAESPECIE,VAR('MONEEXTR'))] O [COTIZACION1<=VPRE1*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE1*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE1*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE1*(1+VAR('RPRECIO2')/100),1,7);NO;;IF([Eqstr(ESPECIE,VAR('MONEEXTR')) o Eqstr(CONTRAESPECIE,VAR('MONEEXTR'))],1)
Cotizacion2    : 'TC_Vencim.'                 ;;;;COTIZACION2<>0;COTIZACION2<>0;;;;
VPRE1          : 'Cot.TC/USD'                 ;10;2; ;NO;NO;;;;;COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(CONTRAESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)
TablaFeriados2 : 'Feriados Ent.'              ;12;2;;;;NOVACIO(TABLAFERIADOS2);'Se debe indicar feriados a utilizar';NO;;BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',CONTRAESPECIE)) 
OperacionRef   : 'Op_Referencia'              ;;;;NO;NOVACIO(OPERACIONREF);;;;;; 
NrOperacion3   : 'Op.Asociada'                ;;;;NO;NOVACIO(NROPERACION3)

Precio4        : 'Cotizacion'                 ;2;2;2;NO;si;;;;;IF(CB6=1,COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VTXT40)/COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,VTXT40),COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,VTXT40)/COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VTXT40))
PlazoRenovPredeter : 'Cot.Contable'           ;7;2;2;NO Y [NOT EQSTR (COTIZAEN(ESPECIE),CONTRAESPECIE)];NO Y [NOT EQSTR(COTIZAEN(ESPECIE),CONTRAESPECIE)]; SI O [EQSTR(COTIZAEN(ESPECIE),CONTRAESPECIE) o PLAZORENOVPREDETER > 0];'REQUIERE COTIZACION CONTABLE';NO;;IF(MODI, PLAZORENOVPREDETER, IF(Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE), IF(Eqstr(CotizaEn(ESPECIE), VAR('MONELOCA') ), 1 , COTIZACIONBNA(CONTRAESPECIE,FECHAOP,1,NO,NO) )   ))
CB1            : 'Op.Automatica'              ;5;2;2;SI;;;;;0

RB1            : 'Genero CV|NO|SI'            ;7;1;3;NO;NO;;;;;;
RB3            : 'MOF'                        ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa        : 'Modificado'                 ;10;3;;NO;NO;;;;0
VCAN12         : 'Cotizacion de Mercado'      ;18;2;2;No;No;;;;;COTIZACIONC(COTIZAEN(ESPECIE),,,,FECHAOP,1,SI,CONTRAESPECIE))

VPRE5          : 'Cot.ESP/USD'                ;10;3;;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
VPRE6          : 'Cot.CONTESP/USD'            ;10;3;;NO;NO;;;;;COTIZACIONC(CONTRAESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
PaseCB         : 'Proviene de Repo'           ;10;3;;NO;NO;;;;0
PrecioMer      : 'Monto USD WF'               ;10;2;2;NO;NO;;;;;IF(Eqstr(ESPECIE, Var('MONEEXTR')), CANTIDAD, IF(Eqstr(CONTRAESPECIE, Var('MONEEXTR')), TOTALBRUTOCLI1, TOTALBRUTOCLI1*VPRE6))

VCB1          : 'Usa Tolerancia 3er Nivel' ;14;1;2;NO;NO;;;;IF(Incluido(TIPOOP,VAR('OPETENITO')),1,0);IF(Incluido(TIPOOP,VAR('OPETENITO')),1,0)
VPRE11        : 'Rango p/ TC Concertacion' ;14;2;2;NO;NO;;;;IF(Incluido(TIPOOP,VAR('OPETENITO')),VAR('RPRECIO3'),VAR('RPRECIO2'));IF(Incluido(TIPOOP,VAR('OPETENITO')),VAR('RPRECIO3'),VAR('RPRECIO2'))

@FXNDF
@FXCTACONT
@CUENTAS4
@CUENTAS5

CONDICIONES
Not Incluido(ESPECIE,VAR('BONOCANJ'));'La Moneda no debe estar Incluida en la Lista '~VAR('BONOCANJ');NO
Not EqStrI(Vehiculo1,Vehiculo2);'El Vehiculo Contraparte debe ser diferente al Vehiculo por el cual se ingresa la Operacion';NO;NO;FSYS;'VEHDUPL'
NOT EqStr(Especie,ContraEspecie);'La Moneda de Compra y la CONTRAESPECIE son IGUALES';NO
NOT EqStr(ContraEspecie,VTXT40) Y NOT EqStr(Especie,VTXT40);'NO PUEDEN EXISTIR ARBITRAJES CON '~VTXT40;NO
NOT EqStr(ContraEspecie,VTXT40);'La Moneda de Pago NO DEBE SER '~VTXT40;NO
EqStr(BuscarCampo('Especies','Status','Codigo',ContraEspecie),'HAB');'La ContraEspecie No esta Habilitada';NO

SI O [VCB1=1 O [PRECIO1<=PRECIO4*(1+VAR('RPRECIO')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO')/100)]];'Tipo de Cambio Fuera de Rango Nivel 1: ['~FSTR(PRECIO4*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO')/100),1,7)~']';SI;SI;FSYS;'RANGOPREC1'
PRECIO1<=PRECIO4*(1+VAR('RPRECIO')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO')/100);'Tipo de Cambio FUERA DE RANGO: '~FSTR(PRECIO4*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOPRECIO'
SI O [VCB1=1 O [PRECIO1<=PRECIO4*(1+VAR('RPRECIO2')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO2')/100)]];'Tipo de Cambio Fuera de Rango Nivel 2: ['~FSTR(PRECIO4*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO2')/100),1,7)~']';SI;SI;FSYS;'RANGOPREC2'
PRECIO1<=PRECIO4*(1+VAR('RPRECIO2')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO2')/100);'Tipo de Cambio Fuera de Rango: '~FSTR(PRECIO4*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO2')/100),1,7);SI;SI;FSYS;'RANGOPRECIO2'
SI O [VCB1=0 O [PRECIO1<=PRECIO4*(1+VAR('RPRECIO3')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO3')/100)]];'Tipo de Cambio Fuera de Rango Nivel 3: ['~FSTR(PRECIO4*(1-VAR('RPRECIO3')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO3')/100),1,7)~']';SI;SI;FSYS;'RANGOPREC3'

SI O VCB1=1 O [Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE) O PLAZORENOVPREDETER<=VCAN12*(1+VAR('RPRECIO') /100) Y PLAZORENOVPREDETER>=VCAN12*(1-VAR('RPRECIO') /100)];'COTIZACION CONTABLE FUERA DE RANGO: '~FSTR(VCAN12*(1-VAR('RPRECIO') /100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOCOTCON'
SI O VCB1=1 O [Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE) O PLAZORENOVPREDETER<=VCAN12*(1+VAR('RPRECIO2')/100) Y PLAZORENOVPREDETER>=VCAN12*(1-VAR('RPRECIO2')/100)];'COTIZACION CONTABLE Fuera de Rango: '~FSTR(VCAN12*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO2')/100),1,7);NO
SI O VCB1=0 O [Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE) O PLAZORENOVPREDETER<=VCAN12*(1+VAR('RPRECIO3')/100) Y PLAZORENOVPREDETER>=VCAN12*(1-VAR('RPRECIO3')/100)];'COTIZACION CONTABLE Fuera de Rango: '~FSTR(VCAN12*(1-VAR('RPRECIO3')/100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO3')/100),1,7);NO

EsHabil(FECHAPAGO,'ARG');'La Fecha de Vencimiento para Entregar  NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'VTOEINH'
EsHabil(FECHAVTO ,'ARG');'La Fecha de Vencimiento para Recibir NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'VTORINH'
ESTERMINAL(VEHICULO2,VEHICULO);'El Vehiculo ContraParte debe ser Terminal';NO
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
@CONDIOP



EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

SQL
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('COTORNOAS','COTORVENC','COTOREXCE','SETTLENOAS','SETTLEVENC','SETTLECANC') ";EqStr(ABM,'E')
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('SETTLEEXCE','CONTNOAS','CONTVENC','CONTCANC','CONTEXCE')";EqStr(ABM,'E')

POSTEDICION
EQSTR(ABM,'A') y MB4=0;'INSEVI';NrOperacion1=NROPERACION;TipoOp1=TIPOOP;String=" Especie='"~CONTRAESPECIE~"',ContraEspecie='"~ESPECIE~"',Cantidad="~FSTR(TotalBrutoCli1,0,2)~",TotalBrutoCli1="~FSTR(Cantidad,0,2)~",RB6='"~IF(RB6=1,'0','1')~"',TablaFeriados1='"~TABLAFERIADOS2~"',TablaFeriados2='"~TABLAFERIADOS1~"' ";Vehiculo1=VEHICULO2;Vehiculo2=VEHICULO1;String1=",Plazo="~Fstr(PLAZO2,0,0)~",Plazo2="~Fstr(PLAZO,0,0)~",FechaVto='"~IdxDate(FECHAPAGO)~"',FechaPago='"~IdxDate(FECHAVTO)~"' "

MOVIMIENTOS
FechaVto ;Cliente1;Especie      ;;;;;Vehiculo1;1;     -Cantidad;;'Arbitraje Termino '~ESPECIE~'/'~CONTRAESPECIE         ;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;PaseCB=0 Y CB9=0;;Cuenta1;;1;;;;;;;;;;;;;;600
FechaPago;Cliente1;ContraEspecie;;;;;Vehiculo1;1;TotalBrutoCli1;;'Arbitraje Termino Imp. Liq.'~ESPECIE~'/'~CONTRAESPECIE;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;PaseCB=0 Y CB9=0;;Cuenta2;;2;
FechaPago;Cliente1;IF(CB1=1, Especie, ContraEspecie);;;;;Vehiculo1;1;-Precio3;;'Resultado NDF'                          ;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;PaseCB=0 y CB9=1 y CB8=1;;Cuenta2;;10;


POSICION3
FechaOp;FechaVto;Vehiculo1;Book1;'FWD';Especie;'0';2;ContraEspecie;Cantidad;0;0;'1';
FechaOp;FechaVto;Vehiculo1;Book1;'FWD';ContraEspecie;'0';2;Especie;-TotalBrutoCli1;0;0;'1';

LIMITES
FechaOp                            ;Cliente1;'CONTRACT';'USD';; TotalBrutoCli1*VPRE6;TipoOp~' '~Especie;PaseCB=0 y EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',Cliente1),'NOC');Vehiculo1
Habiles(FechaVto,1,TablaFeriados1) ;Cliente1;'CONTRACT';'USD';;-TotalBrutoCli1*VPRE6;TipoOp~' '~Especie;RB15=1 Y PaseCB=0 y EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',Cliente1),'NOC') y FechaVto>=FechaPago y Incluido(Vehiculo1,Var('VLIQUIDAA'));Vehiculo1
Habiles(FechaPago,1,TablaFeriados2);Cliente1;'CONTRACT';'USD';;-TotalBrutoCli1*VPRE6;TipoOp~' '~Especie;RB15=1 Y PaseCB=0 y EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',Cliente1),'NOC') y FechaVto<FechaPago y Incluido(Vehiculo1,Var('VLIQUIDAA'));Vehiculo1
Habiles(FechaVto,1,TablaFeriados1) ;Cliente1;'CONTRACT';'USD';;-TotalBrutoCli1*VPRE6;TipoOp~' '~Especie;RB15=1 Y PaseCB=0 y EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',Cliente1),'NOC') y FechaVto>=FechaPago y Not Incluido(Vehiculo1,Var('VLIQUIDAA')) y Not EqStr(BuscarCampo('CLIENTES','Alias10','Codigo',CLIENTE1),'LIMITELIQ');Vehiculo1
Habiles(FechaPago,1,TablaFeriados2);Cliente1;'CONTRACT';'USD';;-TotalBrutoCli1*VPRE6;TipoOp~' '~Especie;RB15=1 Y PaseCB=0 y EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',Cliente1),'NOC') y FechaVto<FechaPago y Not Incluido(Vehiculo1,Var('VLIQUIDAA')) y Not EqStr(BuscarCampo('CLIENTES','Alias10','Codigo',CLIENTE1),'LIMITELIQ');Vehiculo1


