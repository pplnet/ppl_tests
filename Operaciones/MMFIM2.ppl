@VEHITO
Cliente3        : 'Ent_Arranger'               ;4;1;;NO;;NOVACIO(CLIENTE3); 'La Entidad Contratante es Invalida';NO;;OPREF.CLIENTE1
Cliente2        : 'Ent_Agente  '               ;;;;NO;;NOVACIO(CLIENTE2);'La Entidad Agente es Invalida';NO;;OPREF.CLIENTE2
Especie         : 'Especie'                    ;;;;NO;;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'Debe Ingresar una Moneda';NO;;OPREF.ESPECIE;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~")and Status = 'HAB' "
TipoTasa        : 'Tasa Int'                   ;;;;NO;;;;NO;;OPREF.TIPOTASA
Plazo4          : 'Dias Seteo Tasa'            ;;;;NO;NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA);[PLAZO4>=0] O [EQSTR(TIPOTASA,'FIJA')];'Indique la Cantidad de Dias Previos al Inicio para Setear la Tasa';NO;;OPREF.PLAZO4;
RB16            : 'Setea|InicioPer|FinPer'     ;;;;NO;NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA);RB16=0 O RB16=1 O [EQSTR(TIPOTASA,'FIJA') o VACIO(TIPOTASA)];'Indique Inicio o Fin de Periodo';NO;;OPREF.RB16
RB8             : 'Day Count|ActAct|Act365F|Act360|360360|30E360'           ;;;;NO;;RB8>=0;'Unidad de Tiempo Tasa Interes INVALIDA';NO;;OPREF.RB8

Plazo           : 'Plazo '                     ;4;2;;NO;;;;;;OPREF.PLAZO
FechaVto        : 'Fecha_Vto'                  ;;;;NO;;;;;;OPREF.FECHAVTO
Cliente1        : 'Ent_Participante'           ;;;;NOT EV;;NOVACIO(CLIENTE2);'La Entidad Participante es Invalida';NO;;;;;;;;"Status = 'HAB'";;;;
VCAN2           : 'VN_Disponible'              ;;;;NO;;EV O [NOT EV Y VCAN2>0];'La Operacion '~OPERACIONREF~' Fue Completamente Asignada';NO;;OPREF.TOTALNETOCLI3;;;;;'###,###,###,###,###.##'

TotalBrutoCli2  : 'VNO'                        ;12;1;;NOT EV Y TOTALBRUTOCLI2=CANTIDAD;;TOTALBRUTOCLI2>0 Y [[EQSTR(ABM,'A') Y TOTALBRUTOCLI2<=VCAN2] O [NOT EQSTR(ABM,'A') Y TOTALBRUTOCLI2<=(VCAN2+VCAN1)]];'EL VNO DEBE SER MENOR O IGUAL AL VALOR NOMINAL DISPONIBLE';NO;;IF(EQSTR(ABM,'A'),IF(MODI,OPREF.CANTIDAD,VCAN2),OPREF.CANTIDAD);;;;;'###,###,###,###,###.##'
FechaPago       : 'Fecha VNO'                  ;;;;;;ESHABIL(FECHAPAGO,TABLAFERIADOS1);'FECHA VNO ES INVALIDA';NO;;IF(EQSTR(ABM,'A'),IF(MODI,FECHAPAGO,FECHAOP),FECHAPAGO)

Operador        :                              ;;;;NO;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
NrOperacion3    : 'Cesion'                     ;;;;NO;NOVACIO(NROPERACION3)
                                  
Cantidad        : 'VNA'                        ;12;2;;NO;;;;;;IF(EQSTR(ABM,'A') O VCAN1=VCAN3,TOTALBRUTOCLI2,CANTIDAD);;;;;'###,###,###,###,###.##'
FechaVto2       : 'Fecha VNA'                  ;;;;NO;;ESHABIL(FECHAVTO2,TABLAFERIADOS1);'FECHA VNA ES INVALIDA';NO;;IF(EQSTR(ABM,'A'),IF(MODI,FECHAVTO2,FECHAPAGO),FECHAVTO2)
TablaFeriados1  : 'Feriados'                   ;;;;NOT EV;;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE)) 
Cuotas1         : 'Nr_Periodos'                ;;;;NO;;;;;;OPREF.CUOTAS1
Observac2       : 'Operador EAr'               ;;;;NO;;;;;;OPREF.OBSERVAC2;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
RB5             : 'Definitivo?|Si|No'          ;17;1;;NO;;;;;;OPREF.RB9
CB10            : 'Pmo.|Local|Extranjero'      ;1;3;2;NO;NO;;;;;IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),0,1)
TotalAux1       : 'Tasa WH'                    ;1;1;2;CB10=1;CB10=1;CB10=0 O Incluido(Fstr(TotalAux1,2,4),VAR('TASAWH'));'El Valor de TASA WH es Erroneo: '~VAR('TASAWH')~' ...';NO;;;;;;;'###,###.######'
VCAN1           : 'VNAAnt'                     ;;1;2;NO;NO;;;;;BuscarCampo('OPERACIONES','Cantidad','NrOperacion',NrOperacion)
VCAN3           : 'VNOAnt'                     ;;1;2;NO;NO;;;;;BuscarCampo('OPERACIONES','TotalBrutoCli2','NrOperacion',NrOperacion)
ImpGastos2      : 'Tasa_IVA'                   ;1;2;2;;;;;;;;;;;;'###,###.######'
TasaImp1        : '% Imp.Interes'              ;;;2;CB10=1;CB10=1;CB10=0 O [Incluido(Fstr(TASAIMP1,2,4),VAR('TASAINT'))];'El Valor de TASA Impuesto  INTERES es Erroneo: '~VAR('TASAINT')~' ...';NO;;IF(CB10=1,VAR('DEFAINT'),0);;;;;'###,###.######'

VCAN10          : 'ComEF'                      ;;2;2;NO;NO;;;;;IF(NOVACIO(OPERACIONREF),QUERY(" Select Tasa1 from "~DBO~".COMISIONES2 where NrOperacion='"~OPERACIONREF~"' AND Tipo='5'"),SUM(COM2L,2,1,5));;;;;'###.#####'
ContraEspecie   : 'ContraEspecie';;;2;NO;NO;
PrecioEj        : 'PrecioEj'      ;;;2;NO;NO;
TotalComisiones : 'TotalComisiones';;;2;NO;NO;
RB6             : 'RB6';;;2;NO;NO;

RB3             : 'MOF'                        ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa         : 'Modificado'                 ;10;3;;NO;NO;;;;0
VPRE5           : 'Cot.ESP/USD'                ;10;3;;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
VPRE6           : 'Cot.CONTESP/USD'            ;10;3;;NO;NO;;;;;COTIZACIONC(CONTRAESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
Cotizacion1     : 'TC_Concert.'                ;5;1;2;;Not Eqstr(ESPECIE,VAR('MONEEXTR'));Eqstr(ESPECIE,VAR('MONEEXTR')) O [COTIZACION1<=VPRE9*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE9*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE9*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE9*(1+VAR('RPRECIO2')/100),1,7);NO;;IF(Eqstr(ESPECIE,VAR('MONEEXTR')),1)
Cotizacion2     : 'TC_Vencim.'                 ;;;;COTIZACION2<>0;COTIZACION2<>0;;;;
VPRE9           : 'Cot.TC/USD'                 ;10;2; ;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(ESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)
VTXT1           : 'Participo?'                 ;9;2;;NO;NO;;;;;QUERY("Select NrOperacion from "~DBO~".OPERACIONES where OperacionRef='"~OPERACIONREF~"'  and Cliente1='"~CLIENTE1~"' and TipoOp='"~TIPOOP~"' and NrOperacion<>'"~NROPERACION~"' ")

Precio5         : 'Precio5'                    ;1;1;1;NO;NO;
ContraEspecie5  : 'ContraEspecie5'             ;1;1;1;NO;NO;
ContraEspecie6  : 'ContraEspecie6'             ;1;1;1;NO;NO;
Precio6         : 'Precio6'                    ;1;1;1;NO;NO;

VTXT18          : 'Book Def'    ; 1;2;2;NO;NO;;;;;BuscarCampo('VEHICULOS','Alias5','Codigo',VEHICULO1)
VTXT19          : 'Codigo Book' ; 2;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Codigo','Codigo',VTXT18)
VTXT20          : 'Vehic.Book'  ; 3;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Vehiculo','Codigo',VTXT19)

@CUENTAS
@CTAMONLOC

@INDICEFRN

@COMIOP


LISTA:SI;IF(EQSTR(ABM,'A'),0,CUOTAS1);
 Tasa1    : 'Tasa Amort'     ;NO;[NOT EQSTR(ABM,'A')];;;;;100;;Numero;'###,###.######'
 Cantidad4: 'Imp. Amort'     ;NO;[NOT EQSTR(ABM,'A')];;;;;200;NO;Numero;'###,###,###,###,###.##'
 Cantidad2: 'V.Nominal'      ;NO;[NOT EQSTR(ABM,'A')];;;;;200;NO;Numero;'###,###,###,###,###.##'
 Fecha1   : 'Inicio Per'     ;NO;[NOT EQSTR(ABM,'A')];;;;;90;;Fecha
 Plazo1   : 'Plazo'          ;NO;[NOT EQSTR(ABM,'A')];;;;;60;;Numero;'####'
 Fecha2   : 'Fin Per'        ;NO;[NOT EQSTR(ABM,'A')];;;;;90;NO;Fecha
 Fecha3   : 'Settlement'     ;NO;[NOT EQSTR(ABM,'A')];;;;;90;NO;Fecha                            
 Precio2  : 'Tasa Interes'   ;NO;[NOT EQSTR(ABM,'A')];;;;;100;;Numero;'###,###.######'

 Precio4  : 'Spread'         ;NO;[NOT EQSTR(ABM,'A')];;;;;100;;Numero;'###,###.######'
 Precio1  : 'IVA'            ;EV;[NOT EQSTR(ABM,'A')];NOT EV o [[ROUND(CUOTASL.PRECIO1[Fila],2) <= ROUND((CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.PRECIO1[Fila],2) >= ROUND((CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe IVA Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100),2),0,2);;((CUOTASL.CANTIDAD2[Fila]*CUOTASL.TASA2[Fila])*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1))*(IMPGASTOS2/100);200;NO;Numero;'###,###,###,###,###.##';NO;NO;'11';
 Tasa2    : 'Tasa_Int_IVA'   ;;;NOT EV o CUOTASL.TASA2[Fila]>=0;'Ingrese la Tasa para el Calculo del Iva';;;100;;Numero;'###,###.######'
 Precio3  : 'WH'             ;EV;NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) Y [NOT EQSTR(ABM,'A')];NOT EV o [[ROUND(CUOTASL.PRECIO3[Fila],2) <= ROUND((CUOTASL.PRECIO7[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.PRECIO3[Fila],2) >= ROUND((CUOTASL.PRECIO7[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe WHT Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO7[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO7[Fila]*(1+Var('PORVAR')/100),2),0,2);;((CUOTASL.CANTIDAD2[Fila]*CUOTASL.TOTAL6[Fila])*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1)) * (TOTALAUX1/100);200;NO;Numero;'###,###,###,###,###.##';NO;NO;'13';
 Total6   : 'Tasa_Int_WH'    ;;NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));NOT EV o CUOTASL.TOTAL6[Fila]>=0;'Ingrese la Tasa para el Calculo de WH';;;100;;Numero;'###,###.######'
 Total9   : 'Impto.Interes'  ;EV;NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) Y [NOT EQSTR(ABM,'A')];NOT EV o [[ROUND(CUOTASL.TOTAL9[Fila],2)<=ROUND((NUM(CUOTASL.PRECIOREF1[Fila])*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.TOTAL9[Fila],2)>=ROUND((NUM(CUOTASL.PRECIOREF1[Fila])*(1-Var('PORVAR')/100)),2)]];'Importe Impuesto Interes Fuera de Rango: '~FSTR(ROUND(NUM(CUOTASL.PRECIOREF1[Fila])*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(NUM(CUOTASL.PRECIOREF1[Fila])*(1+Var('PORVAR')/100),2),0,2);;IF(NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),CUOTASL.CANTIDAD3[Fila]*TASAIMP1/100,0);200;NO;Numero;'###,###,###,###,###.##';NO;NO;
 Cantidad3: 'Interes'        ;NO;[NOT EQSTR(ABM,'A')];;;;;200;NO;Numero;'###,###,###,###,###.##'
 Cantidad5: 'Interes Total'  ;NO;[NOT EQSTR(ABM,'A')];;;;CUOTASL.CANTIDAD3[Fila]+IF(NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),CUOTASL.PRECIO3[Fila],0)+CUOTASL.TOTAL9[Fila];200;NO;Numero;'###,###,###,###,###.##'
 Total2   : 'Monto'          ;NO;[NOT EQSTR(ABM,'A')];;;;CUOTASL.CANTIDAD4[Fila]+CUOTASL.CANTIDAD3[Fila];200;NO;Numero;'###,###,###,###,###.##'
 Total1   : 'Monto Total'    ;NO;[NOT EQSTR(ABM,'A')];;;;CUOTASL.CANTIDAD4[Fila]+CUOTASL.CANTIDAD5[Fila];200;NO;Numero;'###,###,###,###,###.##'
 Total3   : 'Tasa T.Neta'    ;NO;[NOT EQSTR(ABM,'A')];;;;;200;NO;Numero;'###,###.#####'
 PrecioRef1: 'MOD Impto.Interes' ;NO;NO;;;;Fstr(CUOTASL.CANTIDAD3[Fila]*TASAIMP1/100,0,2);200;;String;
 Precio6  : 'MOD IVA'            ;NO;NO;;;;((CUOTASL.CANTIDAD2[Fila]*CUOTASL.TASA2[Fila]/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1))*(IMPGASTOS2/100);200;;Numero;'###.######'
 Precio7  : 'MOD WHT'            ;NO;NO;;;;((CUOTASL.CANTIDAD2[Fila]*CUOTASL.TOTAL6[Fila]/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1))*(TOTALAUX1/100);200;;Numero;'###.######'
 Cotizacion1: 'TC_IVA'           ;NO;NO;;;-1;;200;;Numero;'###.######'
@INDICECTAS
 Fecha4   : 'F.Reset'           ;NO;NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA);;;;HABILES(IF(RB16=0,CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila]),-PLAZO4,TABLAFERIADOS1,SI); 90;;Fecha;NO;NO;;;;;;
 Tasa7    : '% Amort Orig'   ;NO;NO;;;;;100;;Numero;'###,###.######';NO;NO;

CALLS:[NOT EQSTR(ABM,'A')] y RB10<=0;10;
  FechaEj      : 'Fecha_Ej'       ;NO;;CALLSL.FECHAEJ[Fila]=0 O [ESHABIL(CALLSL.FECHAEJ[Fila],TABLAFERIADOS1) Y ESHABIL(CALLSL.FECHAEJ[Fila],'ARG') Y CALLSL.FECHAEJ[Fila]>FECHAOP2];'La Fecha de Ejercicio No es HABIL';;;90;NO;Fecha
  PrecioEj     : 'Precio_Ej'      ;NO;;CALLSL.PRECIOEJ[Fila]=0 O CALLSL.PRECIOEJ[Fila]>0;'El Precio de Ejercicio debe ser positivo';100;;100;;Numero;'###,###.######'
  Ejercida     : 'Ejercio'        ;NO;;;;;;50;;Check
  FechaPago    : 'F_Pago'         ;NO;;CALLSL.EJERCIDA[Fila]=0 O [ESHABIL(CALLSL.FECHAPAGO[Fila],TABLAFERIADOS1) Y ESHABIL(CALLSL.FECHAPAGO[Fila],'ARG')];'El Vencimiento No es HABIL';;;90;;Fecha
  PorCancelar  : '%_Canc'         ;NO;;CALLSL.EJERCIDA[Fila]=0 O [CALLSL.EJERCIDA[Fila]=1 Y CALLSL.PORCANCELAR[Fila]>0 y CALLSL.PORCANCELAR[Fila]<=100];'El Porcentaje Cancelable es Incorrecto';;;100;;Numero;'###.######'
  VNCancelado  : 'VN_Cancelado'   ;NO;;CALLSL.EJERCIDA[Fila]=0 O [CALLSL.VNCANCELADO[Fila]>0];'El Valor Nominal Cancelado Debe ser Positivo';;;200;;Numero;'###,###,###,###,###.##'
  ImpVNCancela : 'Imp_Pagar'      ;NO;;CALLSL.EJERCIDA[Fila]=0 O [CALLSL.IMPVNCANCELA[Fila]>0];'El Importe a Pagar por el Valor Nominal Cancelado Debe ser Positivo';;;200;;Numero;'###,###,###,###,###.##'
  IntCorridosEj: 'Int_Corridos'   ;NO;;CALLSL.EJERCIDA[Fila]=0 O [CALLSL.INTCORRIDOSEJ[Fila]>0];'Los Interes Corridos Deben ser Positivos';;;200;;Numero;'###,###,###,###,###.##'
  ImporteTotEj : 'Total_Pagar'    ;NO;;CALLSL.EJERCIDA[Fila]=0 O [CALLSL.IMPORTETOTEJ[Fila]>0];'El Importe Total a Pagar debe ser Positivo';;;200;;Numero;'###,###,###,###,###.##'

PUTS:[NOT EQSTR(ABM,'A')] y RB10<=0;10;
  FechaEj      : 'Fecha_Ej'       ;NO;;PUTSL.FECHAEJ[Fila]=0 O [ESHABIL(PUTSL.FECHAEJ[Fila],TABLAFERIADOS1) Y ESHABIL(PUTSL.FECHAEJ[Fila],'ARG') Y PUTSL.FECHAEJ[Fila]>FECHAOP2];'La Fecha de Ejercicio No es HABIL';;;90;NO;Fecha
  PrecioEj     : 'Precio_Ej'      ;NO;;PUTSL.PRECIOEJ[Fila]=0 O PUTSL.PRECIOEJ[Fila]>0;'El Precio de Ejercicio debe ser positivo';100;;100;;Numero;'###,###.######'
  Ejercida     : 'Ejercio'        ;NO;;;;;;50;;Check
  FechaPago    : 'F_Pago'         ;NO;;PUTSL.EJERCIDA[Fila]=0 O [ESHABIL(PUTSL.FECHAPAGO[Fila],TABLAFERIADOS1) Y ESHABIL(PUTSL.FECHAPAGO[Fila],'ARG')];'El Vencimiento No es HABIL';;;90;;Fecha
  PorCancelar  : '%_Canc'         ;NO;;PUTSL.EJERCIDA[Fila]=0 O [PUTSL.EJERCIDA[Fila]=1 Y PUTSL.PORCANCELAR[Fila]>0 y PUTSL.PORCANCELAR[Fila]<=100];'El Porcentaje Cancelable es Incorrecto';;;100;;Numero;'###.######'
  VNCancelado  : 'VN_Cancelado'   ;NO;;PUTSL.EJERCIDA[Fila]=0 O [PUTSL.VNCANCELADO[Fila]>0];'El Valor Nominal Cancelado Debe ser Positivo';;;200;;Numero;'###,###,###,###,###.##'
  ImpVNCancela : 'Imp_Pagar'      ;NO;;PUTSL.EJERCIDA[Fila]=0 O [PUTSL.IMPVNCANCELA[Fila]>0];'El Importe a Pagar por el Valor Nominal Cancelado Debe ser Positivo';;;200;;Numero;'###,###,###,###,###.##'
  IntCorridosEj: 'Int_Corridos'   ;NO;;PUTSL.EJERCIDA[Fila]=0 O [PUTSL.INTCORRIDOSEJ[Fila]>0];'Los Interes Corridos Deben ser Positivos';;;200;;Numero;'###,###,###,###,###.##'
  ImporteTotEj : 'Total_Pagar'    ;NO;;PUTSL.EJERCIDA[Fila]=0 O [PUTSL.IMPORTETOTEJ[Fila]>0];'El Importe Total a Pagar debe ser Positivo';;;200;;Numero;'###,###,###,###,###.##'

CONDICIONES
DESCIENDEDECLIENTE(CLIENTE1,'BANCOS');'Entidad Participante debe ser Banco Local o Extranjero';NO
RB6<>2 O [RB6=2 Y DESCIENDEDECLIENTE(CLIENTE2,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE2))] ;'La Entidad Negociadora debe ser un Banco Local';NO
ESHABIL(FECHAVTO2,'ARG');'La Fecha de Vencimiento NO ES DIA HABIL en Argentina';SI;SI;FSYS;'VTOINH'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'La Entidad Contratante esta Deshabilitada';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'La Entidad Contratante esta Observada';SI;SI;FSYS;'CLIOBS'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE2));'La Entidad Negociadora esta deshabilitada';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE2));'La Entidad Negociadora esta Observada';SI;SI;FSYS;'CLIOBS'
EQSTR('MMFCMV',BuscarCampo('Operaciones','TipoOp','NrOperacion',OPERACIONREF));'La Operacion de Referencia es INVALIDA';NO
VACIO(VTXT1);'La Entidad '~CLIENTE1~' Es Participante en la Operacion '~VTXT1~' !!!';NO
FECHAOP2=Fsys;'La Fecha de Concertacion no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'

@CONDIOP

SI O Incluido(Especie,'ARP|USD') o NoVacio(VTXT18);'El Vehiculo no tiene Book Default para Monedas';NO
SI O Incluido(Especie,'ARP|USD') o NoVacio(VTXT19);'El Book default '~VTXT18~' no es valido';NO
SI O Incluido(Especie,'ARP|USD') o EqStr(VTXT20,Vehiculo1);'El Book default '~VTXT18~' corresponde a otro vehiculo';NO


EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
NO;'Esta Operacion se elimina Evento'
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

POSTEDICION
EQSTR(ABM,'A');'INS';NrOperacion1=OPERACIONREF;NrOperacion2=NROPERACION;String1=""
NOVACIO(OPERACIONREF) y EQSTR(ABM,'A');'INCOMV';NrOperacion1=OPERACIONREF;NrOperacion2=NROPERACION;String=" Tipo  IN ('5','3')";String1=""
SI;'UIVAWH';NrOperacion1=OPERACIONREF;
@POSTEMM


SQL
"INSERT INTO "~DBO~".OPSCALLSPUTS (NrOperacion,TipoOpcion,FechaEj,PrecioEj,Ejercida) SELECT '"~NROPERACION~"' As NrOperacion,TipoOpcion,FechaEj,PrecioEj,Ejercida FROM "~DBO~".OPSCALLSPUTS WHERE NrOperacion='"~OPERACIONREF~"' ";EqStr(ABM,'A')

REFERENCIA
'TotalBrutoCli2='~FStr(OPREF.TotalBrutoCli2-VCAN1+Cantidad,0,2);NOT EV
'TotalNetoCli3='~FStr(OPREF.TotalNetoCli3+VCAN1-Cantidad,0,2);NOT EV

