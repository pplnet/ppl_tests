CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp       : 'Fecha Conc.'          ; 1;1;1;Not EV y VERIFICAACCESO('OPFVALOR');  ;ESHABIL(FECHAOP,TABLAFERIADOS1) Y EsHabil(FECHAOP,'ARG');'Fecha incorrecta';NO;FSYS;
@VEHITO
@CAMPSINTFX

Especie       : 'Moneda'               ; 3;1; ;NOT EV y [CB13=0 o [CB13=1 y CB14=0]];  ;NoVacio(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE) y [CB13=0 o [CB13=1 y [[CB14=0 y Not EqStr(ESPECIE,VTXT2)] o [CB14=1 y EqStr(ESPECIE,VTXT2)]]]];'Debe Ingresar una Especie Valida';NO;;IF(CB13=1 y CB14=1,VTXT2,ESPECIE);;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'"
ContraEspecie : 'Mon.Cobro'            ; 4;1; ;NO;  ;NoVacio(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE,ESPECIE);'Debe ingresar una ContraEspecie';NO;;VTXT40
Plazo         : 'Plazo Moneda'         ; 3;3; ;NO;NO;;;;;IF(VALORRB1<0,0,IF(VALORRB1=0 Y PUESTO=1,0,IF(VALORRB1=1 Y [PUESTO=0],2,IF(VALORRB1=2,IF(PUESTO=1,2,3),IF(VALORRB1=3,IF(PUESTO=1,3,4),1)))))
Plazo2        : 'Plazo M.Cobro'        ; 4;3; ;NO;NO;;;;;IF(VALORRB1<0,0,IF(VALORRB1=0,0,IF(VALORRB1=2,2,1)))
FechaVto      : 'F.Vto.Mon.'           ; 3;2; ;NO;  ;EsHabil(FECHAVTO,TABLAFERIADOS1) y [CB13=0 o [CB13=1 y FechaVto=VFEC7]];'El Vto. de la MOneda debe ser DIA HABIL o no coincide con el vto de la cuota del Pmo relacionado';NO;0;IF(VALORRB1<0,0,HABILES(FECHAOP,PLAZO,TABLAFERIADOS1,SI))
FechaPago     : 'F.Vto.Mon.Cobro'      ; 4;2; ;NO;  ;EsHabil(FECHAPAGO,TABLAFERIADOS1);'No es un Dia Habil';NO;;IF(VALORRB1<0,0,HABILES(FECHAOP,PLAZO2,TABLAFERIADOS1,SI))
ValorRB1      : 'Valor|Hoy|Normal'     ; 5;1; ;SI;SI;;;;0;
Puesto        : 'Puesto'               ; 5;2; ;  ;  ;;;;1;
Cliente1      : 'Entidad '             ; 7;1; ;NOT EV y CB13=0;  ;NoVacio(CLIENTE1);'El Cliente no es valido';NO;;IF(CB13=1,VTXT4,CLIENTE1);;;;;;"Status = 'HAB'";;;;
Cantidad      : 'V_Nominal'            ; 8;1; ;  ;  ;CANTIDAD>0;'El Valor Nominal DEBE SER POSITIVO';NO;
Precio1       : 'Precio'               ; 9;1; ;  ;  ;PRECIO1>0;'El Precio DEBE SER POSITIVO';NO;;;;;;;'###.########';
TotalBrutoCli1: 'Imp_Bruto'            ;10;1; ;NO;  ;;;;;IF(CB6=1,PRECIO1*CANTIDAD,CANTIDAD/PRECIO1);
OperacionRef  : 'Op_Referencia'        ;11;1; ;NO;NoVacio(OPERACIONREF);
CB5           : 'Repo_Sint'            ; 7;2; ;  ;NO  ;
Operador      :                        ; 8;2; ;NO;  ;NoVacio(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
Observac2     : 'Op.Contraparte'       ; 9;2; ;  ;  ;NoVacio(OBSERVAC2);'El Operador Contraparte no es valido';SI;;;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
TablaFeriados1: 'Feriados'             ;10;2; ;  ;  ;NoVacio(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE)) 
DeltaTasa     : '%Imp.DB/CR'           ;13;1; ;  ;  ;[Incluido(Fstr(DELTATASA,2,2),VAR('IMPCHEQUE'))];'El Valor de TASA Impuesto CHEQUE Es Erroneo: '~VAR('IMPCHEQUE')~' ...';NO;0;;;;;;'###,###.######'
PeriodoInts   : 'Imp.DB/CR'            ;14; ; ;EV;;Not EV o [PERIODOINTS   <= ROUND(VPRE3*(1+Var('PORVAR')/100),2) y PERIODOINTS>= ROUND(VPRE3*(1-Var('PORVAR')/100),2)];'Impuesto al Cheque CR Fuera de Rango: '~FSTR(ROUND(VPRE3*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VPRE3*(1+Var('PORVAR')/100),2),0,2);NO;;TOTALBRUTOCLI1*(DELTATASA/100);;;;;'###,###,###,###,###.##'
VPRE3         : 'Imp_Cheque CR'        ;15; ; ;NO;NO;;;;;TOTALBRUTOCLI1*(DELTATASA/100);;;;;'###,###,###,###,###.##'
ConceptoBCRA  : 'Conc. BCRA'           ;13;2; ;;;[Not Incluido(VEHICULO1,VAR('VEHIEXTRAN')) Y NoVacio(ConceptoBCRA)] O [Incluido(VEHICULO1,VAR('VEHIEXTRAN')) Y Vacio(ConceptoBCRA)];'Concepto BCRA Invalido';NO;

@COMIFX

Precio4       : 'Cotizacion'           ;12;2;2;NO;NO;;;;;IF(CB6=1,CotizacionC(ESPECIE,,,,FECHAOP,1,SI,VTXT40)/CotizacionC(CONTRAESPECIE,,,,FECHAOP,1,SI,VTXT40),CotizacionC(CONTRAESPECIE,,,,FECHAOP,1,SI,VTXT40)/CotizacionC(ESPECIE,,,,FECHAOP,1,SI,VTXT40))
Cotizacion1   : 'TC_Concert.'          ;15; ;2;  ;Not Eqstr(ESPECIE,VAR('MONEEXTR'));Eqstr(ESPECIE,VAR('MONEEXTR')) O [Cotizacion1<=VPRE1*(1+VAR('RPRECIO2')/100) Y Cotizacion1>=VPRE1*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE1*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE1*(1+VAR('RPRECIO2')/100),1,7);NO;;IF(Eqstr(ESPECIE,VAR('MONEEXTR')),1)
Cotizacion2   : 'TC_Vencim.'           ;  ; ;2;Cotizacion2<>0;Cotizacion2<>0;
CB6           : 'Cot.Esp/ContDirecta'  ; 4;2;2;NO;NO;;;;;IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE~"' "),'INV'),0,1)
PaseCB        : 'Origen Pase'          ;10;3;2;NO;NO;;;;0
Arbitraje     : 'Origen Arbitraje'     ;10;3;2;NO;NO;;;;0
RB3           : 'MOF'                  ;10;2;2;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa       : 'Modificado'           ;10;3;2;NO;NO;;;;0
VPRE5         : 'Cot.ESP/USD'          ;10;3;2;NO;NO;;;;;CotizacionC(ESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
VPRE6         : 'Cot.CONTESP/USD'      ;10;3;2;NO;NO;;;;;CotizacionC(CONTRAESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
VPRE1         : 'Cot.TC/USD'           ;10;2;2;NO;NO;;;;;CotizacionC(CONTRAESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(CONTRAESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)
VCAN2         : 'LimCon Especie'       ;10;2;2;NO;NO;;;;;LimConsumido(CLIENTE1,'SETTLEMENT',ESPECIE,FECHAVTO,,,,NROPERACION)
VCAN3         : 'LimCon C-Esp'         ;11;2;2;NO;NO;;;;;LimConsumido(CLIENTE1,'SETTLEMENT',CONTRAESPECIE,FECHAPAGO,,,,NROPERACION)
VCAN4         : 'Especie'              ;12;2;2;NO;NO;;;;;IF(VCAN2>0,IF(VCAN2-VCAN8>0,-VCAN8,-VCAN2),0)
VCAN5         : 'ContraEspecie'        ;13;2;2;NO;NO;;;;;IF(VCAN3+VCAN8>0,IF(VCAN3<0,VCAN3+VCAN8,VCAN8),0)
VCAN1         : 'Total Settlement'     ;14;2;2;NO;NO;;;;;LimSumado(CLIENTE1,'SETTLEMENT',FECHAVTO,,,,NROPERACION)+VCAN4+VCAN5
VCAN6         : 'Total SetCre'         ;15;2;2;NO;NO;;;;;LimConsumido(CLIENTE1,'SETCRE',VTXT6,0,,,,NROPERACION,FECHAVTO)+VCAN8
VCAN7         : 'Total Sett.c/SetCre'  ;16;2;2;NO;NO;;;;;LimConsumido(CLIENTE1,'SETCRE',VTXT6,0,,,,NROPERACION,FECHAVTO)+VCAN1
VCAN8         : 'Equivalente USD'      ;17;2;2;NO;NO;;;;;if(EqStr(ESPECIE,VTXT6),CANTIDAD,TOTALBRUTOCLI1*CotizacionC(CONTRAESPECIE,,,,Fsys,1,SI,VTXT6))
VTXT6         : 'EspecieLimiteSett'    ; 1;2;2;NO;NO;;;;;QUERY("SELECT Especie FROM "~DBO~".LIMASIGNADOS WHERE Cliente='"~CLIENTE1~"' AND Limite='SETTLEMENT' ")
PrecioMer     : 'Monto USD WF'         ;10;2;2;NO;NO;;;;TOTALBRUTOCLI1*VPRE6;TOTALBRUTOCLI1*VPRE6
SectorRB      : 'Fuera Param Mer|NO|SI'; 2;2;2;NO;NO;;;;

VCB1          : 'Usa Tolerancia 3er Nivel' ;14;1;2;NO;NO;;;;IF(Incluido(TIPOOP,VAR('OPETENITO')),1,0);IF(Incluido(TIPOOP,VAR('OPETENITO')),1,0)
VPRE11        : 'Rango p/ TC Concertacion' ;14;2;2;NO;NO;;;;IF(Incluido(TIPOOP,VAR('OPETENITO')),VAR('RPRECIO3'),VAR('RPRECIO2'));IF(Incluido(TIPOOP,VAR('OPETENITO')),VAR('RPRECIO3'),VAR('RPRECIO2'))

@FXCTACONT
@CUENTAS

CONDICIONES
Not Incluido(ESPECIE,VAR('BONOCANJ'));'La Moneda no debe estar Incluida en la Lista '~VAR('BONOCANJ');NO
EsHabil(FECHAVTO,'ARG');'La Fecha de Liquidacion de Moneda NO ES HABIL EN ARGENTINA';SI;SI;Fsys;'VTOEINH'
EsHabil(FECHAPAGO,'ARG');'La Fecha de Liquidacion de Moneda NO ES HABIL EN ARGENTINA';SI;SI;Fsys;'VTOCINH'
Not EqStr(Especie,ContraEspecie);'La Moneda de Venta y la CONTRAESPECIE son IGUALES';NO
EqStr(ContraEspecie,VTXT40);'La Moneda de Cobro DEBE SER '~VTXT40;NO
Vacio(Cliente1) o EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB');'El Cliente No esta Habilitado';NO
EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La Especie No esta Habilitada';NO
EqStr(BuscarCampo('Especies','Status','Codigo',ContraEspecie),'HAB');'La ContraEspecie No esta Habilitada';NO

SI O [VCB1=1 O [PRECIO1<=PRECIO4*(1+VAR('RPRECIO') /100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO') /100)]];'Tipo de Cambio Fuera de Rango Nivel 1: ['~FSTR(PRECIO4*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO')/100),1,7)~']';SI;SI;FSYS;'RANGOPREC1'
PRECIO1<=PRECIO4*(1+VAR('RPRECIO') /100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO') /100) ;'Tipo de Cambio FUERA DE RANGO: '~FSTR(PRECIO4*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOPRECIO'
SI O [VCB1=1 O [PRECIO1<=PRECIO4*(1+VAR('RPRECIO2')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO2')/100)]];'Tipo de Cambio Fuera de Rango Nivel 2: ['~FSTR(PRECIO4*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO2')/100),1,7)~']';SI;SI;FSYS;'RANGOPREC2'
PRECIO1<=PRECIO4*(1+VAR('RPRECIO2')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO2')/100);'Tipo de Cambio Fuera de Rango: '~FSTR(PRECIO4*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO2')/100),1,7);SI;SI;FSYS;'RANGOPRECIO2'
SI O [VCB1=0 O [PRECIO1<=PRECIO4*(1+VAR('RPRECIO3')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO3')/100)]];'Tipo de Cambio Fuera de Rango Nivel 3: ['~FSTR(PRECIO4*(1-VAR('RPRECIO3')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO3')/100),1,7)~']';SI;SI;FSYS;'RANGOPREC3'

Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'El Cliente esta Observado';SI;SI;FSYS;'CLIOBS'
SI O [Vacio(CORREDOR) o [PORCOMCOR1>=VAR('RCOMCOR1') y PORCOMCOR1<=VAR('RCOMCOR2')]];'El % Comision Corredor EXCEDE Los Limites: Min.'~VAR('RCOMCOR1')~' Max.'~VAR('RCOMCOR2');NO

SI O [VCB1=1 O Incluido(VEHICULO1,VAR('VEHIEXTRAN')) O [TCCOMCOR1<=TIPOCAMBIO2*(1+VAR('RPRECIO')/100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-VAR('RPRECIO')/100)]];'Cambio COMISION CORREDOR Fuera de Rango Nivel 1: ['~FSTR(TIPOCAMBIO2*(1-VAR('RPRECIO') /100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+VAR('RPRECIO') /100),1,7)~']';SI;SI;FSYS;'RANGOPREC1'
Incluido(VEHICULO1,VAR('VEHIEXTRAN')) O [TCCOMCOR1<=TIPOCAMBIO2*(1+VAR('RPRECIO')/100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-VAR('RPRECIO')/100)];'Cambio  COMISION CORREDOR  FUERA DE RANGO: '~FSTR(TIPOCAMBIO2*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOPRECIO'
SI O [VCB1=1 O Incluido(VEHICULO1,VAR('VEHIEXTRAN')) O [TCCOMCOR1<=TIPOCAMBIO2*(1+VAR('RPRECIO2')/100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-VAR('RPRECIO2')/100)]];'Cambio COMISION CORREDOR Fuera de Rango Nivel 2: ['~FSTR(TIPOCAMBIO2*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+VAR('RPRECIO2')/100),1,7)~']';SI;SI;FSYS;'RANGOPREC2'
Incluido(VEHICULO1,VAR('VEHIEXTRAN')) O [TCCOMCOR1<=TIPOCAMBIO2*(1+VAR('RPRECIO2')/100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-VAR('RPRECIO2')/100)];'Cambio COMISION CORREDOR Fuera de Rango: '~FSTR(TIPOCAMBIO2*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+VAR('RPRECIO2')/100),1,7);SI;SI;FSYS;'RANGOPRECIO2'
SI O [VCB1=0 O Incluido(VEHICULO1,VAR('VEHIEXTRAN')) O [TCCOMCOR1<=TIPOCAMBIO2*(1+VAR('RPRECIO3')/100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-VAR('RPRECIO3')/100)]];'Cambio COMISION CORREDOR Fuera de Rango Nivel 3: ['~FSTR(TIPOCAMBIO2*(1-VAR('RPRECIO3')/100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+VAR('RPRECIO3')/100),1,7)~']';SI;SI;FSYS;'RANGOPREC3'

Not EQSTR (VEHICULO1,CLIENTE1);'El Cliente y el Vehiculo deben ser distintos';NO
ESTERMINAL(VEHICULO1,VEHICULO);'El Vehiculo debe ser Terminal';NO
ESTERMINAL(CLIENTE1,CLIENTE);'El Cliente debe ser Terminal';NO

[Not NoVacio(CLIENTE1)] o [FechaVto<>FechaPago] o ExisteLimite('SETTLEMENT',Cliente1,VTXT6); 'Settlement no asignado';SI;SI;FSYS;'SETTLENOAS'
[Not NoVacio(CLIENTE1)] o [FechaVto<>FechaPago] o Not ExisteLimite('SETTLEMENT',Cliente1,VTXT6) o VtoLimite('SETTLEMENT',Cliente1,VTXT6) >= FechaOp; 'Settlement vencido el '~FECHA(VtoLimite('SETTLEMENT',Cliente1,VTXT6));SI;SI;FSYS;'SETTLEVENC'
[Not NoVacio(CLIENTE1)] o [FechaVto<>FechaPago] o Not LimCancelado('SETTLEMENT',Cliente1,VTXT6); 'Settlement cancelado';SI;SI;FSYS;'SETTLECANC'
[Not NoVacio(CLIENTE1)] o [FechaVto<>FechaPago] o LimAsignado(Cliente1,'SETTLEMENT',VTXT6) >= VCAN6; 'Settlement excedido  '~PYC(VCAN6-LimAsignado(Cliente1,'SETTLEMENT',VTXT6),1,0)~'.-';SI;SI;FSYS;'SETTLEEXCE'

FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
Vacio(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR)) O  VERIFICAPERFIL(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR),'TO'~TIPOOP);'Operador no habilitado para ingresar Operaciones del Tipo '~TIPOOP;NO

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

SQL
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('COTORNOAS','COTORVENC','COTOREXCE','SETTLENOAS','SETTLEVENC','SETTLECANC') ";EqStr(ABM,'E')
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('SETTLEEXCE','CONTNOAS','CONTVENC','CONTCANC','CONTEXCE')";EqStr(ABM,'E')

MOVIMIENTOS
FechaVto ;Cliente1;Especie;;;;;Vehiculo1;1;Cantidad ;;'Venta de Moneda Valor Nominal';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2') );;PaseCB=0 y Arbitraje=0;;Cuenta1;;1;
FechaPago;Cliente1;ContraEspecie ;;;;;Vehiculo1;1;-TotalBrutoCli1 ;;'Venta de Moneda Imp. Liq.';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2') );;PaseCB=0 y Arbitraje=0;;Cuenta2;;2;;;;;;;;;;;;;;600
FechaPago;Cliente1;ContraEspecie;;;;;Vehiculo1;1; PeriodoInts   ;;'Imp.DB/CR';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2') );;PeriodoInts<>0;;Cuenta1;;5;

FechaPago;IF(Vacio(Corredor), Cliente1, Corredor);ContraEspecie2;;;;;Vehiculo1;4;  ImpComMer1 ;;'Venta de Moneda Comision Corredor';SI;SI;;PaseCB=0 y Arbitraje=0 y ImpComMer1<>0;;Cuenta2;;3;
FechaPago;IF(Vacio(Corredor), Cliente1, Corredor);ContraEspecie2;;;;;Vehiculo1;1;  ImpComMer1 ;;'Venta de Moneda Comision Corredor';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2') );;PaseCB=0 y Arbitraje=0 y ImpComMer1<>0;;Cuenta2;;40;
FechaPago;IF(Vacio(Corredor), Cliente1, Corredor);ContraEspecie2;;;;;Vehiculo1;1;TotalIva;;'Venta de Moneda IVA Comision Corredor';SI; Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;PaseCB=0;;Cuenta2;;50;

LIMITES
FechaVto;Cliente1;'SETCRE'  ;VTXT6;; VCAN8;TipoOp~' '~Especie;Arbitraje=0 y PaseCB=0 y FechaVto=FechaPago
Habiles(FechaVto,1,TablaFeriados1);Cliente1;'SETCRE'  ;VTXT6;;-VCAN8;TipoOp~' '~Especie;RB15=1 Y Arbitraje=0 y PaseCB=0 y FechaVto=FechaPago y Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2') );
FechaVto;Cliente1;'SETCRE'  ;VTXT6;;-VCAN8;TipoOp~' '~Especie;RB15=1 Y Arbitraje=0 y PaseCB=0 y FechaVto=FechaPago y Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2') ) y Not EqStr(BuscarCampo('CLIENTES','Alias10','Codigo',CLIENTE1),'LIMITELIQ');

POSICION
FechaVto;Vehiculo1;Especie;;;;Vehiculo1;;;;;31;-Cantidad;Precio1;;;;;'FX';;

FechaOp ;Vehiculo1;Especie;;;;Vehiculo1;;;;;122;-Cantidad;Precio1;;;BOOK1;;'FXS';;
FechaOp ;Vehiculo1;Especie;;;;Vehiculo1;;;;;132;-Cantidad;Precio1*CotizacionC(CONTRAESPECIE,,,,FECHAOP-1,1,SI,'USD');;;BOOK1;;'FXS';;


POSTEDICION
INCLUIDO(ABM,'A') y CB13=1 y CB14=1;'ACTSPE';NrOperacion1=NROPERACION5;Entero1=CUOTAS1;Cantidad1=CANTIDAD;Radio1=0;Check1=1
INCLUIDO(ABM,'D') y CB13=1 y CB14=1;'ACTSPE';NrOperacion1=NROPERACION5;Entero1=CUOTAS1;Cantidad1=CANTIDAD;Radio1=1;Check1=1

@INSTOPE
@INST19FX
@INST19BITS
