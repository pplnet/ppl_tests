Cliente2         : 'Exportadora'     ;03;2;1;;;DesciendeDeCliente(CLIENTE2,'VINCULADOS');'La Exportadora Debe ser un Vehiculo';NO;;;;;;;;" DesciendeDeCliente(CLIENTE2, VINCULADOS) = 1 ";
