FechaOp:         'Fecha Op.'         ;06;1;1;;;;;;FSys;;
Plazo:           'Dias a Desc.'      ;06;2;1;NO;;;;;;FECHAVTO2-FECHAOP;
Precio2:         'Tasa'              ;07;1;1;;;PRECIO2>0;'La TNA debe ser positiva';NO;
Precio3:         'Tasa Adelantada'   ;07;2;1;NO;;;;;;(PRECIO2*PLAZO/IF(DIASANIO<1,36000,36500))/(1+(PRECIO2*PLAZO/IF(DIASANIO<1,36000,36500)))*IF(DIASANIO<1,36000,36500)/PLAZO;
MB1:'Ints. sobre|TNA|Tasa Adelantada';08;1;1;;;;;;;1;
PrecioMer:       'Precio Merc.'      ;08;2;1;;;;;;;
Precio1:         'TC'                ;9;1;1;;;PRECIO1>0;'El TC debe ser positivo';NO;TIPOCAMBIO;
