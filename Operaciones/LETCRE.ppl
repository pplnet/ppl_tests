TotalBrutoCli1:  'Cantidad u$s'      ;10;1;1;;;TOTALBRUTOCLI1>0;'El Monto de la LC debe ser Positivo';NO;;
Cantidad:        'Cantidad $'        ;10;2;1;NO;;;;;;TOTALBRUTOCLI1*IF(EQSTR(CONTRAESPECIE,'PESOS'),PRECIO1,1);
TotalBrutoCli2:  'Intereses u$s'     ;11;1;1;NO;;;;;;TOTALBRUTOCLI1*IF(MB1=0,PRECIO2,PRECIO3)*PLAZO/IF(DIASANIO<1,36000,36500);
TotalIntereses:  'Intereses $'       ;11;2;1;NO;;;;;;TOTALBRUTOCLI2*IF(EQSTR(CONTRAESPECIE,'PESOS'),PRECIO1,1);
TotalDerechos:   'IVA Ints. u$s'     ;12;1;1;NO;;;;;;IF(EQSTR(CLIENTE1,'BPBA'),0,TOTALBRUTOCLI2*VAR('IVA_INT'));
TotalNetoCli3:   'IVA Ints. $'       ;12;2;1;NO;;;;;;IF(EQSTR(CLIENTE1,'BPBA'),0,TOTALINTERESES*VAR('IVA_INT'));
TotalBrutoCli3:  'Gastos u$s'        ;13;1;1;;;;;;;IF(EQSTR(CLIENTE1,'BPBA'),60,0);
TotalGastos:     'Gastos $'          ;13;2;1;NO;;;;;;TOTALBRUTOCLI3*IF(EQSTR(CONTRAESPECIE,'PESOS'),PRECIO1,1);
TotalRetenciones:'IVA Gastos u$s'    ;14;1;1;NO;;;;;;IF(EQSTR(CLIENTE1,'BPBA'),0,TOTALBRUTOCLI3*VAR('IVA'));
TotalImpuestos:  'IVA Gastos $'      ;14;2;1;NO;;;;;;IF(EQSTR(CLIENTE1,'BPBA'),0,TOTALGASTOS*VAR('IVA'));
TotalNetoCli2:   'Monto u$s'         ;15;1;1;NO;;;;;;TOTALBRUTOCLI1-TOTALBRUTOCLI2-TOTALBRUTOCLI3-TOTALRETENCIONES;
TotalNetoCli1:   'Monto $'           ;15;2;1;NO;;;;;;CANTIDAD-TOTALINTERESES-TOTALGASTOS-TOTALIMPUESTOS;
ContraEspecie2:  'TNA InterDiv.'     ;16;1;1;;;NoVacio(CONTRAESPECIE2);'Debe Ingresar una TNA Interdivisional';NO;'LIB180'
Precio4:         'Spread InterDiv.'  ;16;2;1;;;PRECIO4>0;'El Spread InterDiv. debe ser positivo';NO;0.375
