RB8            : 'Day_Count|Act Act|Act 365F|Act 360|360 360|30E 360' ;;;;;;;;;2;
Vehiculo2      : 'Veh Cprte '                 ;;;;NOT EV y EqStr(ABM,'A');;NOVACIO(Vehiculo2);'Debe ingresar un Vehiculo Contraparte';NO;;;;
Book2          : 'Book Cprte'                 ; ;1;;  ;  ;[SI O BookValido(BOOK2, TIPOOP, ESPECIE, VEHICULO2, OPERADOR, '' )] y NoVacio(BOOK2);'Book del Vehiculo Contraparte inválido ';NO;;Var('BOOKDEF');;;;;;;
Cliente1       : 'Cliente'                    ;3;1;;NO;NO;;;;VEHICULO2;VEHICULO2;

MB4            : 'Gen_Contra|Si|No'           ;6;2;;;;MB4>=0;'Genera Operacion Contraparte INVALIDO';NO;;
