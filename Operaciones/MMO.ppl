CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp2        : 'Fecha Conc.'                ;1;1;;VERIFICAACCESO('OPFVALOR');;FECHAOP2<=FECHAOP;'Fecha incorrecta';NO;FSYS;
FechaOp         : 'Fecha_Origen'               ;2;1;;NOT EV Y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1);'Fecha de Origen Incorrecta';RB11 = 0;FSYS;
@VEHITO
Operador        :                              ;;2;;;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
Cliente1        : 'Entidad'                    ;4;1;;NOT EV;;NOVACIO(CLIENTE1);'La Entidad Contratante ES INCORRECTA';NO;;
Observac2       : 'Op.Contraparte'             ;4;2;;;;NOVACIO(OBSERVAC2);'El Operador CONTRAPARTE es INVALIDO';SI;;;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
Especie         : 'Moneda'                     ;6;1;;NOT EV;;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'Debe Ingresar una Moneda';NO;'USD';;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";
Cantidad        : 'Valor Nominal'              ;;;;NOT EV;;CANTIDAD>0;'El Valor Nominal DEBE SER POSITIVO';NO;;;;;;;'###,###,###,###,###.##'
TipoTasa        : 'Tipo_Tasa'                  ;6;2;;;NO;NOVACIO(TIPOTASA);'El Tipo de Tasa ES INVALIDO';NO;'FIJA';
Spread          :                              ;7;2;;NOT EQSTR(TIPOTASA,'FIJA');NOT EQSTR(TIPOTASA,'FIJA');SPREAD>=0;'El SPREAD Debe SER POSITIVO';NO;0;
Plazo           : 'Plazo'                      ;8;2;;;;;;NO;FECHAVTO-FECHAOP;FECHAVTO-FECHAOP
FechaVto        : 'Fecha_Vto'                  ;9;2;;NO;;ESHABIL(FECHAVTO,TABLAFERIADOS1);'Fecha de vencimiento no habil';NO;HABILES(FECHAOP,1,TABLAFERIADOS1,SI);FECHAOP+PLAZO;
Precio1         : 'Tasa (%)'                   ;8;1;;;;PRECIO1>0;'La Tasa Debe ser positiva';NO;
TotalIntereses  : 'Interes'                    ;;;;EV;;NOT EV o [TotalIntereses <= ROUND(VCAN7*(1+Var('PORVAR')/100),2) y TotalIntereses >= ROUND(VCAN7*(1-Var('PORVAR')/100),2)];'Inter¦s Fuera de Rango: '~FSTR(ROUND(VCAN7*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN7*(1+Var('PORVAR')/100),2),0,2);NO;;CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000);;;;;'###,###,###,###,###.##'
TotalBrutoCli1  : 'Monto'                      ;;;;NO;;;;;;CANTIDAD+TOTALINTERESES;
Plazo4          : 'Dias Seteo Tasa'            ;;;;;NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA);[PLAZO4>=0] O [EQSTR(TIPOTASA,'FIJA')];'Indique la Cantidad de Dias Previos al Inicio para Setear la Tasa';NO;;
Precio4         : 'Tasa Total Neta'            ;;;;NO;PRECIO4>0;
RB8             : 'U.Tiempo|360|365'           ;10;2;;;;RB8>=0;'Unidad de Tiempo Tasa Interes INVALIDA';NO;0;
TablaFeriados1  : 'Feriados'                   ;11;2;;;;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE)) 

RB7             : 'Convenio|NO|SI'             ;13;1;;;NO;RB7 >= 0;'Debe Indicar si es Convenio';NO;0;

OperacionRef    : 'Op_Referencia'              ;13;2;;;;;;;
RB3             : 'MOF'                        ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa         : 'Modificado'                 ;10;3;;NO;NO;;;;0
Cotizacion1     : 'TC_Concert.'                ;1;1;2;;Not Eqstr(ESPECIE,VAR('MONEEXTR'));;;;;IF(Eqstr(ESPECIE,VAR('MONEEXTR')),1)
Cotizacion2     : 'TC_Vencim.'                 ;;;;COTIZACION2<>0;COTIZACION2<>0;;;;
FechaPrecan     : 'F.Reset'                    ;3;1;2;NO;NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA);;;;;HABILES(FECHAOP,-PLAZO4,TABLAFERIADOS1,SI);
RB11            : 'Ajuste|NO|SI'               ;5;1;2;;NO;;;;0;

VPRE1           : 'Cot.TC/USD'                 ;10;2; ;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(ESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)
VCAN7           : 'INTERES MOD'                ;18;1;2;NO;NO;;;;;CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000);
VCAN8           : 'Equivalente USD'            ;17;2;2;NO;NO;;;;;if(EqStr(ESPECIE,'USD'),TOTALBRUTOCLI1,(TOTALBRUTOCLI1)*if(EqStr(Modo(ESPECIE,'USD'),'DIR'),COTIZACION1,1/IF(COTIZACION1<=0,1,COTIZACION1)))
VCAN9           : 'Total Consumido'            ;16;2;2;NO;NO;;;;;VCAN10+LIMCONSUMIDO(CLIENTE1,'COTOR','USD',0,,,,NROPERACION)
VCAN10          : 'Capital  USD'               ;17;2;2;NO;NO;;;;;if(EqStr(ESPECIE,'USD'),CANTIDAD,CANTIDAD*if(EqStr(Modo(ESPECIE,'USD'),'DIR'),COTIZACION1,1/IF(COTIZACION1<=0,1,COTIZACION1)))

VTXT18            : 'Book Def'    ; 1;2;2;NO;NO;;;;;BuscarCampo('VEHICULOS','Alias5','Codigo',VEHICULO1)
VTXT19            : 'Codigo Book' ; 2;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Codigo','Codigo',VTXT18)
VTXT20            : 'Vehic.Book'  ; 3;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Vehiculo','Codigo',VTXT19)
ContraEspecie     : 'ContraEspecie';;;2;NO;NO;
MB3            : 'Tipo|Pasiva|Activo'         ;15;1;1;NO;NO;;;;IF(Incluido(TIPOOP,VAR('OPEACT')),1,0);IF(Incluido(TIPOOP,VAR('OPEACT')),1,0)

@CUENTAS
@RANGOTASA


CONDICIONES
SI O [PRECIO1<=VPRE12 Y PRECIO1>=VPRE11];'Tasa Fuera de Rango: '~VPRE11~" Y "~VPRE12;SI;SI;FSYS;'RTASA'
PRECIO1<=VAR('RTASA2') Y PRECIO1>=VAR('RTASA1');'Tasa Fuera de Rango: '~VAR('RTASA1')~" Y "~VAR('RTASA2');SI;SI;FSYS;'RTASA'
ESHABIL(FECHAOP,'ARG');'La Fecha de Origen no es Dia Habil en Argentina';SI;SI;FSYS;'ORIGINH'
ESHABIL(FECHAVTO,'ARG');'La Fecha de Vencimiento NO ES DIA HABIL en Argentina';SI;SI;FSYS;'VTOINH'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'El Cliente esta Observado';SI;SI;FSYS;'CLIOBS'
SI o DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y [Not EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1))];"El Cliente debe er una Entidad Bancaria EXTRANJERA";NO
VACIO(OPERACIONREF) O [EQSTR(TIPOOP,BuscarCampo('Operaciones','TipoOp','NrOperacion',OPERACIONREF)) y BuscarCampo('Operaciones','FechaVto','NrOperacion',OPERACIONREF)=Fsys y EQSTR(BuscarCampo('Operaciones','Vehiculo1','NrOperacion',OPERACIONREF),VEHICULO1) y EQSTR(ESPECIE,BuscarCampo('Operaciones','Especie','NrOperacion',OPERACIONREF))];'La Operacion de Referencia es INVALIDA';NO
EQSTR(TIPOTASA,'FIJA') O [SPREAD>=VAR('RSPREAD1') Y SPREAD<=VAR('RSPREAD2')];'El Spread esta Fuera de Rango '~VAR('RSPREAD1')~' '~VAR('RSPREAD2');SI;SI;FSYS;'RANGOSPREAD'
PRECIO4<=VAR('RTTN2') Y PRECIO4>=VAR('RTTN1');'Tasa Total Neta Fuera de Rango:'~VAR('RTTN1')~" Y "~VAR('RTTN2');SI
FECHAOP2=Fsys;'La Fecha de Concertacion no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
[NOT NOVACIO(CLIENTE1)] o ExisteLimite('COTOR',Cliente1,'USD')                                                   ; 'Lim.Credito no asignado'                                                                ;SI;SI;FSYS;'COTORNOAS'
[NOT NOVACIO(CLIENTE1)] o Not ExisteLimite('COTOR',Cliente1,'USD') o VtoLimite('COTOR',Cliente1,'USD') >= FechaOp; 'Lim.Credito vencido el '~FECHA(VtoLimite('COTOR',Cliente1,'USD'))                       ;SI;SI;FSYS;'COTORVENC'
[NOT NOVACIO(CLIENTE1)] o LimAsignado(Cliente1,'COTOR','USD') >= VCAN9                                           ; 'Lim.Credito excedido en U$D '~PYC(-(LimAsignado(Cliente1,'COTOR','USD')-VCAN9),1,0)~'.-';SI;SI;FSYS;'COTOREXCE'

@CONDIOP

SI O Incluido(Especie,'ARP|USD') o NoVacio(VTXT18);'El Vehiculo no tiene Book Default para Monedas';NO
SI O Incluido(Especie,'ARP|USD') o NoVacio(VTXT19);'El Book default '~VTXT18~' no es valido';NO
SI O Incluido(Especie,'ARP|USD') o EqStr(VTXT20,Vehiculo1);'El Book default '~VTXT18~' corresponde a otro vehiculo';NO

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

SQL
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('COTORNOAS','COTORVENC','COTOREXCE','SETTLENOAS','SETTLEVENC','SETTLECANC') ";EqStr(ABM,'E')
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('SETTLEEXCE','CONTNOAS','CONTVENC','CONTCANC','CONTEXCE')";EqStr(ABM,'E')

POSTEDICION
@POSTEMM

MOVIMIENTOS
FechaOp ;Cliente1;Especie;;;;;Vehiculo1;1; Cantidad        ;;'Alta  Overnight';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;1;
FechaVto;Cliente1;Especie;;;;;Vehiculo1;1;-Cantidad        ;;'Vto.Cap.  Overnight';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;2;;;;;;;;;;;;;;600
FechaVto;Cliente1;Especie;;;;;Vehiculo1;1;-TotalIntereses  ;;'Vto.Int.  Overnight';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta1;;3;

DEVENGADOS
FechaOp+1 ;FechaVto;SI;SI;NO;'ARG';SI;SI;'INTLEN';TotalIntereses;140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;;Especie;

POSICION
FechaOp  ;Vehiculo1;Especie;;;;Vehiculo1;;;;;122;-Cantidad      ;COTIZACIONC(ESPECIE,,,,FECHAOP-1,1,SI,'ARP')  ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD');
FechaOp  ;Vehiculo1;Especie;;;;Vehiculo1;;;;;132;-Cantidad      ;COTIZACIONC(ESPECIE,,,,FECHAOP-1,1,SI,'USD')  ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD');
FechaVto ;Vehiculo1;Especie;;;;Vehiculo1;;;;;122; Cantidad      ;COTIZACIONC(ESPECIE,,,,FECHAVTO-1,1,SI,'ARP') ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD');
FechaVto ;Vehiculo1;Especie;;;;Vehiculo1;;;;;132; Cantidad      ;COTIZACIONC(ESPECIE,,,,FECHAVTO-1,1,SI,'USD') ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD');
FechaVto ;Vehiculo1;Especie;;;;Vehiculo1;;;;;122; TotalIntereses;COTIZACIONC(ESPECIE,,,,FECHAVTO-1,1,SI,'ARP') ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD');
FechaVto ;Vehiculo1;Especie;;;;Vehiculo1;;;;;132; TotalIntereses;COTIZACIONC(ESPECIE,,,,FECHAVTO-1,1,SI,'USD') ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD');

LIMITES
FechaOp2                          ;Cliente1;'COTOR';'USD';; VCAN8;TipoOp~' '~Especie;NoVacio(Cliente1);
Habiles(FechaVto,1,TablaFeriados1);Cliente1;'COTOR';'USD';;-VCAN8;TipoOp~' '~Especie;RB15=1 Y NoVacio(Cliente1) y Incluido(Vehiculo1,Var('VLIQUIDAA'));
FechaVto                          ;Cliente1;'COTOR';'USD';;-VCAN8;TipoOp~' '~Especie;RB15=1 Y NoVacio(Cliente1) y Not Incluido(Vehiculo1,Var('VLIQUIDAA')) y Not EqStr(BuscarCampo('CLIENTES','Alias10','Codigo',CLIENTE1),'LIMITELIQ');

@INSTOPE
@INST19MM
@INST19BITS