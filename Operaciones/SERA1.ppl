ImpGastos1        : 'Gastos_SP'                  ;14;1;;;;IMPGASTOS1>=VAR('GASTOS1') Y IMPGASTOS1<=VAR('GASTOS2');'Los Gastos de la Operacion Spot Estan fuera de Rango: '~VAR('GASTOS1')~' y '~VAR('GASTOS2');NO;;
TotalIntereses    : 'Interes_SP'                 ;15;;;;Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE');;;;;IF(MODI,TOTALINTERESES,IF(Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE'),ValorTeorico2(ESPECIE,FECHAVTO)*CANTIDAD*TASAINTERESESCUPON/DIASA(EspecieDiasAnio(ESPECIE),FSYS)/100*IF(EspecieDiasAnio(ESPECIE)=0 y EspecieDiasMes(ESPECIE)=0,Dif360(FECHAULTCUPON,FECHAVTO,4),DifDias(FECHAULTCUPON,FECHAVTO,'USA',NO)),0));
