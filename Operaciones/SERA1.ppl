Plazo2            : 'Pl.Moneda Spot'             ;4;3;;NO;NO;(PLAZO2 DIV 24)*24=PLAZO2;'El Plazo de Moneda debe ser multiplo de 24';NO;-1;IF(RB6<0,-1,IF(RB6=0,0,IF(RB6=1,24,IF(RB6=2,48,72))))
RB6               : 'Pl.M.Spot|0|24|48|72'       ;5;2;;;;RB6>=0;'Plazo Moneda Incorrecto';NO;;IF(MODI,RB6,(BuscarCampo('Especies','PlazoLiq','Codigo',CONTRAESPECIE) DIV 24))
