TotalBrutoCli2    : 'Monto Futuro'               ;;;;Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE');;TOTALBRUTOCLI2>0;;NO;;IF(MODI,TOTALBRUTOCLI2,IF(CB6=1,IF(Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE'),PRECIO2*CANTIDAD*ValorTeorico2(ESPECIE,FECHAVTO),PRECIO2*CANTIDAD),IF(Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE'),CANTIDAD*ValorTeorico2(ESPECIE,FECHAVTO)/PRECIO2,CANTIDAD/PRECIO2)));
ImpGastos2        : 'Gastos_FU'                  ;14;2;;;;IMPGASTOS2>=VAR('GASTOS1') Y IMPGASTOS2<=VAR('GASTOS2');'Los Gastos de la Operacion Futuro Estan fuera de Rango'~VAR('GASTOS1')~' y '~VAR('GASTOS2');NO;;
