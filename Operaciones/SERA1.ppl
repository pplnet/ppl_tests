PRECIO1<=PRECIO4*(1+VAR('RPRECIO') /100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO') /100);'Tipo de Cambio FUERA DE RANGO: '~FSTR(PRECIO4*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO')/100),1,7)  ;SI;SI;FSYS;'RANGOPRECIO'
PRECIO1<=PRECIO4*(1+VAR('RPRECIO2')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO2')/100);'Tipo de Cambio Fuera de Rango: '~FSTR(PRECIO4*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO2')/100),1,7);SI;SI;FSYS;'RANGOPRECIO2'

SI O [PLAZORENOVPREDETER <=VCAN12*(1+VAR('RPRECIO2')/100) Y PLAZORENOVPREDETER >=VCAN12*(1-VAR('RPRECIO2')/100)];'COTIZACION CONTABLE Fuera de Rango: '~FSTR(VCAN12*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO2')/100),1,7);NO
SI O [PLAZORENOVPREDETER <=VCAN12*(1+VAR('RPRECIO') /100) Y PLAZORENOVPREDETER >=VCAN12*(1-VAR('RPRECIO') /100)];'COTIZACION CONTABLE FUERA DE RANGO: '~FSTR(VCAN12*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOCOTCON'

PRECIO2<=PRECIO4*(1+VAR('RPRECIO') /100) Y PRECIO2>=PRECIO4*(1-VAR('RPRECIO') /100);'Tipo de Cambio FUERA DE RANGO: '~FSTR(PRECIO4*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO')/100),1,7)  ;SI;SI;FSYS;'RANGOPRECIO'
PRECIO2<=PRECIO4*(1+VAR('RPRECIO2')/100) Y PRECIO2>=PRECIO4*(1-VAR('RPRECIO2')/100);'Tipo de Cambio Fuera de Rango: '~FSTR(PRECIO4*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO2')/100),1,7);SI;SI;FSYS;'RANGOPRECIO2'

Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
SI O [VACIO(Corredor) o [PORCOMCOR1>=VAR('RCOMCOR1') y PORCOMCOR1<=VAR('RCOMCOR2')]];'El % Comision Corredor Spot EXCEDE Los Limites: Min.'~VAR('RCOMCOR1')~' Max.'~VAR('RCOMCOR2');NO
SI O [EqStr(Mercado,'OTC')  o [PORCOMMER1>=VAR('RCOMMER1') y PORCOMMER1<=VAR('RCOMMER2')]];'El % Comision Mercado Spot EXCEDE Los Limites: Min.'~VAR('RCOMMER1')~' Max.'~VAR('RCOMMER2');NO
SI O [VACIO(Corredor2) o [PORCOMCOR2>=VAR('RCOMCOR1') y PORCOMCOR2<=VAR('RCOMCOR2')]];'El % Comision Corredor Futuro EXCEDE Los Limites: Min.'~VAR('RCOMCOR1')~' Max.'~VAR('RCOMCOR2');NO
SI O [EqStr(Mercado2,'OTC')  o [PORCOMMER2>=VAR('RCOMMER1') y PORCOMMER2<=VAR('RCOMMER2')]];'El % Comision Mercado Futuro EXCEDE Los Limites: Min.'~VAR('RCOMMER1')~' Max.'~VAR('RCOMMER2');NO

SI O [VACIO(CORREDOR) O [TCCOMCOR1<=TIPOCAMBIO2*(1+VAR('RPRECIO2')/100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-VAR('RPRECIO2')/100)]];'Cambio COMISION CORREDOR SPOT Fuera de Rango: '~FSTR(TIPOCAMBIO2*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+VAR('RPRECIO2')/100),1,7);NO
SI O [VACIO(CORREDOR) O [TCCOMCOR1<=TIPOCAMBIO2*(1+VAR('RPRECIO') /100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-VAR('RPRECIO') /100)]];'Cambio  COMISION CORREDOR SPOT FUERA DE RANGO: '~FSTR(TIPOCAMBIO2*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOPRECIO'
SI O [EQSTR(MERCADO,'OTC') O [TCCOMMER1<=IMPORTEIMP*(1+VAR('RPRECIO2')/100) Y TCCOMMER1>=IMPORTEIMP*(1-VAR('RPRECIO2')/100)]];'Cambio COMISION MERCADO SPOT Fuera de Rango: '~FSTR(IMPORTEIMP*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(IMPORTEIMP*(1+VAR('RPRECIO2')/100),1,7);NO
SI O [EQSTR(MERCADO,'OTC') O [TCCOMMER1<=IMPORTEIMP*(1+VAR('RPRECIO') /100) Y TCCOMMER1>=IMPORTEIMP*(1-VAR('RPRECIO') /100)]];'Cambio  COMISION MERCADO SPOT FUERA DE RANGO: '~FSTR(IMPORTEIMP*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(IMPORTEIMP*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOPRECIO'
SI O [VACIO(CORREDOR2) O [TCCOMCOR2<=COMISION*(1+VAR('RPRECIO2')/100) Y TCCOMCOR2>=COMISION*(1-VAR('RPRECIO2')/100)]];'Cambio COMISION CORREDOR FUTURO Fuera de Rango: '~FSTR(COMISION*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(COMISION*(1+VAR('RPRECIO2')/100),1,7);NO
SI O [VACIO(CORREDOR2) O [TCCOMCOR2<=COMISION*(1+VAR('RPRECIO') /100) Y TCCOMCOR2>=COMISION*(1-VAR('RPRECIO') /100)]];'Cambio COMISION CORREDOR FUTURO FUERA DE RANGO: '~FSTR(COMISION*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(COMISION*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOPRECIO'
SI O [EQSTR(MERCADO2,'OTC') O [TCCOMMER2<=TIPOCAMBIO*(1+VAR('RPRECIO2')/100) Y TCCOMMER2>=TIPOCAMBIO*(1-VAR('RPRECIO2')/100)]];'Cambio COMISION MERCADO FUTURO Fuera de Rango: '~FSTR(TIPOCAMBIO*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(TIPOCAMBIO*(1+VAR('RPRECIO2')/100),1,7);NO
SI O [EQSTR(MERCADO2,'OTC') O [TCCOMMER2<=TIPOCAMBIO*(1+VAR('RPRECIO')/100)  Y TCCOMMER2>=TIPOCAMBIO*(1-VAR('RPRECIO') /100)]];'Cambio  COMISION MERCADO FUTURO FUERA DE RANGO: '~FSTR(TIPOCAMBIO*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(TIPOCAMBIO*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOPRECIO'

NOT EQSTR (VEHICULO1,CLIENTE1);'El Cliente y el Vehiculo deben ser distintos';NO
