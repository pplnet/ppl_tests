CONDICIONES
DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') O DESCIENDEDECLIENTE(CLIENTE1,'EMPRESAS');'El Cliente debe ser una Entidad Bancaria o una Empresa';NO
EsHabil(FECHAVTO,'ARG');'La Fecha de Vencimiento NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'VTOINH'
EsHabil(FECHAVTO2,'ARG');'La Fecha de Vencimiento Futuro NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'VTOFUTINH'
