Precio2           : 'Precio Futuro'              ;10;2;;Not EV;;PRECIO2>=((TOTALBRUTOCLI1+IF(Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE'),TOTALINTERESES,0))-IF(Eqstr(VTXT1,'CLE'),TOTALDERECHOS,0))/(CANTIDAD*IF(Eqstr(VTXT1,'CLE'),ValorTeorico2(ESPECIE,FECHAVTO2),1));'El Precio Futuro es menor que el Precio Spot';SI;;IF(NOT EV,IF(PRECIO1=0,0,IF(NO,PRECIO2,((TOTALBRUTOCLI1+IF(Eqstr(VTXT1,'CLE'),TOTALINTERESES,0))*(PRECIO3*PLAZO3/(if(RB8=0,360,365)*100)+1)-IF(Eqstr(VTXT1,'CLE'),TOTALDERECHOS,0))/(CANTIDAD*IF(Eqstr(VTXT1,'CLE'),ValorTeorico2(ESPECIE,FECHAVTO2),1)))),PRECIO2);;;;;'####.########'; 
