TotalComisiones: 'Costo Contr'                ;;;2;NO;NOT EQSTR(ESPECIE,CONTRAESPECIE2);;;;;PRECIO4*IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE2~"' "),'DIR'),TCCOMCOR1,IF(TCCOMCOR1<>0,1/TCCOMCOR1,0))
MensajeChequeo : 'Contacto '                  ;8;2;2;;;NOVACIO(MENSAJECHEQUEO);'Indique el Contacto PC';NO;;;
