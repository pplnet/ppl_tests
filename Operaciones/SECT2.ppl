Habiles(FechaPago,1,TablaFeriados2);Cliente1;'CONTRACT';VTXT7;;-VPRE8;TipoOp~' '~Especie;PaseCB=0 y FechaVto<FechaPago y Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2')) y Not EqStr(BuscarCampo('CLIENTES','Alias10','Codigo',CLIENTE1),'LIMITELIQ')

