FechaVto;Vehiculo1;Especie;;;;Vehiculo1;;;;;110+Cartera;Cantidad;Precio1;;;Book1;;'SEC';;Cupon1

FechaVto;Vehiculo1;ContraEspecie;;;;Vehiculo1;;;;;122;-TotalNetoCli1;COTIZACIONC(CONTRAESPECIE,,,,FECHAOP-1,1,SI,'ARP');;;VTXT19;;'FXS';Not Incluido(ContraEspecie,'ARP|USD');
FechaVto;Vehiculo1;ContraEspecie;;;;Vehiculo1;;;;;132;-TotalNetoCli1;COTIZACIONC(CONTRAESPECIE,,,,FECHAOP-1,1,SI,'USD');;;VTXT19;;'FXS';Not Incluido(ContraEspecie,'ARP|USD');

POSICION2
FechaOp;Vehiculo1;Book1;'SEC';Especie;Cupon1;1;ContraEspecie;Cantidad;Precio6;IF(RB8=0, TotalIntereses, TotalImpuesto1);IF(RB8=0, '8', '1');
FechaVto;Vehiculo1;Book1;'SEC';Especie;Cupon1;2;ContraEspecie;Cantidad;Precio6;IF(RB8=0, TotalIntereses, TotalImpuesto1);IF(RB8=0, '8', '1');CB15=1
FechaVto;Vehiculo1;Book1;'SEC';Especie;Cupon1;3;ContraEspecie;Cantidad;Precio6;IF(RB8=0, TotalIntereses, TotalImpuesto1);IF(RB8=0, '8', '1');CB15=1 Y Eqstr(BuscarCampo('ESPECIES', 'Issuer', 'Codigo', Especie), Vehiculo1)

LIMITES
FechaPago      ;Cliente1;'SETCRE'  ;VTXT6;; VCAN8;TipoOp~' '~Especie;PaseCB=0 y FormaLiquidacion1 <> 1 y FechaPago<=FechaVto
Habiles(FechaVto,1,TablaFeriados1) ;Cliente1;'SETCRE'  ;VTXT6;;-VCAN8;TipoOp~' '~Especie;RB15=1 Y PaseCB=0 y FormaLiquidacion1 <> 1 y FechaPago<=FechaVto y Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));
FechaVto       ;Cliente1;'SETCRE'  ;VTXT6;;-VCAN8;TipoOp~' '~Especie;RB15=1 Y PaseCB=0 y FormaLiquidacion1 <> 1 y FechaPago<=FechaVto y Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2')) y Not EqStr(BuscarCampo('CLIENTES','Alias10','Codigo',CLIENTE1),'LIMITELIQ');

