Habiles(FechaPago,1,TablaFeriados2);Cliente1;'CONTRACT';VTXT7;;-VPRE8;TipoOp~' '~Especie;PaseCB=0 y FechaVto<FechaPago y Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'))

