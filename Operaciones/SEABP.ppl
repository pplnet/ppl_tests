FechaVto;Cliente1;ContraEspecie;;;;;Vehiculo1;1;ImpComMer1;;'Comision Mercado - Alquiler de Bonos';SI; Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta2;;30;
