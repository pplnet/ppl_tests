FechaVto;IF(VACIO(Corredor),Cliente1,Corredor);ContraEspecie;;;;;Vehiculo1;1;TotalIva  ;;'Comision IVA Corredor - Alquiler de Bonos';SI; Incluido(Vehiculo1,Var('VLIQUIDAA'));;;;Cuenta2;;50;

