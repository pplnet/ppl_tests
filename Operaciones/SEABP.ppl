FechaVto;Cliente1 ;Especie      ;;;;;Vehiculo1;1;  Cantidad;;'Vto Alquiler Bonos-Prestamo'    ;SI;NO;1;NOVACIO(CLIENTE1);;Cuenta1;;2;'SEC';;Cupon1;;;;;;;;;;;500
