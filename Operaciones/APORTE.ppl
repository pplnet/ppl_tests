CAMPOS:1;;BuscarCampo('CENTROSCOSTO','Alias1','Codigo',Centro1)
FechaOp        : 'Fecha Aporte'           ;1;1;;NO;;EsHabil(FECHAOP,'ARG');'FECHA aporte ES INCORRECTA';NO;FSYS;
Centro1        : 'Vehiculo'               ;2;1;;NOT EV  y EqSTr(ABM,'A');;NOVACIO(CENTRO1);'NO INGRESO EL VEHICULO';NO;
Centro2        : 'ContaParte'             ;;;;NOT EV  y EqSTr(ABM,'A');;NOVACIO(CENTRO2);'NO INGRESO EL VEHICULO CONTRAPARTE';NO;;;;
Especie        : 'Moneda'                 ;;;;NOT EV;;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'DEBE INGRESAR ESPECIE';NO;;;;;;;;" Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~") and Status = 'HAB' "
Cantidad       : 'V_Nominal'              ;;;;NOT EV;;CANTIDAD>0;'El Valor Nominal DEBE SER POSITIVO';NO;
Operador       :                          ;;;;INSTANCIA<>4;;NOVACIO(OPERADOR);'DEBE INGRESAR EL OPERADOR';NO;USUARIOACTIVO;
TablaFeriados1 : 'Feriados Esp.'          ;;;;NO;;NOVACIO(TABLAFERIADOS1);'NO INGRESO TABLA DE FERIADOS';NO;'ARG';
CB7            : 'Desembolso'             ;;;;NO;NO;;;;0;0
NrOperacion3   : 'Op.Asoc'                ;;;;NO;NOVACIO(NROPERACION3);;;;;
MB4            : 'Gen_Contra|Si|No'       ;;;;NO;;MB4>=0;'Genera Operacion Contraparte INVALIDO';NO;0;
MB3            : 'Vehiculo|Coloca|Toma'   ;;;;MB4=1;;MB3>=0;'INDIQUE COLOCACION O TOMA';NO;if(MB4=0,0);if(MB4=0,0)
ContraEspecie2 : 'Moneda_Liq'             ;4;2;;CB7=1 y Not Eqstr(ESPECIE,VAR('MONELOCA'));CB7=1 y Not Eqstr(ESPECIE,VAR('MONELOCA'));[Not [CB7=1 y Not Eqstr(ESPECIE,VAR('MONELOCA'))]] O [NOVACIO(CONTRAESPECIE2) y DESCIENDEDEESPECIE(CONTRAESPECIE2,'MONEDA') y ESTERMINAL(CONTRAESPECIE2, ESPECIE)];'MONEDA DE LIQUIDACION NO VALIDA';NO;;IF(Not [CB7=1 y Not Eqstr(ESPECIE,VAR('MONELOCA'))],ESPECIE,CONTRAESPECIE2);;;;;;" Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~")and Status = 'HAB' "
TCComCor1      : 'T.Cambio'               ;;;;CB7=1 y Not Eqstr(ESPECIE,VAR('MONELOCA'));CB7=1 y Not Eqstr(ESPECIE,VAR('MONELOCA'));TCCOMCOR1>=0;'TIPO DE CAMBIO LIQUIDACION NO VALIDO';NO;1;IF(Not [CB7=1 y Not Eqstr(ESPECIE,VAR('MONELOCA'))],1,TCCOMCOR1)
ImpComCor1     : 'Imp.Liquidar'           ;;;;NO;CB7=1 y Not Eqstr(ESPECIE,VAR('MONELOCA'));;;;;CANTIDAD*IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE2~"' "),'DIR'),TCCOMCOR1,IF(TCCOMCOR1<>0,1/TCCOMCOR1,0))
Precio4        : 'Cot.Especie/ARP'        ;;;;NO;NO;;;;;IF(CB9=1,COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'ARP')/COTIZACIONC(CONTRAESPECIE2,,,,FECHAOP,1,SI,'ARP'),COTIZACIONC(CONTRAESPECIE2,,,,FECHAOP,1,SI,'ARP')/COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'ARP')))
CB9            : 'DirectaEsp/Cont?'       ;;;;NO;NO;;;;;IF(EqStr(QUERY("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE2~"' "),'INV'),0,1); 


CB8            : 'Genero FV'              ;;1;;NO;NO;;;;0
Impresa        : 'Modificado'             ;10;3;;NO;NO;;;;1
RB3            : 'MOF'                    ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)
CB6            : 'Original?'              ;10;2;;NO;NO;;;;1;;



CONDICIONES
Not [CB7=1 y Not Eqstr(Especie,VAR('MONELOCA'))] o [TCComCor1<=Precio4*(1+VAR('RPRECIO2')/100) Y TCComCor1>=Precio4*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio a Liquidar Invalido: '~FSTR(Precio4*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(Precio4*(1+VAR('RPRECIO2')/100),1,7);NO
Not EqStr(Centro1,Centro2);'El Vehiculo Contraparte debe ser diferente al Vehiculo por el cual se ingresa la Operacion';NO;NO;FSYS;'VEHDUPL'
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
VACIO(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR)) O  VERIFICAPERFIL(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR),'TO'~TIPOOP);'Operador no habilitado para ingresar Operaciones del Tipo '~TIPOOP;NO
[INSTANCIA=2];'Instancia de Carga Incorrecta !!!';NO

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador



POSTEDICION
EQSTR(ABM,'A') Y MB4=0;'INSAPO';NrOperacion1=NROPERACION;TipoOp1=TIPOOP;String=" CB6='0',MB3='"~Fstr(IF(MB3=0,1,0),1,0)~"' ";Vehiculo1=CENTRO2;Vehiculo2=CENTRO1;String1=""


@INSTOPE
@INST19GENE
@INST19BITS