Book1           : 'Book'                       ;3;1;;NO 
   
Cliente1        : 'Entidad'                    ;4;1;;NO
Cliente2        : 'Contraparte'                ;4;2;;NO;EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',NROPERACION),'TRANSF')
Especie         : 'Especie'                    ;5;1;;NO
ContraEspecie   : 'ContraEspecie'              ;5;2;;NO
