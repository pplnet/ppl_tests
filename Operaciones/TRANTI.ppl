CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)

Vehiculo1       :'Vehiculo'            ;2;1;;;;NoVacio(VEHICULO1);'Vehiculo invalido';NO;BuscarCampo('USRVEHICULO','Vehiculo','Codigo',USUARIOACTIVO);
Especie         :'Especie'             ;3;1;;;;NoVacio(ESPECIE) y DesciendeDeEspecie(ESPECIE,'TITULO') y EsTerminal(ESPECIE, Especie);'Titulo Invalido';NO;;;;;;;;"Status = 'HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','TITULO')~"%' ";

FechaOp         :'Fecha'               ;2;2;;VerificaAcceso('OPFVALOR');;FECHAOP<=FSYS y EsHabil(FECHAOP,'ARG');'Fecha invalida';NO;FSYS
FechaVto        :'Fecha Acredit'       ;3;2;;;;EsHabil(FECHAVTO,'ARG');'Fecha de Acreditacion Invalida';NO;FSYS;

ContraEspecie   :'Moneda'              ;4;1;;NO;;NoVacio(CONTRAESPECIE) y DesciendeDeEspecie(CONTRAESPECIE,'MONEDA') y EsTerminal(CONTRAESPECIE, Especie);'Moneda invalida';NO;;CotizaEn(ESPECIE);;;;;;"Status = 'HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','MONEDA')~"%' ";
Cantidad        :'V_Nominal'           ;5;1;;NOT EV;;CANTIDAD>0;'El Valor Nominal DEBE SER POSITIVO';NO;
Precio1         :'Precio'              ;6;1;;NO;;PRECIO1>0;'El Precio DEBE SER POSITIVO';NO;;COTIZACIONC(ESPECIE,,,,FECHAOP-1,1,SI,CONTRAESPECIE);;;;;'##,###,###.########';;

TotalBrutoCli1  :'Monto'               ;7;1;;NO;;;;;;CANTIDAD*PRECIO1;
TotalIntereses  :'Interes'             ;7;2;;NO;NO Y Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE');;;;;IF(Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE'),ValorTeorico2(ESPECIE,FECHAOP)*CANTIDAD*TASAINTERESESCUPON/DIASA(EspecieDiasAnio(ESPECIE),FSYS)/100*IF(EspecieDiasAnio(ESPECIE)=0 y EspecieDiasMes(ESPECIE)=0,Dif360(FECHAULTCUPON,FECHAOP,4),DifDias(FECHAULTCUPON,FECHAOP,'USA',NO)),0);

VTXT14          :'Cupon Actual'        ;4;2;;NO;NO;;;;FStr(NrCupon2(ESPECIE,FECHAVTO),0,0);FStr(NrCupon2(ESPECIE,FECHAVTO),0,0);
Cupon1          :'Cupon'               ;5;2;;;;EqStr(CUPON1,VTXT14);'Cupon Incorrecto';NO;VTXT14;VTXT14;;;;;'###'
Cartera         :'Cartera|HM|SA|AS|TR' ;6;2;;;;CARTERA>=0;'Indique EL TIPO DE CARTERA';NO;3;

Cliente1        :'De Banco'            ;9;1;;;;[Eqstr(BuscarCampo('CUENTAS','Comitente','Codigo', CUENTA4), CLIENTE1) y Eqstr(BuscarCampo('CLIENTES','Status','Codigo',CLIENTE1), 'HAB')];'Banco Origen invalido';NO;;BuscarCampo('CUENTAS','Comitente','Codigo',CUENTA4);;;;;; " Codigo IN ("~Pipe2Comillas(Descendientes('CLIENTES','BANCOS'))~") and Status = 'HAB'";
Cuenta4         :'De Cuenta'           ;10;1;;;;Eqstr(BuscarCampo('CUENTAS','Comitente','Codigo',CUENTA4), CLIENTE1);'Cuenta Origen invalida';NO;;QUERY("select Codigo from "~DBO~".CUENTAS where Cliente='"~VEHICULO1~"' and Estado='HAB' and Comitente='"~CLIENTE1~"' AND (Especies LIKE '%"~ESPECIE~"%' or Especies LIKE '%TITULO%') ");;;;;;IF(NoVacio(CLIENTE1), "Cliente='"~VEHICULO1~"' and Estado='HAB' and (Especies LIKE '%"~ESPECIE~"%' or Especies LIKE '%TITULO%') AND Comitente = '"~CLIENTE1~"' ", "Cliente='"~VEHICULO1~"' and Estado='HAB' and (Especies LIKE '%"~ESPECIE~"%' or Especies LIKE '%TITULO%')") 
Book1           :'De Book'             ;11;1;;;;[BookValido(BOOK1, TIPOOP, ESPECIE, VEHICULO1, OPERADOR,'') o [BookValido(BOOK1, TIPOOP, ESPECIE, '', OPERADOR,'') y Vacio(Query("Select Vehiculo from "~DBO~".BOOKS where Codigo = '"~BOOK1~"'"))] ] y NoVacio(BOOK1);'El Book seleccionado no corresponde a la Especie, Tipo de Operacion, Operador, Vehiculo';NO;;;;;;;;" (Vehiculo='"~VEHICULO1~"' OR Vehiculo is null) AND (TiposOperacion='' OR TiposOperacion Is Null OR TiposOperacion Like '%"~TIPOOP~"|%') ";

Cliente2        :'A Banco'             ;9;2;;;;[Eqstr(BuscarCampo('CUENTAS','Comitente','Codigo', CUENTA1), CLIENTE2) y Eqstr(BuscarCampo('CLIENTES','Status','Codigo',CLIENTE2), 'HAB')];'Banco Destino invalido';NO;;BuscarCampo('CUENTAS','Comitente','Codigo',CUENTA1);;;;;;" Codigo IN ("~Pipe2Comillas(Descendientes('CLIENTES','BANCOS'))~") and Status = 'HAB'";
Cuenta1         :'A Cuenta'            ;10;2;;;;Eqstr(BuscarCampo('CUENTAS','Comitente','Codigo',CUENTA1), CLIENTE2);'Cuenta Destino Invalida';NO;;QUERY("select Codigo from "~DBO~".CUENTAS where Cliente='"~IF(MB3=1,VEHICULO2,VEHICULO1)~"' and Estado='HAB' and Comitente='"~CLIENTE2~"' AND (Especies LIKE '%"~ESPECIE~"%' or Especies LIKE '%TITULO%') ");;;;;;IF(NoVacio(CLIENTE2), "Cliente='"~IF(MB3=1,VEHICULO2,VEHICULO1)~"' and Estado='HAB' and (Especies LIKE '%"~ESPECIE~"%' or Especies LIKE '%TITULO%') AND Comitente = '"~CLIENTE2~"' " , "Cliente='"~IF(MB3=1,VEHICULO2,VEHICULO1)~"' and Estado='HAB' and (Especies LIKE '%"~ESPECIE~"%' or Especies LIKE '%TITULO%') ")
Book2           :'A Book'              ;11;2;;;;[BookValido(BOOK2, TIPOOP, ESPECIE, VEHICULO1, OPERADOR,'') o [BookValido(BOOK2, TIPOOP, ESPECIE, '', OPERADOR,'') y Vacio(Query("Select Vehiculo from "~DBO~".BOOKS where Codigo = '"~BOOK2~"'"))] ] y NoVacio(BOOK2);'El Book seleccionado no corresponde a la Especie, Tipo de Operacion, Operador, Vehiculo';NO;;;;;;;;" (Vehiculo='"~VEHICULO1~"' OR Vehiculo is null) AND (TiposOperacion='' OR TiposOperacion Is Null OR TiposOperacion Like '%"~TIPOOP~"|%') ";

Operador        :                      ;12;1;;NO;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
Cotizacion1     : 'TC_Concert.'        ;13;2;;;Not Eqstr(CONTRAESPECIE,VAR('MONELOCA'));COTIZACION1<=VPRE1*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE1*(1-VAR('RPRECIO2')/100);'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE1*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE1*(1+VAR('RPRECIO2')/100),1,7);NO;;COTIZACIONBNA(CONTRAESPECIE,FECHAOP-1,1,NO,NO)

CB5             :'Aprobada'            ;12;2;;NO;NO;;;;;

FechaUltCupon   : 'Ult.Cupon'          ;  ; ;2;NO;Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE');;;;;IF(EsHabil(UltCupon2(ESPECIE,FECHAOP),'USA'),UltCupon2(ESPECIE,FECHAOP),Habiles(UltCupon2(ESPECIE,FECHAOP),IF(EqStr(BuscarCampo('ESPECIES','CuponFeriado','Codigo',ESPECIE),'SIG'),1,IF(EqStr(BuscarCampo('ESPECIES','CuponFeriado','Codigo',ESPECIE),'ANT'),-1,0)),'USA'))

VPRE1           : 'Cot.TC/ContraEspecie' ;10;2;;NO;NO;;;;;COTIZACIONBNA(CONTRAESPECIE,FECHAOP-1,1,NO,NO)

MB3                : ''                 ;15;2; ;NO;NO;;;;
Vehiculo2          : ''                 ;15;2; ;NO;NO;;;;
TasaInteresesCupon : ''                 ;15;2; ;NO;NO;;;;
PaseCB             : ''                 ;15;2; ;NO;NO;;;;

Sector2         : 'Perfil'              ;16;2;2;NO;SI;;;;BuscarCampo('USUARIOS','Perfiles','Codigo',USUARIOACTIVO);BuscarCampo('USUARIOS','Perfiles','Codigo',USUARIOACTIVO);

***---Campos para POSICIONES2
***---Precio6           : 'Precio Clean'          ;20;2; ;NO;SI;;;;;IF(TOTALIMPUESTO1 > 0, IF(Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE'), PRECIO1, ((CANTIDAD * PRECIO1) - TOTALIMPUESTO1) / CANTIDAD), PRECIO1) * (IF(VCAN30 > 0 Y Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE'), VCAN30, 1));;;;;'######.########'
***---TotalBrutoCli3   : 'InteresVto'              ;10;2; ;NO;NO;;;;;IF(DesciendeDeEspecie(ESPECIE, 'PUBLIC') O DesciendeDeEspecie(ESPECIE, 'CORP B') O DesciendeDeEspecie(ESPECIE, 'EXTRAN'),ValorTeorico2(ESPECIE,FECHAVTO)*CANTIDAD*TASAINTERESESCUPON/DIASA(EspecieDiasAnio(ESPECIE),FSYS)*IF(EspecieDiasAnio(ESPECIE)=0 y EspecieDiasMes(ESPECIE)=0,Dif360(FECHAULTCUPON,FECHAVTO,4),DifDias(FECHAULTCUPON,FECHAVTO,'USA',NO)),0);
***---Esto que sigue es lo de IRSA
*POSICION2
*FechaOp;Vehiculo1;Book1;'SEC';Especie;Cupon1;1;ContraEspecie;Cantidad;Precio3;TotalBrutoCli3;'1';
*FechaVto;Vehiculo1;Book1;'SEC';Especie;Cupon1;2;ContraEspecie;Cantidad;Precio3;TotalBrutoCli3;'1';Eqstr(CotizaEn(Especie),ContraEspecie)
*FechaVto;Vehiculo1;Book1;'SEC';Especie;Cupon1;2;CotizaEn(Especie);Cantidad;PrecioEj;TotalBrutoCli3;'1';Not Eqstr(CotizaEn(Especie),ContraEspecie)

CONDICIONES
Incluido(VEHICULO1, UsrVehiculos(USUARIOACTIVO))  o VACIO(UsrVehiculos(USUARIOACTIVO)); 'El usuario activo no esta habilitado para operar con el vehiculo '~VEHICULO1;NO
EspecieCuenta(ESPECIE, CUENTA4) O VACIO(CUENTA4);'El Titulo No Corresponde con la Cuenta Origen';NO
ClienteCuenta(VEHICULO1, CUENTA4) o VACIO(CUENTA4);'La Cuenta Origen no corresponde al Vehiculo';NO
EspecieCuenta(ESPECIE, CUENTA1) o VACIO(CUENTA1);'El Titulo No Corresponde con la Cuenta Destino';NO
SI O SaldoC(Vehiculo1,Especie,,,,,,Cuenta4,1,FSYS)>=CANTIDAD;'Cantidad a transferir es superior al saldo en la cuenta origen.';SI

EDICION
NO O [EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'))];'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

MOVIMIENTOS
FechaVto;Cliente1;Especie;;;;;Vehiculo1;1 ; Cantidad;;'Transferencia de '~Especie;SI;NO;;;;Cuenta4;;1;;;Cupon1
