FechaOp  ;Vehiculo1;Especie      ;;;;;Vehiculo1;2;      Cantidad ;;'Transferencia de '~Especie;;SI;;PaseCB=0;;Cuenta1;;6;;;Cupon1;;;;Book2;
FechaVto ;Vehiculo1;Especie      ;;;;;         ;3;      Cantidad ;;'Transferencia de '~Especie;;SI;;PaseCB=0;;Cuenta1;;7;;;Cupon1;;;;Book2;

FechaVto ;Vehiculo1;Especie      ;;;;;         ;10;     -Cantidad ;;'Transferencia de '~Especie;;SI;;PaseCB=0;;Cuenta4;;8;;;Cupon1;;;;Book1;
FechaOp  ;Vehiculo1;Especie      ;;;;;Vehiculo1;2;      -Cantidad ;;'Transferencia de '~Especie;;SI;;PaseCB=0;;Cuenta4;;9;;;Cupon1;;;;Book1;
FechaVto ;Vehiculo1;Especie      ;;;;;         ;3;      -Cantidad ;;'Transferencia de '~Especie;;SI;;PaseCB=0;;Cuenta4;;10;;;Cupon1;;;;Book1;


