IIF(Eqstr(#MONOPER, #MONELOCAL),
   #MONTOBRUTO,
   IIF(Eqstr(#COTIZA, #MONELOCAL),
   IIF(Eqstr(SQL(" Select Modo From "~DBO~".MODOESPECIES Where Especie1 = '"~#COTIZA~"' AND Especie2 = '"~#MONOPER~"' "), 'INV'), #MONTOBRUTO / #COTIZOPERA, #MONTOBRUTO * #COTIZOPERA)
   ,#MONTOBRUTO * COTIZACIONBNA(#MONOPER,Val(FV:2),1,NO,NO)))

