IIF(NoVacio(#CTAREMUNEF), #CTAREMUNEF,  SQL(" Select CuentaContable1 From "~DBO~".CUENTAS Where Comitente = '"~fbn('Cliente1')~"' AND Cliente = '"~fbn('Vehiculo1')~"' AND TipoCuenta = 'INV' AND (Especies Like '%"~fbn('Moneda')~"%' OR Especies Like '%MONEDA%') AND (Pagadora <> 'SI' OR Pagadora Is Null) "))
