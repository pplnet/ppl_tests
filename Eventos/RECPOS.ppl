    SQL.NEW
    SQL.EXEC

    SQL.ADD("Delete "~DBO~".RESULTADOS ")
    SQL.ADD(" where NrSaldo in (120,130) ")
    SQL.NEW
    SQL.EXEC
  endif

  EjecutarEvento('ACTMOV',Vehiculo1='',Fecha1=FSys,Fecha2=FSys,NrOperacion1='',TipoOp1='SECS',Especie1='',Radio1=4,Radio2=1)
  EjecutarEvento('ACTMOV',Vehiculo1='',Fecha1=FSys,Fecha2=FSys,NrOperacion1='',TipoOp1='SEVS',Especie1='',Radio1=4,Radio2=1)

endif

