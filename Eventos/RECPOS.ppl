if Dialogo.Check5=1
  ACT(y1, 'Fin de Mes')
  ACT(y2, 'OK')
  ACT(y4, 'Mes Inicio')
  ACT(y5, 'Mes Cierre')

  * Fin de mes del mes actual
  ACD(z:1, FinDeMes(Dialogo.Fecha1,NO,'ARG'))

  ACT(z:2, 'SI')
  if Val(z:1)<>Dialogo.Fecha1
    MessageBox('La fecha indicada no es fin de mes')
    ACT(z:2, 'NO')
  endif

  IF EqStr(Val(z:2),'SI')
    ACN(z:4, 0)
    ACN(z:4, SQL("Select 1 from "~DBO~".VARIABLES where Codigo='MESINIEJE' "))
    if Val(z:4)=0
      ACN(z:5, 12)
    else
      ACN(z:5, VAR('MESINIEJE')-1)
    endif
    if Val(z:5)<1 or Val(z:5)>12
      ACN(z:5, 12)
    endif
    if Mes(Dialogo.Fecha1)<>Val(z:5)
      MessageBox('La fecha indicada no es fin de Ejercicio')
      ACT(z:2, 'NO')
    endif
  endif

  if EqStr(Val(z:2),'NO')
    MessageBox('No es posible Resetear Posicion en esta Fecha: '~Dialogo.Fecha1)
  endif

  iF EqStr(Val(z:2),'SI')
    EjecutarEvento('RESET1',Fecha1=Dialogo.Fecha1,Especie1='',Check1=Dialogo.Check6)
  endif

endif
