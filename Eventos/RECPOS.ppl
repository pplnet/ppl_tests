FinDialogo

If not Ok
  Cancelar
Endif

if Dialogo.Check1=1 y Dialogo.Check6=1
  if Dialogo.Check7=1
    SQL.ADD("Delete "~DBO~".MOVPOSPEN ")
    SQL.ADD(" where NrSaldo in (120,130) ")
    SQL.NEW
    SQL.EXEC

    SQL.ADD("Delete "~DBO~".MOVPOSEJE ")
    SQL.ADD(" where NrSaldo in (120,130) ")
    SQL.NEW
    SQL.EXEC

    SQL.ADD("Delete "~DBO~".POSICIONES ")
