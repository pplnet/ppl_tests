CrearDialogo
    NrOperacion1: '# Operacion :'
    Radio1:       'Funcionamiento|Otro|Avanzar|Retroceder|';;;;;;;;;0
FinDialogo

If Not OK
   Cancelar
EndIf 

If Radio1=1
    *****AVANZO LA ON DESDE a la instancia 19

    ****Busco las SECS que pueden venir desde un canje o cargadas a mano (O.NrOperacion2) para pasar de Instancia 15 a 19 junto con la ON
    SQL.ADD("SELECT O.NrOperacion, OB.NrBit ")
    SQL.ADD("FROM "~DBO~".OPERACIONES O ")
    SQL.ADD("JOIN "~DBO~".OPERACIONESBITS OB ")
    SQL.ADD("ON O.NrOperacion = OB.NrOperacion ")
    SQL.ADD("where O.NrOperacion2 = '"~Dialogo.NrOperacion1~"' ")
    SQL.ADD("and TipoOp='SECS' ")
    SQL.ADD("and RB1=1 ")
    SQL.ADD("and OB.Valor = 1 ")
    SQL.ADD("and OB.NrBit = 15 ")
    SQL.ADD("UNION ALL ")
    SQL.ADD("SELECT C.NrOperacion1, OB.NrBit ")
    SQL.ADD("FROM "~DBO~".CANJES C ")
    SQL.ADD("JOIN "~DBO~".OPERACIONESBITS OB ")
    SQL.ADD("ON C.NrOperacion1 = OB.NrOperacion ")
    SQL.ADD("where C.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
    SQL.ADD("and OB.Valor = 1 ")
    SQL.ADD("and OB.NrBit = 15 ")

    Recorrer SQL
        let &nrOperacion fbn('NrOperacion')
        let &nrInstancia fbn('NrBit')
        EjecutarEvento('INSTAN', NrOperacion1=&nrOperacion , Precio1=&nrInstancia , Precio2=20 )
    Proximo
Else
    If Radio1=2
        *****RETROCEDO LA ON DESDE la instancia 19

        ****Busco las SECS que pueden venir desde un canje o cargadas a mano (O.NrOperacion2) para pasar de Instancia 15 a 19 junto con la ON
        SQL.ADD("SELECT O.NrOperacion, OB.NrBit ")
        SQL.ADD("FROM "~DBO~".OPERACIONES O ")
        SQL.ADD("JOIN "~DBO~".OPERACIONESBITS OB ")
        SQL.ADD("ON O.NrOperacion = OB.NrOperacion ")
        SQL.ADD("where O.NrOperacion2 = '"~Dialogo.NrOperacion1~"' ")
        SQL.ADD("and TipoOp='SECS' ")
        SQL.ADD("and RB1=1 ")
        SQL.ADD("and OB.Valor = 1 ")
        SQL.ADD("and OB.NrBit = 20 ")
        SQL.ADD("UNION ALL ")
        SQL.ADD("SELECT C.NrOperacion1, OB.NrBit ")
        SQL.ADD("FROM "~DBO~".CANJES C ")
        SQL.ADD("JOIN "~DBO~".OPERACIONESBITS OB ")
        SQL.ADD("ON C.NrOperacion1 = OB.NrOperacion ")
        SQL.ADD("where C.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
        SQL.ADD("and OB.Valor = 1 ")
        SQL.ADD("and OB.NrBit = 20 ")
            
        Recorrer SQL
            let &nrOperacion fbn('NrOperacion')
            let &nrInstancia fbn('NrBit')
            EjecutarEvento('INSTAN', NrOperacion1=&nrOperacion , Precio1=&nrInstancia , Precio2=15 )
        Proximo
    EndIf
EndIf