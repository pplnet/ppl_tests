CrearDialogo
NrOrden         :'Nr Orden'     ;;;
NrOperacion1    :'Nr Operacion' ;;;
TipoOp1         :'Tipo Op'      ;;;
Cliente1        :'ContraParte ' ;;;
Fecha1          :'FechaOp'      ;;;
Fecha2          :'FechaVto'     ;;;
Cantidad1       :'Cantidad'     ;;;
Radio1          :'DELETE|NO|SI' ;;;;;NO;;;;0
FinDialogo

*MessageBox('Se Ejecuta evento ACTEJE')

IF Not OK
    Cancelar
Endif

ACT(CO:1,'SI')
IF Incluido(Dialogo.TipoOp1,VAR('OPNOCONSUM')) Y (EqStr(BuscarCampo('OPERACIONES','CB1','NrOperacion',Dialogo.NrOperacion1),'0') o Vacio(BuscarCampo('OPERACIONES','CB1','NrOperacion',Dialogo.NrOperacion1)))
    ACT(CO:1,'NO')
ENDIF    

IF Dialogo.Radio1=0
    If Query("SELECT 1 FROM "~DBO~".EJECUCIONES WHERE NrOperacion='"~Dialogo.NrOperacion1~"' AND NrOrden='"~Dialogo.NrOrden~"'") = 1
    *MessageBox('Entró al evento por UPDATE')
        *tomar campo cantidad de tabla ejecuciones para operacion
        ACN(CA:1, BuscarCampo('EJECUCIONES','Cantidad','NrOperacion',Dialogo.NrOperacion1))
        *Restar la cantidad nueva - la cantidad vieja
        *Sumar el resultado, usar el valor para updatear CantidadCompletada
        IF EqStr(Val(CO:1),'SI')
            ACN(CA:2, Dialogo.Cantidad1 - Val(CA:1))
            *Actualizo tabla de órdenes
            SQL.ADD(" UPDATE "~DBO~".ORDENES ")
            SQL.ADD(" SET")
            SQL.ADD(" CantidadCompletada= CantidadCompletada + ("~Fstr(Val(CA:2),0,2)~") ")
            SQL.ADD(" WHERE ")
            SQL.ADD(" NrOrden='"~Dialogo.NrOrden~"'  ")
            SQL.NEW
            SQL.EXEC
        Endif    
        *Actualizo tabla Ejecuciones si la Operación ya se encontraba en la tabla bajo esa orden
        SQL.ADD(" UPDATE "~DBO~".EJECUCIONES ")
        SQL.ADD(" SET")
        SQL.ADD(" Cliente1='"~Dialogo.Cliente1~"',Cantidad="~Fstr(Dialogo.Cantidad1,0,2)~",")
        SQL.ADD(" Fecha1='"~IdxDate(Dialogo.Fecha1)~"',Fecha2='"~IdxDate(Dialogo.Fecha2)~"',Consume='"~Val(CO:1)~"' ")
        SQL.ADD(" WHERE ")
        SQL.ADD(" NrOrden='"~Dialogo.NrOrden~"'  ")
        SQL.ADD(" AND NrOperacion='"~Dialogo.NrOperacion1~"' ")
        SQL.NEW
        SQL.EXEC
    Else
    *MessageBox('Entró al evento por INSERT')
        *Inserto la nueva Ejecución en la tabla EJECUCIONES
        ACN(EJ:1, BuscarCampo('ORDENES','Lotes','NrOrden',Dialogo.NrOrden)+1)
        
        SQL.ADD(" INSERT INTO "~DBO~".EJECUCIONES ")
        SQL.ADD(" (NrOrden, NrOperacion, NrEjecucion,")
        SQL.ADD(" TipoOp, Cliente1,Consume, Fecha1, Fecha2, Cantidad) ")
        SQL.ADD(" VALUES ( ")
        SQL.ADD(" '"~Dialogo.NrOrden~"', '"~Dialogo.NrOperacion1~"', "~Fstr(Val(EJ:1),0,0)~", ")
        SQL.ADD(" '"~Dialogo.TipoOp1~"', '"~Dialogo.Cliente1~"','"~Val(CO:1)~"', ")
        SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~IdxDate(Dialogo.Fecha2)~"', "~Fstr(Dialogo.Cantidad1,0,2)~" ) ")
        SQL.NEW
        SQL.EXEC
        *Actualizo el máximo para ese Nr de Orden
        IF EqStr(Val(CO:1),'SI')
            SQL.ADD(" UPDATE "~DBO~".ORDENES ")
            SQL.ADD(" SET")
            SQL.ADD(" Lotes="~Fstr(Val(EJ:1),0,0)~", ")
            SQL.ADD(" CantidadCompletada=CantidadCompletada + "~Fstr(Dialogo.Cantidad1,0,2)~" ")
            SQL.ADD(" WHERE ")
            SQL.ADD(" NrOrden='"~Dialogo.NrOrden~"'  ")
            SQL.NEW
            SQL.EXEC
        ENDIF    
    EndIf
ELSE
    ***BORRAR OPERACION***+
    *MessageBox('Entró al evento por DELETE')
    *Guardo Nr Ejecución para actualizar después
    ACN(NE:1, BuscarCampo('EJECUCIONES','NrEjecucion','NrOperacion',Dialogo.NrOperacion1))
    *Guardo Cantidad para actualizar ORDENES.CantidadCompletada
    ACN(CA:1, BuscarCampo('EJECUCIONES','Cantidad','NrOperacion',Dialogo.NrOperacion1))
    *Borro operación de la tabla EJECUCIONES
    SQL.ADD("DELETE FROM "~DBO~".EJECUCIONES")
    SQL.ADD("WHERE NrOperacion = '"~Dialogo.NrOperacion1~"'")
    SQL.ADD("AND NrOrden = '"~Dialogo.NrOrden~"'")
    SQL.NEW
    SQL.EXEC
    *Actualizo las Ejecuciones de la misma orden con NrEjecucion-1
    SQL.ADD("UPDATE "~DBO~".EJECUCIONES")
    SQL.ADD("SET NrEjecucion = NrEjecucion-1")
    SQL.ADD("WHERE NrOrden = '"~Dialogo.NrOrden~"'")
    SQL.ADD("AND NrEjecucion >= "~Fstr(Val(NE:1),0,0)~"")
    SQL.NEW
    SQL.EXEC
    *Actualizo Cant de ejecuciones en tabla órdenes y CantidadCompletada
    
    SQL.ADD("UPDATE "~DBO~".ORDENES")
    SQL.ADD("SET Lotes = Lotes -1")
    IF EqStr(Val(CO:1),'SI')
        SQL.ADD(",CantidadCompletada=CantidadCompletada + ("~Fstr(Val(CA:1)*(-1),0,2)~") ")
    ENDIF
    SQL.ADD("WHERE NrOrden = '"~Dialogo.NrOrden~"'")
    SQL.NEW
    SQL.EXEC
    IF EqStr(Val(CO:1),'SI')
      *Si consume, busco las operaciones asociadas a la misma orden que hayan sido cargadas luego de la op iterada y corrijo la cantDisponible de la orden
      let &fechaCarga BuscarCampo('OPERACIONES','FechaCarga','NrOperacion',Dialogo.NrOperacion1)
      
      SQL.ADD(" Select NrOperacion,CantidadDispOrden from "~DBO~".OPERACIONES Where NrOrden='"~Dialogo.NrOrden~"' and FechaCarga>"~SQLFecha(&fechaCarga)~" ")
      Recorrer SQL
        let &nuevaCantDispOrden fbn['CantidadDispOrden']+Val(CA:1)
        SQL.ADD(" UPDATE "~DBO~".OPERACIONES Set CantidadDispOrden="~Fstr(&nuevaCantDispOrden, 0, 2)~" ")
        SQL.ADD(" Where NrOperacion='"~fbn['NrOperacion']~"' ")
        SQL.NEW
        SQL.EXEC
      Proximo
    ENDIF    
ENDIF