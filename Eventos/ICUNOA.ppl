CrearDialogo
  Directorio1  : 'Path'           ;1;1;1;SI;SI;;;;Var('PATHDDCHE')
  String1      : 'Archivo '       ;2;1;1;SI;SI;;;;Var('FILEDDCNA')
  Fecha1       : 'Fecha Vigencia' ;;1;1;SI;SI;NoVacio(Dialogo.Fecha1);'Debe ingresar una fecha';NO;FSYS
  Vehiculo1    : 'Vehiculo'       ;;1;1;SI;SI;;;;Var('DDVEHDEF')
  Book1        : 'Book'           ;;1;1;SI;SI;EqStr(Dialogo.Vehiculo1,BuscarCampo('BOOKS','Vehiculo','Codigo',Dialogo.Book1));'El book ingresado no corresponde al Vehiculo';NO;Var('BOOKDDCHE');BuscarCampo('VEHICULOS','Alias5','Codigo',Dialogo.Vehiculo1);;;;" Vehiculo = '"~Dialogo.Vehiculo1~"'"  
  Especie1     : 'Moneda'         ;;;;NO;NO;;;;Var('MONELOCA')
FinDialogo

if Not Ok
  Cancelar
endif

(.'VALIDPATH'.)
*** Corregir path
let &pf ''
If EqStr(Copy(Dialogo.Directorio1,Longitud(Dialogo.Directorio1),1),'\')
    let &pf Dialogo.Directorio1~Dialogo.String1
Else
    let &pf Dialogo.Directorio1~'\'~Dialogo.String1
Endif

ImportarXLS(A:2..AD:10000, A:1..AD:10000, &pf)

If Not Ok
  Cancelar('Error al cargar el archivo '~&pf)
EndIf


***Guarda Variable de directorio, agrega una '\' si no tiene
If EqStr(Copy(Dialogo.Directorio1,Longitud(Dialogo.Directorio1),1),'\')
    let &Directorio Dialogo.Directorio1
Else
    let &Directorio Dialogo.Directorio1~'\'
EndIf

Recorrer&i 1,10000
     If Vacio(Val(B:&i))
        Break
     Else

          ***Validacion de que no exista CUPO DUPLICADO   
          If SQL("Select 1 from "~DBO~".DDCUPOSNOAVALADOS where FechaVigencia ='"~IdxDate(Dialogo.Fecha1)~"' and Vehiculo = '"~Dialogo.Vehiculo1~"' and Book = '"~Dialogo.Book1~"' and CUITEmisor='"~Val(B:&i)~"'")>0
          EscribirAscii('Cupo duplicado, el Cupo con FechaVigencia:'~Dialogo.Fecha1~',Vehiculo:'~Dialogo.Vehiculo1~', Book'~Dialogo.Book1~',CUITEmisor:'~Val(B:&i)~'  no fue procesado')
           Let &TotalNoProcesados &TotalNoProcesados+1         
        Else
              **Validacion que FechaVigencia sea mayor al ultimo registro 
              let &UltFecha SQL("Select MAX(FechaVigencia) From "~DBO~".DDCUPOSNOAVALADOS Where Vehiculo = '"~Dialogo.Vehiculo1~"' and Book = '"~Dialogo.Book1~"' and CUITEmisor='"~Val(B:&i)~"' ")
             If  &UltFecha >= Dialogo.Fecha1
                 EscribirAscii('La fecha debe ser mayor a  '~&UltFecha~', el Cupo no se procesó')
                 Let &TotalNoProcesados &TotalNoProcesados+1 
             Else    
                   *FechaVigencia: Fecha sin horas minutos segundos
                   let &fechaVigencia Fecha(Dialogo.Fecha1)
                   *Columna B = CUITEmisor (char(20))
                   *Hacer Copy(1,100) = EmisorNombre - Columna D (char(100))
                   *Columna E = NroActividad (char(100))
                   *Columna F  = Actividad (char(12))
                   *Columna G = Score  (int)
                   let &score Val(G:&i)
                   *Columna H = CDA (char(2))
                   *Columna I = MoraFAE (char(10))
                   *Columna J = PedidoAmpliacion (char(2))
                   *Columna K = CupoFCE (float)
                   If Vacio(Val(K:&i))
                       let &cupoFCE 0
                   else
                       let &cupoFCE Val(K:&i)
                   Endif    
                   *Columna L = CupoCPD (float)
                   If EqStr(Val(L:&i),'')
                       let &cupoCPD 0
                   else
                       let &cupoCPD Val(L:&i)
                   Endif  
                   *Columna M = CupoPagare (float)
                   If EqStr(Val(M:&i),'')
                       let &cupoPagare 0
                   else
                       let &cupoPagare Val(M:&i)
                   Endif  
                   *Columna N = CupoNC (float)
                   If EqStr(Val(N:&i),'')
                       let &cupoNC 0
                   else
                       let &cupoNC Val(N:&i)
                   Endif  
                   *Columna O = CupoTotal (float)
                   If EqStr(Val(O:&i),'')
                       let &cupoTotal 0
                   else
                       let &cupoTotal Val(O:&i)
                   Endif  
                   
              
                       SQL.ADD(" INSERT INTO "~DBO~".DDCUPOSNOAVALADOS ")
                       SQL.ADD(" (FechaVigencia, FechaCargaSys, Operador, Vehiculo, Book, ")
                       SQL.ADD(" Moneda, CUITEmisor, EmisorNombre, NroActividad, Actividad, ")
                       SQL.ADD(" Score, CDA, MoraFAE, PedidoAmpliacion, CupoFCE, ")
                       SQL.ADD(" CupoCPD, CupoPagare, CupoNC, CupoTotal) ")
                       SQL.ADD(" VALUES ")
                       SQL.ADD(" ('"~IdxDate(&fechaVigencia)~"','"~IdxDate(FSYS)~"','"~UsuarioActivo~"','"~Dialogo.Vehiculo1~"','"~Dialogo.Book1~"', ")
                       SQL.ADD(" '"~Dialogo.Especie1~"','"~Val(B:&i)~"','"~Trim(Copy(Val(D:&i),1,100))~"','"~FStr(Val(E:&i),,0)~"', '"~Val(F:&i)~"', ")
                       SQL.ADD(" "~FStr(&score,,0)~",'"~Val(H:&i)~"','"~FStr(Val(I:&i),,0)~"','"~Val(J:&i)~"',"~FStr(&cupoFCE,,0)~", ")
                       SQL.ADD(" "~FStr(&cupoCPD,,0)~","~FStr(&cupoPagare,,0)~","~FStr(&cupoNC,,0)~","~FStr(&cupoTotal,,0)~" ) ")
                       SQL.NEW()
             Endif
         Endif    
     Endif  
Proximo
watch(sql.batch)
SQL.EXEC()