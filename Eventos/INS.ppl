****Actualizo campos Total6 y Tasa2 con los datos cargados en la operacion item
Recorrer&i 1,&cantCuotas
    SQL.ADD("UPDATE "~DBO~".CUOTAS ")
    SQL.ADD("set Total6 = "~Fstr(VAL(ZB:&i),0,6)~", Tasa2 = "~Fstr(VAL(ZC:&i),0,6)~" ")
    SQL.ADD("WHERE NrOperacion= '"~Dialogo.NrOperacion2~"' ")
    SQL.ADD("AND NrCuota = "~FStr(&i,2,0)~" ")
    SQL.NEW
    SQL.EXEC
