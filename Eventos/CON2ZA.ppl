MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:   'Fecha'       ;;;;;;;;;fsys
  Lista1:   'Vehiculos'   ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
  ListaTabla1: 'Vouchers' ;-4;2;;;;;;;;;;;;;'NrTrans'; 'NrTrans;Cliente1;Fecha1;Fecha2;Especie;Cantidad1;Cuenta2'; 'TRANSACCIONES2' 
  Check1:      'Contab.Procesada' ;;;;NO;NO;
FinDialogo

If Not Ok
   Cancelar
Endif

message('--- Asientos de Liquidacion ---')

***---ACT(US:1, Descendientes('ESPECIES', 'U$S'))
ACT(US:1, Var('MONEEXTR'))
ACT(LS:1, Var('OPEIMPUEST'))
ACT(ME:1, Var('MONEEXTR'))
ACT(ML:1, Var('MONELOCA'))
ACT(MU:1, Var('MONEURU'))

***---Liquidacion de Fondos

SQL.ADD(" SELECT T.NrTrans, T.Cantidad1, T.Especie Moneda, O.NrOperacion, O.Especie, O.ContraEspecie, ")
SQL.ADD(" O.TipoOp, O.TotalNetoCli1, O.TotalBrutoCli1, MA.Codigo CodAsi, C.CUIT, V.Valor1, V.Valor2, ")
SQL.ADD(" O.FechaVto, O.Vehiculo1, O.Cantidad, CU.Comitente, O.CB9, O.CB10, O.Precio3, E.Tipo, ")
SQL.ADD(" O.TotalNetoCli2, T.Fecha2, T.Fecha1, O.FechaVto2, O.PrecioMer, O.FechaPago, O.TotalIVA, ")
SQL.ADD(" O.TotalIntereses, O.FechaOp, O.TotalBrutoCli2, O.TotalDerechos, O.Cliente1, T.Cuenta2, ")
SQL.ADD(" CU.CuentaContable1, C.Valor1 CtaRem, E.Issuer Cliente, T.TipoTr2, O.CB7, O.TipoTasa, O.MB2, O.FechaEx4, ")
SQL.ADD(" O.MB3, O.Observaciones, O.Precio1, O.Plazo, M.NrMov, M.NrGrupo2 MovConcepto, M.Status TipoImpuesto, E.Alias8, E.Alias5, ")
SQL.ADD(" E.Cotiza, O.PlazoRenovPredeter, O.ImpComCor1, O.ImpComMer1, V.Alias4 MonLocalVeh, O.MB4, O.CB13, O.CB14, MA.Libro, ")
SQL.ADD(" O.NrOperacion5, '' TipoDevengado, O.ImpGastos2, T.CNFormaPago, O.CantidadOri,C.CategDepositante, O.Book1 Book, CU.TipoCuenta, ")
SQL.ADD(" O.Arancel1,O.TotalNetoCli3,O.TotalRetenciones,O.CB1,O.TotalGastos,O.ContraEspecie3 MonedaGastos,")
SQL.ADD(" O.ContraEspecie2, O.ImpComCor1, O.ContraEspecie3, O.ImpComMer1, O.TotalIVA2, O.TotalIVA, ")
SQL.ADD(" C.CuentaContableAux as CtaContAuxCli,CU.CuentaContableAux as CtaContAuxCue, O.RB10, O.Indice, O.TipoGracia, T.Precio7 TcLiq, O.RB1 ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO MA, ")
SQL.ADD(" "~DBO~".CLIENTES C, "~DBO~".VEHICULOS V, "~DBO~".CUENTAS CU, "~DBO~".ESPECIES E,  ")
SQL.ADD(" "~DBO~".MOVEJECUTADOS M ")
SQL.ADD(" WHERE T.NrOperacionRef1 = O.NrOperacion ")
SQL.ADD(" AND ((O.Cliente1    =  C.Codigo AND O.TipoOp <> 'TRANSF') OR (T.Cliente1 = C.Codigo AND O.TipoOp = 'TRANSF')) ")
SQL.ADD(" AND O.Vehiculo1   =  V.Codigo  ")
SQL.ADD(" AND  O.Especie     =  E.Codigo ")
SQL.ADD(" AND   T.Especie  IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~")  ")
SQL.ADD(" AND   T.NrTrans     =  M.NrTrans2 ")
***---SQL.ADD(" AND O.TipoOp Not IN ('MMCP', 'MMCPM','MMPCLM','MMPEM','MMPIM','MMPOSM','MMSCMV','MMSIMV','MMPCCM','GARANT','TRANSF','MMDPAC','MMONM') ")
SQL.ADD(" AND O.TipoOp Not IN ('MMCP', 'MMCPM','MMPCLM','MMPEM','MMPIM','MMPOSM','MMSCMV','MMSIMV','MMPCCM','GARANT','MMDPAC','MMONM') ")
SQL.ADD(" and T.TipoTr2 in ('DEP','RET') ")
SQL.ADD(" AND M.NrOperacion = O.NrOperacion ")
SQL.ADD(" AND M.NrSaldo = 1 ")
SQL.ADD(" AND T.Cantidad1 > 0 ")
SQL.ADD(" AND T.Cuenta2 = CU.Codigo ")
SQL.ADD(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASILF'))~") ")
SQL.ADD(" AND MA.TipoOp = O.TipoOp ")
SQL.ADD(" AND T.Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
SQL.ADD(" AND MA.Habilitado = 'SI' ")
**SQL.ADD(" AND MA.Entorno = '"~SIGLA~"' ")
SQL.ADD(" AND '|'+rtrim(MA.Entorno)+'|' like '%|"~SIGLA~"|%' ")
***---Para las TRANSF contabilizamos la pata de la cuenta comitente
SQL.ADD(" AND ((O.TipoOp = 'TRANSF' AND CU.TipoCuenta = 'CUS') OR (O.TipoOp <> 'TRANSF')) ")
If NoVacio(Dialogo.ListaTabla1)
   SQL.ADD(" AND T.NrTrans IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
Else
   SQL.ADD(" AND T.Fecha1 = "~IdxDate2(Dialogo.Fecha1)~" ")
   If NoVAcio(Dialogo.Lista1)
       SQL.ADD(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND (( ")
       Recorrer&i 1,Elementos(Dialogo.Lista1)
            SQL.ADD(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(Dialogo.Lista1,&i)~"|%' ")
            If NOT Elementos(Dialogo.Lista1)=&i
                SQL.ADD(" OR ")
            EndIf
       proximo
       SQL.ADD(") OR MA.Vehiculo is null OR MA.Vehiculo = '' OR MA.Vehiculo = ' ' )")        
   Else
      If NoVacio(UsrVehiculos(UsuarioActivo))
         SQL.ADD(" AND T.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
      Endif
   Endif
Endif
SQL.ADD(" AND ( ") 
SQL.ADD( " (O.TipoOp IN ('MRO','MRF') AND O.FechaEx4 >= '"~IdxDate(Fecha(Var('FECHAMIGRA')))~"') ")
SQL.ADD(" OR (MA.Codigo IN ('FCS2','FCR3') AND O.FechaOp >= '"~IdxDate(Fecha(Var('FECHAMIGRA')))~"') ")
SQL.ADD(" OR (O.TipoOp NOT IN ('MRO','MRF') AND MA.Codigo NOT IN ('FCS2','FCR3') AND T.Fecha2 >= '"~IdxDate(Fecha(Var('FECHAMIGRA')))~"')) ") 
SQL.ADD(" ORDER By O.NrOperacion, MA.Codigo ")
Watch(sql.batch)
Recorrer SQL
    ****CANJE
    let &esCanje fbn('RB1')

    let &monedaOp fbn('Moneda')
    IF Incluido(fbn('TipoOp'), 'MRO|MRF')
        ACD(FV:1, fbn('FechaEx4'))
    ELSE
        IF Incluido(fbn('CodAsi'), 'FCS2|FCR3|')
           ACD(FV:1, fbn('FechaOp'))
        ELSE
           ACD(FV:1, fbn('Fecha2'))
        ENDIF
    ENDIF   
    ***---Ultimo Dia Habil mes anterior
    ACD(FE:43, Habiles(PriDeMes(Val(FV:1)),-1))
    ACT(VH:1, fbn('Vehiculo1'))
    ACD(FO:1, val(FV:1))
    ACD(FO:2, Habiles(FinDeMes(val(FO:1),NO,'ARG')))
    **//(.'FECHAVALOR'.)     
    (.'FECHAVALO2'.)
    ACD(FV:2, Val(FV:1))
    (.'FECHAVALOR'.)
    let &fechaContable Val(FV:1)    
    let &MonedaComisionCorredor fbn('ContraEspecie2')
    let &ImporteComisionCorredor fbn('ImpComCor1')
    let &MonedaComisionMercado fbn('ContraEspecie3')
    let &ImporteComisionMercado fbn('ImpComMer1')
    let &ImporteIVACorredor fbn('TotalIVA2')
    let &ImporteIVAMercado fbn('TotalIVA')
    ***Campos para CTAAUXBOOK
    let &book FBN('Book')
    let &vehiculo FBN('Vehiculo1')
    let &emisor FBN('Cliente')
    *****
    let &ctaContAuxCli fbn('CtaContAuxCli')
    let &ctaContAuxCue FBN('CtaContAuxCue')
    let &esPrecancelacion fbn('RB10')
    ACN(CK:1, 0)
    let &cantidad   0
    let &interes    0
    *let &difCambio  0
    If #ESPRECANCELACION
        **Cintia x TcLiq Prestamos // Lo obtengo para SECS de canje
        let &tcLiq FBN['TCLiq']
  
        let &cantPrecancelacion fbn('TotalBrutoCli1')
        ****Seteo fecha para funcion CONVTCINTD
        let &fechaFinCONVTC &fechaFin

        ****Importe y cuenta item PRESTAMOS        
        let &nrOperacionOn BuscarCampo('OPERACIONES','NrOperacion2','NrOperacion',fbn('NrOperacion'))
        
        ***Cintia DIC2024 Se setea para las precancelaciones la &monedaOp con la moneda de la ON para que tome la cuenta correcta
        let &monedaOp BuscarCampo('OPERACIONES','Especie','NrOperacion',&nrOperacionOn)
        let &clienteOn BuscarCampo('OPERACIONES','Cliente1','NrOperacion',&nrOperacionOn)
        let &sector BuscarCampo('CLIENTES','CategDepositante','Codigo',&clienteOn)
        
        ****Cuenta Auxiliar de la ON
        let &ctaContAuxOp BuscarCampo('OPERACIONES','CuentaContableAux1','NrOperacion',&nrOperacionOn)
 
        ACD(FF:1,fbn('FechaOp'))

        SQL.ADD("SELECT NrOperacion1,NrCuota, 'INTLEN' as TipoDevengado")
        SQL.ADD("FROM "~DBO~".PRECANCELACION WHERE NrOperacion1 = '"~fbn('NrOperacion')~"' AND NrOperacion = '"~&nrOperacionOn~"' ")
        SQL.ADD("Group By NrOperacion1, NrCuota ")
        Recorrer Sql
            let &interesDev 0
*            (.'CONVTCINTD'.)
*            let &intDevDiaMF1 &intDevDiaMF1+&intDevDiaMF
*            let &intDevDiaML1 &intDevDiaML1+&intDevDiaML
*            let &intDevDiaMG1 &intDevDiaMG1+&intDevDiaMG
            SQL.ADD(" Select Sum(Monto) Monto ")
            SQL.ADD(" From "~DBO~".MOVDEVENGADOS ")
            SQL.ADD(" Where NrOperacion = '"~&nrOperacionOn~"' ")
            SQL.ADD(" and TipoDevengado = '"~FBN('TipoDevengado')~"' ")
            SQL.ADD(" and FechaEj = '"~IdxDate(val(FF:1))~"' ")
            SQL.ADD(" and Cupon = '"~FsTr(fbn('NrCuota'),0,0)~"' ")
            SQL.ADD(" And Fecha <= '"~IdxDate(val(FF:1))~"' ")
            *SQL.ADD(" Order by Fecha ")
            Recorrer SQL
                let &interesDev fbn('Monto')
            Proximo
        Proximo
        let &difCambio        0
        let &montoCorriente   0
        let &montoNoCorriente 0
        let &cantidadCorrientePrecan   0
        let &cantidadNoCorrientePrecan 0        
        let &impAControlar  &cantPrecancelacion
        let &indiceOn  BuscarCampo('OPERACIONES','Indice','NrOperacion',&nrOperacionOn)
        let &tipoGraciaON  BuscarCampo('OPERACIONES','TipoGracia','NrOperacion',&nrOperacionOn)

        If #ESUSDLINKON
            let &cantAControlar #CANTIDAD
        EndIf
        let &cuotaAfectada SQL("Select Min(NrCuota1) from "~DBO~".PRECANCELACION WHERE NrOperacion1 = '"~fbn('NrOperacion')~"' AND NrOperacion = '"~&nrOperacionOn~"'")
       ****Si es Dolar Link uso Cantidad13, si no Cantidad4
        let &tasaAmort 0
        If #ESUSDLINKON
            SQL.ADD("Select Cantidad13 ImpAmort, ")
        Else
            SQL.ADD("Select Cantidad4 ImpAmort, ")
        EndIf
        SQL.ADD("Fecha2 FechaVto, Tasa1 TasaAmort ")
        SQL.ADD("from CUOTAS where NrOperacion = '"~&nrOperacionOn~"' and NrCuota >= '"~FsTr(&cuotaAfectada,0,0)~"' ")
        Recorrer SQL
            let &tasaAmort &tasaAmort+fbn('TasaAmort')
            
            If (fbn('ImpAmort')>= &cantAControlar Y #ESUSDLINKON) O (fbn('ImpAmort')>= &impAControlar)
                **Controlo si no me paso de importe para ver si es Corriente o no Corriente
                If fbn('FechaVto') <= Val(FV:2)+VAR('PLCAPCORR')
                    let &montoCorriente   &montoCorriente + &impAControlar
                    If #ESUSDLINKON
                        let &cantidadCorrientePrecan &cantidadCorrientePrecan + &cantAControlar
                    EndIf
                Else
                    let &montoNoCorriente &montoNoCorriente + &impAControlar
                    If #ESUSDLINKON
                        let &cantidadNoCorriente &cantidadNoCorriente + &impAControlar
                    EndIf
                EndIf
                **Si me alcanza con esa cuota no sigo controlando el resto de las cuotas
                Break
            Else
                **Controlo cuando me paso de importe para ver si es Corriente o no Corriente
                If fbn('FechaVto') <= Val(FV:2)+VAR('PLCAPCORR')
                    let &montoCorriente   &montoCorriente + fbn('ImpAmort')
                    If #ESUSDLINKON
                        let &cantidadCorrientePrecan &cantidadCorrientePrecan + fbn('ImpAmort')
                    EndIf
                Else
                    let &montoNoCorriente &montoNoCorriente + &impAControlar
                    If #ESUSDLINKON
                        let &cantidadNoCorriente &cantidadNoCorriente + &impAControlar  
                    EndIf
                EndIf 
                
                let &impAControlar &impAControlar-fbn('ImpAmort')             
            EndIf           
        Proximo
        
        let &PorcPrecancelacion SQL("Select TOP 1 Tasa1 from "~DBO~".PRECANCELACION WHERE NrOperacion1 = '"~fbn('NrOperacion')~"' AND NrOperacion = '"~&nrOperacionOn~"'")

        If #ESUSDLINKON
            ****Estos campos se usan para Calculo3 del modelo
            let &montoPrecan              #CANTIDAD * &tasaAmort /100
            let &cantidadNoCorrientePrecan   &cantidadNoCorrientePrecan * &tasaAmort /100
            let &cantidadCorrientePrecan     &cantidadCorrientePrecan * &tasaAmort /100
            ****Este campo se usa para Valor1 del modelo
            let &cantOperacion            #CANTIDAD * &tasaAmort /100
        Else
            let &montoPrecan              #CANTIDAD
            let &cantOperacion            #MONTOBRUTO
        EndIf

*        ****Cuando es una SECS de precancelacion tengo que generar tambien el asiento MMONMDCPREC
*        ****para obtener diferencia de cambio asociada a la ON
*        let &monedaOpOn BuscarCampo('OPERACIONES','Especie','NrOperacion',&nrOperacionOn)
*        If EqStr(&monedaOpOn,val(ME:1))
*            ****La on solo va a tener DC cuando es en USD
*            let &fechaIniCuota SQL("Select TOP 1 Fecha3 from "~DBO~".PRECANCELACION WHERE NrOperacion1 = '"~fbn('NrOperacion')~"' AND NrOperacion = '"~&nrOperacionOn~"' order by NrCuota1 ")
*            let &fechaPrecan   SQL("Select TOP 1 Fecha1 from "~DBO~".PRECANCELACION WHERE NrOperacion1 = '"~fbn('NrOperacion')~"' AND NrOperacion = '"~&nrOperacionOn~"' order by NrCuota1 ")
*            let &porcentajePrecan SQL("Select TOP 1 Tasa1 from "~DBO~".PRECANCELACION WHERE NrOperacion1 = '"~fbn('NrOperacion')~"' AND NrOperacion = '"~&nrOperacionOn~"' order by NrCuota1 ")
*            (.'DCPRECAN'.)
*        EndIf
*        *let &difCambio #DCCAP + #DCINTERES
*        
    EndIf
    IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
        ACN(CK:1, 1)
        **// Asientos de concert. atados a voucher. No manda NrTrans
        IF Incluido(fbn('CodAsi'),'FCS1|FCR1')
        IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND (FechaValor > '"~IdxDate(Val(FO:2))~"' OR FechaValor =  '"~IdxDate(Val(FO:1))~"') AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
               ACN(CK:1, 0)
           ENDIF
        ELSE
            IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'E' AND NrTrans2 = '"~fbn('NrTrans')~"' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND (FechaValor > '"~IdxDate(Val(FO:2))~"' OR FechaValor =  '"~IdxDate(Val(FO:1))~"') AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
               ACN(CK:1, 0)
           ENDIF
        ENDIF
    ENDIF
    IF Val(CK:1) = 0
        SQL.ADD(" SELECT Cantidad, Especie, NrOperacion FROM "~DBO~".MOVPENDIENTES ")
        SQL.ADD(" WHERE  NrOperacion = '"~fbn('NrOperacion')~"' ")
        IF Eqstr(fbn('Moneda'),fbn('Especie'))
           SQL.ADD(" AND  Especie = '"~fbn('ContraEspecie')~"' ")
        Else
           SQL.ADD(" AND  Especie = '"~fbn('Especie')~"' ")
        Endif
        SQL.ADD(" UNION ")
        SQL.ADD(" SELECT Cantidad, Especie, NrOperacion FROM "~DBO~".MOVEJECUTADOS ")
        SQL.ADD(" WHERE NrOperacion = '"~fbn('NrOperacion')~"' ") 
        IF Eqstr(fbn('Moneda'),fbn('Especie'))
           SQL.ADD(" AND  Especie = '"~fbn('ContraEspecie')~"' ")
        Else
           SQL.ADD(" AND  Especie = '"~fbn('Especie')~"' ")
        Endif
        SQL.ADD(" ORDER BY 3 ")
        Recorrer SQL
           dfa
           SCN(mc:1, fbn('Cantidad'))
           ACT(mo:1, fbn('Especie'))
        Proximo
        ***---DC entre Fecha de liquidacion y FechaOp
        IF Incluido(fbn('TipoOp'), 'SECS|SEVS|SECT|SEVT|SECSV|SEVSV|SECTV|SEVTV')
            ACN(CP:1, fbn('TotalNetoCli1'))
            IF Val(FE:43) > fbn('FechaOp')
                ACD(FD:1, Val(FE:43))
            ELSE
                ACD(FD:1, fbn('FechaOp'))
            ENDIF
            ACD(FH:1, Val(FV:1))
            (.'DC-CAPINT'.)
        ENDIF
        **// Asientos de concert. atados a voucher. No manda NrTrans
        IF Incluido(fbn('CodAsi'),'FCS1|FCR1')
           ACT(NT:1, '')
        Else
           ACT(NT:1, fbn('NrTrans'))
        Endif
        let &modeloContable fbn('CodAsi')
        let &Moneda fbn('Moneda')
        SQL.GenerarAsientoOp(&modeloContable,fbn('NrOperacion'),'','',810,Val(fv:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,Val(NT:1),,,,,fsys,Dialogo.Fecha1)
        SQL.EXEC

    ENDIF
Proximo

let &esCanje 0

***---Liquidacion de Titulos
SQL.ADD(" SELECT T.NrTrans, T.Cantidad1, T.Especie, O.NrOperacion, O.Especie, O.ContraEspecie Moneda, ")
SQL.ADD(" O.TipoOp, O.TotalNetoCli1, O.TotalBrutoCli1, MA.Codigo CodAsi, C.CUIT, V.Valor1, V.Valor2, ")
SQL.ADD(" O.FechaVto, O.Vehiculo1, O.Cantidad, CU.Comitente, O.CB9, O.CB10, O.Precio3, E.Tipo, ")
SQL.ADD(" O.TotalNetoCli2, T.Fecha2, T.Fecha1, O.FechaVto2, O.PrecioMer, O.FechaPago, O.TotalIVA, ")
SQL.ADD(" O.TotalIntereses, O.FechaOp, O.TotalBrutoCli2, O.TotalDerechos, O.Cliente1, T.Cuenta2, ")
SQL.ADD(" CU.CuentaContable1, C.Valor1 CtaRem, E.Issuer Cliente, T.TipoTr2, O.CB7, O.TipoTasa, O.MB2, O.FechaEx4, ")
SQL.ADD(" O.MB3, O.Observaciones, O.Precio1, O.Plazo, M.NrMov, M.NrGrupo2 MovConcepto, M.Status TipoImpuesto, E.Alias8, ")
SQL.ADD(" E.Cotiza, O.PlazoRenovPredeter, V.Alias4 MonLocalVeh, O.MB4, O.CB13, O.CB14, MA.Libro, O.NrOperacion5, '' TipoDevengado, ")
SQL.ADD(" O.ImpComCor1, O.ImpComMer1, O.ImpGastos2, O.ImpComMer2, O.ImpComCor2, O.TotalGastos, O.TasaImp1, O.TasaPrecan, T.CNFormaPago, E.PaisOrigen, O.CantidadOri, O.Book1 Book, ")
SQL.ADD(" C.CuentaContableAux as CtaContAuxCli,CU.CuentaContableAux as CtaContAuxCue ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO MA, ")
SQL.ADD(" "~DBO~".CLIENTES C, "~DBO~".VEHICULOS V, "~DBO~".CUENTAS CU, "~DBO~".ESPECIES E,  ")
SQL.ADD(" "~DBO~".MOVEJECUTADOS M ")
SQL.ADD(" WHERE T.NrOperacionRef1 = O.NrOperacion ")
SQL.ADD(" AND   O.Cliente1    =  C.Codigo   ")
SQL.ADD(" AND   O.Vehiculo1   =  V.Codigo   ")
SQL.ADD(" AND   O.Especie     =  E.Codigo   ")
SQL.ADD(" AND   T.Especie NOT IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~")  ")
SQL.ADD(" AND   T.NrTrans     =  M.NrTrans2 ")
SQL.ADD(" AND O.TipoOp Not IN ('MMCP', 'MMCPM','MMPCLM','MMPEM','MMPIM','MMPOSM','MMSCMV','MMSIMV','MMPCCM','GARANT','TRANSF','MMDPAC') ")
SQL.ADD(" and T.TipoTr2 in ('DEP','RET') ")
SQL.ADD(" AND M.NrOperacion = O.NrOperacion ")
SQL.ADD(" AND M.NrSaldo = 1 ")
SQL.ADD(" AND T.Cantidad1 > 0 ")
SQL.ADD(" AND T.Cuenta2 = CU.Codigo ")
SQL.ADD(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASILT'))~") ")
SQL.ADD(" AND MA.TipoOp = O.TipoOp ")
SQL.ADD(" AND T.Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
SQL.ADD(" AND MA.Habilitado = 'SI' ")
**SQL.ADD(" AND MA.Entorno = '"~SIGLA~"' ")
SQL.ADD(" AND '|'+rtrim(MA.Entorno)+'|' like '%|"~SIGLA~"|%' ")
If NoVacio(Dialogo.ListaTabla1)
   SQL.ADD(" AND T.NrTrans IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
Else
   SQL.ADD(" AND T.Fecha1 = "~IdxDate2(Dialogo.Fecha1)~" ")
   If NoVAcio(Dialogo.Lista1)
       SQL.ADD(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND (( ")
       Recorrer&i 1,Elementos(Dialogo.Lista1)
            SQL.ADD(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(Dialogo.Lista1,&i)~"|%' ")
            If NOT Elementos(Dialogo.Lista1)=&i
                SQL.ADD(" OR ")
            EndIf
       proximo
       SQL.ADD(") OR MA.Vehiculo is null OR MA.Vehiculo = '' OR MA.Vehiculo = ' ' )")   
   Else
      If NoVacio(UsrVehiculos(UsuarioActivo))
         SQL.ADD(" AND T.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
      Endif
   Endif
Endif
SQL.ADD(" AND T.Fecha2 >= '"~IdxDate(Fecha(Var('FECHAMIGRA')))~"' ")
SQL.ADD(" ORDER By O.NrOperacion, MA.Codigo ")
Recorrer SQL
    ACD(FV:1, fbn('Fecha2'))
    ACT(VH:1, fbn('Vehiculo1'))
    ACD(FO:1, val(FV:1))
    ACD(FO:2, Habiles(FinDeMes(val(FO:1),NO,'ARG')))
    let &book fbn('Book')
    let &ctaContAuxCli fbn('CtaContAuxCli')
    let &ctaContAuxCue FBN('CtaContAuxCue')
    ***---Ultimo Dia Habil mes anterior
    ACD(FE:43, Habiles(PriDeMes(Val(FV:1)),-1))
    (.'FECHAVALO2'.)
    ACD(FV:2, Val(FV:1))
    (.'FECHAVALOR'.)
    let &fechaContable Val(FV:1)    
    ACN(CK:1, 0)
    IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
        ACN(CK:1, 1)
        IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'E' AND NrTrans2 = '"~fbn('NrTrans')~"' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND (FechaValor > '"~IdxDate(Val(FO:2))~"' OR FechaValor =  '"~IdxDate(Val(FO:1))~"') AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
            ACN(CK:1, 0)
        ENDIF
    ENDIF
    IF Val(CK:1) = 0
        SQL.ADD(" SELECT Cantidad, Especie, NrOperacion FROM "~DBO~".MOVPENDIENTES ")
        SQL.ADD(" WHERE  NrOperacion = '"~fbn('NrOperacion')~"' ")
        IF Eqstr(fbn('Moneda'),fbn('Especie'))
           SQL.ADD(" AND  Especie = '"~fbn('ContraEspecie')~"' ")
        Else
           SQL.ADD(" AND  Especie = '"~fbn('Especie')~"' ")
        Endif
        SQL.ADD(" UNION ")
        SQL.ADD(" SELECT Cantidad, Especie, NrOperacion FROM "~DBO~".MOVEJECUTADOS ")
        SQL.ADD(" WHERE NrOperacion = '"~fbn('NrOperacion')~"' ") 
        IF Eqstr(fbn('Moneda'),fbn('Especie'))
           SQL.ADD(" AND  Especie = '"~fbn('ContraEspecie')~"' ")
        Else
           SQL.ADD(" AND  Especie = '"~fbn('Especie')~"' ")
        Endif
        SQL.ADD(" ORDER BY 3 ")
        Recorrer SQL
           dfa
           SCN(mc:1, fbn('Cantidad'))
           ACT(mo:1, fbn('Especie'))
        Proximo
        ***---DC entre Fecha de liquidacion y FechaOp
        IF Incluido(fbn('TipoOp'), 'SECS|SEVS|SECT|SEVT|SECSV|SEVSV|SECTV|SEVTV')
            ACN(CP:1, fbn('TotalNetoCli1'))
            IF Val(FE:43) > fbn('FechaOp')
                ACD(FD:1, Val(FE:43))
            ELSE
                ACD(FD:1, fbn('FechaOp'))
            ENDIF
            ACD(FH:1, Val(FV:1))
            (.'DC-CAPINT'.)
        ENDIF
        ACT(EM:1, fbn('Cliente'))
        ACT(VH:11, fbn('Vehiculo1'))
        IF #BONOPROPIO
            ***---Resultado Realizado
            IF Eqstr(fbn('Cotiza'), fbn('Moneda'))
                ACN(RZ:1, fbn('Cantidad') * (1-fbn('Precio1')))
            ELSE
                ACN(RZ:1, fbn('Cantidad') * (1-(fbn('Precio1')*CotizacionC(fbn('Moneda'),,,,Val(FV:1),1,SI,fbn('Cotiza')))))
            ENDIF
        ENDIF  
        let &modeloContable fbn('CodAsi')
        let &Moneda fbn('Moneda')
        SQL.GenerarAsientoOp(&modeloContable,fbn('NrOperacion'),'','',810,Val(fv:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,fbn('NrTrans'),,,,,fsys,Dialogo.Fecha1)
        SQL.EXEC
    ENDIF
Proximo

***---Liquidacion de Titulos Mercado Regulado
SQL.ADD(" SELECT T.NrTrans, T.Cantidad1, T.Especie, O.NrOperacion, O.Especie, O.ContraEspecie Moneda, ")
SQL.ADD(" O.TipoOp, O.TotalNetoCli1, O.TotalBrutoCli1, MA.Codigo CodAsi, C.CUIT, V.Valor1, V.Valor2, ")
SQL.ADD(" O.FechaVto, O.Vehiculo1, O.Cantidad, CU.Comitente, O.CB9, O.CB10, O.Precio3, E.Tipo, ")
SQL.ADD(" O.TotalNetoCli2, T.Fecha2, T.Fecha1, O.FechaVto2, O.PrecioMer, O.FechaPago, O.TotalIVA, ")
SQL.ADD(" O.TotalIntereses, O.FechaOp, O.TotalBrutoCli2, O.TotalDerechos, O.Cliente1, T.Cuenta2, ")
SQL.ADD(" CU.CuentaContable1, C.Valor1 CtaRem, E.Issuer Cliente, T.TipoTr2, O.CB7, O.TipoTasa, O.MB2, O.FechaEx4, O.MB3, ")
SQL.ADD(" E.Cotiza, O.TotalAux1, O.Observaciones, O.Plazo, O.Precio1, E.Alias8, V.Alias4 MonLocalVeh, O.MB4, MA.Libro, O.Book1 Book , ")
SQL.ADD(" C.CuentaContableAux as CtaContAuxCli,CU.CuentaContableAux as CtaContAuxCue ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO MA, ")
SQL.ADD(" "~DBO~".CLIENTES C, "~DBO~".VEHICULOS V, "~DBO~".CUENTAS CU, "~DBO~".ESPECIES E,  ")
SQL.ADD(" "~DBO~".MOVEJECUTADOS M ")
SQL.ADD(" WHERE T.NrOperacionRef1 = O.NrOperacion ")
SQL.ADD(" AND   O.Cliente1    =  C.Codigo   ")
SQL.ADD(" AND   O.Vehiculo1   =  V.Codigo   ")
SQL.ADD(" AND   O.Contrato     =  E.Codigo   ")
SQL.ADD(" AND   dbo.DESCIENDEDEESPECIE(T.Especie,'TITULO') = 1  ")
SQL.ADD(" AND   T.NrTrans     =  M.NrTrans2 ")
SQL.ADD(" AND O.TipoOp IN ('MRF') ")
SQL.ADD(" and T.TipoTr2 in ('DEP','RET') ")
SQL.ADD(" AND M.NrOperacion = O.NrOperacion ")
SQL.ADD(" AND M.NrSaldo = 1 ")
SQL.ADD(" AND T.Cantidad1 > 0 ")
SQL.ADD(" AND MA.TipoOp = O.TipoOp ")
SQL.ADD(" AND T.Cuenta2 = CU.Codigo ")
SQL.ADD(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASILT'))~") ")
SQL.ADD(" AND T.Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
SQL.ADD(" AND MA.Habilitado = 'SI' ")
**SQL.ADD(" AND MA.Entorno = '"~SIGLA~"' ")
SQL.ADD(" AND '|'+rtrim(MA.Entorno)+'|' like '%|"~SIGLA~"|%' ")
If NoVacio(Dialogo.ListaTabla1)
   SQL.ADD(" AND T.NrTrans IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
Else
   SQL.ADD(" AND T.Fecha1 = "~IdxDate2(Dialogo.Fecha1)~" ")
   If NoVAcio(Dialogo.Lista1)
       SQL.ADD(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND (( ")
       Recorrer&i 1,Elementos(Dialogo.Lista1)
            SQL.ADD(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(Dialogo.Lista1,&i)~"|%' ")
            If NOT Elementos(Dialogo.Lista1)=&i
                SQL.ADD(" OR ")
            EndIf
       proximo
       SQL.ADD(") OR MA.Vehiculo is null OR MA.Vehiculo = '' OR MA.Vehiculo = ' ' )")     
   Else
      If NoVacio(UsrVehiculos(UsuarioActivo))
         SQL.ADD(" AND T.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
      Endif
   Endif
Endif
SQL.ADD(" AND O.FechaEx4 >= '"~IdxDate(Fecha(Var('FECHAMIGRA')))~"' ")
SQL.ADD(" ORDER By O.NrOperacion, MA.Codigo, T.NrTrans ")
Recorrer SQL
    ACD(FV:1, fbn('FechaEx4'))
    ACD(FO:1, val(FV:1))
    ACD(FO:2, Habiles(FinDeMes(val(FO:1),NO,'ARG')))
    let &book fbn('Book')
    let &ctaContAuxCli fbn('CtaContAuxCli')
    let &ctaContAuxCue FBN('CtaContAuxCue')
    ACD(FV:2, Val(FV:1))
    (.'FECHAVALOR'.)    
    let &fechaContable Val(FV:1)    
    ACT(VH:1, fbn('Vehiculo1'))
    ACN(CK:1, 0)
    IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
        ACN(CK:1, 1)
        IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'E' AND NrTrans2 = '"~fbn('NrTrans')~"' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND (FechaValor > '"~IdxDate(Val(FO:2))~"' OR FechaValor =  '"~IdxDate(Val(FO:1))~"') AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
            ACN(CK:1, 0)
        ENDIF
    ENDIF
    IF Val(CK:1) = 0
        message(fbn('NrOperacion')~'  - Modelo: '~fbn('CodAsi'))
        let &modeloContable fbn('CodAsi')
        let &Moneda fbn('Moneda')
        SQL.GenerarAsientoOp(&modeloContable,fbn('NrOperacion'),'','',810,Val(fv:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,fbn('NrTrans'),,,,,fsys,Dialogo.Fecha1)
        SQL.EXEC
    ENDIF
Proximo

***---Constitucion PF y Toma de Prestamos
****Si es un canje con Dolar link la moneda es la moneda de la op y no de la transaccion
SQL.ADD(" SELECT T.NrTrans, T.Cantidad1, CASE WHEN (O.Indice is NOT NULL AND (O.TipoGracia ='ULK') AND O.RB1=1 AND M.NrMov > 6000 AND M.NrMov < 7000) THEN O.Especie ELSE T.Especie END Moneda, ")
SQL.ADD(" O.NrOperacion, O.Especie, O.ContraEspecie, ")
SQL.ADD(" O.TipoOp, O.TotalNetoCli1, O.TotalBrutoCli1, MA.Codigo CodAsi, C.CUIT, V.Valor1, V.Valor2, ")
SQL.ADD(" O.FechaVto, O.Vehiculo1, O.Cantidad, CU.Comitente, O.CB9, O.CB10, O.Precio3, E.Tipo, ")
SQL.ADD(" O.TotalNetoCli2, T.Fecha2, T.Fecha1, O.FechaVto2, O.PrecioMer, O.FechaPago, O.TotalIVA, ")
SQL.ADD(" O.TotalIntereses, O.FechaOp, O.TotalBrutoCli2, O.TotalDerechos, O.Cliente1, T.Cuenta2, ")
SQL.ADD(" CU.CuentaContable1, C.Valor1 CtaRem, E.Issuer Cliente, T.TipoTr2, O.CB7, O.TipoTasa, O.Observaciones, ")
SQL.ADD(" O.Precio1, O.Plazo, O.MB3, E.Alias8, O.CB5, V.Alias4 MonLocalVeh, V.Alias4, M.NrMov, O.MB4, MA.Libro, T.CNFormaPago, ")
SQL.ADD(" M.NrGrupo2, O.Indice, O.Precio5, O.Precio6,CU.TipoCuenta,O.Book1 AS Book, O.TipoGracia, ")
SQL.ADD(" C.CuentaContableAux as CtaContAuxCli,CU.CuentaContableAux as CtaContAuxCue, O.CuentaContableAux1 as 'ctaContAuxOp', ")
SQL.ADD(" T.Precio7 TcLiq, O.RB1, O.Cuenta4 ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO MA, ")
SQL.ADD(" "~DBO~".CLIENTES C, "~DBO~".VEHICULOS V, "~DBO~".CUENTAS CU, "~DBO~".ESPECIES E,  ")
SQL.ADD(" "~DBO~".MOVEJECUTADOS M ")
SQL.ADD(" WHERE T.NrOperacionRef1 = O.NrOperacion ")
SQL.ADD(" AND   O.Cliente1    =  C.Codigo   ")
SQL.ADD(" AND   O.Vehiculo1   =  V.Codigo   ")
SQL.ADD(" AND   O.Especie     =  E.Codigo   ")
SQL.ADD(" AND   T.Especie  IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~")  ")
SQL.ADD(" AND   T.NrTrans     =  M.NrTrans2 ")
SQL.ADD(" and T.TipoTr2 in ('DEP','RET') ")
SQL.ADD(" AND M.NrOperacion = O.NrOperacion ")
SQL.ADD(" AND M.NrSaldo = 1 ")
SQL.ADD(" AND T.Cantidad1 > 0 ")
SQL.ADD(" AND T.Cuenta2 = CU.Codigo ")
SQL.ADD(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASICOTO'))~") ")
SQL.ADD(" AND MA.TipoOp = O.TipoOp ")
SQL.ADD(" AND T.Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
SQL.ADD(" AND O.TipoOp IN ('MMCP', 'MMCPM','MMPCLM','MMPEM','MMPIM','MMPOSM','MMSCMV','MMSIMV','MMPCCM','MMONM') ")
SQL.ADD(" AND ((((O.RB1<>1 AND O.TipoOp = 'MMONM') OR (O.TipoOp <> 'MMONM')) AND (O.FechaOp = M.FechaMov ")
****SQL.ADD("AND (O.FechaOp = M.FechaMov ")
***// La fecha del movimiento debe ser FechaOp, excepto para las comisiones de ON
SQL.ADD("       OR ( O.TipoOp = 'MMONM' AND ((M.NrMov > 10000 AND M.NrMov < 11000) )))) ")
**SQL.ADD(" OR (O.RB1=1 AND O.TipoOp='MMONM' AND O.FechaOp = M.FechaMov AND O.Cuenta4=M.Cuenta)) ")
****CANJE - por la liquidacion al alta buscamos por concepto que descienda de moneda para movimientos de canje
SQL.ADD(" OR (O.RB1=1 AND O.TipoOp='MMONM' AND O.FechaOp = M.FechaMov AND ")
SQL.ADD("    ((NrMov<10000 AND dbo.DESCIENDEDEESPECIE(M.Concepto,'MONEDA') = 1) OR (NrMov>10000))  ))")
SQL.ADD(" AND MA.Habilitado = 'SI' ")
**SQL.ADD(" AND MA.Entorno = '"~SIGLA~"' ")
SQL.ADD(" AND '|'+rtrim(MA.Entorno)+'|' like '%|"~SIGLA~"|%' ")
If NoVacio(Dialogo.ListaTabla1)
   SQL.ADD(" AND T.NrTrans IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
Else
   SQL.ADD(" AND T.Fecha1 = "~IdxDate2(Dialogo.Fecha1)~" ")
   If NoVAcio(Dialogo.Lista1)
       SQL.ADD(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND (( ")
       Recorrer&i 1,Elementos(Dialogo.Lista1)
            SQL.ADD(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(Dialogo.Lista1,&i)~"|%' ")
            If NOT Elementos(Dialogo.Lista1)=&i
                SQL.ADD(" OR ")
            EndIf
       proximo
       SQL.ADD(") OR MA.Vehiculo is null OR MA.Vehiculo = '' OR MA.Vehiculo = ' ' )")     
   Else
      If NoVacio(UsrVehiculos(UsuarioActivo))
         SQL.ADD(" AND T.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
      Endif
   Endif
Endif
SQL.ADD(" AND O.FechaOp >= '"~IdxDate(Fecha(Var('FECHAMIGRA')))~"' ")
SQL.ADD(" ORDER By O.NrOperacion, MA.Codigo, T.NrTrans")
ACT(NR:1, '')
Recorrer SQL
    let &ctaContAuxCue FBN('CtaContAuxCue')
    
    **Cintia x TcLink Prestamos
    let &tcLink FBN['Precio6']
    **
    **Cintia x TcLiq Prestamos
    let &tcLiq FBN['TCLiq']
    **
    **Cintia 301123 por préstamos PCR
    let &ctaContAuxOp fbn('ctaContAuxOp')
    let &sector BuscarCampo('CLIENTES','CategDepositante','Codigo',fbn('Cliente1'))
    **
    let &monedaOp fbn('Especie')
    message(fbn('NrOperacion')~'  - Modelo: '~fbn('CodAsi'))
    ACD(FV:1, fbn('FechaOp'))
    ACT(VH:1, fbn('Vehiculo1'))
    ACD(FO:1, val(FV:1))
    ACD(FO:2, Habiles(FinDeMes(val(FO:1),NO,'ARG')))
    ACD(FV:2, Val(FV:1))
    (.'FECHAVALOR'.)
    let &fechaContable Val(FV:1)    
    let &book fbn('Book')
    let &ctaContAuxCli fbn('CtaContAuxCli')
    let &ctaContAuxCue FBN('CtaContAuxCue')
    ACN(CK:1, 0)
        
    **Cintia 230224 x ONs -PCR
    let &primaCte 0
    let &primaNoCte 0
    let &gastosCte 0
    let &gastosNoCte 0
    
    *Los montos de Prima/Dcto y Gastos se calculan ya que en el alta de la op no siempre estan generados todos los devengados
    **Prima/Dcto
    If FBN['Plazo']>VAR('PLCAPCORR')
        let &primaCte FBN['TotalDerechos']/FBN['Plazo'] * VAR('PLCAPCORR')
        let &primaNoCte FBN['TotalDerechos']-&primaCte
    Else
        let &primaCte FBN['TotalDerechos']
    Endif
    *Gastos
    
    let &plazoGastos DifDias(FBN['Fecha1'], FBN['FechaVto'],'ARG',NO)
    If &plazoGastos>VAR('PLCAPCORR')
        let &comisCte FBN['Cantidad1']/&plazoGastos * VAR('PLCAPCORR')
        let &comisNoCte FBN['Cantidad1']-&comisCte
    Else
        let &comisCte FBN['Cantidad1']
    Endif
    
    *****
    
    IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
        ACN(CK:1, 1)
        IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'E' AND NrTrans2 = '"~fbn('NrTrans')~"' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND (FechaValor > '"~IdxDate(Val(FO:2))~"' OR FechaValor =  '"~IdxDate(Val(FO:1))~"') AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
            ACN(CK:1, 0)
        ENDIF
    ENDIF
    ***/// Si estoy por contabilizar Gastos de ON, actualizo los MOVDEVENGADOS para que el asiento obtenga los importes
    IF #LIQCOMON Y #OBLIGNEG Y Not Eqstr(Val(NR:1), FBN('NrOperacion'))
    (.'ACTMOVDEV'.)      
       ACT(NR:1, fbn('NrOperacion'))
    ENDIF
    ****CANJE
    let &esCanje fbn('RB1')
    let &tipoOp fbn('TipoOp')
    let &montoCanjeMoneda 0
    let &montoCanjeTitulo 0
    IF #ESCANJE
        SQL.ADD("SELECT Total2 Monto, dbo.DESCIENDEDEESPECIE(Especie1,'MONEDA') EsMoneda FROM "~DBO~".CANJES where NrOperacion = '"~fbn('NrOperacion')~"'")
        Recorrer SQL
            If fbn('EsMoneda') = 1     
                let &montoCanjeMoneda &montoCanjeMoneda + fbn('Monto')
            Else
                let &montoCanjeTitulo &montoCanjeTitulo + fbn('Monto')
            EndIf
        Proximo
        let &ctaPuente fbn('Cuenta4')
        let &ctaContAuxPuente BuscarCampo('CUENTAS','CuentaContableAux','Codigo',&ctaPuente)
        **let &importeCanjeTitulos SQL("Select SUM(Total2) From "~DBO~".CANJES where NrOperacion = '"~fbn('NrOperacion')~"' and dbo.DESCIENDEDEESPECIE(Especie1,'TITULO') = 1 ")
    EndIf
    IF Val(CK:1) = 0
        ***---Obtengo el Total de Intereses de la operacion
        ACN(TI:1, SQL(" Select Sum(Cantidad3) From "~DBO~".CUOTAS Where NrOperacion = '"~fbn('NrOperacion')~"' "))
        let &modeloContable fbn('CodAsi')
        let &Moneda fbn('Moneda')

        SQL.GenerarAsientoOp(&modeloContable,fbn('NrOperacion'),'','',810,Val(fv:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,fbn('NrTrans'),,,,,fsys,Dialogo.Fecha1)
        SQL.EXEC
    ENDIF
Proximo

***---Cancelacion de PF
SQL.ADD(" SELECT T.NrTrans, T.Cantidad1, T.Especie Moneda, O.NrOperacion, O.Especie, O.ContraEspecie, ")
SQL.ADD(" O.TipoOp, O.TotalNetoCli1, O.TotalBrutoCli1, MA.Codigo CodAsi, C.CUIT, V.Valor1, V.Valor2, ")
SQL.ADD(" O.FechaVto, O.Vehiculo1, O.Cantidad, CU.Comitente, O.CB9, O.CB10, O.Precio3, E.Tipo, ")
SQL.ADD(" O.TotalNetoCli2, T.Fecha2, T.Fecha1, O.FechaVto2, O.PrecioMer, O.FechaPago, O.TotalIVA, ")
SQL.ADD(" O.TotalIntereses, O.FechaOp, O.TotalBrutoCli2, O.TotalDerechos, O.Cliente1, T.Cuenta2, ")
SQL.ADD(" CU.CuentaContable1, C.Valor1 CtaRem, E.Issuer Cliente, T.TipoTr2, O.CB7, O.TipoTasa, ")
SQL.ADD(" O.ImpGastos1, O.Observaciones, O.Precio1, O.Plazo, E.Alias8, M.NrMov, V.Alias4 MonLocalVeh, O.MB4, ")
SQL.ADD(" MA.Libro, O.ImpGastos2, CU.TipoCuenta,O.Book1 AS Book, O.TotalAux1 AS Penalidad , ")
SQL.ADD(" C.CuentaContableAux as CtaContAuxCli,CU.CuentaContableAux as CtaContAuxCue, O.CuentaContableAux1 as 'ctaContAuxOp' ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO MA, ")
SQL.ADD(" "~DBO~".CLIENTES C, "~DBO~".VEHICULOS V, "~DBO~".CUENTAS CU, "~DBO~".ESPECIES E,  ")
SQL.ADD(" "~DBO~".MOVEJECUTADOS M ")
SQL.ADD(" WHERE T.NrOperacionRef1 = O.NrOperacion ")
SQL.ADD(" AND   O.Cliente1    =  C.Codigo   ")
SQL.ADD(" AND   O.Vehiculo1   =  V.Codigo   ")
SQL.ADD(" AND   O.Especie     =  E.Codigo   ")
SQL.ADD(" AND   T.Especie  IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~")  ")
SQL.ADD(" AND   T.NrTrans     =  M.NrTrans2 ")
SQL.ADD(" and T.TipoTr2 in ('DEP','RET') ")
SQL.ADD(" AND M.NrOperacion = O.NrOperacion ")
SQL.ADD(" AND M.NrSaldo = 1 ")
SQL.ADD(" AND T.Cuenta2 = CU.Codigo ")
SQL.ADD(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASICAPP'))~") ")
SQL.ADD(" AND O.TipoOp = MA.TipoOp ")
SQL.ADD(" AND T.Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
SQL.ADD(" AND O.TipoOp IN ('MMCP', 'MMCPM') ")
SQL.ADD(" AND O.FechaOp < M.FechaMov ")
SQL.ADD(" AND MA.Habilitado = 'SI' ")
**SQL.ADD(" AND MA.Entorno = '"~SIGLA~"' ")
SQL.ADD(" AND '|'+rtrim(MA.Entorno)+'|' like '%|"~SIGLA~"|%' ")
If NoVacio(Dialogo.ListaTabla1)
   SQL.ADD(" AND T.NrTrans IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
Else
   SQL.ADD(" AND T.Fecha1 = "~IdxDate2(Dialogo.Fecha1)~" ")
   If NoVAcio(Dialogo.Lista1)
       SQL.ADD(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND (( ")
       Recorrer&i 1,Elementos(Dialogo.Lista1)
            SQL.ADD(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(Dialogo.Lista1,&i)~"|%' ")
            If NOT Elementos(Dialogo.Lista1)=&i
                SQL.ADD(" OR ")
            EndIf
       proximo
       SQL.ADD(") OR MA.Vehiculo is null OR MA.Vehiculo = '' OR MA.Vehiculo = ' ' )")      
   Else
      If NoVacio(UsrVehiculos(UsuarioActivo))
         SQL.ADD(" AND T.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
      Endif
   Endif
Endif
SQL.ADD(" AND T.Fecha2 >= '"~IdxDate(Fecha(Var('FECHAMIGRA')))~"' ")
SQL.ADD(" ORDER By O.NrOperacion, MA.Codigo, T.NrTrans ")
Recorrer SQL
    **Cintia 301123 por préstamos PCR
    let &ctaContAuxOp fbn('ctaContAuxOp')
    let &sector BuscarCampo('CLIENTES','CategDepositante','Codigo',fbn('Cliente1'))
    **
   let &monedaOp fbn('Especie')
   message(fbn('NrOperacion')~'  - Modelo: '~fbn('CodAsi'))
   ACD(FV:1, fbn('Fecha2'))
   ACT(VH:1, fbn('Vehiculo1'))
   ACD(FO:1, val(FV:1))
   ACD(FO:2, Habiles(FinDeMes(val(FO:1),NO,'ARG')))
   (.'FECHAVALO2'.)
   ACD(FV:2, Val(FV:1))
   (.'FECHAVALOR'.)
   let &fechaContable Val(FV:1)   
   let &book fbn('Book')
   let &ctaContAuxCli fbn('CtaContAuxCli')
   let &ctaContAuxCue FBN('CtaContAuxCue')
   ACN(CK:1, 0)
   IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
      ACN(CK:1, 1)
      **//IF Not Eqstr(fbn('NrOperacion'), Val(NR:1))
         ***---IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'E' AND NrTrans2 = '"~fbn('NrTrans')~"' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
         ***---No se pregunta por NrTrans ya que el select puede traer NrTrans que no contabilizan (por ej: Liq.interes)
         IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND (FechaValor > '"~IdxDate(Val(FO:2))~"' OR FechaValor =  '"~IdxDate(Val(FO:1))~"') AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
            ACN(CK:1, 0)
         ENDIF
      **//ENDIF
   ENDIF
   IF Val(CK:1) = 0
      IF Eqstr(fbn('TipoOp'), 'MMCP')
         ACN(TR:1, fbn('TotalRetenciones'))
         ACN(TI:1, fbn('TotalIntereses'))
      ELSE
         ***---Se asume unico vto.
         ACN(TR:1, SQL(" Select Cantidad4 From "~DBO~".CUOTAS Where NrOperacion = '"~fbn('NrOperacion')~"' "))
         ***---Obtengo el Total de Intereses de la operacion
         *ACN(TI:1, SQL(" Select Cantidad3 From "~DBO~".CUOTAS Where NrOperacion = '"~fbn('NrOperacion')~"' and Fecha1 < "~IdxDate2(Val(FV:1))~" and Fecha2 >= "~IdxDate2(Val(FV:1))~" "))
         *Agustin Cocciardi 02/11/2022 - Se sacan los filtros de Fecha
         ACN(TI:1, SQL(" Select Cantidad3 From "~DBO~".CUOTAS Where NrOperacion = '"~fbn('NrOperacion')~"' "))
      ENDIF
      let &modeloContable fbn('CodAsi')
      let &Moneda fbn('Moneda')
      SQL.GenerarAsientoOp(&modeloContable,fbn('NrOperacion'),'','',810,Val(fv:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,fbn('NrTrans'),,,,,fsys,Dialogo.Fecha1)
      SQL.EXEC
   ENDIF
Proximo


let &prestamos 'MMPCLM|MMPOSM|MMONM|'
**---Cancelacion de Prestamos
**---NrMov > 500 y < 1000 son movimientos de Capital
**---NrMov > 5000 y < 6000 son movimientos de Interes
**---NrMov > 8000 y < 9000 son movimientos de Iva y Percepcion
SQL.ADD(" SELECT T.NrTrans, T.Cantidad1, T.Especie Moneda, O.NrOperacion, O.Especie, O.ContraEspecie, ")
SQL.ADD(" O.TipoOp, O.TotalNetoCli1, O.TotalBrutoCli1, MA.Codigo CodAsi, C.CUIT, V.Valor1, V.Valor2, ")
SQL.ADD(" O.FechaVto, O.Vehiculo1, O.Cantidad, CU.Comitente, O.CB9, O.CB10, O.Precio3, E.Tipo, ")
SQL.ADD(" O.TotalNetoCli2, T.Fecha2, T.Fecha1, O.FechaVto2, O.PrecioMer, O.FechaPago, O.TotalIVA, ")
SQL.ADD(" O.TotalIntereses, O.FechaOp, O.TotalBrutoCli2, O.TotalDerechos, O.Cliente1, T.Cuenta2, ")
SQL.ADD(" CU.CuentaContable1, C.Valor1 CtaRem, E.Issuer Cliente, T.TipoTr2, O.CB7, O.TipoTasa, ")
SQL.ADD(" O.ImpGastos1, M.NrMov, O.Observaciones, O.Precio1, O.Plazo, M.NrGrupo2 MovConcepto, M.Status TipoImpuesto, ")
SQL.ADD(" O.MB3, E.Alias8, O.CB5, V.Alias4 MonLocalVeh, O.MB4, MA.Libro, O.ImpGastos2, T.CNFormaPago, O.Indice, O.Precio5, M.NrGrupo2, O.Precio6, O.Book1 Book, O.TipoGracia  , ")
SQL.ADD(" C.CuentaContableAux as CtaContAuxCli,CU.CuentaContableAux as CtaContAuxCue,T.Precio7 TcLiq, O.CuentaContableAux1 as 'ctaContAuxOp',M.FechaMov ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO MA, ")
SQL.ADD(" "~DBO~".CLIENTES C, "~DBO~".VEHICULOS V, "~DBO~".CUENTAS CU, "~DBO~".ESPECIES E,  ")
SQL.ADD(" "~DBO~".MOVEJECUTADOS M ")
SQL.ADD(" WHERE T.NrOperacionRef1 = O.NrOperacion ")
SQL.ADD(" AND O.Cliente1 =  C.Codigo   ")
SQL.ADD(" AND O.Vehiculo1 =  V.Codigo   ")
SQL.ADD(" AND O.Especie  =  E.Codigo   ")
SQL.ADD(" AND T.Especie IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~")  ")
SQL.ADD(" AND T.NrTrans =  M.NrTrans2 ")
SQL.ADD(" and T.TipoTr2 in ('DEP','RET') ")
SQL.ADD(" AND M.NrOperacion = O.NrOperacion ")
SQL.ADD(" AND '|'+rtrim(MA.Entorno)+'|' like '%|"~SIGLA~"|%' ")
SQL.ADD(" AND M.NrSaldo = 1 ")
SQL.ADD(" AND T.Cuenta2 = CU.Codigo ")
SQL.ADD(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASICAPP'))~") ")
SQL.ADD(" AND MA.TipoOp = O.TipoOp ")
SQL.ADD(" AND T.Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
SQL.ADD(" AND O.TipoOp IN ('MMPCLM','MMPEM','MMPIM','MMPOSM','MMSCMV','MMSIMV','MMPCCM','MMDPAC','MMSELN','MMONM') ")
***///          Es MMONM y es sin PIKs, o liquida capital
***///SQL.ADD("       OR (O.TipoOp = 'MMONM' AND (O.RB7=0  OR  (M.NrMov > 500 AND M.NrMov < 1000)) )) ")
***/// Si es voucher de Comisiones no discrimina si es la FechaOp
SQL.ADD(" AND (O.FechaOp < M.FechaMov OR O.TipoOp = 'MMDPAC' OR (M.NrMov>10000 AND M.NrMov<11000 )) ")
If NoVacio(Dialogo.ListaTabla1)
   SQL.ADD(" AND T.NrTrans IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
Else
   SQL.ADD(" AND T.Fecha1 = "~IdxDate2(Dialogo.Fecha1)~" ")
   If NoVAcio(Dialogo.Lista1)
      SQL.ADD(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
   Else
      If NoVacio(UsrVehiculos(UsuarioActivo))
         SQL.ADD(" AND T.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
      Endif
   Endif
Endif
SQL.ADD(" AND T.Fecha2 >= '"~IdxDate(Fecha(Var('FECHAMIGRA')))~"' ")
SQL.ADD(" ORDER By O.NrOperacion, MA.Codigo, MovConcepto, M.NrMov, T.NrTrans ")
Recorrer SQL
    **Cintia 291223 x Liq Int y cap al vto Prestamos
    **Cintia 160224 apertura x ONs**
    If #OBLIGNEG
        let &campoCapOp 'Cantidad4'
    Else
        let &campoCapOp 'Cantidad1'
    Endif
    **
    IF Incluido(fbn['TipoOp'],&prestamos)
        let &impInteresVto 0
        let &capitalOp 0
        let &tcLink 0
        let &capResidual 0
        let &nrCuota 0
        SQL.ADD("Select NrCuota,Fecha1,Fecha2,Cantidad2,Cantidad3 'Intereses' ,"~&campoCapOp~" 'CapitalOp',Cantidad17 'PrecioVto' from "~DBO~".CUOTAS ")
        SQL.ADD("Where NrOperacion= '"~fbn('NrOperacion')~"' and Fecha3= "~IdxDate2(fbn('FechaMov'))~" ")
        Recorrer SQL
            DFA
            let &impInteresVto FBN['Intereses']
            let &capitalOp FBN['CapitalOp']
            let &tcLink FBN['PrecioVto']
            let &fechaIniCuotaVig FBN['Fecha1']
            let &fechaFinCuotaVig FBN['Fecha2']
            let &capResidual FBN['Cantidad2']
            let &nrCuota FBN['NrCuota']
        Proximo
    ENDIF        
    
    let &monedaOp FBN['Especie']
    let &TCBNAVFechaPago 0
    let &ajDCIntVto 0
    let &ajDCCapVto 0
    let &DCCap 0   
    let &tcLiqVtoCuota  0
    let &tcLiqAltaCuota 0
    let &TCBNAVtoCuota  0
    let &TCBNAAltaCuota 0

    **Cintia 271223 x TcLiq Prestamos
    let &tcLiq FBN['TCLiq']
    **
    **Cintia 301123 por préstamos PCR
    let &ctaContAuxOp fbn('ctaContAuxOp')
    let &sector BuscarCampo('CLIENTES','CategDepositante','Codigo',fbn('Cliente1'))
    **
    message(fbn('NrOperacion')~'  - Modelo: '~fbn('CodAsi'))
    ACN(BD:1, 0)
    ACD(FV:1, fbn('Fecha2'))
    ACT(VH:1, fbn('Vehiculo1'))
    ACD(FO:1, val(FV:1))
    ACD(FO:2, Habiles(FinDeMes(val(FO:1),NO,'ARG')))
    let &book fbn('Book')
    let &ctaContAuxCli fbn('CtaContAuxCli')
    let &ctaContAuxCue FBN('CtaContAuxCue')
    IF Not Incluido(fbn('Tipoop'), 'MMDPAC')
        (.'FECHAVALO2'.)
    ENDIF
    ACD(FV:2, Val(FV:1))
   (.'FECHAVALOR'.)
    let &fechaContable Val(FV:1)   
    ACN(CK:1, 0)
    IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
        ACN(CK:1, 1)
        IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'E' AND NrTrans2 = '"~fbn('NrTrans')~"' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND (FechaValor > '"~IdxDate(Val(FO:2))~"' OR FechaValor =  '"~IdxDate(Val(FO:1))~"') AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
            ACN(CK:1, 0)
        ENDIF
    ENDIF
    IF Val(CK:1) = 0
        IF Incluido(fbn('TipoOp'), Val(LS:1))
            IF fbn('NrMov') > 8000 Y fbn('NrMov') < 9000
                ***---Liquidacion de Impuestos
                let &modeloContable fbn('CodAsi')
                let &Moneda fbn('Moneda')
                SQL.GenerarAsientoOp(&modeloContable,fbn('NrOperacion'),'','',810,Val(fv:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,fbn('NrTrans'),Val(NA:1),NO,,,fsys,Dialogo.Fecha1)
            ELSE
                ACN(NV:1, fbn('NrMov'))
                ***---Liquidacion de Interes o Capital
                ACT(NA:1, GetNumerador(810))
                ***---Obtengo Total de Impuestos Aplicados al Concepto
                SQL.ADD(" Select ")
                Recorrer&k 1, 10
                    SQL.ADD(" Total"~Fstr(&k, 0, 0)~" TotalImpuesto"~Fstr(&k, 0, 0)~", ")
                Proximo
                ACN(TI:1, 0)
                SQL.ADD(" NrOperacion From "~DBO~".IMPUESTOS ")
                SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
                SQL.ADD(" AND Plazo4 = "~Fstr(fbn('NrMov'), 0, 0)~" ")
                SQL.ADD(" AND (Check3 = 0 OR Check3 = Null OR Check3 = '' OR Check3 = ' ')")
                Recorrer SQL
                    DFA
                    Recorrer&k 1, 10
                        SCN(TI:1, fbn('TotalImpuesto'~Fstr(&k, 0, 0)))
                    Proximo
                Proximo
                let &modeloContable fbn('CodAsi')
                let &Moneda fbn('Moneda')
                SQL.GenerarAsientoOp(&modeloContable,fbn('NrOperacion'),'','',810,Val(fv:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,fbn('NrTrans'),Val(NA:1),SI,,,fsys,Dialogo.Fecha1)
            ENDIF
            ACN(BD:1, 1)
        ELSE
            IF Incluido(fbn['TipoOp'],&prestamos)    
                **Cintia 310124
                ********Esto sólo se va a generar si el criterio de devengamiento contable es con reversa
                If Var('DEVCONTCRE')=1
                    **Cintia por ajuste en DC al vto para préstamos PCR 
                        **Se vuelve a validar la fecha de inicio del periodo para cuando es liq de capital ya que si hay cuotas anteriores sin amortizacion de capital deben contemplarse. Se busca la fecha de liquidacion de capital maxima anterior al alta 
                    If #LIQCAPPRE
                        SQL.ADD(" Select Max(T.Fecha2) as 'FechaTr' from "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M ")
                        SQL.ADD(" Where T.NrTrans=M.NrTrans2 and T.NrOperacionRef1='"~fbn('NrOperacion')~"' ")
                        SQL.ADD(" AND M.NrSaldo=1 ")
                        SQL.ADD(" and((M.NrMov>500 AND M.NrMov<1000 ) OR (M.NrMov>10000 AND M.NrMov<11000 ) OR M.NrMov=1)  ")
                        SQL.ADD(" and T.Fecha2<='"~IdxDate(&fechaIniCuotaVig)~"'  ")
                        Recorrer SQL
                            DFA
                            let &fechaIniCuotaVig FBN['FechaTr']
                        Proximo                
                    Endif
                    IF Incluido(fbn('TipoOp'), VAR('TOPASTCLIQ')) Y (#LIQCAPPRE O #LIQINTPRE)
                        if #ESUSDLINK
                            let &tcLiqVto &tcLink
                            let &tcLiqVtoCuota &tcLink
                            If &nrCuota=1
                                let &tcLiqAltaCuota SQL("Select Precio6 from "~DBO~".OPERACIONES Where NrOperacion= '"~fbn('NrOperacion')~"' ")                                            
                            Else
                                let &tcLiqAltaCuota SQL("Select Cantidad17 from "~DBO~".CUOTAS Where NrOperacion= '"~fbn('NrOperacion')~"' and Fecha1='"~IdxDate(&fechaIniCuotaVig)~"' ")                                            
                            Endif
                            let &cotiz #COTDCMOPA

                        else
                            let &tcLiqVto &tcLiq
                            let &tcLiqVtoCuota SQL("Select T.Precio7 from "~DBO~".TRANSACCIONES2 T,"~DBO~".MOVEJECUTADOS M  Where T.NrTrans=M.NrTrans2 and T.NrOperacionRef1= '"~fbn('NrOperacion')~"' and T.Fecha2='"~IdxDate(&fechaFinCuotaVig)~"' AND (M.NrMov>500 AND M.NrMov<1000 ) ")
                            let &tcLiqAltaCuota SQL("Select T.Precio7 from "~DBO~".TRANSACCIONES2 T,"~DBO~".MOVEJECUTADOS M  Where T.NrTrans=M.NrTrans2 and T.NrOperacionRef1= '"~fbn('NrOperacion')~"' and T.Fecha2='"~IdxDate(&fechaIniCuotaVig)~"' AND ((M.NrMov>500 AND M.NrMov<1000 )OR M.NrMov=1) ")
                            let &cotiz 1                   
                        endif
                    Endif
                    **AJ DC CAPITAL                
                    IF Incluido(fbn('TipoOp'), VAR('TOPASTCLIQ')) Y #LIQCAPPRE y Not EqStr(#MONELOCAVH,&monedaOp)
                        let &DCCap SQL("Select Sum(DC) as DC FROM "~DBO~".DCMM WHERE NrOperacion = '"~fbn('NrOperacion')~"' AND TipoDC IN ('CTE','NCT') AND Fecha <= '"~IdxDate(&fechaFinCuotaVig)~"' AND Fecha > '"~IdxDate(&fechaIniCuotaVig)~"'")
                        IF Vacio(&DCCap)
                            let &DCCap 0
                        ENDIF
                        let &ajDCCapVto (&capResidual*(&tcLiqVtoCuota - &tcLiqAltaCuota))-(&DCCap)
                    ENDIF
                    
                    **AJ DC INTERES                
                    IF Incluido(fbn('TipoOp'), VAR('TOPASTCLIQ')) Y #LIQINTPRE y Not EqStr(#MONELOCAVH,&monedaOp)
                        let &TCBNAVFechaPago COTIZACIONBNA(&monedaOp,Val(FV:1),2,NO,NO)
                        let &intPagadosUSD FBN['Cantidad1']*&cotiz
                        let &ajDCIntVto &intPagadosUSD*(&tcLiqVto-&TCBNAVFechaPago)             
                    ENDIF 
                ENDIF   
            ENDIF
            let &modeloContable fbn('CodAsi')
            let &Moneda fbn('Moneda')
            SQL.GenerarAsientoOp(&modeloContable,fbn('NrOperacion'),'','',810,Val(fv:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,fbn('NrTrans'),,,,,fsys,Dialogo.Fecha1)
        ENDIF            
        SQL.EXEC
    ENDIF
Proximo

(.'CONLIQGAR'.)