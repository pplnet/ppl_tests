CrearDialogo
    Fecha1: 'Fecha: '             ;1;1;1;SI;SI;;;;FSYS
    Lista1: 'TiposOp: '           ;2;1;1;SI;SI;;;;;;SQLSet("SELECT Codigo FROM TIPOSOPERACION WHERE Codigo IN ('MMCPM', 'MMCCR', 'SECAC', 'SECAT')  ")
    NrOperacion1: 'Operacion: '   ;3;1;1;SI;SI;Incluido( SQLSet("SELECT TipoOp FROM OPERACIONES WHERE NrOperacion = '"~Dialogo.NrOperacion1~"' "), 'MMCPM|MMCCR|SECAC|SECAT',1);'Tipo de Operacion debe ser MMCPM|MMCCR|SECAC|SECAT';NO;;;SQLSet("SELECT NrOperacion FROM OPERACIONES WHERE FechaVto>='"~IdxDate(Dialogo.Fecha1)~"'AND FechaOp<'"~IdxDate(Dialogo.Fecha1)~"' AND NOT Especie = '"~Var('MONELOCA')~"' AND TipoOp IN ('MMCPM', 'MMCCR', 'SECAC', 'SECAT')");;;"TipoOp IN ('MMCPM', 'MMCCR', 'SECAC', 'SECAT')"
FinDialogo

If Not ok
    Cancelar
EndIf

***VARIABLES***
If Vacio(Dialogo.Lista1)
    let &tiposOp 'MMCPM|MMCCR|SECAC|SECAT'
Else
    let &tiposOp Dialogo.Lista1
EndIf
ACT(ML:1,Var('MONELOCA'))
ACT(ME:1,Var('MONEEXTR'))
ACN(AP:1, 1)
*   FD:55 = Fecha Desde
    ACD(FD:55, Habiles(Dialogo.Fecha1, -1, 'ARG', SI))
*   FH:55 = Fecha Hasta
    ACD(FH:55, Dialogo.Fecha1)

***SELECT***
SQL.ADD("SELECT O.NrOperacion,O.Especie, O.TipoOp, O.Cantidad, O.FechaVto, O.FechaOp, V.Alias4, M.Monto ")
SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".VEHICULOS V, "~DBO~".MOVDEVENGADOS M")
SQL.ADD("WHERE O.Vehiculo1 = V.Codigo")
SQL.ADD("AND O.NrOperacion = M.NrOperacion ")
SQL.ADD("AND TipoDevengado = 'INTLEN'")
*Reviso si se eligió un nr Operación particular
IF NoVacio(Dialogo.NrOperacion1)
    SQL.ADD("AND O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Else
    *Sino filtro operaciones
    SQL.ADD("AND O.TipoOp IN("~Pipe2Comillas(&tiposOp)~") ")
    SQL.ADD("AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"'")
    SQL.ADD("AND O.FechaOp < '"~IdxDate(Dialogo.Fecha1) ~"'")
    SQL.ADD("AND NOT O.Especie = '"~Val(ML:1)~"' ")
EndIf
SQL.ADD("ORDER BY O.NrOperacion")
Watch(SQL.batch)

Recorrer SQL
***Datos DC Capital***
*    MO:88 = Especie de la operacion 
    ACT(MO:88, FBN('Especie') )
    ACT(A:FAC, 'Especie enviada'~Val(MO:88) )

*    AL:88 = Moneda Local el vehículo
    ACT(AL:88, FBN('Alias4') )
    ACT(B:FAC, 'Moneda Local el vehículo: '~Val(AL:88) )

*    MO:55 = Capital
    ACN(MO:55, FBN('Cantidad') )
    ACT(C:FAC, 'Capital: '~Val(MO:55) )
    
    (.'DCDIARIA'.)  

    ACD(A:FAC, Val(FD:55) )
    ACD(B:FAC, Val(FH:55) )
    ACN(C:FAC, Val(DK:55) )
    ACT(D:FAC, FBN('TipoOp') )
    ACN(E:FAC, Val(MO:88) )
    IFA
    
***Datos DC Interés***
    ACN(MO:55, FBN('Monto') )
    (.'DCDIARIA'.)

    ACD(A:FAC, Val(FD:55)    )
    ACD(B:FAC, Val(FH:55)    )
    ACN(C:FAC, Val(DK:55)    )
    ACT(D:FAC, FBN('TipoOp') )
    ACN(E:FAC, Val(MO:88)    )
    IFA
Proximo
IFA
HojaVisible(SI)
LimitesVision(F:fac)