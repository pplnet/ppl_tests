CrearDialogo
  Especie1   : "Especie"      ;1;1;;;;NoVacio(Dialogo.Especie1);'Debe ingresar una especie';NO;;;;;;
  Vehiculo1  : "Vehiculo";;;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;;;;;;
FinDialogo

If Not Ok
    Cancelar
ENDIF

*Ejecuto el ACTMOV de operaciones para Posiciones
EjecutarEvento('ACTMOV',Vehiculo1=Dialogo.Vehiculo1,Fecha1=Fecha('30/12/2022'),Fecha2=Fsys,Especie1=Dialogo.Especie1,Radio1=6,Radio2=1)

*Ejecuto el ACTMTR de operaciones para Posiciones
EjecutarEvento('ACTMTR',Vehiculo1=Dialogo.Vehiculo1,Fecha1=Fecha('30/12/2022'),Fecha2=Fsys,Especie1=Dialogo.Especie1,Radio2=1)

*Ejecuto el ACTMOV de operaciones para Movimientos
EjecutarEvento('ACTMOV',Vehiculo1=Dialogo.Vehiculo1,Fecha1=Fecha('30/12/2022'),Fecha2=Fsys,Especie1=Dialogo.Especie1,Radio1=6,Radio2=0)

*Ejecuto el ACTMTR de operaciones para MOVIMIENTOS
EjecutarEvento('ACTMTR',Vehiculo1=Dialogo.Vehiculo1,Fecha1=Fecha('30/12/2022'),Fecha2=Fsys,Especie1=Dialogo.Especie1,Radio2=0)

*Ejecuto el REIMOV
EjecutarEvento('REIMOV',Vehiculo1=Dialogo.Vehiculo1,Especie1=Dialogo.Especie1)