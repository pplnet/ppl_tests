MostrarCuadroDeMensajes
CrearDialogo
   Fecha1         : 'Fecha'          ;1;1;;No;;;;;FSYS
   NrUnicoAsiento1: 'Asiento'        ;;;;;; NoVacio(Dialogo.NrUnicoAsiento1);'Asiento Invalido';NO;  
   String1        : "Nro de Batch"   ;;;;;;;;;;
   Fecha2         : 'F.Valor'        ;;;;;;;;;;;;;;;;
FinDialogo

If Not Ok
  Cancelar
Endif

ACD(fe:1, Dialogo.Fecha1)
ACN(BD:1, 0)
ACT(NA:1, PAD0(Dialogo.NrUnicoAsiento1,8))

SQL.ADD("select DISTINCT  MA.Codigo as CodAsi, AC.FechaGeneracion,  ")
SQL.ADD(" AC.FechaValor, AC.Vehiculo, AC.Libro, AC.Sector, AC.NrLote, AC.NrUnicoAsiento, ")
SQL.ADD(" AC.Modelo, AC.Book, AC.UDN, AC.Centro, AC.NrOperacion, AC.NrTrans2, AC.NrAsiento ")
SQL.ADD("  from  "~DBO~".MODELOSASIENTO MA, "~DBO~".ASIENTOSCON AC ")
SQL.ADD(" Where AC.NrUnicoAsiento = '"~Val(NA:1)~"' ")
SQL.ADD(" and MA.Codigo = AC.Modelo      ")
SQL.ADD(" order by AC.NrUnicoAsiento ")
Recorrer SQL
    MESSAGE('Operacion '~fbn('NrOperacion'))
    ACT(NN:1, GetNumerador(810))
    ACN(BD:1, 1)
    SQL.ADD(" INSERT INTO "~DBO~".ASIENTOSCON ")
    SQL.ADD(" (FechaGeneracion, FechaValor, Vehiculo, Libro, ")
    SQL.ADD(" Modelo, Book, UDN, Centro, ")
    SQL.ADD(" Sector, NrLote, NrAsiento, NrUnicoAsiento, ")
    SQL.ADD(" NrOperacion, NrTrans2, Estado, Fecha1) ")
    SQL.ADD(" VALUES ")
    SQL.ADD(" ("~Idxdate2(fsys)~", '"~Idxdate(HABILES(Dialogo.Fecha2, 1, VAR('FERIADODEF')))~"', '"~fbn('Vehiculo')~"', '"~fbn('Libro')~"', ")
    SQL.ADD(" '"~fbn('Modelo')~"', '"~fbn('Book')~"', '"~fbn('UDN')~"', '"~fbn('Centro')~"', ")
    SQL.ADD(" '"~fbn('Sector')~"', '"~fbn('NrLote')~"', '"~fbn('NrUnicoAsiento')~"', '"~Val(nn:1)~"', ")
    SQL.ADD(" '"~fbn('NrOperacion')~"', '"~fbn('NrTrans2')~"', 'REV', "~Idxdate2(Dialogo.Fecha1)~")  ")
    SQL.NEW
    SQL.ADD(" SELECT Cuenta,DebitoCredito,Especie1,Especie2,Especie3,Cantidad1,Cantidad2,Cantidad3,NrOperacion,NrTrans2,")
    SQL.ADD(" Alias1,Alias2,Alias3,Alias4,Alias5,Alias6,Detalle,CentroCosto,Book,Alias7,Alias8,Alias9,Alias10,Valor1,")
    SQL.ADD(" Valor2,Valor3")
    SQL.ADD(" FROM "~DBO~".ASIENTOSCON1 WHERE NrUnicoAsiento = '"~fbn('NrUnicoAsiento')~"'  ")
    Recorrer SQL
       SQL.ADD(" INSERT INTO "~DBO~".ASIENTOSCON1 ")
       SQL.ADD(" (NrUnicoAsiento, Cuenta, DebitoCredito, Especie1, ")
       SQL.ADD(" Especie2, Especie3, Cantidad1, Cantidad2, ")
       SQL.ADD(" Cantidad3, NrOperacion, NrTrans2, Alias1, ")
       SQL.ADD(" Alias2, Alias3, Alias4, Alias5, Alias6, ")
       SQL.ADD(" Detalle, CentroCosto, Book, ")
       SQL.ADD(" Alias7, Alias8, ")
       SQL.ADD(" Alias9, Alias10, Valor1, ")
       SQL.ADD(" Valor2, Valor3 ")
       SQL.ADD(" ) VALUES ( ")
       SQL.ADD(" '"~Val(NN:1)~"', '"~fbn('Cuenta')~"', ")
       If Eqstr(fbn('DebitoCredito'), 'DEB')
          SQL.ADD(" 'CRE', ")
       Else
          SQL.ADD(" 'DEB', ")
       Endif
       SQL.ADD(" '"~fbn('Especie1')~"', ")
       SQL.ADD(" '"~fbn('Especie2')~"', '"~fbn('Especie3')~"', "~fstr(fbn('Cantidad1'),0,8)~", "~fstr(fbn('Cantidad2'),0,8)~", ")
       SQL.ADD(" "~fstr(fbn('Cantidad3'),0,8)~", '"~fbn('NrOperacion')~"', '"~fbn('NrTrans2')~"', '"~fbn('Alias1')~"', ")
       SQL.ADD(" '"~fbn('Alias2')~"', '"~fbn('Alias3')~"', '"~fbn('Alias4')~"', '"~fbn('Alias5')~"', '"~fbn('Alias6')~"', ")
       SQL.ADD(" '"~fbn('Detalle')~"', '"~fbn('CentroCosto')~"', '"~fbn('Book')~"', ")
       SQL.ADD(" '"~fbn('Alias7')~"', '"~fbn('Alias8')~"', ")
       SQL.ADD(" '"~fbn('Alias9')~"', '"~fbn('Alias10')~"', "~Fstr(fbn('Valor1'), 0, 2)~", ")
       SQL.ADD(" "~Fstr(fbn('Valor2'), 0, 8)~", "~Fstr(fbn('Valor3'), 0, 2)~") ")
       SQL.NEW
    Proximo
    SQL.EXEC
    ***---Marco el asiento
    SQL.ADD(" Update "~DBO~".ASIENTOSCON ")
    SQL.ADD(" Set NrAsiento = '"~Val(NN:1)~"' ")
    SQL.ADD(" Where NrUnicoAsiento = '"~fbn('NrUnicoAsiento')~"' ")
    SQL.NEW
    SQL.EXEC
Proximo

*IF Val(BD:1) = 0
*  MessageBox('El Asiento '~Val(NA:1)~' NO Fue Reversado')
*ELSE
*  MessageBox('El Asiento '~Val(NA:1)~' Fue Reversado con el Asiento '~Val(NN:1))
*ENDIF
