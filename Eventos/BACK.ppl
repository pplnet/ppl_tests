*Cintia MAR2024 Se corrige ya que recorria hasta la cantidad de elementos de nombres DISPONIBLES pero debe recorrer los YA UTILIZADOS
*Recorrer&k 1, Val(X:1) 
If &codigosAgotados=1
    let &elementosK Elementos(Val(Z3))
    let &listaUtilizados Val(Z3)
Else
    let &elementosK Elementos(Val(Z2))
    let &listaUtilizados Val(Z2)
Endif
Recorrer&k 1, &elementosK
   ifa
   *Cintia MAR2024 Se comenta ya que no se utiliza en ningun lado
   *ACT(a:fac, ItemLista(Val(Z:1),&k))
   ACT(b:fac, ItemLista(&listaUtilizados,&k))
   ACT(c:fac, SQL(" Select Nombre from "~DBO~Val(TP:1)~" Where Codigo = '"~Val(b:fac)~"' "))
Proximo

If &codigosAgotados=1
    CrearDialogo
      String2  : Val(TP:2)      ;1;;;NO;;;;;Val(CD:2);;;;'XXXXXX'
      Fecha1   : 'Fecha'        ;2;;;;;;;;SQLAhora;;;
      String1  : 'Cod. BackUp'  ;3;;;;;SQL(" Select 1 from "~DBO~Val(TP:1)~" Where Codigo = '"~Dialogo.String1~"' ") <> 1;'Se eliminará el BackUp '~Dialogo.String1~' para ser reemplazado';SI;Val(Z:1);;Val(Z:1);;'XXXXXX'
      Label1   : ''             ;1;2;;NO;;;;;'Ya Utilizados';
      ListBox; 'Arial,8,N'; 250; 180
         'Codigo'    ;b:1..b:Elementos(&listaUtilizados);;;;;60;STRING;
         'Nombre'    ;c:1..c:Elementos(&listaUtilizados);;;;;155;STRING;
      FinListBox  
    FinDialogo
else
    CrearDialogo
      String2  : Val(TP:2)      ;1;;;NO;;;;;Val(CD:2);;;;'XXXXXX'
      Fecha1   : 'Fecha'        ;2;;;;;;;;SQLAhora;;;;
      String1  : 'Cod. BackUp'  ;3;;;;;SQL(" Select 1 from "~DBO~Val(TP:1)~" Where Codigo = '"~Dialogo.String1~"' ") <> 1;'Ya existe un '~Dialogo.String1;NO;ItemLista(Val(Z:1),Val(DF:1));;Val(Z:1);;'XXXXXX'
      Label1   : ''             ;1;2;;NO;;;;;'Ya Utilizados';
      ListBox; 'Arial,8,N'; 250; 180
         'Codigo'    ;b:1..b:Elementos(&listaUtilizados);;;;;60;STRING;
         'Nombre'    ;c:1..c:Elementos(&listaUtilizados);;;;;155;STRING;
      FinListBox  
    FinDialogo
endif



If not OK
  Cancelar
Endif

**Cintia 2024
If &codigosAgotados=1
    SQL.ADD("DELETE FROM "~DBO~Val(TP:1)~" Where Codigo = '"~Dialogo.String1~"' and Tipo='BACK' ")
    SQL.NEW
    SQL.EXEC
Endif
****
ACN(FD:1, Dia(Dialogo.Fecha1))
ACN(FM:1, Mes(Dialogo.Fecha1))
ACN(FA:1, Anio(Dialogo.Fecha1))
If Val(FA:1)>100
   ACN(FA:1, Num(Copy(Fstr(Val(FA:1),0,0),3,2)))
Endif

ACT(NM:1, Val(CD:2)~' (Back '~Pad0(Fstr(Val(FD:1),0,0),2)~'-'~Pad0(Fstr(Val(FM:1),0,0),2)~'-'~Fstr(Val(FA:1),0,0)~')')

ACN(KK:1, 0)
Repetir
   SCN(KK:1, 1)
   If SQL("Select 1 from "~DBO~Val(TP:1)~" Where Nombre = '"~Val(NM:1)~"' ")=1
      If Val(KK:1)=1
         ACT(NM:1, Val(NM:1)~' ('~Fstr(Val(KK:1),0,0)~')')
      Else
         ACN(KL:1, Longitud(Val(NM:1)))
         ACT(NM:1, Copy(Val(NM:1), 1, Val(KL:1)-2)~Fstr(Val(KK:1),0,0)~')')
      Endif
   Else
      Break
   Endif
Proximo

If Not Eqstr(Val(TP:1),'.TIPOSOPERACION')
   IF Eqstr(Val(TP:1),'.TIPOSTRANSACCION2')
       SQL.ADD(" Insert into "~DBO~Val(TP:1)~" ")
       SQL.ADD(" (Codigo, Nombre, Especie, Codigo2, Script) ")
       SQL.ADD(" Select '"~Dialogo.String1~"' Codigo, '"~Val(NM:1)~"' Nombre, Especie, Codigo2, Script ")
       SQL.ADD(" from "~DBO~Val(TP:1)~" ")
       SQL.ADD(" Where Codigo = '"~Val(CD:2)~"' ")
   ELSE
       SQL.ADD(" Insert into "~DBO~Val(TP:1)~" ")
       SQL.ADD(" (Codigo, Nombre, Script, Tipo) ")
       SQL.ADD(" Select '"~Dialogo.String1~"' Codigo, '"~Val(NM:1)~"' Nombre, Script, 'BACK' Tipo ")
       SQL.ADD(" from "~DBO~Val(TP:1)~" ")
       SQL.ADD(" Where Codigo = '"~Val(CD:2)~"' ")
   ENDIF
Else
   If SQL("Select 1 from "~DBO~".CLASESOPERACION Where Codigo = 'BACKUP' ")=1
      ACT(CL:1, 'BACKUP')
   Else
      If SQL("Select 1 from "~DBO~".CLASESOPERACION Where Codigo = 'BACK' ")=1
         ACT(CL:1, 'BACK')
      Else
         ACT(CL:1, '')
      Endif
   Endif
   SQL.ADD(" Insert into "~DBO~Val(TP:1)~" ")
   SQL.ADD(" (Codigo, Nombre, Inversa, Script, TipoNegocio, ClaseOperacion) ")
   SQL.ADD(" Select '"~Dialogo.String1~"' Codigo, '"~Val(NM:1)~"' Nombre, '' Inversa, Script, '' TipoNegocio, '"~Val(CL:1)~"' ClaseOperacion ")
   SQL.ADD(" from "~DBO~Val(TP:1)~" ")
   SQL.ADD(" Where Codigo = '"~Val(CD:2)~"' ")
Endif
SQL.NEW
SQL.EXEC


MessageBox("Creado "~Val(NM:1)~" con codigo "~Dialogo.String1)

