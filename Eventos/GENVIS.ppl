****CHEQUES*****

let &fecha Habiles(Dialogo.Fecha2,-Var('DIAVISTADD'),'ARG',NO)
let &fechaDesde IIF(EsHabil(&fecha,'ARG'),&fecha,Habiles(&fecha,1,'ARG'))
let &fechaHasta Dialogo.Fecha2

***OPERACIONES DE CHEQUES***
