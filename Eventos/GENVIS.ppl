CrearDialogo
  Fecha1 : 'Desde'            ;1;1;;;;Dialogo.Fecha1<>0;'Fecha invalida';NO;Habiles(Fecha2,-Var('DIAVISTAFI'),'ARG',NO)
  Fecha2 : 'Hasta'            ;;;;;;Dialogo.Fecha2>Dialogo.Fecha1;'La Fecha Desde debe ser mayor a la Fecha Hasta';NO;Fsys
FinDialogo

If NOT OK
  Cancelar
EndIf

let &fechaDesde IIF(EsHabil(Dialogo.Fecha1,'ARG'),Dialogo.Fecha1,Habiles(Dialogo.Fecha1,1,'ARG'))
let &fechaHasta Dialogo.Fecha2

***SALDO CUENTA COMITENTE***
IF Vacio SQL("SELECT 1 from INFORMATION_SCHEMA.TABLES  where TABLE_NAME= 'V_SALCTACOM'")
    SQL.ADD("EXEC "~DBO~".V_SALCTACOM_CREAR '"~IdxDate(&fechaDesde)~"','"~IdxDate(&fechaHasta)~"'")
    SQL.NEW
    SQL.EXEC
EndIf
***SALDO CUENTA CORRIENTE***
IF Vacio SQL("SELECT 1 from INFORMATION_SCHEMA.TABLES  where TABLE_NAME= 'V_SALCTACTE'")
    SQL.ADD("EXEC "~DBO~".V_SALCTACTE_CREAR '"~IdxDate(&fechaDesde)~"','"~IdxDate(&fechaHasta)~"'")
    SQL.NEW
    SQL.EXEC
