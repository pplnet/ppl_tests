**Registro la conciliación en el cheque
SQL.ADD(" UPDATE "~DBO~".OPERACIONES ")
SQL.ADD(" Set RB1='2', ")
SQL.ADD(" Observac3 ='"~&comprobante~"', ")
If (&radio=0 y &check=1) o &radio=1
    SQL.ADD(" ContraEspecie2 ='"~Dialogo.Especie1~"', ")
    SQL.ADD(" Cuenta3 ='"~Dialogo.Cuenta2~"', ")
    SQL.ADD(" TotalAux1 ='"~FStr(Dialogo.Cantidad1,0,2)~"', ")
    SQL.ADD(" TotalAux2 ='"~FStr(Dialogo.Cantidad2,0,2)~"', ")
    If &radio=1  
        SQL.ADD(" Cuenta2 ='"~Dialogo.Cuenta1~"', ")
        SQL.ADD(" TotalAux3 ='"~FStr(Dialogo.Cantidad3,0,2)~"', ")
    Endif 
Endif    
SQL.ADD(" FechaEj ='"~IdxDate(Ahora)~"', ")
SQL.ADD(" FechaEx1 ='"~IdxDate(Fsys)~"', ")
***Cintia 051023 - (se saca porque se agrega en el IMPCHE)
