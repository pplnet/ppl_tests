**
SQL.ADD(" Fecha2 ='"~IdxDate(&FechaCobro)~"' ")
SQL.ADD(" Where NrOperacion= '"~&nrOperacion~"'")
SQL.NEW
SQL.EXEC

SQL.ActualizarMovimientos2(&nrOperacion,NO,SI,NO,NO)
SQL.EXEC
    
MessageBox('La conciliación finalizó con éxito')
