HojaVisible(NO)

ModoReproceso(SinDialogo)
CrearDialogo
  Especie1   : ''                ;;;;;;;;;
FinDialogo
IF Not Ok
  Cancelar
Endif

SQL.ADD(" Select Fecha, Cupon from "~DBO~".ESPECIES where  Codigo = '"~Dialogo.Especie1~"' ")
Recorrer SQL
    SQL.ADD("Insert into "~DBO~".AGENDACUPONES ( ")
    SQL.ADD(" Especie, TipoCupon, FechaCorte, FechaPago, ")
    SQL.ADD(" PorRenta, PorAmCapital, NrCupon, Estado, PorAmIntCap ")
    SQL.ADD(" ) VALUES ( ")
    SQL.ADD("'"~Dialogo.Especie1~"','AMO','"~IdxDate(fbn['Fecha'])~"','"~IdxDate(fbn['Fecha'])~"',") 
    SQL.ADD("0, 100,"~Fstr(fbn('Cupon'),0,0)~", 'PEN', 0 ) ")
    SQL.NEW
    SQL.EXEC
Proximo

MessageBox('Zero-cupon creado con exito!')
