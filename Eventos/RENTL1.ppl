IF Vacio(UsrVehiculos(UsuarioActivo))
    ACT(LS:1, SQLSet(" Select Codigo from "~DBO~".VEHICULOS where Status = 'HAB' "))
ELSE
    ACT(LS:1, UsrVehiculos(UsuarioActivo))
ENDIF
CrearDialogo
  Fecha1: 'Fecha Desde'          ;1;;;;;;;;FSys
  Fecha2: 'Fecha Hasta'          ;2;;;;;;;;FSys
  Radio1: 'Filtra Book|SI|NO'    ;3;;;;;;;;1;
  Lista1: 'Vehiculos'            ;4;;;;Dialogo.Radio1=1;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), Val(LS:1), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where V.Codigo = U.Vehiculo AND U.Codigo = '"~UsuarioActivo~"' AND V.Status = 'HAB' "));;
  Vehiculo1: 'Vehiculo'          ;4;;;;Dialogo.Radio1=0;Dialogo.Radio1=1 O NoVacio(Dialogo.Vehiculo1) ;'Vehiculo Invalido';NO;;;;;;;
  Lista2: 'Books'                ;5;;;;Dialogo.Radio1=0;NoVacio(Dialogo.Lista2) o Dialogo.Radio1=1;'Debe indicar book/s';NO;;;SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~Dialogo.Vehiculo1~"' ");;
FinDialogo

If Not Ok
    Cancelar
Endif


If Dialogo.Radio1 =1
    let &vehiculo '' 
    If Vacio(Dialogo.Lista1)
        let &vehiculos Val(LS:1)
    Else
        let &vehiculos Dialogo.Lista1
    Endif
    let &books ''
Else
    let &vehiculo Dialogo.Vehiculo1
    let &vehiculos ''
    let &books Dialogo.Lista2
Endif


Recorrer&i  Dialogo.Fecha1, Dialogo.Fecha2    
    If EsHabil(Fecha(&i),'ARG')
       Message('Procesando el día:'~Fecha(&i))
       EjecutarEvento('RENTAB',Fecha1=Fecha(&i), Radio1=Dialogo.Radio1, Vehiculo1=&vehiculo, Lista2=&books, Lista1=&vehiculos)
    Endif    
Proximo