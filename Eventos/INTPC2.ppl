MostrarCuadroDeMensajes
HojaVisible(NO)

CrearDialogo
  Fecha1         : 'F.Valor'           ;;;;;;;;;FSYS;;;
  Check1         : 'Filtra Asiento'    ;;;;;;;;;;;;
  Check2         : 'Filtra Oper.'      ;;;;;;;;;;;;
  Check3         : 'Filtra FValor.'    ;;;;;;;;;;;;
  NrUnicoAsiento1: 'Nr Asiento'        ;;;;;;;;;;;;
  NrOperacion1   : 'Operacion'         ;;;;;;;;;;;;
  Lista1         : 'Vehiculo'          ;;;;;;;;;;;;
FinDialogo

If Not Ok
   Cancelar
Endif

let &monedaLocal Var('MONELOCA')

***** Barrera de habilitacion de interfaz contable
IF Eqstr(Var('INTASIENTO'), 'SI')
   Cancelar('Se esta ejecutando la interfaz contable...Por favor intente en unos minutos')
*Else
**** Barrera de habilitacion de proceso Contable
   IF Eqstr(Var('GENASIENTO'), 'SI')
      Cancelar('Ya esta siendo ejecutado el proceso contable...Por favor intente en unos minutos')
   EndIf
EndIf

SQL.ADD(" Update "~DBO~".VARIABLES Set Valor='SI' Where Codigo='INTASIENTO' ")
SQL.NEW
SQL.EXEC

SQL.ADD("SELECT A1.NrUnicoAsiento, A1.NrItem, A.Estado, A.Modelo,")

SQL.ADD(" A1.Alias4, A1.Cuenta, A.FechaValor, A1.Cantidad1, A1.Especie1, ")
SQL.ADD(" A1.Cantidad2, A1.Especie2, A1.Detalle, A1.DebitoCredito, A1.Alias6, ")
SQL.ADD(" A1.Alias1, A1.Alias2, A1.Valor1, A1.Valor2, A1.Alias3 Book, ")
SQL.ADD(" A1.Alias7, A1.Cantidad2, A1.Alias5, A1.CuentaAuxiliar as CuentaAux,A1.Alias10, ")
SQL.ADD(" A.NrOperacion, A.Modelo, A.Vehiculo, ")
SQL.ADD(" M.Descripcion,M.TipoOp, ")
SQL.ADD(" T.TipoDoc ")

SQL.ADD(" FROM "~DBO~".ASIENTOSCON A ")
SQL.ADD(" JOIN "~DBO~".ASIENTOSCON1 A1  ON A.NrUnicoAsiento=A1.NrUnicoAsiento ")
SQL.ADD(" JOIN "~DBO~".MODELOSASIENTO M  ON A.Modelo = M.Codigo ")
SQL.ADD(" JOIN "~DBO~".TIPOSASIENTO T  ON T.Codigo = M.TipoAsiento ")
SQL.ADD(" WHERE A1.Cantidad1 > 0 ")
SQL.ADD(" AND (A.Estado IS Null OR A.Estado = '' OR A.Estado = ' ' OR A.Estado = 'COT' OR A.Estado = 'REV') ")
SQL.ADD(" AND (A.Sector Is Null OR A.Sector = '' OR A.Sector = ' ') ")
IF Dialogo.Check3 = 1
    SQL.ADD(" AND A.FechaValor = '"~IdxDate(Dialogo.Fecha1)~"'" )
ENDIF
IF NoVacio(Dialogo.Lista1)
    SQL.ADD("AND A.Vehiculo in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
IF Dialogo.Check1 = 1
    SQL.ADD("AND A.NrUnicoAsiento = '"~Dialogo.NrUnicoAsiento1~"' ")
ENDIF
IF Dialogo.Check2 = 1
    SQL.ADD("AND A.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
ENDIF

Watch(sql.batch) 

Recorrer SQL
    ***Realizo INSERT a tabla ASIENTOSJDE, preparo campos antes de insertar***
        *1)NrAsiento
        *2)NrItem
        *3)FechaCarga = SQLAHORA
        *******
        *4)FechaCargaSys= FSYS
        *5)UsrInput = USUARIOACTIVO
        *6)TipoAsiento = ASIENTOSCON.Estado ---- Estado = Null => AEstado = COT => COTEstado = REV => REV
        IF Vacio(fbn('Estado'))
            let &tipoAsiento 'A'
        ELSE
            IF Eqstr(fbn('Estado'), 'COT')
                let &tipoAsiento 'COT'
            ELSE
                IF Eqstr(fbn('Estado'), 'REV')
                    let &tipoAsiento 'REV'
                ENDIF
            ENDIF
        ENDIF   
        *******
        *Estado = NO SE INSERTA
        *7)TipoDoc = TIPOSASIENTO.TipoDoc del Tipo de Asiento del modelo contable. 
        *usando ASIENTOSCON.Modelo=MODELOSASIENTO.Codigo
        *MODELOSASIENTO.TipoAsiento=TIPOSASIENTO.CODIGO
        *TIPOSASIENTO.TipoDoc        
        let &tipoDoc FBN('TipoDoc')
        
        *8)CodCia =CLIENTES.Alias1 del Vehiculo del Asiento (ASIENTOSCON.Vehiculo -> CLIENTES.Alias1)
        let &codCia BuscarCampo('CLIENTES','Alias1','Codigo',FBN('Vehiculo') )
        *******
        *9)Explicacion =MODELOSASIENTO.Descripcion del Modelo del asiento (Hacer Copy, tiene máximo de 30)
        let &explicacion Copy(FBN('Descripcion'),1,30)
        *10)FechaLM =ASIENTOSCON.FechaValor
        *11)MonedaOp =De ASIENTOSCON1.Alias5 buscar ESPECIES.Alias10
        let &monedaOp Copy(SQL("SELECT Alias10 FROM ESPECIES WHERE Codigo ='"~FBN('Alias5')~"' "),1,3)
        *******
        *12)MonedaCia =De ASIENTOSCON1.Especie2 buscar ESPECIES.Alias10
        let &monedaCia Copy(SQL("SELECT Alias10 FROM ESPECIES WHERE Codigo ='"~FBN('Especie2')~"' "),1,3)
        *13)TipoCambio =ASIENTOSCON1.FormulaValor2
        *14)MontoMonOp =ASIENTOSCON1.Valor1
        *******
        *15)MontoMonCia =ASIENTOSCON1.Cantidad2
        *16)Signo =ASIENTOSCON1.DebitoCredito
        *17)Cuenta =ASIENTOSCON1(Alias10 + "." + Cuenta + "." + CuentaAux) Si CuentaAux viene vacío cuidar de no agregar el punto

        IF NoVacio(FBN('Alias10'))
            let &cuenta Copy((TRIM(FBN('Alias10')) ~ "."~TRIM(FBN('Cuenta'))),1,30)
        else
            let &cuenta Copy(TRIM(FBN('Cuenta')),1,30)
        endif
        
        If NoVacio(FBN('CuentaAux'))
            let &cuenta Copy((&cuenta~ "." ~ TRIM(FBN('CuentaAux'))),1,30)
        Endif
        *******
        *18)TipoLMAux =Siempre "A"
        **Modificacion GIAN 01/09/2023
        *19)LMAux =Si TipoOp like MM% = ASIENTOSCON1.NrOperacion ELSE ASIENTOSCON1.Alias6
        *Puede ser : Incluido(FBN('TipoOp'),SQLSET('SELECT Codigo FROM TiposOperacion WHERE Codigo like 'MM%''))
        ***
        *UPDATE 31/10/2023: Cuando es una FX también se manda el nro de Operacion
        If Eqstrl(FBN('TipoOp'), 'MM', 2) O Eqstrl(FBN('TipoOp'), 'FX', 2)
            let &LMAux FBN('NrOperacion')
        Else
            let &LMAux FBN('Alias6')
        Endif
        *20)Observacion =ASIENTOSCON1.Detalle (Hasta 30)
        let &observacion Copy(FBN('Detalle'),1,30)
        ****************************************************************************************************************
        ***INSERT***
        SQL.ADD(" INSERT INTO "~DBO~".ASIENTOSJDE ( ")
        SQL.ADD(" NrAsiento     , NrItem    ,   FechaCarga  ,")
        SQL.ADD(" FechaCargaSys , UsrInput  ,   TipoAsiento ,")
        SQL.ADD(" TipoDoc       , CodCia                    ,")
        SQL.ADD(" Explicacion   , FechaLM   ,   MonedaOp    ,")
        SQL.ADD(" MonedaCia     , TipoCambio,   MontoMonOp  ,")
        SQL.ADD(" MontoMonCia   , Signo     ,   Cuenta      ,")
        SQL.ADD(" TipoLMAux     , LMAux     ,   Observacion )")
        
        SQL.ADD(" VALUES ( ")
        SQL.ADD(" '"~FBN('NrUnicoAsiento')~"'   , "~Fstr(FBN('NrItem'),0,0)~"     ,"~SQLAhora~"                    ,")
        SQL.ADD(" '"~IdxDate(FSYS)~"'           , '"~USUARIOACTIVO~"'             ,'"~&tipoAsiento~"'              ,")
        SQL.ADD(" '"~&tipoDoc~"'                , '"~&codCia~"'                                                    ,")
        SQL.ADD(" '"~&explicacion~"'            , '"~IdxDate(FBN('FechaValor'))~"','"~&monedaOp~"'                 ,")
        SQL.ADD(" '"~&monedaCia~"'              , "~Fstr(FBN('Valor2'),0,8)~"     , "~Fstr(FBN('Valor1'),0,2)~"    ,")
        SQL.ADD(" "~Fstr(FBN('Cantidad2'),0,2)~", '"~FBN('DebitoCredito')~"'      , '"~&cuenta~"'                  ,")
        SQL.ADD(" 'A'                           , '"~&LMAux~"'                    , '"~&observacion~"'             )")
        SQL.NEW
        
    ***/Marco asiento como enviado
    SQL.ADD(" Update "~DBO~".ASIENTOSCON ")
    IF Eqstr(fbn('Estado'), 'COT')
        SQL.ADD(" Set Estado = 'COE', ")
    ELSE
         IF Eqstr(fbn('Estado'), 'REV')
            SQL.ADD(" Set Estado = 'REE', ")
         ELSE
            SQL.ADD(" Set Estado = 'E', ")
         ENDIF
    ENDIF
    ***/Fecha2 = Fecha de Envio
    SQL.ADD(" Fecha2 = "~SQLAhora~" ")
    SQL.ADD(" Where NrUnicoAsiento = '"~FBN('NrUnicoAsiento')~"' ")
    SQL.NEW    
Proximo

** Se coloca la variable INTASIENTO en NO para habilitar la interfaz contable 
SQL.ADD(" Update "~DBO~".VARIABLES Set Valor='NO' Where Codigo='INTASIENTO' ")
SQL.NEW
SQL.EXEC