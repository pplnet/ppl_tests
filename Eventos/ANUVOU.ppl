SQL.ADD("DELETE FROM "~DBO~".MOVEJECUTADOS ")
SQL.ADD("WHERE  NrTrans2 = '"~Dialogo.NrTrans1~"'")
SQL.NEW

SQL.ADD("DELETE FROM "~DBO~".MOVPENDIENTES ")
SQL.ADD("WHERE  NrTrans2 = '"~Dialogo.NrTrans1~"'")
SQL.NEW

SQL.ADD("DELETE FROM "~DBO~".OPERACIONESBITS ")
SQL.ADD("WHERE  NrOperacion = '"~Dialogo.NrTrans1~"'")
SQL.NEW

SQL.ADD("DELETE FROM "~DBO~".TRANSACCIONES2 ")
SQL.ADD("WHERE  NrTrans = '"~Dialogo.NrTrans1~"'")
SQL.NEW
SQL.EXEC

***---IF Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion', Val(X:3)), 'FCS|FCR')
    ***---Para las FCI puede haber movimientos de ajuste con el mismo NrMov, con lo cual de esta manera se unifican para que no haya problemas en la liquidacion
    ***---al volver a liquidar
    SQL.ActualizarMovimientos3(Val(X:3),SI,NO,NO,NO,NO)
    SQL.EXEC
