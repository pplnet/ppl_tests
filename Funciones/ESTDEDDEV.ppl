***/// Calculo de columnas S, T, U y V. Devengados de Intereses, WH y Sellos.

ACN(S:fac, 0)
ACN(T:fac, 0)
ACN(U:fac, 0)
ACN(V:fac, 0)

SQL.ADD(" Select Monto, Fecha ")
SQL.ADD(" From "~DBO~".MOVDEVENGADOS ")
SQL.ADD(" Where NrOperacion = '"~FBN['NrOperacion']~"' ")
SQL.ADD(" And NrSaldo = 140 ")
SQL.ADD(" And TipoDevengado = 'INTLEN' ")

Recorrer SQL
  dfa
  *-Calculo de Intereses Devengados
  If FBN['Fecha'] <= Dialogo.Fecha1 Y FBN['Fecha'] > val(e:fac)
    ***---SCN(s:FAC, ABS(FBN['Monto']))
    SCN(s:FAC, FBN['Monto'])
  Endif
  *-Calculo de Intereses a Devengar
  If FBN['Fecha'] > Dialogo.Fecha1  Y FBN['Fecha'] <= Val(g:fac)
    ***---SCN(t:FAC, ABS(FBN['Monto']))
    SCN(t:FAC, FBN['Monto'])
  Endif
Proximo
ACN(S:fac, Abs(Val(S:fac)))
ACN(T:fac, Abs(Val(T:fac)))
* --------------------------------------------------------------------
SQL.ADD(" Select Monto, Fecha ")
SQL.ADD(" From "~DBO~".MOVDEVENGADOS ")
SQL.ADD(" Where NrOperacion = '"~FBN['NrOperacion']~"' ")
SQL.ADD(" And NrSaldo = 140 ")
SQL.ADD(" And TipoDevengado = 'SELLOS' ")
Recorrer SQL
  dfa
  *-Calculo de Intereses Devengados para sellos y WHT
  If FBN['Fecha'] <= Dialogo.Fecha1 Y FBN['Fecha'] > val(e:fac)
    ***---SCN(U:FAC, ABS(FBN['Monto']) )
    SCN(U:FAC, FBN['Monto'] )
  Endif
  *-Calculo de Intereses a Devengar
  If FBN['Fecha'] > Dialogo.Fecha1  Y FBN['Fecha'] <= Val(g:fac)
    ***---SCN(v:FAC, ABS(FBN['Monto']))
    SCN(v:FAC, FBN['Monto'])
  Endif
Proximo
ACN(U:fac, Abs(Val(U:fac)))
ACN(V:fac, Abs(Val(V:fac)))
SQL.ADD(" Select Monto, Fecha ")
SQL.ADD(" From "~DBO~".MOVDEVENGADOS ")
SQL.ADD(" Where NrOperacion = '"~FBN['NrOperacion']~"' ")
SQL.ADD(" And NrSaldo = 140 ")
SQL.ADD(" And TipoDevengado = 'INTWHT' ")
Recorrer SQL
   dfa
  *-Calculo de Intereses Devengados para sellos y WHT
  If FBN['Fecha'] <= Dialogo.Fecha1 Y FBN['Fecha'] > val(e:fac)
  ***---SCN(u:FAC, ABS(FBN['Monto']) )
    SCN(U:FAC, FBN['Monto'] )
  Endif
  *-Calculo de Intereses a Devengar
  If FBN['Fecha'] > Dialogo.Fecha1  Y FBN['Fecha'] <= Val(g:fac)
  ***---SCN(v:FAC, ABS(FBN['Monto'])  )
  SCN(v:FAC, FBN['Monto'])
  Endif
Proximo
ACN(U:fac, Abs(Val(U:fac)))
ACN(V:fac, Abs(Val(V:fac)))


*--->Acumula Devengados------------------------------------------------
ACN(bb7, Val(bb7) + Val(s:fac))
ACN(bb8, Val(bb8) + Val(t:fac))

ACN(bb:9 , Val(bb:9)  + Val(U:fac))
ACN(bb:10, Val(bb:10) + Val(V:fac))