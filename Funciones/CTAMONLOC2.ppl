Cuenta3 : 'Cta.M.Local:'  ;20;1;2;NoVacio(ESPECIE) y Not EqStr(ESPECIE,VAR('MONELOCA'));NO Y NoVacio(ESPECIE) y Not EqStr(ESPECIE,VAR('MONELOCA'));SI O [[[CLIENTECUENTA(VEHICULO1,CUENTA3) y ESPECIECUENTA(ESPECIE,CUENTA3) y EqSTr(BuscarCampo('CUENTAS','Numero','Codigo',CUENTA3),'') y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA3),'SUS')] y NOVACIO(CUENTA3)] o EqStr(ESPECIE,VAR('MONELOCA'))];'Error en Cuenta de Mon.Local '~VAR('MONELOCA');SI;IF(EqStr(ESPECIE, VAR('MONELOCA')),CUENTA3,CUENTACLIENTE(VEHICULO1,VAR('MONELOCA'),CLIENTE1,,TIPOOP,'SUS'));IF(EqStr(ESPECIE, VAR('MONELOCA')),CUENTA3,CUENTACLIENTE(VEHICULO1,VAR('MONELOCA'),CLIENTE1,,TIPOOP,'SUS'));;;;;;"Cliente='"~VEHICULO1~"' and Estado = 'SUS' and (Numero='' or Numero Is Null) and (Especies Like '%"~VAR('MONELOCA')~"%' )" 
  

