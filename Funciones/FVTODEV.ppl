*Siempre evalua la funcion Fecha y con fechas incorrectas pincha
*Fecha8   : 'F.Vto DEV 30360';NO;NO;;;IF(CUOTASL.PLAZO1[Fila] < 30 O Dia(CUOTASL.FECHA1[Fila]) > DiasM(1,CUOTASL.FECHA2[Fila]),CUOTASL.FECHA2[Fila],Fecha(Fstr(Dia(CUOTASL.FECHA1[Fila]),0,0)~'/'~Fstr(Mes(CUOTASL.FECHA2[Fila]),0,0)~'/'~Fstr(Anio(CUOTASL.FECHA2[Fila]),0,0)));IF(CUOTASL.PLAZO1[Fila] < 30 O Dia(CUOTASL.FECHA1[Fila]) > DiasM(1,CUOTASL.FECHA2[Fila]),IF(Dia(CUOTASL.FECHA1[Fila]) = 31 Y CUOTASL.PLAZO1[Fila] = 30,CUOTASL.FECHA2[Fila]+1,CUOTASL.FECHA2[Fila]),IF(Dia(CUOTASL.FECHA1[Fila]) = 31 Y CUOTASL.PLAZO1[Fila] = 30,Fecha(Fstr(Dia(CUOTASL.FECHA1[Fila]),0,0)~'/'~Fstr(Mes(CUOTASL.FECHA2[Fila]),0,0)~'/'~Fstr(Anio(CUOTASL.FECHA2[Fila]),0,0))+1,Fecha(Fstr(Dia(CUOTASL.FECHA1[Fila]),0,0)~'/'~Fstr(Mes(CUOTASL.FECHA2[Fila]),0,0)~'/'~Fstr(Anio(CUOTASL.FECHA2[Fila]),0,0)) ));90;;Fecha;
Fecha8   : 'F.Vto DEV 30360';NO;NO;;;IF(CUOTASL.PLAZO1[Fila] < 30 O Dia(CUOTASL.FECHA1[Fila]) > DiasM(1,CUOTASL.FECHA2[Fila]),CUOTASL.FECHA2[Fila],Fecha(IF(Dias(CUOTASL.FECHA1[Fila])<= DiasM(1,CUOTASL.FECHA2[Fila]),Fstr(Dias(CUOTASL.FECHA1[Fila]),0,0),Fstr(DiasM(1, CUOTASL.FECHA2[Fila])))~'/'~Fstr(Mes(CUOTASL.FECHA2[Fila]),0,0)~'/'~Fstr(Anio(CUOTASL.FECHA2[Fila]),0,0)));IF(CUOTASL.PLAZO1[Fila] < 30 O Dia(CUOTASL.FECHA1[Fila]) > DiasM(1,CUOTASL.FECHA2[Fila]),IF(Dia(CUOTASL.FECHA1[Fila]) = 31 Y CUOTASL.PLAZO1[Fila] = 30,CUOTASL.FECHA2[Fila]+1,CUOTASL.FECHA2[Fila]),IF(Dia(CUOTASL.FECHA1[Fila]) = 31 Y CUOTASL.PLAZO1[Fila] = 30,Fecha(IF(Dias(CUOTASL.FECHA1[Fila])<= DiasM(1,CUOTASL.FECHA2[Fila]),Fstr(Dias(CUOTASL.FECHA1[Fila]),0,0),Fstr(DiasM(1, CUOTASL.FECHA2[Fila])))~'/'~Fstr(Mes(CUOTASL.FECHA2[Fila]),0,0)~'/'~Fstr(Anio(CUOTASL.FECHA2[Fila]),0,0))+1,Fecha(IF(Dias(CUOTASL.FECHA1[Fila])<= DiasM(1,CUOTASL.FECHA2[Fila]),Fstr(Dias(CUOTASL.FECHA1[Fila]),0,0),Fstr(DiasM(1, CUOTASL.FECHA2[Fila])))~'/'~Fstr(Mes(CUOTASL.FECHA2[Fila]),0,0)~'/'~Fstr(Anio(CUOTASL.FECHA2[Fila]),0,0)) ));90;;Fecha;
