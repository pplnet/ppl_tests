*Validación CantidadCompletada Órdenes (Alta)
IF((RB4=0 y Eqstr(ABM,'A')),(VCAN1 + Query(" SELECT CantidadCompletada FROM "~DBO~".ORDENES WHERE NrOrden = '"~NRORDEN~"' ")) <= (Query(" SELECT CantidadTotalOrden FROM "~DBO~".ORDENES WHERE NrOrden = '"~NRORDEN~"' ") + (Query(" SELECT CantidadTotalOrden FROM "~DBO~".ORDENES WHERE NrOrden = '"~NRORDEN~"' ")/VAR('PORDESORD'))) Y VCAN1>0,VCAN1>=0);IF(VCAN1>0,'La Cantidad excede el total de la orden','La cantidad de la orden no puede ser 0');NO
*Validación CantidadCompletada Órdenes (Modificación)
IF((RB4=0 y Eqstr(ABM,'E')),(VCAN1 - (Query(" SELECT Cantidad FROM "~DBO~".EJECUCIONES WHERE NrOperacion = '"~NROPERACION~"' ")) + Query(" SELECT CantidadCompletada FROM "~DBO~".ORDENES WHERE NrOrden = '"~NRORDEN~"' ")) <= (Query(" SELECT CantidadTotalOrden FROM "~DBO~".ORDENES WHERE NrOrden = '"~NRORDEN~"' ") + (Query(" SELECT CantidadTotalOrden FROM "~DBO~".ORDENES WHERE NrOrden = '"~NRORDEN~"' ")/VAR('PORDESORD')))  Y VCAN1>0,VCAN1>=0);IF(VCAN1>0,'La nueva Cantidad excede el total de la orden','La nueva cantidad de la orden no puede ser 0');NO