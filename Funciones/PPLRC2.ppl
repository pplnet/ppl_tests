**// --------------------------------------------------------------------------------------------- //**
**// La función PPLRC es un script global que se distribuye junto al resto de los scripts
**// y es ejecutado de forma automática cuando se crea el proceso para correr la aplicación.
**// 
**// Este archivo sirve, entre otras cosas, para modificar el proceso de inicialización de la aplicación, 
**// configurar variables globales, definir funciones, sobrescribir funciones core y demás; 
**// siempre utilizando código PPL.

**// Las lineas que inician con "**//" son comentarios de ayuda,
**// las que inician con "**" son ejemplos PPL.

**// Mas info: https://github.com/FPA-SOFTWARE/ppl/wiki/pplrc
**// --------------------------------------------------------------------------------------------- //**


**// --------------------------------------------------------------------------------------------- //**
**// ConfigGrilla:
**// --------------------------------------------------------------------------------------------- //**
**// Funciones de configuracion de grillas.

**// Las siguientes funciones nos permiten definir las columnas que se muestran en las grillas de 
**// Operaciones, Transacciones o Ordenes. Cada ejemplo muestra su valor default.

**// Define las columnas de la super grilla. 
**// Parametros: 
**// [1] Lista de columnas formato query y con prefijo "o."
** ConfigGrilla.ColumnasSuperGrillaOp("o.NrOperacion, o.FechaOp, RTRIM(o.Cliente1) as Cliente1, RTRIM(o.Especie) as Especie, RTRIM(o.TipoOp) as TipoOp, ROUND(o.Cantidad,2) as Cantidad, ROUND(o.PrecioEj,9) as PrecioEj, ROUND(o.Precio1,9) as Precio1, RTRIM(o.Cliente2) as Cliente2, o.FechaVto, o.Plazo, RTRIM(o.Operador) as Operador, RTRIM(o.Observaciones) as Observaciones, o.LInstancia, o.Direccion")

**// Define las columnas de una grilla de instancia en particular. 
**// Parametros: 
**// [1] NrInstancia (si es cero aplica a todas)
**// [2] Lista de columnas formato query y con prefijo "o."
** ConfigGrilla.ColumnasInstanciaOp(0, "o.NrOperacion, o.FechaOp, RTRIM(o.Cliente1) as Cliente1, RTRIM(o.Especie) as Especie, RTRIM(o.TipoOp) as TipoOp, ROUND(o.Cantidad,2) as Cantidad, ROUND(o.PrecioEj,9) as PrecioEj, ROUND(o.Precio1,9) as Precio1, RTRIM(o.Cliente2) as Cliente2, o.FechaVto, o.Plazo, RTRIM(o.Operador) as Operador, RTRIM(o.Observaciones) as Observaciones, o.LInstancia, o.Direccion")
** ConfigGrilla.ColumnasInstanciaTr(0, "o.NrTrans, o.Fecha1, o.Cliente1, o.Especie, o.TipoTr2, ROUND(o.Cantidad1,2) as Cantidad1, ROUND(o.Precio1,9) as Precio1, o.Cliente2, o.Direccion")
** ConfigGrilla.ColumnasInstanciaOr(0, "o.NrOrden, o.FechaOrden, o.Cliente, o.TipoOrden, o.CodComitente, o.Especie, ROUND(o.PrecioEjercicio,9) as PrecioEjercicio, o.ContraEspecie, o.Direccion")

**// Configuracion de filtros de usuario para super grilla:
** ConfigGrilla.AgregarFiltro("Compliance", "NrInstancia = 2 or NrInstancia = 3 or NrInstancia = 8")
**// El filtro del ejemplo anterior ya viene por default para STD.
**// --------------------------------------------------------------------------------------------- //**


**// --------------------------------------------------------------------------------------------- //**
**// ConfigCampos:
**// --------------------------------------------------------------------------------------------- //**
**//   Funciones para definir campos:
**//     ConfigCampos.Operaciones()
**//     ConfigCampos.Transacciones()
**//     ConfigCampos.Ordenes()
**//   Funciones para definir campos en los dialogos del interprete:
**//     ConfigCampos.Eventos()

** ConfigCampos.Operaciones("Label[1-21]", LABEL)

** ConfigCampos.Operaciones("CB[1-17]", CHECK)

** ConfigCampos.Operaciones("RB[1-17]", COMBO)

** ConfigCampos.Operaciones("MB[1-6]", RADIO)

** ConfigCampos.Operaciones("FechaOp[N-2]", DATE)

**// TEXT, MEDIUM_TEXT o LARGE_TEXT, el 3er parametro es opcional (max. caracteres)
** ConfigCampos.Operaciones("Observac[2-5]", TEXT ,100)

**// El 3er parametro es opcional (mascara)
** ConfigCampos.Operaciones("Cantidad[N-40]", NUMERIC, "##,###,###,###,###.##")

**// Parametros obligatorios: 
**// [3] Tabla
**// [4] Campo clave
**// [5] Campos columnas a mostrar
** ConfigCampos.Operaciones("Especie[N-5]", LOOKUP, "Especies", "Codigo", "Codigo,Nombre,Extendido,ISIN,CUSIP")

**// Luego de configurar los campos es necesario impactar los cambios:
** ConfigCampos.Guardar()
**// --------------------------------------------------------------------------------------------- //**


**// --------------------------------------------------------------------------------------------- //**
**// Definir numerador para operaciones eventuales
**// --------------------------------------------------------------------------------------------- //**

**// Por default es el numerador 1000
**// Mas info: TODO

**// Ejemplo:
** EventualesNumerador(1001)
**// --------------------------------------------------------------------------------------------- //**


**// --------------------------------------------------------------------------------------------- //**
**// Definir funciones PPL:
**// --------------------------------------------------------------------------------------------- //**

**// Las funciones definidas en PPLRC son globales y estan disponibles en todos los eventos e informes.
**// Mas info: https://github.com/FPA-SOFTWARE/ppl/wiki/Intro-Sintaxis-Informes-y-Eventos#como-definir-funciones-en-pplnet

**// Ejemplo:

**// def sum (a, b)
**//    return a + b
**// end
**// --------------------------------------------------------------------------------------------- //**


**// --------------------------------------------------------------------------------------------- //**
**// Sobrescribir funciones PPL Core:
**// --------------------------------------------------------------------------------------------- //**

**// Las funciones definidas en PPLRC son globales y estan disponibles en todos los eventos e informes.
**// Mas info: https://github.com/FPA-SOFTWARE/ppl/wiki/Intro-Sintaxis-Informes-y-Eventos#como-definir-funciones-en-pplnet

**// Ejemplo:
**// (Funcion eqstr() case insensitive)

** def eqstr(str1, str2)
**   return eqstri(str1, str2)
** end
**// --------------------------------------------------------------------------------------------- //**


**// --------------------------------------------------------------------------------------------- //**
**// Definir variables globales: 


**// --------------------------------------------------------------------------------------------- //**

**// Variables de ambito global que se pueden acceder desde cualquier script.
**// Mas info: https://github.com/FPA-SOFTWARE/ppl/wiki/Variables-Globales

**// Ejemplo:
** letGlobal path_logo, 'G:\PATH\logo.jpg'
**// --------------------------------------------------------------------------------------------- //**

