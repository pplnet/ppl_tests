*Validación CantidadCompletada Órdenes (Alta)
IF((RB4=0 y Eqstr(ABM,'A')),(CANTIDAD + Query(" SELECT CantidadCompletada FROM "~DBO~".ORDENES WHERE NrOrden = '"~NRORDEN~"' ")) <= (Query(" SELECT CantidadTotalOrden FROM "~DBO~".ORDENES WHERE NrOrden = '"~NRORDEN~"' ") + (Query(" SELECT CantidadTotalOrden FROM "~DBO~".ORDENES WHERE NrOrden = '"~NRORDEN~"' ")/VAR('PORDESORD'))) Y CANTIDAD>0,CANTIDAD>0);'La Cantidad excede el total de la orden';NO
*Validación CantidadCompletada Órdenes (Modificación)
IF((RB4=0 y Eqstr(ABM,'E')),(CANTIDAD - (Query(" SELECT Cantidad FROM "~DBO~".EJECUCIONES WHERE NrOperacion = '"~NROPERACION~"' ")) + Query(" SELECT CantidadCompletada FROM "~DBO~".ORDENES WHERE NrOrden = '"~NRORDEN~"' ")) <= (Query(" SELECT CantidadTotalOrden FROM "~DBO~".ORDENES WHERE NrOrden = '"~NRORDEN~"' ") + (Query(" SELECT CantidadTotalOrden FROM "~DBO~".ORDENES WHERE NrOrden = '"~NRORDEN~"' ")/VAR('PORDESORD')))  Y CANTIDAD>0,CANTIDAD>0);'La nueva Cantidad excede el total de la orden';NO