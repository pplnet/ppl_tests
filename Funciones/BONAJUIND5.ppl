**Para utilizar esta funcion deben estar declaradas las variables 
*&espBonInd (especie),&book,&vehiculo y &fechaBonInd

let &indiceEsp BuscarCampo('ESPECIES','Indice','Codigo',&espBonInd)
let &tipoIndice BuscarCampo('ESPECIES','TipoIndice','Codigo',&indiceEsp)
IF NoVacio(&indiceEsp) y (EqStr(&tipoIndice,'CAP') or  EqStr(&tipoIndice,'ULK'))
    SQL.ADD("Select ABS(Cantidad1) as 'Nominales',Cambio3,Precio1,Precio2,Cupon1,Especie2 from "~DBO~".TRANSACCIONES2 ")
    SQL.ADD(" Where TipoTr2='CUPON' AND Cantidad4=3 AND Fecha1 >='"~IdxDate(&fechaBonInd1)~"' AND ")
    SQL.ADD(" Fecha1 <='"~IdxDate(&fechaBonInd2)~"'AND Vehiculo1='"~&vehiculo~"' ")
    SQL.ADD(" AND Book1='"~&book~"' AND Especie='"~&espBonInd~"' ")
    let &monto 0
    Recorrer SQL
        DFA
        let &dif fbn('Cambio3')-1
        **Para Ajustados por ULK en BFSA no se resta el 1
        #ifdef BFSA
            IF EqStr(&tipoIndice,'ULK')
                let &dif fbn('Cambio3')
            Endif
        #endif
        let &PorAmort  fbn('Precio1')/100
        let &PorRenta  fbn('Precio2')/100
        let &montoIni fbn('Nominales')*&dif
        let &montoAmort &montoIni*&PorAmort
        let &montoRenta &montoIni*&PorRenta
        **200126 se agrega MontoUni para acumular ya que depende el período del REPCAR puede haber mas de un corte
        *let &monto &montoAmort+&montoRenta
        let &montoUni &montoAmort+&montoRenta
        **Si la moneda de Pago es distinta a la moneda de expresion del reporte (REPCAR) o la moneda cotiza (RENTAB), se convierte
        let &saveTc &tc
        let &saveMonedaTC2 &monedaTC2  
        let &monPago SQL("Select Especie1 from "~DBO~".TRANSACCIONES2 Where Especie='"~fbn('Especie2')~"' and Cupon1='"~fbn('Cupon1')~"' ")
        let &monedaTC2 &monPago
        (.'TIPOCAMBIO'.)
        **let &monto &monto*&tc
        let &monto &monto + (&montoUni*&tc)
        let &tc &saveTc
        let &monedaTC2 &saveMonedaTC2 
    Proximo
Endif

**Lo que se quiere obtener de esta funcion es el valor de &monto. ***Aplica para ìndices con capitalizaciòn de intereses***


